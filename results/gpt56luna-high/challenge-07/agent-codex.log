{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train7.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np,time\n\ntc.set_backend('jax'); B=tc.backend\nn=16; L=2; nq=8\n\ndef energy(p,u):\n c=tc.Circuit(n)\n q=B.convert_to_tensor(1.0)\n for l in range(L):\n  for i in range(nq): c.ry(i,theta=p[l,i])\n  for i in range(nq): c.ry(nq+i,theta=p[l,nq+i])\n  for i in range(nq): c.rzz(nq+i,i,theta=p[l,2*nq+i])\n  for i in range(nq-1): c.cnot(nq+i,nq+i+1)\n  for i in range(nq):\n   z=B.real(c.expectation_ps(z=[nq+i]))\n   p1=(q-z)/(2*q)\n   m=B.cast(u[l*nq+i] < p1,'int32')\n   md=B.cast(m,'float32')\n   zero=B.convert_to_tensor(0.)\n   proj=B.stack([B.stack([1-md,zero]),B.stack([zero,md])])\n   c.any(nq+i,unitary=proj)\n   q=q*B.where(m>0,p1,1-p1)\n   c.conditional_gate(m,[tc.gates.rzz(theta=p[l,3*nq+i]),tc.gates.rzz(theta=p[l,4*nq+i])],nq+i,i)\n  for i in range(nq-1): c.cnot(i,i+1)\n  for i in range(nq): c.rz(i,theta=p[l,5*nq+i])\n den=B.real(B.norm(c.state())**2)\n e=B.convert_to_tensor(0.)\n for i in range(nq-1): e -= B.real(c.expectation_ps(z=[i,i+1]))\n for i in range(nq): e -= 1.05*B.real(c.expectation_ps(x=[i]))\n return e/den\n\ndef run():\n rng=np.random.default_rng(2047)\n p=jnp.asarray(rng.normal(0,.1,(L,6*nq)),dtype=jnp.float32)\n U=jnp.asarray(np.random.default_rng(2048).random((64,L*nq)),dtype=jnp.float32)\n vj=B.jit(B.value_and_grad(energy))\n t=time.time(); hist=[]\n # compile first via actual first trajectory\n for step in range(100):\n  vals=[]; grads=[]\n  for k in range(64):\n   y,g=vj(p,U[k]); vals.append(y); grads.append(g)\n  hist.append(float(jnp.mean(jnp.stack(vals))))\n  grad=jnp.mean(jnp.stack(grads),axis=0)\n  b1=.9;b2=.999;eps=1e-8\n  if step==0: m=jnp.zeros_like(p);v=jnp.zeros_like(p)\n  m=b1*m+(1-b1)*grad;v=b2*v+(1-b2)*grad*grad\n  mh=m/(1-b1**(step+1)); vh=v/(1-b2**(step+1))\n  p=p-.02*mh/(jnp.sqrt(vh)+eps)\n print('time',time.time()-t,'hist0',hist[0],'histlast',hist[-1])\n vals=[float(vj(p,U[k])[0]) for k in range(64)]\n print('final',np.mean(vals),np.std(vals), 'min', min(vals), 'max',max(vals))\n print(hist)\nrun()\nPY\npython -u /tmp/train7.py\"","aggregated_output":"","exit_code":143,"status":"failed"}}
