{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/benchfixed.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np,time\n\ntc.set_backend('jax'); B=tc.backend\nn=16; L=2\n\ndef energy(p,ms):\n c=tc.Circuit(n)\n for l in range(L):\n  for i in range(8): c.ry(i,theta=p[l,i])\n  for i in range(8): c.ry(8+i,theta=p[l,8+i])\n  for i in range(8): c.rzz(8+i,i,theta=p[l,16+i])\n  for i in range(7): c.cnot(8+i,9+i)\n  for i in range(8):\n   c.mid_measure(8+i,keep=ms[l*8+i])\n   c.rzz(8+i,i,theta=p[l,24+i] if ms[l*8+i]==0 else p[l,32+i])\n  for i in range(7): c.cnot(i,i+1)\n  for i in range(8): c.rz(i,theta=p[l,40+i])\n den=B.real(B.norm(c.state())**2)\n e=0.\n for i in range(7): e -= tc.backend.real(c.expectation_ps(z=[i,i+1]))\n for i in range(8): e -= 1.05*tc.backend.real(c.expectation_ps(x=[i]))\n return e/den\np=jnp.array(np.random.default_rng(2).normal(0,.1,(L,48)),dtype=jnp.float32)\nms=np.random.default_rng(3).integers(0,2,16).tolist()\nprint('eager',energy(p,ms))\nvj=B.jit(B.value_and_grad(energy))\nfor i in range(2):\n t=time.time(); y,g=vj(p,ms); print('single',i,time.time()-t,float(y),g.shape)\nPY\npython -u /tmp/benchfixed.py; echo EXIT:\"'$?'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
