{"type":"item.completed","item":{"id":"item_15","type":"agent_message","text":"The installed nightly TensorCircuit exposes `Circuit.cond_measurement(status=...)` and `conditional_gate`, so the protocol can be represented directly with fixed uniforms and autodiff. I’m testing the full 16-qubit circuit path now, including batched trajectory gradients, before writing the final file."}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench7.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np,time\n\ntc.set_backend('jax')\nB=tc.backend\nn=16; L=2\n\ndef energy(p,u):\n c=tc.Circuit(n)\n for l in range(L):\n  for i in range(8): c.ry(i,theta=p[l,i])\n  for i in range(8): c.ry(8+i,theta=p[l,8+i])\n  for i in range(8): c.rzz(8+i,i,theta=p[l,16+i])\n  for i in range(7): c.cnot(8+i,9+i)\n  for i in range(8):\n   m=c.cond_measure(8+i,status=u[l*8+i])\n   c.conditional_gate(m,[tc.gates.rzz(theta=p[l,24+i]),tc.gates.rzz(theta=p[l,32+i])],8+i,i)\n  for i in range(7): c.cnot(i,i+1)\n  for i in range(8): c.rz(i,theta=p[l,40+i])\n e=0.\n for i in range(7): e -= tc.backend.real(c.expectation_ps(z=[i,i+1]))\n for i in range(8): e -= 1.05*tc.backend.real(c.expectation_ps(x=[i]))\n return e\n\np=jnp.array(np.random.default_rng(2).normal(0,.1,(L,48)),dtype=jnp.float32)\nu=jnp.array(np.random.default_rng(3).random((16,)),dtype=jnp.float32)\nprint('eager', energy(p,u))\nvj=B.jit(B.value_and_grad(energy))\nfor i in range(2):\n t=time.time(); y,g=vj(p,u); print('single',i,time.time()-t,float(y),g.shape)\nvm=B.vmap(energy, vectorized_argnums=1)\nobj=B.jit(B.value_and_grad(lambda pp,uu:B.mean(vm(pp,uu))))\nU=jnp.array(np.random.default_rng(3).random((64,16)),dtype=jnp.float32)\nfor i in range(2):\n t=time.time(); y,g=obj(p,U); print('batch',i,time.time()-t,float(y),g.shape)\nPY\npython /tmp/bench7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
