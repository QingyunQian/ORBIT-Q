{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, inspect\ntc.set_backend('jax')\nprint(tc.backend.__class__)\nprint(inspect.getsource(tc.backend.probability_sample))\nPY\"","aggregated_output":"<class 'tensorcircuit.backends.jax_backend.JaxBackend'>\n    def probability_sample(\n        self: Any, shots: int, p: Tensor, status: Optional[Tensor] = None, g: Any = None\n    ) -> Tensor:\n        \"\"\"\n        Drawn ``shots`` samples from probability distribution p, given the external randomness\n        determined by uniform distributed ``status`` tensor or backend random generator ``g``.\n        This method is similar with ``stateful_randc``, but it supports ``status`` beyond ``g``,\n        which is convenient when jit or vmap\n\n        :param shots: Number of samples to draw with replacement\n        :type shots: int\n        :param p: prbability vector\n        :type p: Tensor\n        :param status: external randomness as a tensor with each element drawn uniformly from [0, 1],\n            defaults to None\n        :type status: Optional[Tensor], optional\n        :param g: backend random genrator, defaults to None\n        :type g: Any, optional\n        :return: The drawn sample as an int tensor\n        :rtype: Tensor\n        \"\"\"\n        if status is not None:\n            status = self.convert_to_tensor(status)\n        elif g is not None:\n            status = self.stateful_randu(g, shape=[shots])\n        else:\n            status = self.implicit_randu(shape=[shots])\n        p = p / self.sum(p)\n        p_cuml = self.cumsum(p)\n        r = p_cuml[-1] * (1 - self.cast(status, p.dtype))\n        ind = self.searchsorted(p_cuml, r)\n        a = self.arange(self.shape_tuple(p)[0])\n        res = self.gather1d(a, ind)\n        return res\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_tc.py <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\n\ntc.set_backend('jax')\ndef f(x,u):\n c=tc.Circuit(2)\n c.ry(0,theta=x[0]); c.ry(1,theta=x[1]); c.rzz(0,1,theta=x[2])\n m=c.cond_measure(1,status=u)\n c.conditional_gate(m,[tc.gates.rzz(x[3]),tc.gates.rzz(x[4])],1,0)\n return tc.backend.real(c.expectation((tc.gates.z(),[0])))\nprint(f(jnp.ones(5)*.1,.3))\ng=tc.backend.jit(tc.backend.value_and_grad(f))\nfor i in range(2):\n t=time.time(); y,gr=g(jnp.ones(5)*.1,.3); print(i,time.time()-t,y,gr)\nPY\npython /tmp/test_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
