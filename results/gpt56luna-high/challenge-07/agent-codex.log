{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/benchdynamic.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np,time\n\ntc.set_backend('jax'); B=tc.backend\nn=16; L=2\n\ndef energy(p,u):\n c=tc.Circuit(n)\n q=B.convert_to_tensor(1.0)\n for l in range(L):\n  for i in range(8): c.ry(i,theta=p[l,i])\n  for i in range(8): c.ry(8+i,theta=p[l,8+i])\n  for i in range(8): c.rzz(8+i,i,theta=p[l,16+i])\n  for i in range(7): c.cnot(8+i,9+i)\n  for i in range(8):\n   z=B.real(c.expectation_ps(z=[8+i]))\n   p1=(q-z)/(2*q)\n   m=B.cast(B.less_equal(u[l*8+i],p1),'int32')\n   md=B.cast(m,'float32')\n   proj=B.stack([B.stack([1-md,B.convert_to_tensor(0.)]),B.stack([B.convert_to_tensor(0.),md])])\n   c.any(8+i,unitary=proj)\n   q=q*B.where(m>0,p1,1-p1)\n   c.conditional_gate(m,[tc.gates.rzz(theta=p[l,24+i]),tc.gates.rzz(theta=p[l,32+i])],8+i,i)\n  for i in range(7): c.cnot(i,i+1)\n  for i in range(8): c.rz(i,theta=p[l,40+i])\n den=B.real(B.norm(c.state())**2)\n e=0.\n for i in range(7): e -= B.real(c.expectation_ps(z=[i,i+1]))\n for i in range(8): e -= 1.05*B.real(c.expectation_ps(x=[i]))\n return e/den\np=jnp.array(np.random.default_rng(2).normal(0,.1,(L,48)),dtype=jnp.float32)\nu=jnp.array(np.random.default_rng(3).random((16,)),dtype=jnp.float32)\nprint('eager',energy(p,u))\nvj=B.jit(B.value_and_grad(energy))\nfor i in range(2):\n t=time.time(); y,g=vj(p,u); print('single',i,time.time()-t,float(y),g.shape)\nPY\npython -u /tmp/benchdynamic.py; echo EXIT:\"'$?'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
