             c.exp(  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/utils.py:230:                c.exp(  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/utils.py:247:                yp += cnnp[3 * epochs + 1, i] * c.expectation(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/utils.py:292:            c.exp(  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/utils.py:300:            c.exp(  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/utils.py:317:            yp += cnnp[3 * epochs + 1, i] * c.expectation(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/layers.py:190:            circuit.apply_general_kraus(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/layers.py:193:            circuit.apply_general_kraus(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/layers.py:320:        ci.apply_general_kraus(depolarizingchannel(px, py, pz), [(i,)])\n/usr/local/lib/python3.11/site-packages/tensorcircuit/__init__.py:33:from .circuit import Circuit, expectation\n/usr/local/lib/python3.11/site-packages/tensorcircuit/translation.py:91:    return np.real(backend.numpy(gates.array_to_tensor(parameters.get(key, default)))).item()  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/translation.py:372:                    \"omit non unitary gate in tensorcircuit when transforming to qiskit: %s\"\n/usr/local/lib/python3.11/site-packages/tensorcircuit/translation.py:432:def ctrl_str2ctrl_state(ctrl_str: str, nctrl: int) -> List[int]:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/translation.py:536:            tc_circuit.exp(*idx, theta=parameters[-1], unitary=parameters[0])\n/usr/local/lib/python3.11/site-packages/tensorcircuit/translation.py:543:                ctrl_state = ctrl_str2ctrl_state(gate_name[5:], len(idx) - 1)\n","exit_code":0,"sta