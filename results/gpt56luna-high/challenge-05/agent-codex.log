{"type":"item.completed","item":{"id":"item_24","type":"agent_message","text":"The framework-native route is now working efficiently: a single TensorCircuit circuit is built layer by layer, and after each layer I compute its norm and apply the inverse norm as a scalar identity gate, so the circuit remains continuous while honoring per-layer rescaling. With JAX JIT, one loss/gradient evaluation is about 0.30 seconds; I’m testing a compiled Adam scan to keep all 600 required updates within the time limit."}}
{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time,jax,jax.numpy as jnp,tensorcircuit as tc\nprint('imports');tc.set_backend('jax');tc.set_dtype('complex64');K=tc.backend;n=18;plus=jnp.ones(2**n,dtype=jnp.complex64)/(2**(n/2));X=tc.gates.x().tensor;Z=tc.gates.z().tensor;I=tc.gates.i().tensor\nss=[];ww=[]\nfor i in range(n-1):s=[0]*n;s[i]=s[i+1]=3;ss.append(s);ww.append(-1.)\nfor i in range(n):s=[0]*n;s[i]=1;ss.append(s);ww.append(-1.1)\nmvp=tc.quantum.PauliStringSum2MVP(ss,ww)\ndef loss(p):\n c=tc.Circuit(n,inputs=plus)\n for l in range(10):\n  a=tc.gates.exponential_gate(X,1j*p[0,l]).tensor;b=tc.gates.exponential_gate(jnp.kron(Z,Z),1j*p[1,l]).tensor\n  for i in range(n):c.any(i,unitary=a)\n  for i in range(l%2,n-1,2):c.any(i,i+1,unitary=b)\n  s=c.state();norm=K.sqrt(K.real(K.sum(K.conj(s)*s)));c.any(0,unitary=I/norm)\n s=c.state();return K.real(K.sum(K.conj(s)*mvp(s)))/n\nvg=jax.value_and_grad(loss)\ndef body(carry, _):\n p,m,v,t=carry\n e,g=vg(p); t=t+1\n m=.9*m+.1*g;v=.999*v+.001*g*g\n p=p-.02*m/(K.sqrt(v)+1e-8)\n return (p,m,v,t),e\n\ndef run(p):\n carry=(p,jnp.zeros_like(p),jnp.zeros_like(p),jnp.array(0,dtype=jnp.int32))\n return jax.lax.scan(body,carry,jnp.arange(600))[0:2]\np=jnp.ones((2,10),dtype=jnp.float32)*.01\nprint('start');t=time.time();f=jax.jit(run);out=f(p);out[1].block_until_ready();print('done',time.time()-t,float(out[1][0]),float(out[1][-1]),out[0][0].shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time,jax,jax.numpy as jnp,tensorcircuit as tc\nprint('imports');tc.set_backend('jax');tc.set_dtype('complex64');K=tc.backend;n=18;plus=jnp.ones(2**n,dtype=jnp.complex64)/(2**(n/2));I=tc.gates.i().tensor\nZ=tc.gates.z().tensor\nss=[];ww=[]\nfor i in range(n-1):s=[0]*n;s[i]=s[i+1]=3;ss.append(s);ww.append(-1.)\nfor i in range(n):s=[0]*n;s[i]=1;ss.append(s);ww.append(-1.1)\nmvp=tc.quantum.PauliStringSum2MVP(ss,ww)\ndef loss(p):\n c=tc.Circuit(n,inputs=plus)\n for l in range(10):\n  a=p[0,l];b=p[1,l]\n  ag=K.reshape(K.stack([K.cosh(a),K.sinh(a),K.sinh(a),K.cosh(a)]),[2,2])\n  bg=K.reshape(K.stack([K.exp(b),K.exp(-b),K.exp(-b),K.exp(b)]),[2,2,2,2])\n  for i in range(n):c.any(i,unitary=ag)\n  for i in range(l%2,n-1,2):c.any(i,i+1,unitary=bg)\n  s=c.state();norm=K.sqrt(K.real(K.sum(K.conj(s)*s)));c.any(0,unitary=I/norm)\n s=c.state();return K.real(K.sum(K.conj(s)*mvp(s)))/n\np=jnp.ones((2,10),dtype=jnp.float32)*.01\nprint('plain',loss(p)); f=jax.jit(jax.value_and_grad(loss));print('call');t=time.time();v,g=f(p);v.block_until_ready();print('compiled',time.time()-t,float(v));t=time.time();\nfor _ in range(5):v,g=f(p);v.block_until_ready()\nprint('5',(time.time()-t)/5)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
