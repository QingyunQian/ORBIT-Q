{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend('jax'); tc.set_dtype('complex64')\nK=tc.backend\nn=18\nplus=jnp.ones(2**n,dtype=jnp.complex64)/(2**(n/2))\nX=tc.gates.x().tensor\nZ=tc.gates.z().tensor\n\ndef one(a): return tc.gates.exponential_gate(X, 1j*a)\ndef two(b): return tc.gates.exponential_gate(jnp.kron(Z,Z), 1j*b)\n\ndef loss(p):\n    s=plus\n    for l in range(10):\n        c=tc.Circuit(n, inputs=s)\n        for i in range(n): c.any(i, unitary=one(p[0,l]))\n        for i in range(l%2,n-1,2): c.any(i,i+1,unitary=two(p[1,l]))\n        s=c.state(); s=s/K.sqrt(K.real(K.sum(K.conj(s)*s)))\n    c=tc.Circuit(n, inputs=s)\n    e=0\n    for i in range(n-1): e -= K.real(c.expectation_ps(z=[i,i+1]))\n    for i in range(n): e -= 1.1*K.real(c.expectation_ps(x=[i]))\n    return e/n\n\np=jnp.ones((2,10),dtype=jnp.float32)*.01\nprint('plain',loss(p))\nt0=time.time(); f=jax.jit(jax.value_and_grad(loss)); print('compile call'); v,g=f(p); print('compiled',time.time()-t0, v, jnp.max(jnp.abs(g)), g.shape)\nt0=time.time();\nfor _ in range(5): v,g=f(p); v.block_until_ready()\nprint('5', (time.time()-t0)/5, v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
