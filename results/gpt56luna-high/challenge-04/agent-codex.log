{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench4.py <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\n\ntc.set_backend('jax'); N=12; theta=.31\npairs_even=tuple((i,i+1) for i in range(0,N,2)); pairs_odd=tuple((i,i+1) for i in range(1,N-1,2))\ndef states():\n s0=jnp.zeros((2**N,),dtype=jnp.complex64).at[0].set(1/jnp.sqrt(2)).at[-1].set(1/jnp.sqrt(2))\n pair=jnp.array([0,1,1,0],dtype=jnp.complex64)/jnp.sqrt(2); s1=pair\n for _ in range(5): s1=jnp.kron(s1,pair)\n s2=jnp.zeros((2**N,),dtype=jnp.complex64).at[0].set(1)\n s3=jnp.ones((2**N,),dtype=jnp.complex64)/jnp.sqrt(2**N)\n return (s0,s1,s2,s3)\npsis=states()\ndef ks(p01,p10):\n z=jnp.zeros((),dtype=jnp.complex64)\n return (tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]],dtype=jnp.complex64)))\ndef probe(psi,p01,p10):\n c=tc.DMCircuit2(N,inputs=psi); k=ks(p01,p10)\n for a,b in pairs_even+pairs_odd:\n  c.rxx(a,b,theta=theta); c.apply_general_kraus(k,a); c.apply_general_kraus(k,b)\n e=[tc.backend.real(c.expectation_ps(z=[i])) for i in range(N)]\n e.append(tc.backend.real(c.expectation_ps(z=range(N))))\n return tc.backend.stack(e)\ndef all_exp(x):\n p01=jax.nn.sigmoid(x[0]); p10=jax.nn.sigmoid(x[1])\n return tc.backend.stack([probe(s,p01,p10) for s in psis])\n[REDACTED]=jnp.array([jnp.log(.034/(1-.034)),jnp.log(.011/(1-.011))])\ninit=jnp.array([jnp.log(.07/(1-.07)),jnp.log(.04/(1-.04))])\nstart=time.time(); target=all_exp([REDACTED]); print('target',time.time()-start)\ndef loss(x): return jnp.mean((all_exp(x)-target)**2)\nvg=jax.jit(jax.value_and_grad(loss));\nstart=time.time(); print('compile',vg(init),time.time()-start)\nm=jnp.zeros(2); v=jnp.zeros(2); x=init; hist=[]\nstart=time.time()\nfor i in range(120):\n l,g=vg(x); hist.append(l)\n m=.9*m+.1*g; v=.999*v+.001*g*g\n mh=m/(1-.9**(i+1)); vh=v/(1-.999**(i+1))\n x=x-.04*mh/(jnp.sqrt(vh)+1e-8)\nprint('train',time.time()-start,'x',x,'p',jax.nn.sigmoid(x),'losses',hist[0],hist[-1],loss(x), 'finalexp',all_exp(x))\nPY\npython /tmp/bench4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
