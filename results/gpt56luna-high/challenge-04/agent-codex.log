{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_tc.py <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\nfrom tensorcircuit import gates\n\ntc.set_backend('jax')\nN=12; theta=0.31\n\ndef st(kind):\n  if kind==0:\n    v=jnp.zeros((2**N,),dtype=jnp.complex64).at[0].set(1/jnp.sqrt(2)).at[-1].set(1/jnp.sqrt(2)); return v\n  if kind==1:\n    a=jnp.zeros((2**N,),dtype=jnp.complex64)\n    for q in range(0,N,2):\n      # pair pattern computational bits; construct via integer\n      pass\n    v=jnp.zeros((2**N,),dtype=jnp.complex64)\n    for k in range(0,N,2):\n      b=(1<<(N-1-k)) | (1<<(N-1-(k+1))) # no, pair all states impossible\n    # bell-like product pairs enumerate bitstrings\n    v=v.at[0].set(1)\n    for k in range(0,N,2):\n      # tensor product via state vector use kron\n      pair=jnp.array([0,1,1,0],dtype=jnp.complex64)/jnp.sqrt(2)\n      if k==0: v=pair\n      else: v=jnp.kron(v,pair)\n    return v\n  if kind==2:\n    v=jnp.zeros((2**N,),dtype=jnp.complex64).at[0].set(1); return v\n  return jnp.ones((2**N,),dtype=jnp.complex64)/jnp.sqrt(2**N)\n\ndef kraus(p01,p10):\n  z=jnp.zeros((),dtype=jnp.complex64); one=jnp.ones((),dtype=jnp.complex64)\n  return [tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]],dtype=jnp.complex64)),\n          tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]],dtype=jnp.complex64)),\n          tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]],dtype=jnp.complex64))]\n\ndef circ(psi,p01,p10):\n  c=tc.DMCircuit2(N,inputs=psi)\n  ks=kraus(p01,p10)\n  for a,b in [(i,i+1) for i in range(0,N,2)]+[(i,i+1) for i in range(1,N-1,2)]:\n    c.rxx(a,b,theta=theta)\n    c.apply_general_kraus(ks,a); c.apply_general_kraus(ks,b)\n  out=[]\n  for i in range(N): out.append(tc.backend.real(c.expectation_ps(z=[i])))\n  out.append(tc.backend.real(c.expectation_ps(z=list(range(N)))))\n  return tc.backend.stack(out)\n\nstart=time.time(); y=circ(st(0),.034,.011); print('one',time.time()-start,y)\nstart=time.time(); y2=circ(st(1),.034,.011); print('two',time.time()-start,y2)\n\ndef f(x): return jnp.sum(circ(st(0),jax.nn.sigmoid(x[0]),jax.nn.sigmoid(x[1])))\nstart=time.time(); print('grad eager',jax.grad(f)(jnp.array([-.1,-1.])),time.time()-start)\nstart=time.time(); jf=jax.jit(jax.value_and_grad(f)); print('jit compile/run',jf(jnp.array([-.1,-1.])),time.time()-start)\nstart=time.time(); print('jit again',jf(jnp.array([-.2,-.8])),time.time()-start)\nPY\npython /tmp/test_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
