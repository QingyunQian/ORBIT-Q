{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/poly_compare.py <<'PY'\nimport numpy as np, jax.numpy as jnp, tensorcircuit as tc\nfrom tensorcircuit.pauliprop import PauliPropagationEngine\ntc.set_backend('jax');N=12;theta=.31\neven=tuple((i,i+1) for i in range(0,N,2));odd=tuple((i,i+1) for i in range(1,N-1,2))\npp=PauliPropagationEngine(2,2);up=np.asarray(pp.get_ptm_2q(tc.gates.rxx(theta=theta).tensor.reshape(4,4)))\numaps=[[(j,float(up[i,j])) for j in range(16) if abs(up[i,j])>1e-6] for i in range(16)]\nops=[]\nfor pair in even+odd: ops += [('u',pair),('c',pair[0]),('c',pair[1])]\n# terms key (word,ns,nd,na) -> coeff\n\ndef structure(word):\n terms={(word,0,0,0):1.}\n for typ,site in ops[::-1]:\n  out={}\n  for (w,ns,nd,na),v in terms.items():\n   if typ=='c':\n    old=w[site]\n    choices=((0,0,1,0.),(1,1,0,0.)) if old==1 else ((2,1,0,0.),) if old==2 else ((0,0,1,0.),) # wrong\n    # explicit destination, exponents, factor\n    if old==0: choices=((0,0,0,0,1.),)\n    elif old in (1,2): choices=((old,1,0,0,1.),)\n    elif old==3: choices=((0,0,1,0,1.),(3,0,0,1,1.))\n    for new,ds,dd,da,f in choices:\n     ww=list(w);ww[site]=new;key=(tuple(ww),ns+ds,nd+dd,na+da);out[key]=out.get(key,0)+v*f\n   else:\n    q,r=site; old=4*w[q]+w[r]\n    for new,f in umaps[old]:\n     ww=list(w);ww[q]=new//4;ww[r]=new%4;key=(tuple(ww),ns,nd,na);out[key]=out.get(key,0)+v*f\n  terms={k:v for k,v in out.items() if abs(v)>1e-7}\n return terms\nterms=[structure(tuple(3 if q==i else 0 for q in range(N))) for i in range(N)] + [structure((3,)*N)]\nprint('term counts',list(map(len,terms)),sum(map(len,terms)))\n# initial expectations analytic\ndef init_exp(w,p):\n if p==0: # GHZ\n  if all(x in (0,3) for x in w): return 1. if sum(x==3 for x in w)%2==0 else 0.\n  if all(x in (1,2) for x in w) and all(x\"'!=0 for x in w):\n   m=sum(x==2 for x in w);return (-1.)**(m//2) if m%2==0 else 0.\n  return 0.\n if p==1:\n  v=1.\n  for q in range(0,N,2):\n   a,b=w[q:q+2]\n   if (a,b)==(0,0):pass\n   elif a==b and a in (1,2,3):v*=1 if a in (1,2) else -1\n   else:return 0.\n  return v\n if p==2:return 1. if all(x in (0,3) for x in w) else 0.\n return 1. if all(x in (0,1) for x in w) else 0.\nwords=sorted(set(k[0] for t in terms for k in t));wi={w:i for i,w in enumerate(words)}; ex=np.array([[init_exp(w,p) for w in words] for p in range(4)])\n# aggregate coefficient by output, exponent; directly compute for exp\n\ndef all_poly(p01,p10):\n s=jnp.sqrt((1-p01)*(1-p10));d=p10-p01;a=1-p01-p10\n rows=[]\n for t in terms:\n  val=[]\n  for p in range(4):\n   z=0.\n   for (w,ns,nd,na),c in t.items(): z += c*ex[p,wi[w]]*s**ns*d**nd*a**na\n   val.append(z)\n  rows.append(jnp.stack(val))\n return jnp.stack(rows,axis=1)\nsp=np.asarray(all_poly(.034,.011));print('\"'poly',sp)\n# dense direct one\n\ndef dense(psi,p01,p10):\n z=jnp.zeros((),dtype=jnp.complex64); k=(tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]],dtype=jnp.complex64)))\n c=tc.DMCircuit2(N,inputs=psi)\n for a,b in even+odd:\n  c.rxx(a,b,theta=theta);c.apply_general_kraus(tuple(tc.gates.Gate(jnp.kron(x.tensor,y.tensor)) for x in k for y in k),a,b)\n e=[tc.backend.real(c.expectation_ps(z=[i])) for i in range(N)];e.append(tc.backend.real(c.expectation_ps(z=range(N))))\n return np.asarray(e)\ns0=jnp.zeros(2**N,dtype=jnp.complex64).at[0].set(1/jnp.sqrt(2)).at[-1].set(1/jnp.sqrt(2));pair=jnp.array([0,1,1,0],dtype=jnp.complex64)/jnp.sqrt(2);s1=pair\nfor _ in range(5):s1=jnp.kron(s1,pair)\ns2=jnp.zeros(2**N,dtype=jnp.complex64).at[0].set(1);s3=jnp.ones(2**N,dtype=jnp.complex64)/jnp.sqrt(2**N)\nfor i,s in enumerate([s0,s1,s2,s3]):\n d=dense(s,.034,.011);print(i,np.max(abs(d-sp[i])),d,sp[i])\nPY\npython -u /tmp/poly_compare.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/sparse_train.py <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\nfrom tensorcircuit.pauliprop import PauliPropagationEngine\n\ntc.set_backend('jax')\nN=12; theta=.31\neven=tuple((i,i+1) for i in range(0,N,2)); odd=tuple((i,i+1) for i in range(1,N-1,2))\npp=PauliPropagationEngine(2,2)\nup=np.asarray(pp.get_ptm_2q(tc.gates.rxx(theta=theta).tensor.reshape(4,4)))\numaps=[[(j,float(up[i,j])) for j in range(16) if abs(up[i,j])>1e-6] for i in range(16)]\ncmaps=[[(0,'I'),] for _ in range(4)]\ncmaps[1]=[(1,'s')];cmaps[2]=[(2,'s')];cmaps[3]=[(0,'d'),(3,'a')]\nops=[]\nfor a,b in even+odd:ops += [('u',(a,b)),('c',a),('c',b)]\ndef terms_for(word):\n t={word:1.}\n for typ,site in ops[::-1]:\n  out={}\n  for w,v in t.items():\n   if typ=='c':\n    for j,label in cmaps[w[site]]:\n     ww=list(w);ww[site]=j;ww=tuple(ww);out[ww]=out.get(ww,0.) + v # label applied at runtime\n   else:\n    a,b=site\n    for j,f in umaps[4*w[a]+w[b]]:\n     ww=list(w);ww[a]=j//4;ww[b]=j%4;ww=tuple(ww);out[ww]=out.get(ww,0.) + v*f\n  t={w:v for w,v in out.items() if abs(v)>1e-7}\n return t\n# maps from output observable to final Pauli strings and static RXX factors; channel factors evaluated dynamically per operation\ntarget_words=[tuple(3 if q==i else 0 for q in range(N)) for i in range(N)]+[tuple([3]*N)]\nall_terms=[terms_for(w) for w in target_words]\nprint('counts',sum(map(len,all_terms)),len(all_terms))\ndef init_exp(w,p):\n if p==0:\n  if all(x in (0,3) for x in w): return float(sum(x==3 for x in w)%2==0)\n  if all(x in (1,2) for x in w):\n   m=sum(x==2 for x in w); return float((-1)**(m//2)) if m%2==0 else 0.\n  return 0.\n if p==1:\n  v=1.\n  for q in range(0,N,2):\n   a,b=w[q:q+2]\n   if (a,b)==(0,0):continue\n   if a==b and a in (1,2):continue\n   if a==b==3:v*=-1;continue\n   return 0.\n  return v\n if p==2:return float(all(x in (0,3) for x in w))\n return float(all(x in (0,1) for x in w))\n# channel PTM from explicit Kraus tensor algebra\ndef cptm(p01,p10):\n z=jnp.zeros((),dtype=jnp.complex64)\n k=(tc.gates.Gate(jnp.stack((jnp.stack((jnp.sqrt(1-p01),z)),jnp.stack((z,jnp.sqrt(1-p10)))))),tc.gates.Gate(jnp.stack((jnp.stack((z,jnp.sqrt(p10))),jnp.stack((z,z)))))),tc.gates.Gate(jnp.stack((jnp.stack((z,z)),jnp.stack((jnp.sqrt(p01),z))))))\n kt=jnp.stack([x.tensor for x in k]); pa=jnp.asarray(np.array([[[1,0],[0,1]],[[0,1],[1,0]],[[0,-1j],[1j,0]],[[1,0],[0,-1]]],np.complex64))\n h=jnp.einsum('kba,ibc,kcd->iad',jnp.conj(kt),pa,kt)\n return jnp.real(.5*jnp.einsum('jda,iad->ij',pa,h))\ndef all_exp(r):\n cp=cptm(jax.nn.sigmoid(r[0]),jax.nn.sigmoid(r[1]))\n rows=[]\n for terms in all_terms:\n  vals=[]\n  for p in range(4):\n   val=0.\n   for w,static in terms.items():\n    # Reconstruct channel factor by a short backward pass for this final word is not available;\n    # Instead static term propagation below is repeated with dynamic values.\n    val += static*init_exp(w,p)\n   vals.append(val)\n  rows.append(vals)\n # placeholder wrong: dynamic factors absent\n return jnp.asarray(rows)\n# dynamic propagation, kept separate to retain exact channel factors\ndef one(r,word,p):\n cp=cptm(jax.nn.sigmoid(r[0]),jax.nn.sigmoid(r[1])); t={word:jnp.asarray(1.,dtype=jnp.float32)}\n for typ,site in ops[::-1]:\n  out={}\n  for w,v in t.items():\n   if typ=='c':\n    for j,label in cmaps[w[site]]:\n     ww=list(w);ww[site]=j;ww=tuple(ww);out[ww]=out.get(ww,0.)+v*cp[w[site],j]\n   else:\n    a,b=site\n    for j,f in umaps[4*w[a]+w[b]]:\n     ww=list(w);ww[a]=j//4;ww[b]=j%4;ww=tuple(ww);out[ww]=out.get(ww,0.)+v*f\n  t={w:v for w,v in out.items() if abs(v)>1e-7}\n return jnp.asarray([sum(v*init_exp(w,p) for w,v in t.items()) for p in range(4)])\ndef expall(r):return jnp.stack([one(r,w) for w in target_words],axis=1)\n[REDACTED]=jnp.array([np.log(.034/.966),np.log(.011/.989)]);init=jnp.array([np.log(.07/.93),np.log(.04/.96)])\nstart=time.time();target=expall([REDACTED]);print('target',time.time()-start,target)\ndef loss(r):return jnp.mean((expall(r)-target)**2)\nvg=jax.jit(jax.value_and_grad(loss));x=init;m=jnp.zeros(2);v=jnp.zeros(2);hist=[];start=time.time()\nfor i in range(10):\n l,g=vg(x);l.block_until_ready();hist.append(l);print('step',i,float(l),flush=True)\n m=.9*m+.1*g;v=.999*v+.001*g*g;mh=m/(1-.9**(i+1));vh=v/(1-.999**(i+1));x=x-.04*mh/(jnp.sqrt(vh)+1e-8)\nprint('train',time.time()-start,'p',jax.nn.sigmoid(x),'loss',loss(x))\nPY\npython -u /tmp/sparse_train.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
