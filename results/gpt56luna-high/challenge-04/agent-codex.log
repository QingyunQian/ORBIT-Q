{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/benchtorch.py <<'PY'\nimport time,numpy as np, torch, tensorcircuit as tc\ntc.set_backend('pytorch'); N=12; theta=.31\npairs=tuple((i,i+1) for i in range(0,N,2))+tuple((i,i+1) for i in range(1,N-1,2))\ndef states():\n s0=torch.zeros(2**N,dtype=torch.complex64); s0[0]=1/np.sqrt(2); s0[-1]=1/np.sqrt(2)\n pair=torch.tensor([0,1,1,0],dtype=torch.complex64)/np.sqrt(2); s1=pair\n for _ in range(5):s1=torch.kron(s1,pair)\n s2=torch.zeros(2**N,dtype=torch.complex64);s2[0]=1;s3=torch.ones(2**N,dtype=torch.complex64)/np.sqrt(2**N)\n return s0,s1,s2,s3\npsis=states()\ndef probe(psi,p01,p10):\n z=torch.zeros((),dtype=torch.complex64); k=(torch.stack((torch.stack((torch.sqrt(1-p01),z)),torch.stack((z,torch.sqrt(1-p10))))),torch.stack((torch.stack((z,torch.sqrt(p10))),torch.stack((z,z)))),torch.stack((torch.stack((z,z)),torch.stack((torch.sqrt(p01),z)))))\n c=tc.DMCircuit2(N,inputs=psi); u=torch.reshape(tc.gates.rxx(theta=theta).tensor,(4,4))\n for a,b in pairs:c.apply_general_kraus(tuple(tc.gates.Gate(torch.kron(x,y)@u) for x in k for y in k),a,b)\n e=[torch.real(c.expectation_ps(z=[i])) for i in range(N)]; e.append(torch.real(c.expectation_ps(z=range(N))))\n return torch.stack(e)\ndef all_exp(x): return torch.stack([probe(s,torch.sigmoid(x[0]),torch.sigmoid(x[1])) for s in psis])\n[REDACTED]=torch.tensor([np.log(.034/.966),np.log(.011/.989)]); init=torch.tensor([np.log(.07/.93),np.log(.04/.96)])\nstart=time.time();target=all_exp([REDACTED]);print('target',time.time()-start,flush=True)\ndef loss(x):return torch.mean((all_exp(x)-target)**2)\nx=init.clone().requires_grad_();opt=torch.optim.Adam([x],lr=.04); hist=[];start=time.time()\nfor i in range(10):\n l=loss(x);hist.append(l.detach().numpy().item());l.backward();opt.step();opt.zero_grad();print('step',i,l.item(),flush=True)\nprint('train',time.time()-start,'p',torch.sigmoid(x).detach().numpy(),'loss',loss(x).item())\nPY\npython -u /tmp/benchtorch.py; echo EXIT:\"'$?'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
