{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/combined_forward.py <<'PY'\nimport time,numpy as np,jax,jax.numpy as jnp,tensorcircuit as tc\nfrom tensorcircuit.pauliprop import PauliPropagationEngine\ntc.set_backend('jax');N=12;theta=.31\neven=tuple((i,i+1) for i in range(0,N,2));odd=tuple((i,i+1) for i in range(1,N-1,2));pp=PauliPropagationEngine(2,2)\nup=np.asarray(pp.get_ptm_2q(tc.gates.rxx(theta=theta).tensor.reshape(4,4)));um=[[(j,float(up[i,j])) for j in range(16) if abs(up[i,j])>1e-6] for i in range(16)]\ncm=[[(0,'I')] for _ in range(4)];cm[1]=[(1,'s')];cm[2]=[(2,'s')];cm[3]=[(0,'d'),(3,'a')]\nops=[]\nfor a,b in even+odd:ops += [('u',(a,b)),('c',a),('c',b)]\ndef initial(w,p):\n if p==0:\n  if all(x in(0,3) for x in w):return float(sum(x==3 for x in w)%2==0)\n  if all(x in(1,2) for x in w):\n   m=sum(x==2 for x in w);return float((-1)**(m//2)) if m%2==0 else 0.\n  return 0.\n if p==1:\n  v=1.\n  for q in range(0,N,2):\n   a,b=w[q:q+2]\n   if (a,b)==(0,0) or (a==b and a in(1,2)):continue\n   if a==b==3:v*=-1;continue\n   return 0.\n  return v\n if p==2:return float(all(x in(0,3) for x in w))\n return float(all(x in(0,1) for x in w))\ndef build(obs):\n stages=[set(obs)]\n for typ,site in ops[::-1]:\n  nxt=set()\n  for w in stages[-1]:\n   if typ=='c':\n    for j,_ in cm[w[site]]:x=list(w);x[site]=j;nxt.add(tuple(x))\n   else:\n    a,b=site\n    for j,_ in um[4*w[a]+w[b]]:x=list(w);x[a]=j//4;x[b]=j%4;nxt.add(tuple(x))\n  stages.append(nxt)\n words=sorted(set().union(*stages));wi={w:i for i,w in enumerate(words)}\n tr=[]\n for (typ,site),cur in zip(ops[::-1],stages[:-1]):\n  src=[];dst=[];q0=[];q1=[];fac=[]\n  for w in cur:\n   if typ=='c':\n    for j,_ in cm[w[site]]:\n     x=list(w);x[site]=j;src.append(wi[w]);dst.append(wi[tuple(x)]);q0.append(w[site]);q1.append(j);fac.append(1.)\n   else:\n    a,b=site\n    for j,f in um[4*w[a]+w[b]]:\n     x=list(w);x[a]=j//4;x[b]=j%4;src.append(wi[w]);dst.append(wi[tuple(x)]);q0.append(0);q1.append(0);fac.append(f)\n  tr.append((typ,np.asarray(src,np.int32),np.asarray(dst,np.int32),np.asarray(q0,np.int32),np.asarray(q1,np.int32),np.asarray(fac,np.float32)))\n ex=jnp.asarray(np.array([[initial(w,p) for p in range(4)] for w in words],np.float32));ids=np.asarray([wi[w] for w in obs],np.int32)\n return tr,ex,ids,len(obs),len(words)\ndef cptm(r):\n p01=jax.nn.sigmoid(r[0]);p10=jax.nn.sigmoid(r[1]);z=jnp.zeros((),dtype=jnp.complex64)\n k=(tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]])),tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]])),tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]])))\n kt=jnp.stack([x.tensor for x in k]);pa=jnp.asarray(np.array([[[1,0],[0,1]],[[0,1],[1,0]],[[0,-1j],[1j,0]],[[1,0],[0,-1]]],np.complex64));h=jnp.einsum('kba,ibc,kcd->iad',jnp.conj(kt),pa,kt)\n return jnp.real(.5*jnp.einsum('jda,iad->ij',pa,h))\ndef make_eval(obs):\n tr,ex,ids,no,M=build(obs)\n def ev(r):\n  v=cptm(r);dv=jax.jacfwd(cptm)(r);st=jnp.zeros((no,M),jnp.float32).at[np.arange(no),ids].set(1.);dt=jnp.zeros((2,no,M),jnp.float32)\n  for typ,src,dst,q0,q1,fac in tr:\n   si=jnp.asarray(src);di=jnp.asarray(dst);f=v[jnp.asarray(q0),jnp.asarray(q1)] if typ=='c' else jnp.asarray(fac);df=jax.lax.select(jnp.asarray(typ=='c'),jnp.zeros_like(f),jnp.zeros_like(f))\n   if typ=='c':df=dv[jnp.asarray(q0),jnp.asarray(q1),:]\n   else:df=jnp.zeros((len(src),2),jnp.float32)\n   old=st;st=jnp.zeros_like(st).at[:,di].add(old[:,si]*f)\n   for k in range(2):dt=dt.at[k].set(jnp.zeros_like(dt[k]).at[:,di].add(dt[k][:,si]*f+old[:,si]*df[:,k]))\n  out=(st@ex).T;der=jnp.stack([(dt[k]@ex).T for k in range(2)]);return out,der\n return jax.jit(ev),M\nsingles=[tuple(3 if q==i else 0 for q in range(N)) for i in range(N)];parity=[tuple([3]*N)]\nsev,sm=make_eval(singles);pev,pm=make_eval(parity);[REDACTED]=jnp.array([np.log(.034/.966),np.log(.011/.989)]);x=jnp.array([np.log(.07/.93),np.log(.04/.96)])\nts,_=sev([REDACTED]);tp,_=pev([REDACTED]);target=jnp.concatenate((ts,tp),axis=1);target.block_until_ready();print('built',sm,pm,flush=True)\nm=jnp.zeros(2);v=jnp.zeros(2);hist=[];start=time.time()\nfor i in range(120):\n ys,ds=sev(x);yp,dp=pev(x);out=jnp.concatenate((ys,yp),axis=1);der=jnp.concatenate((ds,dp),axis=2);diff=out-target;l=jnp.mean(diff*diff);g=2*jnp.mean(diff[None]*der,axis=(1,2));l.block_until_ready();hist.append(float(l));m=.9*m+.1*g;v=.999*v+.001*g*g;mh=m/(1-.9**(i+1));vh=v/(1-.999**(i+1));x=x-.04*mh/(jnp.sqrt(vh)+1e-8)\nprint('done',time.time()-start,'p',jax.nn.sigmoid(x),'h',hist[0],hist[-1], 'loss',jnp.mean((jnp.concatenate((sev(x)[0],pev(x)[0]),1)-target)**2))\nPY\npython -u /tmp/combined_forward.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
