{"type":"item.completed","item":{"id":"item_33","type":"agent_message","text":"The dense exact density-matrix route is not viable for repeated optimization on this CPU: each autodiff contraction retains several gigabytes, so even two successive full evaluations approach the memory limit. I found a framework-native exact alternative: propagate each requested Pauli observable backward through the fixed RXX PTMs and the explicit Kraus adjoint PTM, then evaluate the resulting Pauli strings with TensorCircuit’s circuit expectation API. This avoids raw state-vector evolution while preserving the exact noisy-circuit objective and should make the 120 Adam steps practical."}}
{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/sparse_compare.py <<'PY'\nimport numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\nfrom tensorcircuit.pauliprop import PauliPropagationEngine\n\ntc.set_backend('jax');N=12;theta=.31\neven=tuple((i,i+1) for i in range(0,N,2));odd=tuple((i,i+1) for i in range(1,N-1,2))\nP=np.array([[[1,0],[0,1]],[[0,1],[1,0]],[[0,-1j],[1j,0]],[[1,0],[0,-1]]],np.complex64)\npp=PauliPropagationEngine(2,2)\nup=np.asarray(pp.get_ptm_2q(tc.gates.rxx(theta=theta)))\nprint('uptm',np.round(up,3))\ndef cp_numpy(p01,p10):\n K=np.array([[[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],[[0,np.sqrt(p10)],[0,0]],[[0,0],[np.sqrt(p01),0]]],np.complex64)\n h=np.einsum('kba,ibc,kcd->iad',K.conj(),P,K)\n return np.real(.5*np.einsum('jda,iad->ij',P,h))\ncp0=cp_numpy(.034,.011);print('cp',cp0)\n\ndef maps(M,size):\n return [[(j,float(M[i,j])) for j in range(size) if abs(M[i,j])>1e-6] for i in range(size)]\numaps=maps(up,16); cmaps=maps(cp0,4)\nops=[]\nfor pair in even:\n ops += [('u',pair),('c', (pair[0],)),('c',(pair[1],))]\nfor pair in odd:\n ops += [('u',pair),('c',(pair[0],)),('c',(pair[1],))]\n# reverse propagation\n\ndef structure(word):\n terms={word:1.}\n for typ,sites in ops[::-1]:\n  out={}\n  if typ=='c':\n   q=sites[0]\n   for w,a in terms.items():\n    for j,f in cmaps[w[q]]:\n     ww=list(w);ww[q]=j;ww=tuple(ww);out[ww]=out.get(ww,0)+a*f\n  else:\n   q,r=sites\n   for w,a in terms.items():\n    old=4*w[q]+w[r]\n    for j,f in umaps[old]:\n     ww=list(w);ww[q]=j//4;ww[r]=j%4;ww=tuple(ww);out[ww]=out.get(ww,0)+a*f\n  terms={w:a for w,a in out.items() if abs(a)>1e-7}\n return terms\nterms=[structure(tuple(3 if q==i else 0 for q in range(N))) for i in range(N)] + [structure((3,)*N)]\nprint('counts',[len(x) for x in terms], 'total',sum(map(len,terms)))\n# all initial states\ns0=jnp.zeros(2**N,dtype=jnp.complex64).at[0].set(1/jnp.sqrt(2)).at[-1].set(1/jnp.sqrt(2))\npair=jnp.array([0,1,1,0],dtype=jnp.complex64)/jnp.sqrt(2);s1=pair\nfor _ in range(5):s1=jnp.kron(s1,pair)\ns2=jnp.zeros(2**N,dtype=jnp.complex64).at[0].set(1);s3=jnp.ones(2**N,dtype=jnp.complex64)/jnp.sqrt(2**N)\npsis=[s0,s1,s2,s3]\nwords=sorted(set(w for ts in terms for w in ts))\nprint('words',len(words))\nex=[]\nfor psi in psis:\n c=tc.Circuit(N,inputs=psi)\n ex.append(np.array([float(np.real(c.expectation_ps(ps=list(w)))) for w in words]))\nex=np.array(ex);wi={w:i for i,w in enumerate(words)}\n\ndef ch(p01,p10):\n z=jnp.zeros((),dtype=jnp.complex64)\n K=jnp.stack([jnp.stack([jnp.sqrt(1-p01),z,z,jnp.sqrt(1-p10)]).reshape(2,2),jnp.stack([z,jnp.sqrt(p10),z,z]).reshape(2,2),jnp.stack([z,z,jnp.sqrt(p01),z]).reshape(2,2)])\n h=jnp.einsum('kba,ibc,kcd->iad',jnp.conj(K),jnp.asarray(P),K)\n return .5*jnp.real(jnp.einsum('jda,iad->ij',jnp.asarray(P),h))\ndef expall(p01,p10):\n cp=ch(p01,p10); ys=[]\n for ts in terms:\n  ys.append(sum(a*ex[:,wi[w]] for w,a in ts)) # (4,)\n # trans (4,13)\n return jnp.stack(ys,axis=1)\nsp=np.array(expall(.034,.011));print('sparse',sp)\n# compare dense one using imported approach logic\n# use DMCircuit2 direct\n\ndef dense(psi,p01,p10):\n z=jnp.zeros((),dtype=jnp.complex64); k=(tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]],dtype=jnp.complex64)),tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]],dtype=jnp.complex64)))\n c=tc.DMCircuit2(N,inputs=psi)\n for a,b in even+odd:\n  c.rxx(a,b,theta=theta);c.apply_general_kraus(tuple(tc.gates.Gate(jnp.kron(x.tensor,y.tensor)) for x in k for y in k),a,b)\n e=[tc.backend.real(c.expectation_ps(z=[i])) for i in range(N)];e.append(tc.backend.real(c.expectation_ps(z=range(N))))\n return np.asarray(e)\nfor i,psi in enumerate(psis):\n d=dense(psi,.034,.011);print('probe',i,'maxdiff',np.max(np.abs(d-sp[i])), 'dense',d,'sparse',sp[i])\nPY\npython -u /tmp/sparse_compare.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
