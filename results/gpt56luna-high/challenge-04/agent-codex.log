{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\ns=open('/tmp/scatter_train.py').read(); idx=s.index('[REDACTED]=jnp.array')\nprefix=s[:idx]\nsuffix='''def cptm_r(r):\\\\n p01=jax.nn.sigmoid(r[0]);p10=jax.nn.sigmoid(r[1]);z=jnp.zeros((),dtype=jnp.complex64)\\\\n k=(tc.gates.Gate(jnp.array([[jnp.sqrt(1-p01),z],[z,jnp.sqrt(1-p10)]])),tc.gates.Gate(jnp.array([[z,jnp.sqrt(p10)],[z,z]])),tc.gates.Gate(jnp.array([[z,z],[jnp.sqrt(p01),z]])))\\\\n kt=jnp.stack([x.tensor for x in k]);pa=jnp.asarray(np.array([[[1,0],[0,1]],[[0,1],[1,0]],[[0,-1j],[1j,0]],[[1,0],[0,-1]]],np.complex64))\\\\n h=jnp.einsum('kba,ibc,kcd->iad',jnp.conj(kt),pa,kt)\\\\n return jnp.real(.5*jnp.einsum('jda,iad->ij',pa,h))\\\\ndef fg(r,target):\\\\n cp=jax.jacfwd(cptm_r)(r); val=cptm_r(r)\\\\n # jacfwd shape (4,4,2)\\\\n st=jnp.zeros((13,M),jnp.float32).at[np.arange(13),np.array([wi[w] for w in target_words])].set(1.)\\\\n dt=jnp.zeros((2,13,M),jnp.float32)\\\\n for typ,src,dst,q0,q1,fac,labs in trans:\\\\n  si=jnp.asarray(src);di=jnp.asarray(dst)\\\\n  if typ=='c': f=val[jnp.asarray(q0),jnp.asarray(q1)];df=cp[jnp.asarray(q0),jnp.asarray(q1),:]\\\\n  else:f=jnp.asarray(fac);df=jnp.zeros((2,),jnp.float32)\\\\n  st0=st;st=jnp.zeros_like(st).at[:,di].add(st0[:,si]*f)\\\\n  for k in range(2):dt0=dt[k];dt=dt.at[k].set(jnp.zeros_like(dt0).at[:,di].add(dt0[:,si]*f+st0[:,si]*df[k]))\\\\n out=(st@ex).T; dout=jnp.stack([(dt[k]@ex).T for k in range(2)])\\\\n diff=out-target;return jnp.mean(diff*diff),2*jnp.mean(diff[None]*dout,axis=(1,2))\\\\n[REDACTED]=jnp.array([np.log(.034/.966),np.log(.011/.989)]);init=jnp.array([np.log(.07/.93),np.log(.04/.96)])\\\\ntarget=expall([REDACTED]);target.block_until_ready();print('target ready')\\\\nfjg=jax.jit(fg);x=init;m=jnp.zeros(2);v=jnp.zeros(2);hist=[];start=time.time()\\\\nfor i in range(120):\\\\n l,g=fjg(x,target);l.block_until_ready();hist.append(l)\\\\n m=.9*m+.1*g;v=.999*v+.001*g*g;mh=m/(1-.9**(i+1));vh=v/(1-.999**(i+1));x=x-.04*mh/(jnp.sqrt(vh)+1e-8)\\\\nprint('train',time.time()-start,'p',jax.nn.sigmoid(x),'losses',hist[0],hist[-1], 'final',fg(x,target)[0])\\\\n'''\nopen('/tmp/scatter_forward.py','w').write(prefix+suffix)\nPY\npython -u /tmp/scatter_forward.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
