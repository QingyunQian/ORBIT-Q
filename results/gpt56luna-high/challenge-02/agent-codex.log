{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\nprint('start'); tc.set_backend('jax'); n=12; x=tc.gates.x().tensor; y=tc.gates.y().tensor; z=tc.gates.z().tensor; xx=jnp.kron(x,x); yy=jnp.kron(y,y); zz=jnp.kron(z,z); init=np.zeros(2**n,np.complex64); init[int('010101010101',2)]=1\n\ndef rdm(s, inds):\n t=jnp.reshape(s,(2,)*n); axes=list(inds)+[i for i in range(n) if i not in inds]; q=jnp.transpose(t,axes); q=jnp.reshape(q,(2**len(inds),-1)); return q@jnp.conj(q.T)\ndef entropy(s):\n rho=rdm(s,range(6)); return -jnp.log(jnp.real(jnp.sum(jnp.abs(rho)**2)))\ndef energy(s):\n e=0.\n for i in range(n-1):\n  r=rdm(s,(i,i+1)); e += jnp.real(jnp.sum(r*xx.T))+jnp.real(jnp.sum(r*yy.T))+1.2*jnp.real(jnp.sum(r*zz.T))\n for i in range(n): e += .35*((-1)**i)*jnp.real(jnp.sum(rdm(s,(i,))*z.T))\n return e/n\ndef fun(p):\n c=tc.Circuit(n,inputs=init); es=[]\n for b in range(3):\n  q=81*b\n  for i in range(n): c.ry(i,theta=p[q+2*i]); c.rz(i,theta=p[q+2*i+1])\n  q+=24\n  for k,i in enumerate(range(0,n,2)):\n   c.exp(i,i+1,unitary=xx,theta=p[q+3*k]); c.exp(i,i+1,unitary=yy,theta=p[q+3*k+1]); c.exp(i,i+1,unitary=zz,theta=p[q+3*k+2])\n  q+=18\n  for i in range(n): c.ry(i,theta=p[q+2*i]); c.rz(i,theta=p[q+2*i+1])\n  q+=24\n  for k,i in enumerate(range(1,n-1,2)):\n   c.exp(i,i+1,unitary=xx,theta=p[q+3*k]); c.exp(i,i+1,unitary=yy,theta=p[q+3*k+1]); c.exp(i,i+1,unitary=zz,theta=p[q+3*k+2])\n  es.append(entropy(c.state()))\n s=c.state(); return energy(s)+.25*jnp.mean((jnp.stack(es)-jnp.array([.3,.6,.8]))**2)\np=jnp.zeros(243,dtype=jnp.float32); t=time.time(); q=fun(p); print('eager',q,time.time()-t); t=time.time(); v,g=jax.value_and_grad(fun)(p); print('grad',v,time.time()-t,jnp.linalg.norm(g))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
