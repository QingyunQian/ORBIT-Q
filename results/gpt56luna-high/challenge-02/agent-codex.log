{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\nK=tc.set_backend('jax'); n=12\nI=jnp.eye(2); x=tc.gates.x().tensor; y=tc.gates.y().tensor; z=tc.gates.z().tensor\nxx=jnp.kron(x,x); yy=jnp.kron(y,y); zz=jnp.kron(z,z)\ninit=np.zeros(2**n,np.complex64); init[int('010101010101',2)]=1\n\ndef entropy(s):\n p=jnp.reshape(s,(64,64)); rho=p@jnp.conj(p.T); return -jnp.log(jnp.real(jnp.sum(jnp.abs(rho)**2)))\ndef fun(p):\n c=tc.Circuit(n,inputs=init)\n es=[]\n for b in range(3):\n  q=81*b\n  for i in range(n): c.ry(i,theta=p[q+2*i]); c.rz(i,theta=p[q+2*i+1])\n  q+=24\n  for k,i in enumerate(range(0,n,2)):\n   c.exp(i,i+1,unitary=xx,theta=p[q+3*k]); c.exp(i,i+1,unitary=yy,theta=p[q+3*k+1]); c.exp(i,i+1,unitary=zz,theta=p[q+3*k+2])\n  q+=18\n  for i in range(n): c.ry(i,theta=p[q+2*i]); c.rz(i,theta=p[q+2*i+1])\n  q+=24\n  for k,i in enumerate(range(1,n-1,2)):\n   c.exp(i,i+1,unitary=xx,theta=p[q+3*k]); c.exp(i,i+1,unitary=yy,theta=p[q+3*k+1]); c.exp(i,i+1,unitary=zz,theta=p[q+3*k+2])\n  q+=15\n  es.append(entropy(c.state()))\n e=0.\n for i in range(n-1):\n  e += c.expectation((tc.gates.x(),[i]),(tc.gates.x(),[i+1]))\n  e += c.expectation((tc.gates.y(),[i]),(tc.gates.y(),[i+1]))\n  e += 1.2*c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\n for i in range(n): e += .35*((-1)**i)*c.expectation((tc.gates.z(),[i]))\n return tc.backend.real(e)/n + .25*jnp.mean((jnp.stack(es)-jnp.array([.3,.6,.8]))**2)\np=jnp.array(np.random.default_rng(1).normal(0,.02,243),dtype=jnp.float32)\nt=time.time(); print('eager', fun(p), 'time',time.time()-t)\nt=time.time(); vg=jax.jit(jax.value_and_grad(fun)); print('compile call'); v,g=vg(p); v.block_until_ready(); print(v,time.time()-t, jnp.linalg.norm(g).block_until_ready())\nt=time.time(); v,g=vg(p); v.block_until_ready(); print('repeat',time.time()-t, v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
