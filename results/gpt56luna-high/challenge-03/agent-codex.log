{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time,numpy as np\nimport tensorcircuit as tc\nimport jax.numpy as jnp\ntc.set_backend('jax');tc.set_dtype('complex64');b=tc.backend\nn=12; steps=10;bonds=[[(i,i+1) for i in range(0,n-1,2)],[(i,i+1) for i in range(1,n-1,2)]]\ndef f(p):\n c=tc.Circuit(n);c.h(range(n))\n for t in range(steps):\n  for j,(a,d) in enumerate(bonds[t&1]):\n   c.exp1(a,d,unitary=tc.gates._xx_matrix,theta=p[t,2*j]);c.exp1(a,d,unitary=tc.gates._zz_matrix,theta=p[t,2*j+1])\n  for q in range(n):c.rx(q,theta=p[t,12+q])\n  for q in range(0,n,2):c.mid_measurement(q,keep=0)\n s=c.wavefunction();norm=b.real(b.sum(b.abs(s)**2))\n e=0\n for i in range(n-1):e-=b.real(c.expectation_ps(z=[i,i+1],reuse=True))\n for i in range(n):e-=.9*b.real(c.expectation_ps(x=[i],reuse=True))\n return e/(n*norm)-.05*b.log(norm)/60\np=jnp.array(np.random.default_rng(1).normal(0,.05,(steps,24)).astype('float32'))\nprint('eager',flush=True);t=time.time();print(f(p),time.time()-t,flush=True)\nprint('jit',flush=True);g=b.jit(b.value_and_grad(f));t=time.time();v,gr=g(p);print('jit1',v,np.linalg.norm(np.asarray(gr)),time.time()-t,flush=True);t=time.time();v,gr=g(p);print('jit2',time.time()-t,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
