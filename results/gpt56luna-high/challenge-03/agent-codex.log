torized_argnums,)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/cupy_backend.py:489:            for barg in zip(*[args[i] for i in vectorized_argnums]):  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/cupy_backend.py:493:                    if k in vectorized_argnums:  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/cupy_backend.py:503:    def vectorized_value_and_grad(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/cupy_backend.py:507:        vectorized_argnums: Union[int, Sequence[int]] = 0,\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/cupy_backend.py:512:    vvag = vectorized_value_and_grad\n/usr/local/lib/python3.11/site-packages/tensorcircuit/zx/noise_model.py:651:    outcome_indices = jax.vmap(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/zx/noise_model.py:655:    gathered = jax.vmap(lambda xp, idx: xp[idx])(xor_pats_all, outcome_indices)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/channels.py:198:    # vectorized implementation\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/optimization.py:104:    :param vvag (optional): A flag indicating whether to use vectorized variational adjoint gradient. Default is False.\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/optimization.py:105:    :param ncircuits (optional): The number of circuits when using vectorized variational adjoint gradient.\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/optimization.py:134:            loss_val_grad = backend.vvag(loss_val_grad, argnums=0, vectorized_argnums=0)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/optimization.py:137:            # If vvag flag is set to True, use vectorized variational adjoint gradient (vvag) with multiple circuits.\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/abstract_backend.py:1658:    # Though try hard, the current ra