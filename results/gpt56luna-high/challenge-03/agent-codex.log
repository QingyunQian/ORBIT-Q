ocal/lib/python3.11/site-packages/tensorcircuit/backends/abstract_backend.py:2578:        :param vectorized_argnums: the args to be vectorized, these arguments should share the same batch shape\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/abstract_backend.py:2580:        :type vectorized_argnums: Union[int, Sequence[int]], defaults to 0\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/abstract_backend.py:2581:        :return: a vectorized function returning ``(value, grad)`` tuples over the batch\n/usr/local/lib/python3.11/site-packages/tensorcircuit/backends/abstract_backend.py:2585:            \"Backend '{}' has not implemented `vectorized_value_and_grad`.\".format(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/van.py:204:    def sample(self, batch_size: int) -> Tuple[np.array, tf.Tensor]:  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/van.py:207:            [batch_size, self.input_space, self.spin_channel], dtype=np.float32\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/van.py:212:                tf.reshape(x_hat, [batch_size * self.input_space, self.spin_channel])\n/usr/local/lib/python3.11/site-packages/tensorcircuit/applications/van.py:219:                one_hot, [batch_size, self.input_space, self.spin_channel]\n","exit_code":0,"status":"completed"}}
