{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_struct.py <<'PY'\nimport pickle,time,numpy as np,jax,jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax');tc.set_dtype('complex64')\nraw=pickle.load(open('/tmp/target.pkl','rb'));T=[jnp.asarray(x) for x in raw]\nb0=tuple(range(0,31,2));b1=tuple(range(1,31,2)); bits=np.array([[i%2,(i+1)%2] for i in b0])\ndef split2(x,l,r):\n u,s,vh=jnp.linalg.svd(x,full_matrices=False);return (u*s).reshape(l,2,-1),vh.reshape(-1,2,r)\ndef loss(p):\n A=[];k=0\n for z in bits:\n  g=tc.gates.su4_gate(p[k:k+15]).tensor;k+=15\n  u,s,v=jnp.linalg.svd(g[z[0],z[1]],full_matrices=False)\n  A += [(u*s).reshape(1,2,2),v.reshape(2,2,1)]\n for i in range(1,30,2):\n  g=tc.gates.su4_gate(p[k:k+15]).tensor;k+=15\n  w=jnp.einsum('lpm,mqr,pqij->lijr',A[i],A[i+1],g)\n  l,_,_,r=w.shape; u,s,v=jnp.linalg.svd(w.reshape(l*2,2*r),full_matrices=False)\n  A[i]=(u*s).reshape(l,2,4); A[i+1]=v.reshape(4,2,r)\n e=jnp.ones((1,1),dtype=jnp.complex64)\n for t,a in zip(T,A):e=jnp.einsum('ab,apc,bpd->cd',e,jnp.conj(t),a)\n ov=e[0,0];return 1-jnp.real(ov*jnp.conj(ov))\nvg=jax.value_and_grad(loss);p=jnp.zeros(465);t=time.time();x,g=vg(p);x.block_until_ready();g.block_until_ready();print('grad',time.time()-t,x,g.shape,flush=True)\nvgj=jax.jit(vg);t=time.time();x,g=vgj(p);x.block_until_ready();g.block_until_ready();print('jit',time.time()-t,flush=True);t=time.time()\nfor i in range(20):x,g=vgj(p);x.block_until_ready();g.block_until_ready()\nprint('per',(time.time()-t)/20,flush=True)\nPY\npython -u /tmp/train_struct.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
