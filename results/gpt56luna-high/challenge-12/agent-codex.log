{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_proj.py <<'PY'\nimport pickle,time,numpy as np,jax,jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax');tc.set_dtype('complex64')\nraw=pickle.load(open('/tmp/target.pkl','rb')); T=[]\nfor i,x in enumerate(raw):\n x=jnp.asarray(x)\n if x.ndim==2:x=x[None,:,:] if i==0 else x[:,:,None]\n T.append(x)\nB=tc.MPSCircuit(32,tensors=T,center_position=0)\nN=[]\nfor i in range(32):N.append(jnp.zeros((1,2,1),dtype=jnp.complex64).at[0,i%2,0].set(1))\nb0=tuple(range(0,31,2));b1=tuple(range(1,31,2))\ndef loss(p):\n c=tc.MPSCircuit(32,tensors=N,center_position=0);k=0\n for i in b0+b1:\n  c.apply(tc.gates.su4_gate(p[k:k+15]),i,i+1);k+=15\n a=c.proj_with_mps(B)\n return 1-jnp.real(a*jnp.conj(a))\nvg=jax.value_and_grad(loss)\nprint('before',flush=True);t=time.time();x,g=vg(jnp.zeros(465));x.block_until_ready();g.block_until_ready();print('after',time.time()-t,x,g.shape,flush=True)\nPY\npython -u /tmp/train_proj.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_proj.py <<'PY'\nimport pickle,time,numpy as np,jax,jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax');tc.set_dtype('complex64')\nraw=pickle.load(open('/tmp/target.pkl','rb')); T=[]\nfor i,x in enumerate(raw):\n x=jnp.asarray(x)\n if x.ndim==2:x=x[None,:,:] if i==0 else x[:,:,None]\n T.append(x)\nB=tc.MPSCircuit(32,tensors=T,center_position=0)\nN=[]\nfor i in range(32):N.append(jnp.zeros((1,2,1),dtype=jnp.complex64).at[0,i%2,0].set(1))\nb0=tuple(range(0,31,2));b1=tuple(range(1,31,2))\ndef loss(p):\n c=tc.MPSCircuit(32,tensors=N,center_position=0);k=0\n for i in b0+b1:\n  c.apply(tc.gates.su4_gate(p[k:k+15]),i,i+1);k+=15\n a=c.proj_with_mps(B)\n return 1-jnp.real(a*jnp.conj(a))\nvg=jax.value_and_grad(loss)\nprint('before',flush=True);t=time.time();x,g=vg(jnp.zeros(465));x.block_until_ready();g.block_until_ready();print('after',time.time()-t,x,g.shape,flush=True)\nPY\npython -u /tmp/train_proj.py\"","aggregated_output":"before\nafter 16.204015731811523 1.0 (465,)\n","exit_code":0,"status":"completed"}}
