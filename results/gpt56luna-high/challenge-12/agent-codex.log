{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_einsum.py <<'PY'\nimport pickle,time,numpy as np,jax,jax.numpy as jnp,opt_einsum as oe\nimport tensorcircuit as tc\ntc.set_backend('jax');tc.set_dtype('complex64')\nraw=pickle.load(open('/tmp/target.pkl','rb'));T=[];sh=[]\nfor x in raw:\n x=np.asarray(x);T.append(jnp.asarray(x));sh.append(x.shape)\n# labels and operands: target tensors, initial local vectors, layer0 gates, layer1 gates\n# bonds labels 0..30, final 31..62, intermediate 63..94, initial 95..126\nsym=[oe.get_symbol(i) for i in range(127)]\nsubs=[]; shapes=[]\nfor i,x in enumerate(T):\n subs.append(sym[i-1] if i else '')\n # rebuild target label string\n left=sym[i-1] if i else ''; right=sym[i] if i<31 else ''\n final=sym[31+i] if i in (0,31) else sym[63+i]\n subs[-1]=left+final+right; shapes.append(x.shape)\nfor i in range(32): subs.append(sym[95+i]);shapes.append((2,))\nfor i in range(0,31,2): subs.append(sym[95+i]+sym[95+i+1]+sym[63+i]+sym[63+i+1]);shapes.append((2,2,2,2))\nfor i in range(1,31,2): subs.append(sym[63+i]+sym[63+i+1]+sym[31+i]+sym[31+i+1]);shapes.append((2,2,2,2))\nexpr=oe.contract_expression(','.join(subs)+'->',*shapes,optimize='greedy')\nN=[jnp.array([1.,0.],dtype=jnp.complex64) if i%2==0 else jnp.array([0.,1.],dtype=jnp.complex64) for i in range(32)]\nb0=tuple(range(0,31,2));b1=tuple(range(1,31,2))\ndef loss(p):\n ops=list(T)+N;k=0\n for i in b0:\n  ops.append(tc.gates.su4_gate(p[k:k+15]).tensor);k+=15\n for i in b1:\n  ops.append(tc.gates.su4_gate(p[k:k+15]).tensor);k+=15\n a=expr(*ops,backend='jax')\n return 1-jnp.real(a*jnp.conj(a))\nprint('subs',len(subs),flush=True);vg=jax.value_and_grad(loss);t=time.time();a,g=vg(jnp.zeros(465));a.block_until_ready();g.block_until_ready();print('grad',time.time()-t,a,g.shape,flush=True)\nvgj=jax.jit(vg);t=time.time();a,g=vgj(jnp.zeros(465));a.block_until_ready();g.block_until_ready();print('jit',time.time()-t,flush=True);t=time.time()\nfor i in range(20):a,g=vgj(jnp.zeros(465));a.block_until_ready();g.block_until_ready()\nprint('per',(time.time()-t)/20,flush=True)\nPY\npython -u /tmp/train_einsum.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
