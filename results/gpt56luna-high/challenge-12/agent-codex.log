{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train_tc.py <<'PY'\nimport pickle,time,numpy as np,jax,jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax'); tc.set_dtype('complex64')\nT=[jnp.asarray(x) for x in pickle.load(open('/tmp/target.pkl','rb'))]\nn=32\nb0=tuple(range(0,31,2)); b1=tuple(range(1,31,2)); neel='01'*16\n\ndef loss(p):\n c=tc.MPSCircuit(n,tensors=T,center_position=0)\n k=0\n for i in b1[::-1]:\n  c.apply(tc.gates.su4_gate(-p[k:k+15]),i,i+1); k+=15\n for i in b0[::-1]:\n  c.apply(tc.gates.su4_gate(-p[k:k+15]),i,i+1); k+=15\n a=c.amplitude(neel)\n return 1-jnp.real(a*jnp.conj(a))\nvg=jax.value_and_grad(loss)\ndef body(carry,_):\n p,m,v,t=carry\n l,g=vg(p); t=t+1\n m=.9*m+.1*g; v=.999*v+.001*g*g\n mh=m/(1-.9**t); vh=v/(1-.999**t)\n p=p-.02*mh/(jnp.sqrt(vh)+1e-8)\n return (p,m,v,t),(l,1-l)\nscan=jax.jit(lambda p: jax.lax.scan(body,(p,jnp.zeros_like(p),jnp.zeros_like(p),jnp.array(0,dtype=jnp.int32)),None,length=5000))\nrng=np.random.default_rng(2039); p=jnp.asarray(rng.normal(0,.02,465),dtype=jnp.float32)\nst=time.time(); (pf,_,_,_), hist=scan(p); pf.block_until_ready(); print('compile+run',time.time()-st)\nprint('init',float(hist[1][0]),'last pre',float(hist[1][-1]),'final',float(1-loss(pf)),'minloss',float(jnp.min(hist[0])))\nprint('phase',float(jnp.angle(jnp.conj((1-jnp.asarray(loss(pf)))**.5))))\nPY\npython /tmp/train_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
