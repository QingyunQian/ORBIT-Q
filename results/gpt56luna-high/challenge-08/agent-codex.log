eep else [1.0] for _idx in range(self._d)],\n            dtype=npdtype,\n        )\n\n        mg1 = tn.Node(gate)\n        mg2 = tn.Node(gate)\n        # mg1.flag = \"post-select\"\n        # mg1.is_dagger = False\n        # mg1.id = id(mg1)\n        # mg2.flag = \"post-select\"\n        # mg2.is_dagger = False\n        # mg2.id = id(mg2)\n        self.coloring_nodes([mg1, mg2], flag=\"post-select\")\n        mg1.get_edge(0) ^ self._front[index]\n        mg1.get_edge(1) ^ mg2.get_edge(1)\n        self._front[index] = mg2.get_edge(0)\n        self._nodes.append(mg1)\n        self._nodes.append(mg2)\n        r = backend.convert_to_tensor(keep)\n        r = backend.cast(r, \"int32\")\n        return r\n\n    mid_measure = mid_measurement\n    post_select = mid_measurement\n    post_selection = mid_measurement\n\n    def depolarizing2(\n        self,\n        index: int,\n        *,\n        px: float,\n        py: float,\n        pz: float,\n        status: Optional[float] = None,\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:38:    contractor,\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:155:def get_all_nodes(edges: Iterable[Edge]) -> List[Node]:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:156:    \"\"\"Return the set of nodes connected to edges.\"\"\"\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:157:    nodes = []\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:159:        if edge.node1 is not None and edge.node1 not in nodes:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:160:            nodes.append(edge.node1)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:161:        if edge.node2 is not None and edge.node2 not in nodes:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:162:            nodes.append(edge.node2)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/quantum.py:163:    return nodes\n/usr/local/li