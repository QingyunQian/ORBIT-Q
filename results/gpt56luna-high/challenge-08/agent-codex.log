{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_vmap.py <<'PY'\nimport time,numpy as np,tensorcircuit as tc,jax,jax.numpy as jnp\ns=7;tc.set_backend('jax');tc.set_contractor('omeco-4-8')\nc=tc.Circuit(49)\nfor r in range(s):\n for col in range(s): c.ry(7*r+col,theta=.19+.07*np.sin(.83*(r+1))+.05*np.cos(.61*(col+1))+.03*np.sin(.29*(r+col+2)))\nk=0\nfor r in range(s):\n for col in range(s-1): c.rzz(7*r+col,7*r+col+1,theta=.31+.09*np.sin(.47*(k+1))+.06*np.cos(.38*(2*r+col+1)));k+=1\nk=0\nfor r in range(s-1):\n for col in range(s): c.rxx(7*r+col,7*(r+1)+col,theta=.27+.08*np.cos(.41*(k+1))+.07*np.sin(.33*(r+2*col+1)));k+=1\nfor r in range(s):\n for col in range(s): c.rx(7*r+col,theta=.17+.06*np.cos(.52*(r+1))-.04*np.sin(.44*(col+1))+.02*np.cos(.25*(r+col+2)))\nprint('trace',flush=True);t=time.time()\nf=jax.jit(jax.vmap(c.perfect_sampling))\nprint('built',time.time()-t,flush=True)\nfor shots in [1,2,8,32]:\n st=jax.random.uniform(jax.random.key(0),(shots,49)); t=time.time();x=f(st);jax.block_until_ready(x);print(shots,time.time()-t,np.asarray(x[0]).shape,flush=True)\nPY\npython /tmp/bench_vmap.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
