{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat >/tmp/bench_one.py <<'PY'\nimport numpy as np, tensorcircuit as tc, jax, jax.numpy as jnp, time\nn=512; rng=np.random.default_rng(2035); tape=[]; pi=0\ndef es():\n e=[]\n for c in range(256):\n  e.append((2*c,2*c+1))\n  if c<255:e += [(2*c,2*c+2),(2*c+1,2*c+3),(2*c,2*c+3) if c%2==0 else (2*c+1,2*c+2)]\n return e\nfor _ in range(6):\n for q in range(n): tape.append((('rx','ry','rz')[int(rng.integers(3))],q,pi));pi+=1\n ee=es();rng.shuffle(ee);used=set()\n for a,b in ee:\n  if a in used or b in used or rng.random()>.24:continue\n  tape.append((('rxx','ryy','rzz')[int(rng.integers(3))],a,b,pi));pi+=1;used|={a,b}\nactive={388,390};keep=[]\nfor g in tape[::-1]:\n if len(g)==3:\n  if g[1] in active:keep.append(g)\n elif g[1] in active or g[2] in active:keep.append(g);active|={g[1],g[2]}\ntarget=sorted(active); mp={q:i for i,q in enumerate(target)}; sel=sorted(g[-1] for g in keep); lm={p:i for i,p in enumerate(sel)};lt=[]\nfor g in keep[::-1]:\n if len(g)==3:lt.append((g[0],mp[g[1]],lm[g[2]]))\n else:lt.append((g[0],mp[g[1]],mp[g[2]],lm[g[3]]))\nprint('cone',len(target),len(lt),len(sel), flush=True)\ntc.set_backend('jax')\ndef obj(x):\n c=tc.MPSCircuit(len(target),split={'max_singular_values':64})\n for q in range(len(target)):c.h(q)\n for g in lt:\n  if len(g)==3:getattr(c,g[0])(g[1],theta=x[g[2]])\n  else:getattr(c,g[0])(g[1],g[2],theta=x[g[3]])\n return jnp.real(c.expectation((tc.gates.x(),[mp[388]]),(tc.gates.z(),[mp[390]])))\nx=jnp.zeros(len(sel))+.01\nprint('eager',obj(x),flush=True)\nf=jax.jit(jax.value_and_grad(obj)); t=time.time();v,gr=f(x);print('compiled',time.time()-t,v,gr.shape,flush=True);t=time.time()\nfor _ in range(10):v,gr=f(x)\nprint('10',time.time()-t,flush=True)\nPY\ntimeout 150s python -u /tmp/bench_one.py; echo status:\"'$?'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
