{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, tensorcircuit as tc, jax, jax.numpy as jnp, time\n\ndef ladder_edges(n):\n e=[]\n for c in range(n//2):\n  e.append((2*c,2*c+1))\n  if c+1<n//2:\n   e += [(2*c,2*(c+1)),(2*c+1,2*(c+1)+1)]\n   e.append((2*c,2*(c+1)+1) if c%2==0 else (2*c+1,2*(c+1)))\n return e\ncfg={'n_qubits':512,'n_layers':6,'seed':2035,'edge_keep_prob':.24}\nrng=np.random.default_rng(cfg['seed']); tape=[]; pi=0\nfor _ in range(6):\n for q in range(512):\n  tape.append((('rx','ry','rz')[int(rng.integers(3))],q,pi));pi+=1\n edges=ladder_edges(512);rng.shuffle(edges);used=set()\n for a,b in edges:\n  if a in used or b in used or rng.random()>cfg['edge_keep_prob']: continue\n  tape.append((('rxx','ryy','rzz')[int(rng.integers(3))],a,b,pi));pi+=1;used|={a,b}\nprint(len(tape),pi)\nterms=[(('x',388),('z',390)),(('x',16),('y',19))]\n\ndef cone(term):\n active=set(q for _,q in term)\n keep=[]\n for g in tape[::-1]:\n  if len(g)==3:\n   name,a,p=g\n   if a in active: keep.append(g); active.add(a)\n  else:\n   name,a,b,p=g\n   if a in active or b in active:\n    keep.append(g);active|={a,b}\n return active, list(reversed(keep))\nfor term in terms:\n a,k=cone(term); print('cone',len(a),'gates',len(k),min(a),max(a))\n# union cone preserving terms\nactive=set(q for term in terms for _,q in term);keep=[]\nfor g in tape[::-1]:\n if len(g)==3:\n  if g[1] in active: keep.append(g)\n else:\n  if g[1] in active or g[2] in active: keep.append(g);active|={g[1],g[2]}\nprint('union',len(active),len(keep))\n\n# Test local circuit full local cone\nTC_NAMES={'rx':'rx','ry':'ry','rz':'rz','rxx':'rxx','ryy':'ryy','rzz':'rzz'}\ntarget=sorted(active); mp={q:i for i,q in enumerate(target)}\nlt=[(g[0],mp[g[1]],*( [mp[g[2]]] if len(g)==4 else []),g[-1]) for g in keep]\n# use local parameter order\nsel=np.array(sorted({g[-1] for g in keep}),dtype=int)\nlocal_map={p:i for i,p in enumerate(sel)}\nlt=[g[:-1]+(local_map[g[-1]],) for g in lt]\nprint('sel',len(sel))\ntc.set_backend('jax')\n\ndef obj(x):\n c=tc.Circuit(len(target))\n for q in range(len(target)): c.h(q)\n for g in lt:\n  if len(g)==4: name,a,p=g; getattr(c,name)(a,theta=x[p])\n  else: name,a,b,p=g; getattr(c,name)(a,b,theta=x[p])\n return .5645931361768194* c.expectation((tc.gates.x(),[mp[388]]),(tc.gates.z(),[mp[390]]))+c.expectation((tc.gates.x(),[mp[16]]),(tc.gates.y(),[mp[19]]))\nx=jnp.zeros(len(sel))+.01\nprint('test obj',obj(x))\nf=jax.jit(jax.value_and_grad(obj)); t=time.time(); v,gr=f(x); print('compile/result',time.time()-t,v,gr.shape,jnp.linalg.norm(gr)); t=time.time();\nfor _ in range(10): v,gr=f(x)\nprint('10',time.time()-t,float(v))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
