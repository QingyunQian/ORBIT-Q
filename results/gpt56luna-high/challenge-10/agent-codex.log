^ket[q][1]\n return tc.backend.real(tc.cons.contractor(ket+bra+hs).tensor)\np=jnp.array(np.random.default_rng(2040).normal(0,.08,(2,n,3)),dtype=jnp.float32)\nt=time.time();v=energy(p);print('\"'energy',float(v),time.time()-t,flush=True)\nt=time.time();v,g=jax.value_and_grad(energy)(p);print('grad',float(v),g.shape,time.time()-t,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
