{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport tensorcircuit as tc,jax.numpy as jnp,numpy as np,time\ntc.set_backend('jax');n=22;sel=[0,1,2,4,5,6,8,9,10,12,13,14,16,17,18,19,20,21]\ndef mk():\n op=tc.gates.cmz_gate(len(sel));ls=[e.node1.tensor for e in op.out_edges];mp=[]\n for q in range(n):\n  if q not in sel:\n   d=2;a=jnp.zeros((d,2,2,d),dtype=jnp.complex64);a=a.at[jnp.arange(d),jnp.arange(2),jnp.arange(2),jnp.arange(d)].set(1)\n  else:\n   k=sel.index(q);t=ls[k]\n   if k==0:a=jnp.zeros((1,2,2,2),dtype=jnp.complex64);a=a.at[0,jnp.arange(2),jnp.arange(2),:].set(t)\n   elif k==len(sel)-1:a=jnp.zeros((2,2,2,1),dtype=jnp.complex64);a=a.at[:,jnp.arange(2),jnp.arange(2),0].set(t)\n   else:a=jnp.zeros((2,2,2,2),dtype=jnp.complex64);a=a.at[:,jnp.arange(2),jnp.arange(2),:].set(t)\n  mp.append(a)\n return mp\nm=mk();print('start',flush=True);c=tc.MPSCircuit(n,split={'max_singular_values':4});c.apply_MPO(m,0);print('one',c.get_bond_dimensions(),flush=True);c.apply_MPO(m,0);print('two',c.get_bond_dimensions(),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
