{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\n# test variants of cmz MPO on n8 mixed state\nimport tensorcircuit as tc,jax.numpy as jnp\ntc.set_backend('jax');n=8;sel=[0,1,2,4,5,6,7];op=tc.gates.cmz_gate(len(sel));ls=[e.node1.tensor for e in op.out_edges]\ndef build(reverse=False, gaprev=False):\n tlist=ls[::-1] if reverse else ls;mp=[]\n for q in range(n):\n  if q not in sel:\n   d=2;a=jnp.zeros((d,2,2,d)); a=a.at[jnp.arange(d),jnp.arange(2),jnp.arange(2),jnp.arange(d)].set(1)\n  else:\n   k=sel.index(q);t=tlist[k]\n   if k==0:a=jnp.zeros((1,2,2,2));a=a.at[0,jnp.arange(2),jnp.arange(2),:].set(t)\n   elif k==len(sel)-1:a=jnp.zeros((2,2,2,1));a=a.at[:,jnp.arange(2),jnp.arange(2),0].set(t)\n   else:a=jnp.zeros((2,2,2,2));a=a.at[:,jnp.arange(2),jnp.arange(2),:].set(t)\n  mp.append(a)\n return mp\nfor rev in [False,True]:\n c=tc.MPSCircuit(n)\n for i in [1,3]:c.X(i)\n c.apply_MPO(build(rev),0);print(rev,c.expectation((tc.gates.i(),[0])),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
