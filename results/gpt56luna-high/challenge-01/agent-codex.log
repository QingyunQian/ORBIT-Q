{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat >> /tmp/bench_tc.py <<'PY'\nimport jax\njax.config.update('jax_enable_x64', True)\nimport jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax'); tc.set_dtype('complex128')\nT=[jnp.asarray(t.data) for t in s.tensors]\nX=jnp.array([[0,1],[1,0]],dtype=jnp.complex128); Y=jnp.array([[0,-1j],[1j,0]],dtype=jnp.complex128); Z=jnp.array([[1,0],[0,-1]],dtype=jnp.complex128)\nXX=jnp.kron(X,X); YY=jnp.kron(Y,Y); ZZ=jnp.kron(Z,Z)\ndef energy(p):\n c=tc.MPSCircuit(L,tensors=T)\n k=0\n for layer in range(4):\n  for q in range(L):\n   c.rz(q,theta=p[k]); c.ry(q,theta=p[k+1]); c.rz(q,theta=p[k+2]); k+=3\n  for q in range(layer%2,L-1,2):\n   c.any(q,q+1,unitary=tc.backend.reshape(tc.backend.expm(-tc.backend.i()*(p[k]*XX+p[k+1]*YY+p[k+2]*ZZ)),[2,2,2,2])); k+=3\n e=0.\n for q in range(L-1): e -= tc.backend.real(c.expectation_ps(z=[q,q+1]))\n for q in range(L): e -= 1.05*tc.backend.real(c.expectation_ps(x=[q]))\n return e\np=jnp.zeros(432)\nt=time.time(); print('e',energy(p), 'time',time.time()-t)\nt=time.time(); v,g=tc.backend.value_and_grad(energy)(p); print('vg',v, 'gnorm', jnp.linalg.norm(g), 'time',time.time()-t)\nPY\npython /tmp/bench_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
