{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport jax.numpy as jnp\nimport time\n\nn_sites = 12\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\n\ndef make(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for i in range(3):\n        c.unitary(i, unitary=jnp.eye(3, dtype=jnp.complex64), dim=3)\n    return c.state()\n\nf = jax.jit(make)\np = jnp.zeros((1,10))\nt0=time.time(); s = f(p); s.block_until_ready(); t1=time.time()\nprint(\\\"state jit ok\\\", s.shape, t1-t0)\nprint(jnp.allclose(s, init_j))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport jax.numpy as jnp\nimport time\n\nn_sites = 12\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\n\ndef make(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for i in range(3):\n        c.unitary(i, unitary=jnp.eye(3, dtype=jnp.complex64), dim=3)\n    return c.state()\n\nf = jax.jit(make)\np = jnp.zeros((1,10))\nt0=time.time(); s = f(p); s.block_until_ready(); t1=time.time()\nprint(\\\"state jit ok\\\", s.shape, t1-t0)\nprint(jnp.allclose(s, init_j))\nEOF\"","aggregated_output":"state jit ok (531441,) 0.09366893768310547\nTrue\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench2.py <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\n\nn_sites = 12\nn_layers = 5\nbeta = 0.20\nD = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2np = SS + beta*(SS@SS)\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\nn_rot = 3*n_sites; n_even = 6; n_odd = 5; off = n_rot + 2*n_even\neven_bonds = [(2*b,2*b+1) for b in range(6)]\nodd_bonds = [(2*b+1,2*b+2) for b in range(5)]\nSxj = jnp.asarray(Sx); Syj = jnp.asarray(Sy); Szj = jnp.asarray(Sz)\nXXj = jnp.asarray(XX); YYj = jnp.asarray(YY); ZZj = jnp.asarray(ZZ)\nSSj = jnp.asarray(SS); H2j = jnp.asarray(H2np)\nSz2j = jnp.diag(jnp.array([1,0,1], dtype=jnp.complex64))\nbonds = even_bonds + odd_bonds\nall_ops = [(H2j, b) for b in bonds] + [(Sz2j, [i]) for i in range(n_sites)]\n\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\ndef ry(th):\n    return jexpm(-1j*th*Syj)\ndef u2(th, ph):\n    return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\ndef build_circuit(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for l in range(n_layers):\n        p = params[l]\n        for i in range(n_sites):\n            a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n            c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n    return c\n\ndef energy_exp(params):\n    c = build_circuit(params)\n    e = sum(c.expectation(op) for op in all_ops[:11]) + D*sum(c.expectation((Sz2j,[i])) for i in range(n_sites))\n    return jnp.real(e)/n_sites\n\ndef state_of(params):\n    return build_circuit(params).state()\n\ndef energy_state(params):\n    st = state_of(params).reshape([3]*n_sites)\n    e = 0.0\n    for (i,j) in bonds:\n        # 2-site rdm\n        st2 = st.reshape(3**i, 9, 3**(n_sites-j-1))\n        rho = jnp.tensordot(st2, jnp.conj(st2), axes=([0,2],[0,2]))  # (9,9)\n        e = e + jnp.real(jnp.sum(rho * H2j))\n    for i in range(n_sites):\n        st1 = st.reshape(3**i, 3, 3**(n_sites-i-1))\n        rho = jnp.tensordot(st1, jnp.conj(st1), axes=([0,2],[0,2]))\n        e = e + D*jnp.real(jnp.trace(rho @ Sz2j))\n    return e/n_sites\n\nkey = jax.random.PRNGKey(2041)\nnp_ = (n_rot + 2*(n_even+n_odd))\nparams = jax.random.normal(key, (n_layers, np_), dtype=jnp.float32)*0.05\nparams2 = jax.random.normal(jax.random.PRNGKey(1), (n_layers, np_), dtype=jnp.float32)*0.05\n\ndef timeit(f, arg, warmup=1, reps=3):\n    for _ in range(warmup):\n        r = f(arg); r.block_until_ready() if hasattr(r,'block_until_ready') else None\n    ts=[]\n    for _ in range(reps):\n        t0=time.time(); r = f(arg); r.block_until_ready() if hasattr(r,'block_until_ready') else None; ts.append(time.time()-t0)\n    return float(r), min(ts)\n\nfor name, f in [(\\\"exp_energy\\\", energy_exp), (\\\"state_energy\\\", energy_state)]:\n    jf = jax.jit(f)\n    t0=time.time(); v = float(jf(params)); t1=time.time()\n    print(name, \\\"compile+first:\\\", round(t1-t0,2), \\\"value\\\", v)\n    v, t = timeit(jf, params2)\n    print(name, \\\"steady:\\\", round(t,4), \\\"value\\\", v)\n\n# value_and_grad\nfor name, f in [(\\\"exp_energy\\\", energy_exp), (\\\"state_energy\\\", energy_state)]:\n    jf = jax.jit(jax.value_and_grad(f))\n    t0=time.time(); v,g = jf(params); g.block_until_ready(); t1=time.time()\n    print(\\\"vg\\\", name, \\\"compile+first:\\\", round(t1-t0,2), \\\"value\\\", float(v))\n    v,t = timeit(jf, params2)\n    print(\\\"vg\\\", name, \\\"steady:\\\", round(t,4), \\\"value\\\", float(v))\nEOF\npython /tmp/bench2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
