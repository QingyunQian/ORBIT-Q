{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto11.py <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\n\nn_sites = 12\nn_layers = 5\nbeta = 0.20\nD = 0.15\n\n# local spin operators, basis order |+1>, |0>, |-1> (digits 0,1,2)\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nSz2 = Sz@Sz\nP = np.diag([-1.,1.,-1.]).astype(complex)  # exp(i pi Sz)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2 = SS + beta*(SS@SS)   # bond Hamiltonian\nSx = jnp.asarray(Sx); Sy = jnp.asarray(Sy); Sz = jnp.asarray(Sz)\nSz2 = jnp.asarray(Sz2); P = jnp.asarray(P)\nXX = jnp.asarray(XX); YY = jnp.asarray(YY); ZZ = jnp.asarray(ZZ)\nSS = jnp.asarray(SS); H2 = jnp.asarray(H2)\n\n# initial product state |+1,-1,...>  -> digits 0,2,0,2,...\ndigits = np.array([0,2]*(n_sites//2))\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\n\nn_rot = 3*n_sites\nn_even = n_sites//2\nn_odd = n_sites - 1 - n_even\nper_layer = n_rot + 2*(n_even+n_odd)\n\neven_bonds = [(2*b, 2*b+1) for b in range(n_even)]\nodd_bonds = [(2*b+1, 2*b+2) for b in range(n_odd)]\n\n# gate builders (jnp)\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\n\ndef ry(theta):\n    return jexpm(-1j*theta*Sy)\n\ndef u2(theta, phi):\n    M = theta*(XX+YY) + phi*ZZ + beta*(SS@SS)\n    return jexpm(-1j*M)\n\ndef build_circuit(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for l in range(n_layers):\n        p = params[l]\n        for i in range(n_sites):\n            a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n            mat = rz(a) @ ry(b) @ rz(g)\n            c.unitary(i, unitary=mat, dim=3)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        off = n_rot + 2*n_even\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n    return c\n\ndef energy(params):\n    c = build_circuit(params)\n    e = c.expectation((H2, even_bonds[0]), (H2, even_bonds[1]), (H2, even_bonds[2]),\n                      (H2, even_bonds[3]), (H2, even_bonds[4]), (H2, even_bonds[5]))\n    e = e + c.expectation((H2, odd_bonds[0]), (H2, odd_bonds[1]), (H2, odd_bonds[2]),\n                          (H2, odd_bonds[3]), (H2, odd_bonds[4]))\n    e = e + D*c.expectation(*[(Sz2, [i]) for i in range(n_sites)])\n    return jnp.real(e)/n_sites\n\nkey = jax.random.PRNGKey(2041)\nparams = jax.random.normal(key, (n_layers, per_layer), dtype=jnp.float32)*0.05\n\n# test correctness vs numpy reference for one layer\nimport scipy.linalg\ndef ref_energy_np(par):\n    psi = init.copy()\n    for l in range(1):\n        p = par[l]\n        for i in range(n_sites):\n            a,b,g = p[3*i], p[3*i+1], p[3*i+2]\n            Rz = lambda ph: np.diag([np.exp(-1j*ph), 1., np.exp(1j*ph)])\n            mat = Rz(a) @ scipy.linalg.expm(-1j*b*Sy_np) @ Rz(g)\n            psi = np.tensordot(mat, psi.reshape([3]*n_sites), axes=([1],[i]))\n            # move axis to i\n            psi = np.moveaxis(psi, 0, i).reshape(-1)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            M = th*(XXnp+YYnp) + ph*ZZnp + beta*(SSnp@SSnp)\n            U = scipy.linalg.expm(-1j*M)\n            psi = np.tensordot(U.reshape(3,3,3,3), psi.reshape([3]*n_sites), axes=([2,3],[i,j]))\n            psi = np.moveaxis(psi, [0,1], [i,j]).reshape(-1)\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            M = th*(XXnp+YYnp) + ph*ZZnp + beta*(SSnp@SSnp)\n            U = scipy.linalg.expm(-1j*M)\n            psi = np.tensordot(U.reshape(3,3,3,3), psi.reshape([3]*n_sites), axes=([2,3],[i,j]))\n            psi = np.moveaxis(psi, [0,1], [i,j]).reshape(-1)\n    E = 0.0\n    for i in range(n_sites-1):\n        rho = np.tensordot(psi, psi.conj(), axes=(list(range(n_sites)), list(range(n_sites))))\n        pass\n    # direct: compute <psi|H|psi> via full matrix-free per-term\n    E = 0.0\n    for i in range(n_sites-1):\n        psi2 = psi.reshape([3]*n_sites)\n        # apply H2 to sites i,i+1\n        Hp = np.tensordot(H2np.reshape(3,3,3,3), psi2, axes=([2,3],[i,i+1]))\n        Hp = np.moveaxis(Hp, [0,1], [i,i+1])\n        E += np.vdot(psi2, Hp).real\n    psi2 = psi.reshape([3]*n_sites)\n    for i in range(n_sites):\n        Hp = np.tensordot(np.diag([1.,0.,1.]), psi2, axes=([1],[i]))\n        Hp = np.moveaxis(Hp, 0, i)\n        E += D*np.vdot(psi2, Hp).real\n    return E/n_sites\n\nSx_np = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy_np = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nXXnp = np.kron(Sx_np,Sx_np); YYnp = np.kron(Sy_np,Sy_np); ZZnp = np.kron(Sz,Sz)\nSSnp = XXnp+YYnp+ZZnp\nH2np = SSnp + beta*(SSnp@SSnp)\noff = n_rot + 2*n_even\npar_np = np.random.RandomState(0).normal(0, 0.05, (1, per_layer))\npar_j = jnp.asarray(par_np.astype(np.float32))\n\ne_tc = energy(par_j)\nprint(\\\"TC energy:\\\", e_tc)\ne_np = ref_energy_np(par_np)\nprint(\\\"NP energy:\\\", e_np)\nEOF\npython /tmp/proto11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
