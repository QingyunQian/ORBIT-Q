{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport numpy as np\nimport scipy.linalg as sla\n\nn_sites = 12\nbeta = 0.20\nD = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2 = SS + beta*(SS@SS)\nSz2 = Sz@Sz\n\n# build full Hamiltonian via sparse kron\nimport scipy.sparse as sp\ndef bond(i, j, M):\n    # M 9x9 acting on sites i,j\n    left = sp.eye(3**i)\n    mid = sp.csr_matrix(M.reshape(3,3,3,3).transpose(0,1,2,3).reshape(9,9)) if False else sp.csr_matrix(M)\n    right = sp.eye(3**(n_sites-j-1))\n    return sp.kron(sp.kron(left, mid), right, format='csr')\nH = sum(bond(i, i+1, H2) for i in range(n_sites-1))\nfor i in range(n_sites):\n    left = sp.eye(3**i); right = sp.eye(3**(n_sites-i-1))\n    H = H + D*sp.kron(sp.kron(left, sp.csr_matrix(Sz2)), right, format='csr')\n\n# ground state via sparse eigs\nw, v = sp.linalg.eigsh(H, k=1, which='SA')\nprint(\\\"exact GS energy:\\\", w[0], \\\"density:\\\", w[0]/n_sites)\npsi = v[:,0]\n# string orders\ndef diag_str(i, j):\n    Ds = np.ones(3**n_sites, dtype=complex)\n    # build as kron of per-site diag\n    per = [np.ones(3) for _ in range(n_sites)]\n    per[i] = np.diag(Sz).copy()\n    per[j] = np.diag(Sz).copy()\n    for k in range(i+1, j):\n        per[k] = np.array([-1.,1.,-1.])\n    d = per[0]\n    for p in per[1:]:\n        d = np.kron(d, p)\n    return d\nfor (i,j) in [(0,11),(1,10),(2,9)]:\n    d = diag_str(i,j)\n    o = np.vdot(psi, d*psi).real\n    print(\\\"string\\\", (i,j), o)\n# also initial Neel state energy\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=complex)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\nE0 = np.vdot(init, H@init).real\nprint(\\\"neel energy density:\\\", E0/n_sites)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
