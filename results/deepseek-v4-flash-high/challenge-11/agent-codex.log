{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\n# clean single-layer comparison\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\nimport scipy.linalg\n\nn_sites = 12\nn_layers = 1\nbeta = 0.20\nD = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2np = SS + beta*(SS@SS)\n\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\n\nn_rot = 3*n_sites; n_even = 6; n_odd = 5; off = n_rot + 2*n_even\neven_bonds = [(2*b,2*b+1) for b in range(6)]\nodd_bonds = [(2*b+1,2*b+2) for b in range(5)]\n\nSxj = jnp.asarray(Sx); Syj = jnp.asarray(Sy); Szj = jnp.asarray(Sz)\nXXj = jnp.asarray(XX); YYj = jnp.asarray(YY); ZZj = jnp.asarray(ZZ)\nSSj = jnp.asarray(SS); H2j = jnp.asarray(H2np)\nSz2j = jnp.diag(jnp.array([1,0,1], dtype=jnp.complex64))\n\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\ndef ry(th):\n    return jexpm(-1j*th*Syj)\ndef u2(th, ph):\n    return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\ndef energy_tc(p):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for i in range(n_sites):\n        a,b,g = p[3*i], p[3*i+1], p[3*i+2]\n        c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n    for k,(i,j) in enumerate(even_bonds):\n        th, ph = p[n_rot+2*k], p[n_rot+2*k+1]\n        c.unitary(i, j, unitary=u2(th,ph), dim=3)\n    for k,(i,j) in enumerate(odd_bonds):\n        th, ph = p[off+2*k], p[off+2*k+1]\n        c.unitary(i, j, unitary=u2(th,ph), dim=3)\n    e = c.expectation(*[(H2j, b) for b in even_bonds])\n    e = e + c.expectation(*[(H2j, b) for b in odd_bonds])\n    e = e + D*c.expectation(*[(Sz2j, [i]) for i in range(n_sites)])\n    return jnp.real(e)/n_sites\n\ndef energy_np(p):\n    psi = init.astype(complex).reshape([3]*n_sites)\n    for i in range(n_sites):\n        a,b,g = p[3*i], p[3*i+1], p[3*i+2]\n        Rz = lambda ph: np.diag([np.exp(-1j*ph),1.,np.exp(1j*ph)])\n        mat = Rz(a) @ scipy.linalg.expm(-1j*b*Sy) @ Rz(g)\n        psi = np.moveaxis(np.tensordot(mat, psi, axes=([1],[i])), 0, i)\n    for k,(i,j) in enumerate(even_bonds):\n        th, ph = p[n_rot+2*k], p[n_rot+2*k+1]\n        U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n        psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\n    for k,(i,j) in enumerate(odd_bonds):\n        th, ph = p[off+2*k], p[off+2*k+1]\n        U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n        psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\n    E = 0.0\n    for i in range(n_sites-1):\n        Hp = np.moveaxis(np.tensordot(H2np.reshape(3,3,3,3), psi, axes=([2,3],[i,i+1])), [0,1], [i,i+1])\n        E += np.vdot(psi, Hp).real\n    for i in range(n_sites):\n        Hp = np.moveaxis(np.tensordot(np.diag([1.,0.,1.]), psi, axes=([1],[i])), 0, i)\n        E += D*np.vdot(psi, Hp).real\n    return E/n_sites\n\np = np.random.RandomState(7).normal(0, 0.05, (n_rot + 2*(n_even+n_odd),)).astype(np.float32)\nprint(\\\"TC:\\\", float(energy_tc(jnp.asarray(p))))\nprint(\\\"NP:\\\", energy_np(p))\n# state comparison\nc = tc.Circuit(n_sites, dim=3, inputs=init_j)\nfor i in range(n_sites):\n    a,b,g = p[3*i], p[3*i+1], p[3*i+2]\n    c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\nfor k,(i,j) in enumerate(even_bonds):\n    th, ph = p[n_rot+2*k], p[n_rot+2*k+1]\n    c.unitary(i, j, unitary=u2(th,ph), dim=3)\nfor k,(i,j) in enumerate(odd_bonds):\n    th, ph = p[off+2*k], p[off+2*k+1]\n    c.unitary(i, j, unitary=u2(th,ph), dim=3)\nst = np.asarray(c.state())\npsi = init.astype(complex).reshape([3]*n_sites)\nfor i in range(n_sites):\n    a,b,g = p[3*i], p[3*i+1], p[3*i+2]\n    Rz = lambda ph: np.diag([np.exp(-1j*ph),1.,np.exp(1j*ph)])\n    mat = Rz(a) @ scipy.linalg.expm(-1j*b*Sy) @ Rz(g)\n    psi = np.moveaxis(np.tensordot(mat, psi, axes=([1],[i])), 0, i)\nfor k,(i,j) in enumerate(even_bonds):\n    th, ph = p[n_rot+2*k], p[n_rot+2*k+1]\n    U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n    psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\nfor k,(i,j) in enumerate(odd_bonds):\n    th, ph = p[off+2*k], p[off+2*k+1]\n    U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n    psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\nprint(\\\"state max diff:\\\", np.max(np.abs(st - psi.ravel())))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
