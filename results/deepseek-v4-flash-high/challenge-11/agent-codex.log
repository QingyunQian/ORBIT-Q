{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport time\nexec(open('/tmp/bench2.py').read().split(\\\"# value_and_grad\\\")[0])\n# now time vg steady for exp energy only\ndef energy_exp(params):\n    c = build_circuit(params)\n    e = sum(c.expectation((H2j, b)) for b in even_bonds+odd_bonds)\n    e = e + D*sum(c.expectation((Sz2j, [i])) for i in range(n_sites))\n    return jnp.real(e)/n_sites\njv = jax.jit(jax.value_and_grad(energy_exp))\nt0=time.time(); v,g = jv(params); g.block_until_ready(); print(\\\"vg compile:\\\", round(time.time()-t0,1))\nfor rep in range(3):\n    t0=time.time(); v,g = jv(params); g.block_until_ready(); print(\\\"vg steady:\\\", round(time.time()-t0,4))\n# scan of 500 steps to get total estimate\nimport optax\nopt = optax.adam(0.03)\nopt_state = opt.init(params)\ndef step(carry, _):\n    p, os = carry\n    v, g = jv(p)\n    updates, os = opt.update(g, os, p)\n    p = optax.apply_updates(p, updates)\n    return (p, os), v\n_, hist = jax.lax.scan(step, (params, opt_state), None, length=500)\nhist.block_until_ready()\nprint(\\\"scan compile+run total:\\\", \\\"measure separately\\\")\nt0=time.time()\nout = jax.jit(lambda c: c)(hist)\nprint(\\\"hist check\\\", hist.shape, float(hist[0]), float(hist[-1]))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
