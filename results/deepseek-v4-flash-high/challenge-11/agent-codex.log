{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\nimport scipy.linalg\n\nn_sites = 4\nbeta = 0.20\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2 = SS + beta*(SS@SS)\n\ndigits = np.array([0,2,0,2])\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\n\n# apply a simple 2-site gate to make state nontrivial\nU = scipy.linalg.expm(-1j*0.3*(XX+YY) - 1j*0.1*ZZ)\nc = tc.Circuit(n_sites, dim=3, inputs=init)\nc.unitary(0, 1, unitary=U, dim=3)\npsi = init.astype(complex).reshape([3]*n_sites)\npsi = np.moveaxis(np.tensordot(U.reshape(3,3,3,3), psi, axes=([2,3],[0,1])), [0,1], [0,1])\n\n# reference: <H2(0,1)> + <H2(2,3)> individually via numpy\nref01 = 0; ref23 = 0\nfor (i,j) in [(0,1),(2,3)]:\n    Hp = np.moveaxis(np.tensordot(H2.reshape(3,3,3,3), psi, axes=([2,3],[i,j])), [0,1], [i,j])\n    v = np.vdot(psi, Hp).real\n    if (i,j)==(0,1): ref01=v\n    else: ref23=v\nprint(\\\"numpy ref01\\\", ref01, \\\"ref23\\\", ref23, \\\"sum\\\", ref01+ref23)\n\n# TC individual\nprint(\\\"tc ind 01:\\\", float(c.expectation((H2, [0,1])).real))\nprint(\\\"tc ind 23:\\\", float(c.expectation((H2, [2,3])).real))\n# TC combined raw matrices\nprint(\\\"tc combined raw:\\\", float(c.expectation((H2, [0,1]), (H2, [2,3])).real))\n# TC combined with Gate nodes\ng01 = tc.gates.Gate(H2.reshape(3,3,3,3))\ng23 = tc.gates.Gate(H2.reshape(3,3,3,3))\nprint(\\\"tc combined nodes:\\\", float(c.expectation((g01, [0,1]), (g23, [2,3])).real))\n# TC combined with reshaped via backend\nfrom tensorcircuit import backend\nr01 = backend.reshaped(H2, 3); r23 = backend.reshaped(H2, 3)\nprint(\\\"tc combined reshaped:\\\", float(c.expectation((r01, [0,1]), (r23, [2,3])).real))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
