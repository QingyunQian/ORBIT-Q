{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/dbg11.py <<'EOF'\nimport numpy as np\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\n\nn=2\nSx = jnp.asarray(np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.))\nSy = jnp.asarray(np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.))\nSz = jnp.asarray(np.diag([1.,0.,-1.]).astype(complex))\nSz2 = Sz@Sz\nXX = jnp.kron(Sx,Sx); YY = jnp.kron(Sy,Sy); ZZ = jnp.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2 = SS + 0.2*(SS@SS)\n\ndigits = np.array([0,2])\ninit = np.zeros(9, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3,3])] = 1.0\ninit_j = jnp.asarray(init)\n\n# no gates: expectation Sz2 on site 0 and 1; H2 on (0,1)\nc = tc.Circuit(n, dim=3, inputs=init_j)\nprint(\\\"E0 Sz2:\\\", c.expectation((Sz2,[0])))\nprint(\\\"E1 Sz2:\\\", c.expectation((Sz2,[1])))\nprint(\\\"E H2 bond:\\\", c.expectation((H2,[0,1])))\nprint(\\\"state shape:\\\", c.state().shape)\n\n# apply Rz(0.3) on site 0, check <Sz> \ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\nc2 = tc.Circuit(n, dim=3, inputs=init_j)\nc2.unitary(0, unitary=rz(0.3), dim=3)\nprint(\\\"Sz site0 after Rz:\\\", c2.expectation((Sz,[0])))\nprint(\\\"state:\\\", np.asarray(c2.state()))\n\n# two-site gate: apply u2 with theta=0.3, phi=0.1 to |+1,-1>\ndef u2m(theta, phi):\n    M = theta*(XX+YY) + phi*ZZ + 0.2*(SS@SS)\n    return jexpm(-1j*M)\nU = u2m(0.3, 0.1)\nc3 = tc.Circuit(n, dim=3, inputs=init_j)\nc3.unitary(0, 1, unitary=U, dim=3)\nst_tc = np.asarray(c3.state()).reshape(3,3)\n# numpy reference\npsi = np.zeros((3,3), dtype=complex); psi[0,2]=1\nst_np = np.tensordot(np.asarray(U).reshape(3,3,3,3), psi, axes=([2,3],[0,1]))\nprint(\\\"TC state match:\\\", np.allclose(st_tc, np.moveaxis(st_np,0,0)))\nprint(\\\"max diff:\\\", np.max(np.abs(st_tc - st_np)))\n# expectation H2 after gate\nprint(\\\"H2 exp tc:\\\", c3.expectation((H2,[0,1])))\nH2np = np.asarray(H2)\nprint(\\\"H2 exp np:\\\", np.vdot(st_np.ravel(), H2np@st_np.ravel()))\nEOF\npython /tmp/dbg11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
