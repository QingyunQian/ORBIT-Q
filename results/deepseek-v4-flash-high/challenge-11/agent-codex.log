return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\n    def build_circuit(params):\n        c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n        for l in range(n_layers):\n            p = params[l]\n            for i in range(n_sites):\n                a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n                c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n            for k, (i, j) in enumerate(even_bonds):\n                th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n                c.unitary(i, j, unitary=u2(th, ph), dim=3)\n            for k, (i, j) in enumerate(odd_bonds):\n                th = p[off+2*k]; ph = p[off+2*k+1]\n                c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        return c\n\n    def energy_density(params):\n        st = build_circuit(params).state().reshape([3]*n_sites)\n        e = 0.0\n        for (i, j) in bonds:\n            st2 = st.reshape(3**i, 9, 3**(n_sites-j-1))\n            rho = jnp.tensordot(st2, jnp.conj(st2), axes=([0,2],[0,2]))\n            e = e + jnp.real(jnp.sum(rho*H2j))\n        for i in range(n_sites):\n            st1 = st.reshape(3**i, 3, 3**(n_sites-i-1))\n            rho = jnp.tensordot(st1, jnp.conj(st1), axes=([0,2],[0,2]))\n            e = e + D*jnp.real(jnp.sum(rho*Sz2j))\n        return e/n_sites\n\n    vgf = jax.jit(jax.value_and_grad(energy_density))\n    ef = jax.jit(energy_density)\n\n    per_layer = n_rot + 2*(n_even+n_odd)\n    key = jax.random.PRNGKey(seed)\n    params = jax.random.normal(key, (n_layers, per_layer), dtype=jnp.float32)*scale\n\n    opt = optax.adam(lr)\n    opt_state = opt.init(params)\n    history = np.zeros(max_steps, dtype=np.float64)\n    for k in range(max_steps):\n        v, g = vgf(params)\n        history[k] = float(v)\n        updates, opt_state = opt.update(g, opt_state, params)\n        params = optax.apply_updates(params, updates)\n\n    final_e = float(ef(params))\n\n    # string orders from final state: <Sz_i prod P_k Sz_j>\n    st = build_circuit(params).state()\n    st2 = jnp.abs(st)**2\n    def diag_string(i, j):\n        per = [jnp.ones(3, dtype=jnp.complex64)]*n_sites\n        per[i] = jnp.diag(jnp.array([1.,0.,-1.], dtype=jnp.complex64))\n        per[j] = per[i]\n        for k in range(i+1, j):\n            per[k] = Pj\n        d = per[0]\n        for p in per[1:]:\n            d = jnp.kron(d, p)\n        return jnp.real(jnp.sum(st2*d))\n    strs = jnp.array([diag_string(i, j) for (i, j) in [(0, n_sites-1), (1, n_sites-2), (2, n_sites-3)]])\n\n    return {\n        \\\"energy_density_history\\\": np.asarray(history),\n        \\\"final_energy_density\\\": np.asarray(final_e, dtype=np.float64),\n        \\\"final_string_orders\\\": np.asarray(strs),\n    }\n\nif __name__ == \\\"__main__\\\":\n    import time\n    cfg = {\n        \\\"n_sites\\\": 12, \\\"n_layers\\\": 5, \\\"beta\\\": 0.20,\n        \\\"single_ion_anisotropy\\\": 0.15, \\\"max_steps\\\": 500,\n        \\\"learning_rate\\\": 0.03, \\\"initial_parameter_scale\\\": 0.05,\n        \\\"seed\\\": 2041,\n        \\\"minimum_energy_improvement\\\": 5e-3,\n        \\\"maximum_energy_density_gap\\\": 0.12,\n        \\\"maximum_string_order_mae\\\": 0.12,\n    }\n    t0 = time.time()\n    res = run_solution(cfg)\n    print(\\\"total time:\\\", round(time.time()-t0,1))\n    print(\\\"history shape:\\\", res[\\\"energy_density_history\\\"].shape)\n    print(\\\"final energy density:\\\", res[\\\"final_energy_density\\\"])\n    print(\\\"final strings:\\\", res[\\\"final_string_orders\\\"])\n    print(\\\"hist[0]:\\\", res[\\\"energy_density_history\\\"][0], \\\"hist[-1]:\\\", res[\\\"energy_density_history\\\"][-1])\n    print(\\\"improvement:\\\", res[\\\"energy_density_history\\\"][0]-res[\\\"final_energy_density\\\"])\nEOF\ncd /tmp && timeout 300 python solution_11_dev.py\"","aggregated_output":"","exit_code":137,"status":"failed"}}
