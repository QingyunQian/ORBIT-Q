{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench11.py <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\n\nn_sites = 12\nn_layers = 5\nbeta = 0.20\nD = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\nH2np = SS + beta*(SS@SS)\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\nn_rot = 3*n_sites; n_even = 6; n_odd = 5; off = n_rot + 2*n_even\neven_bonds = [(2*b,2*b+1) for b in range(6)]\nodd_bonds = [(2*b+1,2*b+2) for b in range(5)]\nSxj = jnp.asarray(Sx); Syj = jnp.asarray(Sy); Szj = jnp.asarray(Sz)\nXXj = jnp.asarray(XX); YYj = jnp.asarray(YY); ZZj = jnp.asarray(ZZ)\nSSj = jnp.asarray(SS); H2j = jnp.asarray(H2np)\nSz2j = jnp.diag(jnp.array([1,0,1], dtype=jnp.complex64))\n\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\ndef ry(th):\n    return jexpm(-1j*th*Syj)\ndef u2(th, ph):\n    return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\ndef build_circuit(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for l in range(n_layers):\n        p = params[l]\n        for i in range(n_sites):\n            a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n            c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n    return c\n\ndef energy(params):\n    c = build_circuit(params)\n    e = c.expectation((H2j, [0,1])) + c.expectation((H2j, [2,3])) + c.expectation((H2j, [4,5])) \\\\\n        + c.expectation((H2j, [6,7])) + c.expectation((H2j, [8,9])) + c.expectation((H2j, [10,11])) \\\\\n        + c.expectation((H2j, [1,2])) + c.expectation((H2j, [3,4])) + c.expectation((H2j, [5,6])) \\\\\n        + c.expectation((H2j, [7,8])) + c.expectation((H2j, [9,10]))\n    e = e + D*sum(c.expectation((Sz2j, [i])) for i in range(n_sites))\n    return jnp.real(e)/n_sites\n\nkey = jax.random.PRNGKey(2041)\nparams = jax.random.normal(key, (n_layers, n_rot+2*(n_even+n_odd)), dtype=jnp.float32)*0.05\n\n# eager single call timing\nt0=time.time()\ne0 = float(energy(params))\nt1=time.time()\nprint(\\\"eager energy:\\\", e0, \\\"time\\\", t1-t0)\n\n# jit\nefun = jax.jit(energy)\nt0=time.time()\ne1 = float(efun(params))\nt1=time.time()\nprint(\\\"jit warmup energy:\\\", e1, \\\"compile+run\\\", t1-t0)\nt0=time.time()\ne2 = float(efun(params))\nt1=time.time()\nprint(\\\"jit steady:\\\", e2, \\\"time\\\", t1-t0)\n\n# grad\nvgf = jax.jit(jax.value_and_grad(energy))\nt0=time.time()\nval, grad = vgf(params)\nt1=time.time()\nprint(\\\"jit vg warmup:\\\", float(val), \\\"time\\\", t1-t0, \\\"gradnorm\\\", float(jnp.linalg.norm(grad)))\nt0=time.time()\nval, grad = vgf(params)\nt1=time.time()\nprint(\\\"jit vg steady:\\\", float(val), \\\"time\\\", t1-t0)\nEOF\npython /tmp/bench11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
