{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\n\nn_sites = 12; n_layers = 5; beta = 0.20; D = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\nn_rot = 36; n_even = 6; n_odd = 5; off = n_rot + 2*n_even\neven_bonds = [(2*b,2*b+1) for b in range(6)]\nodd_bonds = [(2*b+1,2*b+2) for b in range(5)]\nSxj = jnp.asarray(Sx); Syj = jnp.asarray(Sy)\nXXj = jnp.asarray(XX); YYj = jnp.asarray(YY); ZZj = jnp.asarray(ZZ); SSj = jnp.asarray(SS)\n\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\ndef ry(th): return jexpm(-1j*th*Syj)\ndef u2(th, ph): return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\ndef build_circuit(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for l in range(n_layers):\n        p = params[l]\n        for i in range(n_sites):\n            a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n            c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n    return c\n\ndef state_of(params): return build_circuit(params).state()\n\nnp_ = n_rot + 2*(n_even+n_odd)\nparams = jax.random.normal(jax.random.PRNGKey(3), (n_layers, np_), dtype=jnp.float32)*0.05\n\nfrom tensorcircuit.backends import *\nimport tensorcircuit.cons as cons\nfor optname in [\\\"greedy\\\", \\\"branch\\\", \\\"optimal\\\"]:\n    try:\n        cons.set_contractor(\\\"custom\\\", optimizer=optname)\n        # rebuild jit (plan is baked in)\n        js = jax.jit(state_of)\n        t0=time.time(); r = js(params); r.block_until_ready(); t1=time.time()\n        # steady\n        t2=time.time()\n        for _ in range(3):\n            r = js(params); r.block_until_ready()\n        t3=time.time()\n        print(optname, \\\"compile+first:\\\", round(t1-t0,2), \\\"steady/3:\\\", round(t3-t2,3))\n    except Exception as e:\n        print(optname, \\\"failed:\\\", type(e).__name__, str(e)[:120])\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
