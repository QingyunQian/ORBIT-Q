{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'EOF'\nimport tensorcircuit as tc\nfrom tensorcircuit.simplify import _split_two_qubit_gate\nimport inspect\nprint(inspect.getsource(_split_two_qubit_gate)[:5000])\nEOF\"","aggregated_output":"def _split_two_qubit_gate(\n    a: tn.Node,\n    max_singular_values: Optional[int] = None,\n    max_truncation_err: Optional[float] = None,\n    fixed_choice: Optional[int] = None,\n) -> Any:\n    if (max_singular_values is not None) and (fixed_choice is None):\n        fixed_choice = 1\n    ndict, _ = tn.copy([a])\n    n = ndict[a]\n    n1, n2, _ = tn.split_node(\n        n,\n        left_edges=[n[0], n[2]],\n        right_edges=[n[1], n[3]],\n        max_singular_values=max_singular_values,\n        max_truncation_err=max_truncation_err,\n    )\n    if fixed_choice == 1:\n        # still considering better API type for fixed_choice\n        return n1, n2, False\n    s1 = n1.tensor.shape[-1]  # bond dimension\n    n3, n4, _ = tn.split_node(\n        n,\n        left_edges=[n[0], n[3]],\n        right_edges=[n[1], n[2]],\n        max_singular_values=max_singular_values,\n        max_truncation_err=max_truncation_err,\n    )\n    if fixed_choice == 2:  # swap one\n        return n3, n4, True  # swap\n    s2 = n3.tensor.shape[-1]\n    if (s1 >= n[0].dimension * n[2].dimension) and (\n        s2 >= n[1].dimension * n[3].dimension\n    ):\n        # jax jit unspport split_node with trun_err anyway\n        # tf function doesn't work either, though I believe it may work on tf side\n        # CANNOT DONE(@refraction-ray): tf.function version with trun_err set\n        return None\n    if s1 <= s2:  # equal is necessary for max values to pick on unswap one\n        return n1, n2, False  # no swap\n    return n3, n4, True  # swap\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\n\nn_sites = 12; n_layers = 5; beta = 0.20; D = 0.15\nSx = np.array([[0.,1.,0.],[1.,0.,1.],[0.,1.,0.]])/np.sqrt(2.)\nSy = np.array([[0.,-1j,0.],[1j,0.,-1j],[0.,1j,0.]])/np.sqrt(2.)\nSz = np.diag([1.,0.,-1.]).astype(complex)\nXX = np.kron(Sx,Sx); YY = np.kron(Sy,Sy); ZZ = np.kron(Sz,Sz)\nSS = XX+YY+ZZ; H2np = SS + beta*(SS@SS)\ndigits = np.array([0,2]*6)\ninit = np.zeros(3**n_sites, dtype=np.complex64)\ninit[np.ravel_multi_index(digits, [3]*n_sites)] = 1.0\ninit_j = jnp.asarray(init)\nn_rot = 36; n_even = 6; n_odd = 5; off = n_rot + 2*n_even\neven_bonds = [(2*b,2*b+1) for b in range(6)]\nodd_bonds = [(2*b+1,2*b+2) for b in range(5)]\nbonds = even_bonds+odd_bonds\nSxj = jnp.asarray(Sx); Syj = jnp.asarray(Sy)\nXXj = jnp.asarray(XX); YYj = jnp.asarray(YY); ZZj = jnp.asarray(ZZ); SSj = jnp.asarray(SS)\nH2j = jnp.asarray(H2np); Sz2j = jnp.diag(jnp.array([1,0,1], dtype=jnp.complex64))\n\ndef rz(phi):\n    e = jnp.exp(-1j*phi)\n    return jnp.diag(jnp.array([e, 1.0+0j, 1.0/e]))\ndef ry(th): return jexpm(-1j*th*Syj)\ndef u2(th, ph): return jexpm(-1j*(th*(XXj+YYj) + ph*ZZj + beta*(SSj@SSj)))\n\ndef build_circuit(params):\n    c = tc.Circuit(n_sites, dim=3, inputs=init_j)\n    for l in range(n_layers):\n        p = params[l]\n        for i in range(n_sites):\n            a = p[3*i]; b = p[3*i+1]; g = p[3*i+2]\n            c.unitary(i, unitary=rz(a)@ry(b)@rz(g), dim=3)\n        for k,(i,j) in enumerate(even_bonds):\n            th = p[n_rot+2*k]; ph = p[n_rot+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n        for k,(i,j) in enumerate(odd_bonds):\n            th = p[off+2*k]; ph = p[off+2*k+1]\n            c.unitary(i, j, unitary=u2(th, ph), dim=3)\n    return c\n\ndef energy_state(params):\n    st = build_circuit(params).state().reshape([3]*n_sites)\n    e = 0.0\n    for (i,j) in bonds:\n        st2 = st.reshape(3**i, 9, 3**(n_sites-j-1))\n        rho = jnp.tensordot(st2, jnp.conj(st2), axes=([0,2],[0,2]))\n        e = e + jnp.real(jnp.sum(rho * H2j))\n    for i in range(n_sites):\n        st1 = st.reshape(3**i, 3, 3**(n_sites-i-1))\n        rho = jnp.tensordot(st1, jnp.conj(st1), axes=([0,2],[0,2]))\n        e = e + D*jnp.real(jnp.sum(rho * Sz2j))\n    return e/n_sites\n\nnp_ = n_rot + 2*(n_even+n_odd)\nparams = jax.random.normal(jax.random.PRNGKey(3), (n_layers, np_), dtype=jnp.float32)*0.05\njv = jax.jit(jax.value_and_grad(energy_state))\nt0=time.time(); v,g = jv(params); g.block_until_ready(); print(\\\"vg state compile:\\\", round(time.time()-t0,1), \\\"val\\\", float(v))\nfor rep in range(3):\n    t0=time.time(); v,g = jv(params); g.block_until_ready(); print(\\\"vg state steady:\\\", round(time.time()-t0,4))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
