   Rz = lambda ph: np.diag([np.exp(-1j*ph),1.,np.exp(1j*ph)])\n    mat = Rz(a) @ scipy.linalg.expm(-1j*b*Sy) @ Rz(g)\n    psi = np.moveaxis(np.tensordot(mat, psi, axes=([1],[i])), 0, i)\nfor k,(i,j) in enumerate(even_bonds):\n    th, ph = p[n_rot+2*k], p[n_rot+2*k+1]\n    U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n    psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\nfor k,(i,j) in enumerate(odd_bonds):\n    th, ph = p[off+2*k], p[off+2*k+1]\n    U = scipy.linalg.expm(-1j*(th*(XX+YY)+ph*ZZ+beta*(SS@SS))).reshape(3,3,3,3)\n    psi = np.moveaxis(np.tensordot(U, psi, axes=([2,3],[i,j])), [0,1], [i,j])\n\n# numpy bond sums\nnp_even = 0.0\nfor k,(i,j) in enumerate(even_bonds):\n    Hp = np.moveaxis(np.tensordot(H2np.reshape(3,3,3,3), psi, axes=([2,3],[i,j])), [0,1], [i,j])\n    np_even += np.vdot(psi, Hp).real\nnp_odd = 0.0\nfor k,(i,j) in enumerate(odd_bonds):\n    Hp = np.moveaxis(np.tensordot(H2np.reshape(3,3,3,3), psi, axes=([2,3],[i,j])), [0,1], [i,j])\n    np_odd += np.vdot(psi, Hp).real\nnp_single = 0.0\nfor i in range(n_sites):\n    Hp = np.moveaxis(np.tensordot(np.diag([1.,0.,1.]), psi, axes=([1],[i])), 0, i)\n    np_single += D*np.vdot(psi, Hp).real\nprint(\\\"np even\\\", np_even, \\\"odd\\\", np_odd, \\\"single\\\", np_single, \\\"total\\\", (np_even+np_odd+np_single)/n_sites)\n\n# TC combined\ntc_even = float(c.expectation(*[(H2j, b) for b in even_bonds]).real)\nprint(\\\"tc even combined:\\\", tc_even)\ntc_even_ind = sum(float(c.expectation((H2j, b)).real) for b in even_bonds)\nprint(\\\"tc even individual sum:\\\", tc_even_ind)\ntc_odd = float(c.expectation(*[(H2j, b) for b in odd_bonds]).real)\nprint(\\\"tc odd combined:\\\", tc_odd, \\\"ind:\\\", sum(float(c.expectation((H2j,b)).real) for b in odd_bonds))\ntc_single = float(D*c.expectation(*[(Sz2j, [i]) for i in range(n_sites)]).real)\nprint(\\\"tc single combined:\\\", tc_single, \\\"ind:\\\", sum(float(D*c.expectation((Sz2j,[i])).real) for i in