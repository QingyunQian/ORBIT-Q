{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cd /root && cat > /tmp/bench12.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport quimb.tensor as qtn\nimport time\n\nn = 32\nnp.random.seed(0)\n\n# synthetic target MPS chi=8, lrp\nchi = 8\nbs = [1] + [chi]*(n-1) + [1]\narrays = [(np.random.randn(bs[i], bs[i+1], 2) + 1j*np.random.randn(bs[i], bs[i+1], 2)) for i in range(n)]\nps = qtn.MatrixProductState(arrays, shape=\\\"lrp\\\")\nps.normalize()\n\nbra_tensors = [np.transpose(np.asarray(a.data), (0,2,1)) for a in ps.tensors]\nbra = tc.MPSCircuit(n, tensors=bra_tensors, center_position=None)\n\nneel = []\nfor i in range(n):\n    b = i % 2\n    t = np.zeros((1,2,1), dtype=complex)\n    t[0,b,0] = 1.0\n    neel.append(t)\n\nbonds = [(2*j, 2*j+1) for j in range(n//2)] + [(2*j+1, 2*j+2) for j in range(n//2 - 1)]\nn_gates = len(bonds)\nprint(\\\"n_gates:\\\", n_gates)\n\ndef loss_fn(theta):\n    mps = tc.MPSCircuit(n, tensors=neel)\n    for k, (i1, i2) in enumerate(bonds):\n        g = tc.gates.su4_gate(theta[k])\n        mps.apply_double_gate(g, i1, i2)\n    ov = mps.proj_with_mps(bra)\n    return 1.0 - jnp.real(ov * jnp.conj(ov))\n\ntheta0 = np.random.uniform(-0.02, 0.02, size=(n_gates, 15)).astype(np.float64)\nloss_jit = jax.jit(loss_fn)\nloss_jit(theta0)\nprint(\\\"loss:\\\", loss_jit(theta0))\ng = jax.grad(loss_fn)(theta0)\nprint(\\\"grad finite:\\\", np.isfinite(g).all(), g.shape)\n\n# full step with optax adam\nopt = optax.adam(0.02)\nopt_state = opt.init(theta0)\n@jax.jit\ndef step(theta, opt_state):\n    loss, g = jax.value_and_grad(loss_fn)(theta)\n    updates, opt_state = opt.update(g, opt_state, theta)\n    theta = optax.apply_updates(theta, updates)\n    return theta, opt_state, loss\n\ntheta = theta0\nt0 = time.time()\nstep(theta, opt_state)\nprint(\\\"compile+run first:\\\", time.time()-t0)\nt0 = time.time()\nfor i in range(200):\n    theta, opt_state, loss = step(theta, opt_state)\nprint(\\\"200 steps:\\\", time.time()-t0, \\\"loss now:\\\", loss)\nEOF\npython /tmp/bench12.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
