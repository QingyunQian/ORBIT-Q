{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cd /root && cat -n solution_12.py && echo \\\"---\\\" && awk 'NF>0 && \"'$1 !~ /''^#/'\"' solution_12.py | wc -l\"","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\timport tensorcircuit as tc\n     4\t\n     5\ttc.set_backend(\"jax\")\n     6\ttc.set_dtype(\"complex128\")\n     7\t\n     8\timport jax\n     9\timport jax.numpy as jnp\n    10\timport optax\n    11\t\n    12\t\n    13\tdef run_solution(config):\n    14\t    n = config[\"n_qubits\"]\n    15\t    n_layers = config[\"n_layers\"]\n    16\t    max_steps = config[\"max_steps\"]\n    17\t    learning_rate = config[\"learning_rate\"]\n    18\t    seed = config[\"seed\"]\n    19\t    scale = config[\"initial_parameter_scale\"]\n    20\t\n    21\t    # Alternating brickwork bonds: layer l acts on bonds (2j+l, 2j+l+1).\n    22\t    bonds = [\n    23\t        (2 * j + l, 2 * j + l + 1)\n    24\t        for l in range(n_layers)\n    25\t        for j in range(n // 2)\n    26\t        if 2 * j + l + 1 < n\n    27\t    ]\n    28\t    n_params = len(bonds) * 15\n    29\t\n    30\t    # Target MPS (quimb canonical shape (left, right, phys)) -> (left, phys, right).\n    31\t    mps = config[\"dmrg_state\"]\n    32\t    tensors = [np.asarray(t.data) for t in mps.tensors]\n    33\t    bra_tensors = []\n    34\t    for i, a in enumerate(tensors):\n    35\t        if a.ndim == 2:  # boundary tensor without the empty bond\n    36\t            a = np.transpose(a)  # (phys, bond)\n    37\t            if i == 0:\n    38\t                a = a[None, :, :]  # (1, phys, bond)\n    39\t            else:\n    40\t                a = a[:, :, None]  # (bond, phys, 1)\n    41\t        elif a.shape[1] != 2:\n    42\t            a = np.transpose(a, (0, 2, 1))\n    43\t        bra_tensors.append(a)\n    44\t    bra = tc.MPSCircuit(n, tensors=bra_tensors, center_position=0)\n    45\t\n    46\t    # Neel |0101...01> product-state MPS.\n    47\t    neel = []\n    48\t    for i in range(n):\n    49\t        t = np.zeros((1, 2, 1), dtype=np.complex128)\n    50\t        t[0, i % 2, 0] = 1.0\n    51\t        neel.append(t)\n    52\t\n    53\t    def overlap_fn(theta):\n    54\t        ket = tc.MPSCircuit(n, tensors=neel)\n    55\t        for k, (i1, i2) in enumerate(bonds):\n    56\t            ket.apply_double_gate(tc.gates.su4_gate(theta[k]), i1, i2)\n    57\t        return ket.proj_with_mps(bra)\n    58\t\n    59\t    def loss_fn(theta):\n    60\t        ov = overlap_fn(theta)\n    61\t        return 1.0 - jnp.real(ov * jnp.conj(ov))\n    62\t\n    63\t    loss_and_grad = jax.jit(jax.value_and_grad(loss_fn))\n    64\t    overlap_jit = jax.jit(overlap_fn)\n    65\t\n    66\t    rng = np.random.default_rng(seed)\n    67\t    theta = jnp.asarray(rng.uniform(-scale, scale, size=(len(bonds), 15)))\n    68\t\n    69\t    optimizer = optax.adam(learning_rate)\n    70\t    opt_state = optimizer.init(theta)\n    71\t\n    72\t    loss_history = np.empty(max_steps)\n    73\t    fidelity_history = np.empty(max_steps)\n    74\t    for step in range(max_steps):\n    75\t        loss, grad = loss_and_grad(theta)\n    76\t        loss_history[step] = float(loss)\n    77\t        fidelity_history[step] = 1.0 - float(loss)\n    78\t        updates, opt_state = optimizer.update(grad, opt_state, theta)\n    79\t        theta = optax.apply_updates(theta, updates)\n    80\t\n    81\t    final_parameters = np.asarray(theta).reshape(-1).copy()\n    82\t    final_overlap = complex(np.asarray(overlap_jit(theta)))\n    83\t    final_overlap_phase = float(np.angle(final_overlap))\n    84\t\n    85\t    return {\n    86\t        \"loss_history\": loss_history,\n    87\t        \"fidelity_history\": fidelity_history,\n    88\t        \"final_parameters\": final_parameters,\n    89\t        \"final_overlap_phase\": final_overlap_phase,\n    90\t    }\n---\n71\n","exit_code":0,"status":"completed"}}
