{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"cd /root && grep -n \\\"def su4\\\\|def _su4\\\\|def general_qubit_phase\\\\|class Gate\\\" /usr/local/lib/python3.11/site-packages/tensorcircuit/gates.py | head && sed -n \\\"\"'$(grep -n '\"'def su4' /usr/local/lib/python3.11/site-packages/tensorcircuit/gates.py | head -1 | cut -d: -f1),+45p\\\" /usr/local/lib/python3.11/site-packages/tensorcircuit/gates.py\"","aggregated_output":"153:class Gate(tn.Node):  # type: ignore\n261:class GateF:\n352:class GateVF(GateF):\n876:def su4_gate(theta: Tensor, name: str = \"su(4)\") -> Gate:\ndef su4_gate(theta: Tensor, name: str = \"su(4)\") -> Gate:\n    r\"\"\"\n    Two-qubit general SU(4) gate.\n\n    :param theta: the angle tensor (15 components) of the gate.\n    :type theta: Tensor\n    :param name: the name of the gate.\n    :type name: str\n    :return: a gate object.\n    :rtype: Gate\n    \"\"\"\n    theta = num_to_tensor(theta)\n    pauli_ops = array_to_tensor(\n        _ix_matrix,\n        _iy_matrix,\n        _iz_matrix,\n        _xi_matrix,\n        _xx_matrix,\n        _xy_matrix,\n        _xz_matrix,\n        _yi_matrix,\n        _yx_matrix,\n        _yy_matrix,\n        _yz_matrix,\n        _zi_matrix,\n        _zx_matrix,\n        _zy_matrix,\n        _zz_matrix,\n    )\n    generator = backend.sum(\n        backend.stack([theta[i] * pauli_ops[i] for i in range(15)]), axis=0\n    )\n    mat = backend.expm(-1j * generator)\n    mat = backend.reshape2(mat)\n    return Gate(mat, name=name)\n\n\nexp1_gate = exponential_gate_unity\n# exp1 = exponential_gate_unity\nrzz_gate = partial(exp1_gate, unitary=_zz_matrix, half=True)\nrxx_gate = partial(exp1_gate, unitary=_xx_matrix, half=True)\nryy_gate = partial(exp1_gate, unitary=_yy_matrix, half=True)\n\n\ndef multicontrol_gate(unitary: Tensor, ctrl: Union[int, Sequence[int]] = 1) -> Operator:\n    r\"\"\"\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend(\\\"jax\\\")\nimport jax\nprint(\\\"dtype:\\\", tc.get_dtype(), \\\"backend:\\\", tc.get_backend())\n\n# Build a small target MPS via quimb for testing (not part of solution)\nimport quimb.tensor as qtn\nn = 8\n# random MPS with chi=4\ntensors = []\nnp.random.seed(0)\nchi = 4\nbs = [1] + [chi]*(n-1) + [1]\nfor i in range(n):\n    t = (np.random.randn(bs[i], 2, bs[i+1]) + 1j*np.random.randn(bs[i],2,bs[i+1]))\n    tensors.append(t)\nps = qtn.MatrixProductState(tensors, shape=\\\"lrp\\\")\nps.normalize()\n\n# Neel product state tensors\nneel = []\nfor i in range(n):\n    b = i % 2\n    t = np.zeros((1,2,1), dtype=complex)\n    t[0,b,0] = 1.0\n    neel.append(t)\n\n# build ket MPSCircuit with su4 gates\ntheta = np.random.randn(2, n//2, 15).astype(np.float64)*0.1\ndef build_ket(theta):\n    mps = tc.MPSCircuit(n, tensors=neel)\n    t = theta.reshape(2, n//2, 15)\n    for layer in range(2):\n        for j in range(n//2):\n            i1 = 2*j + layer\n            i2 = i1 + 1\n            if i2 < n:\n                g = tc.gates.su4_gate(t[layer, j])\n                mps.apply_double_gate(g, i1, i2)\n    return mps\n\nket = build_ket(theta)\nprint(\\\"ket bond dims:\\\", ket.get_bond_dimensions())\n\n# bra MPSCircuit from quimb\nbra = tc.MPSCircuit(n, tensors=[np.array(t) for t in ps.tensors], center_position=None)\nov = ket.proj_with_mps(bra)\nprint(\\\"overlap MPS:\\\", ov)\n\n# exact via state vector\nfrom quimb import qarray\npsi = ps.to_dense()\n# circuit state vector via tc.Circuit\nc = tc.Circuit(n)\nc.x(np.arange(1, n, 2))  # sites 1,3,5,7 -> |0101...>\nt = theta.reshape(2,n//2,15)\nfor layer in range(2):\n    for j in range(n//2):\n        i1 = 2*j+layer; i2=i1+1\n        if i2<n:\n            c.apply_gate(tc.gates.su4_gate(t[layer,j]), i1, i2)\nsv = c.state()\nexact = np.vdot(np.asarray(psi), np.asarray(sv))\nprint(\\\"overlap exact:\\\", exact)\nprint(\\\"diff:\\\", abs(exact-ov))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
