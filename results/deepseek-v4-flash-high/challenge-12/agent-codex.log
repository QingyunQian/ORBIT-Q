{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\nimport jax\nimport quimb.tensor as qtn\n\nn = 8\nnp.random.seed(0)\nchi = 4\nbs = [1] + [chi]*(n-1) + [1]\narrays = []\nfor i in range(n):\n    t = (np.random.randn(bs[i], bs[i+1], 2) + 1j*np.random.randn(bs[i], bs[i+1], 2))\n    arrays.append(t)\nps = qtn.MatrixProductState(arrays, shape=\\\"lrp\\\")\nps.normalize()\nprint(\\\"quimb tensor shapes:\\\", [a.shape for a in ps.tensors])\n\nneel = []\nfor i in range(n):\n    b = i % 2\n    t = np.zeros((1,2,1), dtype=complex)\n    t[0,b,0] = 1.0\n    neel.append(t)\n\ntheta = np.random.randn(2, n//2, 15).astype(np.float64)*0.1\ndef build_ket(theta):\n    mps = tc.MPSCircuit(n, tensors=neel)\n    t = theta.reshape(2, n//2, 15)\n    for layer in range(2):\n        for j in range(n//2):\n            i1 = 2*j + layer\n            i2 = i1 + 1\n            if i2 < n:\n                g = tc.gates.su4_gate(t[layer, j])\n                mps.apply_double_gate(g, i1, i2)\n    return mps\n\nket = build_ket(theta)\nprint(\\\"ket bond dims:\\\", ket.get_bond_dimensions())\n\n# bra MPSCircuit from quimb: transpose (l,r,p) -> (l,p,r)\nbra_tensors = [np.transpose(np.asarray(a), (0,2,1)) for a in ps.tensors]\nbra = tc.MPSCircuit(n, tensors=bra_tensors, center_position=None)\nov = ket.proj_with_mps(bra)\nprint(\\\"overlap MPS:\\\", ov)\n\npsi = ps.to_dense()\nc = tc.Circuit(n)\nc.x(np.arange(1, n, 2))\nt = theta.reshape(2,n//2,15)\nfor layer in range(2):\n    for j in range(n//2):\n        i1 = 2*j+layer; i2=i1+1\n        if i2<n:\n            c.apply_gate(tc.gates.su4_gate(t[layer,j]), i1, i2)\nsv = c.state()\nexact = np.vdot(np.asarray(psi), np.asarray(sv))\nprint(\\\"overlap exact:\\\", exact)\nprint(\\\"diff:\\\", abs(exact-ov))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
