{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_pshift_b.py <<'PY'\nimport numpy as np, time, sys, os\nos.environ.setdefault('XLA_PYTHON_CLIENT_PREALLOCATE','false')\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax'); tc.set_dtype('complex64')\nfrom tensorcircuit import quantum as qu\nfrom tensorcircuit.templates.measurements import operator_expectation\nexec(open('/tmp/bench2.py').read().split(\\\"key=jax.random.PRNGKey(0)\\\")[0])\nB=int(sys.argv[1])\nkey=jax.random.PRNGKey(0)\np=jax.random.normal(key,(243,),dtype=jnp.float32)*0.02\ndeltas=np.zeros(243,dtype=np.float32)\nsingle_idx=[]; exp_idx=[]\nfor b in range(3):\n    base=b*81\n    single_idx += list(range(base,base+24))+list(range(base+42,base+66))\n    exp_idx += list(range(base+24,base+42))+list(range(base+66,base+81))\nsingle_idx=np.array(single_idx); exp_idx=np.array(exp_idx)\ndeltas[single_idx]=np.pi/2; deltas[exp_idx]=np.pi/4\nshifts=np.zeros((486,243),dtype=np.float32)\nfor k in range(243):\n    shifts[k,k]=deltas[k]; shifts[243+k,k]=-deltas[k]\nshift_t=jnp.asarray(shifts)\nfactors=np.ones(243,dtype=np.float32); factors[single_idx]=0.5\nbatch_obj=jax.jit(jax.vmap(objective))\nchunk=np.zeros((B,243),dtype=np.float32)\nt0=time.time(); out=batch_obj(chunk); print('batch%d compile'%B, time.time()-t0, flush=True)\nt0=time.time(); out=batch_obj(chunk); print('batch%d warm'%B, time.time()-t0, flush=True)\nm=np.zeros(243,np.float32); v=np.zeros(243,np.float32)\nt0=time.time()\nfor step in range(20):\n    out0=batch_obj(p[None,:])\n    losses=[]\n    for s in range(0,486,B):\n        out=batch_obj(p[None,:]+shift_t[s:s+B])\n        losses.append(out[0])\n    losses=jnp.concatenate(losses)\n    g=(losses[:243]-losses[243:])*factors\n    m=0.9*m+0.1*g; v=0.999*v+0.001*g*g\n    mh=m/(1-0.9**(step+1)); vh=v/(1-0.999**(step+1))\n    p=p-0.015*mh/(jnp.sqrt(vh)+1e-8)\nprint('20 steps sec',time.time()-t0, flush=True)\nprint('final',float(out0[1][0][0]),float(out0[0][0]),np.array(out0[1][2][0]))\nPY\npython /tmp/bench_pshift_b.py 27\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
