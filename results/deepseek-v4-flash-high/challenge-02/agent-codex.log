d, metrics via separate batch1\nhist=[]\nm=np.zeros(243,np.float32); v=np.zeros(243,np.float32)\nt0=time.time()\nfor step in range(20):\n    # metrics baseline\n    out0=batch_obj(p[None,:])\n    hist.append((float(out0[1][0][0]),float(out0[0][0]),float(out0[1][1][0]),np.array(out0[1][2][0])))\n    # gradient chunks\n    losses=[]\n    for s in range(0,486,B):\n        out=batch_obj(p[None,:]+shift_t[s:s+B])\n        losses.append(out[0])\n    losses=jnp.concatenate(losses)\n    g=(losses[:243]-losses[243:])*factors\n    m=0.9*m+0.1*g; v=0.999*v+0.001*g*g\n    mh=m/(1-0.9**(step+1)); vh=v/(1-0.999**(step+1))\n    p=p-0.015*mh/(jnp.sqrt(vh)+1e-8)\nprint('20 steps sec',time.time()-t0)\nprint('final',hist[-1])\nPY\npython /tmp/bench_pshift9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
