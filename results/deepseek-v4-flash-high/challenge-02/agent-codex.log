x64)))\nYYt=jnp.asarray(np.kron(np.array([[0,-1j],[1j,0]],dtype=np.complex64),np.array([[0,-1j],[1j,0]],dtype=np.complex64)))\nZZt=jnp.asarray(np.kron(np.array([[1,0],[0,-1]],dtype=np.complex64),np.array([[1,0],[0,-1]],dtype=np.complex64)))\n\ndef apply_gate(vec, ty, q0, q1, theta):\n    c=tc.Circuit(n, inputs=vec)\n    if ty==0: c.ry(q0, theta=theta)\n    elif ty==1: c.rz(q0, theta=theta)\n    elif ty==2: c.exp1(q0,q1,theta=theta,unitary=XXt)\n    elif ty==3: c.exp1(q0,q1,theta=theta,unitary=YYt)\n    else: c.exp1(q0,q1,theta=theta,unitary=ZZt)\n    return c.state()\n\ndef apply_deriv(vec, ty, q0, q1, theta):\n    c=tc.Circuit(n, inputs=vec)\n    if ty==0:\n        mat=-0.5*jnp.sin(theta/2)*I2t + 0.5j*jnp.cos(theta/2)*Yt\n        c.any(q0, unitary=mat)\n    elif ty==1:\n        mat=-0.5*jnp.sin(theta/2)*I2t + 0.5j*jnp.cos(theta/2)*Zt\n        c.any(q0, unitary=mat)\n    elif ty==2:\n        mat=-jnp.sin(theta)*XXt + 1j*jnp.cos(theta)*XXt\n        c.exp1(q0,q1,theta=1.0,unitary=mat)  # exp1 with theta=1 gives exp(-i*mat) not mat\"'! wrong\n    return c.state()\n\ndef s2_grad_formula(psi, t):\n    W=jnp.reshape(psi,(64,64))\n    rho=W @ jnp.conj(W.T)\n    pur=jnp.real(jnp.trace(rho@rho))\n    s2=-jnp.log(pur)\n    coef=2*(s2-t)*(-2.0/pur)\n    K=coef*rho\n    return jnp.reshape(K@W,(-1,))\n\n# verify s2 grad formula vs jax.grad on a random psi\nrng=jnp.array(np.random.RandomState(0).normal(size=(4096,2)).astype(np.float32).view(np.complex64).reshape(-1),dtype=jnp.complex64)\ndef lossfn(psi,t):\n    rho=qu.reduced_density_matrix(psi, subsystems_to_trace_out=list(range(6,12)))\n    return (qu.renyi_entropy(rho,k=2)-t)**2\ngg=jax.grad(lossfn)(rng,jnp.float32(0.5))\ngf=s2_grad_formula(rng,jnp.float32(0.5))\nprint('\"'s2 grad max err',float(jnp.max(jnp.abs(gg-gf))))\n\ndef objective_old(p):\n    c=tc.Circuit(n)\n    for q in (1,3,5,7,9,11): c.x(q)\n    s2s=[]\n    for b in range(3):\n        apply_block(c,p[b*81:(b+1)*81],even_bonds,odd_bonds)\n        w=c.state(); rho=qu.reduced_density_matrix(w, subsystems_to_trace_out=list(range(6,12))); s2s.append(qu.renyi_entropy(rho,k=2))\n    s2=jnp.stack(s2s); ed=operator_expectation(c,Hsp)/n; mse=jnp.mean((s2-target)**2); return ed+0.25*mse,(ed,mse,s2)\n\ndef compute(p):\n    state=init_state; states=[]\n    for k in range(len(gtype)):\n        state=apply_gate(state,int(gtype[k]),int(q0s[k]),int(q1s[k]),p[int(pinds[k])])\n        states.append(state)\n    s1=states[80]; s2s=states[161]; s3=states[242]\n    # metrics\n    # energy via sparse H\n    ed=jnp.real(jnp.sum(jnp.conj(s3)*(Hsp@s3)))/n\n    s2a=-jnp.log(jnp.real(jnp.trace((jnp.reshape(s1,(64,64))@jnp.conj(jnp.reshape(s1,(64,64)).T))@(jnp.reshape(s1,(64,64))@jnp.conj(jnp.reshape(s1,(64,64)).T)))))\n    # easier use qu functions\n    rho1=qu.reduced_density_matrix(s1, subsystems_to_trace_out=list(range(6,12)))\n    s2v=jnp.stack([qu.renyi_entropy(rho1,k=2), qu.renyi_entropy(qu.reduced_density_matrix(s2s, subsystems_to_trace_out=list(range(6,12))),k=2), qu.renyi_entropy(qu.reduced_density_matrix(s3, subsystems_to_trace_out=list(range(6,12))),k=2)])\n    mse=jnp.mean((s2v-target)**2); loss=ed+0.25*mse\n    # checkpoint grads\n    wcoef=0.25/3.0\n    g3=(Hsp@s3)/n + wcoef*s2_grad_formula(s3,target[2])\n    g2=wcoef*s2_grad_formula(s2s,target[1])\n    g1=wcoef*s2_grad_formula(s1,target[0])\n    g=jnp.zeros_like(init_state); grads=jnp.zeros((243,),dtype=jnp.float32)\n    for k in range(len(gtype)-1,-1,-1):\n        if k==242: g=g+g3\n        elif k==161: g=g+g2\n        elif k==80: g=g+g1\n        sb=init_state if k==0 else states[k-1]\n        theta=p[int(pinds[k])]\n        # derivative state\n        ty=int(gtype[k]); q0=int(q0s[k]); q1=int(q1s[k])\n        c=tc.Circuit(n, inputs=jnp.conj(sb))\n        if ty==0:\n            mat=-0.5*jnp.sin(theta/2)*I2t + 0.5j*jnp.cos(theta/2)*Yt\n            c.any(q0, unitary=mat)\n        elif ty==1:\n            mat=-0.5*jnp.sin(theta/2)*I2t + 0.5j*jnp.cos(theta/2)*Zt\n            c.any(q0, unitary=mat)\n        elif ty==2:\n            mat=-jnp.sin(theta)*XXt + 1j*jnp.cos(theta)*XXt\n            c.any(q0,q1, unitary=mat)\n        elif ty==3:\n            mat=-jnp.sin(theta)*YYt + 1j*jnp.cos(theta)*YYt\n            c.any(q0,q1, unitary=mat)\n        else:\n            mat=-jnp.sin(theta)*ZZt + 1j*jnp.cos(theta)*ZZt\n            c.any(q0,q1, unitary=mat)\n        dstate=c.state()\n        gp=2.0*jnp.real(jnp.sum(g*jnp.conj(dstate)))\n        # try no conj\n        gp2=2.0*jnp.real(jnp.sum(g*dstate))\n        grads=grads.at[int(pinds[k])].add(gp)\n        g=apply_gate(g,ty,q0,q1,-theta)\n    return loss,ed,mse,s2v,grads\n\nkey=jax.random.PRNGKey(0); p=jax.random.normal(key,(243,),dtype=jnp.float32)*0.02\nt0=time.time(); loss,ed,mse,s2v,grads=compute(p); print('manual eager sec',time.time()-t0)\nprint('loss',float(loss),'ed',float(ed),'mse',float(mse),'s2',s2v)\n# exact grad\nt0=time.time(); (l_ex,aux_ex),g_ex=jax.value_and_grad(objective_old,has_aux=True)(p); print('exact sec',time.time()-t0)\nprint('loss match',float(loss-l_ex))\nprint('grad max abs',float(jnp.max(jnp.abs(grads))),'exact',float(jnp.max(jnp.abs(g_ex))))\nprint('grad max err',float(jnp.max(jnp.abs(grads-g_ex))))\nprint('grad rel',float(jnp.max(jnp.abs(grads-g_ex)/(jnp.abs(g_ex)+1e-6))))\nPY\npython /tmp/adjoint_test.py\"","aggregated_output":"H sparse type <class 'jax.experimental.sparse.bcoo.BCOO'> is_sparse True\nnum gates 243 checkpoint indices [80, 161, 242]\ns2 grad max err 0.040924735367298126\nmanual eager sec 2.3236491680145264\nloss -0.6559896469116211 ed -0.7460358738899231 mse 0.3601848781108856 s2 [0.0020663  0.00139733 0.00409493]\nexact sec 6.680309057235718\nloss match -5.364418029785156e-07\ngrad max abs 0.4056355953216553 exact 0.1096898764371872\ngrad max err 0.45853590965270996\ngrad rel 4749.55712890625\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/small_test.py <<'PY'\nimport jax, jax.numpy as jnp, numpy as np\n# 1-qubit RY\nI=jnp.eye(2,dtype=jnp.complex64)\nY=jnp.array([[0,-1j],[1j,0]],dtype=jnp.complex64)\nZ=jnp.array([[1,0],[0,-1]],dtype=jnp.complex64)\na=jnp.array([0.3+0.1j,0.7-0.2j],dtype=jnp.complex64)\ndef loss_th(th):\n    c=jnp.cos(th/2)*I-1j*jnp.sin(th/2)*Y\n    b=c@a\n    return jnp.real(jnp.conj(b)@Z@b)\nprint('exact dth',jax.grad(loss_th)(jnp.float32(0.3)))\nth=jnp.float32(0.3)\nb=(jnp.cos(th/2)*I-1j*jnp.sin(th/2)*Y)@a\ng=jax.grad(lambda z: jnp.real(jnp.conj(z)@Z@z))(b)\nprint('g',g)\n# derivative U'* applied to a*\ndUc=(-0.5*jnp.sin(th/2)*I + 0.5j*jnp.cos(th/2)*Y)@jnp.conj(a)\nprint('cands',2*jnp.real(jnp.sum(g*dUc)),2*jnp.real(jnp.sum(jnp.conj(g)*dUc)),2*jnp.real(jnp.sum(g*jnp.conj(dUc))),2*jnp.real(jnp.sum(jnp.conj(g)*jnp.conj(dUc))))\n# check grad wrt state convention for energy psi\"'^H H psi\nh=jnp.array([[1,0],[0,-1]],dtype=jnp.complex64)\ndef E(psi): return jnp.real(jnp.conj(psi)@h@psi)\nprint('\"'gE',jax.grad(E)(a),'h a',h@a)\n# propagation test: L depends on b=Ua, compute g_a=U\"'^H g_b and compare jax.grad of L(a) wrt a*\nLa=lambda z: jnp.real(jnp.conj(U@z)@Z@(U@z))\nga=jax.grad(La)(a)\nprint('\"'ga direct',ga,'U\"'^H gb'\"',jnp.conj((jnp.cos(th/2)*I-1j*jnp.sin(th/2)*Y).T)@g)\n# S2 gradient small: n=2, W 2x2\nW=jnp.array([[0.3+0.1j,0.2-0.1j],[0.1j,0.5]],dtype=jnp.complex64)\npsi=jnp.reshape(W,(-1,))\ndef s2(psi):\n    W2=jnp.reshape(psi,(2,2)); rho=W2@jnp.conj(W2.T); pur=jnp.real(jnp.trace(rho@rho)); return -jnp.log(pur)\ndef ls(psi,t=0.2): return (s2(psi)-t)**2\ngg=jax.grad(ls)(psi)\nW2=jnp.reshape(psi,(2,2)); rho=W2@jnp.conj(W2.T); pur=jnp.real(jnp.trace(rho@rho)); s=-jnp.log(pur); coef=2*(s-0.2)*(-2/pur); K=coef*rho; gf=jnp.reshape(K@W2,(-1,))\nprint('s2',float(s),'grad exact',gg)\nprint('grad formula',gf,'err',float(jnp.max(jnp.abs(gg-gf))))\nPY\npython /tmp/small_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
