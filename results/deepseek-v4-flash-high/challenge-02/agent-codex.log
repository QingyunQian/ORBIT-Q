{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_pshift.py <<'PY'\nimport numpy as np, time\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax'); tc.set_dtype('complex64')\nfrom tensorcircuit import quantum as qu\nfrom tensorcircuit.templates.measurements import operator_expectation\nexec(open('/tmp/bench2.py').read().split(\\\"key=jax.random.PRNGKey(0)\\\")[0])\n\nkey=jax.random.PRNGKey(0)\np=jax.random.normal(key,(243,),dtype=jnp.float32)*0.02\n\n# parameter shift map\ndeltas=np.zeros(243,dtype=np.float32)\nsingle_idx=[]; exp_idx=[]\nfor b in range(3):\n    base=b*81\n    single_idx += list(range(base,base+24))+list(range(base+42,base+66))\n    exp_idx += list(range(base+24,base+42))+list(range(base+66,base+81))\nsingle_idx=np.array(single_idx)\nexp_idx=np.array(exp_idx)\ndeltas[single_idx]=np.pi/2\ndeltas[exp_idx]=np.pi/4\n# rows 0..242 plus, 243..485 minus\nshifts=np.zeros((486,243),dtype=np.float32)\nfor k in range(243):\n    shifts[k,k]=deltas[k]\n    shifts[243+k,k]=-deltas[k]\nshift_t=jnp.asarray(shifts)\nfactors=np.ones((243,),dtype=np.float32)\nfactors[single_idx]=0.5\n\n# batched objective over p rows\nbatch_obj=jax.jit(jax.vmap(objective))\n\n# baseline\nt0=time.time(); out=batch_obj(p[None,:]); print('batch1 compile+run',time.time()-t0, float(out[0][0]))\nt0=time.time(); out=batch_obj(p[None,:]); print('batch1 run',time.time()-t0)\n\n# compare gradient for one p\nbp=p[None,:]+shift_t  # (486,243)\nt0=time.time(); out=batch_obj(bp); print('batch486 first compile+run',time.time()-t0)\nt0=time.time(); out=batch_obj(bp); print('batch486 warm run',time.time()-t0)\nlosses=out[0]  # (486,)\ngrad=((losses[:243]-losses[243:])*factors)\n# exact gradient eager\nt0=time.time(); (l_ex,aux_ex),g_ex=jax.value_and_grad(objective,has_aux=True)(p); print('eager grad sec',time.time()-t0)\nprint('grad max err',float(jnp.max(jnp.abs(grad-g_ex))))\nprint('loss',float(losses.mean()), float(l_ex))\n\n# full 500-step Adam with batched parameter-shift\nbatch_in=np.concatenate([np.zeros((1,243),dtype=np.float32), shifts],axis=0)\n# precompute shift rows (487,243): baseline 0 row\nb0=jnp.asarray(batch_in)\nhist_e=np.zeros(500,np.float32); hist_l=np.zeros(500,np.float32); hist_m=np.zeros(500,np.float32); hist_s=np.zeros((500,3),np.float32)\nm=np.zeros(243,np.float32); v=np.zeros(243,np.float32)\nt0=time.time()\nfor k in range(500):\n    bp=p[None,:]+b0\n    out=batch_obj(bp)\n    loss=out[0]; aux=out[1]\n    hist_e[k]=float(aux[0][0]); hist_l[k]=float(loss[0]); hist_m[k]=float(aux[1][0]); hist_s[k]=np.array(aux[2][0])\n    losses=loss[1:]  # (486,)\n    g=((losses[:243]-losses[243:])*factors)\n    m=0.9*m+0.1*g; v=0.999*v+0.001*g*g\n    mh=m/(1-0.9**(k+1)); vh=v/(1-0.999**(k+1))\n    p=p-0.015*mh/(jnp.sqrt(vh)+1e-8)\nprint('500 steps sec',time.time()-t0)\nprint('final loss',hist_l[-1],'ed',hist_e[-1],'mse',hist_m[-1],'s2',hist_s[-1])\nPY\npython /tmp/bench_pshift.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
