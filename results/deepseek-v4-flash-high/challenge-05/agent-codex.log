001 * ga * ga\n        mb = 0.9 * mb + 0.1 * gb\n        vb = 0.999 * vb + 0.001 * gb * gb\n        mah = ma / (1 - 0.9 ** tt); vah = va / (1 - 0.999 ** tt)\n        mbh = mb / (1 - 0.9 ** tt); vbh = vb / (1 - 0.999 ** tt)\n        return (a - LR * mah / (jnp.sqrt(vah) + 1e-8), b - LR * mbh / (jnp.sqrt(vbh) + 1e-8),\n                ma, va, mb, vb, hist)\n    return jax.jit(step)\n\na0 = np.full((NL // 2, 2), INIT, dtype=np.float64)\nb0 = np.full((NL // 2, 2), INIT, dtype=np.float64)\nz5 = jnp.zeros((NL // 2, 2))\n\nfor tag, wh in ((\\\"no_hist\\\", False),):\n    step_jit = make_step(wh)\n    carry = (a0, b0, z5, z5, z5, z5, jnp.zeros(STEPS))\n    t_start = time.time()\n    for t in range(400):\n        t0 = time.time()\n        carry = step_jit(carry, t)\n        carry = jax.block_until_ready(carry)\n        t1 = time.time()\n        if t < 5 or t % 50 == 0:\n            print(tag, \\\"t\\\", t, round(t1-t0, 3), \\\"cum\\\", round(t1-t_start, 1), flush=True)\n    print(tag, \\\"done\\\", round(time.time()-t_start, 1), flush=True)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
