{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 180 python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\nN = 18; HF = 1.10; NL = 10; INIT = 0.01\n\ndef build_circuit(a, b, with_norm=True):\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    for l in range(NL):\n        al = a[l // 2, l % 2]\n        bl = b[l // 2, l % 2]\n        ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n        for i in range(N):\n            c.apply_general_gate(tc.gates.any(ga), i)\n        ebb = jnp.exp(bl); em = jnp.exp(-bl)\n        gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n        start = l % 2\n        for i in range(start, N - 1, 2):\n            c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n        if with_norm:\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(N, inputs=s / norm)\n    return c\n\na0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\nb0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\n\n# gates only\ndef gates_only(a, b):\n    c = build_circuit(a, b, with_norm=True)\n    return jnp.real(c.state()[0])\ng = jax.jit(gates_only)\nout = g(a0, b0); jax.block_until_ready(out)\nt0 = time.time(); n = 5\nfor _ in range(n):\n    out = g(a0, b0); jax.block_until_ready(out)\nprint(\\\"gates+norms fwd:\\\", round((time.time()-t0)/n, 4), \\\"s\\\")\n\n# gates + expectations\ndef full(a, b):\n    c = build_circuit(a, b, with_norm=True)\n    e = 0.0\n    for i in range(N - 1):\n        e = e - c.expectation_ps(z=[i, i + 1])\n    for i in range(N):\n        e = e - HF * c.expectation_ps(x=[i])\n    return jnp.real(e / N)\nfg = jax.jit(full)\nout = fg(a0, b0); jax.block_until_ready(out)\nt0 = time.time(); n = 3\nfor _ in range(n):\n    out = fg(a0, b0); jax.block_until_ready(out)\nprint(\\\"gates+norms+exp fwd:\\\", round((time.time()-t0)/n, 4), \\\"s\\\")\n\n# expectations only (no gates, on |+> state)\ndef exp_only(a, b):\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    e = 0.0\n    for i in range(N - 1):\n        e = e - c.expectation_ps(z=[i, i + 1])\n    for i in range(N):\n        e = e - HF * c.expectation_ps(x=[i])\n    return jnp.real(e / N)\nfe = jax.jit(exp_only)\nout = fe(a0, b0); jax.block_until_ready(out)\nt0 = time.time(); n = 5\nfor _ in range(n):\n    out = fe(a0, b0); jax.block_until_ready(out)\nprint(\\\"exp-only fwd:\\\", round((time.time()-t0)/n, 4), \\\"s\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
