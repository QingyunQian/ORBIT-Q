{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nN = 18; HF = 1.10; NL = 10; INIT = 0.01; LR = 0.02\n\ndef make_energy(n_qubits, transverse_field, n_layers):\n    def energy_fn(a, b):\n        c = tc.Circuit(n_qubits)\n        for i in range(n_qubits):\n            c.h(i)\n        for l in range(n_layers):\n            al = a[l // 2, l % 2]\n            bl = b[l // 2, l % 2]\n            ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n            for i in range(n_qubits):\n                c.apply_general_gate(tc.gates.any(ga), i)\n            ebb = jnp.exp(bl); em = jnp.exp(-bl)\n            gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n            start = l % 2\n            for i in range(start, n_qubits - 1, 2):\n                c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(n_qubits, inputs=s / norm)\n        e = 0.0\n        for i in range(n_qubits - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_qubits):\n            e = e - transverse_field * c.expectation_ps(x=[i])\n        return e / n_qubits\n    return energy_fn\n\nf = make_energy(N, HF, NL)\nloss_grad = jax.jit(jax.value_and_grad(lambda p: jnp.real(f(p[0], p[1]))))\n\na0 = np.full((NL // 2, 2), INIT, dtype=np.float64)\nb0 = np.full((NL // 2, 2), INIT, dtype=np.float64)\np = (a0, b0)\nm = (np.zeros_like(a0), np.zeros_like(b0))\nv = (np.zeros_like(a0), np.zeros_like(b0))\nhist = np.zeros(30)\n\nfor t in range(30):\n    t0 = time.time()\n    loss, (ga, gb) = loss_grad(p)\n    tt = t + 1.0\n    ma = 0.9 * m[0] + 0.1 * ga\n    va = 0.999 * v[0] + 0.001 * ga * ga\n    mb = 0.9 * m[1] + 0.1 * gb\n    vb = 0.999 * v[1] + 0.001 * gb * gb\n    mah = ma / (1 - 0.9 ** tt)\n    vah = va / (1 - 0.999 ** tt)\n    mbh = mb / (1 - 0.9 ** tt)\n    vbh = vb / (1 - 0.999 ** tt)\n    p = (p[0] - LR * mah / (jnp.sqrt(vah) + 1e-8),\n         p[1] - LR * mbh / (jnp.sqrt(vbh) + 1e-8))\n    m = (ma, mb); v = (va, vb)\n    hist[t] = np.asarray(loss)\n    t1 = time.time()\n    if t < 5 or t % 10 == 0:\n        print(t, round(t1-t0, 4), float(np.real(loss)))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
