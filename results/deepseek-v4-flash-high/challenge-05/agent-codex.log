{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 240 python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\nN = 18; HF = 1.10; NL = 10; INIT = 0.01\n\nI2 = np.eye(2, dtype=np.complex64)\nXm = np.array([[0, 1], [1, 0]], dtype=np.complex64)\nZm = np.array([[1, 0], [0, -1]], dtype=np.complex64)\n\ndef h_mpo_energy(state, h_field, n):\n    ket = tn.Node(tc.backend.reshape(state, [2] * n))\n    bra = tn.Node(tc.backend.conj(tc.backend.reshape(state, [2] * n)))\n    nodes = [ket, bra]\n    prev_out = None\n    first = None\n    for i in range(n):\n        if i == 0:\n            T = np.zeros((1, 2, 2, 3), dtype=np.complex64)\n            T[0, :, :, 0] = I2; T[0, :, :, 1] = Zm; T[0, :, :, 2] = -h_field * Xm\n        elif i == n - 1:\n            T = np.zeros((3, 2, 2, 1), dtype=np.complex64)\n            T[0, :, :, 0] = -h_field * Xm; T[1, :, :, 0] = -Zm; T[2, :, :, 0] = I2\n        else:\n            T = np.zeros((3, 2, 2, 3), dtype=np.complex64)\n            T[0, :, :, 0] = I2; T[0, :, :, 1] = Zm; T[0, :, :, 2] = -h_field * Xm\n            T[1, :, :, 2] = -Zm; T[2, :, :, 2] = I2\n        node = tn.Node(T)\n        if prev_out is not None:\n            prev_out \"'^ node[0]\n        node[1] ''^ bra[i]\n        node[2] ''^ ket[i]\n        nodes.append(node)\n        prev_out = node[3]\n        if first is None:\n            first = node\n    first[0] ''^ prev_out\n    return tc.contractor(nodes, output_edge_order=[]).tensor\n\ndef energy_mpo(a, b):\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    for l in range(NL):\n        al = a[l // 2, l % 2]; bl = b[l // 2, l % 2]\n        ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n        for i in range(N):\n            c.apply_general_gate(tc.gates.any(ga), i)\n        ebb = jnp.exp(bl); em = jnp.exp(-bl)\n        gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n        start = l % 2\n        for i in range(start, N - 1, 2):\n            c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n        s = c.state()\n        norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n        c = tc.Circuit(N, inputs=s / norm)\n    return jnp.real(h_mpo_energy(c.state(), HF, N) / N)\n\ndef energy_ps(a, b):\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    for l in range(NL):\n        al = a[l // 2, l % 2]; bl = b[l // 2, l % 2]\n        ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n        for i in range(N):\n            c.apply_general_gate(tc.gates.any(ga), i)\n        ebb = jnp.exp(bl); em = jnp.exp(-bl)\n        gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n        start = l % 2\n        for i in range(start, N - 1, 2):\n            c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n        s = c.state()\n        norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n        c = tc.Circuit(N, inputs=s / norm)\n    e = 0.0\n    for i in range(N - 1):\n        e = e - c.expectation_ps(z=[i, i + 1])\n    for i in range(N):\n        e = e - HF * c.expectation_ps(x=[i])\n    return jnp.real(e / N)\n\na0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\nb0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\n\nf_ps = jax.jit(energy_ps)\nf_mpo = jax.jit(energy_mpo)\nout_ps = f_ps(a0, b0); jax.block_until_ready(out_ps)\nout_mpo = f_mpo(a0, b0); jax.block_until_ready(out_mpo)\nprint(\"ps:\", float(out_ps), \"mpo:\", float(out_mpo), \"diff:\", abs(float(out_ps)-float(out_mpo)))\n\nfg = jax.jit(jax.value_and_grad(lambda p: energy_mpo(p[0], p[1])))\nout = fg((a0, b0)); jax.block_until_ready(out)\nprint(\"loss:\", float(out[0]))\nt0 = time.time(); n = 3\nfor _ in range(n):\n    out = fg((a0, b0)); jax.block_until_ready(out)\nt1 = time.time()\nprint(\"mpo fwd+bwd sync per call:\", round((t1-t0)/n, 4), \"s\")\nEOF'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
