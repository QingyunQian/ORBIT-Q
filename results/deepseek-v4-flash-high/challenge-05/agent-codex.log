{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nN = 18\nH_FIELD = 1.10\nN_LAYERS = 10\n\ndef make_energy(n_qubits, transverse_field, n_layers):\n    def energy_fn(a, b):\n        c = tc.Circuit(n_qubits)\n        for i in range(n_qubits):\n            c.h(i)\n        for l in range(n_layers):\n            al = a[l // 2, l % 2]\n            bl = b[l // 2, l % 2]\n            ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n            for i in range(n_qubits):\n                c.apply_general_gate(tc.gates.any(ga), i)\n            ebb = jnp.exp(bl); em = jnp.exp(-bl)\n            gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n            start = l % 2\n            for i in range(start, n_qubits - 1, 2):\n                c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(n_qubits, inputs=s / norm)\n        e = 0.0\n        for i in range(n_qubits - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_qubits):\n            e = e - transverse_field * c.expectation_ps(x=[i])\n        return e / n_qubits\n    return energy_fn\n\nf = make_energy(N, H_FIELD, N_LAYERS)\na0 = np.full((5,2), 0.01); b0 = np.full((5,2), 0.01)\n\n# single forward timing (jit)\nt0 = time.time()\nf_jit = jax.jit(f)\nout = f_jit(a0, b0)\nt1 = time.time()\nprint(\\\"compile+first eval:\\\", t1-t0, \\\"energy:\\\", out)\n\nt0 = time.time()\nfor _ in range(3):\n    out = f_jit(a0, b0)\nt1 = time.time()\nprint(\\\"per eval (no grad):\\\", (t1-t0)/3)\n\nval_and_grad = jax.jit(jax.value_and_grad(lambda p: jnp.real(f(*p))))\nt0 = time.time()\nvg = val_and_grad((a0, b0))\nt1 = time.time()\nprint(\\\"compile value_and_grad:\\\", t1-t0)\nprint(\\\"energy:\\\", vg[0], \\\"grad norm:\\\", np.linalg.norm(vg[1][0]), np.linalg.norm(vg[1][1]))\nt0 = time.time()\nfor _ in range(3):\n    vg = val_and_grad((a0, b0))\nt1 = time.time()\nprint(\\\"per step (fwd+bwd):\\\", (t1-t0)/3)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
