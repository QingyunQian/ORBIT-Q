{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\nfrom scipy.sparse import lil_matrix, kron, eye, identity\nfrom scipy.sparse.linalg import eigsh\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nN = 18; HF = 1.10; NL = 10; INIT = 0.01; STEPS = 600; LR = 0.02\n\ndef make_energy(n_qubits, transverse_field, n_layers):\n    def energy_fn(a, b):\n        c = tc.Circuit(n_qubits)\n        for i in range(n_qubits):\n            c.h(i)\n        for l in range(n_layers):\n            al = a[l // 2, l % 2]\n            bl = b[l // 2, l % 2]\n            ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n            for i in range(n_qubits):\n                c.apply_general_gate(tc.gates.any(ga), i)\n            ebb = jnp.exp(bl); em = jnp.exp(-bl)\n            gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n            start = l % 2\n            for i in range(start, n_qubits - 1, 2):\n                c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(n_qubits, inputs=s / norm)\n        e = 0.0\n        for i in range(n_qubits - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_qubits):\n            e = e - transverse_field * c.expectation_ps(x=[i])\n        return e / n_qubits\n    return energy_fn\n\nf = make_energy(N, HF, NL)\nloss_grad = jax.value_and_grad(lambda a, b: jnp.real(f(a, b)))\nloss_grad = jax.jit(loss_grad)\n\ndef train_step(carry, t):\n    a, b, ma, va, mb, vb = carry\n    loss, (ga, gb) = loss_grad(a, b)\n    tt = t + 1.0\n    ma = 0.9 * ma + 0.1 * ga\n    va = 0.999 * va + 0.001 * ga * ga\n    mb = 0.9 * mb + 0.1 * gb\n    vb = 0.999 * vb + 0.001 * gb * gb\n    mah = ma / (1 - 0.9 ** tt)\n    vah = va / (1 - 0.999 ** tt)\n    mbh = mb / (1 - 0.9 ** tt)\n    vbh = vb / (1 - 0.999 ** tt)\n    a = a - LR * mah / (jnp.sqrt(vah) + 1e-8)\n    b = b - LR * mbh / (jnp.sqrt(vbh) + 1e-8)\n    return (a, b, ma, va, mb, vb), loss\n\na0 = jnp.full((NL // 2, 2), INIT)\nb0 = jnp.full((NL // 2, 2), INIT)\nz5 = jnp.zeros((NL // 2, 2))\ncarry0 = (a0, b0, z5, z5, z5, z5)\n\nt0 = time.time()\ncarry, hist = jax.jit(jax.lax.scan)(train_step, carry0, jnp.arange(STEPS))\nt1 = time.time()\nprint(\\\"scan compile+run:\\\", t1 - t0)\na_f, b_f, *_ = carry\nhist = np.asarray(hist)\nprint(\\\"history len:\\\", len(hist), \\\"init:\\\", hist[0], \\\"final:\\\", hist[-1])\nprint(\\\"a:\\\", np.asarray(a_f))\nprint(\\\"b:\\\", np.asarray(b_f))\n\n# exact GS density via scipy sparse (validation only)\nd = 2\ndef site_op(op, n, i):\n    mats = [identity(d, format='lil') for _ in range(n)]\n    mats[i] = lil_matrix(op)\n    r = mats[0]\n    for m in mats[1:]:\n        r = kron(r, m, format='lil')\n    return r\nH = None\nX = np.array([[0,1],[1,0]])\nZ = np.array([[1,0],[0,-1]])\nfor i in range(N-1):\n    M = site_op(np.kron(Z,Z), N, i)\n    H = M if H is None else H + M\nfor i in range(N):\n    M = site_op(X, N, i)\n    H = H - HF*M if i>0 else -HF*M\nH = -H  # careful sign\nH = H.tocsr()\ne0 = eigsh(H, k=1, which='SA', return_eigenvectors=False)[0]\nprint(\\\"exact GS density:\\\", e0/N)\nprint(\\\"gap final vs GS:\\\", hist[-1] - e0/N)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
