{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 180 python - <<'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\nN = 18; HF = 1.10; NL = 10; INIT = 0.01\n\n# Build H as QuOperator via generate_local_hamiltonian(matrix_form=False)\nX = np.array([[0,1],[1,0]], dtype=np.complex64)\nZ = np.array([[1,0],[0,-1]], dtype=np.complex64)\nZZ = np.kron(Z, Z)\nterms = []\nfor i in range(N-1):\n    terms.append((-1.0 * ZZ, (i, i+1)))  # not this signature; check hlist format\n# hlist expects tensors with shape (2,2,...)? Let's check by trying\nprint(\\\"building H qop...\\\")\nHq = tc.quantum.generate_local_hamiltonian(\n    *[(-1.0)*ZZ for _ in range(N-1)], *[(-HF)*X for _ in range(N)], matrix_form=False)\nprint(\\\"Hq type:\\\", type(Hq), \\\"edges:\\\", len(Hq.out_edges))\n\ndef energy_mpi(a, b):\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    for l in range(NL):\n        al = a[l // 2, l % 2]; bl = b[l // 2, l % 2]\n        ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n        for i in range(N):\n            c.apply_general_gate(tc.gates.any(ga), i)\n        ebb = jnp.exp(bl); em = jnp.exp(-bl)\n        gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n        start = l % 2\n        for i in range(start, N - 1, 2):\n            c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n        s = c.state()\n        norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n        c = tc.Circuit(N, inputs=s / norm)\n    e = c.expectation((Hq, list(range(N))))\n    return jnp.real(e / N)\n\na0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\nb0 = np.full((NL // 2, 2), INIT, dtype=np.float32)\n\nfg = jax.jit(jax.value_and_grad(lambda p: energy_mpi(p[0], p[1])))\nout = fg((a0, b0))\njax.block_until_ready(out)\nprint(\\\"loss:\\\", float(np.real(out[0])))\nt0 = time.time(); n = 3\nfor _ in range(n):\n    out = fg((a0, b0)); jax.block_until_ready(out)\nprint(\\\"H-MPO fwd+bwd per call:\\\", round((time.time()-t0)/n, 4), \\\"s\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
