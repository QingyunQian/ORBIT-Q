{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\ndef make_energy(n_qubits, transverse_field, n_layers):\n    def energy_fn(a, b):\n        c = tc.Circuit(n_qubits)\n        for i in range(n_qubits):\n            c.h(i)\n        for l in range(n_layers):\n            al = a[l // 2, l % 2]\n            bl = b[l // 2, l % 2]\n            ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n            for i in range(n_qubits):\n                c.apply_general_gate(tc.gates.any(ga), i)\n            ebb = jnp.exp(bl); em = jnp.exp(-bl)\n            gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n            start = l % 2\n            for i in range(start, n_qubits - 1, 2):\n                c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(n_qubits, inputs=s / norm)\n        e = 0.0\n        for i in range(n_qubits - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_qubits):\n            e = e - transverse_field * c.expectation_ps(x=[i])\n        return e / n_qubits\n    return energy_fn\n\n# reference via numpy dense state vector\ndef ref_energy(n_qubits, transverse_field, n_layers, a, b):\n    sx = np.array([[0,1],[1,0]], dtype=complex)\n    sz = np.array([[1,0],[0,-1]], dtype=complex)\n    ga = lambda al: np.cosh(al)*np.eye(2) + np.sinh(al)*sx\n    gb = lambda bl: np.diag([np.exp(bl), np.exp(-bl), np.exp(-bl), np.exp(bl)])\n    psi = np.ones(2**n_qubits, dtype=complex) / np.sqrt(2**n_qubits)\n    for l in range(n_layers):\n        al = a[l//2, l%2]; bl = b[l//2, l%2]\n        M = ga(al)\n        # apply single-qubit to all\n        psi = psi.reshape([2]*n_qubits)\n        for i in range(n_qubits):\n            psi = np.tensordot(M, psi, axes=([1],[i]))\n            psi = np.moveaxis(psi, 0, i)\n        psi = psi.reshape(-1)\n        start = l % 2\n        G = gb(bl)\n        for i in range(start, n_qubits-1, 2):\n            psi = psi.reshape([2]*(i) + [2,2] + [2]*(n_qubits-i-2))\n            psi = np.tensordot(G, psi, axes=([2,3],[i,i+1]))\n            psi = np.moveaxis(psi, [0,1],[i,i+1])\n            psi = psi.reshape(-1)\n        psi = psi / np.linalg.norm(psi)\n    # Hamiltonian\n    zz = np.kron(sz, sz)\n    H = np.zeros((2**n_qubits,)*2, dtype=complex)\n    for i in range(n_qubits-1):\n        op = [np.eye(2)]*n_qubits\n        op[i] = sz; op[i+1] = sz\n        H = H - _kron_n(op)\n    for i in range(n_qubits):\n        op = [np.eye(2)]*n_qubits\n        op[i] = sx\n        H = H - transverse_field*_kron_n(op)\n    return np.real(np.vdot(psi, H@psi))/n_qubits\n\ndef _kron_n(ops):\n    r = np.array([[1.0+0j]])\n    for o in ops:\n        r = np.kron(r, o)\n    return r\n\nn = 6\na = np.array([[0.01, 0.012],[0.008,0.015],[0.02,0.01]], dtype=np.float64)\nb = np.array([[0.01, 0.011],[0.009,0.013],[0.015,0.01]], dtype=np.float64)\nf = make_energy(n, 1.1, 6)\nout_jax = f(a, b)\nout_ref = ref_energy(n, 1.1, 6, a, b)\nprint(\\\"jax:\\\", out_jax, \\\"ref:\\\", out_ref, \\\"diff:\\\", abs(complex(out_jax)-out_ref))\n\nf_jit = jax.jit(f)\nprint(\\\"jit:\\\", f_jit(a,b))\ng = jax.grad(lambda p: jax.numpy.real(f(*p)))\ngv = g((a,b))\nprint(\\\"grad ok:\\\", gv[0].shape, gv[1].shape)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
