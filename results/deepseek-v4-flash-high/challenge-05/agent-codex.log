{"type":"item.started","item":{"id":"item_113","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 300 python - <<'EOF'\nimport numpy as np\nfrom scipy.sparse import lil_matrix, kron, identity\nfrom scipy.sparse.linalg import eigsh\n\nN = 18; HF = 1.10\nd = 2\ndef site_op(op, n, i):\n    mats = [identity(d, format='lil') for _ in range(n)]\n    mats[i] = lil_matrix(op)\n    r = mats[0]\n    for m in mats[1:]:\n        r = kron(r, m, format='lil')\n    return r\nX = np.array([[0,1],[1,0]])\nZ = np.array([[1,0],[0,-1]])\nH = None\nfor i in range(N-1):\n    M = site_op(np.kron(Z,Z), N, i)\n    H = M if H is None else H + M\nfor i in range(N):\n    M = site_op(X, N, i)\n    H = H - HF*M if i>0 else -HF*M\nH = -H.tocsr()\nimport time\nt0 = time.time()\ne0 = eigsh(H, k=1, which='SA', return_eigenvectors=False, maxiter=2000)[0]\nprint(\\\"GS energy:\\\", e0, \\\"density:\\\", e0/N, \\\"time:\\\", round(time.time()-t0,1))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
