{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\ndef make_energy(n_qubits, transverse_field, n_layers):\n    def energy_fn(a, b):\n        c = tc.Circuit(n_qubits)\n        for i in range(n_qubits):\n            c.h(i)\n        for l in range(n_layers):\n            al = a[l // 2, l % 2]\n            bl = b[l // 2, l % 2]\n            ga = jnp.array([[jnp.cosh(al), jnp.sinh(al)], [jnp.sinh(al), jnp.cosh(al)]])\n            for i in range(n_qubits):\n                c.apply_general_gate(tc.gates.any(ga), i)\n            ebb = jnp.exp(bl); em = jnp.exp(-bl)\n            gb = jnp.diag(jnp.array([ebb, em, em, ebb]))\n            start = l % 2\n            for i in range(start, n_qubits - 1, 2):\n                c.apply_general_gate(tc.gates.any(gb), i, i + 1)\n            s = c.state()\n            norm = jnp.sqrt(jnp.sum(jnp.abs(s) ** 2))\n            c = tc.Circuit(n_qubits, inputs=s / norm)\n        e = 0.0\n        for i in range(n_qubits - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_qubits):\n            e = e - transverse_field * c.expectation_ps(x=[i])\n        return e / n_qubits\n    return energy_fn\n\ndef ref_energy(n, h, n_layers, a, b):\n    sx = np.array([[0,1],[1,0]], dtype=complex)\n    sz = np.array([[1,0],[0,-1]], dtype=complex)\n    ga = lambda al: np.cosh(al)*np.eye(2) + np.sinh(al)*sx\n    gb = lambda bl: np.diag([np.exp(bl), np.exp(-bl), np.exp(-bl), np.exp(bl)])\n    psi = np.ones(2**n, dtype=complex) / np.sqrt(2**n)\n    for l in range(n_layers):\n        al = a[l//2, l%2]; bl = b[l//2, l%2]\n        M = ga(al); G = gb(bl).reshape(2,2,2,2)\n        for i in range(n):\n            psi = psi.reshape(2**i, 2, 2**(n-i-1))\n            psi = np.einsum('ai,kil->akl', M, psi).reshape(-1)\n        start = l % 2\n        for i in range(start, n-1, 2):\n            psi = psi.reshape(2**i, 2, 2, 2**(n-i-2))\n            psi = np.einsum('abij,kijl->abkl', G, psi).reshape(-1)\n        psi = psi / np.linalg.norm(psi)\n    # build H as sum of local terms, apply via einsum\n    def apply_op(psi, op, pos):\n        psi = psi.reshape(2**pos, 2, 2**(n-pos-1))\n        return np.einsum('ai,kil->akl', op, psi).reshape(-1)\n    e = 0.0\n    for i in range(n-1):\n        op = np.kron(sz, sz)\n        psi2 = psi.reshape(2**i, 2, 2, 2**(n-i-2))\n        e += -np.real(np.vdot(psi2, np.einsum('abij,kijl->abkl', op.reshape(2,2,2,2), psi2)))\n    for i in range(n):\n        e += -h*np.real(np.vdot(psi, apply_op(psi, sx, i)))\n    return e/n\n\nn = 6\nrng = np.random.default_rng(0)\na = np.full((3,2), 0.01); b = np.full((3,2), 0.01)\na += rng.normal(0, 0.003, a.shape); b += rng.normal(0, 0.003, b.shape)\nf = make_energy(n, 1.1, 6)\nout_jax = f(a, b)\nout_ref = ref_energy(n, 1.1, 6, a, b)\nprint(\\\"jax:\\\", out_jax, \\\"ref:\\\", out_ref, \\\"diff:\\\", abs(complex(out_jax)-out_ref))\n\nf_jit = jax.jit(f)\nprint(\\\"jit:\\\", f_jit(a,b))\ng = jax.grad(lambda p: jax.numpy.real(f(*p)))\ngv = g((a,b))\nprint(\\\"grad shapes:\\\", gv[0].shape, gv[1].shape, \\\"grad finite:\\\", all(np.isfinite(x) for x in [gv[0], gv[1]]))\n\n# check grad vs finite diff on one param\nf0 = float(np.real(f_jit(a,b)))\neps = 1e-5\na2 = a.copy(); a2[0,0] += eps\nfa = float(np.real(f_jit(a2,b)))\nprint(\\\"fd:\\\", (fa-f0)/eps, \\\"ad:\\\", gv[0][0,0])\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
