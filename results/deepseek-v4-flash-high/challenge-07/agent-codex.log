{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto2.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\nimport jax\n\nconfig = {\n    \\\"n_data_qubits\\\": 8, \\\"n_ancilla_qubits\\\": 8, \\\"n_qubits\\\": 16, \\\"n_layers\\\": 2,\n    \\\"n_trajectories\\\": 64, \\\"initial_parameter_scale\\\": 0.1, \\\"max_steps\\\": 100,\n    \\\"learning_rate\\\": 0.02, \\\"seed\\\": 2047, \\\"transverse_field\\\": 1.05,\n}\nnq = config[\\\"n_qubits\\\"]; nd = config[\\\"n_data_qubits\\\"]; nl = config[\\\"n_layers\\\"]\nnt = config[\\\"n_trajectories\\\"]; tf = config[\\\"transverse_field\\\"]\nnpq = 6 * nl * nd  # params per block\n\ndef traj(params, status):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd)\n    th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd)\n    th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd)\n    th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        bits = []\n        for i in range(nd):\n            b = c.cond_measurement(nd + i, status=status[l, i])\n            bits.append(b)\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\nparams = np.random.default_rng(config[\\\"seed\\\"]).normal(0.0, config[\\\"initial_parameter_scale\\\"], size=(npq,))\nstatus = np.random.default_rng(123).random((nt, nl, nd))\n\n# eager check\nt0 = time.time()\ne0 = traj(params, status[0])\nprint(\\\"eager traj energy:\\\", float(e0), \\\"time:\\\", time.time()-t0)\n\nbt = tc.backend.vmap(traj, vectorized_argnums=(1,))\nt0 = time.time()\nbe = bt(params, status)\nprint(\\\"vmap eager:\\\", float(tc.backend.mean(be)), \\\"time:\\\", time.time()-t0)\n\nobj = lambda p, s: tc.backend.mean(bt(p, s))\nvg = jax.value_and_grad(obj)\nt0 = time.time()\nvgj = jax.jit(vg)\nval, g = vgj(params, status)\nprint(\\\"jit compile+run:\\\", time.time()-t0)\nprint(\\\"val:\\\", float(val), \\\"g shape:\\\", g.shape, \\\"gnorm:\\\", float(np.linalg.norm(g)))\nt0 = time.time()\nval, g = vgj(params, status)\nprint(\\\"jit rerun:\\\", time.time()-t0)\nEOF\npython /root/work/proto2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
