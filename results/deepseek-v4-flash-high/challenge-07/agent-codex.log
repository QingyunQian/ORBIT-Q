{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto8.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\n\ndef build_layer(c, l, params):\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for i in range(nd):\n        c.ry(i, theta=th_d[l, i])\n    for i in range(nd):\n        c.ry(nd + i, theta=th_a[l, i])\n    for i in range(nd):\n        c.rzz(nd + i, i, theta=th_e[l, i])\n    for i in range(nd - 1):\n        c.cnot(nd + i, nd + i + 1)\n\ndef measure_layer(c, l, params, status, mode=\\\"cond\\\"):\n    th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd)\n    th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    bits = []\n    if mode == \\\"cond\\\":\n        for i in range(nd):\n            bits.append(c.cond_measurement(nd + i, status=status[l, i]))\n    elif mode == \\\"zproj\\\":\n        for i in range(nd):\n            p1 = (1.0 - tc.backend.real(c.expectation_ps(z=[nd + i]))) / 2.0\n            b = tc.backend.cast(tc.backend.sign(status[l, i] - p1 + 1e-12) / 2 + 0.5, \\\"int32\\\")\n            bits.append(b)\n            P = np.array([[1.0,0],[0,0]]) if int(b) == 0 else np.array([[0,0],[0,1]])\n            # apply normalized projector via any\n            c.any(nd + i, unitary=P)\n    for i in range(nd):\n        th_sel = tc.backend.where(bits[i] == 0, th_f0[l, i], th_f1[l, i])\n        c.rzz(nd + i, i, theta=th_sel)\n    for i in range(nd - 1):\n        c.cnot(i, i + 1)\n    for i in range(nd):\n        c.rz(i, theta=th_p[l, i])\n\ndef energy(c):\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\ndef full(params, status, mode):\n    c = tc.Circuit(nq)\n    for l in range(nl):\n        build_layer(c, l, params)\n        measure_layer(c, l, params, status, mode)\n    return energy(c)\n\n# warmup\n_ = full(params, status[0], \\\"cond\\\")\n\nfor mode in (\\\"cond\\\", \\\"zproj\\\"):\n    t0=time.time()\n    v = full(params, status[0], mode)\n    print(mode, \\\"time:\\\", time.time()-t0, \\\"val:\\\", float(v))\n\n# state extraction cost\nc = tc.Circuit(nq)\nfor l in range(nl):\n    build_layer(c, l, params)\n    measure_layer(c, l, params, status[0], \\\"cond\\\")\nt0=time.time(); s = c.state(); print(\\\"state():\\\", time.time()-t0)\nEOF\npython /root/work/proto8.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
