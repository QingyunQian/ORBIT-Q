{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto7.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\n\nnq=16; nd=8; nl=2\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\n\ndef build_layer(c, l, params):\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for i in range(nd):\n        c.ry(i, theta=th_d[l, i])\n    for i in range(nd):\n        c.ry(nd + i, theta=th_a[l, i])\n    for i in range(nd):\n        c.rzz(nd + i, i, theta=th_e[l, i])\n    for i in range(nd - 1):\n        c.cnot(nd + i, nd + i + 1)\n\n# baseline: 8 sequential cond_measurements on a fresh circuit layer\nc = tc.Circuit(nq); build_layer(c, 0, params)\nt0 = time.time()\nfor i in range(nd):\n    b = c.cond_measurement(nd + i, status=0.3)\nprint(\\\"8 sequential cond_measurements:\\\", time.time()-t0)\n\n# joint: general_kraus with 256 projectors over 8 sites\nc2 = tc.Circuit(nq); build_layer(c2, 0, params)\nimport itertools\nprojs = []\nfor bits in itertools.product([0,1], repeat=nd):\n    P = np.array([[1.0,0],[0,0]]) if bits[0]==0 else np.array([[0,0],[0,1]])\n    for b in bits[1:]:\n        P2 = np.array([[1.0,0],[0,0]]) if b==0 else np.array([[0,0],[0,1]])\n        P = np.kron(P, P2)\n    projs.append(P)\nt0 = time.time()\nr = c2.general_kraus(projs, *range(nd, 2*nd), status=0.3, with_prob=True)\nprint(\\\"joint general_kraus 8 sites:\\\", time.time()-t0)\nprint(\\\"selected index:\\\", int(r[0]), \\\"expect z0:\\\", c2.expectation_ps(z=[0]))\nEOF\npython /root/work/proto7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
