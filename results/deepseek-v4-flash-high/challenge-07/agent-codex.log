{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto5.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\n\ndef build_and_measure(params, status, do_measure=True):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    bits = []\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            if do_measure:\n                b = c.cond_measurement(nd + i, status=status[l, i])\n            else:\n                b = tc.backend.convert_to_tensor(0)\n            bits.append(b)\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[l*nd+i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return c, bits\n\n# time measurements only (no expectations)\nt0=time.time(); c,bits = build_and_measure(params, status[0]); print(\\\"build+measure:\\\", time.time()-t0)\nt0=time.time(); c,bits = build_and_measure(params, status[0], do_measure=False); print(\\\"build no measure:\\\", time.time()-t0)\n\n# time 15 expectation calls\nc,bits = build_and_measure(params, status[0], do_measure=False)\nt0=time.time()\ne = c.expectation_ps(z=[0,1])\nfor i in range(1, nd-1): e = e + c.expectation_ps(z=[i,i+1])\nex = c.expectation_ps(x=[0])\nfor i in range(1, nd): ex = ex + c.expectation_ps(x=[i])\nres = -tc.backend.real(e) - tf*tc.backend.real(ex)\nprint(\\\"expectations:\\\", time.time()-t0, float(res))\n\n# measure_jit collapse test\nc2 = tc.Circuit(2); c2.h(0)\nm, p = c2.measure_jit(0, with_prob=True, status=tc.backend.convert_to_tensor(np.array([0.2], np.float32)))\nprint(\\\"measure_jit bit:\\\", float(m), \\\"expect z0 after:\\\", c2.expectation_ps(z=[0]))\nEOF\npython /root/work/proto5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
