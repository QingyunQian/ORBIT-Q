{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto10.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\nimport jax\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\n\ndef traj(params, status):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        bits = []\n        for i in range(nd):\n            b = c.cond_measurement(nd + i, status=status[l, i])\n            bits.append(b)\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\nbt = tc.backend.vmap(traj, vectorized_argnums=(1,))\nobj = lambda p, s: tc.backend.mean(bt(p, s))\nfwd = jax.jit(obj)\nvg = jax.jit(jax.value_and_grad(obj))\n\n_ = fwd(params, status); _ = vg(params, status)  # compile both\n_ = fwd(params, status); _ = vg(params, status)  # warm\n\nt0=time.time(); v = fwd(params, status); v.block_until_ready(); print(\\\"compiled fwd 64-trajectory:\\\", time.time()-t0, float(v))\nt0=time.time(); v2, g = vg(params, status); v2.block_until_ready(); g.block_until_ready(); print(\\\"compiled vg 64-trajectory:\\\", time.time()-t0, float(v2))\n\n# conditional: bits given, projectors applied via any() with normalization, energy via expectation_ps\ndef traj_cond(params, bits, probs):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    P0 = np.array([[1.0,0],[0,0]], dtype=np.complex64); P1 = np.array([[0,0],[0,1]], dtype=np.complex64)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            b = bits[l, i]\n            Pb = tc.backend.where(b == 0, P0, P1)\n            c.any(nd + i, unitary=Pb / tc.backend.sqrt(probs[l, i]))\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[l, i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\nbits = np.zeros((nl, nd), np.int32); probs = np.ones((nl, nd), np.float32)\nprint(\\\"eager cond single:\\\", end=\\\" \\\")\nt0=time.time(); vc = traj_cond(params, bits, probs); print(time.time()-t0, float(vc))\nEOF\npython /root/work/proto10.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
