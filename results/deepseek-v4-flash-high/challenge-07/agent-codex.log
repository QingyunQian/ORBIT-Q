{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto9.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\nimport jax\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\n\ndef traj(params, status):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        bits = []\n        for i in range(nd):\n            b = c.cond_measurement(nd + i, status=status[l, i])\n            bits.append(b)\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\n# steady state single\nfor k in range(3):\n    t0=time.time(); v = traj(params, status[0]); print(\\\"single:\\\", time.time()-t0, float(v))\n\n# eager vmap over 64\nbt = tc.backend.vmap(traj, vectorized_argnums=(1,))\nt0=time.time(); be = bt(params, status); print(\\\"vmap eager:\\\", time.time()-t0, float(be.mean()))\n\n# grad of eager single\nvg = jax.value_and_grad(lambda p, s: traj(p, s))\nt0=time.time(); val, g = vg(params, status[0]); print(\\\"eager grad single:\\\", time.time()-t0, float(val))\n\n# components: measurements only steady-state\ndef meas_only(params, status):\n    c = tc.Circuit(nq)\n    th_a = params[nl*nd:2*nl*nd].reshape(nl, nd); th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            c.cond_measurement(nd + i, status=status[l, i])\n    return c.state()\nt0=time.time(); _ = meas_only(params, status[0]); print(\\\"meas only:\\\", time.time()-t0)\nt0=time.time(); _ = meas_only(params, status[0]); print(\\\"meas only again:\\\", time.time()-t0)\nEOF\npython /root/work/proto9.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
