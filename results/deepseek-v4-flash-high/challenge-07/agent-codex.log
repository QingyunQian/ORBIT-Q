{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto11.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\nimport jax\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\nP0 = np.array([[1.0,0],[0,0]], dtype=np.complex64); P1 = np.array([[0,0],[0,1]], dtype=np.complex64)\n\n# A: sample-only pass (measurements, returns bits and probs)\ndef sample(params, status):\n    c = tc.Circuit(nq)\n    th_a = params[nl*nd:2*nl*nd].reshape(nl, nd); th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd)\n    bits = []; probs = []\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            pick, pr = c.general_kraus([P0, P1], nd + i, status=status[l, i], with_prob=True)\n            bits.append(pick)\n            probs.append(tc.backend.where(pick == 0, pr[0], pr[1]))\n        # note: data RY/th_d not needed for sampling ancilla marginals? they ARE needed (data entangled via rzz). omitted th_d & th_p here -> wrong state. fix in real impl\n    return tc.backend.stack(bits), tc.backend.stack(probs)\n\n# full correct sample: include data gates and layer feedback/post? measurement marginals need full pre-measurement state only.\ndef sample_full(params, status):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    bits = []; probs = []\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            pick, pr = c.general_kraus([P0, P1], nd + i, status=status[l, i], with_prob=True)\n            bits.append(pick)\n            probs.append(tc.backend.where(pick == 0, pr[0], pr[1]))\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[-nd+i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return tc.backend.stack(bits), tc.backend.stack(probs)\n\nsamp_b = tc.backend.vmap(sample_full, vectorized_argnums=(1,))\nsamp_bj = jax.jit(samp_b)\nt0=time.time(); bits, probs = samp_bj(params, status); bits.block_until_ready(); print(\\\"compile sample:\\\", time.time()-t0)\nt0=time.time(); bits, probs = samp_bj(params, status); bits.block_until_ready(); probs.block_until_ready(); print(\\\"compiled sample:\\\", time.time()-t0, bits.shape, probs.shape)\nt0=time.time(); bits, probs = samp_bj(params, status); bits.block_until_ready(); probs.block_until_ready(); print(\\\"compiled sample:\\\", time.time()-t0)\n\n# B: conditional pass, bits+probs given, energy via expectation_ps\ndef traj_cond(params, bits, probs):\n    c = tc.Circuit(nq)\n    th_d = params[0:nl*nd].reshape(nl, nd); th_a = params[nl*nd:2*nl*nd].reshape(nl, nd)\n    th_e = params[2*nl*nd:3*nl*nd].reshape(nl, nd); th_f0 = params[3*nl*nd:4*nl*nd].reshape(nl, nd)\n    th_f1 = params[4*nl*nd:5*nl*nd].reshape(nl, nd); th_p = params[5*nl*nd:6*nl*nd].reshape(nl, nd)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            b = bits[l, i]\n            Pb = tc.backend.where(b == 0, P0, P1)\n            c.any(nd + i, unitary=Pb / tc.backend.sqrt(probs[l, i]))\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[l, i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\nbits_np = np.zeros((64, nl, nd), np.int32); probs_np = np.ones((64, nl, nd), np.float32)\ncond_b = tc.backend.vmap(traj_cond, vectorized_argnums=(1, 2))\nobjc = lambda p, b, pr: tc.backend.mean(cond_b(p, b, pr))\nvcg = jax.jit(jax.value_and_grad(objc))\nt0=time.time(); v, g = vcg(params, bits_np, probs_np); v.block_until_ready(); g.block_until_ready(); print(\\\"compile cond-vg:\\\", time.time()-t0, float(v))\nfor k in range(2):\n    t0=time.time(); v, g = vcg(params, bits_np, probs_np); v.block_until_ready(); g.block_until_ready(); print(\\\"compiled cond-vg:\\\", time.time()-t0, float(v))\nEOF\npython /root/work/proto11.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
