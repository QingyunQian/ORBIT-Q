or i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\nbt = tc.backend.vmap(traj, vectorized_argnums=(1,))\nobj = lambda p, s: tc.backend.mean(bt(p, s))\nvg = jax.value_and_grad(obj)\nvgj = jax.jit(vg)\n\nrng = np.random.default_rng(config[\\\"seed\\\"])\nparams = rng.normal(0.0, config[\\\"initial_parameter_scale\\\"], size=(npq,)).astype(np.float32)\nstatus = rng.random((nt, nl, nd)).astype(np.float32)\n\nt0 = time.time()\nval0, g0 = vgj(params, status)\nprint(\\\"compile done, val0:\\\", float(val0), \\\"elapsed:\\\", time.time()-t0)\n\nopt = optax.adam(config[\\\"learning_rate\\\"])\nopt_state = opt.init(params)\nhistory = np.zeros(config[\\\"max_steps\\\"])\nt0 = time.time()\nfor t in range(config[\\\"max_steps\\\"]):\n    val, grads = vgj(params, status)\n    history[t] = float(val)\n    updates, opt_state = opt.update(grads, opt_state, params)\n    params = optax.apply_updates(params, updates)\nfinal_traj = np.asarray(bt(params, status))\nprint(\\\"loop time:\\\", time.time()-t0)\nprint(\\\"initial:\\\", history[0], \\\"final avg:\\\", float(final_traj.mean()), \\\"min:\\\", float(history.min()))\nprint(\\\"improvement:\\\", history[0] - final_traj.mean())\nprint(\\\"final_traj shape:\\\", final_traj.shape, final_traj.dtype)\nEOF\npython /root/work/proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
