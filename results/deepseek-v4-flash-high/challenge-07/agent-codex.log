{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"cat > /root/work/proto12.py <<'EOF'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport optax\n\nnq=16; nd=8; nl=2; tf=1.05\nnpq = 6*nl*nd\nrng = np.random.default_rng(2047)\nparams = rng.normal(0.0, 0.1, size=(npq,)).astype(np.float32)\nstatus = rng.random((64, nl, nd)).astype(np.float32)\nP0 = np.array([[1.0,0],[0,0]], dtype=np.complex64); P1 = np.array([[0,0],[0,1]], dtype=np.complex64)\n\ndef _unpack(params):\n    return (params[0:nl*nd].reshape(nl, nd), params[nl*nd:2*nl*nd].reshape(nl, nd),\n            params[2*nl*nd:3*nl*nd].reshape(nl, nd), params[3*nl*nd:4*nl*nd].reshape(nl, nd),\n            params[4*nl*nd:5*nl*nd].reshape(nl, nd), params[5*nl*nd:6*nl*nd].reshape(nl, nd))\n\ndef full_traj(params, status):\n    c = tc.Circuit(nq)\n    th_d, th_a, th_e, th_f0, th_f1, th_p = _unpack(params)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            c.cond_measurement(nd + i, status=status[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=tc.backend.where(0, th_f0[l, i], th_f0[l, i]))  # placeholder not used\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return c\n\ndef energy(c):\n    e = c.expectation_ps(z=[0, 1])\n    for i in range(1, nd - 1):\n        e = e + c.expectation_ps(z=[i, i + 1])\n    ex = c.expectation_ps(x=[0])\n    for i in range(1, nd):\n        ex = ex + c.expectation_ps(x=[i])\n    return -tc.backend.real(e) - tf * tc.backend.real(ex)\n\n# single-pass with cond_measurement + feedback (correct full protocol)\ndef full(params, status):\n    c = tc.Circuit(nq)\n    th_d, th_a, th_e, th_f0, th_f1, th_p = _unpack(params)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        bits = []\n        for i in range(nd):\n            b = c.cond_measurement(nd + i, status=status[l, i])\n            bits.append(b)\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return energy(c)\n\ndef sample_pass(params, status):\n    c = tc.Circuit(nq)\n    th_d, th_a, th_e, th_f0, th_f1, th_p = _unpack(params)\n    bits = []; probs = []\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            pick, pr = c.general_kraus([P0, P1], nd + i, status=status[l, i], with_prob=True)\n            bits.append(pick)\n            probs.append(tc.backend.where(pick == 0, pr[0], pr[1]))\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[-nd+i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return tc.backend.stack(bits), tc.backend.stack(probs)\n\ndef cond_traj(params, bits, probs):\n    c = tc.Circuit(nq)\n    th_d, th_a, th_e, th_f0, th_f1, th_p = _unpack(params)\n    for l in range(nl):\n        for i in range(nd):\n            c.ry(i, theta=th_d[l, i])\n        for i in range(nd):\n            c.ry(nd + i, theta=th_a[l, i])\n        for i in range(nd):\n            c.rzz(nd + i, i, theta=th_e[l, i])\n        for i in range(nd - 1):\n            c.cnot(nd + i, nd + i + 1)\n        for i in range(nd):\n            b = bits[l, i]\n            Pb = tc.backend.where(b == 0, P0, P1)\n            c.any(nd + i, unitary=Pb / tc.backend.sqrt(probs[l, i]))\n        for i in range(nd):\n            th_sel = tc.backend.where(bits[l, i] == 0, th_f0[l, i], th_f1[l, i])\n            c.rzz(nd + i, i, theta=th_sel)\n        for i in range(nd - 1):\n            c.cnot(i, i + 1)\n        for i in range(nd):\n            c.rz(i, theta=th_p[l, i])\n    return energy(c)\n\n# equivalence check: eager, several statuses\nfor s in range(5):\n    st = status[s]\n    e1 = full(params, st)\n    bits, probs = sample_pass(params, st)\n    e2 = cond_traj(params, bits.reshape(nl, nd), probs.reshape(nl, nd))\n    print(s, \\\"full:\\\", float(e1), \\\"split:\\\", float(e2), \\\"diff:\\\", abs(float(e1)-float(e2)))\nEOF\npython /root/work/proto12.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
