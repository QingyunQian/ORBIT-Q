{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'EOF'\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nn = 8; h = 1.05\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi)\ndmrg.solve(verbosity=0)\nprint(\\\"energies:\\\", dmrg.energies)\nprint(\\\"max_bond:\\\", psi.max_bond())\nprint(\\\"bond dims:\\\", [t.shape for t in psi.tensors])\nX = qu.pauli(\\\"X\\\"); Z = qu.pauli(\\\"Z\\\"); I2 = qu.eye(2)\ndef kron_all(ops):\n    out = np.array(1.0+0j)\n    for o in ops: out = np.kron(out, o)\n    return out\nHm = np.zeros((2**n,2**n), dtype=complex)\nfor i in range(n-1):\n    ops = [I2]*n; ops[i]=Z; ops[i+1]=Z; Hm -= kron_all(ops)\nfor i in range(n):\n    ops = [I2]*n; ops[i]=X; Hm -= h*kron_all(ops)\nevals, evecs = np.linalg.eigh(Hm)\nprint(\\\"exact:\\\", evals[0])\n# fidelity of psi vs exact gs\narr = psi.to_dense()\nprint(\\\"fidelity:\\\", abs(np.vdot(evecs[:,0], arr.ravel()))**2)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
