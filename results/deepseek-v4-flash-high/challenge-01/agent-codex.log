{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto3.py <<'EOF'\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\ndef quimb_mps_to_tensors(mps):\n    ts = mps.tensors\n    n = len(ts)\n    out = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        phys = None\n        for j, ind in enumerate(inds):\n            if ind == f\\\"k{i}\\\":\n                phys = j; break\n        if phys is None:\n            others = set()\n            if i > 0: others |= set(ts[i-1].inds)\n            if i < n-1: others |= set(ts[i+1].inds)\n            for j, ind in enumerate(inds):\n                if ind not in others:\n                    phys = j; break\n        left = right = None\n        if i > 0:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i-1].inds): left = j; break\n        if i < n-1:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i+1].inds): right = j; break\n        axes = {ind: a for a, ind in enumerate(inds)}\n        # build in (left, phys, right) order with dummy size-1 legs\n        parts = []\n        if left is not None:\n            parts.append(data.take(axes[inds[left]], axis=axes[inds[left]]))  # placeholder\n        break\n    # simpler: permute then expand dims\n    out2 = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        ax = {ind: a for a, ind in enumerate(inds)}\n        phys_name = f\\\"k{i}\\\" if f\\\"k{i}\\\" in ax else None\n        if phys_name is None:\n            others = set(ts[i-1].inds) if i > 0 else set()\n            if i < n-1: others |= set(ts[i+1].inds)\n            phys_name = [ind for ind in inds if ind not in others][0]\n        left_name = [ind for ind in ts[i-1].inds if ind in ax] if i > 0 else None\n        right_name = [ind for ind in ts[i+1].inds if ind in ax] if i < n-1 else None\n        perm = []\n        if left_name:\n            perm.append(ax[left_name[0]])\n        perm.append(ax[phys_name])\n        if right_name:\n            perm.append(ax[right_name[0]])\n        arr = np.transpose(data, perm).astype(np.complex128)\n        if i == 0:\n            arr = arr[np.newaxis, ...]\n        if i == n-1:\n            arr = arr[..., np.newaxis]\n        out2.append(arr)\n    return out2\n\nn = 8\nh = 1.05\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi)\ndmrg.solve(verbosity=0)\nprint(\\\"DMRG energy:\\\", dmrg.energies[-1])\n\ntensors = quimb_mps_to_tensors(psi)\nfor t in tensors:\n    assert t.ndim == 3\nprint([t.shape for t in tensors])\n\n# canonicalize once at position 0 using TC's own machinery\nc0 = tc.MPSCircuit(n, tensors=tensors)   # canonicalize=True center 0\ninit_tensors = [jnp.asarray(t) for t in c0.get_tensors()]\nc0.check  # noqa\nprint(\\\"canonicalized shapes:\\\", [tuple(t.shape) for t in init_tensors])\n\nn_layers = 2\nXX = jnp.kron(jnp.array([[0,1],[1,0]]), jnp.array([[0,1],[1,0]]))\nYY = jnp.kron(jnp.array([[0,-1j],[1j,0]]), jnp.array([[0,-1j],[1j,0]]))\nZZ = jnp.kron(jnp.array([[1,0],[0,-1]]), jnp.array([[1,0],[0,-1]]))\n\ndef energy(params):\n    c = tc.MPSCircuit(n, center_position=0, tensors=init_tensors)\n    off = 0\n    for layer in range(n_layers):\n        p = params[off:off+3*n].reshape(n, 3)\n        off += 3*n\n        for i in range(n):\n            c.rz(i, p[i,0]); c.ry(i, p[i,1]); c.rz(i, p[i,2])\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i % 2 == parity]\n        q = params[off:off+3*len(bonds)].reshape(len(bonds), 3)\n        off += 3*len(bonds)\n        for k, b in enumerate(bonds):\n            thx, thy, thz = q[k]\n            g = tc.gates.exp_gate(thx*XX + thy*YY + thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, b, b+1)\n    e = 0.0\n    for i in range(n-1):\n        e = e - c.expectation_ps(z=[i, i+1])\n    for i in range(n):\n        e = e - h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\n\nrng = np.random.default_rng(42)\ntotal = sum(3*n + 3*len([i for i in range(n-1) if i%2==layer%2]) for layer in range(n_layers))\nparams0 = rng.normal(0, 0.05, total)\ne0 = energy(jnp.asarray(params0))\nprint(\\\"e0:\\\", e0)\n\n# grad check: finite difference on a couple entries vs autodiff\neg = jax.grad(energy)(jnp.asarray(params0))\neps = 1e-6\nfor idx in [0, 1, 40, total-1]:\n    p2 = params0.copy()\n    p2[idx] += eps\n    fd = (float(energy(jnp.asarray(p2))) - float(e0)) / eps\n    print(idx, \\\"ad:\\\", float(eg[idx]), \\\"fd:\\\", fd, \\\"diff:\\\", abs(float(eg[idx])-fd))\nEOF\npython /tmp/proto/proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
