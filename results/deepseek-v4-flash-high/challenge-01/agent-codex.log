{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto4.py <<'EOF'\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\ndef quimb_mps_to_tensors(mps):\n    ts = mps.tensors\n    n = len(ts)\n    out = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        ax = {ind: a for a, ind in enumerate(inds)}\n        phys_name = f\\\"k{i}\\\" if f\\\"k{i}\\\" in ax else None\n        if phys_name is None:\n            others = set(ts[i-1].inds) if i > 0 else set()\n            if i < n-1: others |= set(ts[i+1].inds)\n            phys_name = [ind for ind in inds if ind not in others][0]\n        left_name = [ind for ind in ts[i-1].inds if ind in ax] if i > 0 else None\n        right_name = [ind for ind in ts[i+1].inds if ind in ax] if i < n-1 else None\n        perm = []\n        if left_name: perm.append(ax[left_name[0]])\n        perm.append(ax[phys_name])\n        if right_name: perm.append(ax[right_name[0]])\n        arr = np.transpose(data, perm).astype(np.complex128)\n        if i == 0: arr = arr[np.newaxis, ...]\n        if i == n-1: arr = arr[..., np.newaxis]\n        out.append(arr)\n    return out\n\nn = 8\nh = 1.05\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi0 = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi0)\ndmrg.solve(verbosity=0)\npsi = dmrg.state\nprint(\\\"DMRG energy:\\\", dmrg.energy)\n\ntensors = quimb_mps_to_tensors(psi)\nc0 = tc.MPSCircuit(n, tensors=tensors)   # canonicalize=True center 0\ninit_tensors = [jnp.asarray(t) for t in c0.get_tensors()]\nprint(\\\"shapes:\\\", [tuple(t.shape) for t in init_tensors])\n\nn_layers = 2\nXX = jnp.kron(jnp.array([[0,1],[1,0]]), jnp.array([[0,1],[1,0]]))\nYY = jnp.kron(jnp.array([[0,-1j],[1j,0]]), jnp.array([[0,-1j],[1j,0]]))\nZZ = jnp.kron(jnp.array([[1,0],[0,-1]]), jnp.array([[1,0],[0,-1]]))\n\ndef energy(params):\n    c = tc.MPSCircuit(n, center_position=0, tensors=init_tensors)\n    off = 0\n    for layer in range(n_layers):\n        p = params[off:off+3*n].reshape(n, 3)\n        off += 3*n\n        for i in range(n):\n            c.rz(i, p[i,0]); c.ry(i, p[i,1]); c.rz(i, p[i,2])\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i % 2 == parity]\n        q = params[off:off+3*len(bonds)].reshape(len(bonds), 3)\n        off += 3*len(bonds)\n        for k, b in enumerate(bonds):\n            thx, thy, thz = q[k]\n            g = tc.gates.exp_gate(thx*XX + thy*YY + thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, b, b+1)\n    e = 0.0\n    for i in range(n-1):\n        e = e - c.expectation_ps(z=[i, i+1])\n    for i in range(n):\n        e = e - h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\n\ntotal = sum(3*n + 3*len([i for i in range(n-1) if i%2==layer%2]) for layer in range(n_layers))\nprint(\\\"total params:\\\", total)\n\n# identity params: energy should equal DMRG energy\nparams0 = np.zeros(total)\ne0 = float(energy(jnp.asarray(params0)))\nprint(\\\"e0(identity):\\\", e0, \\\" dmrg:\\\", float(dmrg.energy), \\\" diff:\\\", abs(e0-float(dmrg.energy)))\n\nrng = np.random.default_rng(42)\nparams1 = rng.normal(0, 0.05, total)\ne1 = float(energy(jnp.asarray(params1)))\nprint(\\\"e1(small rand):\\\", e1)\n\neg = jax.grad(energy)(jnp.asarray(params1))\neps = 1e-6\nfor idx in [0, 1, 40, total-1]:\n    p2 = params1.copy(); p2[idx] += eps\n    fd = (float(energy(jnp.asarray(p2))) - e1) / eps\n    print(idx, \\\"ad:\\\", float(eg[idx]), \\\"fd:\\\", fd, \\\"diff:\\\", abs(float(eg[idx])-fd))\nEOF\npython /tmp/proto/proto4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
