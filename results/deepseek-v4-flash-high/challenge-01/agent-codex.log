{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto5.py <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nn = 8\nh = 1.05\nn_layers = 2\nrng = np.random.default_rng(7)\nparams = rng.normal(0, 0.4, 100).tolist()\n\nXX = np.kron(np.array([[0,1],[1,0]]), np.array([[0,1],[1,0]]))\nYY = np.kron(np.array([[0,-1j],[1j,0]]), np.array([[0,-1j],[1j,0]]))\nZZ = np.kron(np.array([[1,0],[0,-1]]), np.array([[1,0],[0,-1]]))\n\n# dense circuit reference\nc = tc.Circuit(n)\noff = 0\nfor layer in range(n_layers):\n    for i in range(n):\n        c.rz(i, theta=params[off]); c.ry(i, theta=params[off+1]); c.rz(i, theta=params[off+2])\n        off += 3\n    parity = layer % 2\n    bonds = [i for i in range(n-1) if i % 2 == parity]\n    for b in bonds:\n        thx, thy, thz = params[off], params[off+1], params[off+2]\n        off += 3\n        U = np.reshape(np.linalg.expm(-1j*(thx*XX+thy*YY+thz*ZZ)), (2,2,2,2))\n        c.apply_general_gate(tc.gates.Gate(U), b, b+1)\nE = 0\nfor i in range(n-1):\n    E -= c.expectation_ps(z=[i, i+1])\nfor i in range(n):\n    E -= h*c.expectation_ps(x=[i])\nprint(\\\"dense E:\\\", float(np.real(E)))\n\n# MPSCircuit with same params, all-zero state (no MPS input)\ninit = [jnp.array(np.array([[1.0],[0.0]]).reshape(1,2,1), dtype=jnp.complex128) for _ in range(n)]\ndef energy(params_arr):\n    c = tc.MPSCircuit(n, center_position=0, tensors=init)\n    off = 0\n    for layer in range(n_layers):\n        p = params_arr[off:off+3*n].reshape(n,3)\n        off += 3*n\n        for i in range(n):\n            c.rz(i, theta=p[i,0]); c.ry(i, theta=p[i,1]); c.rz(i, theta=p[i,2])\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i % 2 == parity]\n        q = params_arr[off:off+3*len(bonds)].reshape(len(bonds),3)\n        off += 3*len(bonds)\n        for k, b in enumerate(bonds):\n            thx, thy, thz = q[k]\n            g = tc.gates.exp_gate(thx*XX + thy*YY + thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, b, b+1)\n    e = 0.0\n    for i in range(n-1):\n        e -= c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e -= h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\n\ne_mps = float(energy(jnp.asarray(params)))\nprint(\\\"mps E:\\\", e_mps, \\\" diff:\\\", abs(e_mps - float(np.real(E))))\nEOF\npython /tmp/proto/proto5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
