{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto6.py <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nn = 8\nh = 1.05\n\n# Build TFIM MPO: H = -sum Z_i Z_{i+1} - h sum X_i, bond dim 3\n# legs: (left, out, in, right)\nI = np.eye(2, dtype=np.complex128)\nX = np.array([[0,1],[1,0]], dtype=np.complex128)\nZ = np.array([[1,0],[0,-1]], dtype=np.complex128)\nmpo = []\nfor i in range(n):\n    W = np.zeros((3,2,2,3), dtype=np.complex128)\n    if i == 0:\n        W[0, :, :, 0] = I          # 0->0 identity\n        W[0, :, :, 1] = -Z         # start ZZ: apply -Z, carry\n        W[0, :, :, 2] = -h*X       # local X term -> end\n    elif i == n-1:\n        W[0, :, :, 2] = -h*X       # local X term\n        W[1, :, :, 2] = Z          # close ZZ\n        W[2, :, :, 2] = I          # continue\n    else:\n        W[0, :, :, 0] = I\n        W[0, :, :, 1] = -Z\n        W[0, :, :, 2] = -h*X\n        W[1, :, :, 2] = Z\n        W[2, :, :, 2] = I\n    mpo.append(jnp.asarray(W))\n\n# all-zero MPS\ninit = [jnp.array(np.array([[[1.0],[0.0]]], dtype=np.complex128).reshape(1,2,1)) for _ in range(n)]\n\ndef energy_mpo(tensors, split=None):\n    c = tc.MPSCircuit(n, center_position=0, tensors=tensors)\n    c.apply_MPO(mpo, 0, center_left=False, split=split)\n    # energy = <psi|H|psi>; bra = original state\n    bra = tc.MPSCircuit(n, center_position=0, tensors=tensors)\n    val = c.proj_with_mps(bra)\n    return tc.backend.real(val)\n\ne = energy_mpo(init)\nprint(\\\"MPO energy of |0>:\\\", e)   # expect -h*n = -8.4 for all-zero state? <0|H|0> = -h*sum <X>=0 -> 0? Actually <0|X|0>=0 so E=0\n# compute expectation: H|0> then <0|H|0> = 0 (no ZZ, no X). \nprint(\\\"expected: 0\\\")\n\n# dense reference: TC Circuit all-zero with same H\nc = tc.Circuit(n)\nEd = 0\nfor i in range(n-1):\n    Ed -= c.expectation_ps(z=[i,i+1])\nfor i in range(n):\n    Ed -= h*c.expectation_ps(x=[i])\nprint(\\\"dense E of |0>:\\\", float(np.real(Ed)))\n\n# random MPS input test via dense\nrng = np.random.default_rng(3)\nvec = rng.normal(size=2**n) + 1j*rng.normal(size=2**n)\nvec = vec/np.linalg.norm(vec)\n# TC dense circuit from state\ncd = tc.Circuit(n, inputs=vec)\nEd2 = 0\nfor i in range(n-1):\n    Ed2 -= cd.expectation_ps(z=[i,i+1])\nfor i in range(n):\n    Ed2 -= h*cd.expectation_ps(x=[i])\nprint(\\\"dense random E:\\\", float(np.real(Ed2)))\n\n# split vec into MPS via TC\nmps_tensors = tc.MPSCircuit(n, wavefunction=jnp.asarray(vec.reshape([2]*n)), split={\\\"max_singular_values\\\": 16}).get_tensors()\ne2 = energy_mpo([jnp.asarray(t) for t in mps_tensors])\nprint(\\\"mps random E:\\\", float(e2), \\\"diff:\\\", abs(float(e2)-float(np.real(Ed2))))\nEOF\npython /tmp/proto/proto6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
