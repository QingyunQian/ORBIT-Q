{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto10.py <<'EOF'\nimport time\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import quantum as qu\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nn = 8\nh = 1.05\n\ndef mps_quvector(tensors):\n    # tensors: list of (left, phys, right) jnp arrays\n    import tensornetwork as tn\n    nodes = [tn.Node(t, backend=tc.backend.name) for t in tensors]\n    for i in range(len(nodes)-1):\n        nodes[i][2] \"'^ nodes[i+1][0]\n    return qu.quantum_constructor([nd[1] for nd in nodes], [])\n\ndef mpo_quoperator(Ws):\n    import tensornetwork as tn\n    nodes = [tn.Node(w, backend=tc.backend.name) for w in Ws]\n    for i in range(len(nodes)-1):\n        nodes[i][3] ''^ nodes[i+1][0]\n    out = [nd[1] for nd in nodes]\n    inn = [nd[2] for nd in nodes]\n    return qu.quantum_constructor(out, inn)\n\ndef rz_mat(th):\n    return jnp.array([[jnp.exp(-0.5j*th), 0],[0, jnp.exp(0.5j*th)]])\ndef ry_mat(th):\n    c = jnp.cos(th/2); s = jnp.sin(th/2)\n    return jnp.array([[c, -s],[s, c]])\n\nXX = jnp.kron(jnp.array([[0,1],[1,0]]), jnp.array([[0,1],[1,0]]))\nYY = jnp.kron(jnp.array([[0,-1j],[1j,0]]), jnp.array([[0,-1j],[1j,0]]))\nZZ = jnp.kron(jnp.array([[1,0],[0,-1]]), jnp.array([[1,0],[0,-1]]))\n\n# random MPS input (n=8) via TC\nrng = np.random.default_rng(5)\nvec = rng.normal(size=2**n) + 1j*rng.normal(size=2**n)\nvec = vec/np.linalg.norm(vec)\nmps_c = tc.MPSCircuit(n, wavefunction=jnp.asarray(vec.reshape([2]*n), dtype=jnp.complex64), split={\"max_singular_values\": 16})\ntensors = [jnp.asarray(t) for t in mps_c.get_tensors()]\n\n# H MPO tensors (same convention as before)\nI2 = np.eye(2, dtype=np.complex64); X2 = np.array([[0,1],[1,0]],dtype=np.complex64); Z2 = np.array([[1,0],[0,-1]],dtype=np.complex64)\nWs = []\nfor i in range(n):\n    W = np.zeros((3,2,2,3), dtype=np.complex64)\n    if i == 0:\n        W[0,:,:,0]=I2; W[0,:,:,1]=-Z2; W[0,:,:,2]=-h*X2\n    elif i == n-1:\n        W[0,:,:,2]=-h*X2; W[1,:,:,2]=Z2; W[2,:,:,2]=I2\n    else:\n        W[0,:,:,0]=I2; W[0,:,:,1]=-Z2; W[0,:,:,2]=-h*X2\n        W[1,:,:,2]=Z2; W[2,:,:,2]=I2\n    Ws.append(jnp.asarray(W))\n\nket0 = mps_quvector(tensors)\nbra0 = ket0.adjoint()\nHq = mpo_quoperator(Ws)\n\nn_layers = 2\ndef energy(params):\n    U = None\n    off = 0\n    for layer in range(n_layers):\n        gates = []\n        for i in range(n):\n            gates.append(qu.QuOperator.from_tensor(rz_mat(params[off]), out_axes=[0], in_axes=[1]))\n            gates.append(qu.QuOperator.from_tensor(ry_mat(params[off+1]), out_axes=[0], in_axes=[1]))\n            gates.append(qu.QuOperator.from_tensor(rz_mat(params[off+2]), out_axes=[0], in_axes=[1]))\n            off += 3\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i%2 == parity]\n        for b in bonds:\n            thx, thy, thz = params[off], params[off+1], params[off+2]\n            off += 3\n            G = jnp.reshape(jax.scipy.linalg.expm(-1j*(thx*XX+thy*YY+thz*ZZ)), (2,2,2,2))\n            gates.append(qu.QuOperator.from_tensor(G, out_axes=[0,1], in_axes=[2,3]))\n        # compose into layer operator: tensor product of gates then apply via chained @\n        # simpler: apply each gate one by one to ket and to H\n    # fallback: apply gates sequentially on the operator U via chained composition\n    # build U by composing all gates in order (g1 @ g2 @ ... ) acting left-to-right on ket\n    # We'\"'ll just do full @ composition below in energy2.\n    raise NotImplementedError\n\n# approach: sequential application to ket and conjugated application to bra side\ndef energy2(params):\n    ket = ket0\n    off = 0\n    for layer in range(n_layers):\n        for i in range(n):\n            ket = qu.QuOperator.from_tensor(rz_mat(params[off]), out_axes=[0], in_axes=[1]) @ ket\n            ket = qu.QuOperator.from_tensor(ry_mat(params[off+1]), out_axes=[0], in_axes=[1]) @ ket\n            ket = qu.QuOperator.from_tensor(rz_mat(params[off+2]), out_axes=[0], in_axes=[1]) @ ket\n            off += 3\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i%2 == parity]\n        for b in bonds:\n            thx, thy, thz = params[off], params[off+1], params[off+2]\n            off += 3\n            G = jnp.reshape(jax.scipy.linalg.expm(-1j*(thx*XX+thy*YY+thz*ZZ)), (2,2,2,2))\n            g = qu.QuOperator.from_tensor(G, out_axes=[0,1], in_axes=[2,3])\n            ket = g @ ket\n    Hket = Hq @ ket\n    return tc.backend.real((bra0 @ Hket).eval())\n\ntotal = sum(3*n + 3*len([i for i in range(n-1) if i%2==layer%2]) for layer in range(n_layers))\nparams = rng.normal(0, 0.2, total)\ne = energy2(jnp.asarray(params))\nprint(\\\"qop energy:\\\", float(e))\n\n# reference: MPSCircuit with same params and same input state\ninit2 = [jnp.asarray(t) for t in mps_c.get_tensors()]\ndef energy_ref(params):\n    c = tc.MPSCircuit(n, center_position=0, tensors=init2)\n    off = 0\n    for layer in range(n_layers):\n        for i in range(n):\n            c.rz(i, theta=params[off]); c.ry(i, theta=params[off+1]); c.rz(i, theta=params[off+2])\n            off += 3\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i%2 == parity]\n        for b in bonds:\n            thx, thy, thz = params[off], params[off+1], params[off+2]\n            off += 3\n            g = tc.gates.exp_gate(thx*XX+thy*YY+thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, b, b+1)\n    e = 0.0\n    for i in range(n-1):\n        e -= c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e -= h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\ner = float(energy_ref(jnp.asarray(params)))\nprint(\\\"mps energy:\\\", er, \\\" diff:\\\", abs(float(e)-er))\n\n# grad check\ng_ad = jax.grad(energy2)(jnp.asarray(params))\neps = 1e-5\nfor idx in [0, 5, total-1]:\n    p2 = params.copy(); p2[idx]+=eps\n    fd = (float(energy2(jnp.asarray(p2))) - float(e))/eps\n    print(idx, \\\"ad:\\\", float(g_ad[idx]), \\\"fd:\\\", fd)\nEOF\npython -u /tmp/proto/proto10.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
