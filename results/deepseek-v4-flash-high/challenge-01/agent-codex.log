{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto7.py <<'EOF'\nimport time\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\nn = 32\nh = 1.05\nn_layers = 4\n\ndef quimb_mps_to_tensors(mps):\n    ts = mps.tensors\n    nn = len(ts)\n    out = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        ax = {ind: a for a, ind in enumerate(inds)}\n        phys_name = f\\\"k{i}\\\" if f\\\"k{i}\\\" in ax else None\n        if phys_name is None:\n            others = set(ts[i-1].inds) if i > 0 else set()\n            if i < nn-1: others |= set(ts[i+1].inds)\n            phys_name = [ind for ind in inds if ind not in others][0]\n        left_name = [ind for ind in ts[i-1].inds if ind in ax] if i > 0 else None\n        right_name = [ind for ind in ts[i+1].inds if ind in ax] if i < nn-1 else None\n        perm = []\n        if left_name: perm.append(ax[left_name[0]])\n        perm.append(ax[phys_name])\n        if right_name: perm.append(ax[right_name[0]])\n        arr = np.transpose(data, perm).astype(np.complex128)\n        if i == 0: arr = arr[np.newaxis, ...]\n        if i == nn-1: arr = arr[..., np.newaxis]\n        out.append(arr)\n    return out\n\n# DMRG n=32 chi=8\nHq = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi0 = qtn.MPS_computational_state(\\\"0\\\"*n)\nt0 = time.time()\ndmrg = qtn.DMRG2(Hq, bond_dims=[8], which=\\\"SA\\\", p0=psi0)\ndmrg.solve(verbosity=0)\npsi = dmrg.state\nprint(\\\"DMRG time:\\\", time.time()-t0, \\\"energy:\\\", dmrg.energy, \\\"maxbond:\\\", psi.max_bond())\n\ntensors = quimb_mps_to_tensors(psi)\nc0 = tc.MPSCircuit(n, tensors=tensors)\ninit_tensors = [jnp.asarray(t) for t in c0.get_tensors()]\nprint(\\\"max init bond:\\\", max(t.shape[0]*t.shape[2] for t in init_tensors), [tuple(t.shape) for t in init_tensors[:4]])\n\nXX = jnp.kron(jnp.array([[0,1],[1,0]]), jnp.array([[0,1],[1,0]]))\nYY = jnp.kron(jnp.array([[0,-1j],[1j,0]]), jnp.array([[0,-1j],[1j,0]]))\nZZ = jnp.kron(jnp.array([[1,0],[0,-1]]), jnp.array([[1,0],[0,-1]]))\n\nI2 = np.eye(2, dtype=np.complex128)\nX2 = np.array([[0,1],[1,0]], dtype=np.complex128)\nZ2 = np.array([[1,0],[0,-1]], dtype=np.complex128)\nmpo = []\nfor i in range(n):\n    W = np.zeros((3,2,2,3), dtype=np.complex128)\n    if i == 0:\n        W[0,:,:,0] = I2; W[0,:,:,1] = -Z2; W[0,:,:,2] = -h*X2\n    elif i == n-1:\n        W[0,:,:,2] = -h*X2; W[1,:,:,2] = Z2; W[2,:,:,2] = I2\n    else:\n        W[0,:,:,0] = I2; W[0,:,:,1] = -Z2; W[0,:,:,2] = -h*X2\n        W[1,:,:,2] = Z2; W[2,:,:,2] = I2\n    mpo.append(jnp.asarray(W))\n\ndef build(params, use_mpo):\n    c = tc.MPSCircuit(n, center_position=0, tensors=init_tensors)\n    off = 0\n    for layer in range(n_layers):\n        p = params[off:off+3*n].reshape(n,3)\n        off += 3*n\n        for i in range(n):\n            c.rz(i, theta=p[i,0]); c.ry(i, theta=p[i,1]); c.rz(i, theta=p[i,2])\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i % 2 == parity]\n        q = params[off:off+3*len(bonds)].reshape(len(bonds),3)\n        off += 3*len(bonds)\n        for k, b in enumerate(bonds):\n            thx, thy, thz = q[k]\n            g = tc.gates.exp_gate(thx*XX + thy*YY + thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, b, b+1)\n    return c\n\ndef energy_mpo(params):\n    c = build(params, True)\n    c.apply_MPO(mpo, 0, center_left=False)\n    bra = tc.MPSCircuit(n, center_position=0, tensors=init_tensors)\n    return tc.backend.real(c.proj_with_mps(bra))\n\ndef energy_ps(params):\n    c = build(params, False)\n    e = 0.0\n    for i in range(n-1):\n        e -= c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e -= h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\n\ntotal = sum(3*n + 3*len([i for i in range(n-1) if i%2==layer%2]) for layer in range(n_layers))\nprint(\\\"total params:\\\", total)\nparams0 = np.zeros(total)\n\nfor name, fn in [(\\\"mpo\\\", energy_mpo), (\\\"ps\\\", energy_ps)]:\n    t0 = time.time()\n    e0 = float(fn(jnp.asarray(params0)))\n    t_eager = time.time()-t0\n    print(f\\\"[{name}] eager energy:\\\", e0, \\\"time:\\\", round(t_eager,2), \\\"s\\\")\n\n# jit compile + run for both\nfor name, fn in [(\\\"mpo\\\", energy_mpo), (\\\"ps\\\", energy_ps)]:\n    eg = jax.jit(jax.value_and_grad(fn))\n    t0 = time.time()\n    e, g = eg(jnp.asarray(params0))\n    t_first = time.time()-t0\n    t0 = time.time()\n    e2, g2 = eg(jnp.asarray(params0))\n    t_second = time.time()-t0\n    print(f\\\"[{name}] jit first call (incl compile): {t_first:.2f}s, second call: {t_second:.4f}s, E={float(e):.8f}\\\")\n    eg(np.zeros(total))  # keep alive\nEOF\npython /tmp/proto/proto7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
