psi = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi)\nen = dmrg.solve(verbosity=0)\nprint(\\\"DMRG energy:\\\", en)\n\ntensors = quimb_mps_to_tensors(psi)\nfor t in tensors[:3]:\n    print(t.shape)\n\n# exact diagonalization reference\nX = qu.pauli(\\\"X\\\"); Z = qu.pauli(\\\"Z\\\"); I2 = qu.eye(2)\ndef kron_all(ops):\n    out = np.array(1.0+0j)\n    for o in ops:\n        out = np.kron(out, o)\n    return out\nHm = np.zeros((2**n,2**n), dtype=complex)\nfor i in range(n-1):\n    ops = [I2]*n; ops[i]=Z; ops[i+1]=Z\n    Hm -= kron_all(ops)\nfor i in range(n):\n    ops = [I2]*n; ops[i]=X\n    Hm -= h*kron_all(ops)\nevals, evecs = np.linalg.eigh(Hm)\nprint(\\\"exact gs energy:\\\", evals[0])\nEOF\npython /tmp/proto/proto1.py\"","aggregated_output":"DMRG energy: True\n(2, 1)\n(2, 1, 1)\n(2, 1, 1)\nexact gs energy: -10.14241091025915\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto/proto2.py <<'EOF'\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend(\\\"jax\\\")\n\ndef quimb_mps_to_tensors(mps):\n    ts = mps.tensors\n    n = len(ts)\n    out = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        phys = None\n        for j, ind in enumerate(inds):\n            if ind == f\\\"k{i}\\\":\n                phys = j; break\n        if phys is None:\n            others = set()\n            if i > 0: others |= set(ts[i-1].inds)\n            if i < n-1: others |= set(ts[i+1].inds)\n            for j, ind in enumerate(inds):\n                if ind not in others:\n                    phys = j; break\n        left = right = None\n        if i > 0:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i-1].inds): left = j; break\n        if i < n-1:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i+1].inds): right = j; break\n        perm = [p for p in (phys, left, right) if p is not None]\n        perm += [a for a in range(data.ndim) if a not in perm]\n        out.append(np.transpose(data, perm).astype(np.complex128))\n    return out\n\nn = 8\nh = 1.05\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi)\ndmrg.solve(verbosity=0)\nen_dmrg = dmrg.energies[-1]\nprint(\\\"DMRG energy:\\\", en_dmrg)\n\ninit_tensors = quimb_mps_to_tensors(psi)\ninit_tensors = [jnp.asarray(t) for t in init_tensors]\n\n# Build parameter structure for n_layers\nn_layers = 2\n# per layer: 3n singles + 3 * nbonds\nslices = []\ntotal = 0\nfor layer in range(n_layers):\n    parity = layer % 2\n    bonds = [i for i in range(n-1) if i % 2 == parity]\n    slices.append((3*n, 3*len(bonds)))\n    total += 3*n + 3*len(bonds)\nprint(\\\"total params:\\\", total)\n\nXX = jnp.kron(jnp.array([[0,1],[1,0]]), jnp.array([[0,1],[1,0]]))\nYY = jnp.kron(jnp.array([[0,-1j],[1j,0]]), jnp.array([[0,-1j],[1j,0]]))\nZZ = jnp.kron(jnp.array([[1,0],[0,-1]]), jnp.array([[1,0],[0,-1]]))\n\ndef energy(params):\n    c = tc.MPSCircuit(n, tensors=init_tensors)\n    off = 0\n    for layer in range(n_layers):\n        p = params[off:off+3*n].reshape(n, 3)\n        off += 3*n\n        for i in range(n):\n            c.rz(i, p[i,0]); c.ry(i, p[i,1]); c.rz(i, p[i,2])\n        parity = layer % 2\n        bonds = [i for i in range(n-1) if i % 2 == parity]\n        q = params[off:off+3*len(bonds)].reshape(len(bonds), 3)\n        off += 3*len(bonds)\n        for k, (i, jj) in enumerate([(b, b+1) for b in bonds]):\n            thx, thy, thz = q[k]\n            g = tc.gates.exp_gate(thx*XX + thy*YY + thz*ZZ, 1.0, name=\\\"pq\\\")\n            c.apply(g, i, jj)\n    e = 0.0\n    for i in range(n-1):\n        e = e - c.expectation_ps(z=[i, i+1])\n    for i in range(n):\n        e = e - h*c.expectation_ps(x=[i])\n    return tc.backend.real(e)\n\n# test with zeros: should equal DMRG energy of initial state (identity circuit)\nrng = np.random.default_rng(42)\nparams0 = rng.normal(0, 0.05, total)\ne0 = energy(jnp.asarray(params0))\nprint(\\\"e0:\\\", e0)\nEOF\npython /tmp/proto/proto2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
