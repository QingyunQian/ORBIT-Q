{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /tmp/proto && cat > /tmp/proto/proto1.py <<'EOF'\nimport numpy as np\nimport quimb as qu\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\n\ndef quimb_mps_to_tensors(mps):\n    ts = mps.tensors\n    n = len(ts)\n    out = []\n    for i, t in enumerate(ts):\n        inds = list(t.inds)\n        data = np.asarray(t.data)\n        # physical index: prefer k{i}, else an index not shared with neighbors\n        phys = None\n        for j, ind in enumerate(inds):\n            if ind == f\\\"k{i}\\\":\n                phys = j\n                break\n        if phys is None:\n            others = set()\n            if i > 0:\n                others |= set(ts[i-1].inds)\n            if i < n-1:\n                others |= set(ts[i+1].inds)\n            for j, ind in enumerate(inds):\n                if ind not in others:\n                    phys = j\n                    break\n        assert phys is not None\n        left = None\n        right = None\n        if i > 0:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i-1].inds):\n                    left = j\n                    break\n        if i < n-1:\n            for j, ind in enumerate(inds):\n                if ind in set(ts[i+1].inds):\n                    right = j\n                    break\n        axes = [a for a in range(data.ndim) if a not in (phys, left, right)] if False else None\n        # build perm: phys, left, right\n        perm = []\n        if phys is not None: perm.append(phys)\n        if left is not None: perm.append(left)\n        if right is not None: perm.append(right)\n        perm += [a for a in range(data.ndim) if a not in perm]\n        arr = np.transpose(data, perm).astype(np.complex128)\n        out.append(arr)\n    return out\n\n# Build TFIM DMRG for n=8\nn = 8\nh = 1.05\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*h)\npsi = qtn.MPS_computational_state(\\\"0\\\"*n)\ndmrg = qtn.DMRG2(H, bond_dims=[8], which=\\\"SA\\\", p0=psi)\nen = dmrg.solve(verbosity=0)\nprint(\\\"DMRG energy:\\\", en)\n\ntensors = quimb_mps_to_tensors(psi)\nfor t in tensors[:3]:\n    print(t.shape)\n\n# exact diagonalization reference\nX = qu.pauli(\\\"X\\\"); Z = qu.pauli(\\\"Z\\\"); I2 = qu.eye(2)\ndef kron_all(ops):\n    out = np.array(1.0+0j)\n    for o in ops:\n        out = np.kron(out, o)\n    return out\nHm = np.zeros((2**n,2**n), dtype=complex)\nfor i in range(n-1):\n    ops = [I2]*n; ops[i]=Z; ops[i+1]=Z\n    Hm -= kron_all(ops)\nfor i in range(n):\n    ops = [I2]*n; ops[i]=X\n    Hm -= h*kron_all(ops)\nevals, evecs = np.linalg.eigh(Hm)\nprint(\\\"exact gs energy:\\\", evals[0])\nEOF\npython /tmp/proto/proto1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
