 print('res',r,'call',time.time()-t0,flush=True)\nprint('compile vg...',flush=True)\nvg=jax.jit(jax.value_and_grad(lambda a,b:f(a,b)[0] if False else f(a,b), argnums=(0,1), has_aux=True))\n# Actually value_and_grad of f with has_aux returns ((loss,aux), grads)\nt0=time.time(); r=vg(th,rx); print('vg compile+call',time.time()-t0,r[0][0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
