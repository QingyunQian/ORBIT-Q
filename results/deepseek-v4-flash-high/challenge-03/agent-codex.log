{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, scipy.sparse as sp\nfrom scipy.sparse.linalg import eigsh\nn=12; h=0.9; dim=2**n\nidx=np.arange(dim,dtype=np.int64)\n# ZZ terms\nrows=[]; cols=[]; vals=[]\nfor i in range(n-1):\n    zsign=np.where((idx>>i)&1,-1.0,1.0)*np.where((idx>>(i+1))&1,-1.0,1.0)\n    d=np.arange(dim)\n    rows.extend(d.tolist()); cols.extend(d.tolist()); vals.extend((-zsign).tolist())\nfor i in range(n):\n    off=idx \"'^ (1<<i)\n    rows.extend(idx.tolist()); cols.extend(off.tolist()); vals.extend([-h]*dim)\nH=sp.coo_matrix((vals,(rows,cols)),shape=(dim,dim)).tocsr()\ne=eigsh(H,k=1,which='\"'SA',return_eigenvectors=False)[0]\nprint('gs density',e/n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
