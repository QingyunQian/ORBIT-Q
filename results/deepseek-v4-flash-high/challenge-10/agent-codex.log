{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nI=np.eye(2); Z=np.diag([1.,-1.]); X=np.array([[0.,1.],[1.,0.]])\ndef make(N):\n chi=3; Ws=[]\n W=np.zeros((1,2,2,chi),dtype=complex); W[0,:,:,0]=I; W[0,:,:,1]=Z; W[0,:,:,2]=X; Ws.append(W)\n for _ in range(N-2):\n  W=np.zeros((chi,2,2,chi),dtype=complex); W[0,:,:,0]=I; W[0,:,:,1]=Z; W[0,:,:,2]=X; W[1,:,:,2]=Z; W[2,:,:,2]=I; Ws.append(W)\n W=np.zeros((chi,2,2,1),dtype=complex); W[0,:,:,0]=X; W[1,:,:,0]=Z; W[2,:,:,0]=I; Ws.append(W)\n T=Ws[0]\n for W in Ws[1:]: T=np.einsum('...a,abcd->...bcd', T, W)\n return T[0,...,0]\nfor N in [2,3,4]:\n T=make(N)\n # T shape p1,p1*,...,pN,pN*\n # permute to p1*..pN*,p1..pN\n order=[]\n for i in range(N): order.append(2*i+1)\n for i in range(N): order.append(2*i)\n M=T.transpose(order).reshape(2**N,2**N)\n H=np.zeros((2**N,2**N),dtype=complex)\n for i in range(N):\n  H += np.kron(np.eye(2**i), np.kron(X, np.eye(2**(N-i-1))))\n for i in range(N-1):\n  H += np.kron(np.kron(np.eye(2**i),Z), np.kron(Z,np.eye(2**(N-i-2))))\n print(N, np.max(np.abs(M-H)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
