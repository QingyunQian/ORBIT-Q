dtype=complex)\n    for i in range(N-1):\n        H2 += np.kron(np.kron(np.eye(2**i),Z), np.kron(Z,np.eye(2**(N-i-2))))\n    H += H2\n    # T shape (1, p..., p*..., 1) -> matrix\n    M=T[0,...,0].reshape(2**N,2**N)\n    print(N, np.max(np.abs(M-H)))\nPY'","aggregated_output":"2 2.0\n3 2.0\n4 5.0\n5 6.0\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nI=np.eye(2); Z=np.diag([1.,-1.]); X=np.array([[0.,1.],[1.,0.]])\nN=2\nchi=3\nWs=[]\nW=np.zeros((1,2,2,chi),dtype=complex); W[0,:,:,0]=I; W[0,:,:,1]=Z; W[0,:,:,2]=X; Ws.append(W)\nW=np.zeros((chi,2,2,1),dtype=complex); W[0,:,:,0]=X; W[1,:,:,0]=Z; W[2,:,:,0]=I; Ws.append(W)\nT=Ws[0]\nfor W in Ws[1:]:\n    T=np.einsum('...a,abcd->...bcd', T, W)\nM=T[0,...,0].reshape(4,4)\nH=np.zeros((4,4),dtype=complex)\nfor i in range(N):\n    H += np.kron(np.eye(2**i), np.kron(X, np.eye(2**(N-i-1))))\nfor i in range(N-1):\n    H += np.kron(np.kron(np.eye(2**i),Z), np.kron(Z,np.eye(2**(N-i-2))))\nprint('M\\\\n', np.round(M,2)); print('H\\\\n', np.round(H,2)); print(M-H)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
