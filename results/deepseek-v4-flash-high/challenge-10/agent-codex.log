{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_mpo.py <<'PY'\nimport numpy as np, tensorcircuit as tc\nimport tensornetwork as tn\ntc.set_backend('numpy')\nfrom tensorcircuit.quantum import QuOperator\nI=np.eye(2); Z=np.diag([1.,-1.]); X=np.array([[0.,1.],[1.,0.]])\ndef tfim_mpo(N):\n    chi=3\n    W=np.zeros((1,2,2,chi),dtype=np.complex64); W[0,:,:,0]=I; W[0,:,:,1]=Z; W[0,:,:,2]=X\n    nodes=[tn.Node(W,name='mpo0')]\n    for i in range(N-2):\n        W=np.zeros((chi,2,2,chi),dtype=np.complex64); W[0,:,:,0]=I; W[0,:,:,1]=Z; W[0,:,:,2]=X; W[1,:,:,2]=Z; W[2,:,:,2]=I\n        nodes.append(tn.Node(W,name=f'mpo{i+1}'))\n    W=np.zeros((chi,2,2,1),dtype=np.complex64); W[0,:,:,0]=X; W[1,:,:,0]=Z; W[2,:,:,0]=I\n    nodes.append(tn.Node(W,name=f'mpo{N-1}'))\n    for i in range(N-1): nodes[i][3]\"'^nodes[i+1][0]\n    out_edges=[n[2] for n in nodes]; in_edges=[n[1] for n in nodes]\n    return QuOperator(out_edges,in_edges,[],[nodes[0][0],nodes[-1][3]])\nN=4\nmpo=tfim_mpo(N)\n# compare eval_matrix\nM=mpo.eval_matrix()\nH=np.zeros((2**N,2**N),dtype=complex)\nfor i in range(N): H += np.kron(np.eye(2**i), np.kron(X, np.eye(2**(N-i-1))))\nfor i in range(N-1): H += np.kron(np.kron(np.eye(2**i),Z), np.kron(Z,np.eye(2**(N-i-2))))\nprint('\"'mpo matrix maxdiff', np.max(np.abs(M-H)))\n# expectation with random circuit\nrng=np.random.default_rng(1)\np=rng.normal(size=(N,3)).astype(np.float32)\nc=tc.Circuit(N)\nfor q in range(N):\n    c.rx(q, theta=p[q,0]); c.rz(q,theta=p[q,1]); c.ry(q,theta=p[q,2])\nfrom tensorcircuit.templates.measurements import mpo_expectation\ne=mpo_expectation(c,mpo)\npsi=c.wavefunction()\nref=np.conj(psi)@(H@psi)\nprint('expectation', e, ref)\nPY\npython /tmp/test_mpo.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
