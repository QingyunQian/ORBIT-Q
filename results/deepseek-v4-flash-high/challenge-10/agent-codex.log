{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, tensorcircuit as tc\n# use numpy backend for easy verify\ntc.set_backend('numpy')\nn=3\n# initial all zero? apply cmz to |111>\nbit = np.zeros(2**n, dtype=np.complex64)\nbit[0b111]=1\nc=tc.Circuit(n, inputs=bit)\nc.cmz(0,1,2)\npsi=c.wavefunction()\nprint('cmz 111 ->', np.round(psi,4))\nbit2=np.zeros(2**n, dtype=np.complex64); bit2[0b110]=1\nc2=tc.Circuit(n, inputs=bit2); c2.cmz(0,1,2)\nprint('cmz 110 ->', c2.wavefunction())\n# apply to arbitrary random state compare manual\nrng=np.random.default_rng(0)\npsi0=rng.normal(size=2**n)+1j*rng.normal(size=2**n)\nc3=tc.Circuit(n, inputs=psi0)\nc3.cmz(0,1,2)\nout=c3.wavefunction()\nref=psi0.copy(); ref[-1]*=-1\nprint('match', np.allclose(out, ref))\n# test RX RZ RY and expectation\nc4=tc.Circuit(3)\nc4.rx(0, theta=0.4)\nprint('rx expectation z', c4.expectation((tc.gates.z(),[0])))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
