{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_mps_cmz2.py <<'PY'\nimport numpy as np, tensorcircuit as tc\ntc.set_backend('numpy'); tc.set_dtype('complex64')\nI=np.eye(2)\ndef cmz_mpo(selected,n):\n sel=sorted(selected); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=np.complex64)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n return ts,l\ndef run(n,sel,center_left=True):\n psi=np.zeros(2**n,dtype=np.complex64); psi[0]=1\n for b in range(1,2**n): psi[b]=0.1+0.2j\n c=tc.Circuit(n,inputs=psi); c.cmz(*sel); ref=c.wavefunction()\n m=tc.MPSCircuit(n, wavefunction=psi)\n ts,l=cmz_mpo(sel,n)\n m.apply_MPO(ts,l,center_left=center_left,split={})\n out=m.wavefunction()\n print('n,sel,cl',n,sel,center_left,'diff',np.max(np.abs(ref-out)), 'bonds',m.get_bond_dimensions())\n for b in range(2**n):\n  if abs(ref[b]-out[b])>1e-4: print('b',b,ref[b],out[b]); break\nfor cl in [True,False]:\n run(2,[0,1],cl)\n run(3,[0,2],cl)\n run(4,[0,1,3],cl)\nPY\npython /tmp/test_mps_cmz2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
