{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nfrom scipy.sparse import lil_matrix\nfrom scipy.sparse.linalg import eigsh\nfor n in [14,16]:\n D=2**n\n H=lil_matrix((D,D),dtype=float)\n # X terms\n for i in range(n):\n  block=np.eye(D)\n  # vectorized via kron? use loops on basis maybe okay D=65536*22 huge; use csr construction via kron\n  pass\n# easier build with kron chain\nfrom scipy.sparse import kron, eye, csr_matrix\nX=csr_matrix(np.array([[0.,1.],[1.,0.]])); Z=csr_matrix(np.array([[1.,0.],[0.,-1.]])); I=csr_matrix(np.eye(2))\nfor n in [14,16,18]:\n H=csr_matrix((2**n,2**n))\n for i in range(n):\n  left=eye(2**i,format='csr')\n  right=eye(2**(n-i-1),format='csr')\n  H=H-1.05*kron(kron(left,X,format='csr'),right,format='csr')\n for i in range(n-1):\n  left=eye(2**i,format='csr'); right=eye(2**(n-i-2),format='csr')\n  H=H-kron(kron(left,Z,format='csr'),kron(Z,right,format='csr'),format='csr')\n e=eigsh(H,k=1,which='SA',tol=1e-8)[0][0]\n print(n,e/n)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
