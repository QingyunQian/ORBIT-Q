{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, tensorcircuit as tc\ntc.set_backend('numpy'); tc.set_dtype('complex64')\nones=set([0,2,4,6]); n=8\ntensors=[np.array([[[1.],[0.]]],dtype=np.complex64) if q not in ones else np.array([[[0.],[1.]]],dtype=np.complex64) for q in range(n)]\nm=tc.MPSCircuit(n,tensors=tensors[::-1],center_position=0)\nw=m.wavefunction(); print('nonzero',np.where(abs(w)>1e-6)[0])\n# apply cmz on physical sel [0,2,4,6] => stored indices n-1-q = [7,5,3,1]\nsel=[0,2,4,6]; sel_stored=[n-1-q for q in sel]\nI=np.eye(2)\ndef cmz_mpo(sel):\n sel=sorted(sel); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=np.complex64)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n return ts,l\nts,l=cmz_mpo(sel_stored); m.apply_MPO(ts,l,center_left=True,split={})\n# dense ref physical\nidx=0\nfor q in ones: idx|=1<<q\ninit=np.zeros(2**n,dtype=np.complex64); init[idx]=1\nc=tc.Circuit(n,inputs=init); c.cmz(*sel)\nprint('diff',np.max(np.abs(m.wavefunction()-c.wavefunction())), 'bonds', m.get_bond_dimensions())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
