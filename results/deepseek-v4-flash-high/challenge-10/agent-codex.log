{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nI=np.eye(2)\ndef mpo(selected,n):\n sel=sorted(selected); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=complex)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=complex); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=complex); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=complex); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n T=ts[0] # L,out,in,R\n for W in ts[1:]:\n  # connect T R (axis3) to W L(axis0)\n  T=np.tensordot(T,W,axes=([3],[0]))\n  # result axes: T L,out,in, W out,in,W R  => reorder L,outT,inT,outW,inW,R\n  T=T.transpose(0,1,2,3,4,5)\n  # merge adjacent? keep all\n return T\nfor n,sel in [(5,[0,2,4]),(4,[0,2]),(6,[1,3,5])]:\n T=mpo(sel,n)\n m=len(sel); span=sel[-1]-sel[0]+1\n # flatten out/in: row order out..., col order in...\n order=[]\n for i in range(m): order.append(2*i+1)\n for i in range(m): order.append(2*i)\n M=T.transpose(order).reshape(2**m,2**m)\n print('n,sel',n,sel,'span',span,'diag', np.round(np.diag(M),2))\n for b in range(2**m):\n  bits=[(b>>j)&1 for j in range(m)]\n  exp=-1 if all(bits)==1 else 1\n  if abs(M[b,b]-exp)>1e-6: print('bad',b, M[b,b], exp)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
