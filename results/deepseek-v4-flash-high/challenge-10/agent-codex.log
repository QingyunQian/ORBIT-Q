are\ne1=0.0\nfor i in range(n-1): e1+= -1.0*m.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\nfor i in range(n): e1+= -1.05*m.expectation((tc.gates.x(),[i]))\ne2=0.0\nfor i in range(n-1): e2+= -1.0*c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\nfor i in range(n): e2+= -1.05*c.expectation((tc.gates.x(),[i]))\nprint('energy mps',e1,'circ',e2)\nPY\npython /tmp/test_mps_vqe.py\"","aggregated_output":"wave diff 0.955605\nbonds [1, 2, 4, 8, 16, 16, 8, 4, 2, 1, 1]\nenergy mps (9.292051+1.870957e-08j) circ (7.9300203-2.4350028e-08j)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, tensorcircuit as tc\ntc.set_backend('numpy'); tc.set_dtype('complex64')\nI=np.eye(2)\nn=8; sel=[1,3,5,7]; ones=set([0,2,4,6])\ndef init_tensors(n,ones): return [np.array([[[1.],[0.]]],dtype=np.complex64) if q not in ones else np.array([[[0.],[1.]]],dtype=np.complex64) for q in range(n)]\ndef cmz_mpo(sel):\n sel=sorted(sel); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=np.complex64)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n return ts,l\nm=tc.MPSCircuit(n,tensors=init_tensors(n,ones),center_position=0)\nprint('init bonds',m.get_bond_dimensions(), m.wavefunction())\nts,l=cmz_mpo(sel); m.apply_MPO(ts,l,center_left=True,split={})\nprint('after cmz bonds',m.get_bond_dimensions(),'out',m.wavefunction())\n# dense ref\nidx=0\nfor q in ones: idx|=1<<q\ninit=np.zeros(2**n,dtype=np.complex64); init[idx]=1\nc=tc.Circuit(n,inputs=init); c.cmz(*sel)\nprint('ref',c.wavefunction(),'diff',np.max(np.abs(m.wavefunction()-c.wavefunction())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
