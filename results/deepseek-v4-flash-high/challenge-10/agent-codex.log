{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_mps_vqe2.py <<'PY'\nimport numpy as np, tensorcircuit as tc\ntc.set_backend('numpy'); tc.set_dtype('complex64')\nI=np.eye(2)\nconfig={\\\"n_qubits\\\":10,\\\"selected_qubits\\\":[0,1,2,4,5,6,8,9],\\\"initial_ones\\\":[1,3,5,7,9],\\\"n_layers\\\":2,\\\"initial_parameter_scale\\\":0.08,\\\"seed\\\":2040}\nn=config['n_qubits']; L=config['n_layers']; sel=config['selected_qubits']; ones=set(config['initial_ones'])\nrng=np.random.default_rng(2040); p=rng.normal(0,0.08,size=(L,n,3)).astype(np.float32)\ndef init_tensors(n,ones):\n return [np.array([[[1.],[0.]]],dtype=np.complex64) if q not in ones else np.array([[[0.],[1.]]],dtype=np.complex64) for q in range(n)]\ndef cmz_mpo(sel):\n sel=sorted(sel); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=np.complex64)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=np.complex64); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n return ts,l\ndef build_mps(p):\n m=tc.MPSCircuit(n, tensors=init_tensors(n,ones)[::-1], center_position=0)\n for l in range(L):\n  for q in range(n):\n   m.rx(q,theta=p[l,q,0]); m.rz(q,theta=p[l,q,1]); m.ry(q,theta=p[l,q,2])\n  ts,l0=cmz_mpo(sel)\n  m.apply_MPO(ts,l0,center_left=True,split={})\n return m\ndef build_circ(p):\n idx=0\n for q in ones: idx|=1<<q\n init=np.zeros(2**n,dtype=np.complex64); init[idx]=1\n c=tc.Circuit(n, inputs=init)\n for l in range(L):\n  for q in range(n): c.rx(q,theta=p[l,q,0]); c.rz(q,theta=p[l,q,1]); c.ry(q,theta=p[l,q,2])\n  c.cmz(*sel)\n return c\nm=build_mps(p); c=build_circ(p)\nprint('wave diff', np.max(np.abs(m.wavefunction()-c.wavefunction())))\nprint('bonds', m.get_bond_dimensions())\n# energy compare\ne1=0.0\nfor i in range(n-1): e1+= -1.0*m.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\nfor i in range(n): e1+= -1.05*m.expectation((tc.gates.x(),[i]))\ne2=0.0\nfor i in range(n-1): e2+= -1.0*c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]))\nfor i in range(n): e2+= -1.05*c.expectation((tc.gates.x(),[i]))\nprint('energy mps',e1,'circ',e2)\nPY\npython /tmp/test_mps_vqe2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
