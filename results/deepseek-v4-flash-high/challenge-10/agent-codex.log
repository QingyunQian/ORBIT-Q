     m2.rx(q,theta=th[0]); m2.rz(q,theta=th[1]); m2.ry(q,theta=th[2])\n    c2.cmz(*selected); m2.apply_MPO(tensors,l,center_left=True,split={})\n    print('rot cmz maxdiff', np.max(np.abs(c2.wavefunction()-m2.wavefunction())), 'bonds', m2.get_bond_dimensions())\n\nfor n,sel in [(5,[0,2,4]), (8,[1,3,5,7]), (10,list(range(0,10,2)))]:\n    test(n,sel)\nPY\npython /tmp/test_mps_cmz.py\"","aggregated_output":"n 5 maxdiff 2.6599011144180564 bonds [1, 2, 4, 4, 2, 1]\nrot cmz maxdiff 3.7455162166869505 bonds [1, 2, 4, 4, 2, 1]\nn 8 maxdiff 4.065170791445137 bonds [1, 2, 4, 8, 16, 8, 4, 2, 1]\nrot cmz maxdiff 3.3717284188644 bonds [1, 2, 4, 8, 16, 8, 4, 2, 1]\nn 10 maxdiff 3.9929596041807436 bonds [1, 2, 4, 8, 16, 32, 16, 8, 4, 2, 1]\nrot cmz maxdiff 4.477360217024364 bonds [1, 2, 4, 8, 16, 32, 16, 8, 4, 2, 1]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nI=np.eye(2)\ndef mpo(selected,n):\n sel=sorted(selected); l=sel[0]; r=sel[-1]; sset=set(sel); ts=[]\n for q in range(l,r+1):\n  if q not in sset:\n   W=np.zeros((2,2,2,2),dtype=complex)\n   for b in range(2): W[b,:,:,b]=I\n  elif q==l:\n   W=np.zeros((1,2,2,2),dtype=complex); W[0,:,:,0]=I; W[0,1,1,1]=-2\n  elif q==r:\n   W=np.zeros((2,2,2,1),dtype=complex); W[0,:,:,0]=I; W[1,1,1,0]=1\n  else:\n   W=np.zeros((2,2,2,2),dtype=complex); W[0,:,:,0]=I; W[1,1,1,1]=1\n  ts.append(W)\n T=ts[0]\n for W in ts[1:]:\n  T=np.einsum('ijab,abcd->ijcd', T, W) # wrong\n return T\n# proper contract with O axes (l,out,in,r), T (L,out,in,R), connect O.r to T.L\ndef contract(ts):\n T=ts[0]\n for W in ts[1:]:\n  T=np.einsum('ijab,abcd->ijcd', T, W)\n return T\nfor n,sel in [(5,[0,2,4])]:\n ts=mpo(sel,n); T=contract(ts)\n # shape out... in...\n print(T.shape)\n # transpose to out/in\n order=[]\n for i in range(len(ts)): order.append(2*i+1)\n for i in range(len(ts)): order.append(2*i)\n M=T.transpose(order).reshape(2**len(ts),2**len(ts))\n print(M.shape)\n print('diag', np.round(np.diag(M),3))\n # expected coefficient for bits on span: -1 if selected all 1 else 1\n for b in range(2**len(ts)):\n  bits=[(b>>j)&1 for j in range(len(ts))]\n  # map span positions to selected positions\n  span=list(range(sel[0],sel[-1]+1))\n  exp=-1 if all(bits[span.index(q)]==1 for q in sel) else 1\n  if abs(M[b,b]-exp)>1e-6 or np.any(M[b,:b]) or np.any(M[b,b+1:]):\n   print('bad', b, M[b,b], exp)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
