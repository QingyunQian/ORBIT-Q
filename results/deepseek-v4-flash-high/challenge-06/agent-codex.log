{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 500 python - <<'EOF'\nimport numpy as np, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport jax.numpy as jnp\n\nn = 14; nb = 4\n\ndef u2x2(a, b, g):\n    # RZ(a) RY(b) RZ(g), up to irrelevant global phase (keep exact)\n    ca = jnp.cos(a/2); sa = jnp.sin(a/2)\n    e1 = ca - 1j*sa; e2 = ca + 1j*sa\n    cb = jnp.cos(b/2); sb = jnp.sin(b/2)\n    cg = jnp.cos(g/2); sg = jnp.sin(g/2)\n    f1 = cg - 1j*sg; f2 = cg + 1j*sg\n    # RZ(a) @ RY(b) @ RZ(g)\n    # RY(b) @ RZ(g): [[cb*f1, -sb*f2],[sb*f1, cb*f2]]\n    m1 = jnp.array([[cb*f1, -sb*f2],[sb*f1, cb*f2]], jnp.complex64)\n    row0 = jnp.stack([e1*m1[0,0], e1*m1[0,1]])\n    row1 = jnp.stack([e2*m1[1,0], e2*m1[1,1]])\n    return jnp.stack([row0, row1])\n\ndef make_loss(mode):\n    def loss(params):\n        rot=params[3*nb:].reshape(nb,n,3)\n        c0=tc.Circuit(n)\n        for i in range(1,n,2): c0.x(i)\n        state=c0.state()\n        for l in range(nb):\n            c=tc.Circuit(n,inputs=state)\n            if mode == \\\"combined\\\":\n                for k in range(n):\n                    c.apply_gate(tc.gates.Gate(u2x2(rot[l,k,0],rot[l,k,1],rot[l,k,2])), k)\n            else:\n                for k in range(n):\n                    c.rz(k,theta=rot[l,k,0]); c.ry(k,theta=rot[l,k,1]); c.rz(k,theta=rot[l,k,2])\n            state=c.state()\n        return jnp.real(jnp.sum(jnp.conj(state)*state))/n\n    return loss\n\nrng = np.random.default_rng(0)\nparams = np.concatenate([np.zeros(nb), 0.1*np.ones(nb), 0.1*np.ones(nb), rng.normal(0,0.1,nb*n*3)]).astype(np.float32)\nP = jnp.array(params)\n\nfor mode in [\\\"combined\\\", \\\"separate\\\"]:\n    fn = make_loss(mode)\n    vg = jax.jit(jax.value_and_grad(fn))\n    t0=time.time(); v,g = vg(P); print(f\\\"{mode}: compile+run {time.time()-t0:.2f}s val {float(v):.5f} gradnorm {float(jnp.linalg.norm(g)):.4f}\\\")\n    t0=time.time(); v,g = vg(P); print(f\\\"{mode}: run {time.time()-t0:.4f}s\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
