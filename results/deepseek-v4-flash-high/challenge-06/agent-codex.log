e)\n    return e\n\ndef loss(params):\n    s = params[:nb]; j = params[nb:2*nb]; d = params[2*nb:3*nb]\n    t = tmin + (tmax-tmin) * jax.nn.sigmoid(s)\n    J = jnp.tanh(j); D = jnp.tanh(d)\n    rot = params[3*nb:].reshape(nb, n, 3)\n    def ham(t, J, D):\n        return J*A_j + D*B_j\n    c0 = tc.Circuit(n)\n    for i in range(1, n, 2):\n        c0.x(i)\n    state = c0.state()\n    for l in range(nb):\n        ts = tc.backend.stack([tc.backend.cast(0.0, tc.rdtypestr), t[l]])\n        s1 = tc.timeevol.ode_evol_global(ham, state, ts, None, J[l], D[l], mode=\\\"hamiltonian\\\",\n                                         rtol=config[\\\"ode_rtol\\\"], atol=config[\\\"ode_atol\\\"], max_steps=config[\\\"ode_max_steps\\\"])\n        c = tc.Circuit(n, inputs=s1[-1])\n        for k in range(n):\n            c.rz(k, theta=rot[l,k,0]); c.ry(k, theta=rot[l,k,1]); c.rz(k, theta=rot[l,k,2])\n        state = c.state()\n    return jnp.real(target_energy(state)) / n\n\nrng = np.random.default_rng(0)\nparams = np.concatenate([np.zeros(nb), 0.1*np.ones(nb), 0.1*np.ones(nb), rng.normal(0, 0.1, nb*n*3)]).astype(np.float32)\n\nvg = jax.jit(jax.value_and_grad(loss))\nt0=time.time()\nv, g = vg(jnp.array(params))\nprint(\\\"v+g 1st\\\", float(v), \\\"time\\\", time.time()-t0)\nt0=time.time()\nv, g = vg(jnp.array(params))\nprint(\\\"v+g 2nd\\\", float(v), \\\"grad norm\\\", float(jnp.linalg.norm(g)), \\\"time\\\", time.time()-t0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
