{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax.numpy as jnp\n\na, b, g = 0.3, -0.2, 0.5\n\n# tc gates\nc = tc.Circuit(1)\nc.rz(0, theta=a); c.ry(0, theta=b); c.rz(0, theta=g)\ns_sep = c.state()\n\ndef u2x2(a, b, g):\n    ca = jnp.cos(a/2); sa = jnp.sin(a/2)\n    e1 = ca - 1j*sa; e2 = ca + 1j*sa\n    cb = jnp.cos(b/2); sb = jnp.sin(b/2)\n    cg = jnp.cos(g/2); sg = jnp.sin(g/2)\n    f1 = cg - 1j*sg; f2 = cg + 1j*sg\n    m1 = jnp.array([[cb*f1, -sb*f2],[sb*f1, cb*f2]], jnp.complex64)\n    row0 = jnp.stack([e1*m1[0,0], e1*m1[0,1]])\n    row1 = jnp.stack([e2*m1[1,0], e2*m1[1,1]])\n    return jnp.stack([row0, row1])\n\nc2 = tc.Circuit(1)\nc2.apply_general_gate(tc.gates.Gate(u2x2(a,b,g)), 0)\ns_comb = c2.state()\nprint(\\\"sep\\\", s_sep, \\\"comb\\\", s_comb)\nprint(\\\"diff\\\", jnp.abs(s_sep - s_comb))\n\n# order test: also compare to U = RZ(g) RY(b) RZ(a) (wrong order)\ndef u_wrong(a,b,g):\n    return u2x2(g,b,a)\nc3 = tc.Circuit(1)\nc3.apply_general_gate(tc.gates.Gate(u_wrong(a,b,g)), 0)\nprint(\\\"wrong-order diff\\\", jnp.abs(s_sep - c3.state()))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
