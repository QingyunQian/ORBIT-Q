{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np, scipy.sparse as sp\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import sparse\nimport time\n\nconfig = {\n    \\\"n_qubits\\\": 14, \\\"n_blocks\\\": 4,\n    \\\"t_min\\\": 0.05, \\\"t_max\\\": 0.50,\n    \\\"ode_rtol\\\": 1e-6, \\\"ode_atol\\\": 1e-6, \\\"ode_max_steps\\\": 16,\n    \\\"max_steps\\\": 100, \\\"learning_rate\\\": 0.12,\n}\nn = config[\\\"n_qubits\\\"]; nb = config[\\\"n_blocks\\\"]\ntmin, tmax = config[\\\"t_min\\\"], config[\\\"t_max\\\"]\n\nI2 = np.eye(2); X = np.array([[0,1],[1,0.]],complex); Y = np.array([[0,-1j],[1j,0.]],complex); Z = np.array([[1,0],[0,-1.]],complex)\n\ndef kron_seq(mats):\n    out = mats[0]\n    for m in mats[1:]:\n        out = sp.kron(out, m, format='csr')\n    return out.tocoo()\n\nA = None\nfor i in range(n-1):\n    mats = [I2]*n\n    mats[i] = X; mats[i+1] = X\n    m1 = kron_seq(mats)\n    mats[i] = Y; mats[i+1] = Y\n    m2 = kron_seq(mats)\n    A = m1+m2 if A is None else A + m1 + m2\nA = A.tocoo()\nB = None\nfor i in range(n):\n    mats = [I2]*n; mats[i] = Z\n    m = kron_seq(mats).tocoo()\n    B = m if B is None else B + m\nB = B.tocoo()\n\ndef to_bcoo(m):\n    return sparse.BCOO((jnp.array(m.data, jnp.complex64), jnp.array(np.stack([m.row, m.col],axis=1), jnp.int32)), shape=m.shape)\nA_j = to_bcoo(A); B_j = to_bcoo(B)\n\n# target terms: (gate_node, idx, weight)\ntarget_terms = []\nfor i in range(n-1):\n    for g, w in [(X, 0.7), (Y, 0.7), (Z, 1.1)]:\n        # scaled single-qubit gates\n        target_terms.append((tc.gates.Gate(g.astype(np.complex64)) * w, [i]))\n        target_terms.append((tc.gates.Gate(g.astype(np.complex64)) * w, [i+1]))\nfor i in range(n):\n    target_terms.append((tc.gates.Gate(Z.astype(np.complex64)) * (0.25*(-1.0)**i), [i]))\nprint(\\\"num target terms\\\", len(target_terms))\n\ndef target_energy(state):\n    e = tc.backend.cast(0.0, tc.rdtypestr)\n    for op, idx, w in target_terms:\n        e = e + w * tc.expectation((op, idx), ket=state)\n    return e\n\ndef loss(params):\n    s = params[:nb]; j = params[nb:2*nb]; d = params[2*nb:3*nb]\n    t = tmin + (tmax-tmin) * jax.nn.sigmoid(s)\n    J = jnp.tanh(j); D = jnp.tanh(d)\n    rot = params[3*nb:].reshape(nb, n, 3)\n    def ham(t, J, D):\n        return J*A_j + D*B_j\n    state = tc.Circuit(n).state()\n    # Neel: X on odd qubits\n    c0 = tc.Circuit(n)\n    for i in range(1, n, 2):\n        c0.x(i)\n    state = c0.state()\n    for l in range(nb):\n        ts = tc.backend.stack([tc.backend.cast(0.0, tc.rdtypestr), t[l]])\n        s1 = tc.timeevol.ode_evol_global(ham, state, ts, None, J[l], D[l], mode=\\\"hamiltonian\\\",\n                                         rtol=config[\\\"ode_rtol\\\"], atol=config[\\\"ode_atol\\\"], max_steps=config[\\\"ode_max_steps\\\"])\n        c = tc.Circuit(n, inputs=s1[-1])\n        for k in range(n):\n            c.rz(k, theta=rot[l,k,0]); c.ry(k, theta=rot[l,k,1]); c.rz(k, theta=rot[l,k,2])\n        state = c.state()\n    return target_energy(state) / n\n\nrng = np.random.default_rng(0)\nparams = np.concatenate([np.zeros(nb), 0.1*np.ones(nb), 0.1*np.ones(nb), rng.normal(0, 0.1, nb*n*3)]).astype(np.float32)\nprint(\\\"nparams\\\", len(params))\n\nt0=time.time()\nval = loss(jnp.array(params))\nprint(\\\"loss first (jit compile)\\\", val, \\\"time\\\", time.time()-t0)\nt0=time.time()\nval = loss(jnp.array(params))\nprint(\\\"loss second\\\", val, \\\"time\\\", time.time()-t0)\n\nvg = jax.jit(jax.value_and_grad(loss))\nt0=time.time()\nv, g = vg(jnp.array(params))\nprint(\\\"value_and_grad\\\", v, \\\"grad shape\\\", g.shape, \\\"time\\\", time.time()-t0)\nt0=time.time()\nv, g = vg(jnp.array(params))\nprint(\\\"value_and_grad 2nd\\\", v, \\\"time\\\", time.time()-t0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
