{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np, scipy.sparse as sp\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import sparse\nfrom jax.experimental.ode import odeint\nimport time\n\nn = 14\nI2 = np.eye(2); X = np.array([[0,1],[1,0.]],complex); Y = np.array([[0,-1j],[1j,0.]],complex); Z = np.array([[1,0],[0,-1.]],complex)\n\ndef kron_seq(mats):\n    out = mats[0]\n    for m in mats[1:]:\n        out = sp.kron(out, m, format='csr')\n    return out.tocoo()\n\nA = None; B = None\nfor i in range(n-1):\n    matsA = [I2]*n; matsA[i] = X; matsA[i+1] = X\n    m1 = kron_seq(matsA)\n    matsA[i] = Y; matsA[i+1] = Y\n    m2 = kron_seq(matsA)\n    m = (m1 + m2).tocoo()\n    A = m if A is None else (A + m)\nA = A.tocoo()\nB = None\nfor i in range(n):\n    mats = [I2]*n; mats[i] = Z\n    m = kron_seq(mats).tocoo()\n    B = m if B is None else (B + m)\nB = B.tocoo()\n\ndef to_bcoo(m):\n    return sparse.BCOO((jnp.array(m.data, jnp.complex64), jnp.array(np.stack([m.row, m.col],axis=1), jnp.int32)), shape=m.shape)\n\nA_j = to_bcoo(A); B_j = to_bcoo(B)\n\nc0 = tc.Circuit(n)\nfor i in range(1, n, 2):\n    c0.x(i)\npsi0 = c0.state()\nprint(\\\"state\\\", psi0.shape, psi0.dtype)\nts = jnp.array([0.0, 0.275], jnp.float32)\ndef f(y, t, J, D):\n    H = jnp.tanh(J) * A_j + jnp.tanh(D) * B_j\n    return -1j * (H @ y)\n\nt0=time.time()\nout = odeint(f, psi0, ts, J, D, rtol=1e-6, atol=1e-6, mxstep=16)\nprint(\\\"ode success\\\", out.shape, \\\"norm\\\", jnp.linalg.norm(out[-1]), \\\"time\\\", time.time()-t0)\n\n# gradient check\ndef loss(J, D):\n    out = odeint(f, psi0, ts, J, D, rtol=1e-6, atol=1e-6, mxstep=16)\n    return jnp.real(jnp.sum(jnp.conj(out[-1]) * out[-1]))\ng = jax.grad(loss)(jnp.array(0.1), jnp.array(0.1))\nprint(\\\"grad\\\", g)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
