{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'EOF'\nimport numpy as np, scipy.sparse as sp\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import sparse\n\nn = 14\nI2 = np.eye(2); X = np.array([[0,1],[1,0.]],complex); Y = np.array([[0,-1j],[1j,0.]],complex); Z = np.array([[1,0],[0,-1.]],complex)\n\ndef kron_seq(mats):\n    out = mats[0]\n    for m in mats[1:]:\n        out = sp.kron(out, m, format='csr')\n    return out.tocoo()\n\nA = None; B = None\nfor i in range(n-1):\n    matsA = [I2]*n\n    matsA[i] = X; matsA[i+1] = X\n    m1 = kron_seq(matsA)\n    matsA[i] = Y; matsA[i+1] = Y\n    m2 = kron_seq(matsA)\n    m = (m1 + m2).tocoo()\n    A = m if A is None else (A + m)\nA = A.tocoo()\nB = None\nfor i in range(n):\n    mats = [I2]*n\n    mats[i] = Z\n    m = kron_seq(mats).tocoo()\n    B = m if B is None else (B + m)\nB = B.tocoo()\nprint(\\\"A nnz\\\", A.nnz, \\\"B nnz\\\", B.nnz)\n\ndef to_bcoo(m):\n    return sparse.BCOO((jnp.array(m.data, jnp.complex64), jnp.array(np.stack([m.row, m.col],axis=1), jnp.int32)), shape=m.shape)\n\nA_j = to_bcoo(A); B_j = to_bcoo(B)\n\nJ = jnp.array(tanh0 := 0.1)\nD = jnp.array(0.1)\nH = jnp.tanh(jnp.array(0.1)) * A_j + jnp.tanh(jnp.array(0.1)) * B_j\nprint(\\\"H type\\\", type(H))\n\n# Neel state via circuit\nc0 = tc.Circuit(n)\nfor i in range(1, n, 2):\n    c0.x(i)\npsi0 = c0.state()\nprint(\\\"state shape/dtype\\\", psi0.shape, psi0.dtype)\n\nfrom jax.experimental.ode import odeint\nts = jnp.array([0.0, 0.275], jnp.float32)\ndef f(y, t, J, D):\n    H = jnp.tanh(J) * A_j + jnp.tanh(D) * B_j\n    return -1j * (H @ y)\n\nout = odeint(f, psi0, ts, rtol=1e-6, atol=1e-6, mxstep=16, J, D)\nprint(\\\"ode success, shape\\\", out.shape, \\\"norm\\\", jnp.linalg.norm(out[-1]))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
