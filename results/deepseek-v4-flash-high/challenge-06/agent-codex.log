{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 500 python - <<'EOF'\nimport numpy as np, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport jax.numpy as jnp\n\nn = 14; nb = 4\n\ndef make_loss(nqubits_per_block, fixed=False):\n    def loss(params):\n        rot=params[3*nb:].reshape(nb,n,3)\n        c0=tc.Circuit(n)\n        for i in range(1,n,2): c0.x(i)\n        state=c0.state()\n        for l in range(nb):\n            c=tc.Circuit(n,inputs=state)\n            for k in range(nqubits_per_block):\n                if fixed:\n                    c.x(k)\n                else:\n                    c.rz(k,theta=rot[l,k,0]); c.ry(k,theta=rot[l,k,1]); c.rz(k,theta=rot[l,k,2])\n            state=c.state()\n        return jnp.real(jnp.sum(jnp.conj(state)*state))/n\n    return loss\n\nrng = np.random.default_rng(0)\nparams = np.concatenate([np.zeros(nb), 0.1*np.ones(nb), 0.1*np.ones(nb), rng.normal(0,0.1,nb*n*3)]).astype(np.float32)\nP = jnp.array(params)\n\nfor name, nq, fixed in [(\\\"1q-var\\\", 1, False), (\\\"2q-var\\\", 2, False), (\\\"1q-fixed\\\", 1, True)]:\n    fn = make_loss(nq, fixed)\n    vg = jax.jit(jax.value_and_grad(fn))\n    t0=time.time(); jax.make_jaxpr(vg)(P); t1=time.time()-t0\n    print(f\\\"{name}: make_jaxpr {t1:.2f}s\\\")\n    t0=time.time(); v,g = vg(P); t2=time.time()-t0\n    print(f\\\"{name}: compile+run {t2:.2f}s\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
