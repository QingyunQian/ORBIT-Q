{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 400 python - <<'EOF'\nimport numpy as np, scipy.sparse as sp, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nimport jax\nimport jax.numpy as jnp\nfrom jax.experimental import sparse\n\nconfig = {\n    \\\"n_qubits\\\": 14, \\\"n_blocks\\\": 4,\n    \\\"t_min\\\": 0.05, \\\"t_max\\\": 0.50,\n    \\\"ode_rtol\\\": 1e-6, \\\"ode_atol\\\": 1e-6, \\\"ode_max_steps\\\": 16,\n    \\\"max_steps\\\": 100, \\\"learning_rate\\\": 0.12,\n}\nn = config[\\\"n_qubits\\\"]; nb = config[\\\"n_blocks\\\"]\ntmin, tmax = config[\\\"t_min\\\"], config[\\\"t_max\\\"]\nrtol, atol, mx = config[\\\"ode_rtol\\\"], config[\\\"ode_atol\\\"], config[\\\"ode_max_steps\\\"]\n\nI2 = np.eye(2); X = np.array([[0,1],[1,0.]],complex); Y = np.array([[0,-1j],[1j,0.]],complex); Z = np.array([[1,0],[0,-1.]],complex)\ndef kron_seq(mats):\n    out = mats[0]\n    for m in mats[1:]:\n        out = sp.kron(out, m, format='csr')\n    return out.tocoo()\nA=None\nfor i in range(n-1):\n    mats=[I2]*n; mats[i]=X; mats[i+1]=X; m1=kron_seq(mats)\n    mats[i]=Y; mats[i+1]=Y; m2=kron_seq(mats)\n    A = m1+m2 if A is None else A+m1+m2\nA=A.tocoo()\nB=None\nfor i in range(n):\n    mats=[I2]*n; mats[i]=Z\n    m=kron_seq(mats).tocoo()\n    B = m if B is None else B+m\nB=B.tocoo()\ndef to_bcoo(m):\n    return sparse.BCOO((jnp.array(m.data,jnp.complex64), jnp.array(np.stack([m.row,m.col],1),jnp.int32)), shape=m.shape)\nA_j=to_bcoo(A); B_j=to_bcoo(B)\n\ngx=tc.gates.x(); gy=tc.gates.y(); gz=tc.gates.z()\nterms = []\nfor i in range(n-1):\n    terms.append(((gx*0.7,[i]),(gx,[i+1])))\n    terms.append(((gy*0.7,[i]),(gy,[i+1])))\n    terms.append(((gz*1.1,[i]),(gz,[i+1])))\nfor i in range(n):\n    terms.append(((gz*(0.25*(-1.0)**i),[i]),))\n\ndef u2x2(a, b, g):\n    ca = jnp.cos(a/2); sa = jnp.sin(a/2)\n    e1 = ca - 1j*sa; e2 = ca + 1j*sa\n    cb = jnp.cos(b/2); sb = jnp.sin(b/2)\n    cg = jnp.cos(g/2); sg = jnp.sin(g/2)\n    f1 = cg - 1j*sg; f2 = cg + 1j*sg\n    m1 = jnp.array([[cb*f1, -sb*f2],[sb*f1, cb*f2]], jnp.complex64)\n    row0 = jnp.stack([e1*m1[0,0], e1*m1[0,1]])\n    row1 = jnp.stack([e2*m1[1,0], e2*m1[1,1]])\n    return jnp.stack([row0, row1])\n\ndef target_energy(state):\n    e = tc.backend.cast(0.0, tc.rdtypestr)\n    for ops in terms:\n        e = e + tc.expectation(*ops, ket=state)\n    return e\n\ndef loss(params):\n    s=params[:nb]; j=params[nb:2*nb]; d=params[2*nb:3*nb]\n    t = tmin+(tmax-tmin)*jax.nn.sigmoid(s); J=jnp.tanh(j); D=jnp.tanh(d)\n    rot=params[3*nb:].reshape(nb,n,3)\n    def ham(tt, J, D):\n        return J*A_j + D*B_j\n    c0=tc.Circuit(n)\n    for i in range(1,n,2): c0.x(i)\n    state=c0.state()\n    for l in range(nb):\n        ts=tc.backend.stack([tc.backend.cast(0.0,tc.rdtypestr), t[l]])\n        s1=tc.timeevol.ode_evol_global(ham,state,ts,None,J[l],D[l],mode=\\\"hamiltonian\\\",rtol=rtol,atol=atol,max_steps=mx)\n        c=tc.Circuit(n,inputs=s1[-1])\n        for k in range(n):\n            # exact equivalent of c.rz(alpha); c.ry(beta); c.rz(gamma)\n            c.apply_general_gate(tc.gates.Gate(u2x2(rot[l,k,2],rot[l,k,1],rot[l,k,0])), k)\n        state=c.state()\n    return jnp.real(target_energy(state))/n\n\n# sanity: eager loss matches previous separate-gate eager value\nrng = np.random.default_rng(0)\nparams = np.concatenate([np.zeros(nb), 0.1*np.ones(nb), 0.1*np.ones(nb), rng.normal(0,0.1,nb*n*3)]).astype(np.float32)\nprint(\\\"eager init loss:\\\", float(loss(jnp.array(params))))  # expect ~ -0.632375\n\nvg = jax.jit(jax.value_and_grad(loss))\nP = jnp.array(params)\nt0=time.time(); v,g = vg(P); print(\\\"compile\\\", time.time()-t0, \\\"init\\\", float(v))\n\nlr = config[\\\"learning_rate\\\"]\nm = np.zeros_like(params); vv = np.zeros_like(params)\nhist = []\nt0=time.time()\nfor it in range(1, config[\\\"max_steps\\\"]+1):\n    v, g = vg(jnp.array(params))\n    hist.append(float(np.asarray(v)))\n    g = np.asarray(g)\n    m = 0.9*m + 0.1*g\n    vv = 0.999*vv + 0.001*g*g\n    mh = m/(1-0.9**it); vh = vv/(1-0.999**it)\n    params = params - lr*mh/(np.sqrt(vh)+1e-8)\nprint(\\\"100 steps\\\", time.time()-t0)\nprint(\\\"first/last\\\", hist[0], hist[-1])\nprint(\\\"times:\\\", 0.05+0.45/(1+np.exp(-params[:nb])))\nprint(\\\"J:\\\", np.tanh(params[nb:2*nb]), \\\"D:\\\", np.tanh(params[2*nb:3*nb]))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
