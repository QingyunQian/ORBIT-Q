{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ntape, P = generate_gate_tape(config)\nterm = ((\\\"x\\\",388),(\\\"z\\\",390))\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ngates, nq, pauli = build_cone(tape, list(term))\ntheta = jnp.zeros(P)\nc = tc.Circuit(nq)\nprint(\\\"front type:\\\", type(c._front[0]), \\\"nodes:\\\", len(c._nodes))\nfor i in range(nq):\n    c.H(i)\nprint(\\\"after H: nodes:\\\", len(c._nodes))\nfor g in gates:\n    if len(g) == 4:\n        getattr(c, g[0])(g[1], g[2], theta=theta[g[3]])\n    else:\n        getattr(c, g[0])(g[1], theta=theta[g[2]])\nprint(\\\"after gates: nodes:\\\", len(c._nodes))\nw = c.wavefunction()\nprint(\\\"wavefunction type:\\\", type(w), \\\"shape:\\\", getattr(w, 'shape', None))\n# does front hold tensors?\nf0 = c._front[0]\nprint(\\\"front edge tensors:\\\", [n.tensor.shape for n in [f0.node1, f0.node2]][:2] if f0.node2 else \\\"dangling\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
