{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax, jax.numpy as jnp, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ntape, P = generate_gate_tape(config)\npauli_terms = ((0.5645931361768194, ((\\\"x\\\",388),(\\\"z\\\",390))), (1.0, ((\\\"x\\\",16),(\\\"y\\\",19))))\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ncones = [build_cone(tape, list(term)) for _, term in pauli_terms]\n\ndef make_term_fn(gates, nq, pauli, positions):\n    # positions: local pos -> global cone-vector index\n    def fn(theta_cone):\n        c = tc.Circuit(nq)\n        for i in range(nq):\n            c.H(i)\n        for g in gates:\n            if len(g) == 4:\n                axis, a, b, p = g\n                getattr(c, axis)(a, b, theta=theta_cone[positions[p]])\n            else:\n                axis, a, p = g\n                getattr(c, axis)(a, theta=theta_cone[positions[p]])\n        xs = [q for q, p in pauli if p == \\\"x\\\"]\n        ys = [q for q, p in pauli if p == \\\"y\\\"]\n        zs = [q for q, p in pauli if p == \\\"z\\\"]\n        return c.expectation_ps(x=xs, y=ys, z=zs).real\n    return fn\n\n# combined cone param vector: unique pidx\nuniq = sorted({g[-1] for gates, _, _ in cones for g in gates})\npos_of = {p: i for i, p in enumerate(uniq)}\npositions = [[pos_of[g[-1]] for g in gates] for gates, _, _ in cones]\nprint(\\\"unique cone params:\\\", len(uniq), \\\"per term:\\\", [len(x) for x in positions])\n\nfns = [make_term_fn(*cones[k], positions[k]) for k in range(2)]\nvgs = [jax.jit(jax.vmap(jax.value_and_grad(lambda th, k=k: -fns[k](th)))) for k in range(2)]\n\nR = 200\nth = jnp.asarray(np.random.default_rng(0).normal(0, 0.02, (R, len(uniq))))\nt0=time.time()\nfor k in range(2):\n    vgs[k](th)\njax.block_until_ready(tuple(vgs[k](th) for k in range(2)))\nprint(\\\"compile:\\\", time.time()-t0)\nt0=time.time()\nfor _ in range(3):\n    jax.block_until_ready(tuple(vgs[k](th) for k in range(2)))\nprint(\\\"per-step:\\\", (time.time()-t0)/3)\nr = vgs[0](th)\nprint(\\\"grad shape:\\\", r[1].shape, \\\"nz:\\\", int(jnp.count_nonzero(r[1][0])))\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
