a[p])\n    xs = [q for q, p in pauli if p == \\\"x\\\"]\n    zs = [q for q, p in pauli if p == \\\"z\\\"]\n    return c.expectation_ps(x=xs, z=zs).real\n\nfor trial in range(5):\n    t = rng.normal(0, 0.5, P)\n    e_full = float(np.asarray(full_exp(jnp.asarray(t))))\n    e_cone = float(np.asarray(cone_exp(jnp.asarray(t))))\n    print(f\\\"trial {trial}: full={e_full:.8f} cone={e_cone:.8f} diff={abs(e_full-e_cone):.2e}\\\")\nEOF\"","aggregated_output":"tape len 3897 P 3897\nterm (('x', 388), ('z', 390)) cone qubits: 18 kept gates: 74\nterm (('x', 16), ('y', 19)) cone qubits: 15 kept gates: 80\ntrial 0: full=0.41596222 cone=0.41596231 diff=8.94e-08\ntrial 1: full=0.14925385 cone=0.14925386 diff=1.49e-08\ntrial 2: full=-0.12269942 cone=-0.12269935 diff=6.71e-08\ntrial 3: full=-0.59608132 cone=-0.59608120 diff=1.19e-07\ntrial 4: full=-0.13760857 cone=-0.13760854 diff=2.98e-08\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax.numpy as jnp, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ntape, P = generate_gate_tape(config)\npauli_terms = ((0.5645931361768194, ((\\\"x\\\",388),(\\\"z\\\",390))), (1.0, ((\\\"x\\\",16),(\\\"y\\\",19))))\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ncones = [build_cone(tape, list(term)) for _, term in pauli_terms]\n\ndef make_loss(idx, sign=1.0):\n    gates, nq, pauli = cones[idx]\n    def loss(theta):\n        c = tc.Circuit(nq)\n        for i in range(nq):\n            c.H(i)\n        for g in gates:\n            if len(g) == 4:\n                axis, a, b, p = g\n                getattr(c, axis)(a, b, theta=theta[p])\n            else:\n                axis, a, p = g\n                getattr(c, axis)(a, theta=theta[p])\n        xs = [q for q, p in pauli if p == \\\"x\\\"]\n        ys = [q for q, p in pauli if p == \\\"y\\\"]\n        zs = [q for q, p in pauli if p == \\\"z\\\"]\n        return sign * c.expectation_ps(x=xs, y=ys, z=zs).real\n    return loss\n\ndef adam_maximize(loss_fn, P, steps=100, lr=0.03, seed=0, scale=0.02):\n    theta = jnp.asarray(np.random.default_rng(seed).normal(0, scale, P))\n    m = jnp.zeros_like(theta); v = jnp.zeros_like(theta)\n    vg = jax.jit(jax.grad(loss_fn))\n    best = -9\n    for t in range(1, steps+1):\n        g = vg(theta)\n        m = 0.9*m + 0.1*g\n        v = 0.999*v + 0.001*g*g\n        mh = m/(1-0.9**t); vh = v/(1-0.999**t)\n        theta -= lr*mh/(jnp.sqrt(vh)+1e-8)\n        val = float(np.asarray(loss_fn(theta)))\n        best = max(best, val)\n    return best, float(np.asarray(loss_fn(theta)))\n\nfor idx, name in [(0, \\\"term1 XZ\\\"), (1, \\\"term2 XY\\\")]:\n    t0 = time.time()\n    best, final = adam_maximize(make_loss(idx), P)\n    print(f\\\"{name}: best={best:.6f} final={final:.6f} time={time.time()-t0:.1f}s\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
