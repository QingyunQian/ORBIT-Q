{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\n# small random instance for cone validation\ncfg = dict(n_qubits=12, n_layers=3, seed=7, edge_keep_prob=0.9)\ntape, P = generate_gate_tape(cfg)\nterm = ((\\\"x\\\", 3), (\\\"z\\\", 8))\nrng = np.random.default_rng(0)\ntheta = rng.normal(0, 0.5, P)\n\n# full circuit expectation\ndef full_exp(theta):\n    c = tc.Circuit(cfg[\\\"n_qubits\\\"])\n    for i in range(cfg[\\\"n_qubits\\\"]):\n        c.H(i)\n    for g in tape:\n        if len(g) == 4:\n            axis, a, b, p = g\n            getattr(c, axis)(a, b, theta=theta[p])\n        else:\n            axis, a, p = g\n            getattr(c, axis)(a, theta=theta[p])\n    xs = [q for p_, q in term if p_ == \\\"x\\\"]\n    zs = [q for p_, q in term if p_ == \\\"z\\\"]\n    return c.expectation_ps(x=xs, z=zs).real\n\n# cone reduction\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ngates, nq, pauli = build_cone(tape, list(term))\ndef cone_exp(theta):\n    c = tc.Circuit(nq)\n    for i in range(nq):\n        c.H(i)\n    for g in gates:\n        if len(g) == 4:\n            axis, a, b, p = g\n            getattr(c, axis)(a, b, theta=theta[p])\n        else:\n            axis, a, p = g\n            getattr(c, axis)(a, theta=theta[p])\n    xs = [q for q, p in pauli if p == \\\"x\\\"]\n    zs = [q for q, p in pauli if p == \\\"z\\\"]\n    return c.expectation_ps(x=xs, z=zs).real\n\nfor trial in range(5):\n    t = rng.normal(0, 0.5, P)\n    e_full = float(np.asarray(full_exp(jnp.asarray(t))))\n    e_cone = float(np.asarray(cone_exp(jnp.asarray(t))))\n    print(f\\\"trial {trial}: full={e_full:.8f} cone={e_cone:.8f} diff={abs(e_full-e_cone):.2e}\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
