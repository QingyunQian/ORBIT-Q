{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto9/proto.py <<'EOF'\nimport numpy as np\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\nimport time, sys\nsys.path.insert(0, '/tmp/proto9')\nfrom gen import generate_gate_tape\n\ntc.set_backend(\\\"jax\\\")\n\nconfig = {\n    \\\"n_qubits\\\": 512, \\\"n_layers\\\": 6, \\\"max_steps\\\": 100, \\\"n_restarts\\\": 200,\n    \\\"learning_rate\\\": 0.03, \\\"initial_parameter_scale\\\": 0.02, \\\"seed\\\": 2035,\n    \\\"edge_keep_prob\\\": 0.24, \\\"success_threshold\\\": 1.0,\n}\ntape, P = generate_gate_tape(config)\nconfig[\\\"gate_tape\\\"] = tape\nconfig[\\\"parameter_count\\\"] = P\npauli_terms = (\n    (0.5645931361768194, ((\\\"x\\\", 388), (\\\"z\\\", 390))),\n    (1.0, ((\\\"x\\\", 16), (\\\"y\\\", 19))),\n)\nconfig[\\\"pauli_terms\\\"] = pauli_terms\n\ndef build_cone(tape, term_qubits):\n    work = set(term_qubits)\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    pauli = [(qmap[q], p) for p, q in term_qubits]\n    return gates, len(work), pauli\n\ncones = []\nweights = []\nfor w, term in pauli_terms:\n    gates, nq, pauli = build_cone(tape, [(q, p) for p, q in term])\n    cones.append((gates, nq, pauli))\n    weights.append(w)\nprint(\\\"cones:\\\", [(len(g), n) for g, n, _ in cones])\n\ndef loss_restart(theta):\n    total = 0.0\n    for w, (gates, nq, pauli) in zip(weights, cones):\n        c = tc.Circuit(nq)\n        for i in range(nq):\n            c.H(i)\n        for g in gates:\n            if len(g) == 4:\n                axis, a, b, pidx = g\n                getattr(c, axis)(a, b, theta=theta[pidx])\n            else:\n                axis, a, pidx = g\n                getattr(c, axis)(a, theta=theta[pidx])\n        xs = [q for q, p in pauli if p == \\\"x\\\"]\n        ys = [q for q, p in pauli if p == \\\"y\\\"]\n        zs = [q for q, p in pauli if p == \\\"z\\\"]\n        e = c.expectation_ps(x=xs, y=ys, z=zs).real\n        total += w * e\n    return -total\n\n# sanity: single restart numpy vs vmap jit\nrng = np.random.default_rng(2035 + 100000)\ntheta0 = rng.normal(0.0, 0.02, size=P)\nval_ref = loss_restart(jnp.asarray(theta0))\nvmap_vg = jax.jit(jax.vmap(jax.value_and_grad(loss_restart)))\nv, g = vmap_vg(jnp.stack([jnp.asarray(theta0)] * 3))\nprint(\\\"ref\\\", val_ref, \\\"vmap vals\\\", v)\nprint(\\\"grad shape\\\", g.shape, \\\"grad nonzero\\\", np.count_nonzero(np.asarray(g[0])), \\\"expected\\\", len({pidx for gates,_,_ in cones for gg in gates for pidx in [gg[-1]]}))\n\n# full loop benchmark\nn_restarts = config[\\\"n_restarts\\\"]\nrngs = [np.random.default_rng(config[\\\"seed\\\"] + 100000 + r) for r in range(n_restarts)]\nthetas = np.stack([rng.normal(0.0, config[\\\"initial_parameter_scale\\\"], size=P) for rng in rngs])\ntheta = jnp.asarray(thetas)\nm = jnp.zeros_like(theta)\nvv = jnp.zeros_like(theta)\nlr = config[\\\"learning_rate\\\"]\nb1, b2, eps = 0.9, 0.999, 1e-8\n\nt0 = time.time()\nvmap_vg(theta, m, vv)  # warm/compile\nt1 = time.time()\nprint(\\\"compile time\\\", t1 - t0)\nhistory = np.zeros((n_restarts, config[\\\"max_steps\\\"]))\nfor step in range(config[\\\"max_steps\\\"]):\n    vals, grad = vmap_vg(theta)\n    history[:, step] = np.asarray(vals)\n    m = b1 * m + (1 - b1) * grad\n    vv = b2 * vv + (1 - b2) * grad ** 2\n    t = step + 1\n    mhat = m / (1 - b1 ** t)\n    vhat = vv / (1 - b2 ** t)\n    theta = theta - lr * mhat / (jnp.sqrt(vhat) + eps)\nt2 = time.time()\nprint(\\\"loop time\\\", t2 - t1, \\\"total\\\", t2 - t0)\nprint(\\\"mean init\\\", history[:, 0].mean(), \\\"mean final\\\", history[:, -1].mean())\nprint(\\\"best final\\\", history[:, -1].max())\nprint(\\\"final std\\\", history[:, -1].std())\nEOF\npython /tmp/proto9/proto.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
