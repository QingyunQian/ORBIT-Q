{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax, jax.numpy as jnp, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"max_steps\\\":100,\\\"n_restarts\\\":200,\n          \\\"learning_rate\\\":0.03,\\\"initial_parameter_scale\\\":0.02,\\\"seed\\\":2035,\n          \\\"edge_keep_prob\\\":0.24,\\\"success_threshold\\\":1.0}\ntape, P = generate_gate_tape(config)\nconfig[\\\"gate_tape\\\"] = tape; config[\\\"parameter_count\\\"] = P\npauli_terms = ((0.5645931361768194, ((\\\"x\\\",388),(\\\"z\\\",390))), (1.0, ((\\\"x\\\",16),(\\\"y\\\",19))))\nconfig[\\\"pauli_terms\\\"] = pauli_terms\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ncones = [build_cone(tape, list(term)) for _, term in pauli_terms]\nweights = [w for w, _ in pauli_terms]\n\ndef make_term_fn(gates, nq, pauli):\n    def fn(theta):\n        c = tc.Circuit(nq)\n        for i in range(nq):\n            c.H(i)\n        for g in gates:\n            if len(g) == 4:\n                axis, a, b, p = g\n                getattr(c, axis)(a, b, theta=theta[p])\n            else:\n                axis, a, p = g\n                getattr(c, axis)(a, theta=theta[p])\n        xs = [q for q, p in pauli if p == \\\"x\\\"]\n        ys = [q for q, p in pauli if p == \\\"y\\\"]\n        zs = [q for q, p in pauli if p == \\\"z\\\"]\n        return c.expectation_ps(x=xs, y=ys, z=zs).real\n    return fn\n\nvgs = [jax.jit(jax.vmap(jax.value_and_grad(lambda th, k=k: -make_term_fn(*cones[k])(th)))) for k in range(2)]\n\nR, S = config[\\\"n_restarts\\\"], config[\\\"max_steps\\\"]\ntheta = jnp.asarray(np.stack([np.random.default_rng(config[\\\"seed\\\"] + 100000 + r).normal(0.0, config[\\\"initial_parameter_scale\\\"], P) for r in range(R)]))\nm = jnp.zeros_like(theta); v = jnp.zeros_like(theta)\nhistory = np.zeros((R, S), dtype=np.float64)\nt0 = time.time()\nfor k in range(2):\n    vgs[k](theta)\njax.block_until_ready(tuple(vgs[k](theta) for k in range(2)))\nprint(\\\"compile:\\\", time.time()-t0)\nt0 = time.time()\nfor step in range(S):\n    r1, r2 = vgs[0](theta), vgs[1](theta)\n    jax.block_until_ready((r1, r2))\n    obj = weights[0]*np.asarray(r1[0]) + weights[1]*np.asarray(r2[0])\n    history[:, step] = obj\n    grad = weights[0]*r1[1] + weights[1]*r2[1]\n    t = step + 1\n    m = 0.9*m + 0.1*grad\n    v = 0.999*v + 0.001*grad*grad\n    theta = theta - 0.03*(m/(1-0.9**t))/(jnp.sqrt(v/(1-0.999**t)) + 1e-8)\nprint(\\\"loop:\\\", time.time()-t0)\ninit, fin = history[:, 0], history[:, -1]\nprint(\\\"mean init\\\", init.mean(), \\\"mean final\\\", fin.mean(), \\\"best\\\", fin.max())\nprint(\\\"var\\\", fin.var(), \\\"std\\\", fin.std(), \\\"success\\\", (fin >= 1.0).mean())\nprint(\\\"shape\\\", history.shape)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
