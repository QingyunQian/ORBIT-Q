  zs = [q for q, p in pauli if p == \\\"z\\\"]\n        return c.expectation_ps(x=xs, y=ys, z=zs).real\n    return fn\n\nvgs = [jax.jit(jax.vmap(jax.value_and_grad(lambda th, k=k: -make_term_fn(*cones[k])(th)))) for k in range(2)]\n\nn_restarts, max_steps, P = config[\\\"n_restarts\\\"], config[\\\"max_steps\\\"], config[\\\"parameter_count\\\"]\nrngs = [np.random.default_rng(config[\\\"seed\\\"] + 100000 + r) for r in range(n_restarts)]\ntheta = jnp.asarray(np.stack([rng.normal(0.0, config[\\\"initial_parameter_scale\\\"], size=P) for rng in rngs]))\nm = jnp.zeros_like(theta); v = jnp.zeros_like(theta)\nlr, b1, b2, eps = 0.03, 0.9, 0.999, 1e-8\nhistory = np.zeros((n_restarts, max_steps), dtype=np.float64)\n\nt0 = time.time()\nfor k in range(2):\n    vgs[k](theta)\njax.block_until_ready(tuple(vgs[k](theta) for k in range(2)))\nprint(\\\"compile:\\\", time.time()-t0)\n\nt0 = time.time()\nfor step in range(max_steps):\n    vals = [vgs[k](theta) for k in range(2)]\n    jax.block_until_ready(tuple(vals))\n    obj = weights[0]*vals[0][0] + weights[1]*vals[1][0]\n    history[:, step] = np.asarray(obj)\n    grad = weights[0]*vals[0][1] + weights[1]*vals[1][1]\n    m = b1*m + (1-b1)*grad\n    v = b2*v + (1-b2)*grad*grad\n    t = step + 1\n    theta = theta - lr*(m/(1-b1**t))/(jnp.sqrt(v/(1-b2**t)) + eps)\nprint(\\\"loop:\\\", time.time()-t0)\nprint(\\\"total:\\\", time.time()-(t0-999)) if False else None\nprint(\\\"shape:\\\", history.shape)\nprint(\\\"mean init:\\\", history[:,0].mean(), \\\"mean final:\\\", history[:,-1].mean())\nprint(\\\"best final:\\\", history[:,-1].max())\nprint(\\\"final var:\\\", history[:,-1].var(), \\\"std:\\\", history[:,-1].std())\nprint(\\\"success frac:\\\", (history[:,-1] >= 1.0).mean())\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
