[make_term_fn(*cones[k]) for k in range(2)]\nvgs = [jax.jit(jax.vmap(jax.value_and_grad(lambda th, k=k: -fns[k](th)))) for k in range(2)]\n\nR = 200\nth = jnp.asarray(np.random.default_rng(0).normal(0, 0.02, (R, len(uniq))))\nt0=time.time()\nfor k in range(2):\n    vgs[k](th)\njax.block_until_ready(tuple(vgs[k](th) for k in range(2)))\nprint(\\\"compile:\\\", time.time()-t0)\nt0=time.time()\nfor _ in range(3):\n    jax.block_until_ready(tuple(vgs[k](th) for k in range(2)))\nprint(\\\"per-step:\\\", (time.time()-t0)/3)\nr = vgs[0](th)\nprint(\\\"grad shape:\\\", r[1].shape, \\\"nz:\\\", int(jnp.count_nonzero(r[1][0])))\nEOF\"","aggregated_output":"tape len 3897 P 3897\nterm (('x', 388), ('z', 390)) cone qubits: 18 kept gates: 74\nterm (('x', 16), ('y', 19)) cone qubits: 15 kept gates: 80\nunique cone params: 154\ncompile: 32.97600960731506\nper-step: 1.5787227153778076\ngrad shape: (200, 154) nz: 70\n","exit_code":0,"status":"completed"}}
