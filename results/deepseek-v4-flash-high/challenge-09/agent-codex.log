{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax, jax.numpy as jnp, time\nimport tensorcircuit as tc\ntc.set_backend(\\\"jax\\\")\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ntape, P = generate_gate_tape(config)\npauli_terms = ((0.5645931361768194, ((\\\"x\\\",388),(\\\"z\\\",390))), (1.0, ((\\\"x\\\",16),(\\\"y\\\",19))))\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ncones = [build_cone(tape, list(term)) for _, term in pauli_terms]\ngates, nq, pauli = cones[1]\n\ndef term2(theta):\n    c = tc.Circuit(nq)\n    for i in range(nq):\n        c.H(i)\n    for g in gates:\n        if len(g) == 4:\n            axis, a, b, p = g\n            getattr(c, axis)(a, b, theta=theta[p])\n        else:\n            axis, a, p = g\n            getattr(c, axis)(a, theta=theta[p])\n    xs = [q for q, p in pauli if p == \\\"x\\\"]\n    ys = [q for q, p in pauli if p == \\\"y\\\"]\n    zs = [q for q, p in pauli if p == \\\"z\\\"]\n    return c.expectation_ps(x=xs, y=ys, z=zs).real\n\ngrad_fn = jax.jit(jax.grad(lambda th: -term2(th)))\nt0=time.time(); grad_fn(jnp.zeros(P)); print(\\\"compile\\\", time.time()-t0)\n\ndef run(seed, scale, steps=100):\n    theta = jnp.asarray(np.random.default_rng(seed).normal(0, scale, P))\n    m = jnp.zeros_like(theta); v = jnp.zeros_like(theta)\n    best = -9\n    for t in range(1, steps+1):\n        g = grad_fn(theta)\n        m = 0.9*m + 0.1*g; v = 0.999*v + 0.001*g*g\n        theta -= 0.03*(m/(1-0.9**t))/(jnp.sqrt(v/(1-0.999**t))+1e-8)\n        best = max(best, float(term2(theta)))\n    return best, float(term2(theta))\n\nfor scale in [0.02, 0.5, 2.0]:\n    vals = [run(s, scale) for s in range(12)]\n    finals = [v[1] for v in vals]\n    print(f\\\"scale={scale}: finals {[round(x,3) for x in finals]} max={max(finals):.3f}\\\")\n\n# random search\nrng = np.random.default_rng(42)\nbest = -9\nfor k in range(2000):\n    th = jnp.asarray(rng.normal(0, 0.8, P))\n    v = float(term2(th))\n    if v > best: best = v\nprint(\\\"random search best:\\\", best)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
