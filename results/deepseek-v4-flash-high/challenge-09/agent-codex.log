{"type":"item.started","item":{"id":"item_73","type":"command_execution","command":"/bin/bash -lc \"cd /tmp/proto9 && python - <<'EOF'\nimport numpy as np, jax, jax.numpy as jnp, time, os\nimport tensorcircuit as tc\nfrom gen import generate_gate_tape\n\nconfig = {\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24}\ntape, P = generate_gate_tape(config)\nterm = ((\\\"x\\\",388),(\\\"z\\\",390))\n\ndef build_cone(tape, term_qubits):\n    work = {q for _, q in term_qubits}\n    kept = []\n    for g in reversed(tape):\n        gq = set(g[1:3]) if len(g) == 4 else {g[1]}\n        if gq & work:\n            kept.append(g)\n            work |= gq\n    kept.reverse()\n    qmap = {q: i for i, q in enumerate(sorted(work))}\n    gates = []\n    for g in kept:\n        if len(g) == 4:\n            gates.append((g[0], qmap[g[1]], qmap[g[2]], g[3]))\n        else:\n            gates.append((g[0], qmap[g[1]], g[2]))\n    return gates, len(work), [(qmap[q], p) for p, q in term_qubits]\n\ngates, nq, pauli = build_cone(tape, list(term))\ndef fn(theta):\n    c = tc.Circuit(nq)\n    for i in range(nq):\n        c.H(i)\n    for g in gates:\n        if len(g) == 4:\n            getattr(c, g[0])(g[1], g[2], theta=theta[g[3]])\n        else:\n            getattr(c, g[0])(g[1], theta=theta[g[2]])\n    xs = [q for q, p in pauli if p == \\\"x\\\"]\n    zs = [q for q, p in pauli if p == \\\"z\\\"]\n    return -c.expectation_ps(x=xs, z=zs).real\n\nR = 200\nth = jnp.asarray(np.random.default_rng(0).normal(0, 0.02, (R, P)))\n\ndef bench(label):\n    tc.set_backend(\\\"jax\\\")\n    vg = jax.jit(jax.vmap(jax.value_and_grad(fn)))\n    t0=time.time(); r = vg(th); jax.block_until_ready(r)\n    c1 = time.time()-t0\n    t0=time.time()\n    for _ in range(3):\n        r = vg(th); jax.block_until_ready(r)\n    s = (time.time()-t0)/3\n    print(f\\\"{label}: compile={c1:.1f}s step={s:.3f}s\\\")\n    return c1, s\n\n# (a) default greedy\nbench(\\\"greedy\\\")\n# (b) use_primitives\ntc.set_contractor(\\\"greedy\\\", use_primitives=True)\nbench(\\\"greedy+primitives\\\")\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
