{"type":"item.started","item":{"id":"item_136","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/direct_n4.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=C); k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=C); k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=C)\n    return (np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))).astype(C)\nN=4; THETA=0.31; even=[(i,i+1) for i in range(0,N,2)]; odd=[(i,i+1) for i in range(1,N-1,2)]\nR=su(rxxu(THETA)).reshape(4,4,4,4); E=noise_su(0.034,0.011)\nrho=np.zeros([4]*N,dtype=C); rho[(0,)*N]=1\ndef apply2(U,i,j):\n    global rho\n    res=np.tensordot(U,rho,axes=([2,3],[i,j]))\n    rem=[k for k in range(N) if k not in (i,j)]\n    pos=[i,j]+rem\n    perm=[0]*N\n    for idx,p in enumerate(pos): perm[p]=idx\n    rho=np.transpose(res,perm)\ndef apply1(M,i):\n    global rho\n    res=np.tensordot(M,rho,axes=([1],[i]))\n    rem=[k for k in range(N) if k\"'!=i]\n    pos=[i]+rem\n    perm=[0]*N\n    for idx,p in enumerate(pos): perm[p]=idx\n    rho=np.transpose(res,perm)\nfor i,j in even:\n    apply2(R,i,j); apply1(E,i); apply1(E,j)\nfor i,j in odd:\n    apply2(R,i,j); apply1(E,i); apply1(E,j)\nw=np.array([1,0,0,-1],dtype=C)\npar=w.copy()\nfor _ in range(N-1): par=np.kron(par,w)\nprint('\"'direct parity', np.dot(np.conj(par),rho.reshape(-1)))\n# dm circuit\nks=[tc.gates.Gate(np.diag(np.array([np.sqrt(1-0.034),np.sqrt(1-0.011)],dtype=C))),tc.gates.Gate(np.array([[0,np.sqrt(0.011)],[0,0]],dtype=C)),tc.gates.Gate(np.array([[0,0],[np.sqrt(0.034),0]],dtype=C))]\nc=tc.DMCircuit(N)\nfor i,j in even:\n    c.rxx(i,j,theta=THETA); c.apply_general_kraus(ks,i); c.apply_general_kraus(ks,j)\nfor i,j in odd:\n    c.rxx(i,j,theta=THETA); c.apply_general_kraus(ks,i); c.apply_general_kraus(ks,j)\nprint('dm parity', float(np.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]))))\nPY\npython /tmp/direct_n4.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
