general_kraus(ks,i); c.apply_general_kraus(ks,j)\nfor i,j in odd:\n    c.rxx(i,j,theta=THETA); c.apply_general_kraus(ks,i); c.apply_general_kraus(ks,j)\nprint('dm parity', float(np.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]))))\nPY\npython /tmp/direct_n4.py\"","aggregated_output":"direct parity (0.6562206589753623+1.3877787807814457e-17j)\ndm parity 0.6595752114043555\n","exit_code":0,"status":"completed"}}
