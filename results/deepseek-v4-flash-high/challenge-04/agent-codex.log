{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/linear1.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy')\nC64=np.complex64\ndef su(M): return np.kron(M.astype(C64),np.conj(M).astype(C64)).astype(C64)\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=C64); k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=C64); k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=C64)\n    return (np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))).astype(C64)\nE=noise_su(0.034,0.011)\nc=tc.MPSCircuit(1,dim=4)\nc.apply_general_gate(tc.gates.Gate(E),0)\nwf=np.array(c.wavefunction())\nprint('wf',wf)\nfor w in [[1,0,0,-1],[1,-1,0,0],[-1,0,0,1]]:\n    obs=tc.MPSCircuit(1,dim=4,tensors=[np.array(w,dtype=C64)[None,:,None]])\n    Iop=np.eye(4,dtype=C64)\n    val=c.expectation((tc.gates.Gate(Iop),[0]), other=obs)\n    print(w, val, 'dot', np.dot(np.conj(w),wf))\nprint('direct Z', 1-2*wf[3].real)\nPY\npython /tmp/linear1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
