{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/scalar_test.py <<'PY'\nimport numpy as np, jax, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax')\n# minimal single qubit noise test with jax scalar vs float\ndef noise_su(p01,p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.array([[a,0],[0,b]],dtype=jnp.complex64); k1=jnp.array([[0,jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64); k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return jnp.kron(k0,jnp.conj(k0))+jnp.kron(k1,jnp.conj(k1))+jnp.kron(k2,jnp.conj(k2))\ndef f(p01,p10):\n    c=tc.MPSCircuit(1,dim=4)\n    c.apply_general_gate(tc.gates.Gate(noise_su(p01,p10)),0)\n    w=jnp.array([1,0,0,-1],dtype=jnp.complex64)\n    obs=tc.MPSCircuit(1,dim=4,tensors=[w[None,:,None]],center_position=0)\n    return c.proj_with_mps(obs)\nr=jnp.array([np.log(0.07/0.93),np.log(0.04/0.96)],dtype=jnp.float32)\np=jax.nn.sigmoid(r)\nprint('p',p,p.dtype)\nfor a,b in [(0.07,0.04),(float(p[0]),float(p[1])),(p[0],p[1])]:\n    print(a,b, f(a,b))\nPY\npython /tmp/scalar_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
