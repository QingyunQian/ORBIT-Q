{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/fulltest.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax')\n\nN=12\nTHETA=0.31\nEVEN=[(i,i+1) for i in range(0,N,2)]\nODD=[(i,i+1) for i in range(1,N-1,2)]\n\ndef make_kraus(p01,p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.array([[a,0],[0,b]],dtype=jnp.complex64)\n    k1=jnp.array([[0,jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64)\n    k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return [tc.gates.Gate(k0), tc.gates.Gate(k1), tc.gates.Gate(k2)]\n\ndef probe(kind,p01,p10):\n    ks=make_kraus(p01,p10)\n    c=tc.DMCircuit(N)\n    if kind==0:  # GHZ\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:  # Bell pairs |01>+|10>\n        for i in range(0,N,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind==2:\n        pass\n    else:  # |+>\n        for i in range(N): c.h(i)\n    for i,j in EVEN:\n        c.rxx(i,j,theta=THETA)\n        c.apply_general_kraus(ks,i)\n        c.apply_general_kraus(ks,j)\n    for i,j in ODD:\n        c.rxx(i,j,theta=THETA)\n        c.apply_general_kraus(ks,i)\n        c.apply_general_kraus(ks,j)\n    vals=[c.expectation((tc.gates.z(),[i])).real for i in range(N)]\n    vals.append(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]).real)\n    return jnp.stack(vals)\n\ndef table(p01,p10):\n    return jnp.stack([probe(k,p01,p10) for k in range(4)])\n\nt=time.time()\nr=table(0.034,0.011)\nprint('elapsed', time.time()-t)\nprint(r)\nprint(r.shape)\nPY\npython /tmp/fulltest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
