{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/rqcheck.py <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('numpy')\ndef su(M): return np.kron(M,np.conj(M))\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=np.complex64); XX=np.kron(X,X)\n    return np.cos(th/2)*np.eye(4,dtype=np.complex64)-1j*np.sin(th/2)*XX\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=np.complex64); k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64); k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))\nE2=np.kron(noise_su(0.034,0.011),noise_su(0.034,0.011)); S=su(rxxu(0.31))\nrho0=np.zeros(16,dtype=np.complex64); rho0[0]=1\nT=(E2@(S@rho0)).reshape(4,4,4,4)  # axes (out1,out2,in1,in2)?? wait\nprint('T',T.shape)\n# For MPS apply_two_site_gate, tensor = ncon with site tensors and gate, resulting shape (left1, out1, out2, right2)? Actually labels [-1,1,2], [2,3,-4], gate[-2,-3,1,3] -> output shape (-1,-2,-3,-4) = left, out1,out2,right.\n# T above from full rho with axes (a,b) etc is not same. skip.\n# Use a random 2x4x3 tensor and apply rq pivot_axis=2\nimport tensorcircuit.mps_base as mb\nA=np.random.randn(2,4,3)+1j*np.random.randn(2,4,3)\nR,Q=tc.cons.backend.rq(A, pivot_axis=2)\nprint('R',R.shape,'Q',Q.shape)\n# product with pivot axis\n# RQ: reshape A (2*4,3), T=R Q. R from rq should (2*4,k), Q(k,3)\nB=np.einsum('ij,jk->ik', R.reshape(R.shape[0]*R.shape[1],R.shape[2]), Q.reshape(Q.shape[0],Q.shape[2]))\nprint('err',np.max(np.abs(B-A.reshape(8,3))))\nprint('R shape after reshape', R.shape, Q.shape)\nPY\npython /tmp/rqcheck.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
