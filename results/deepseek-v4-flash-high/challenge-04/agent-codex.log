{"type":"item.started","item":{"id":"item_143","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/diag_final.py <<'PY'\nimport numpy as np, jax, jax.numpy as jnp, time\nimport solution_4\ncfg={'n_qubits':12,'entangler_angle':0.31,'true_p01':0.034,'true_p10':0.011,'initial_p01':0.070,'initial_p10':0.040,'max_steps':120,'learning_rate':0.04,'probability_absolute_tolerance':2e-4}\nn=cfg['n_qubits']; theta=cfg['entangler_angle']; table=solution_4._make_table(n,theta)\ntarget=jnp.asarray(np.asarray(table(cfg['true_p01'],cfg['true_p10'])))\ndef loss(r):\n    p=jax.nn.sigmoid(r); return jnp.mean((table(p[0],p[1])-target)**2)\nr=jnp.array([np.log(cfg['initial_p01']/(1-cfg['initial_p01'])),np.log(cfg['initial_p10']/(1-cfg['initial_p10']))],dtype=jnp.float64)\nm=jnp.zeros(2,dtype=jnp.float64); v=jnp.zeros(2,dtype=jnp.float64)\nstep=jax.jit(jax.value_and_grad(loss))\nfor t in range(1,121):\n    val,g=step(r)\n    if t in [1,10,20,40,60,80,100,110,120]: print(t,float(val),np.asarray(jax.nn.sigmoid(r)),np.asarray(g))\n    m=0.9*m+0.1*g; v=0.999*v+0.001*g*g\n    r=r-0.04*(m/(1-0.9**t))/(jnp.sqrt(v/(1-0.999**t))+1e-8)\nprint('final loss',float(loss(r)),'p',np.asarray(jax.nn.sigmoid(r)))\nprint('loss true p',float(loss(jnp.array([np.log(0.034/0.966),np.log(0.011/0.989)]))))\nPY\npython /tmp/diag_final.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
