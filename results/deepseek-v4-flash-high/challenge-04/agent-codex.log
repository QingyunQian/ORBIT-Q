{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/two_noise_check.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\ntc.set_backend('jax')\ndef su(M): return jnp.kron(M,jnp.conj(M))\ndef rxxu(th):\n    X=jnp.array([[0,1],[1,0]],dtype=jnp.complex64)\n    XX=jnp.kron(X,X)\n    return jnp.cos(th/2)*jnp.eye(4,dtype=jnp.complex64)-1j*jnp.sin(th/2)*XX\ndef noise_su(p01,p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.array([[a,0],[0,b]],dtype=jnp.complex64)\n    k1=jnp.array([[0,jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64)\n    k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return jnp.kron(k0,jnp.conj(k0))+jnp.kron(k1,jnp.conj(k1))+jnp.kron(k2,jnp.conj(k2))\nE=noise_su(0.034,0.011); S=su(rxxu(0.31))\nE2=jnp.kron(E,E)\nrho0=jnp.zeros(16,dtype=jnp.complex64).at[0].set(1)\nrho=E2@(S@rho0)\nrho=rho.reshape(4,4)\nO0=jnp.kron(jnp.diag(jnp.array([1.,-1.],dtype=jnp.complex64)),jnp.eye(2,dtype=jnp.complex64))\nprint('direct', jnp.trace(O0@rho))\n# mps\nc=tc.MPSCircuit(2,dim=4)\nc.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nc.apply_general_gate(tc.gates.Gate(E),0)\nc.apply_general_gate(tc.gates.Gate(E),1)\nZop=jnp.diag(jnp.array([1.,0.,0.,-1.],dtype=jnp.complex64))\nprint('mps', c.expectation((tc.gates.Gate(Zop),[0])))\n# mps combined E2 as two-site\nc2=tc.MPSCircuit(2,dim=4)\nc2.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nc2.apply_general_gate(tc.gates.Gate(E2.reshape(4,4,4,4)),0,1)\nprint('mps2', c2.expectation((tc.gates.Gate(Zop),[0])))\nPY\npython /tmp/two_noise_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/two_noise_check.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\ntc.set_backend('jax')\ndef su(M): return jnp.kron(M,jnp.conj(M))\ndef rxxu(th):\n    X=jnp.array([[0,1],[1,0]],dtype=jnp.complex64)\n    XX=jnp.kron(X,X)\n    return jnp.cos(th/2)*jnp.eye(4,dtype=jnp.complex64)-1j*jnp.sin(th/2)*XX\ndef noise_su(p01,p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.array([[a,0],[0,b]],dtype=jnp.complex64)\n    k1=jnp.array([[0,jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64)\n    k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return jnp.kron(k0,jnp.conj(k0))+jnp.kron(k1,jnp.conj(k1))+jnp.kron(k2,jnp.conj(k2))\nE=noise_su(0.034,0.011); S=su(rxxu(0.31))\nE2=jnp.kron(E,E)\nrho0=jnp.zeros(16,dtype=jnp.complex64).at[0].set(1)\nrho=E2@(S@rho0)\nrho=rho.reshape(4,4)\nO0=jnp.kron(jnp.diag(jnp.array([1.,-1.],dtype=jnp.complex64)),jnp.eye(2,dtype=jnp.complex64))\nprint('direct', jnp.trace(O0@rho))\n# mps\nc=tc.MPSCircuit(2,dim=4)\nc.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nc.apply_general_gate(tc.gates.Gate(E),0)\nc.apply_general_gate(tc.gates.Gate(E),1)\nZop=jnp.diag(jnp.array([1.,0.,0.,-1.],dtype=jnp.complex64))\nprint('mps', c.expectation((tc.gates.Gate(Zop),[0])))\n# mps combined E2 as two-site\nc2=tc.MPSCircuit(2,dim=4)\nc2.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nc2.apply_general_gate(tc.gates.Gate(E2.reshape(4,4,4,4)),0,1)\nprint('mps2', c2.expectation((tc.gates.Gate(Zop),[0])))\nPY\npython /tmp/two_noise_check.py\"","aggregated_output":"direct (0.88647854+0j)\nmps (0.8291756+1.0269657e-10j)\nmps2 (0.8291758+5.586609e-11j)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/two_noise_np.py <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('numpy')\ndef su(M): return np.kron(M,np.conj(M))\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=np.complex64)\n    XX=np.kron(X,X)\n    return np.cos(th/2)*np.eye(4,dtype=np.complex64)-1j*np.sin(th/2)*XX\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=np.complex64)\n    k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64)\n    k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))\nE=noise_su(0.034,0.011); S=su(rxxu(0.31)); E2=np.kron(E,E)\nrho0=np.zeros(16,dtype=np.complex64); rho0[0]=1\nrho=E2@(S@rho0); rho=rho.reshape(4,4)\nO0=np.kron(np.diag(np.array([1.,-1.],dtype=np.complex64)),np.eye(2,dtype=np.complex64))\nprint('direct', np.trace(O0@rho))\nfor order in ['seq','comb']:\n    c=tc.MPSCircuit(2,dim=4)\n    c.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\n    if order=='seq':\n        c.apply_general_gate(tc.gates.Gate(E),0); c.apply_general_gate(tc.gates.Gate(E),1)\n    else:\n        c.apply_general_gate(tc.gates.Gate(E2.reshape(4,4,4,4)),0,1)\n    Zop=np.diag(np.array([1.,0.,0.,-1.],dtype=np.complex64))\n    print(order, c.expectation((tc.gates.Gate(Zop),[0])))\n    print('bonds', c.get_bond_dimensions(), [t.shape for t in c.get_tensors()])\nPY\npython /tmp/two_noise_np.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
