{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/superop_check.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\ntc.set_backend('jax')\nH = jnp.array([[1,1],[1,-1]],dtype=jnp.complex64)/jnp.sqrt(2)\nX = jnp.array([[0,1],[1,0]],dtype=jnp.complex64)\nXX=jnp.kron(X,X)\ndef U(th): return jnp.cos(th/2)*jnp.eye(4,dtype=jnp.complex64)-1j*jnp.sin(th/2)*XX\ndef su(M): return jnp.kron(M,jnp.conj(M))\nS=su(U(0.31)) # 16x16\nrho0=jnp.zeros(16,dtype=jnp.complex64); rho0=rho0.at[0].set(1)\nrhovec=S@rho0\nrho=rhovec.reshape(4,4) # (a0,a1) x (b0,b1)\n# row-major local vec basis a,b; rho index (a,b)\ndef zexp(i):\n    # trace Z_i rho\n    if i==0:\n        O=jnp.kron(Z:=jnp.array([[1,0],[0,-1]],dtype=jnp.complex64), jnp.eye(2,dtype=jnp.complex64))\n    else:\n        O=jnp.kron(jnp.eye(2,dtype=jnp.complex64), jnp.array([[1,0],[0,-1]],dtype=jnp.complex64))\n    return jnp.trace(O@rho)\nprint('direct', zexp(0), zexp(1), 'trace', jnp.trace(rho))\n\n# mps apply custom superop gate\nc=tc.MPSCircuit(2,dim=4)\nc.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nZop=jnp.diag(jnp.array([1.,0.,0.,-1.],dtype=jnp.complex64))\nprint('mps', c.expectation((tc.gates.Gate(Zop),[0])), c.expectation((tc.gates.Gate(Zop),[1])))\nprint('bonds', c.get_bond_dimensions())\nprint('tensors shapes', [t.shape for t in c.get_tensors()])\nprint('rho mps proj maybe')\nPY\npython /tmp/superop_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/superop_check.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\ntc.set_backend('jax')\nH = jnp.array([[1,1],[1,-1]],dtype=jnp.complex64)/jnp.sqrt(2)\nX = jnp.array([[0,1],[1,0]],dtype=jnp.complex64)\nXX=jnp.kron(X,X)\ndef U(th): return jnp.cos(th/2)*jnp.eye(4,dtype=jnp.complex64)-1j*jnp.sin(th/2)*XX\ndef su(M): return jnp.kron(M,jnp.conj(M))\nS=su(U(0.31)) # 16x16\nrho0=jnp.zeros(16,dtype=jnp.complex64); rho0=rho0.at[0].set(1)\nrhovec=S@rho0\nrho=rhovec.reshape(4,4) # (a0,a1) x (b0,b1)\n# row-major local vec basis a,b; rho index (a,b)\ndef zexp(i):\n    # trace Z_i rho\n    if i==0:\n        O=jnp.kron(Z:=jnp.array([[1,0],[0,-1]],dtype=jnp.complex64), jnp.eye(2,dtype=jnp.complex64))\n    else:\n        O=jnp.kron(jnp.eye(2,dtype=jnp.complex64), jnp.array([[1,0],[0,-1]],dtype=jnp.complex64))\n    return jnp.trace(O@rho)\nprint('direct', zexp(0), zexp(1), 'trace', jnp.trace(rho))\n\n# mps apply custom superop gate\nc=tc.MPSCircuit(2,dim=4)\nc.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nZop=jnp.diag(jnp.array([1.,0.,0.,-1.],dtype=jnp.complex64))\nprint('mps', c.expectation((tc.gates.Gate(Zop),[0])), c.expectation((tc.gates.Gate(Zop),[1])))\nprint('bonds', c.get_bond_dimensions())\nprint('tensors shapes', [t.shape for t in c.get_tensors()])\nprint('rho mps proj maybe')\nPY\npython /tmp/superop_check.py\"","aggregated_output":"direct (0.95233357+0j) (0.95233357+0j) trace (1+0j)\nmps (0.95233357+0j) (0.95233345+0j)\nbonds [1, 4, 1]\ntensors shapes [(1, 4, 4), (4, 4, 1)]\nrho mps proj maybe\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/noise_check.py <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\ntc.set_backend('jax')\ndef su(M): return jnp.kron(M,jnp.conj(M))\ndef noise_su(p01,p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.array([[a,0],[0,b]],dtype=jnp.complex64)\n    k1=jnp.array([[0,jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64)\n    k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return jnp.kron(k0,jnp.conj(k0))+jnp.kron(k1,jnp.conj(k1))+jnp.kron(k2,jnp.conj(k2))\nE=noise_su(0.034,0.011)\nrho0=jnp.zeros(4,dtype=jnp.complex64).at[0].set(1)\nrho=E@rho0\nprint('single rho',rho)\nprint('single Z', 1-2*rho[3].real)\nprint('E',E)\n# MPS\nc=tc.MPSCircuit(1,dim=4)\nc.apply_general_gate(tc.gates.Gate(E),0)\nZop=jnp.diag(jnp.array([1.,0.,0.,-1.],dtype=jnp.complex64))\nprint('mps Z', c.expectation((tc.gates.Gate(Zop),[0])))\nPY\npython /tmp/noise_check.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
