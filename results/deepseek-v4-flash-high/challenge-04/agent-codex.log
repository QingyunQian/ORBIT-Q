{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/tctest.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend('numpy')\nprint('backend', tc.cons.backend)\n\ndef make_kraus(p01, p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.diag([a,b]).astype(np.complex64)\n    k1=np.array([[0, np.sqrt(p10)],[0,0]],dtype=np.complex64)\n    k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return [tc.gates.Gate(k0), tc.gates.Gate(k1), tc.gates.Gate(k2)]\n\ndef probe_circ(n=2, theta=0.31, p01=0.034, p11=0.011, init='ghz'):\n    c=tc.DMCircuit(n)\n    if init=='ghz':\n        # ghz on n via hadamard + cnots? just for test\n        pass\n    ks=make_kraus(p01,p11)\n    c.apply_general_kraus(ks,0)\n    c.rxx(0,1,theta=theta)\n    c.apply_general_kraus(ks,1)\n    return c\n\nc=probe_circ()\nprint('nodes',len(c._nodes),'front',len(c._front))\nprint('dm shape', c.densitymatrix().shape)\nprint('exp z0', c.expectation((tc.gates.z(),[0])))\nprint('exp z0z1', c.expectation((tc.gates.z(),[0]),(tc.gates.z(),[1])))\nPY\npython /tmp/tctest.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
