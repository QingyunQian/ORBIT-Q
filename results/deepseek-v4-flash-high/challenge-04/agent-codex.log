{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/tcjax.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax')\nprint('backend', tc.cons.backend)\n\ndef make_kraus(p01, p10):\n    a=jnp.sqrt(1-p01); b=jnp.sqrt(1-p10)\n    k0=jnp.diag(jnp.array([a,b],dtype=jnp.complex64))\n    k1=jnp.array([[0, jnp.sqrt(p10)],[0,0]],dtype=jnp.complex64)\n    k2=jnp.array([[0,0],[jnp.sqrt(p01),0]],dtype=jnp.complex64)\n    return [tc.gates.Gate(k0), tc.gates.Gate(k1), tc.gates.Gate(k2)]\n\ndef f(p):\n    p01,junk=p\n    ks=make_kraus(p01, 0.011)\n    c=tc.DMCircuit(1)\n    c.apply_general_kraus(ks,0)\n    return c.expectation((tc.gates.z(),[0])).real\n\ntry:\n    r=f(jnp.array([0.034,0.011]))\n    print('r',r)\n    g=jax.grad(f)(jnp.array([0.034,0.011]))\n    print('g',g)\nexcept Exception:\n    import traceback; traceback.print_exc()\nPY\npython /tmp/tcjax.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
