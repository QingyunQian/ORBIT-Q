{"type":"item.started","item":{"id":"item_138","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/rxx_compare.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\nR=su(rxxu(0.31)).reshape(4,4,4,4)\nfor N in [2,4]:\n    rho=np.zeros([4]*N,dtype=C); rho[(0,)*N]=1\n    res=np.tensordot(R,rho,axes=([2,3],[0,1]))\n    rem=[k for k in range(N) if k not in (0,1)]\n    perm=[0]*N\n    for idx,p in enumerate([0,1]+rem): perm[p]=idx\n    rho=np.transpose(res,perm)\n    c=tc.DMCircuit(N); c.rxx(0,1,theta=0.31)\n    dm=np.array(c.densitymatrix()).reshape([4]*N)\n    print(N,'err',np.max(np.abs(dm-rho)))\nPY\npython /tmp/rxx_compare.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_138","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/rxx_compare.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\nR=su(rxxu(0.31)).reshape(4,4,4,4)\nfor N in [2,4]:\n    rho=np.zeros([4]*N,dtype=C); rho[(0,)*N]=1\n    res=np.tensordot(R,rho,axes=([2,3],[0,1]))\n    rem=[k for k in range(N) if k not in (0,1)]\n    perm=[0]*N\n    for idx,p in enumerate([0,1]+rem): perm[p]=idx\n    rho=np.transpose(res,perm)\n    c=tc.DMCircuit(N); c.rxx(0,1,theta=0.31)\n    dm=np.array(c.densitymatrix()).reshape([4]*N)\n    print(N,'err',np.max(np.abs(dm-rho)))\nPY\npython /tmp/rxx_compare.py\"","aggregated_output":"2 err 0.0\n4 err 0.15252931822172175\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/rxx_full.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\nR16=su(rxxu(0.31))\nfor N in [2,4]:\n    I4=np.eye(4,dtype=C)\n    Ufull=R16\n    for _ in range(2,N): Ufull=np.kron(Ufull,I4)\n    rho=np.zeros(4**N,dtype=C); rho[0]=1\n    rho=Ufull@rho\n    c=tc.DMCircuit(N); c.rxx(0,1,theta=0.31)\n    dm=np.array(c.densitymatrix()).reshape(-1)\n    print(N,'err',np.max(np.abs(dm-rho)))\n    if N==4:\n        print('nonzero direct',np.nonzero(np.abs(rho)>1e-10)[0])\n        print('nonzero dm',np.nonzero(np.abs(dm)>1e-10)[0])\nPY\npython /tmp/rxx_full.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/rxx_full.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\nR16=su(rxxu(0.31))\nfor N in [2,4]:\n    I4=np.eye(4,dtype=C)\n    Ufull=R16\n    for _ in range(2,N): Ufull=np.kron(Ufull,I4)\n    rho=np.zeros(4**N,dtype=C); rho[0]=1\n    rho=Ufull@rho\n    c=tc.DMCircuit(N); c.rxx(0,1,theta=0.31)\n    dm=np.array(c.densitymatrix()).reshape(-1)\n    print(N,'err',np.max(np.abs(dm-rho)))\n    if N==4:\n        print('nonzero direct',np.nonzero(np.abs(rho)>1e-10)[0])\n        print('nonzero dm',np.nonzero(np.abs(dm)>1e-10)[0])\nPY\npython /tmp/rxx_full.py\"","aggregated_output":"2 err 0.0\n4 err 0.15252931822172175\nnonzero direct [  0  48 192 240]\nnonzero dm [  0  12 192 204]\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/mps_perm.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy'); tc.set_dtype('complex128')\nC=np.complex128\ndef su(M): return np.kron(M.astype(C),np.conj(M).astype(C)).astype(C)\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=C); XX=np.kron(X,X)\n    return (np.cos(th/2)*np.eye(4,dtype=C)-1j*np.sin(th/2)*XX).astype(C)\ndef rxx_mps(th):\n    S=su(rxxu(th))  # 16x16 grouped\n    S=S.reshape([2]*8).transpose(0,2,1,3,4,6,5,7).reshape(4,4,4,4)\n    return S\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=C); k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=C); k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=C)\n    return (np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))).astype(C)\ndef run(N, perm):\n    THETA=0.31; even=[(i,i+1) for i in range(0,N,2)]; odd=[(i,i+1) for i in range(1,N-1,2)]\n    R= (rxx_mps(THETA) if perm else su(rxxu(THETA)).reshape(4,4,4,4)); E=noise_su(0.034,0.011)\n    c=tc.MPSCircuit(N,dim=4)\n    for i,j in even:\n        c.apply_general_gate(tc.gates.Gate(R),i,j); c.apply_general_gate(tc.gates.Gate(E),i); c.apply_general_gate(tc.gates.Gate(E),j)\n    for i,j in odd:\n        c.apply_general_gate(tc.gates.Gate(R),i,j); c.apply_general_gate(tc.gates.Gate(E),i); c.apply_general_gate(tc.gates.Gate(E),j)\n    w=np.array([1,0,0,-1],dtype=C)\n    obs=tc.MPSCircuit(N,dim=4,tensors=[w[None,:,None] for _ in range(N)],center_position=0)\n    return float(np.real(c.proj_with_mps(obs)))\ndef dm(N):\n    THETA=0.31; even=[(i,i+1) for i in range(0,N,2)]; odd=[(i,i+1) for i in range(1,N-1,2)]\n    ks=[tc.gates.Gate(np.diag(np.array([np.sqrt(1-0.034),np.sqrt(1-0.011)],dtype=C))),tc.gates.Gate(np.array([[0,np.sqrt(0.011)],[0,0]],dtype=C)),tc.gates.Gate(np.array([[0,0],[np.sqrt(0.034),0]],dtype=C))]\n    c=tc.DMCircuit(N)\n    for i,j in even:\n        c.rxx(i,j,theta=THETA); c.apply_general_kraus(ks,i); c.apply_general_kraus(ks,j)\n    for i,j in odd:\n        c.rxx(i,j,theta=THETA); c.apply_general_kraus(ks,i); c.apply_general_kraus(ks,j)\n    return float(np.real(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)])))\nfor N in [2,4,6]:\n    print(N,'unperm',run(N,False),'perm',run(N,True),'dm',dm(N))\nPY\npython /tmp/mps_perm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
