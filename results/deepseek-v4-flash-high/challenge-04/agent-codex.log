{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/statematch.py <<'PY'\nimport tensorcircuit as tc, numpy as np\ntc.set_backend('numpy')\ndef su(M): return np.kron(M,np.conj(M))\ndef rxxu(th):\n    X=np.array([[0,1],[1,0]],dtype=np.complex64); XX=np.kron(X,X)\n    return np.cos(th/2)*np.eye(4,dtype=np.complex64)-1j*np.sin(th/2)*XX\ndef noise_su(p01,p10):\n    a=np.sqrt(1-p01); b=np.sqrt(1-p10)\n    k0=np.array([[a,0],[0,b]],dtype=np.complex64); k1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64); k2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return np.kron(k0,np.conj(k0))+np.kron(k1,np.conj(k1))+np.kron(k2,np.conj(k2))\nE2=np.kron(noise_su(0.034,0.011),noise_su(0.034,0.011)); S=su(rxxu(0.31))\nrho0=np.zeros(16,dtype=np.complex64); rho0[0]=1\ndirect=E2@(S@rho0)\nc=tc.MPSCircuit(2,dim=4)\nc.apply_general_gate(tc.gates.Gate(S.reshape(4,4,4,4)),0,1)\nc.apply_general_gate(tc.gates.Gate(E2.reshape(4,4,4,4)),0,1)\nwf=np.array(c.wavefunction()).reshape(-1)\nprint('max err', np.max(np.abs(wf-direct)))\nprint('wf',wf)\nprint('direct',direct)\nprint('bonds',c.get_bond_dimensions())\nPY\npython /tmp/statematch.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
