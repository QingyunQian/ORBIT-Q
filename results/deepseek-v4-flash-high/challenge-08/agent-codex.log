{"type":"item.started","item":{"id":"item_113","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, tensornetwork as tn\nc = tc.Circuit(1)\nc.ry(0, theta=0.3)\nn1, e1 = c._copy()\nn2, e2 = c._copy(conj=True)\nprint(\\\"node1 tensor:\\\", np.asarray(n1[0].tensor))\nprint(\\\"node2 tensor:\\\", np.asarray(n2[0].tensor))\nprint(\\\"conj matches:\\\", np.allclose(np.asarray(n1[0].tensor), np.conj(np.asarray(n2[0].tensor))))\n# full doubled: ket + bra + delta on measurement legs\nnodes = n1 + n2\nd = tn.Node(np.eye(2, dtype=complex))\ntn.connect(d[0], e1[0]); tn.connect(d[1], e2[0])\nnodes.append(d)\nres = tn.contractors.greedy(nodes, ignore_edge_order=True)\nres = res[0] if isinstance(res, list) else res\nprint(\\\"1q doubled:\\\", np.asarray(res.tensor).reshape(-1)[0], \\\"expect 1\\\")\n# 2-qubit check with fixed bits\nc2 = tc.Circuit(2)\nc2.ry(0, theta=0.19); c2.ry(1, theta=0.3)\nc2.rzz(0,1,theta=0.31); c2.rxx(0,1,theta=0.27)\nc2.rx(0, theta=0.17); c2.rx(1, theta=0.22)\nsv = c2.state()\nprobs = np.abs(sv)**2\nimport itertools\nfor bits in itertools.product([0,1], repeat=2):\n    n1, e1 = c2._copy()\n    n2, e2 = c2._copy(conj=True)\n    nodes = n1 + n2\n    for s,(ke,be) in enumerate(zip(e1,e2)):\n        bit = bits[s]\n        proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n        d = tn.Node(proj)\n        tn.connect(d[0], ke); tn.connect(d[1], be)\n        nodes.append(d)\n    res = tn.contractors.greedy(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    z = np.asarray(res.tensor).reshape(-1)[0]\n    idx = bits[0]*2+bits[1]\n    print(bits, \\\"net:\\\", z, \\\"expected:\\\", probs[idx], \\\"diff:\\\", abs(z-probs[idx]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
