{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto3.py <<'PY'\nimport numpy as np, itertools, time\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef site_core(alpha, gamma):\n    # amplitude site core over bond legs (L,R,U,D): shape (b,L,R,U,D)\n    A = ry(alpha) @ rx(gamma)\n    s0 = A[:,0]\n    T = np.einsum('b,l,r,u,d->blrud', s0,\n                  np.eye(2), np.eye(2), np.eye(2), np.eye(2))\n    return T\n\ndef bond_mat_h(t): return rzz(t).reshape(4,4)[0,:].reshape(2,2)  # (xL,xR)\ndef bond_mat_v(t): return rxx(t).reshape(4,4)[0,:].reshape(2,2)  # (xU,xD)\n\ndef make_amp_net(side, alpha, gamma, hb, vb):\n    # returns site cores and bond matrices; bonds identified by ((r,c),dir) dir in 'L','R','U','D'\n    cores = {}\n    for r in range(side):\n        for c in range(side):\n            cores[(r,c)] = site_core(alpha[r,c], gamma[r,c])\n    bonds = {}  # key ((r,c),'L') -> (2,2) matrix acting on bond with left site\n    for (r,c),t in hb.items():\n        M = bond_mat_h(t)  # (x_left, x_right)\n        bonds[((r,c),'R')] = M\n        bonds[((r,c+1),'L')] = M\n    for (r,c),t in vb.items():\n        M = bond_mat_v(t)\n        bonds[((r,c),'D')] = M\n        bonds[((r+1,c),'U')] = M\n    return cores, bonds\n\ndef amplitude(cores, bonds, side, bits):\n    nodes = []\n    for (r,c),T in cores.items():\n        n = tn.Node(T, name=f\\\"s{r}{c}\\\")\n        # attach measurement vector\n        b = bits[r*side+c]\n        v = tn.Node(np.eye(2)[b])\n        tn.connect(v[0], n[0])\n        nodes.append(v)\n        nodes.append(n)\n    for (r,c),d in sorted(bonds.items()):\n        # find nodes and attach matrix node with legs\n        pass\n    return None\n\n# build doubled network directly\ndef build_doubled(side, cores, bonds, fix=None, open_sites=frozenset()):\n    # fix: dict site->bit ; open_sites: sites with ket+bra measurement legs dangling\n    nodes = []\n    ket_nodes = {}; bra_nodes = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T, name=f\\\"k{r}{c}\\\")\n        bnode = tn.Node(np.conj(T), name=f\\\"b{r}{c}\\\")\n        ket_nodes[(r,c)] = k; bra_nodes[(r,c)] = bnode\n        nodes += [k, bnode]\n    # bond tensors (ket and bra share bond values through diagonal)\n    for (r,c),d in sorted(bonds.items()):\n        M = d  # (2,2)\n        kk = np.einsum('ab,ab->abcd', M, np.conj(M))  # (ka,kb,ba,bb)? careful\n        # ket legs (a,b), bra legs (c,d): T[a,b,c,d] = M[a,b]*conj(M)[c,d]\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd, name=f\\\"bd{(r,c)}\\\")\n        # locate which site edge: direction encoded in bonds key; we map via side info below\n        nodes.append(nd)\n        bond_nodes[(r,c)] = nd\n    return nodes\n\n# For clarity, write a purpose-built builder with explicit axis conventions\ndef build_net(side, cores, bonds_h, bonds_v, fix=None, open_sites=frozenset()):\n    # bonds_h[(r,c)] = matrix (xL,xR) for horizontal edge (r,c)-(r,c+1)\n    # bonds_v[(r,c)] = matrix (xU,xD) for vertical edge (r,c)-(r+1,c)\n    nodes = []\n    K = {}; Bc = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T); b = tn.Node(np.conj(T))\n        K[(r,c)] = k; Bc[(r,c)] = b\n        nodes += [k,b]\n    # delta between ket/bra measurement legs\n    for (r,c) in cores:\n        s = r*side+c\n        if fix is not None and s in fix:\n            bit = fix[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj)\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n        elif s in open_sites:\n            pass\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n    # horizontal bonds: site (r,c) R-leg = axis 2; site (r,c+1) L-leg = axis 1\n    for (r,c),M in bonds_h.items():\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][2])    # ket left site R\n        tn.connect(nd[1], K[(r,c+1)][1])  # ket right site L\n        tn.connect(nd[2], Bc[(r,c)][2])   # bra left site R\n        tn.connect(nd[3], Bc[(r,c+1)][1]) # bra right site L\n        nodes.append(nd)\n    for (r,c),M in bonds_v.items():\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][4])    # ket up site D\n        tn.connect(nd[1], K[(r+1,c)][3])  # ket down site U\n        tn.connect(nd[2], Bc[(r,c)][4])\n        tn.connect(nd[3], Bc[(r+1,c)][3])\n        nodes.append(nd)\n    return nodes\n\ndef contract_scalar(nodes, path='greedy'):\n    fn = getattr(tn.contractors, path)\n    res = fn(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\ndef ref_probs(side, alpha, gamma, hb, vb):\n    n = side*side\n    psi = np.zeros(2**n, dtype=complex); psi[0]=1\n    def single(i, M):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes).reshape(-1)\n    def two(i, j, M4):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = M4 @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv).reshape(-1)\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, ry(alpha[r,c]))\n    for r in range(side):\n        for c in range(side-1):\n            two(r*side+c, r*side+c+1, rzz(hb[(r,c)]).reshape(4,4))\n    for r in range(side-1):\n        for c in range(side):\n            two(r*side+c, (r+1)*side+c, rxx(vb[(r,c)]).reshape(4,4))\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, rx(gamma[r,c]))\n    return np.abs(psi)**2\n\ndef get_net_parts(side, alpha, gamma, hb, vb):\n    cores = {}\n    for r in range(side):\n        for c in range(side):\n            cores[(r,c)] = site_core(alpha[r,c], gamma[r,c])\n    bonds_h = {k: bond_mat_h(v) for k,v in hb.items()}\n    bonds_v = {k: bond_mat_v(v) for k,v in vb.items()}\n    return cores, bonds_h, bonds_v\n\nif __name__ == '__main__':\n    for side in (2,3):\n        alpha, gamma, hb, vb = build_angles(side)\n        cores, bonds_h, bonds_v = get_net_parts(side, alpha, gamma, hb, vb)\n        probs = ref_probs(side, alpha, gamma, hb, vb)\n        n = side*side\n        # full bitstring probability check\n        err = 0.0\n        for bits in itertools.product([0,1], repeat=n):\n            fx = {i: bits[i] for i in range(n)}\n            nodes = build_net(side, cores, bonds_h, bonds_v, fix=fx, open_sites=frozenset())\n            z = contract_scalar(nodes)\n            idx = sum(b<<(n-1-k) for k,b in enumerate(bits))\n            err = max(err, abs(z - probs[idx]))\n        print(f\\\"side={side}: max |Z(b)-P(b)| = {err}\\\")\n        # prefix marginals\n        for k in [1,2]:\n            err = 0.0\n            for prefix in itertools.product([0,1], repeat=k):\n                zt = sum(probs[sum((prefix+rest)[j]<<(n-1-j) for j in range(n))]\n                         for rest in itertools.product([0,1], repeat=n-k))\n                fx = {i: prefix[i] for i in range(k)}\n                nodes = build_net(side, cores, bonds_h, bonds_v, fix=fx, open_sites=frozenset())\n                z = contract_scalar(nodes)\n                err = max(err, abs(z - zt))\n            print(f\\\"side={side}: k={k} max |Z(prefix)-marginal| = {err}\\\")\nPY\ncd /tmp && timeout 900 python proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto3.py <<'PY'\nimport numpy as np, itertools, time\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef site_core(alpha, gamma):\n    # amplitude site core over bond legs (L,R,U,D): shape (b,L,R,U,D)\n    A = ry(alpha) @ rx(gamma)\n    s0 = A[:,0]\n    T = np.einsum('b,l,r,u,d->blrud', s0,\n                  np.eye(2), np.eye(2), np.eye(2), np.eye(2))\n    return T\n\ndef bond_mat_h(t): return rzz(t).reshape(4,4)[0,:].reshape(2,2)  # (xL,xR)\ndef bond_mat_v(t): return rxx(t).reshape(4,4)[0,:].reshape(2,2)  # (xU,xD)\n\ndef make_amp_net(side, alpha, gamma, hb, vb):\n    # returns site cores and bond matrices; bonds identified by ((r,c),dir) dir in 'L','R','U','D'\n    cores = {}\n    for r in range(side):\n        for c in range(side):\n            cores[(r,c)] = site_core(alpha[r,c], gamma[r,c])\n    bonds = {}  # key ((r,c),'L') -> (2,2) matrix acting on bond with left site\n    for (r,c),t in hb.items():\n        M = bond_mat_h(t)  # (x_left, x_right)\n        bonds[((r,c),'R')] = M\n        bonds[((r,c+1),'L')] = M\n    for (r,c),t in vb.items():\n        M = bond_mat_v(t)\n        bonds[((r,c),'D')] = M\n        bonds[((r+1,c),'U')] = M\n    return cores, bonds\n\ndef amplitude(cores, bonds, side, bits):\n    nodes = []\n    for (r,c),T in cores.items():\n        n = tn.Node(T, name=f\\\"s{r}{c}\\\")\n        # attach measurement vector\n        b = bits[r*side+c]\n        v = tn.Node(np.eye(2)[b])\n        tn.connect(v[0], n[0])\n        nodes.append(v)\n        nodes.append(n)\n    for (r,c),d in sorted(bonds.items()):\n        # find nodes and attach matrix node with legs\n        pass\n    return None\n\n# build doubled network directly\ndef build_doubled(side, cores, bonds, fix=None, open_sites=frozenset()):\n    # fix: dict site->bit ; open_sites: sites with ket+bra measurement legs dangling\n    nodes = []\n    ket_nodes = {}; bra_nodes = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T, name=f\\\"k{r}{c}\\\")\n        bnode = tn.Node(np.conj(T), name=f\\\"b{r}{c}\\\")\n        ket_nodes[(r,c)] = k; bra_nodes[(r,c)] = bnode\n        nodes += [k, bnode]\n    # bond tensors (ket and bra share bond values through diagonal)\n    for (r,c),d in sorted(bonds.items()):\n        M = d  # (2,2)\n        kk = np.einsum('ab,ab->abcd', M, np.conj(M))  # (ka,kb,ba,bb)? careful\n        # ket legs (a,b), bra legs (c,d): T[a,b,c,d] = M[a,b]*conj(M)[c,d]\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd, name=f\\\"bd{(r,c)}\\\")\n        # locate which site edge: direction encoded in bonds key; we map via side info below\n        nodes.append(nd)\n        bond_nodes[(r,c)] = 