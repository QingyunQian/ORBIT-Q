{"type":"item.started","item":{"id":"item_117","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport proto8 as P, numpy as np, itertools\nside = 3\nalpha, gamma, hb, vb = P.build_angles(side)\nc = P.build_circuit(side, alpha, gamma, hb, vb)\n# grid sites 0..8 row-major; prefix {0..4} (row 0 all + (1,0),(1,1)), next=5\n# future = {5,6,7,8}; boundary (prefix sites adjacent to future):\n# site4 (1,1) adjacent to 5,7; site1 (0,1) adjacent to 4 (in prefix) and... not adjacent to future directly\n# site4 is boundary. site2 (0,2)? adjacent to 5 -> boundary. site1 (0,1) adjacent to 4? and (0,2)? no future direct.\n# Let's compute adjacency: future={5,6,7,8}; prefix={0,1,2,3,4}\n# edges: 0-1,1-2,3-4,4-5, 0-3,1-4,2-5, 5-6,6-7,7-8\n# prefix sites adjacent to future: 4 (to 5), 2 (to 5), 1 (to 4? no, 4 in prefix)... also 0? no.\n# boundary prefix sites: {2,4}. frontier (future adjacent to prefix): {5,6,7,8}? 5 adjacent to 2,4; 6 adjacent to 3? no 3 in prefix\"'! wait 6 (2,0) adjacent to 3 (1,0) -> yes boundary.\n# frontier future sites adjacent to prefix: {5 (adj 2,4), 6 (adj 3), 7 (adj 4), 8 (adj 7 in future only? no adj 4? 7-4 yes, 7-8)}: {5,6,7}\n# So boundary set B = {2,4} ∪ {5,6,7} ∪ {next=5} = {2,4,5,6,7}\ndef Zc(fx):\n    return P.Z(c, fx)\n# Vary interior bit b0 (site 0, not in B) with B fixed\nfor Bvals in itertools.product([0,1], repeat=5):\n    pass\n# quick: fix B config (b2,b4,b5,b6,b7) = (0,0,0,0,0), vary b0,b1,b3 (interior) and compute P(b5=0)\nfixedB = {2:0, 4:0, 5:0, 6:0, 7:0}\nimport collections\nresults = collections.defaultdict(list)\nfor b0 in (0,1):\n    for b1 in (0,1):\n        for b3 in (0,1):\n            fx = dict(fixedB); fx[0]=b0; fx[1]=b1; fx[3]=b3\n            z0 = Zc({**fx, 5:0}); z1 = Zc({**fx, 5:1})\n            results[(b0,b1,b3)].append((z0/(z0+z1)).real)\nfor k,v in results.items():\n    print(\"interior (b0,b1,b3):\", k, \"P(b5=0):\", v[0])\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_117","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport proto8 as P, numpy as np, itertools\nside = 3\nalpha, gamma, hb, vb = P.build_angles(side)\nc = P.build_circuit(side, alpha, gamma, hb, vb)\n# grid sites 0..8 row-major; prefix {0..4} (row 0 all + (1,0),(1,1)), next=5\n# future = {5,6,7,8}; boundary (prefix sites adjacent to future):\n# site4 (1,1) adjacent to 5,7; site1 (0,1) adjacent to 4 (in prefix) and... not adjacent to future directly\n# site4 is boundary. site2 (0,2)? adjacent to 5 -> boundary. site1 (0,1) adjacent to 4? and (0,2)? no future direct.\n# Let's compute adjacency: future={5,6,7,8}; prefix={0,1,2,3,4}\n# edges: 0-1,1-2,3-4,4-5, 0-3,1-4,2-5, 5-6,6-7,7-8\n# prefix sites adjacent to future: 4 (to 5), 2 (to 5), 1 (to 4? no, 4 in prefix)... also 0? no.\n# boundary prefix sites: {2,4}. frontier (future adjacent to prefix): {5,6,7,8}? 5 adjacent to 2,4; 6 adjacent to 3? no 3 in prefix\"'! wait 6 (2,0) adjacent to 3 (1,0) -> yes boundary.\n# frontier future sites adjacent to prefix: {5 (adj 2,4), 6 (adj 3), 7 (adj 4), 8 (adj 7 in future only? no adj 4? 7-4 yes, 7-8)}: {5,6,7}\n# So boundary set B = {2,4} ∪ {5,6,7} ∪ {next=5} = {2,4,5,6,7}\ndef Zc(fx):\n    return P.Z(c, fx)\n# Vary interior bit b0 (site 0, not in B) with B fixed\nfor Bvals in itertools.product([0,1], repeat=5):\n    pass\n# quick: fix B config (b2,b4,b5,b6,b7) = (0,0,0,0,0), vary b0,b1,b3 (interior) and compute P(b5=0)\nfixedB = {2:0, 4:0, 5:0, 6:0, 7:0}\nimport collections\nresults = collections.defaultdict(list)\nfor b0 in (0,1):\n    for b1 in (0,1):\n        for b3 in (0,1):\n            fx = dict(fixedB); fx[0]=b0; fx[1]=b1; fx[3]=b3\n            z0 = Zc({**fx, 5:0}); z1 = Zc({**fx, 5:1})\n            results[(b0,b1,b3)].append((z0/(z0+z1)).real)\nfor k,v in results.items():\n    print(\"interior (b0,b1,b3):\", k, \"P(b5=0):\", v[0])\nPY'","aggregated_output":"interior (b0,b1,b3): (0, 0, 0) P(b5=0): 0.9628006434445147\ninterior (b0,b1,b3): (0, 0, 1) P(b5=0): 0.9632588981221053\ninterior (b0,b1,b3): (0, 1, 0) P(b5=0): 0.9579594148346283\ninterior (b0,b1,b3): (0, 1, 1) P(b5=0): 0.9550666512845217\ninterior (b0,b1,b3): (1, 0, 0) P(b5=0): 0.9629021742770738\ninterior (b0,b1,b3): (1, 0, 1) P(b5=0): 0.9628416687708783\ninterior (b0,b1,b3): (1, 1, 0) P(b5=0): 0.9638843519495222\ninterior (b0,b1,b3): (1, 1, 1) P(b5=0): 0.9596328382448114\n","exit_code":0,"status":"completed"}}
