{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import quantum as tq\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    # exp(-i t X X /2): block in {00,11} and {01,10}\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef site_tensor(alpha, gamma, rzzL, rzzR, rzzU, rzzD, rxxL, rxxR, rxxU, rxxD):\n    # returns tensor shape (b, left, right, up, down)\n    A = ry(alpha) @ rx(gamma)  # column b <- column in\n    out = np.zeros((2,2,2,2,2), dtype=complex)\n    for b in range(2):\n        for s in range(2):\n            val = A[b, s]\n            if val == 0: continue\n            for L in range(2):\n                for R in range(2):\n                    for U in range(2):\n                        for D in range(2):\n                            out[b,L,R,U,D] += val*rzzL[0,L]*rzzR[0,R]*rzzU[0,U]*rzzD[0,D]*rxxL[0,L]*rxxR[0,R]*rxxU[0,U]*rxxD[0,D]\n    return out\n\n# Validate on 2x2 grid\nside = 2\nalpha = 0.19 + 0.07*np.sin(0.83*(np.arange(side)+1))[:,None] + 0.05*np.cos(0.61*(np.arange(side)+1))[None,:] + 0.03*np.sin(0.29*(np.arange(side)[:,None]+np.arange(side)[None,:]+2))\ngamma = 0.17 + 0.06*np.cos(0.52*(np.arange(side)+1))[:,None] - 0.04*np.sin(0.44*(np.arange(side)+1))[None,:] + 0.02*np.cos(0.25*(np.arange(side)[:,None]+np.arange(side)[None,:]+2))\n\ndef beta_h(r,c,kh): return 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1))\ndef beta_v(r,c,kv): return 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1))\n\nkh = 0; kv = 0\nT = {}\nfor r in range(side):\n    for c in range(side):\n        rzzL = np.eye(2) if c==0 else rzz(beta_h(r,c-1,kh-1)) if False else None\n        # compute h bond to left: edge (r,c-1)->(r,c) with its kh\n        pass\n\n# easier: collect angles\nh_edges = []\nfor r in range(side):\n    for c in range(side-1):\n        h_edges.append((r,c,beta_h(r,c,kh))); kh+=1\nv_edges = []\nfor r in range(side-1):\n    for c in range(side):\n        v_edges.append((r,c,beta_v(r,c,kv))); kv+=1\n\n# build brute force state\nn = side*side\npsi = np.zeros(2**n, dtype=complex)\npsi[0] = 1\ndef apply_single(i, M):\n    global psi\n    psi = psi.reshape(-1, 2, 2**(n-i-1))\n    psi = np.einsum('ab,ijk->aijbk' if False else 'ab,...b->...a', M, psi)\n    psi = psi.reshape(-1)\napply_single.__globals__['psi'] = psi\npsi = psi.reshape([2]*n)\nfor r in range(side):\n    for c in range(side):\n        i = r*side+c\n        M = ry(alpha[r,c])\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes)\npsi = psi.reshape(-1)\ndef apply_two(i, j, M4):\n    global psi\n    psi = psi.reshape([2]*n)\n    # move i,j to front\n    perm = [i,j] + [k for k in range(n) if k not in (i,j)]\n    psi = np.transpose(psi, perm)\n    psi = psi.reshape(4, 2**(n-2))\n    psi = M4 @ psi\n    psi = psi.reshape([2]*n)\n    inv = [0]*n\n    for k,x in enumerate(perm): inv[x]=k\n    psi = np.transpose(psi, inv)\n    psi = psi.reshape(-1)\nfor (r,c,t) in h_edges:\n    apply_two(r*side+c, r*side+c+1, rzz(t).reshape(4,4))\nfor (r,c,t) in v_edges:\n    apply_two(r*side+c, (r+1)*side+c, rxx(t).reshape(4,4))\nfor r in range(side):\n    for c in range(side):\n        i = r*side+c\n        M = rx(gamma[r,c])\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi.reshape([2]*n), axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes)\npsi = psi.reshape(-1)\nprobs = np.abs(psi)**2\nprint(\\\"brute force probs sum:\\\", probs.sum())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import quantum as tq\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    # exp(-i t X X /2): block in {00,11} and {01,10}\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef site_tensor(alpha, gamma, rzzL, rzzR, rzzU, rzzD, rxxL, rxxR, rxxU, rxxD):\n    # returns tensor shape (b, left, right, up, down)\n    A = ry(alpha) @ rx(gamma)  # column b <- column in\n    out = np.zeros((2,2,2,2,2), dtype=complex)\n    for b in range(2):\n        for s in range(2):\n            val = A[b, s]\n            if val == 0: continue\n            for L in range(2):\n                for R in range(2):\n                    for U in range(2):\n                        for D in range(2):\n                            out[b,L,R,U,D] += val*rzzL[0,L]*rzzR[0,R]*rzzU[0,U]*rzzD[0,D]*rxxL[0,L]*rxxR[0,R]*rxxU[0,U]*rxxD[0,D]\n    return out\n\n# Validate on 2x2 grid\nside = 2\nalpha = 0.19 + 0.07*np.sin(0.83*(np.arange(side)+1))[:,None] + 0.05*np.cos(0.61*(np.arange(side)+1))[None,:] + 0.03*np.sin(0.29*(np.arange(side)[:,None]+np.arange(side)[None,:]+2))\ngamma = 0.17 + 0.06*np.cos(0.52*(np.arange(side)+1))[:,None] - 0.04*np.sin(0.44*(np.arange(side)+1))[None,:] + 0.02*np.cos(0.25*(np.arange(side)[:,None]+np.arange(side)[None,:]+2))\n\ndef beta_h(r,c,kh): return 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1))\ndef beta_v(r,c,kv): return 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1))\n\nkh = 0; kv = 0\nT = {}\nfor r in range(side):\n    for c in range(side):\n        rzzL = np.eye(2) if c==0 else rzz(beta_h(r,c-1,kh-1)) if False else None\n        # compute h bond to left: edge (r,c-1)->(r,c) with its kh\n        pass\n\n# easier: collect angles\nh_edges = []\nfor r in range(side):\n    for c in range(side-1):\n        h_edges.append((r,c,beta_h(r,c,kh))); kh+=1\nv_edges = []\nfor r in range(side-1):\n    for c in range(side):\n        v_edges.append((r,c,beta_v(r,c,kv))); kv+=1\n\n# build brute force state\nn = side*side\npsi = np.zeros(2**n, dtype=complex)\npsi[0] = 1\ndef apply_single(i, M):\n    global psi\n    psi = psi.reshape(-1, 2, 2**(n-i-1))\n    psi = np.einsum('ab,ijk->aijbk' if False else 'ab,...b->...a', M, psi)\n    psi = psi.reshape(-1)\napply_single.__globals__['psi'] = psi\npsi = psi.reshape([2]*n)\nfor r in range(side):\n    for c in range(side):\n        i = r*side+c\n        M = ry(alpha[r,c])\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes)\npsi = psi.reshape(-1)\ndef apply_two(i, j, M4):\n    global psi\n    psi = psi.reshape([2]*n)\n    # move i,j to front\n    perm = [i,j] + [k for k in range(n) if k not in (i,j)]\n    psi = np.transpose(psi, perm)\n    psi = psi.reshape(4, 2**(n-2))\n    psi = M4 @ psi\n    psi = psi.reshape([2]*n)\n    inv = [0]*n\n    for k,x in enumerate(perm): inv[x]=k\n    psi = np.transpose(psi, inv)\n    psi = psi.reshape(-1)\nfor (r,c,t) in h_edges:\n    apply_two(r*side+c, r*side+c+1, rzz(t).reshape(4,4))\nfor (r,c,t) in v_edges:\n    apply_two(r*side+c, (r+1)*side+c, rxx(t).reshape(4,4))\nfor r in range(side):\n    for c in range(side):\n        i = r*side+c\n        M = rx(gamma[r,c])\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi.reshape([2]*n), axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes)\npsi = psi.reshape(-1)\nprobs = np.abs(psi)**2\nprint(\\\"brute force probs sum:\\\", probs.sum())\nPY\"","aggregated_output":"brute force probs sum: 0.9999999999999999\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nfrom tensorcircuit import quantum as tq\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0\n    hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef site_core(alpha, gamma, hleft, hright, vup, vdown):\n    A = ry(alpha) @ rx(gamma)   # (b, s)\n    T = np.zeros((2,2,2,2,2), dtype=complex)\n    for b in range(2):\n        for s in range(2):\n            v = A[b,s]\n            if v == 0: continue\n            T[b] += v*np.einsum('l,r,u,d->lr u d'.replace(' ',''), hleft[0,:,None]*1, hright[0,None,:]*1, vup[0,:,None]*1, vdown[0,None,:]*1) if False else v*np.einsum('l,r,u,d->lrud', hleft[0,:], hright[0,:], vup[0,:], vdown[0,:])\n    return T\n\ndef site_core2(alpha, gamma, hleft, hright, vup, vdown):\n    A = ry(alpha) @ rx(gamma)\n    # outer product of row-0 vectors\n    outer = np.einsum('l,r,u,d->lrud', hleft[0,:], hright[0,:], vup[0,:], vdown[0,:])\n    return np.einsum('bs,s,lrud->blrud', A, np.array([1,0]), outer)\n\ndef build_amp_network(side, alpha, gamma, hb, vb):\n    nodes = {}\n    for r in range(side):\n        for c in range(side):\n            hleft = np.eye(2) if c==0 else rzz(hb[(r,c-1)])\n            hright = np.eye(2) if c==side-1 else rzz(hb[(r,c)])\n            vup = np.eye(2) if r==0 else rxx(vb[(r-1,c)])\n            vdown = np.eye(2) if r==side-1 else rxx(vb[(r,c)])\n            T = site_core2(alpha[r,c], gamma[r,c], hleft, hright, vup, vdown)\n            nodes[(r,c)] = tn.Node(T, name=f\\\"site{r}{c}\\\")\n    # connect bonds: leg order (b, L, R, U, D)\n    for r in range(side):\n        for c in range(side):\n            if c+1 < side:\n                tn.connect(nodes[(r,c)][2], nodes[(r,c+1)][1])  # R of left -> L of right\n            if r+1 < side:\n                tn.connect(nodes[(r,c)][4], nodes[(r+1,c)][3])  # D -> U\n    return nodes\n\ndef amplitude(nodes, side, bits):\n    ns = [n.copy() for n in nodes.values()]\n    # fix measurement legs to bits: contract with one-hot vector\n    for (r,c),b in zip(sorted(nodes), bits):\n        v = np.eye(2)[b]\n        # attach vector to axis 0\n        tn.contract_between(tn.Node(v), ns[r*side+c], name=\\\"m\\\")\n    return tn.contractors.greedy(ns)\n\n# test 2x2\nside = 2\nalpha, gamma, hb, vb = build_angles(side)\nnodes = build_amp_network(side, alpha, gamma, hb, vb)\n\n# brute force\nn = side*side\ndef apply_single_mat(psi, i, M):\n    shp = psi.shape\n    psi = psi.reshape([2]*n)\n    axes = list(range(n)); axes[0]=i; axes[i]=0\n    psi = np.transpose(psi, axes)\n    psi = np.tensordot(M, psi, axes=([1],[0]))\n    psi = np.transpose(psi, axes)\n    return psi.reshape(shp)\npsi = np.zeros(2**n, dtype=complex); psi[0]=1\npsi = psi.reshape([2]*n)\nfor r in range(side):\n    for c in range(side):\n        psi = apply_single_mat(psi, r*side+c, ry(alpha[r,c]))\npsi = psi.reshape(-1)\nfor r in range(side):\n    for c in range(side-1):\n        psi = apply_single_mat(psi.reshape([2]*n), r*side+c, np.eye(2)); psi=psi.reshape(-1)\n        # two-qubit gate\n        i, j = r*side+c, r*side+c+1\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = rzz(hb[(r,c)]).reshape(4,4) @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv)\n        psi = psi.reshape(-1)\nfor r in range(side-1):\n    for c in range(side):\n        i, j = r*side+c, (r+1)*side+c\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = rxx(vb[(r,c)]).reshape(4,4) @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv)\n        psi = psi.reshape(-1)\nfor r in range(side):\n    for c in range(side):\n        psi = apply_single_mat(psi.reshape([2]*n), r*side+c, rx(gamma[r,c])); psi=psi.reshape(-1)\npsi = psi.reshape(-1)\n\nimport itertools\nerr = 0\nfor bits in itertools.product([0,1], repeat=n):\n    a_net = amplitude(nodes, side, bits)\n    a_ref = psi[sum(b<<(n-1-k) for k,b in enumerate(bits))]\n    err = max(err, abs(a_net - a_ref))\nprint(\\\"max amp error:\\\", err)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
