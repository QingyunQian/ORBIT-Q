{"type":"item.started","item":{"id":"item_152","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && timeout 300 python - <<'PY'\nimport numpy as np, time, sys\nsys.path.insert(0,'/tmp')\nimport proto8 as P\nimport tensorcircuit as tc\n\nside = 7\nalpha, gamma, hb, vb = P.build_angles(side)\nc = tc.MPSCircuit(side*side)\nfor r in range(side):\n    for cc in range(side):\n        c.ry(r*side+cc, theta=alpha[r,cc])\nfor r in range(side):\n    for cc in range(side-1):\n        c.rzz(r*side+cc, r*side+cc+1, theta=hb[(r,cc)])\nfor r in range(side-1):\n    for cc in range(side):\n        c.rxx(r*side+cc, (r+1)*side+cc, theta=vb[(r,cc)])\nfor r in range(side):\n    for cc in range(side):\n        c.rx(r*side+cc, theta=gamma[r,cc])\n# inspect MPS tensors shapes\ntensors = c._mps.tensors\nprint(\\\"num tensors:\\\", len(tensors))\nprint(\\\"shapes:\\\", [t.shape for t in tensors])\n# norm check\nprint(\\\"norm:\\\", c.get_norm() if hasattr(c,'get_norm') else 'n/a')\n# measure timing of a single measure with position\nimport time\nc2 = c.copy()\nt0=time.time()\nfor site in range(49):\n    c2.position(site)\n    t = c2._mps.tensors[site]\nprint(\\\"49 positions on copy:\\\", time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
