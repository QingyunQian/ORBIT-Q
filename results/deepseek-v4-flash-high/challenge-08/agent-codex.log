{"type":"item.completed","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,125p' /tmp/proto3.py\"","aggregated_output":"        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd, name=f\"bd{(r,c)}\")\n        # locate which site edge: direction encoded in bonds key; we map via side info below\n        nodes.append(nd)\n        bond_nodes[(r,c)] = nd\n    return nodes\n\n# For clarity, write a purpose-built builder with explicit axis conventions\ndef build_net(side, cores, bonds_h, bonds_v, fix=None, open_sites=frozenset()):\n    # bonds_h[(r,c)] = matrix (xL,xR) for horizontal edge (r,c)-(r,c+1)\n    # bonds_v[(r,c)] = matrix (xU,xD) for vertical edge (r,c)-(r+1,c)\n    nodes = []\n    K = {}; Bc = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T); b = tn.Node(np.conj(T))\n        K[(r,c)] = k; Bc[(r,c)] = b\n        nodes += [k,b]\n    # delta between ket/bra measurement legs\n    for (r,c) in cores:\n        s = r*side+c\n        if fix is not None and s in fix:\n            bit = fix[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj)\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n        elif s in open_sites:\n            pass\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n    # horizontal bonds: site (r,c) R-leg = axis 2; site (r,c+1) L-leg = axis 1\n    for (r,c),M in bonds_h.items():\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][2])    # ket left site R\n        tn.connect(nd[1], K[(r,c+1)][1])  # ket right site L\n        tn.connect(nd[2], Bc[(r,c)][2])   # bra left site R\n        tn.connect(nd[3], Bc[(r,c+1)][1]) # bra right site L\n        nodes.append(nd)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport proto3 as P, numpy as np, tensornetwork as tn\nside=2\nalpha, gamma, hb, vb = P.build_angles(side)\ncores, bonds_h, bonds_v = P.get_net_parts(side, alpha, gamma, hb, vb)\nfx = {i:0 for i in range(4)}\nnodes = P.build_net(side, cores, bonds_h, bonds_v, fix=fx, open_sites=frozenset())\n# give nodes distinct names for debugging by rebuilding\ndef build_named(side, cores, bonds_h, bonds_v, fix):\n    nodes=[]; K={}; Bc={}\n    for (r,c),T in cores.items():\n        k=tn.Node(T,name=f\\\"K{r}{c}\\\"); b=tn.Node(np.conj(T),name=f\\\"B{r}{c}\\\")\n        K[(r,c)]=k; Bc[(r,c)]=b; nodes+=[k,b]\n    for (r,c) in cores:\n        s=r*side+c\n        if fix is not None and s in fix:\n            bit=fix[s]; proj=np.zeros((2,2),complex); proj[bit,bit]=1\n            d=tn.Node(proj,name=f\\\"P{s}\\\"); tn.connect(d[0],K[(r,c)][0]); tn.connect(d[1],Bc[(r,c)][0]); nodes.append(d)\n        else:\n            d=tn.Node(np.eye(2,complex),name=f\\\"D{s}\\\"); tn.connect(d[0],K[(r,c)][0]); tn.connect(d[1],Bc[(r,c)][0]); nodes.append(d)\n    for (r,c),M in bonds_h.items():\n        Tbd=np.einsum('ab,cd->abcd',M,np.conj(M))\n        nd=tn.Node(Tbd,name=f\\\"H{r}{c}\\\")\n        tn.connect(nd[0],K[(r,c)][2]); tn.connect(nd[1],K[(r,c+1)][1])\n        tn.connect(nd[2],Bc[(r,c)][2]); tn.connect(nd[3],Bc[(r,c+1)][1])\n        nodes.append(nd)\n    for (r,c),M in bonds_v.items():\n        Tbd=np.einsum('ab,cd->abcd',M,np.conj(M))\n        nd=tn.Node(Tbd,name=f\\\"V{r}{c}\\\")\n        tn.connect(nd[0],K[(r,c)][4]); tn.connect(nd[1],K[(r+1,c)][3])\n        tn.connect(nd[2],Bc[(r,c)][4]); tn.connect(nd[3],Bc[(r+1,c)][3])\n        nodes.append(nd)\n    return nodes\nnodes = build_named(side, cores, bonds_h, bonds_v, fx)\nfor nd in nodes:\n    if nd.name.startswith('K'):\n        print(nd.name, [(e.is_dangling()) for e in nd.edges])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
