{"type":"item.started","item":{"id":"item_148","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && timeout 600 python - <<'PY'\nimport numpy as np, time, sys\nsys.path.insert(0,'/tmp')\nimport proto8 as P\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\nside = 7\nalpha, gamma, hb, vb = P.build_angles(side)\nc = P.build_circuit(side, alpha, gamma, hb, vb)\n\ndef doubled_nodes(c, fixed):\n    nodes, e_ket = c._copy()\n    bn, e_bra = c._copy(conj=True)\n    alln = nodes + bn\n    for s,(ke,be) in enumerate(zip(e_ket, e_bra)):\n        if s in fixed:\n            bit = fixed[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj); tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n    return alln\n\nrng = np.random.default_rng(1)\nfor k in [0, 7, 20, 40, 48]:\n    fixed = {i: int(rng.integers(2)) for i in range(k)}\n    nodes = doubled_nodes(c, fixed)\n    t0=time.time()\n    res = tc.cons.contractor.func(nodes, tc.cons.contractor.keywords['optimizer'],\n                                  ignore_edge_order=True, preprocessing=True)\n    t1=time.time()\n    res = res[0] if isinstance(res, list) else res\n    print(f\\\"k={k}: {t1-t0:.3f}s\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
