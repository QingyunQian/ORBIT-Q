{"type":"item.started","item":{"id":"item_119","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench7.py <<'PY'\nimport numpy as np, time\nimport tensorcircuit as tc\nimport tensornetwork as tn\nimport sys\nsys.path.insert(0, '/tmp')\nimport proto8 as P\n\nside = 7\nalpha, gamma, hb, vb = P.build_angles(side)\nc = P.build_circuit(side, alpha, gamma, hb, vb)\nprint(\\\"circuit built; nodes:\\\", len(c._nodes))\n\ndef doubled_nodes(c, fixed, open_sites):\n    nodes, e_ket = c._copy()\n    bn, e_bra = c._copy(conj=True)\n    alln = nodes + bn\n    open_edges = {}\n    for s,(ke,be) in enumerate(zip(e_ket, e_bra)):\n        if s in fixed:\n            bit = fixed[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj)\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n        elif s in open_sites:\n            open_edges[s] = (ke, be)\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n    return alln, open_edges\n\nrng = np.random.default_rng(0)\n# benchmark: fixed = first k bits random\nfor k in [0, 5, 20, 40, 48]:\n    fixed = {i: int(rng.integers(2)) for i in range(k)}\n    t0 = time.time()\n    nodes, _ = doubled_nodes(c, fixed, frozenset())\n    t1 = time.time()\n    res = tn.contractors.greedy(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    t2 = time.time()\n    print(f\\\"k={k}: build {t1-t0:.3f}s, contract {t2-t1:.3f}s, val {np.asarray(res.tensor).reshape(-1)[0]:.6f}\\\")\nPY\ncd /tmp && timeout 900 python bench7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
