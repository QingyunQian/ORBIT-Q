{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport proto4 as P, numpy as np, tensornetwork as tn\n# 1x1 check\nside=1\nalpha, gamma, hb, vb = P.build_angles(side)\ncores = {(r,c): P.site_core(alpha[r,c], gamma[r,c]) for r in range(side) for c in range(side)}\nprobs = P.ref_probs(side, alpha, gamma, hb, vb)\nfor b in (0,1):\n    nodes, oe = P.build_doubled_nodes(side, cores, hb, vb, fixed={0:b}, open_sites=frozenset())\n    z = P.contract_all(nodes)\n    print(\\\"b:\\\", b, \\\"net:\\\", z, \\\"ref:\\\", probs[b])\n# 2x2: check amplitude network alone vs reference amplitudes\nside=2\nalpha, gamma, hb, vb = P.build_angles(side)\ncores = {(r,c): P.site_core(alpha[r,c], gamma[r,c]) for r in range(side) for c in range(side)}\npsi = np.zeros(4, dtype=complex)\n# build amplitude network: site cores + bond mats + measure\ndef amp_net(bits):\n    nodes=[]\n    K={}\n    for (r,c),T in cores.items():\n        n=tn.Node(T); K[(r,c)]=n; nodes.append(n)\n        v=tn.Node(np.eye(2)[bits[r*side+c]])\n        tn.connect(v[0], n[0]); nodes.append(v)\n    for (r,c) in hb:\n        M = P.rzz(hb[(r,c)]).reshape(4,4)[0,:].reshape(2,2)\n        nd = tn.Node(M)\n        tn.connect(nd[0], K[(r,c)][2]); tn.connect(nd[1], K[(r,c+1)][1])\n        nodes.append(nd)\n    for (r,c) in vb:\n        M = P.rxx(vb[(r,c)]).reshape(4,4)[0,:].reshape(2,2)\n        nd = tn.Node(M)\n        tn.connect(nd[0], K[(r,c)][4]); tn.connect(nd[1], K[(r+1,c)][3])\n        nodes.append(nd)\n    zero = np.array([1.0+0j,0j])\n    for (r,c) in cores:\n        for leg, present in [(1,(r,c-1) in hb),(2,(r,c) in hb),(3,(r-1,c) in vb),(4,(r,c) in vb)]:\n            if not present:\n                v=tn.Node(zero); tn.connect(v[0], K[(r,c)][leg]); nodes.append(v)\n    res = tn.contractors.greedy(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor).reshape(-1)[0]\nimport itertools\nref_psi = np.zeros(4, dtype=complex)\n# brute amplitude from full circuit: replicate ref_probs but keep amplitudes\nn=4\npsi0 = np.zeros(2**n, dtype=complex); psi0[0]=1\ndef single(i, M):\n    nonlocal psi0\n    psi0 = psi0.reshape([2]*n)\n    axes = list(range(n)); axes[0]=i; axes[i]=0\n    psi0 = np.transpose(psi0, axes)\n    psi0 = np.tensordot(M, psi0, axes=([1],[0]))\n    psi0 = np.transpose(psi0, axes).reshape(-1)\ndef two(i, j, M4):\n    nonlocal psi0\n    psi0 = psi0.reshape([2]*n)\n    perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n    psi0 = np.transpose(psi0, perm).reshape(4, 2**(n-2))\n    psi0 = M4 @ psi0\n    psi0 = psi0.reshape([2]*n)\n    inv = [0]*n\n    for k,x in enumerate(perm): inv[x]=k\n    psi0 = np.transpose(psi0, inv).reshape(-1)\nfor r in range(side):\n    for c in range(side):\n        single(r*side+c, P.ry(alpha[r,c]))\nfor r in range(side):\n    for c in range(side-1):\n        two(r*side+c, r*side+c+1, P.rzz(hb[(r,c)]).reshape(4,4))\nfor r in range(side-1):\n    for c in range(side):\n        two(r*side+c, (r+1)*side+c, P.rxx(vb[(r,c)]).reshape(4,4))\nfor r in range(side):\n    for c in range(side):\n        single(r*side+c, P.rx(gamma[r,c]))\nerr=0\nfor bits in itertools.product([0,1], repeat=4):\n    a1 = amp_net(bits)\n    idx = sum(b<<(3-k) for k,b in enumerate(bits))\n    err = max(err, abs(a1 - psi0[idx]))\nprint(\\\"amp network max err:\\\", err)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
