{"type":"item.completed","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"sed -n '55,135p' /tmp/proto3.py\"","aggregated_output":"def amplitude(cores, bonds, side, bits):\n    nodes = []\n    for (r,c),T in cores.items():\n        n = tn.Node(T, name=f\"s{r}{c}\")\n        # attach measurement vector\n        b = bits[r*side+c]\n        v = tn.Node(np.eye(2)[b])\n        tn.connect(v[0], n[0])\n        nodes.append(v)\n        nodes.append(n)\n    for (r,c),d in sorted(bonds.items()):\n        # find nodes and attach matrix node with legs\n        pass\n    return None\n\n# build doubled network directly\ndef build_doubled(side, cores, bonds, fix=None, open_sites=frozenset()):\n    # fix: dict site->bit ; open_sites: sites with ket+bra measurement legs dangling\n    nodes = []\n    ket_nodes = {}; bra_nodes = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T, name=f\"k{r}{c}\")\n        bnode = tn.Node(np.conj(T), name=f\"b{r}{c}\")\n        ket_nodes[(r,c)] = k; bra_nodes[(r,c)] = bnode\n        nodes += [k, bnode]\n    # bond tensors (ket and bra share bond values through diagonal)\n    for (r,c),d in sorted(bonds.items()):\n        M = d  # (2,2)\n        kk = np.einsum('ab,ab->abcd', M, np.conj(M))  # (ka,kb,ba,bb)? careful\n        # ket legs (a,b), bra legs (c,d): T[a,b,c,d] = M[a,b]*conj(M)[c,d]\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd, name=f\"bd{(r,c)}\")\n        # locate which site edge: direction encoded in bonds key; we map via side info below\n        nodes.append(nd)\n        bond_nodes[(r,c)] = nd\n    return nodes\n\n# For clarity, write a purpose-built builder with explicit axis conventions\ndef build_net(side, cores, bonds_h, bonds_v, fix=None, open_sites=frozenset()):\n    # bonds_h[(r,c)] = matrix (xL,xR) for horizontal edge (r,c)-(r,c+1)\n    # bonds_v[(r,c)] = matrix (xU,xD) for vertical edge (r,c)-(r+1,c)\n    nodes = []\n    K = {}; Bc = {}\n    for (r,c),T in cores.items():\n        k = tn.Node(T); b = tn.Node(np.conj(T))\n        K[(r,c)] = k; Bc[(r,c)] = b\n        nodes += [k,b]\n    # delta between ket/bra measurement legs\n    for (r,c) in cores:\n        s = r*side+c\n        if fix is not None and s in fix:\n            bit = fix[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj)\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n        elif s in open_sites:\n            pass\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], Bc[(r,c)][0])\n            nodes.append(d)\n    # horizontal bonds: site (r,c) R-leg = axis 2; site (r,c+1) L-leg = axis 1\n    for (r,c),M in bonds_h.items():\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][2])    # ket left site R\n        tn.connect(nd[1], K[(r,c+1)][1])  # ket right site L\n        tn.connect(nd[2], Bc[(r,c)][2])   # bra left site R\n        tn.connect(nd[3], Bc[(r,c+1)][1]) # bra right site L\n        nodes.append(nd)\n    for (r,c),M in bonds_v.items():\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][4])    # ket up site D\n        tn.connect(nd[1], K[(r+1,c)][3])  # ket down site U\n        tn.connect(nd[2], Bc[(r,c)][4])\n        tn.connect(nd[3], Bc[(r+1,c)][3])\n        nodes.append(nd)\n    return nodes\n\n","exit_code":0,"status":"completed"}}
