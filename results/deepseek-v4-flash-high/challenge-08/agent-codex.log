{"type":"item.completed","item":{"id":"item_52","type":"agent_message","text":"The brute-force validation hit memory issues on 4×4, but the 2×2/3×3 logic is nearly there. Let me write a cleaner, more careful prototype: build the doubled network with measurement projectors, validate marginals vs brute force, and check the frontier-dependency hypothesis."}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto2.py <<'PY'\nimport numpy as np, itertools, time\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef g0(mat4):\n    return mat4.reshape(4,4)[0,:].reshape(2,2)\n\ndef site_core(alpha, gamma, hleft, hright, vup, vdown):\n    A = ry(alpha) @ rx(gamma)\n    s0 = A[:, 0]\n    hL = g0(hleft); hR = g0(hright); vU = g0(vup); vD = g0(vdown)\n    T = np.einsum('b,l,r,u,d->blrud', s0,\n        np.einsum('l,r->lr', hL[:,0], hR[0,:]),\n        np.einsum('l,r->lr', hL[0,:], hR[:,0]),\n        np.einsum('u,d->ud', vU[:,0], vD[0,:]),\n        np.einsum('u,d->ud', vU[0,:], vD[:,0])) if False else None\n    # simpler: build via explicit loops is slow; use einsum with outer products\n    # T[b,L,R,U,D] = s0[b] * hL[L,L]*hR[R,R]*vU[U,U]*vD[D,D]  (shared-bond view)\n    outer = np.einsum('l,r,u,d->lrud', np.diag(hL), np.diag(hR), np.diag(vU), np.diag(vD))\n    return np.einsum('b,lrud->blrud', s0, outer)\n\ndef build_amp_nodes(side, alpha, gamma, hb, vb):\n    nodes = {}\n    for r in range(side):\n        for c in range(side):\n            hleft = rzz(hb.get((r,c-1), 0.0))\n            hright = rzz(hb.get((r,c), 0.0))\n            vup = rxx(vb.get((r-1,c), 0.0))\n            vdown = rxx(vb.get((r,c), 0.0))\n            T = site_core(alpha[r,c], gamma[r,c], hleft, hright, vup, vdown)\n            nodes[(r,c)] = tn.Node(T, name=f\\\"s{r}{c}\\\")\n    for r in range(side):\n        for c in range(side):\n            if c+1 < side:\n                tn.connect(nodes[(r,c)][2], nodes[(r,c+1)][1])\n            if r+1 < side:\n                tn.connect(nodes[(r,c)][4], nodes[(r+1,c)][3])\n    return nodes\n\ndef build_doubled(side, amp_nodes, fixdict=None, open_sites=None):\n    # returns list of nodes representing doubled network with measurement structure.\n    # open_sites: set of sites whose ket/bra measurement legs stay dangling (both).\n    # fixdict: map site->bit for fixed measurement (ket-bra tied to bit).\n    # traced sites: ket-bra tied (delta).\n    nodes = []\n    for (r,c),n in amp_nodes.items():\n        k = n.copy(); b = n.copy()\n        b.set_tensor(np.conj(b.tensor))\n        nodes += [k, b]\n        ket_leg = k[0]; bra_leg = b[0]\n        s = r*side+c\n        if s in (fixdict or {}):\n            bit = fixdict[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj)\n            tn.connect(d[0], ket_leg); tn.connect(d[1], bra_leg)\n            nodes.append(d)\n        elif open_sites is not None and s in open_sites:\n            pass  # leave ket/bra dangling\n        else:\n            delta = np.eye(2, dtype=complex)\n            d = tn.Node(delta)\n            tn.connect(d[0], ket_leg); tn.connect(d[1], bra_leg)\n            nodes.append(d)\n    return nodes\n\ndef contract_scalar(nodes):\n    res = tn.contractors.greedy(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\ndef ref_probs(side, alpha, gamma, hb, vb):\n    n = side*side\n    psi = np.zeros(2**n, dtype=complex); psi[0]=1\n    def single(i, M):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes).reshape(-1)\n    def two(i, j, M4):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = M4 @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv).reshape(-1)\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, ry(alpha[r,c]))\n    for r in range(side):\n        for c in range(side-1):\n            two(r*side+c, r*side+c+1, rzz(hb[(r,c)]).reshape(4,4))\n    for r in range(side-1):\n        for c in range(side):\n            two(r*side+c, (r+1)*side+c, rxx(vb[(r,c)]).reshape(4,4))\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, rx(gamma[r,c]))\n    return np.abs(psi)**2\n\n# ---- validation on 2x2 and 3x3 ----\nfor side in (2,3):\n    alpha, gamma, hb, vb = build_angles(side)\n    amp_nodes = build_amp_nodes(side, alpha, gamma, hb, vb)\n    probs = ref_probs(side, alpha, gamma, hb, vb)\n    n = side*side\n    # check: Z(full bitstring) via doubled network == prob\n    err = 0.0\n    for bits in itertools.product([0,1], repeat=n):\n        fx = {i: bits[i] for i in range(n)}\n        nodes = build_doubled(side, amp_nodes, fixdict=fx, open_sites=set())\n        z = contract_scalar(nodes)\n        idx = sum(b<<(n-1-k) for k,b in enumerate(bits))\n        err = max(err, abs(z - probs[idx]))\n    print(f\\\"side={side}: max |Z(b)-P(b)| = {err}\\\")\n\n    # check marginals over first k bits\n    for k in [1, max(1, side)]:\n        if k > n: continue\n        err = 0.0\n        for prefix in itertools.product([0,1], repeat=k):\n            z_total = 0.0\n            for rest in itertools.product([0,1], repeat=n-k):\n                idx = sum((prefix+rest)[j]<<(n-1-j) for j in range(n))\n                z_total += probs[idx]\n            fx = {i: prefix[i] for i in range(k)}\n            nodes = build_doubled(side, amp_nodes, fixdict=fx, open_sites=set())\n            z = contract_scalar(nodes)\n            err = max(err, abs(z - z_total))\n        print(f\\\"side={side}: k={k} max |Z(prefix)-marginal| = {err}\\\")\nPY\ncd /tmp && timeout 600 python proto2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto2.py <<'PY'\nimport numpy as np, itertools, time\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef g0(mat4):\n    return mat4.reshape(4,4)[0,:].reshape(2,2)\n\ndef site_core(alpha, gamma, hleft, hright, vup, vdown):\n    A = ry(alpha) @ rx(gamma)\n    s0 = A[:, 0]\n    hL = g0(hleft); hR = g0(hright); vU = g0(vup); vD = g0(vdown)\n    T = np.einsum('b,l,r,u,d->blrud', s0,\n        np.einsum('l,r->lr', hL[:,0], hR[0,:]),\n        np.einsum('l,r->lr', hL[0,:], hR[:,0]),\n        np.einsum('u,d->ud', vU[:,0], vD[0,:]),\n        np.einsum('u,d->ud', vU[0,:], vD[:,0])) if False else None\n    # simpler: build via explicit loops is slow; use einsum with