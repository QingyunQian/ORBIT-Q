{"type":"item.started","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np\nimport tensornetwork as tn\n# inspect a gate tensor from a built circuit\nc = tc.Circuit(1)\nc.ry(0, theta=0.3)\ng = c._nodes[0]\nprint(\\\"node tensor shape:\\\", g.tensor.shape)\nprint(\\\"node edges:\\\", len(g.edges), [e.is_dangling() for e in g.edges])\nprint(\\\"tensor:\\\\n\\\", np.asarray(g.tensor))\n# compare with ry matrix\nt=0.3\nry = np.array([[np.cos(t/2), -np.sin(t/2)],[np.sin(t/2), np.cos(t/2)]])\nprint(\\\"ry:\\\\n\\\", ry)\n# check initial-state handling: build circuit, contract with <0| vectors manually\nn, e = c._copy()\nprint(\\\"front edges:\\\", [e2.dimension for e2 in e])\n# add bra: conj copy\nbn, be = c._copy(conj=True)\nnodes = n + bn\nd = tn.Node(np.eye(2,dtype=complex))\ntn.connect(d[0], e[0]); tn.connect(d[1], be[0])\nnodes.append(d)\nres = tn.contractors.greedy(nodes, ignore_edge_order=True)\nres = res[0] if isinstance(res, list) else res\nprint(\\\"contracted norm:\\\", np.asarray(res.tensor))\n# compare <0|Ry\"'^'\"\\\\dag Ry|0> = 1\n# also test amplitude: <b|Ry|0>\nfor b in (0,1):\n    c2 = tc.Circuit(1)\n    c2.ry(0, theta=0.3)\n    n2, e2 = c2._copy()\n    v = tn.Node(np.eye(2)[b])\n    tn.connect(v[0], e2[0])\n    res = tn.contractors.greedy(n2+[v], ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    print(\\\"amp\\\", b, np.asarray(res.tensor), \\\"expect\\\", ry[b,0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np\nimport tensornetwork as tn\n# inspect a gate tensor from a built circuit\nc = tc.Circuit(1)\nc.ry(0, theta=0.3)\ng = c._nodes[0]\nprint(\\\"node tensor shape:\\\", g.tensor.shape)\nprint(\\\"node edges:\\\", len(g.edges), [e.is_dangling() for e in g.edges])\nprint(\\\"tensor:\\\\n\\\", np.asarray(g.tensor))\n# compare with ry matrix\nt=0.3\nry = np.array([[np.cos(t/2), -np.sin(t/2)],[np.sin(t/2), np.cos(t/2)]])\nprint(\\\"ry:\\\\n\\\", ry)\n# check initial-state handling: build circuit, contract with <0| vectors manually\nn, e = c._copy()\nprint(\\\"front edges:\\\", [e2.dimension for e2 in e])\n# add bra: conj copy\nbn, be = c._copy(conj=True)\nnodes = n + bn\nd = tn.Node(np.eye(2,dtype=complex))\ntn.connect(d[0], e[0]); tn.connect(d[1], be[0])\nnodes.append(d)\nres = tn.contractors.greedy(nodes, ignore_edge_order=True)\nres = res[0] if isinstance(res, list) else res\nprint(\\\"contracted norm:\\\", np.asarray(res.tensor))\n# compare <0|Ry\"'^'\"\\\\dag Ry|0> = 1\n# also test amplitude: <b|Ry|0>\nfor b in (0,1):\n    c2 = tc.Circuit(1)\n    c2.ry(0, theta=0.3)\n    n2, e2 = c2._copy()\n    v = tn.Node(np.eye(2)[b])\n    tn.connect(v[0], e2[0])\n    res = tn.contractors.greedy(n2+[v], ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    print(\\\"amp\\\", b, np.asarray(res.tensor), \\\"expect\\\", ry[b,0])\nPY\"","aggregated_output":"node tensor shape: (2,)\nnode edges: 1 [False]\ntensor:\n [1.+0.j 0.+0.j]\nry:\n [[ 0.98877108 -0.14943813]\n [ 0.14943813  0.98877108]]\nfront edges: [2]\ncontracted norm: (1.0000000090805798+0j)\namp 0 (0.9887710809707642+0j) expect 0.9887710779360422\namp 1 (0.14943814277648926+0j) expect 0.14943813247359922\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport tensorcircuit as tc, numpy as np, tensornetwork as tn, itertools\n# 2-qubit circuit: ry(0), ry(1), rzz(0,1), rxx(0,1), rx(0), rx(1)\nc = tc.Circuit(2)\nc.ry(0, theta=0.19); c.ry(1, theta=0.3)\nc.rzz(0,1,theta=0.31); c.rxx(0,1,theta=0.27)\nc.rx(0, theta=0.17); c.rx(1, theta=0.22)\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(4,4)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m\npsi = np.zeros(4, dtype=complex); psi[0]=1\ndef single(i, M):\n    global psi\n    psi = psi.reshape(2,2)\n    psi = np.tensordot(M, psi, axes=([1],[i]))\n    psi = psi.reshape(-1)\ndef two(M4):\n    global psi\n    psi = psi.reshape(4)\n    psi = M4 @ psi\npsi = psi.reshape(2,2)\npsi = np.tensordot(rx(0.19), psi, axes=([1],[0]))  # wrong: use ry\n# redo carefully\npsi = np.zeros(4, dtype=complex); psi[0]=1\npsi = psi.reshape(2,2)\npsi = np.einsum('ai,ij->aj', ry(0.19), psi)\npsi = np.einsum('bj,ij->ib', ry(0.3), psi)  # careful index order\n# simpler: brute force kron\npsi = np.zeros(4, complex); psi[0]=1\npsi = psi.reshape(2,2)\npsi = np.tensordot(ry(0.19), psi, axes=([1],[0]))     # apply to qubit 0 (axis 0)\npsi = np.tensordot(ry(0.3), psi, axes=([1],[1]))      # apply to qubit 1 (axis 1) - wrong axis order\n# do it explicitly\npsi = np.zeros(4, complex); psi[0]=1\nM = np.kron(ry(0.19), ry(0.3))   # qubit0 (left), qubit1 (right)\npsi = M @ psi\npsi = rzz(0.31).reshape(4,4) @ psi\npsi = rxx(0.27).reshape(4,4) @ psi\nM2 = np.kron(rx(0.17), rx(0.22))\npsi = M2 @ psi\nprobs = np.abs(psi)**2\n# TC doubled network\ndef doubled(c, bits):\n    nodes, edges = c._copy()\n    bn, be = c._copy(conj=True)\n    alln = nodes + bn\n    for s,(ke,be_ ) in enumerate(zip(edges, be)):\n        bit = bits[s]\n        proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n        d = tn.Node(proj)\n        tn.connect(d[0], ke); tn.connect(d[1], be_)\n        alln.append(d)\n    res = tn.contractors.greedy(alln, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor).reshape(-1)[0]\nerr = 0\nfor bits in itertools.product([0,1], repeat=2):\n    z = doubled(c, bits)\n    idx = bits[0]*2+bits[1]\n    print(bits, z, probs[idx])\n    err = max(err, abs(z-probs[idx]))\nprint(\\\"err:\\\", err)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
