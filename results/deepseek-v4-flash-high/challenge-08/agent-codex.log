{"type":"item.started","item":{"id":"item_130","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport tensorcircuit as tc, numpy as np, time, sys\nsys.path.insert(0,'/tmp')\nimport proto8 as P\nside = 7\nalpha, gamma, hb, vb = P.build_angles(side)\nt0 = time.time()\nc = tc.MPSCircuit(side*side)\nfor r in range(side):\n    for cc in range(side):\n        c.ry(r*side+cc, theta=alpha[r,cc])\nfor r in range(side):\n    for cc in range(side-1):\n        c.rzz(r*side+cc, r*side+cc+1, theta=hb[(r,cc)])\nfor r in range(side-1):\n    for cc in range(side):\n        c.rxx(r*side+cc, (r+1)*side+cc, theta=vb[(r,cc)])\nfor r in range(side):\n    for cc in range(side):\n        c.rx(r*side+cc, theta=gamma[r,cc])\nt1 = time.time()\nprint(\\\"MPSCircuit build:\\\", t1-t0)\nprint(\\\"bond dims:\\\", c.get_bond_dimensions())\nt0 = time.time()\nsamples = c.sample(batch=8)\nt1 = time.time()\nprint(\\\"sample batch=8:\\\", t1-t0, \\\"shape:\\\", np.asarray(samples).shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
