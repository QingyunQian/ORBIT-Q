{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np\ng = tc.gates.rxx_gate(theta=0.27)\nT = np.asarray(g.tensor)\n# axes: (o1,o2,i1,i2)? print slices\nfor o1 in range(2):\n    for o2 in range(2):\n        for i1 in range(2):\n            for i2 in range(2):\n                v = T[o1,o2,i1,i2]\n                if abs(v) > 1e-8:\n                    print(f\\\"<{o1}{o2}|U|{i1}{i2}> = {v:.6f}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
