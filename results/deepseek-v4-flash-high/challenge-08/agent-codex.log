{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto6.py <<'PY'\nimport numpy as np, itertools, time\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\ndef build_circuit(side, alpha, gamma, hb, vb):\n    n = side*side\n    c = tc.Circuit(n)\n    for r in range(side):\n        for cidx in range(side):\n            c.ry(r*side+cidx, theta=alpha[r,cidx])\n    for r in range(side):\n        for cidx in range(side-1):\n            c.rzz(r*side+cidx, r*side+cidx+1, theta=hb[(r,cidx)])\n    for r in range(side-1):\n        for cidx in range(side):\n            c.rxx(r*side+cidx, (r+1)*side+cidx, theta=vb[(r,cidx)])\n    for r in range(side):\n        for cidx in range(side):\n            c.rx(r*side+cidx, theta=gamma[r,cidx])\n    return c\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef doubled_network(c, fixed=None, open_sites=frozenset()):\n    # fixed: dict site->bit ; open_sites: set of sites whose ket/bra measurement edges stay dangling\n    nodes, edges = c._copy()            # ket\n    bnodes, bedges = c._copy(conj=True) # bra\n    allnodes = nodes + bnodes\n    front_ket = edges\n    front_bra = bedges\n    open_edges = {}\n    for s, (ke, be) in enumerate(zip(front_ket, front_bra)):\n        if fixed is not None and s in fixed:\n            bit = fixed[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit] = 1.0\n            d = tn.Node(proj)\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            allnodes.append(d)\n        elif s in open_sites:\n            open_edges[s] = (ke, be)\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            allnodes.append(d)\n    return allnodes, open_edges\n\ndef contract_scalar(nodes, path='greedy'):\n    fn = getattr(tn.contractors, path)\n    res = fn(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\ndef contract_open(nodes, open_edges, path='greedy'):\n    fn = getattr(tn.contractors, path)\n    order = []\n    for s in sorted(open_edges):\n        order += [open_edges[s][0], open_edges[s][1]]\n    res = fn(nodes, output_edge_order=order)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\ndef ref_probs(side, alpha, gamma, hb, vb):\n    n = side*side\n    psi = np.zeros(2**n, dtype=complex); psi[0]=1\n    def single(i, M):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes).reshape(-1)\n    def two(i, j, M4):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = M4 @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv).reshape(-1)\n    def rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\n    def ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\n    def rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(4,4)\n    def rxx(t):\n        m = np.zeros((4,4), dtype=complex)\n        m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n        m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n        m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n        return m\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, ry(alpha[r,c]))\n    for r in range(side):\n        for c in range(side-1):\n            two(r*side+c, r*side+c+1, rzz(hb[(r,c)]))\n    for r in range(side-1):\n        for c in range(side):\n            two(r*side+c, (r+1)*side+c, rxx(vb[(r,c)]))\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, rx(gamma[r,c]))\n    return np.abs(psi)**2\n\nif __name__ == '__main__':\n    for side in (2,3):\n        alpha, gamma, hb, vb = build_angles(side)\n        c = build_circuit(side, alpha, gamma, hb, vb)\n        probs = ref_probs(side, alpha, gamma, hb, vb)\n        n = side*side\n        err = 0.0\n        for bits in itertools.product([0,1], repeat=n):\n            nodes, oe = doubled_network(c, fixed={i: bits[i] for i in range(n)})\n            z = contract_scalar(nodes)\n            idx = sum(b<<(n-1-k) for k,b in enumerate(bits))\n            err = max(err, abs(z - probs[idx]))\n        print(f\\\"side={side}: max |Z(b)-P(b)| = {err}\\\")\nPY\ncd /tmp && timeout 1200 python proto6.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
