{"type":"item.started","item":{"id":"item_126","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport proto8 as P, numpy as np, itertools\nside = 3\nalpha, gamma, hb, vb = P.build_angles(side)\nc = P.build_circuit(side, alpha, gamma, hb, vb)\ndef Zc(fx): return P.Z(c, fx)\n# Prefix {0,1,2,3,4}, next=5. Future={5,6,7,8}. Boundary (prefix sites adjacent to future):\n# site2-(5), site3-(6), site4-(5,7) => {2,3,4}\n# Test: fix b2,b3,b4, vary interior b0,b1 -> P(b5) should be constant\nfixedB = {2:0, 3:0, 4:0}\nfor b0 in (0,1):\n    for b1 in (0,1):\n        fx = dict(fixedB); fx[0]=b0; fx[1]=b1\n        z0 = Zc({**fx, 5:0}); z1 = Zc({**fx, 5:1})\n        print(\\\"interior (b0,b1):\\\", (b0,b1), \\\"P(b5=0) =\\\", (z0/(z0+z1)).real)\nprint()\n# now vary boundary b2,b3,b4 with interior fixed -> should change\nfor b2 in (0,1):\n    fx = {0:0, 1:0, 2:b2, 3:0, 4:0}\n    z0 = Zc({**fx, 5:0}); z1 = Zc({**fx, 5:1})\n    print(\\\"b2:\\\", b2, \\\"P(b5=0) =\\\", (z0/(z0+z1)).real)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
