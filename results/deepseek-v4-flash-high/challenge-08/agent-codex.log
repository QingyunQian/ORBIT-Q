{"type":"item.started","item":{"id":"item_132","type":"command_execution","command":"/bin/bash -lc \"cd /tmp && python - <<'PY'\nimport numpy as np, time\nimport tensorcircuit as tc\nimport tensornetwork as tn\nimport sys\nsys.path.insert(0,'/tmp')\nimport proto8 as P\n\ndef doubled_nodes(c, fixed):\n    nodes, e_ket = c._copy()\n    bn, e_bra = c._copy(conj=True)\n    alln = nodes + bn\n    for s,(ke,be) in enumerate(zip(e_ket, e_bra)):\n        if s in fixed:\n            bit = fixed[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n            d = tn.Node(proj); tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], ke); tn.connect(d[1], be)\n            alln.append(d)\n    return alln\n\nfor side in (4,5,6):\n    alpha, gamma, hb, vb = P.build_angles(side)\n    c = P.build_circuit(side, alpha, gamma, hb, vb)\n    nodes = doubled_nodes(c, {})\n    print(f\\\"--- side={side}, nodes={len(nodes)}\\\")\n    for path in [\\\"greedy\\\", \\\"branch\\\", \\\"optimal\\\", \\\"bucket\\\"]:\n        try:\n            t0=time.time()\n            fn = getattr(tn.contractors, path)\n            res = fn(nodes, ignore_edge_order=True)\n            res = res[0] if isinstance(res, list) else res\n            dt = time.time()-t0\n            print(f\\\"  {path}: {dt:.3f}s\\\", end=\\\"\\\")\n            if dt > 20: print(\\\" (slow, skip)\\\"); break\n            else: print()\n        except Exception as e:\n            print(f\\\"  {path}: ERR {str(e)[:80]}\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
