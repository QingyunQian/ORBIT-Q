{"type":"item.started","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc, numpy as np, tensornetwork as tn, itertools\nc = tc.Circuit(2)\nc.ry(0, theta=0.19); c.ry(1, theta=0.3)\nc.rzz(0,1,theta=0.31); c.rxx(0,1,theta=0.27)\nc.rx(0, theta=0.17); c.rx(1, theta=0.22)\nsv = c.state()\n# amplitude via circuit nodes + measurement vectors\nfor bits in itertools.product([0,1], repeat=2):\n    nodes, edges = c._copy()\n    for s,(ke) in enumerate(edges):\n        v = tn.Node(np.eye(2)[bits[s]])\n        tn.connect(v[0], ke)\n        nodes.append(v)\n    res = tn.contractors.greedy(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    a = np.asarray(res.tensor).reshape(-1)[0]\n    idx = bits[0]*2+bits[1]\n    print(bits, a, sv[idx], abs(a-sv[idx]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
