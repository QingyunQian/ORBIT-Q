{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto5.py <<'PY'\nimport numpy as np, itertools, time\nimport tensornetwork as tn\n\ndef rx(t): return np.array([[np.cos(t/2), -1j*np.sin(t/2)], [-1j*np.sin(t/2), np.cos(t/2)]])\ndef ry(t): return np.array([[np.cos(t/2), -np.sin(t/2)], [np.sin(t/2), np.cos(t/2)]])\ndef rzz(t): return np.diag([np.exp(-1j*t/2), np.exp(1j*t/2), np.exp(1j*t/2), np.exp(-1j*t/2)]).reshape(2,2,2,2)\ndef rxx(t):\n    m = np.zeros((4,4), dtype=complex)\n    m[0,0] = np.exp(-1j*t/2); m[3,3] = np.exp(-1j*t/2)\n    m[1,1] = np.cos(t/2); m[1,2] = -1j*np.sin(t/2)\n    m[2,1] = -1j*np.sin(t/2); m[2,2] = np.cos(t/2)\n    return m.reshape(2,2,2,2)\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef site_core(alpha, gamma):\n    # amplitude network site core with legs (b, hL, hR, vU, vD):\n    # contraction of Ry input |0>, output -> RZZ bonds -> RXX bonds -> Rx output\n    Ry = ry(alpha)\n    Ry0 = Ry[:, 0]  # (h_in,) = (a)\n    Rx_ = rx(gamma)\n    out = np.zeros((2,2,2,2,2), dtype=complex)\n    # indices: b (out), a (in to Rx), s (out of Ry -> RZZ), t (out of RZZ -> RXX)\n    for b in range(2):\n        for a in range(2):\n            v = Rx_[b, a]\n            if v == 0: continue\n            for s in range(2):\n                for t in range(2):\n                    # RZZ output s: horizontal out legs (s for this site); RXX output t: vertical out leg\n                    out[b, s, s, t, t] += v * Ry0[a]\n    return out\n\ndef ref_probs(side, alpha, gamma, hb, vb):\n    n = side*side\n    psi = np.zeros(2**n, dtype=complex); psi[0]=1\n    def single(i, M):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        axes = list(range(n)); axes[0]=i; axes[i]=0\n        psi = np.transpose(psi, axes)\n        psi = np.tensordot(M, psi, axes=([1],[0]))\n        psi = np.transpose(psi, axes).reshape(-1)\n    def two(i, j, M4):\n        nonlocal psi\n        psi = psi.reshape([2]*n)\n        perm = [i,j]+[k for k in range(n) if k not in (i,j)]\n        psi = np.transpose(psi, perm).reshape(4, 2**(n-2))\n        psi = M4 @ psi\n        psi = psi.reshape([2]*n)\n        inv = [0]*n\n        for k,x in enumerate(perm): inv[x]=k\n        psi = np.transpose(psi, inv).reshape(-1)\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, ry(alpha[r,c]))\n    for r in range(side):\n        for c in range(side-1):\n            two(r*side+c, r*side+c+1, rzz(hb[(r,c)]).reshape(4,4))\n    for r in range(side-1):\n        for c in range(side):\n            two(r*side+c, (r+1)*side+c, rxx(vb[(r,c)]).reshape(4,4))\n    for r in range(side):\n        for c in range(side):\n            single(r*side+c, rx(gamma[r,c]))\n    return np.abs(psi)**2\n\ndef hmat(r,c,hb): return rzz(hb[(r,c)]).reshape(4,4)[0,:].reshape(2,2) if (r,c) in hb else None\ndef vmat(r,c,vb): return rxx(vb[(r,c)]).reshape(4,4)[0,:].reshape(2,2) if (r,c) in vb else None\n\ndef build_doubled_nodes(side, cores, hb, vb, fixed=None, open_sites=frozenset()):\n    nodes = []\n    K = {}; B = {}; open_edges = {}\n    for (r,c), T in cores.items():\n        k = tn.Node(T); b = tn.Node(np.conj(T))\n        K[(r,c)] = k; B[(r,c)] = b\n        nodes += [k, b]\n    for (r,c) in cores:\n        s = r*side + c\n        if fixed is not None and s in fixed:\n            bit = fixed[s]\n            proj = np.zeros((2,2), dtype=complex); proj[bit,bit] = 1.0\n            d = tn.Node(proj)\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], B[(r,c)][0])\n            nodes.append(d)\n        elif s in open_sites:\n            open_edges[s] = (K[(r,c)][0], B[(r,c)][0])\n        else:\n            d = tn.Node(np.eye(2, dtype=complex))\n            tn.connect(d[0], K[(r,c)][0]); tn.connect(d[1], B[(r,c)][0])\n            nodes.append(d)\n    for (r,c) in hb:\n        M = hmat(r,c,hb)\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][1]); tn.connect(nd[1], K[(r,c+1)][2])\n        tn.connect(nd[2], B[(r,c)][1]); tn.connect(nd[3], B[(r,c+1)][2])\n        nodes.append(nd)\n    for (r,c) in vb:\n        M = vmat(r,c,vb)\n        Tbd = np.einsum('ab,cd->abcd', M, np.conj(M))\n        nd = tn.Node(Tbd)\n        tn.connect(nd[0], K[(r,c)][3]); tn.connect(nd[1], K[(r+1,c)][4])\n        tn.connect(nd[2], B[(r,c)][3]); tn.connect(nd[3], B[(r+1,c)][4])\n        nodes.append(nd)\n    return nodes, open_edges\n\ndef contract_all(nodes, path=\\\"greedy\\\"):\n    fn = getattr(tn.contractors, path)\n    res = fn(nodes, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\ndef contract_with_open(nodes, open_edges, path=\\\"greedy\\\"):\n    fn = getattr(tn.contractors, path)\n    order = []\n    for s in sorted(open_edges):\n        ke, be = open_edges[s]\n        order += [ke, be]\n    res = fn(nodes, output_edge_order=order)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor)\n\nif __name__ == \\\"__main__\\\":\n    for side in (2,3):\n        alpha, gamma, hb, vb = build_angles(side)\n        cores = {(r,c): site_core(alpha[r,c], gamma[r,c]) for r in range(side) for c in range(side)}\n        probs = ref_probs(side, alpha, gamma, hb, vb)\n        n = side*side\n        err = 0.0\n        for bits in itertools.product([0,1], repeat=n):\n            fixed = {i: bits[i] for i in range(n)}\n            nodes, oe = build_doubled_nodes(side, cores, hb, vb, fixed=fixed, open_sites=frozenset())\n            z = contract_all(nodes)\n            idx = sum(b<<(n-1-k) for k,b in enumerate(bits))\n            err = max(err, abs(z - probs[idx]))\n        print(f\\\"side={side}: max |Z(b)-P(b)| = {err}\\\")\n        err2 = 0.0\n        for s in range(n):\n            nodes, oe = build_doubled_nodes(side, cores, hb, vb, fixed=None, open_sites={s})\n            T = contract_with_open(nodes, oe)\n            marg = np.array([T[k,k].real for k in range(2)])\n            ref_marg = np.zeros(2)\n            for bits in itertools.product([0,1], repeat=n-1):\n                for k in range(2):\n                    bb = list(bits[:s]) + [k] + list(bits[s:])\n                    idx = sum(bb[j]<<(n-1-j) for j in range(n))\n                    ref_marg[k] += probs[idx]\n            err2 = max(err2, float(np.max(np.abs(marg-ref_marg))))\n        print(f\\\"side={side}: single-site marginal err = {err2}\\\")\nPY\ncd /tmp && timeout 1200 python proto5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
