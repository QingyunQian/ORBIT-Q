{"type":"item.started","item":{"id":"item_111","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto7.py <<'PY'\nimport numpy as np, itertools, time\nimport tensorcircuit as tc\nimport tensornetwork as tn\n\ndef build_angles(side):\n    rr = np.arange(side)+1; cc = np.arange(side)+1\n    alpha = 0.19 + 0.07*np.sin(0.83*rr)[:,None] + 0.05*np.cos(0.61*cc)[None,:] + 0.03*np.sin(0.29*(rr[:,None]+cc[None,:]+1))\n    gamma = 0.17 + 0.06*np.cos(0.52*rr)[:,None] - 0.04*np.sin(0.44*cc)[None,:] + 0.02*np.cos(0.25*(rr[:,None]+cc[None,:]+1))\n    kh=0; kv=0; hb={}; vb={}\n    for r in range(side):\n        for c in range(side-1):\n            hb[(r,c)] = 0.31 + 0.09*np.sin(0.47*(kh+1)) + 0.06*np.cos(0.38*(2*r+c+1)); kh+=1\n    for r in range(side-1):\n        for c in range(side):\n            vb[(r,c)] = 0.27 + 0.08*np.cos(0.41*(kv+1)) + 0.07*np.sin(0.33*(r+2*c+1)); kv+=1\n    return alpha, gamma, hb, vb\n\ndef gate_tensors(alpha, gamma, hb, vb):\n    # returns per-site single-qubit product tensor and per-bond 2x2 matrices\n    Ry = {s: np.asarray(tc.gates.ry_gate(theta=alpha[r,c]).tensor) for s,(r,c) in enumerate([(r,c) for r in range(side) for c in range(side)])}\n    return None\n\ndef build_amp_net(side, alpha, gamma, hb, vb):\n    # returns nodes list + front (measurement) edges\n    nodes = []\n    front = []\n    # per site: Ry node (1 in,1 out), RZZ nodes (2in,2out) for each bond, RXX nodes, Rx node\n    # We'll create one node per gate and connect them; keep measurement edges.\n    # Site structure: |0> --Ry--> a --(RZZ: L,R outputs)--> ... hmm need ordering:\n    # circuit order per site: Ry then RZZ (two-qubit) then RXX then Rx.\n    # Represent: Ry node edges [in_leg, out_leg]\n    ry_nodes = {}\n    rx_nodes = {}\n    for r in range(side):\n        for c in range(side):\n            T_ry = np.asarray(tc.gates.ry_gate(theta=alpha[r,c]).tensor)  # (out,in)\n            n_ry = tn.Node(T_ry)\n            # input leg: |0>\n            v0 = tn.Node(np.array([1.0+0j,0j]))\n            tn.connect(v0[0], n_ry[1])\n            nodes.append(v0)\n            ry_nodes[(r,c)] = n_ry\n            nodes.append(n_ry)\n            T_rx = np.asarray(tc.gates.rx_gate(theta=gamma[r,c]).tensor)\n            n_rx = tn.Node(T_rx)\n            rx_nodes[(r,c)] = n_rx\n            nodes.append(n_rx)\n    # RZZ gates on horizontal edges\n    rzz_nodes = {}\n    for (r,c),t in hb.items():\n        T = np.asarray(tc.gates.rzz_gate(theta=t).tensor)  # axes (o1,o2,i1,i2)\n        n = tn.Node(T)\n        rzz_nodes[(r,c)] = n\n        nodes.append(n)\n    rxx_nodes = {}\n    for (r,c),t in vb.items():\n        T = np.asarray(tc.gates.rxx_gate(theta=t).tensor)\n        n = tn.Node(T)\n        rxx_nodes[(r,c)] = n\n        nodes.append(n)\n    # connect: ry.out -> rzz.in ; rzz.out -> rxx.in ; rxx.out -> rx.in ; rx.out -> measurement\n    for r in range(side):\n        for c in range(side):\n            s = r*side+c\n            a_leg = ry_nodes[(r,c)][0]\n            # RZZ inputs for this site: horizontal bond (r,c-1) [as right site] and (r,c) [as left site]\n            if (r,c-1) in rzz_nodes:\n                tn.connect(rzz_nodes[(r,c-1)][2], a_leg)   # i2 = this site's input\n            if (r,c) in rzz_nodes:\n                tn.connect(rzz_nodes[(r,c)][3], a_leg)     # i1 = this site's input\n            # RZZ outputs -> RXX inputs: horizontal outputs of RZZ become vertical inputs of RXX\n            # RXX input legs for this site: (r-1,c) [as down site: i2] and (r,c) [as up site: i1]\n            hout_left = rzz_nodes[(r,c-1)][0] if (r,c-1) in rzz_nodes else None\n            hout_right = rzz_nodes[(r,c)][1] if (r,c) in rzz_nodes else None\n            vin_up = rxx_nodes[(r,c)][2] if (r,c) in rxx_nodes else None      # i1\n            vin_down = rxx_nodes[(r-1,c)][3] if (r-1,c) in rxx_nodes else None # i2\n            # Need connectivity matrix: RZZ (hL,hR) -> RXX (vU,vD)? Actually order: RZZ layer output (both qubits) then RXX layer input.\n            # Per site: RZZ output leg (this site) connects to RXX input leg (this site).\n            # RZZ output leg for this site: if left bond exists -> o2 (=this site right?); if right bond exists -> o1\n            # Hmm: RZZ node (r,c) has o1=site(r,c), o2=site(r,c+1). RZZ node (r,c-1): o1=site(r,c-1), o2=site(r,c).\n            # So this site's RZZ output leg is o2 of node (r,c-1) or o1 of node (r,c).\n            rzz_out = None\n            if (r,c-1) in rzz_nodes: rzz_out = rzz_nodes[(r,c-1)][1]  # o2\n            elif (r,c) in rzz_nodes: rzz_out = rzz_nodes[(r,c)][0]    # o1\n            # RXX input leg for this site: i1 if (r,c) in rxx_nodes else i2 if (r-1,c) in rxx_nodes\n            rxx_in = None\n            if (r,c) in rxx_nodes: rxx_in = rxx_nodes[(r,c)][2]       # i1\n            elif (r-1,c) in rxx_nodes: rxx_in = rxx_nodes[(r-1,c)][3] # i2\n            if rzz_out is not None and rxx_in is not None:\n                tn.connect(rzz_out, rxx_in)\n            # RXX output -> Rx input\n            rx_in = None\n            if (r,c) in rxx_nodes: rx_in = rxx_nodes[(r,c)][0]        # o1\n            elif (r-1,c) in rxx_nodes: rx_in = rxx_nodes[(r-1,c)][1]  # o2\n            if rx_in is not None:\n                tn.connect(rx_in, rx_nodes[(r,c)][1])\n            front.append(rx_nodes[(r,c)][0])\n    return nodes, front\n\nif __name__ == '__main__':\n    side=2\n    alpha, gamma, hb, vb = build_angles(side)\n    nodes, front = build_amp_net(side, alpha, gamma, hb, vb)\n    print(\\\"nodes:\\\", len(nodes), \\\"front:\\\", len(front), \\\"dangling:\\\", sum(len(n.get_all_dangling()) for n in nodes))\n    # compare with TC statevector\n    c = tc.Circuit(side*side)\n    for r in range(side):\n        for cc in range(side):\n            c.ry(r*side+cc, theta=alpha[r,cc])\n    for r in range(side):\n        for cc in range(side-1):\n            c.rzz(r*side+cc, r*side+cc+1, theta=hb[(r,cc)])\n    for r in range(side-1):\n        for cc in range(side):\n            c.rxx(r*side+cc, (r+1)*side+cc, theta=vb[(r,cc)])\n    for r in range(side):\n        for cc in range(side):\n            c.rx(r*side+cc, theta=gamma[r,cc])\n    sv = c.state()\n    err = 0\n    for bits in itertools.product([0,1], repeat=side*side):\n        nn = [n.copy() for n in nodes]\n        for s, e in enumerate(front):\n            pass\n    # contract with measurement vectors on copies of front\n    for bits in itertools.product([0,1], repeat=4):\n        nn = [n.copy() for n in nodes]\n        # need mapping front edges -> copied edges\n        print(\\\"skip\\\")\n        break\nPY\ncd /tmp && timeout 300 python proto7.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
