2))\npsi = M2 @ psi\nprobs = np.abs(psi)**2\n# TC doubled network\ndef doubled(c, bits):\n    nodes, edges = c._copy()\n    bn, be = c._copy(conj=True)\n    alln = nodes + bn\n    for s,(ke,be_ ) in enumerate(zip(edges, be)):\n        bit = bits[s]\n        proj = np.zeros((2,2), dtype=complex); proj[bit,bit]=1\n        d = tn.Node(proj)\n        tn.connect(d[0], ke); tn.connect(d[1], be_)\n        alln.append(d)\n    res = tn.contractors.greedy(alln, ignore_edge_order=True)\n    res = res[0] if isinstance(res, list) else res\n    return np.asarray(res.tensor).reshape(-1)[0]\nerr = 0\nfor bits in itertools.product([0,1], repeat=2):\n    z = doubled(c, bits)\n    idx = bits[0]*2+bits[1]\n    print(bits, z, probs[idx])\n    err = max(err, abs(z-probs[idx]))\nprint(\\\"err:\\\", err)\nPY\"","aggregated_output":"(0, 0) (0.9419192131832741+1.0544910115847291e-17j) 0.9653311525369859\n(0, 1) (0.022724499887584376+6.541860341278884e-10j) 0.021882762797137783\n(1, 0) (0.011656817974823123+0j) 0.012174744430039281\n(1, 1) (0.023699669231432453-9.699706294486871e-12j) 0.0006113402358365031\nerr: 0.023411939353711775\n","exit_code":0,"status":"completed"}}
