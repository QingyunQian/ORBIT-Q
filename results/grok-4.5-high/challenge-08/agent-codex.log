{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport tensorcircuit as tc\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\ndef build(nside=3):\n    n = nside*nside\n    c = tc.Circuit(n)\n    def idx(r,c): return r*nside+c\n    # simple angles\n    for r in range(nside):\n        for col in range(nside):\n            c.ry(idx(r,col), theta=0.2)\n    kh=0\n    for r in range(nside):\n        for col in range(nside-1):\n            c.rzz(idx(r,col), idx(r,col+1), theta=0.3)\n            kh+=1\n    kv=0\n    for r in range(nside-1):\n        for col in range(nside):\n            c.rxx(idx(r,col), idx(r+1,col), theta=0.25)\n            kv+=1\n    for r in range(nside):\n        for col in range(nside):\n            c.rx(idx(r,col), theta=0.15)\n    return c\n\nfor s in [2,3,4]:\n    c = build(s)\n    t0=time.time()\n    r = c.sample(batch=2, allow_state=False, format='sample_bin')\n    t1=time.time()\n    print(s, 'time for 2 samples', t1-t0, 'shape', np.array(r).shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
