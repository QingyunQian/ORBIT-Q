{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\nfrom scipy import sparse\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\nK = tc.backend\n\nn = 12\ndim = 3\nbeta = 0.20\nD = 0.15\nn_layers=5\n\nSx = (1/np.sqrt(2)) * np.array([[0,1,0],[1,0,1],[0,1,0]], dtype=np.complex128)\nSy = (1/np.sqrt(2)) * np.array([[0,-1j,0],[1j,0,-1j],[0,1j,0]], dtype=np.complex128)\nSz = np.diag([1.,0.,-1.]).astype(np.complex128)\n\ndef two_site_op(i, mat9, n=n, dim=dim):\n    left = dim**i\n    right = dim**(n-i-2)\n    return sparse.kron(sparse.kron(sparse.eye(left, dtype=np.complex128), sparse.csr_matrix(mat9)), sparse.eye(right, dtype=np.complex128), format='csr')\n\ndef one_site_op(i, mat3, n=n, dim=dim):\n    left = dim**i\n    right = dim**(n-i-1)\n    return sparse.kron(sparse.kron(sparse.eye(left, dtype=np.complex128), sparse.csr_matrix(mat3)), sparse.eye(right, dtype=np.complex128), format='csr')\n\nSdotS = np.kron(Sx,Sx)+np.kron(Sy,Sy)+np.kron(Sz,Sz)\nSdotS2 = SdotS@SdotS\nXXpYY = np.kron(Sx,Sx)+np.kron(Sy,Sy)\nZZ = np.kron(Sz,Sz)\nbond = SdotS + beta*SdotS2\nH = sparse.csr_matrix((dim**n, dim**n), dtype=np.complex128)\nfor i in range(n-1):\n    H = H + two_site_op(i, bond)\nfor i in range(n):\n    H = H + D * one_site_op(i, Sz@Sz)\n\n# exact ground state via sparse eigensolver - just for our knowledge not solution\nt0=time.time()\n# too big? 531k dim - lobpcg or eigsh\nfrom scipy.sparse.linalg import eigsh\nevals, evecs = eigsh(H, k=1, which='SA', tol=1e-8)\nprint('exact E/n', evals[0]/n, 'time', time.time()-t0)\n\n# string order exact\npsi_g = evecs[:,0]\ndef string_order(psi, i, j):\n    # build operator\n    # start with identity\n    # apply on state: O|psi> then vdot\n    # Sz_i * prod exp(i pi Sz) * Sz_j\n    exp_i_pi_Sz = np.diag([-1.,1.,-1.]).astype(np.complex128)\n    # apply from right: Sz_j, then middles, then Sz_i\n    out = psi.copy()\n    # reshape approach\n    def apply_local(vec, site, mat):\n        v = vec.reshape(dim**site, dim, dim**(n-site-1))\n        v = np.einsum('ab,ibj->iaj', mat, v, optimize=True)\n        return v.reshape(-1)\n    out = apply_local(out, j, Sz)\n    for k in range(i+1,j):\n        out = apply_local(out, k, exp_i_pi_Sz)\n    out = apply_local(out, i, Sz)\n    return np.vdot(psi, out).real\n\nfor pair in [(0,11),(1,10),(2,9)]:\n    print(pair, string_order(psi_g, *pair))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
