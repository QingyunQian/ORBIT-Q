{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\nfrom scipy import sparse\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nn = 12\ndim = 3\nbeta = 0.20\nD = 0.15\nn_layers=5\nmax_steps=5\nlr=0.03\nscale=0.05\nseed=2041\n\nSx = jnp.array([[0,1,0],[1,0,1],[0,1,0]], dtype=jnp.complex128)/jnp.sqrt(2)\nSy = jnp.array([[0,-1j,0],[1j,0,-1j],[0,1j,0]], dtype=jnp.complex128)/jnp.sqrt(2)\nSz = jnp.diag(jnp.array([1.,0.,-1.], dtype=jnp.complex128))\nXXpYY = jnp.kron(Sx,Sx)+jnp.kron(Sy,Sy)\nZZ = jnp.kron(Sz,Sz)\nSdotS = XXpYY + ZZ\nSdotS2 = SdotS @ SdotS\nfixed_gen = beta * SdotS2\nSz2 = Sz @ Sz\n\n# initial state\npsi0_np = np.zeros(dim**n, dtype=np.complex128)\nidx=0\nfor i in range(n):\n    local = 0 if i%2==0 else 2\n    idx = idx*dim + local\npsi0_np[idx]=1.0\npsi0 = jnp.array(psi0_np)\n\n# sparse H as jax-friendly matvec via precomputed scipy - use dense local expectations instead\n# Build H as sum of local terms applied via reshape - better for jit\n\ndef apply_1(psi, site, mat):\n    psi = psi.reshape(dim**site, dim, dim**(n-site-1))\n    psi = jnp.einsum('ab,ibj->iaj', mat, psi)\n    return psi.reshape(-1)\n\ndef apply_2(psi, site, mat):\n    # mat 9x9 on site, site+1\n    psi = psi.reshape(dim**site, dim*dim, dim**(n-site-2))\n    psi = jnp.einsum('ab,ibj->iaj', mat, psi)\n    return psi.reshape(-1)\n\nbond_op = SdotS + beta*SdotS2\n\ndef energy(psi):\n    e = 0.0\n    for i in range(n-1):\n        phi = apply_2(psi, i, bond_op)\n        e = e + jnp.vdot(psi, phi).real\n    for i in range(n):\n        phi = apply_1(psi, i, Sz2)\n        e = e + D * jnp.vdot(psi, phi).real\n    return e / n\n\n# Build gates with expm\ndef rz(phi):\n    # exp(-i phi Sz) = diag(e\"'^{-i phi}, 1, e''^{i phi})\n    return jexpm(-1j * phi * Sz)\n\ndef ry(th):\n    return jexpm(-1j * th * Sy)\n\ndef ubond(th, ph):\n    return jexpm(-1j * (th * XXpYY + ph * ZZ + fixed_gen))\n\nparams_per_layer = 3*n + 2*(n-1)\n\ndef circuit_state(params):\n    # use TC\n    c = tc.QuditCircuit(n, dim=dim, inputs=psi0)\n    p = 0\n    for l in range(n_layers):\n        for i in range(n):\n            a = params[p]; b=params[p+1]; g=params[p+2]; p+=3\n            c.any(i, unitary=rz(a))\n            c.any(i, unitary=ry(b))\n            c.any(i, unitary=rz(g))\n        for i in range(0,n-1,2):\n            th=params[p]; ph=params[p+1]; p+=2\n            c.any(i, i+1, unitary=ubond(th,ph))\n        for i in range(1,n-1,2):\n            th=params[p]; ph=params[p+1]; p+=2\n            c.any(i, i+1, unitary=ubond(th,ph))\n    return c.state()\n\ndef loss(params):\n    psi = circuit_state(params)\n    return energy(psi)\n\nkey = jax.random.PRNGKey(seed)\nparams = scale * jax.random.normal(key, (n_layers*params_per_layer,), dtype=jnp.float64)\n# enable x64\nfrom jax import config\nconfig.update('\"'jax_enable_x64', True)\nparams = scale * jax.random.normal(jax.random.PRNGKey(seed), (n_layers*params_per_layer,), dtype=jnp.float64)\n\nprint('params', params.shape, params.dtype)\nt0=time.time()\ne = loss(params)\ne.block_until_ready()\nprint('first loss', float(e), 'time', time.time()-t0)\n\nt0=time.time()\ne = loss(params)\ne.block_until_ready()\nprint('second loss', float(e), 'time', time.time()-t0)\n\n# try grad\nt0=time.time()\nval, g = jax.value_and_grad(loss)(params)\nval.block_until_ready()\nprint('grad time', time.time()-t0, 'val', float(val), 'gnorm', float(jnp.linalg.norm(g)))\n\nt0=time.time()\nval, g = jax.value_and_grad(loss)(params)\nval.block_until_ready()\nprint('grad2 time', time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
