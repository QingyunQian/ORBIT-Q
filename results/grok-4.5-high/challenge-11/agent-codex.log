{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nfrom jax import config\nconfig.update('jax_enable_x64', True)\nfrom jax.scipy.linalg import expm as jexpm\nimport tensorcircuit as tc\nimport optax\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nn = 12\ndim = 3\nbeta = 0.20\nD = 0.15\nn_layers=5\nmax_steps=500\nlr=0.03\nscale=0.05\nseed=2041\n\nSx = jnp.asarray([[0,1,0],[1,0,1],[0,1,0]], dtype=jnp.complex128)/jnp.sqrt(2)\nSy = jnp.asarray([[0,-1j,0],[1j,0,-1j],[0,1j,0]], dtype=jnp.complex128)/jnp.sqrt(2)\nSz = jnp.diag(jnp.asarray([1.,0.,-1.], dtype=jnp.complex128))\nXXpYY = jnp.kron(Sx,Sx)+jnp.kron(Sy,Sy)\nZZ = jnp.kron(Sz,Sz)\nSdotS = XXpYY + ZZ\nSdotS2 = SdotS @ SdotS\nfixed_gen = beta * SdotS2\nSz2 = Sz @ Sz\nbond_op = SdotS + beta*SdotS2\n\npsi0_np = np.zeros(dim**n, dtype=np.complex128)\nidx=0\nfor i in range(n):\n    local = 0 if i%2==0 else 2\n    idx = idx*dim + local\npsi0_np[idx]=1.0\npsi0 = jnp.asarray(psi0_np)\n\ndef apply_1(psi, site, mat):\n    psi = psi.reshape((dim**site, dim, dim**(n-site-1)))\n    psi = jnp.einsum('ab,ibj->iaj', mat, psi)\n    return psi.reshape((dim**n,))\n\ndef apply_2(psi, site, mat):\n    psi = psi.reshape((dim**site, dim*dim, dim**(n-site-2)))\n    psi = jnp.einsum('ab,ibj->iaj', mat, psi)\n    return psi.reshape((dim**n,))\n\ndef energy(psi):\n    e = 0.0\n    for i in range(n-1):\n        e = e + jnp.vdot(psi, apply_2(psi, i, bond_op)).real\n    for i in range(n):\n        e = e + D * jnp.vdot(psi, apply_1(psi, i, Sz2)).real\n    return e / n\n\ndef rz(phi):\n    # closed form faster\n    phases = jnp.exp(-1j * phi * jnp.asarray([1.,0.,-1.], dtype=jnp.complex128))\n    return jnp.diag(phases)\n\ndef ry(th):\n    return jexpm(-1j * th * Sy)\n\ndef ubond(th, ph):\n    return jexpm(-1j * (th * XXpYY + ph * ZZ + fixed_gen))\n\neven_bonds = list(range(0,n-1,2))\nodd_bonds = list(range(1,n-1,2))\nparams_per_layer = 3*n + 2*(n-1)\nnparams = n_layers*params_per_layer\n\ndef circuit_state(params):\n    c = tc.QuditCircuit(n, dim=dim, inputs=psi0)\n    # reshape params\n    # process layer by layer with python for (static)\n    p = 0\n    for l in range(n_layers):\n        alphas = params[p:p+n]; p+=n\n        betas = params[p:p+n]; p+=n\n        gammas = params[p:p+n]; p+=n\n        # actually original order is alpha,beta,gamma per site interleaved\n    return None\n\n# stick to interleaved layout as specified\ndef circuit_state(params):\n    c = tc.QuditCircuit(n, dim=dim, inputs=psi0)\n    p = 0\n    for l in range(n_layers):\n        for i in range(n):\n            a,b,g = params[p], params[p+1], params[p+2]; p+=3\n            c.any(i, unitary=rz(a))\n            c.any(i, unitary=ry(b))\n            c.any(i, unitary=rz(g))\n        for i in even_bonds:\n            th,ph = params[p], params[p+1]; p+=2\n            c.any(i,i+1, unitary=ubond(th,ph))\n        for i in odd_bonds:\n            th,ph = params[p], params[p+1]; p+=2\n            c.any(i,i+1, unitary=ubond(th,ph))\n    return c.state()\n\ndef loss(params):\n    return energy(circuit_state(params))\n\nparams0 = scale * jax.random.normal(jax.random.PRNGKey(seed), (nparams,), dtype=jnp.float64)\nopt = optax.adam(lr)\n\n@jax.jit\ndef train(params):\n    opt_state = opt.init(params)\n    def step(carry, _):\n        params, opt_state = carry\n        val, g = jax.value_and_grad(loss)(params)\n        updates, opt_state = opt.update(g, opt_state, params)\n        params = optax.apply_updates(params, updates)\n        return (params, opt_state), val\n    (params, opt_state), hist = jax.lax.scan(step, (params, opt_state), None, length=max_steps)\n    # final energy after last update\n    final = loss(params)\n    return hist, final, params\n\nprint('compiling...')\nt0=time.time()\nhist, final, params = train(params0)\nhist.block_until_ready()\nprint('total', time.time()-t0)\nprint('init', float(hist[0]), 'final_hist', float(hist[-1]), 'final', float(final))\nprint('min', float(jnp.min(hist)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
