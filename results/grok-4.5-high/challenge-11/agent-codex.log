i0, H @ psi0).real / n\nprint('neel energy density', e0)\n\n# test circuit build\nn_layers=5\n# params\nrng = np.random.default_rng(2041)\nnparams = n_layers * (3*n + 2*(n-1))\nparams = rng.normal(0, 0.05, size=nparams)\nprint('nparams', nparams)\n\ndef rz(phi):\n    return expm(-1j * phi * Sz)\n\ndef ry(theta):\n    return expm(-1j * theta * Sy)\n\ndef Ubond(theta, phi, beta=beta):\n    G = theta * XXpYY + phi * ZZ + beta * SdotS2\n    return expm(-1j * G)\n\nt0=time.time()\nc = tc.QuditCircuit(n, dim=dim, inputs=tc.array_to_tensor(psi0))\np=0\nfor l in range(n_layers):\n    for i in range(n):\n        a,b,g = params[p:p+3]; p+=3\n        c.any(i, unitary=tc.array_to_tensor(rz(a)))\n        c.any(i, unitary=tc.array_to_tensor(ry(b)))\n        c.any(i, unitary=tc.array_to_tensor(rz(g)))\n    # even\n    bidx=0\n    for i in range(0,n-1,2):\n        th,ph = params[p:p+2]; p+=2\n        c.any(i,i+1, unitary=tc.array_to_tensor(Ubond(th,ph)))\n    for i in range(1,n-1,2):\n        th,ph = params[p:p+2]; p+=2\n        c.any(i,i+1, unitary=tc.array_to_tensor(Ubond(th,ph)))\npsi = np.array(c.state())\nprint('state time', time.time()-t0, 'norm', np.linalg.norm(psi))\ne = np.vdot(psi, H@psi).real/n\nprint('energy', e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
