ay(0.1+0.j, dtype=complex64), array([1.+0.j], dtype=complex64)]\n    >>>\n    >>> tc.set_backend('tensorflow')\n    tensorflow_backend\n    >>> num_to_tensor(x, y, z)\n    [<tf.Tensor: shape=(), dtype=complex64, numpy=0j>,\n     <tf.Tensor: shape=(), dtype=complex64, numpy=(0.1+0j)>,\n     <tf.Tensor: shape=(1,), dtype=complex64, numpy=array([1.+0.j], dtype=complex64)>]\n    >>>\n    >>> tc.set_backend('pytorch')\n    pytorch_backend\n    >>> num_to_tensor(x, y, z)\n    [tensor(0.+0.j), tensor(0.1000+0.j), tensor([1.+0.j])]\n    >>>\n    >>> tc.set_backend('jax')\n    jax_backend\n    >>> num_to_tensor(x, y, z)\n    [DeviceArray(0.+0.j, dtype=complex64),\n     DeviceArray(0.1+0.j, dtype=complex64),\n     DeviceArray([1.+0.j], dtype=complex64)]\n\n    :param num: inputs\n    :type num: Union[float, Tensor]\n    :param dtype: dtype of the output Tensors\n    :type dtype: str, optional\n    :return: List of Tensors or a single Tensor\n    :rtype: Union[List[Tensor], Tensor]\n    \"\"\"\n\n    l = []\n    if dtype is None:\n        dtype = dtypestr\n    for n in num:\n        if not backend.is_tensor(n):\n            l.append(backend.cast(backend.convert_to_tensor(n), dtype=dtype))\n        else:\n            l.append(backend.cast(n, dtype=dtype))\n    if len(l) == 1:\n        return l[0]\n    return l\n\n['Any', 'Array', 'Callable', 'ComplexWarning', 'Gate', 'GateF', 'GateVF', 'List', 'Operator', 'Optional', 'Sequence', 'Tensor', 'Tuple', 'Union', 'any', 'any_gate', 'anygate', 'arg_alias', 'array_to_tensor', 'backend', 'bmatrix', 'cmz', 'cmz_gate', 'cmzgate', 'cnot', 'cnot_gate', 'cnotgate', 'contractor', 'cphase', 'cphasegate', 'cr', 'cr_gate', 'crgate', 'crx', 'crxgate', 'cry', 'crygate', 'crz', 'crzgate', 'cu', 'cugate', 'cy', 'cy_gate', 'cygate', 'cz', 'cz_gate', 'czgate', 'deepcopy', 'default_device', 'default_provider']\n        def apply_list(self: \"AbstractCircuit\", *index: int, **vars: Any) -> None:\n            if isinstance(index[0], int):\n               