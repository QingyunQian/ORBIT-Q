{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\nL=32;h=1.05;n_layers=4\nbuilder=qtn.SpinHam1D(S=0.5,cyclic=False)\nbuilder += -4.,'Z','Z'; builder += -2*h,'X'\nH=builder.build_mpo(L)\ndmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\nmps=dmrg.state; mps.canonicalize_(where=0)\nprint('dmrg',dmrg.energy,flush=True)\n\ndef to_tc(mps):\n    ts=[]\n    for i in range(mps.nsites):\n        t=np.asarray(mps.tensors[i].data,dtype=np.complex128)\n        if t.ndim==2:\n            t=t.reshape(1,t.shape[0],t.shape[1]) if i==0 else t.reshape(t.shape[0],t.shape[1],1)\n        ts.append(t)\n    return ts\nbase=to_tc(mps)\nsplit={'max_singular_values':8}\nXX=tc.gates._xx_matrix; YY=tc.gates._yy_matrix; ZZ=tc.gates._zz_matrix\nparams=np.zeros(570)\n\nI=np.eye(2,dtype=np.complex128); X=np.array([[0,1],[1,0]],dtype=np.complex128); Z=np.array([[1,0],[0,-1]],dtype=np.complex128)\ndef make_mpo(L,h):\n    ts=[]\n    for i in range(L):\n        W=np.zeros((3,2,2,3),dtype=np.complex128)\n        W[0,:,:,0]=I; W[0,:,:,1]=-Z; W[0,:,:,2]=-h*X; W[1,:,:,2]=Z; W[2,:,:,2]=I\n        if i==0: ts.append(W[0:1])\n        elif i==L-1: ts.append(W[:,:,:,2:3])\n        else: ts.append(W)\n    return ts\nHts=make_mpo(L,h)\n\ndef mps_e(ts,Hts):\n    env=np.ones((1,1,1),dtype=np.complex128)\n    for A,W in zip(ts,Hts):\n        env=np.einsum('awb,apx,wpqy,bqz->xyz', env, A.conj(), W, A)\n    return env[0,0,0].real\ndef mps_n2(ts):\n    env=np.ones((1,1),dtype=np.complex128)\n    for A in ts:\n        env=np.einsum('ab,apx,bpy->xy', env, A.conj(), A)\n    return env[0,0].real\n\ndef energy(params):\n    c=tc.MPSCircuit(L, tensors=[t.copy() for t in base], center_position=0, split=split)\n    idx=0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q,theta=params[idx]); idx+=1\n            c.ry(q,theta=params[idx]); idx+=1\n            c.rz(q,theta=params[idx]); idx+=1\n        bonds=range(0,L-1,2) if layer%2==0 else range(1,L-1,2)\n        for b in bonds:\n            thxx=params[idx];idx+=1; thyy=params[idx];idx+=1; thzz=params[idx];idx+=1\n            c.exp1(b,b+1,theta=thxx,unitary=XX)\n            c.exp1(b,b+1,theta=thyy,unitary=YY)\n            c.exp1(b,b+1,theta=thzz,unitary=ZZ)\n    ts=c.get_tensors()\n    return mps_e(ts,Hts)/mps_n2(ts)\n\nt0=time.time(); e=energy(params); print('E',e,time.time()-t0,flush=True)\nt0=time.time(); e=energy(params); print('E2',e,time.time()-t0,flush=True)\n\n# fused unitary version\nfrom scipy.linalg import expm\ndef energy_fused(params):\n    c=tc.MPSCircuit(L, tensors=[t.copy() for t in base], center_position=0, split=split)\n    idx=0\n    XX_=np.kron(X,X); YY_=np.kron(np.array([[0,-1j],[1j,0]],dtype=np.complex128),np.array([[0,-1j],[1j,0]],dtype=np.complex128)); ZZ_=np.kron(Z,Z)\n    for layer in range(n_layers):\n        for q in range(L):\n            a,b,g=params[idx:idx+3]; idx+=3\n            # Rz(a) Ry(b) Rz(g)\n            rz1=np.array([[np.exp(-1j*a/2),0],[0,np.exp(1j*a/2)]],dtype=np.complex128)\n            ry=np.array([[np.cos(b/2),-np.sin(b/2)],[np.sin(b/2),np.cos(b/2)]],dtype=np.complex128)\n            rz2=np.array([[np.exp(-1j*g/2),0],[0,np.exp(1j*g/2)]],dtype=np.complex128)\n            u=rz1@ry@rz2\n            c.unitary(q, unitary=u)\n        bonds=range(0,L-1,2) if layer%2==0 else range(1,L-1,2)\n        for bnd in bonds:\n            th=params[idx:idx+3]; idx+=3\n            H2=th[0]*XX_+th[1]*YY_+th[2]*ZZ_\n            g=expm(-1j*H2).reshape(2,2,2,2)\n            c.unitary(bnd,bnd+1,unitary=g)\n    ts=c.get_tensors()\n    return mps_e(ts,Hts)/mps_n2(ts)\n\nt0=time.time(); e=energy_fused(params); print('Ef',e,time.time()-t0,flush=True)\nt0=time.time()\nfor i in range(10):\n    e=energy_fused(params)\nprint('avg fused', (time.time(