{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY' > /tmp/bench1.log 2>&1\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\ndef make_dmrg(n, field, chi, sweeps):\n    H = qtn.MPO_ham_ising(n, j=-4.0, bx=2*field, S=1/2, cyclic=False)\n    dmrg = qtn.DMRG2(H, bond_dims=[chi], cutoffs=1e-10)\n    dmrg.solve(max_sweeps=sweeps, verbosity=0)\n    psi = dmrg.state\n    tensors = []\n    for i in range(n):\n        t = np.asarray(psi.arrays[i], dtype=np.complex64)\n        if t.ndim == 2:\n            t = t.reshape(1, t.shape[0], t.shape[1]) if i == 0 else t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(t)\n    return tensors, float(dmrg.energy)\n\ndef energy_of(params, tensors, n, field, n_layers, max_bond=None):\n    split = {\\\"max_singular_values\\\": max_bond} if max_bond else {}\n    c = tc.MPSCircuit(n, tensors=tensors, split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(n):\n            rz1, ry, rz2 = params[idx], params[idx+1], params[idx+2]\n            idx += 3\n            c.rz(q, theta=rz1)\n            c.ry(q, theta=ry)\n            c.rz(q, theta=rz2)\n        bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n        for b in bonds:\n            txx, tyy, tzz = params[idx], params[idx+1], params[idx+2]\n            idx += 3\n            c.rxx(b, b+1, theta=2*txx)\n            c.ryy(b, b+1, theta=2*tyy)\n            c.rzz(b, b+1, theta=2*tzz)\n    e = 0.0\n    for i in range(n-1):\n        e = e - jnp.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - field * jnp.real(c.expectation_ps(x=[i]))\n    return e\n\nn, field, chi, sweeps = 8, 1.05, 8, 2\ntensors, e0 = make_dmrg(n, field, chi, sweeps)\nprint('dmrg', e0, flush=True)\n\nn_layers = 2\nnp_sing = n_layers * n * 3\nnp_doub = 0\nfor layer in range(n_layers):\n    bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n    np_doub += len(bonds)*3\nnparams = np_sing + np_doub\nprint('nparams', nparams, flush=True)\nparams = jnp.zeros((nparams,), dtype=jnp.float32)\n\nt0 = time.time()\ne = energy_of(params, tensors, n, field, n_layers, max_bond=16)\nprint('E0', float(e), 'time', time.time()-t0, flush=True)\n\nval_and_grad = jax.value_and_grad(lambda p: energy_of(p, tensors, n, field, n_layers, max_bond=16))\nt0 = time.time()\ne, g = val_and_grad(params)\nprint('grad E', float(e), 'gnorm', float(jnp.linalg.norm(g)), 'time', time.time()-t0, flush=True)\n\nt0 = time.time()\ne, g = val_and_grad(params)\nprint('2nd grad time', time.time()-t0, flush=True)\nprint('done', flush=True)\nPY\necho EXIT:\"'$?\ntail -50 /tmp/bench1.log\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
