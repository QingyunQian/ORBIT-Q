{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY' > /tmp/bench2.log 2>&1\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\ndef make_dmrg(n, field, chi, sweeps):\n    H = qtn.MPO_ham_ising(n, j=-4.0, bx=2*field, S=1/2, cyclic=False)\n    dmrg = qtn.DMRG2(H, bond_dims=[chi], cutoffs=1e-10)\n    dmrg.solve(max_sweeps=sweeps, verbosity=0)\n    psi = dmrg.state\n    tensors = []\n    for i in range(n):\n        t = np.asarray(psi.arrays[i], dtype=np.complex128)\n        if t.ndim == 2:\n            t = t.reshape(1, t.shape[0], t.shape[1]) if i == 0 else t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(t)\n    return tensors, float(dmrg.energy)\n\ndef energy_of(params, tensors, n, field, n_layers, max_bond=32):\n    split = {\\\"max_singular_values\\\": max_bond}\n    c = tc.MPSCircuit(n, tensors=[t.copy() for t in tensors], split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(n):\n            rz1, ry, rz2 = params[idx], params[idx+1], params[idx+2]\n            idx += 3\n            c.rz(q, theta=rz1)\n            c.ry(q, theta=ry)\n            c.rz(q, theta=rz2)\n        bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n        for b in bonds:\n            txx, tyy, tzz = params[idx], params[idx+1], params[idx+2]\n            idx += 3\n            c.rxx(b, b+1, theta=2*txx)\n            c.ryy(b, b+1, theta=2*tyy)\n            c.rzz(b, b+1, theta=2*tzz)\n    e = 0.0\n    for i in range(n-1):\n        e = e - np.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - field * np.real(c.expectation_ps(x=[i]))\n    return float(e)\n\nfor n in [8, 16, 32]:\n    tensors, e0 = make_dmrg(n, 1.05, 8, 2)\n    n_layers = 4\n    nparams = 0\n    for layer in range(n_layers):\n        nparams += n*3\n        bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n        nparams += len(bonds)*3\n    params = np.zeros(nparams)\n    t0 = time.time()\n    e = energy_of(params, tensors, n, 1.05, n_layers, max_bond=32)\n    t1 = time.time()\n    print(f'n={n} dmrg={e0:.6f} E={e:.6f} time={t1-t0:.4f}s nparams={nparams}', flush=True)\nprint('done', flush=True)\nPY\necho finished\ncat /tmp/bench2.log\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
