{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\nL = 6\nh = 1.05\n# Pauli convention\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -1.0, 'Z', 'Z'\nbuilder += -h, 'X'\nH = builder.build_mpo(L)\n# Actually need to check if it uses Pauli or spin\nprint('try energy of product state')\n\ndmrg = qtn.DMRG2(H, bond_dims=[8], cutoffs=1e-12)\ndmrg.solve(max_sweeps=4, verbosity=0)\nmps = dmrg.state\nprint('energy', dmrg.energy)\nprint('norm', mps.norm())\nfor i,t in enumerate(mps.tensors):\n    print(i, t.data.shape, t.inds)\n\n# convert to tc MPS\ntensors = []\nfor i in range(L):\n    arr = np.asarray(mps.tensors[i].data)\n    # quimb typically uses (left, phys, right) or for ends without left/right\n    print('shape', arr.shape)\n\n# canonicalize and get arrays in left-phys-right form\nmps2 = mps.copy()\nmps2.canonicalize_(where=0)\ntensors = [np.asarray(mps2.tensors[i].data) for i in range(L)]\nfor i,t in enumerate(tensors):\n    print(i, t.shape)\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\nc = tc.MPSCircuit(L, tensors=tensors, center_position=0)\nprint('norm', c.get_norm())\n# energy via expectations\ndef energy(c):\n    e = 0\n    for i in range(L-1):\n        e += -c.expectation((tc.gates.z(), [i]), (tc.gates.z(), [i+1]), normalize=True)\n    for i in range(L):\n        e += -h * c.expectation((tc.gates.x(), [i]), normalize=True)\n    return e\nprint('E', energy(c))\nprint('dmrg E', dmrg.energy)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
