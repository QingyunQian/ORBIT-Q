{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"kill 59367 2>/dev/null; python -u - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax import value_and_grad\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nL=32; h=1.05; n_layers=4; chi=8; max_steps=500; lr=0.005\nbuilder=qtn.SpinHam1D(S=0.5,cyclic=False)\nbuilder += -4.,'Z','Z'; builder += -2*h,'X'\nH=builder.build_mpo(L)\ndmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\nmps=dmrg.state; mps.canonicalize_(where=0)\nprint('dmrg',dmrg.energy,flush=True)\n\ndef pad_tensor(t, chiL, chiR):\n    out = np.zeros((chiL,2,chiR), dtype=np.complex128)\n    out[:t.shape[0],:,:t.shape[2]] = t\n    return out\n\ndef to_padded(mps, chi):\n    ts=[]\n    for i in range(mps.nsites):\n        t=np.asarray(mps.tensors[i].data,dtype=np.complex128)\n        if t.ndim==2:\n            t = t.reshape(1,t.shape[0],t.shape[1]) if i==0 else t.reshape(t.shape[0],t.shape[1],1)\n        chiL = 1 if i==0 else chi\n        chiR = 1 if i==mps.nsites-1 else chi\n        ts.append(jnp.asarray(pad_tensor(t, chiL, chiR)))\n    return ts\n\nbase=to_padded(mps, chi)\nsplit={'max_singular_values': chi}\n\nI = jnp.eye(2, dtype=jnp.complex128)\nX = jnp.array([[0,1],[1,0]], dtype=jnp.complex128)\nY = jnp.array([[0,-1j],[1j,0]], dtype=jnp.complex128)\nZ = jnp.array([[1,0],[0,-1]], dtype=jnp.complex128)\nXX = jnp.kron(X,X).reshape(2,2,2,2)\nYY = jnp.kron(Y,Y).reshape(2,2,2,2)\nZZ = jnp.kron(Z,Z).reshape(2,2,2,2)\n\ndef make_mpo(L,h):\n    ts=[]\n    II=np.eye(2,dtype=np.complex128); Xp=np.array([[0,1],[1,0]],dtype=np.complex128); Zp=np.array([[1,0],[0,-1]],dtype=np.complex128)\n    for i in range(L):\n        W=np.zeros((3,2,2,3),dtype=np.complex128)\n        W[0,:,:,0]=II; W[0,:,:,1]=-Zp; W[0,:,:,2]=-h*Xp; W[1,:,:,2]=Zp; W[2,:,:,2]=II\n        if i==0: ts.append(jnp.asarray(W[0:1]))\n        elif i==L-1: ts.append(jnp.asarray(W[:,:,:,2:3]))\n        else: ts.append(jnp.asarray(W))\n    return ts\nHts=make_mpo(L,h)\n\ndef mps_e(ts,Hts):\n    env=jnp.ones((1,1,1),dtype=jnp.complex128)\n    for A,W in zip(ts,Hts):\n        env=jnp.einsum('awb,apx,wpqy,bqz->xyz', env, jnp.conj(A), W, A)\n    return env[0,0,0].real\ndef mps_n2(ts):\n    env=jnp.ones((1,1),dtype=jnp.complex128)\n    for A in ts:\n        env=jnp.einsum('ab,apx,bpy->xy', env, jnp.conj(A), A)\n    return env[0,0].real\n\ndef nparams(n,nl):\n    p=0\n    for layer in range(nl):\n        p+=3*n\n        bonds=list(range(0,n-1,2) if layer%2==0 else range(1,n-1,2))\n        p+=3*len(bonds)\n    return p\np=nparams(L,n_layers)\n\ndef rzryrz(a,b,g):\n    # use tc gates\n    return (tc.gates.rz_gate(a).tensor.reshape(2,2) @\n            tc.gates.ry_gate(b).tensor.reshape(2,2) @\n            tc.gates.rz_gate(g).tensor.reshape(2,2))\n\ndef heis(thxx, thyy, thzz):\n    # exp(-i(thxx XX+...)) via exp1 composition matrices\n    # Since XX\"'^2=I etc and they commute:\n    # exp(-i th XX)= cos(th)I - i sin(th) XX\n    def epu(th, U):\n        # U is 4x4 with U''^2=I\n        return jnp.cos(th)*jnp.eye(4,dtype=jnp.complex128) - 1j*jnp.sin(th)*U\n    U = epu(thxx, jnp.kron(X,X)) @ epu(thyy, jnp.kron(Y,Y)) @ epu(thzz, jnp.kron(Z,Z))\n    return U.reshape(2,2,2,2)\n\ndef energy_fn(params):\n    c=tc.MPSCircuit(L, tensors=base, center_position=0, split=split)\n    idx=0\n    for layer in range(n_layers):\n        for q in range(L):\n            a=params[idx]; b=params[idx+1]; g=params[idx+2]; idx+=3\n            c.unitary(q, unitary=rzryrz(a,b,g))\n        bonds=range(0,L-1,2) if layer%2==0 else range(1,L-1,2)\n        for bsite in bonds:\n            thxx=params[idx]; thyy=params[idx+1]; thzz=params[idx+2]; idx+=3\n            c.unitary(bsite, bsite+1, unitary=heis(thxx,thyy,thzz))\n    ts=c.get_tensors()\n    return mps_e(ts,Hts)/mps_n2(ts)\n\nparams0=jnp.zeros((p,),dtype=jnp.float64)\nprint('\"'E0 check', float(energy_fn(params0)), flush=True)\n\nbeta1=0.9; beta2=0.999; eps=1e-8\ndef adam_step(carry, _):\n    params, m, v, t = carry\n    e, g = value_and_grad(energy_fn)(params)\n    t = t + 1\n    m = beta1*m + (1-beta1)*g\n    v = beta2*v + (1-beta2)*(g*g)\n    mhat = m / (1 - beta1**t)\n    vhat = v / (1 - beta2**t)\n    params = params - lr * mhat / (jnp.sqrt(vhat)+eps)\n    return (params,m,v,t), e\n\nm0=jnp.zeros_like(params0); v0=jnp.zeros_like(params0); t0=jnp.array(0,dtype=jnp.int32)\nprint('compile', flush=True)\nt_start=time.time()\n@jax.jit\ndef run(params,m,v,t):\n    (params,m,v,t), hist = jax.lax.scan(adam_step, (params,m,v,t), xs=None, length=max_steps)\n    return hist\nhist = run(params0,m0,v0,t0)\nhist.block_until_ready()\nprint('total', time.time()-t_start, flush=True)\nprint('E0', float(hist[0]), 'Ef', float(hist[-1]), 'impr', float(hist[0]-hist[-1]), flush=True)\n# compare high-chi dmrg reference\ndmrg2=qtn.DMRG2(H,bond_dims=[64],cutoffs=1e-12); dmrg2.solve(max_sweeps=10,verbosity=0)\nprint('better dmrg', dmrg2.energy, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
