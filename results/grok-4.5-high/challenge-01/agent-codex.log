{"type":"item.started","item":{"id":"item_213","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, traceback\nimport numpy as np, jax, jax.numpy as jnp, quimb.tensor as qtn, tensorcircuit as tc, optax\ntc.set_backend('jax'); tc.set_dtype('complex64')\nout=open('/tmp/jitvg.txt','w',buffering=1)\ndef p(s):\n    out.write(s+'\\\\n'); out.flush()\n\ndef bench(n, n_layers, max_bond=32, steps=3):\n    field=1.05\n    p(f'==== n={n} L={n_layers}')\n    H=qtn.MPO_ham_ising(n,j=-4.0,bx=2*field,S=0.5,cyclic=False)\n    dmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\n    tensors=[]\n    for i in range(n):\n        t=np.asarray(dmrg.state.arrays[i],dtype=np.complex64)\n        if t.ndim==2:\n            t=t.reshape(1,*t.shape) if i==0 else t.reshape(*t.shape,1)\n        tensors.append(jnp.asarray(t))\n    p(f'dmrg {float(dmrg.energy)}')\n    nparams=0\n    for layer in range(n_layers):\n        nparams += n*3\n        bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n        nparams += len(bonds)*3\n    p(f'nparams {nparams}')\n    def energy(params):\n        c=tc.MPSCircuit(n, tensors=tensors, split={'max_singular_values': max_bond})\n        idx=0\n        for layer in range(n_layers):\n            for q in range(n):\n                c.rz(q,theta=params[idx]); c.ry(q,theta=params[idx+1]); c.rz(q,theta=params[idx+2]); idx+=3\n            bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n            for b in bonds:\n                c.exp1(b,b+1,theta=params[idx],unitary=tc.gates._xx_matrix)\n                c.exp1(b,b+1,theta=params[idx+1],unitary=tc.gates._yy_matrix)\n                c.exp1(b,b+1,theta=params[idx+2],unitary=tc.gates._zz_matrix)\n                idx+=3\n        e=0.0\n        for i in range(n-1):\n            e = e - jnp.real(c.expectation_ps(z=[i,i+1]))\n        for i in range(n):\n            e = e - field*jnp.real(c.expectation_ps(x=[i]))\n        return e\n    params=jnp.zeros((nparams,),jnp.float32)\n    vg=jax.jit(jax.value_and_grad(energy))\n    p('compile vg')\n    t0=time.time(); e,g=vg(params); e.block_until_ready(); g.block_until_ready();\n    p(f'compile {time.time()-t0} E={float(e)} |g|={float(jnp.linalg.norm(g))}')\n    t0=time.time()\n    for _ in range(steps):\n        e,g=vg(params); e.block_until_ready()\n    p(f'{steps} runs {time.time()-t0}')\n    # adam few steps\n    opt=optax.adam(0.005)\n    opt_state=opt.init(params)\n    @jax.jit\n    def step(params, opt_state):\n        e,g=jax.value_and_grad(energy)(params)\n        updates, opt_state = opt.update(g, opt_state, params)\n        params = optax.apply_updates(params, updates)\n        return params, opt_state, e\n    p('compile step')\n    t0=time.time(); params,opt_state,e=step(params,opt_state); e.block_until_ready(); p(f'step compile {time.time()-t0} E={float(e)}')\n    t0=time.time()\n    for i in range(10):\n        params,opt_state,e=step(params,opt_state)\n    e.block_until_ready()\n    p(f'10 steps {time.time()-t0} E={float(e)}')\n\ntry:\n    bench(8,2,max_bond=16)\n    bench(16,4,max_bond=24)\n    bench(32,4,max_bond=32)\n    p('ALLDONE')\nexcept Exception:\n    p(traceback.format_exc())\nout.close()\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
