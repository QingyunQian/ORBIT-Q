{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax import value_and_grad\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nL=32; h=1.05; n_layers=4; chi=16; max_steps=500; lr=0.005\nbuilder=qtn.SpinHam1D(S=0.5,cyclic=False)\nbuilder += -4.,'Z','Z'; builder += -2*h,'X'\nH=builder.build_mpo(L)\ndmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\nmps=dmrg.state; mps.canonicalize_(where=0)\nprint('dmrg',dmrg.energy,flush=True)\n\ndef pad_tensor(t, chiL, chiR):\n    out = np.zeros((chiL,2,chiR), dtype=np.complex128)\n    out[:t.shape[0],:,:t.shape[2]] = t\n    return out\n\ndef to_padded(mps, chi):\n    ts=[]\n    for i in range(mps.nsites):\n        t=np.asarray(mps.tensors[i].data,dtype=np.complex128)\n        if t.ndim==2:\n            t = t.reshape(1,t.shape[0],t.shape[1]) if i==0 else t.reshape(t.shape[0],t.shape[1],1)\n        chiL = 1 if i==0 else chi\n        chiR = 1 if i==mps.nsites-1 else chi\n        ts.append(jnp.asarray(pad_tensor(t, chiL, chiR)))\n    return ts\n\nbase=to_padded(mps, chi)\nsplit={'max_singular_values': chi}\nXX=tc.gates._xx_matrix; YY=tc.gates._yy_matrix; ZZ=tc.gates._zz_matrix\n\nI=np.eye(2,dtype=np.complex128); X=np.array([[0,1],[1,0]],dtype=np.complex128); Z=np.array([[1,0],[0,-1]],dtype=np.complex128)\ndef make_mpo(L,h):\n    ts=[]\n    for i in range(L):\n        W=np.zeros((3,2,2,3),dtype=np.complex128)\n        W[0,:,:,0]=I; W[0,:,:,1]=-Z; W[0,:,:,2]=-h*X; W[1,:,:,2]=Z; W[2,:,:,2]=I\n        if i==0: ts.append(jnp.asarray(W[0:1]))\n        elif i==L-1: ts.append(jnp.asarray(W[:,:,:,2:3]))\n        else: ts.append(jnp.asarray(W))\n    return ts\nHts=make_mpo(L,h)\n\ndef mps_e(ts,Hts):\n    env=jnp.ones((1,1,1),dtype=jnp.complex128)\n    for A,W in zip(ts,Hts):\n        env=jnp.einsum('awb,apx,wpqy,bqz->xyz', env, jnp.conj(A), W, A)\n    return env[0,0,0].real\ndef mps_n2(ts):\n    env=jnp.ones((1,1),dtype=jnp.complex128)\n    for A in ts:\n        env=jnp.einsum('ab,apx,bpy->xy', env, jnp.conj(A), A)\n    return env[0,0].real\n\ndef nparams(n,nl):\n    p=0\n    for layer in range(nl):\n        p+=3*n\n        bonds=list(range(0,n-1,2) if layer%2==0 else range(1,n-1,2))\n        p+=3*len(bonds)\n    return p\np=nparams(L,n_layers)\n\ndef energy_fn(params):\n    c=tc.MPSCircuit(L, tensors=base, center_position=0, split=split)\n    idx=0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q,theta=params[idx]); idx+=1\n            c.ry(q,theta=params[idx]); idx+=1\n            c.rz(q,theta=params[idx]); idx+=1\n        bonds=range(0,L-1,2) if layer%2==0 else range(1,L-1,2)\n        for b in bonds:\n            thxx=params[idx];idx+=1; thyy=params[idx];idx+=1; thzz=params[idx];idx+=1\n            c.exp1(b,b+1,theta=thxx,unitary=XX)\n            c.exp1(b,b+1,theta=thyy,unitary=YY)\n            c.exp1(b,b+1,theta=thzz,unitary=ZZ)\n    ts=c.get_tensors()\n    return mps_e(ts,Hts)/mps_n2(ts)\n\n# small random init near identity\nkey=jax.random.PRNGKey(0)\nparams0=0.01*jax.random.normal(key,(p,),dtype=jnp.float64)\nprint('E init random', float(energy_fn(params0)), flush=True)\nprint('E zero', float(energy_fn(jnp.zeros((p,),dtype=jnp.float64))), flush=True)\n\nbeta1=0.9; beta2=0.999; eps=1e-8\ndef adam_step(carry, _):\n    params, m, v, t = carry\n    e, g = value_and_grad(energy_fn)(params)\n    t = t + 1\n    m = beta1*m + (1-beta1)*g\n    v = beta2*v + (1-beta2)*(g*g)\n    mhat = m / (1-beta1**t)\n    vhat = v / (1-beta2**t)\n    params = params - lr * mhat / (jnp.sqrt(vhat) + eps)\n    return (params, m, v, t), e\n\nm0=jnp.zeros_like(params0); v0=jnp.zeros_like(params0); tt=jnp.array(0,dtype=jnp.int32)\nprint('compile...', flush=True)\nt_start=time.time()\n@jax.jit\ndef run(params,m,v,t):\n    (params,m,v,t), hist = jax.lax.scan(adam_step, (params,m,v,t), xs=None, length=max_steps)\n    return params, hist\nparams_f, hist = run(params0,m0,v0,tt)\nhist.block_until_ready()\nprint('total', time.time()-t_start, flush=True)\nprint('E0', float(hist[0]), 'Ef', float(hist[-1]), 'min', float(jnp.min(hist)), 'impr', float(hist[0]-hist[-1]), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
