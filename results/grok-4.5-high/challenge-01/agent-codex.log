{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax import value_and_grad\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nL = 32\nh = 1.05\nn_layers = 4\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -4.0, 'Z', 'Z'\nbuilder += -2*h, 'X'\nHmpo = builder.build_mpo(L)\ndmrg = qtn.DMRG2(Hmpo, bond_dims=[8], cutoffs=1e-10)\ndmrg.solve(max_sweeps=2, verbosity=0)\nmps = dmrg.state\nmps.canonicalize_(where=0)\nprint('dmrg', dmrg.energy, flush=True)\n\ndef to_tc_tensors(mps):\n    tensors = []\n    for i in range(mps.nsites):\n        t = np.asarray(mps.tensors[i].data, dtype=np.complex128)\n        if t.ndim == 2:\n            if i == 0:\n                t = t.reshape(1, t.shape[0], t.shape[1])\n            else:\n                t = t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(jnp.asarray(t))\n    return tensors\n\nbase_tensors = to_tc_tensors(mps)\n\n# Build fixed-shape padded tensors for jax friendliness? variable chi is painful.\n# Check bond dims\nprint('shapes', [tuple(t.shape) for t in base_tensors], flush=True)\n\n# Convert H MPO tensors to left-phys_out-phys_in-right style with boundary bonds 1\ndef mpo_tensors(H):\n    ts=[]\n    for i in range(H.L):\n        arr = np.asarray(H.tensors[i].data, dtype=np.complex128)\n        # quimb: ends (mpo_bond, k, b) or (mpoL, mpoR, k, b)\n        if arr.ndim==3:\n            if i==0:\n                # (R, k, b) -> (1, k, b, R)\n                arr = arr.transpose(1,2,0)[None,...]  # (1,k,b,R)\n            else:\n                # (L,k,b) -> (L,k,b,1)\n                arr = arr[...,None]\n        else:\n            # (L,R,k,b) -> (L,k,b,R)\n            arr = arr.transpose(0,2,3,1)\n        ts.append(jnp.asarray(arr))\n    return ts\n\nH_tensors = mpo_tensors(Hmpo)\nprint('H shapes', [tuple(t.shape) for t in H_tensors[:3]], [tuple(H_tensors[-1].shape)], flush=True)\n\n# Efficient energy via sequential contraction W[a,b] = L env\ndef mps_mpo_energy(mps_tensors, mpo_tensors):\n    # Assume normalized MPS roughly; compute <psi|H|psi>/<psi|psi>\n    # left env E shape (chi_mps, chi_mpo, chi_mps)\n    t0 = mps_tensors[0]  # (1,2,chi)\n    w0 = mpo_tensors[0]  # (1,2,2,Dw)\n    # E = sum_{p,p'} t0[0,p,:].conj() * W[0,p,p',:] * t0[0,p',:]\n    # start env as 1\n    env = jnp.array([1.0+0j]).reshape(1,1,1)  # (chiL, DwL, chiL)\n    for i in range(len(mps_tensors)):\n        A = mps_tensors[i]      # (Dl, p, Dr)\n        W = mpo_tensors[i]      # (wl, p, p', wr)\n        # env: a,w,b\n        # contract: a,w,b ; a,p,a2 ; w,p,p',w2 ; b,p',b2 -> a2,w2,b2\n        env = jnp.einsum('awb,apx,wpqy,bqy->xwy', env, A.conj(), W, A)\n    # env should be (1,1,1)\n    return env[0,0,0].real\n\n# norm\ndef mps_norm2(mps_tensors):\n    env = jnp.array([1.0+0j]).reshape(1,1)\n    for A in mps_tensors:\n        env = jnp.einsum('ab,apx,bpy->xy', env, A.conj(), A)\n    return env[0,0].real\n\nts = base_tensors\ne = mps_mpo_energy(ts, H_tensors)\nn2 = mps_norm2(ts)\nprint('fast E', float(e/n2), 'n2', float(n2), flush=True)\n\n# time circuit + fast energy\nsplit = {\\\"max_singular_values\\\": 12}\nXX = tc.gates._xx_matrix\nYY = tc.gates._yy_matrix\nZZ = tc.gates._zz_matrix\np = 570\nparams0 = jnp.zeros((p,), dtype=jnp.float64)\n\ndef energy_fn(params):\n    c = tc.MPSCircuit(L, tensors=base_tensors, center_position=0, split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q, theta=params[idx]); idx+=1\n            c.ry(q, theta=params[idx]); idx+=1\n            c.rz(q, theta=params[idx]); idx+=1\n        bonds = range(0, L-1, 2) if layer % 2 == 0 else range(1, L-1, 2)\n        for b in bonds:\n            thxx = params[idx]; idx+=1\n            thyy = params[idx]; idx+=1\n            thzz = params[idx]; idx+=1\n            c.exp1(b, b+1, theta=thxx, unitary=XX)\n            c.exp1(b, b+1, theta=thyy, unitary=YY)\n            c.exp1(b, b+1, theta=thzz, unitary=ZZ)\n    mps_ts = c.get_tensors()\n    # ensure 3d\n    mps_ts = [jnp.reshape(t, t.shape if t.ndim==3 else ((1,)+t.shape if i==0 else t.shape+(1,))) for i,t in enumerate(mps_ts)]\n    e = mps_mpo_energy(mps_ts, H_tensors)\n    n2 = mps_norm2(mps_ts)\n    return e/n2\n\nprint('energy...', flush=True)\nt0=time.time(); e=energy_fn(params0); e.block_until_ready(); print('E', float(e), time.time()-t0, flush=True)\nprint('vg1...', flush=True)\nt0=time.time(); e,g=value_and_grad(energy_fn)(params0); e.block_until_ready(); g.block_until_ready(); print(float(e), float(jnp.linalg.norm(g)), time.time()-t0, flush=True)\nprint('vg2...', flush=True)\nt0=time.time(); e,g=value_and_grad(energy_fn)(params0); e.block_until_ready(); g.block_until_ready(); print(float(e), time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
