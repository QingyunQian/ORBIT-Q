ond = 24  def energy_of(params):     split = {\"max_singular_values\": max_bond}     c = tc.MPSCircuit(n, tensors=tensors, split=split)     idx = 0     for layer in range(n_layers):         for q in range(n):             rz1 = params[idx]; ry=params[idx+1]; rz2=params[idx+2]             idx += 3             c.rz(q, theta=rz1)             c.ry(q, theta=ry)             c.rz(q, theta=rz2)         bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))         for b in bonds:             txx=params[idx]; tyy=params[idx+1]; tzz=params[idx+2]             idx += 3             c.rxx(b, b+1, theta=2*txx)             c.ryy(b, b+1, theta=2*tyy)             c.rzz(b, b+1, theta=2*tzz)     e = 0.0     for i in range(n-1):         e = e - jnp.real(c.expectation_ps(z=[i, i+1]))     for i in range(n):         e = e - field * jnp.real(c.expectation_ps(x=[i]))     return e  params = jnp.zeros((nparams,), dtype=jnp.float32)  print('jit energy...', flush=True) e_jit = jax.jit(energy_of) t0=time.time(); e=e_jit(params); e.block_until_ready(); print('energy compile', time.time()-t0, float(e), flush=True) t0=time.time(); e=e_jit(params); e.block_until_ready(); print('energy run', time.time()-t0, float(e), flush=True)  print('jit val_and_grad...', flush=True) vg = jax.jit(jax.value_and_grad(energy_of)) t0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg compile', time.time()-t0, float(e), float(jnp.linalg.norm(g)), flush=True) t0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg run', time.time()-t0, float(e), flush=True) print('done', flush=True) PY echo EXIT:$? cat /tmp/bench3.log \n762 python -\n922 /bin/bash -c date; cat /tmp/bench3.log; pgrep -af python | head -20; ls -la /tmp/bench3.log \n-rw-r--r-- 1 root root 175 Aug  5 17:13 /tmp/bench3.log\n","exit_code":0,"status":"completed"}}
