{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\n# Build TFIM with MPO\nn = 8\nfield = 1.05\nbuilder = qtn.SpinHam1D(S=1/2)\nbuilder += -1.0, 'Z', 'Z'\nbuilder += -field, 'X'\nH = builder.build_mpo(n)\nprint(type(H), H)\n\ndmrg = qtn.DMRG2(H, bond_dims=[8], cutoffs=1e-10)\ninfo = dmrg.solve(max_sweeps=2, verbosity=0)\npsi = dmrg.state\nprint('energy', dmrg.energy)\nprint('norm', psi.norm())\n# arrays\nfor i in range(n):\n    a = psi.arrays[i]\n    print(i, np.asarray(a).shape)\n\n# Convert to TC MPS - quimb arrays are (l, p, r) typically\ntensors = [np.asarray(psi.arrays[i], dtype=np.complex128) for i in range(n)]\n# ensure left/right dims\n# first site may be (p, r) or (1,p,r)\nfixed = []\nfor i,t in enumerate(tensors):\n    t = np.asarray(t)\n    if t.ndim == 2:\n        if i == 0:\n            t = t.reshape(1, t.shape[0], t.shape[1])\n        else:\n            t = t.reshape(t.shape[0], t.shape[1], 1)\n    fixed.append(t)\n    print('fixed', i, t.shape)\n\nc = tc.MPSCircuit(n, tensors=fixed)\nprint('norm', c.get_norm())\n# energy via expectation_ps\ne = 0\nfor i in range(n-1):\n    e += -c.expectation_ps(z=[i,i+1])\nfor i in range(n):\n    e += -field * c.expectation_ps(x=[i])\nprint('TC energy', complex(e))\nprint('DMRG energy', dmrg.energy)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
