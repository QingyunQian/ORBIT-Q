  c.rz(q, theta=params[idx])\n                c.ry(q, theta=params[idx + 1])\n                c.rz(q, theta=params[idx + 2])\n                idx += 3\n            bonds = (\n                list(range(0, n - 1, 2))\n                if (layer % 2 == 0)\n                else list(range(1, n - 1, 2))\n            )\n            for b in bonds:\n                # exp(-i (θxx XX + θyy YY + θzz ZZ)) via commuting half-angle RXX etc.\n                # rxx(φ)=exp(-i φ XX/2) => φ=2θ\n                c.rxx(b, b + 1, theta=2.0 * params[idx])\n                c.ryy(b, b + 1, theta=2.0 * params[idx + 1])\n                c.rzz(b, b + 1, theta=2.0 * params[idx + 2])\n                idx += 3\n        e = jnp.asarray(0.0, dtype=jnp.float32)\n        for i in range(n - 1):\n            e = e - jnp.real(c.expectation_ps(z=[i, i + 1])).astype(jnp.float32)\n        for i in range(n):\n            e = e - jnp.float32(field) * jnp.real(c.expectation_ps(x=[i])).astype(\n                jnp.float32\n            )\n        return e\n\n    # Identity-initialized refinement on top of DMRG-MPS.\n    params = jnp.zeros((nparams,), dtype=jnp.float32)\n    optimizer = optax.adam(lr)\n    opt_state = optimizer.init(params)\n\n    @jax.jit\n    def step(params, opt_state):\n        e, g = jax.value_and_grad(energy)(params)\n        updates, opt_state = optimizer.update(g, opt_state, params)\n        params = optax.apply_updates(params, updates)\n        return params, opt_state, e\n\n    # Warmup / compile\n    params, opt_state, _ = step(params, opt_state)\n    # The warmup already took one step; rebuild cleanly for exact 500 recorded steps.\n    params = jnp.zeros((nparams,), dtype=jnp.float32)\n    opt_state = optimizer.init(params)\n\n    history = np.empty((max_steps,), dtype=np.float64)\n    for i in range(max_steps):\n        params, opt_state, e = step(params, opt_state)\n        history[i] = float(e)\n\n    return {\\\"energy_history\\\": history}\nPY\necho written\nwc -l /root/solution_1.py\n\"","aggregated_output":"written\n105 /root/solution_1.py\n","exit_code":0,"status":"completed"}}
