{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nfrom jax import value_and_grad\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nL = 32\nh = 1.05\nn_layers = 4\n\nI = np.eye(2, dtype=np.complex128)\nX = np.array([[0,1],[1,0]], dtype=np.complex128)\nZ = np.array([[1,0],[0,-1]], dtype=np.complex128)\n\ndef make_tfim_mpo(L, h):\n    Dw=3\n    tensors=[]\n    for i in range(L):\n        W = np.zeros((Dw,2,2,Dw), dtype=np.complex128)\n        W[0,:,:,0] = I\n        W[0,:,:,1] = -Z\n        W[0,:,:,2] = -h*X\n        W[1,:,:,2] = Z\n        W[2,:,:,2] = I\n        if i==0:\n            tensors.append(jnp.asarray(W[0:1]))\n        elif i==L-1:\n            tensors.append(jnp.asarray(W[:,:,:,2:3]))\n        else:\n            tensors.append(jnp.asarray(W))\n    return tensors\n\nH_tensors = make_tfim_mpo(L,h)\n\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -4.0, 'Z', 'Z'\nbuilder += -2*h, 'X'\nHmpo = builder.build_mpo(L)\ndmrg = qtn.DMRG2(Hmpo, bond_dims=[8], cutoffs=1e-10)\ndmrg.solve(max_sweeps=2, verbosity=0)\nmps = dmrg.state\nmps.canonicalize_(where=0)\nprint('dmrg', dmrg.energy, flush=True)\n\ndef to_tc_tensors(mps):\n    tensors = []\n    for i in range(mps.nsites):\n        t = np.asarray(mps.tensors[i].data, dtype=np.complex128)\n        if t.ndim == 2:\n            if i == 0:\n                t = t.reshape(1, t.shape[0], t.shape[1])\n            else:\n                t = t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(jnp.asarray(t))\n    return tensors\n\nbase_tensors = to_tc_tensors(mps)\n\ndef mps_mpo_energy(mps_tensors, mpo_ts):\n    env = jnp.asarray([1.0+0j]).reshape(1,1,1)\n    for A,W in zip(mps_tensors, mpo_ts):\n        env = jnp.einsum('awb,apx,wpqy,bqz->xyz', env, jnp.conj(A), W, A)\n    return env[0,0,0].real\n\ndef mps_norm2(mps_tensors):\n    env = jnp.asarray([1.0+0j]).reshape(1,1)\n    for A in mps_tensors:\n        env = jnp.einsum('ab,apx,bpy->xy', env, jnp.conj(A), A)\n    return env[0,0].real\n\ne = mps_mpo_energy(base_tensors, H_tensors)\nn2 = mps_norm2(base_tensors)\nprint('fast E', float(e/n2), 'n2', float(n2), flush=True)\n\nsplit = {\\\"max_singular_values\\\": 12}\nXX = tc.gates._xx_matrix\nYY = tc.gates._yy_matrix\nZZ = tc.gates._zz_matrix\n\ndef count_params(n, n_layers):\n    p=0\n    for layer in range(n_layers):\n        p += 3*n\n        bonds = list(range(0,n-1,2) if layer%2==0 else range(1,n-1,2))\n        p += 3*len(bonds)\n    return p\np = count_params(L,n_layers)\nparams0 = jnp.zeros((p,), dtype=jnp.float64)\n\ndef energy_fn(params):\n    c = tc.MPSCircuit(L, tensors=base_tensors, center_position=0, split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q, theta=params[idx]); idx+=1\n            c.ry(q, theta=params[idx]); idx+=1\n            c.rz(q, theta=params[idx]); idx+=1\n        bonds = range(0, L-1, 2) if layer % 2 == 0 else range(1, L-1, 2)\n        for b in bonds:\n            thxx = params[idx]; idx+=1\n            thyy = params[idx]; idx+=1\n            thzz = params[idx]; idx+=1\n            c.exp1(b, b+1, theta=thxx, unitary=XX)\n            c.exp1(b, b+1, theta=thyy, unitary=YY)\n            c.exp1(b, b+1, theta=thzz, unitary=ZZ)\n    mps_ts = c.get_tensors()\n    e = mps_mpo_energy(mps_ts, H_tensors)\n    n2 = mps_norm2(mps_ts)\n    return e/n2\n\nprint('energy...', flush=True)\nt0=time.time(); e=energy_fn(params0); e.block_until_ready(); print('E', float(e), time.time()-t0, flush=True)\nprint('vg1...', flush=True)\nvag = value_and_grad(energy_fn)\nt0=time.time(); e,g=vag(params0); e.block_until_ready(); g.block_until_ready(); print(float(e), float(jnp.linalg.norm(g)), time.time()-t0, flush=True)\nprint('vg2...', flush=True)\nt0=time.time(); e,g=vag(params0); e.block_until_ready(); g.block_until_ready(); print(float(e), time.time()-t0, flush=True)\nprint('vg3...', flush=True)\nt0=time.time(); e,g=vag(params0+1e-3); e.block_until_ready(); g.block_until_ready(); print(float(e), float(jnp.linalg.norm(g)), time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
