{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport numpy as np\nimport jax.numpy as jnp\n\n# Build TFIM MPO ourselves\n# H = -sum ZZ - h sum X\n# Standard MPO for open TFIM:\n# W = [[I, -Z, -h X],\n#      [0, 0, Z],\n#      [0, 0, I]]\n# as operator valued matrix\n\nI = np.eye(2, dtype=np.complex128)\nX = np.array([[0,1],[1,0]], dtype=np.complex128)\nZ = np.array([[1,0],[0,-1]], dtype=np.complex128)\nh=1.05\n\ndef make_tfim_mpo(L, h):\n    Dw=3\n    tensors=[]\n    for i in range(L):\n        W = np.zeros((Dw,2,2,Dw), dtype=np.complex128)\n        # W[a,p,p',b]\n        W[0,:,:,0] = I\n        W[0,:,:,1] = -Z\n        W[0,:,:,2] = -h*X\n        W[1,:,:,2] = Z\n        W[2,:,:,2] = I\n        if i==0:\n            # left boundary row vector [I, -Z, -hX] -> take first row? actually left is (1,:,:,Dw) = W[0]\n            tensors.append(W[0:1])  # (1,2,2,3)\n        elif i==L-1:\n            # right boundary col [ -hX, Z, I]\"'^T -> W[:,:,:,2]\n            tensors.append(W[:,:,:,2:3])\n        else:\n            tensors.append(W)\n    return tensors\n\ndef mps_mpo_energy(mps_tensors, mpo_ts):\n    env = jnp.asarray([1.0+0j]).reshape(1,1,1)\n    for A,W in zip(mps_tensors, mpo_ts):\n        print('\"'A',A.shape,'W',W.shape,'env',env.shape)\n        env = jnp.einsum('awb,apx,wpqy,bqz->xzy', env, jnp.conj(A), W, A)\n    return env[0,0,0].real\n\n# random product mps\nL=4\nmps=[]\nrng=np.random.default_rng(0)\nfor i in range(L):\n    A=rng.normal(size=(1 if i==0 else 2, 2, 1 if i==L-1 else 2)) + 1j*rng.normal(size=(1 if i==0 else 2, 2, 1 if i==L-1 else 2))\n    mps.append(jnp.asarray(A.astype(np.complex128)))\n# normalize roughly\n# compute exact energy via full state\ndef mps_to_state(ts):\n    s=ts[0][0] # (p,r)\n    # s shape (p,r)\n    left=ts[0].reshape(2, ts[0].shape[-1])\n    for A in ts[1:]:\n        left = np.einsum('pa,aqb->pqb', left, A).reshape(-1, A.shape[-1])\n    return left.reshape(-1)\n\nst = mps_to_state([np.asarray(t) for t in mps])\nst = st/np.linalg.norm(st)\n# build H dense\ndef H_dense(L,h):\n    dim=2**L\n    H=np.zeros((dim,dim),dtype=np.complex128)\n    for i in range(L-1):\n        op=1\n        for q in range(L):\n            if q==i or q==i+1:\n                op=np.kron(op,Z)\n            else:\n                op=np.kron(op,I)\n        H += -op\n    for i in range(L):\n        op=1\n        for q in range(L):\n            if q==i:\n                op=np.kron(op,X)\n            else:\n                op=np.kron(op,I)\n        H += -h*op\n    return H\nHd=H_dense(L,h)\nEexact = np.vdot(st, Hd@st).real\nprint('exact', Eexact)\n\nmpo=make_tfim_mpo(L,h)\n# pad mps bonds to match\ne=mps_mpo_energy(mps, [jnp.asarray(w) for w in mpo])\n# norm\nenv=jnp.asarray([1+0j]).reshape(1,1)\nfor A in mps:\n    env=jnp.einsum('ab,apx,bpy->xy',env,jnp.conj(A),A)\nn2=env[0,0].real\nprint('mpo E', float(e/n2), 'n2', float(n2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
