{"type":"item.started","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY' > /tmp/bench5.log 2>&1\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn=32\nfield=1.05\nn_layers=4\nH = qtn.MPO_ham_ising(n, j=-4.0, bx=2*field, S=1/2, cyclic=False)\ndmrg = qtn.DMRG2(H, bond_dims=[8], cutoffs=1e-10)\ndmrg.solve(max_sweeps=2, verbosity=0)\npsi=dmrg.state\ntensors=[]\nfor i in range(n):\n    t=np.asarray(psi.arrays[i], dtype=np.complex64)\n    if t.ndim==2:\n        t=t.reshape(1,t.shape[0],t.shape[1]) if i==0 else t.reshape(t.shape[0],t.shape[1],1)\n    tensors.append(jnp.asarray(t))\nprint('dmrg', dmrg.energy, flush=True)\n\nnparams=0\nfor layer in range(n_layers):\n    nparams += n*3\n    bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n    nparams += len(bonds)*3\nprint('nparams', nparams, flush=True)\n\ndef energy_of(params):\n    c = tc.Circuit(n, tensors=tensors)\n    idx=0\n    for layer in range(n_layers):\n        for q in range(n):\n            c.rz(q, theta=params[idx]); c.ry(q, theta=params[idx+1]); c.rz(q, theta=params[idx+2]); idx+=3\n        bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n        for b in bonds:\n            # combined XX+YY+ZZ via successive commuting gates\n            c.rxx(b,b+1,theta=2*params[idx]); c.ryy(b,b+1,theta=2*params[idx+1]); c.rzz(b,b+1,theta=2*params[idx+2]); idx+=3\n    e = 0.0\n    for i in range(n-1):\n        e = e - jnp.real(c.expectation((tc.gates.z(),[i]), (tc.gates.z(),[i+1]), enable_lightcone=True))\n    for i in range(n):\n        e = e - field*jnp.real(c.expectation((tc.gates.x(),[i]), enable_lightcone=True))\n    return e\n\nparams = jnp.zeros((nparams,), dtype=jnp.float32)\nej = jax.jit(energy_of)\nprint('compiling energy', flush=True)\nt0=time.time(); e=ej(params); e.block_until_ready(); print('compile', time.time()-t0, float(e), flush=True)\nt0=time.time();\nfor _ in range(5):\n    e=ej(params); e.block_until_ready()\nprint('5 runs', time.time()-t0, float(e), flush=True)\n\n# parameter shift for one param\ndef grad_paramshift(params):\n    # shift = pi/2 for R gates with generator half convention?\n    # Our gates: rz(theta)=exp(-i theta Z/2), rxx(2t)=exp(-i t XX)\n    # For U=exp(-i theta G/2) with G\"'^2=1, d/dtheta <H> = (<H>_{theta+pi/2} - <H>_{theta-pi/2})/2\n    # For rz,ry: standard param shift with s=pi/2, scale 1/2\n    # For rxx(2t): d/dt = d/d(alpha)*d(alpha)/dt where alpha=2t, d/d alpha has scale 1/2, so d/dt scale 1\n    # Easier: numerical check later. Use general: for exp(-i theta P/2), grad = 0.5*(E+ - E-)\n    eyes = jnp.eye(nparams, dtype=params.dtype)\n    # We'\"'ll do a simple loop first with jit of single energy only\n    grads = []\n    # classify scales - all singles use 0.5; doubles: gate angle is 2*param so effective generator scale: \n    # dE/dparam = dE/dangle * 2, dE/dangle = 0.5*(E+-E-) for angle in rxx(angle)=exp(-i angle XX/2)\n    # so dE/dparam = 1.0*(E+(shift on angle=2param) ...)\n    # If we shift param by pi/4, angle shifts by pi/2. Then dE/dparam = (E+-E-) * (0.5 * 2) /1? \n    # Let alpha=2*p, E(p)=f(alpha), dE/dp = f'(alpha)*2, f'=0.5*(f(a+pi/2)-f(a-pi/2))\n    # so dE/dp = (f(a+pi/2)-f(a-pi/2)) = E(p+pi/4)-E(p-pi/4)\n    return None\n\n# time 10 energy evals\nt0=time.time()\nfor i in range(10):\n    p = params.at[i].set(0.001)\n    e=ej(p); e.block_until_ready()\nprint('10 shifted', time.time()-t0, flush=True)\n\n# Try value_and_grad with NO jit for a few steps timing\nprint('unjitted vg once', flush=True)\nvg = jax.value_and_grad(energy_of)\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('unjit vg', time.time()-t0, float(e), float(jnp.linalg.norm(g)), flush=True)\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('unjit vg2', time.time()-t0, float(e), flush=True)\nprint('done', flush=True)\nPY\necho launched\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
