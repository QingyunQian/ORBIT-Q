nds:\n                # exp[-i(θxx XX + θyy YY + θzz ZZ)] via commuting RXX/RYY/RZZ\n                c.rxx(b, b + 1, theta=2.0 * params[idx])\n                c.ryy(b, b + 1, theta=2.0 * params[idx + 1])\n                c.rzz(b, b + 1, theta=2.0 * params[idx + 2])\n                idx += 3\n        e = jnp.float32(0.0)\n        for i in range(n - 1):\n            e = e - jnp.real(c.expectation_ps(z=[i, i + 1])).astype(jnp.float32)\n        f = jnp.float32(field)\n        for i in range(n):\n            e = e - f * jnp.real(c.expectation_ps(x=[i])).astype(jnp.float32)\n        return e\n\n    params0 = jnp.zeros((nparams,), dtype=jnp.float32)\n    opt = optax.adam(lr)\n    opt_state0 = opt.init(params0)\n\n    def step(carry, _):\n        params, opt_state = carry\n        e, g = jax.value_and_grad(energy)(params)\n        updates, opt_state = opt.update(g, opt_state, params)\n        params = optax.apply_updates(params, updates)\n        return (params, opt_state), e\n\n    # JIT the scanned optimization (compile once)\n    @jax.jit\n    def run_all(params, opt_state):\n        (params, opt_state), hist = jax.lax.scan(step, (params, opt_state), None, length=max_steps)\n        return hist\n\n    hist = run_all(params0, opt_state0)\n    hist = np.asarray(hist, dtype=np.float64)\n    return {\\\"energy_history\\\": hist}\nPY\n# quick test with file log\ncat > /tmp/runsol.py <<'PY'\nimport time,traceback,sys\nsys.path.insert(0,'/root')\nimport quimb.tensor as qtn\nfrom importlib import reload\nimport solution_1\nreload(solution_1)\nout=open('/tmp/runsol.log','w',buffering=1)\ndef p(s):\n    out.write(s+'\\\\n'); out.flush()\ntry:\n p('dmrg')\n n,field=32,1.05\n H=qtn.MPO_ham_ising(n,j=-4.0,bx=2*field,S=0.5,cyclic=False)\n dmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\n psi=dmrg.state; psi.normalize()\n p(str(float(dmrg.energy)))\n cfg=dict(n_qubits=32,field=1.05,dmrg_chi=8,dmrg_sweeps=2,n_layers=4,max_steps=500,learning_rate=0.005,dmrg_state=psi,dmrg_energy=float(dmrg.energy))\n p('run_solution')\n t0=time.time()\n res=solution_1.run_solution(cfg)\n p(f'time {time.time()-t0}')\n h=res['energy_history']\n p(f'shape {h.shape} first {h[0]} last {h[-1]} min {h.min()} finite {np.isfinite(h).all()}')\n import numpy as np\n p(f'dmrg {cfg[\\\"dmrg_energy\\\"]} delta_init {h[0]-cfg[\\\"dmrg_energy\\\"]} improve {h[0]-h[-1]}')\nexcept Exception:\n p(traceback.format_exc())\nout.close()\nPY\npython /tmp/runsol.py &\necho pid=\"'$!\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
