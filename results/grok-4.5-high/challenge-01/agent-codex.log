oat32)\n        for i in range(n-1):\n            e = e - jnp.real(c.expectation_ps(z=[i,i+1])).astype(jnp.float32)\n        for i in range(n):\n            e = e - jnp.float32(field)*jnp.real(c.expectation_ps(x=[i])).astype(jnp.float32)\n        return e\n    params=jnp.zeros((nparams,), jnp.float32)\n    p('energy eager')\n    t0=time.time(); e=energy(params); p(f'eager E={float(e)} t={time.time()-t0}')\n    p('jit energy')\n    ej=jax.jit(energy)\n    t0=time.time(); e=ej(params).block_until_ready(); p(f'jitE E={float(e)} t={time.time()-t0}')\n    t0=time.time(); e=ej(params).block_until_ready(); p(f'jitE2 t={time.time()-t0}')\n    p('jit vg')\n    vg=jax.jit(jax.value_and_grad(energy))\n    t0=time.time(); e,g=vg(params); e.block_until_ready(); g.block_until_ready(); p(f'VG E={float(e)} |g|={float(jnp.linalg.norm(g))} t={time.time()-t0}')\n    t0=time.time(); e,g=vg(params); e.block_until_ready(); p(f'VG2 t={time.time()-t0}')\n    p('DONE')\nexcept Exception:\n    p(traceback.format_exc())\nfinally:\n    log.close()\nPY\npython /tmp/mps32.py > /tmp/mps32_stdout.log 2>&1 &\necho PID=\"'$!\necho $! > /tmp/mps32.pid\nsleep 8\ncat /tmp/mps32.log\nps -p $(cat /tmp/mps32.pid) -o etime,pcpu,pmem\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
