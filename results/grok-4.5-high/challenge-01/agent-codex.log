nds=('_6981d3AAAAE', '_6981d3AAAAF', 'k4', 'b4'), tags=oset(['I4'])),\n    Tensor(shape=(3, 3, 2, 2), inds=('_6981d3AAAAF', '_6981d3AAAAG', 'k5', 'b5'), tags=oset(['I5'])),\n    Tensor(shape=(3, 3, 2, 2), inds=('_6981d3AAAAG', '_6981d3AAAAH', 'k6', 'b6'), tags=oset(['I6'])),\n    Tensor(shape=(3, 2, 2), inds=('_6981d3AAAAH', 'k7', 'b7'), tags=oset(['I7'])),\n], tensors=8, indices=23, L=8, max_bond=3)\nenergy -4.410515813762378\nnorm 0.9999999999999991\n0 (2, 2)\n1 (2, 2, 4)\n2 (4, 2, 5)\n3 (5, 2, 5)\n4 (5, 2, 5)\n5 (5, 2, 4)\n6 (4, 2, 2)\n7 (2, 2)\nfixed 0 (1, 2, 2)\nfixed 1 (2, 2, 4)\nfixed 2 (4, 2, 5)\nfixed 3 (5, 2, 5)\nfixed 4 (5, 2, 5)\nfixed 5 (5, 2, 4)\nfixed 6 (4, 2, 2)\nfixed 7 (2, 2, 1)\nnorm 1.0\nTC energy (-9.672123916478075+0j)\nDMRG energy -4.410515813762378\n","exit_code":0,"status":"completed"}}
