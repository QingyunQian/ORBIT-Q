ange(n):\n        e = e - field*jnp.real(c.expectation((tc.gates.x(),[i]), enable_lightcone=True))\n    return e\n\nparams = jnp.zeros((nparams,), dtype=jnp.float32)\nprint('energy nojit', flush=True)\nt0=time.time(); e=energy_of(params); e.block_until_ready(); print('E', float(e), 't', time.time()-t0, flush=True)\n\nprint('jit energy', flush=True)\nej = jax.jit(energy_of)\nt0=time.time(); e=ej(params); e.block_until_ready(); print('compile', time.time()-t0, float(e), flush=True)\nt0=time.time(); e=ej(params); e.block_until_ready(); print('run', time.time()-t0, float(e), flush=True)\n\nprint('jit vg', flush=True)\nvg = jax.jit(jax.value_and_grad(energy_of))\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg compile', time.time()-t0, float(e), float(jnp.linalg.norm(g)), flush=True)\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg run', time.time()-t0, float(e), flush=True)\nprint('done', flush=True)\nPY\necho EXIT:\"'$?\ncat /tmp/bench4.log\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
