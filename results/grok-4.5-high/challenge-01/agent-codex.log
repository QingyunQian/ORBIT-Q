{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport inspect\nimport tensorcircuit as tc\nfrom tensorcircuit import mps_base\nprint(mps_base.__file__)\nprint([x for x in dir(mps_base) if not x.startswith('_')])\n# read apply_two_site_gate\nfrom tensorcircuit.mps_base import FiniteMPS\nprint(inspect.getsource(FiniteMPS.apply_two_site_gate)[:2500])\nPY\n# Check if numpy backend energy+finite diff is out - not allowed\n# Try tensorflow\npython -u - <<'PY'\nimport time, os\nos.environ['TF_CPP_MIN_LOG_LEVEL']='3'\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\ntc.set_backend('tensorflow')\ntc.set_dtype('complex128')\nimport tensorflow as tf\nL=32;h=1.05;n_layers=4\nbuilder=qtn.SpinHam1D(S=0.5,cyclic=False)\nbuilder += -4.,'Z','Z'; builder += -2*h,'X'\nH=builder.build_mpo(L)\ndmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\nmps=dmrg.state; mps.canonicalize_(where=0)\nprint('dmrg',dmrg.energy,flush=True)\n\ndef to_tc(mps):\n    ts=[]\n    for i in range(mps.nsites):\n        t=np.asarray(mps.tensors[i].data,dtype=np.complex128)\n        if t.ndim==2:\n            t=t.reshape(1,t.shape[0],t.shape[1]) if i==0 else t.reshape(t.shape[0],t.shape[1],1)\n        ts.append(tc.backend.convert_to_tensor(t))\n    return ts\nbase=to_tc(mps)\nsplit={'max_singular_values':8}\nXX=tc.gates._xx_matrix; YY=tc.gates._yy_matrix; ZZ=tc.gates._zz_matrix\n\nI=np.eye(2,dtype=np.complex128); X=np.array([[0,1],[1,0]],dtype=np.complex128); Z=np.array([[1,0],[0,-1]],dtype=np.complex128)\ndef make_mpo(L,h):\n    ts=[]\n    for i in range(L):\n        W=np.zeros((3,2,2,3),dtype=np.complex128)\n        W[0,:,:,0]=I; W[0,:,:,1]=-Z; W[0,:,:,2]=-h*X; W[1,:,:,2]=Z; W[2,:,:,2]=I\n        if i==0: ts.append(tf.constant(W[0:1]))\n        elif i==L-1: ts.append(tf.constant(W[:,:,:,2:3]))\n        else: ts.append(tf.constant(W))\n    return ts\nHts=make_mpo(L,h)\n\ndef mps_e(ts,Hts):\n    env=tf.reshape(tf.constant([1+0j],dtype=tf.complex128),(1,1,1))\n    for A,W in zip(ts,Hts):\n        env=tf.einsum('awb,apx,wpqy,bqz->xyz', env, tf.math.conj(A), W, A)\n    return tf.math.real(env[0,0,0])\ndef mps_n2(ts):\n    env=tf.reshape(tf.constant([1+0j],dtype=tf.complex128),(1,1))\n    for A in ts:\n        env=tf.einsum('ab,apx,bpy->xy', env, tf.math.conj(A), A)\n    return tf.math.real(env[0,0])\n\np=570\nparams=tf.Variable(tf.zeros((p,),dtype=tf.float64))\n\n@tf.function\ndef energy(params):\n    c=tc.MPSCircuit(L, tensors=base, center_position=0, split=split)\n    idx=0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q,theta=params[idx]); idx+=1\n            c.ry(q,theta=params[idx]); idx+=1\n            c.rz(q,theta=params[idx]); idx+=1\n        bonds=range(0,L-1,2) if layer%2==0 else range(1,L-1,2)\n        for b in bonds:\n            thxx=params[idx];idx+=1; thyy=params[idx];idx+=1; thzz=params[idx];idx+=1\n            c.exp1(b,b+1,theta=thxx,unitary=XX)\n            c.exp1(b,b+1,theta=thyy,unitary=YY)\n            c.exp1(b,b+1,theta=thzz,unitary=ZZ)\n    ts=c.get_tensors()\n    return mps_e(ts,Hts)/mps_n2(ts)\n\nprint('e1',flush=True)\nt0=time.time(); e=energy(params); print(float(e.numpy()), time.time()-t0, flush=True)\nprint('e2',flush=True)\nt0=time.time(); e=energy(params); print(float(e.numpy()), time.time()-t0, flush=True)\n\n@tf.function\ndef vg(params):\n    with tf.GradientTape() as tape:\n        e=energy(params)\n    g=tape.gradient(e,params)\n    return e,g\nprint('vg1',flush=True)\nt0=time.time(); e,g=vg(params); e.numpy(); g.numpy(); print(float(e.numpy()), float(tf.norm(g).numpy()), time.time()-t0, flush=True)\nprint('vg2',flush=True)\nt0=time.time(); e,g=vg(params); e.numpy(); g.numpy(); print(float(e.numpy()), time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
