{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\n\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nL = 32\nh = 1.05\nn_layers = 4\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -4.0, 'Z', 'Z'\nbuilder += -2*h, 'X'\nH = builder.build_mpo(L)\ndmrg = qtn.DMRG2(H, bond_dims=[8], cutoffs=1e-10)\ndmrg.solve(max_sweeps=2, verbosity=0)\nmps = dmrg.state\nmps.canonicalize_(where=0)\nprint('dmrg', dmrg.energy)\n\ndef to_tc_tensors(mps):\n    tensors = []\n    for i in range(mps.nsites):\n        t = np.asarray(mps.tensors[i].data, dtype=np.complex128)\n        if t.ndim == 2:\n            if i == 0:\n                t = t.reshape(1, t.shape[0], t.shape[1])\n            else:\n                t = t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(jnp.asarray(t))\n    return tensors\n\nbase_tensors = to_tc_tensors(mps)\nsplit = {\\\"max_singular_values\\\": 16}\n\ndef count_params(n, n_layers):\n    p = 0\n    for layer in range(n_layers):\n        p += 3*n\n        bonds = range(0, n-1, 2) if layer % 2 == 0 else range(1, n-1, 2)\n        p += 3*len(list(bonds))\n    return p\n\np = count_params(L, n_layers)\nprint('n_params', p)\n\ndef energy_fn(params):\n    params = params.astype(jnp.float64)  # real params\n    ts = [t for t in base_tensors]\n    c = tc.MPSCircuit(L, tensors=ts, center_position=0, split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(L):\n            c.rz(q, theta=params[idx]); idx+=1\n            c.ry(q, theta=params[idx]); idx+=1\n            c.rz(q, theta=params[idx]); idx+=1\n        bonds = range(0, L-1, 2) if layer % 2 == 0 else range(1, L-1, 2)\n        for b in bonds:\n            thxx = params[idx]; idx+=1\n            thyy = params[idx]; idx+=1\n            thzz = params[idx]; idx+=1\n            c.exp1(b, b+1, theta=thxx, unitary=tc.gates._xx_matrix)\n            c.exp1(b, b+1, theta=thyy, unitary=tc.gates._yy_matrix)\n            c.exp1(b, b+1, theta=thzz, unitary=tc.gates._zz_matrix)\n    e = 0.0\n    for i in range(L-1):\n        e = e - tc.backend.real(c.expectation((tc.gates.z(), [i]), (tc.gates.z(), [i+1]), normalize=True))\n    for i in range(L):\n        e = e - h * tc.backend.real(c.expectation((tc.gates.x(), [i]), normalize=True))\n    return e\n\nparams0 = jnp.zeros((p,), dtype=jnp.float64)\nt0=time.time(); e=energy_fn(params0); print('E0', e, 'time', time.time()-t0)\n\n# try grad\nt0=time.time()\ntry:\n    g = jax.grad(energy_fn)(params0)\n    print('grad ok', g.shape, float(jnp.linalg.norm(g)), 'time', time.time()-t0)\nexcept Exception as ex:\n    import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
