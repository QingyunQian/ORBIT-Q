{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\nL = 32\nh = 1.05\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -4.0, 'Z', 'Z'\nbuilder += -2*h, 'X'\nH = builder.build_mpo(L)\ndmrg = qtn.DMRG2(H, bond_dims=[8], cutoffs=1e-10)\ndmrg.solve(max_sweeps=2, verbosity=0)\nmps = dmrg.state\nprint('dmrg E', dmrg.energy)\nmps.canonicalize_(where=0)\n\ndef to_tc_tensors(mps):\n    tensors = []\n    for i in range(mps.nsites):\n        t = np.asarray(mps.tensors[i].data, dtype=np.complex128)\n        if t.ndim == 2:\n            if i == 0:\n                t = t.reshape(1, t.shape[0], t.shape[1])\n            else:\n                t = t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(t)\n    return tensors\n\ntensors = to_tc_tensors(mps)\nprint('chis', [t.shape[0] for t in tensors]+[tensors[-1].shape[-1]])\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\nsplit = {\\\"max_singular_values\\\": 16, \\\"max_truncation_err\\\": 1e-8}\n\ndef apply_circuit(c, params, n_layers):\n    # params structure\n    idx = 0\n    n = c._nqubits\n    for layer in range(n_layers):\n        # RZ RY RZ\n        for q in range(n):\n            c.rz(q, theta=params[idx]); idx+=1\n            c.ry(q, theta=params[idx]); idx+=1\n            c.rz(q, theta=params[idx]); idx+=1\n        bonds = range(0, n-1, 2) if layer % 2 == 0 else range(1, n-1, 2)\n        for b in bonds:\n            # exp(-i(thxx XX + thyy YY + thzz ZZ)) = rxx(2th)*ryy(2th)*rzz(2th) with half=True\n            thxx = params[idx]; idx+=1\n            thyy = params[idx]; idx+=1\n            thzz = params[idx]; idx+=1\n            c.rxx(b, b+1, theta=2*thxx)\n            c.ryy(b, b+1, theta=2*thyy)\n            c.rzz(b, b+1, theta=2*thzz)\n    return c\n\ndef n_params(n, n_layers):\n    p = 0\n    for layer in range(n_layers):\n        p += 3*n\n        bonds = list(range(0, n-1, 2) if layer % 2 == 0 else range(1, n-1, 2))\n        p += 3*len(bonds)\n    return p\n\nnp.random.seed(0)\np = n_params(L, 4)\n# small random as refinement\nparams = 0.01*np.random.randn(p)\n\ndef energy_from_params(params):\n    c = tc.MPSCircuit(L, tensors=[t.copy() for t in tensors], center_position=0, split=split)\n    apply_circuit(c, params, 4)\n    e = 0.0\n    for i in range(L-1):\n        e += -np.real(c.expectation((tc.gates.z(), [i]), (tc.gates.z(), [i+1]), normalize=True))\n    for i in range(L):\n        e += -h * np.real(c.expectation((tc.gates.x(), [i]), normalize=True))\n    return e\n\nt0 = time.time()\ne0 = energy_from_params(np.zeros(p))\nt1 = time.time()\nprint('E0', e0, 'time', t1-t0)\nt0 = time.time()\ne1 = energy_from_params(params)\nt1 = time.time()\nprint('E1', e1, 'time', t1-t0)\nprint('dmrg', dmrg.energy)\nprint('bond after', end=' ')\nc = tc.MPSCircuit(L, tensors=[t.copy() for t in tensors], center_position=0, split=split)\napply_circuit(c, params, 4)\nprint(c.get_bond_dimensions())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
