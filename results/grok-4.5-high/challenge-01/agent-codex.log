{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY' > /tmp/bench3.log 2>&1\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\ndef make_dmrg(n, field, chi, sweeps):\n    H = qtn.MPO_ham_ising(n, j=-4.0, bx=2*field, S=1/2, cyclic=False)\n    dmrg = qtn.DMRG2(H, bond_dims=[chi], cutoffs=1e-10)\n    dmrg.solve(max_sweeps=sweeps, verbosity=0)\n    psi = dmrg.state\n    tensors = []\n    for i in range(n):\n        t = np.asarray(psi.arrays[i], dtype=np.complex64)\n        if t.ndim == 2:\n            t = t.reshape(1, t.shape[0], t.shape[1]) if i == 0 else t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(jnp.asarray(t))\n    return tensors, float(dmrg.energy)\n\nn=16\nfield=1.05\nn_layers=4\ntensors, e0 = make_dmrg(n, field, 8, 2)\nprint('dmrg', e0, flush=True)\n\n# count params\ndef count_params(n, n_layers):\n    nparams = 0\n    for layer in range(n_layers):\n        nparams += n*3\n        bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n        nparams += len(bonds)*3\n    return nparams\nnparams = count_params(n, n_layers)\nprint('nparams', nparams, flush=True)\n\nmax_bond = 24\n\ndef energy_of(params):\n    split = {\\\"max_singular_values\\\": max_bond}\n    c = tc.MPSCircuit(n, tensors=tensors, split=split)\n    idx = 0\n    for layer in range(n_layers):\n        for q in range(n):\n            rz1 = params[idx]; ry=params[idx+1]; rz2=params[idx+2]\n            idx += 3\n            c.rz(q, theta=rz1)\n            c.ry(q, theta=ry)\n            c.rz(q, theta=rz2)\n        bonds = list(range(0, n-1, 2)) if layer % 2 == 0 else list(range(1, n-1, 2))\n        for b in bonds:\n            txx=params[idx]; tyy=params[idx+1]; tzz=params[idx+2]\n            idx += 3\n            c.rxx(b, b+1, theta=2*txx)\n            c.ryy(b, b+1, theta=2*tyy)\n            c.rzz(b, b+1, theta=2*tzz)\n    e = 0.0\n    for i in range(n-1):\n        e = e - jnp.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - field * jnp.real(c.expectation_ps(x=[i]))\n    return e\n\nparams = jnp.zeros((nparams,), dtype=jnp.float32)\n\nprint('jit energy...', flush=True)\ne_jit = jax.jit(energy_of)\nt0=time.time(); e=e_jit(params); e.block_until_ready(); print('energy compile', time.time()-t0, float(e), flush=True)\nt0=time.time(); e=e_jit(params); e.block_until_ready(); print('energy run', time.time()-t0, float(e), flush=True)\n\nprint('jit val_and_grad...', flush=True)\nvg = jax.jit(jax.value_and_grad(energy_of))\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg compile', time.time()-t0, float(e), float(jnp.linalg.norm(g)), flush=True)\nt0=time.time(); e,g=vg(params); e.block_until_ready(); print('vg run', time.time()-t0, float(e), flush=True)\nprint('done', flush=True)\nPY\necho EXIT:\"'$?\ncat /tmp/bench3.log\n'","aggregated_output":"Terminated\nEXIT:143\ndmrg -20.594824095925592\nnparams 282\njit energy...\nenergy compile 6.5015175342559814 -20.59479522705078\nenergy run 0.009058237075805664 -20.59479522705078\njit val_and_grad...\n","exit_code":0,"status":"completed"}}
