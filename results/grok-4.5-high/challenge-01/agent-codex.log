{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport quimb.tensor as qtn\nimport tensorcircuit as tc\n\nL = 6\nh = 1.05\nbuilder = qtn.SpinHam1D(S=0.5, cyclic=False)\nbuilder += -4.0, 'Z', 'Z'  # Pauli ZZ = 4 SzSz\nbuilder += -2*h, 'X'       # Pauli X = 2 Sx\nH = builder.build_mpo(L)\n\ndmrg = qtn.DMRG2(H, bond_dims=[16], cutoffs=1e-12)\ndmrg.solve(max_sweeps=6, verbosity=0)\nmps = dmrg.state\nprint('energy', dmrg.energy)\nmps.canonicalize_(where=0)\n\ndef to_tc_tensors(mps):\n    tensors = []\n    for i in range(mps.nsites):\n        t = np.asarray(mps.tensors[i].data)\n        if t.ndim == 2:\n            # end tensor: could be (phys, right) or (left, phys)\n            if i == 0:\n                # (phys, right) -> (1, phys, right)\n                t = t.reshape(1, t.shape[0], t.shape[1])\n            else:\n                # (left, phys) -> (left, phys, 1)\n                t = t.reshape(t.shape[0], t.shape[1], 1)\n        tensors.append(t)\n    return tensors\n\ntensors = to_tc_tensors(mps)\nfor i,t in enumerate(tensors):\n    print(i, t.shape, t.dtype)\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\nc = tc.MPSCircuit(L, tensors=tensors, center_position=0)\nprint('norm', c.get_norm())\n\ndef energy(c, h, L):\n    e = 0.0+0j\n    for i in range(L-1):\n        e += -c.expectation((tc.gates.z(), [i]), (tc.gates.z(), [i+1]), normalize=True)\n    for i in range(L):\n        e += -h * c.expectation((tc.gates.x(), [i]), normalize=True)\n    return np.real(e)\n\nprint('E tc', energy(c,h,L))\nprint('E dmrg', dmrg.energy)\n\n# try gates\nc2 = c.copy()\nc2.ry(0, theta=0.1)\nc2.rzz(0,1, theta=0.05)\nprint('after gate E', energy(c2,h,L))\nprint('norm', c2.get_norm())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
