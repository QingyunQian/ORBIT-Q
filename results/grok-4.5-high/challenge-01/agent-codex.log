{"type":"item.started","item":{"id":"item_241","type":"command_execution","command":"/bin/bash -lc \"# leave 2577 running; start Circuit vg test if memory allows\nfree -h | head -2\ncat > /tmp/circ_vg.py <<'PY'\nimport time, traceback\nimport numpy as np, jax, jax.numpy as jnp, quimb.tensor as qtn, tensorcircuit as tc, optax\ntc.set_backend('jax'); tc.set_dtype('complex64')\nout=open('/tmp/circ_vg.txt','w',buffering=1)\ndef p(s):\n    out.write(s+'\\\\n'); out.flush()\ntry:\n  n,field,n_layers=32,1.05,4\n  H=qtn.MPO_ham_ising(n,j=-4.0,bx=2*field,S=0.5,cyclic=False)\n  dmrg=qtn.DMRG2(H,bond_dims=[8],cutoffs=1e-10); dmrg.solve(max_sweeps=2,verbosity=0)\n  tensors=[]\n  for i in range(n):\n    t=np.asarray(dmrg.state.arrays[i],dtype=np.complex64)\n    if t.ndim==2:\n      t=t.reshape(1,*t.shape) if i==0 else t.reshape(*t.shape,1)\n    tensors.append(jnp.asarray(t))\n  p(f'dmrg {float(dmrg.energy)}')\n  nparams=0\n  for layer in range(n_layers):\n    nparams += n*3\n    bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n    nparams += len(bonds)*3\n  p(f'nparams {nparams}')\n  def energy(params):\n    c=tc.Circuit(n, tensors=tensors)\n    idx=0\n    for layer in range(n_layers):\n      for q in range(n):\n        c.rz(q,theta=params[idx]); c.ry(q,theta=params[idx+1]); c.rz(q,theta=params[idx+2]); idx+=3\n      bonds=list(range(0,n-1,2)) if layer%2==0 else list(range(1,n-1,2))\n      for b in bonds:\n        c.exp1(b,b+1,theta=params[idx],unitary=tc.gates._xx_matrix)\n        c.exp1(b,b+1,theta=params[idx+1],unitary=tc.gates._yy_matrix)\n        c.exp1(b,b+1,theta=params[idx+2],unitary=tc.gates._zz_matrix)\n        idx+=3\n    e=0.0\n    for i in range(n-1):\n      e = e - jnp.real(c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]), enable_lightcone=True))\n    for i in range(n):\n      e = e - field*jnp.real(c.expectation((tc.gates.x(),[i]), enable_lightcone=True))\n    return e\n  params=jnp.zeros((nparams,),jnp.float32)\n  p('jit energy')\n  ej=jax