{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto3.py << 'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK = tc.backend\n\nn = 12\nn_steps = 10\ng = 0.9\nweight = 0.05\neven_q = (0,2,4,6,8,10)\n\nps, ws = [], []\nfor i in range(n-1):\n    p = [0]*n; p[i]=3; p[i+1]=3\n    ps.append(p); ws.append(-1.0)\nfor i in range(n):\n    p = [0]*n; p[i]=1\n    ps.append(p); ws.append(-float(g))\nH = tc.quantum.PauliStringSum2COO(ps, ws)\nprint('H type', type(H), getattr(H,'shape',None))\n\ndef n_params_fn(n_qubits, n_steps):\n    tot=0\n    for t in range(n_steps):\n        nb = n_qubits//2 if t%2==0 else n_qubits//2 - 1\n        tot += nb*2 + n_qubits\n    return tot\n\nn_params = n_params_fn(n, n_steps)\nprint('n_params', n_params)\n\ndef evaluate(params):\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    state = c.state()\n    logps = []\n    idx = 0\n    for t in range(n_steps):\n        nb = n//2 if (t % 2 == 0) else n//2 - 1\n        gp = params[idx:idx+nb*2]; idx += nb*2\n        rp = params[idx:idx+n]; idx += n\n        c = tc.Circuit(n, inputs=state)\n        if t % 2 == 0:\n            bonds = [(2*i, 2*i+1) for i in range(nb)]\n        else:\n            bonds = [(2*i+1, 2*i+2) for i in range(nb)]\n        for bi,(a,b) in enumerate(bonds):\n            c.rxx(a,b, theta=2.0*gp[2*bi])\n            c.rzz(a,b, theta=2.0*gp[2*bi+1])\n        for q in range(n):\n            c.rx(q, theta=rp[q])\n        st = c.state()\n        for q in even_q:\n            c2 = tc.Circuit(n, inputs=st)\n            z = jnp.real(c2.expectation_ps(z=[q]))\n            p0 = (1.0 + z) * 0.5\n            logps.append(jnp.log(p0 + 1e-12))\n            c2.post_select(q, keep=0)\n            st2 = c2.state()\n            nrm = jnp.linalg.norm(st2)\n            st = st2 / nrm\n        state = st\n    ket = state.reshape((-1,1))\n    tmp = K.sparse_dense_matmul(H, ket)\n    e = jnp.real((jnp.conj(ket).T @ tmp)[0,0])\n    ed = e / n\n    log_arr = jnp.stack(logps)\n    mean_log = jnp.mean(log_arr)\n    success = jnp.exp(jnp.sum(log_arr))\n    loss = ed - weight * mean_log\n    return loss, ed, success, mean_log\n\nparams0 = jnp.zeros((n_params,), dtype=jnp.float32)\nt0=time.time()\nout = evaluate(params0)\nprint('eager', out, 't', time.time()-t0)\n\ndef loss_fn(p):\n    return evaluate(p)[0]\n\nt0=time.time()\nv,g = jax.value_and_grad(loss_fn)(params0)\nprint('first grad', float(v), float(jnp.linalg.norm(g)), 't', time.time()-t0)\nt0=time.time()\nv,g = jax.value_and_grad(loss_fn)(params0)\nprint('second grad', float(v), 't', time.time()-t0)\n\njvg = jax.jit(jax.value_and_grad(loss_fn))\nt0=time.time()\nv,g = jvg(params0)\nprint('jit first', float(v), 't', time.time()-t0)\nt0=time.time()\nv,g = jvg(params0)\nprint('jit second', float(v), 't', time.time()-t0)\n\n# try a few adam steps\nopt = optax.adam(0.01)\nopt_state = opt.init(params0)\nparams = params0\nt0=time.time()\nfor i in range(5):\n    (loss, ed, suc, ml), grads = jax.value_and_grad(lambda p: evaluate(p), has_aux=False)(params) if False else (None, None)\n    def f(p):\n        loss, ed, suc, ml = evaluate(p)\n        return loss, (ed, suc, ml)\n    (loss, (ed, suc, ml)), grads = jax.value_and_grad(f, has_aux=True)(params)\n    updates, opt_state = opt.update(grads, opt_state, params)\n    params = optax.apply_updates(params, updates)\n    print(i, float(loss), float(ed), float(suc), float(ml))\nprint('5 steps t', time.time()-t0)\nPY\npython /tmp/proto3.py\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
