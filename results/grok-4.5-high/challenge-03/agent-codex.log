it q is 0             # state is ordered as bitstring with qubit 0 as most significant?              # In tensorcircuit, qubit 0 is the first index (leftmost, MSB)             shape = tuple([2]*n)             psi_r = psi.reshape(shape)             # sum over all indices where q-th axis is 0             # Use projector via expectation_ps - but need normalize             # <Z_q> unnorm / norm2             z_un = c.expectation_ps(z=[q])             # norm2 from state             n2 = jnp.real(jnp.vdot(psi, psi))             z_exp = jnp.real(z_un) / n2             p0 = (1.0 + z_exp) / 2.0             log_ps.append(jnp.log(p0 + 1e-12))             c.post_select(q, keep=0)          psi = c.state()     n2 = jnp.real(jnp.vdot(psi, psi))     psi = psi / jnp.sqrt(n2)     # energy density of TFIM     # rebuild circuit with normalized state for expectations     c2 = tc.Circuit(n, inputs=psi)     e = 0.0     for i in range(n-1):         e = e - jnp.real(c2.expectation_ps(z=[i, i+1]))     for i in range(n):         e = e - g * jnp.real(c2.expectation_ps(x=[i]))     ed = e / n     log_arr = jnp.stack(log_ps)     mean_log = jnp.mean(log_arr)     success = jnp.exp(jnp.sum(log_arr))     loss = ed - 0.05 * mean_log     return loss, ed, success, mean_log  params = jnp.zeros(n_params) t0 = time.time() out = build_and_eval(params) print(\"eager out\", out, \"time\", time.time()-t0)  # jit value_and_grad def loss_only(params):     return build_and_eval(params)[0]  t0 = time.time() val, grad = jax.value_and_grad(loss_only)(params) print(\"grad compile+run\", time.time()-t0, \"val\", val, \"gradnorm\", jnp.linalg.norm(grad))  t0 = time.time() val, grad = jax.value_and_grad(loss_only)(params) print(\"grad second\", time.time()-t0, \"val\", val) EOF \nroot         583  108  5.0 3780232 818604 ?      Rl   18:02   0:24 python\n","exit_code":0,"status":"completed"}}
