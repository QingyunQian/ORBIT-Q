{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\nn_steps = 10\ng = 0.9\nlog_w = 0.05\nlr = 0.01\n\n# parameter structure\n# even step bonds: 6, odd: 5\ndef num_bond_params(step):\n    nb = 6 if step % 2 == 0 else 5\n    return nb * 2\n\n# flatten params: list per step of (bond_params, rx_params)\n# Use a single array with max size and mask, or pytree\n\ndef init_params(key):\n    params = []\n    for t in range(n_steps):\n        nb = 6 if t % 2 == 0 else 5\n        key, k1, k2 = jax.random.split(key, 3)\n        bond = jax.random.normal(k1, (nb, 2)) * 0.1\n        rx = jax.random.normal(k2, (n,)) * 0.1\n        params.append({'bond': bond, 'rx': rx})\n    return params\n\ndef energy_from_circuit(c):\n    e = 0.0\n    for i in range(n-1):\n        e = e - tc.backend.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - g * tc.backend.real(c.expectation_ps(x=[i]))\n    return e / n\n\ndef loss_fn(params):\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    logps = []\n    for t in range(n_steps):\n        bonds = [(2*i, 2*i+1) for i in range(6)] if t % 2 == 0 else [(2*i+1, 2*i+2) for i in range(5)]\n        bp = params[t]['bond']\n        for b_idx, (i,j) in enumerate(bonds):\n            th_xx = bp[b_idx, 0]\n            th_zz = bp[b_idx, 1]\n            c.exp1(i, j, theta=th_xx, unitary=tc.gates._xx_matrix)\n            c.exp1(i, j, theta=th_zz, unitary=tc.gates._zz_matrix)\n        rx = params[t]['rx']\n        for i in range(n):\n            c.rx(i, theta=rx[i])\n        # post-select even qubits\n        for q in range(0, n, 2):\n            ez = tc.backend.real(c.expectation_ps(z=[q]))\n            p0 = (1.0 + ez) * 0.5\n            logps.append(jnp.log(p0 + 1e-12))\n            c.post_select(q, keep=0)\n            s = c.state()\n            s = s / jnp.sqrt(jnp.maximum(jnp.sum(jnp.real(s*jnp.conj(s))), 1e-30))\n            c = tc.Circuit(n, inputs=s)\n    logps = jnp.stack(logps)\n    mean_logp = jnp.mean(logps)\n    success_p = jnp.exp(jnp.sum(logps))\n    ed = energy_from_circuit(c)\n    loss = ed - log_w * mean_logp\n    return loss, (ed, success_p, mean_logp)\n\nkey = jax.random.PRNGKey(0)\nparams = init_params(key)\n\n# test one forward\nt0 = time.time()\nout = loss_fn(params)\nprint('forward', out[0], out[1], 'time', time.time()-t0)\n\nval_and_grad = jax.jit(jax.value_and_grad(loss_fn, has_aux=True))\nt0 = time.time()\n(loss, aux), grads = val_and_grad(params)\nloss.block_until_ready()\nprint('compile+first', time.time()-t0, 'loss', loss, 'aux', aux)\n\nt0 = time.time()\nfor i in range(5):\n    (loss, aux), grads = val_and_grad(params)\nloss.block_until_ready()\nprint('5 iters', time.time()-t0, 'per', (time.time()-t0)/5)\nprint(loss, aux)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
