{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"pkill -f '/tmp/proto_jax2.py' 2>/dev/null\npkill -f '/tmp/proto_rand.py' 2>/dev/null\npkill -f 'nohup bash' 2>/dev/null\npkill -f 'wait_status' 2>/dev/null\nsleep 1\npgrep -af 'proto_|python /tmp' || echo clean\ncat > /tmp/proto_fast.py << 'PY'\nimport time\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\nK = tc.backend\n\nN = 12\nN_STEPS = 10\nG = 0.9\nWLOG = 0.05\nEVEN_Q = jnp.array([0, 2, 4, 6, 8, 10], dtype=jnp.int32)\n\n# Hamiltonian sparse\nps, ws = [], []\nfor i in range(N - 1):\n    p = [0] * N\n    p[i] = 3\n    p[i + 1] = 3\n    ps.append(p)\n    ws.append(-1.0)\nfor i in range(N):\n    p = [0] * N\n    p[i] = 1\n    ps.append(p)\n    ws.append(-float(G))\nH = tc.quantum.PauliStringSum2COO(ps, ws)\n\n# Parameter layout with padding for scan:\n# even bonds: 6, odd bonds: 5 -> pad odd to 6 with dummy bond ignored\n# params_bond: (N_STEPS, 6, 2)  # xx, zz\n# params_rx: (N_STEPS, N)\n\ndef init_plus():\n    c = tc.Circuit(N)\n    for i in range(N):\n        c.h(i)\n    return c.state()\n\n\ndef apply_unitary(state, bond_params, rx_params, parity):\n    # bond_params: (6,2), rx_params:(N,)\n    # parity 0 even, 1 odd\n    c = tc.Circuit(N, inputs=state)\n    # always loop 6 potential bonds; for odd, last bond is dummy (11,12) invalid - handle carefully\n    # Better: use python bonds based on parity as concrete static value via two functions\n    return None\n\n\ndef apply_even(state, bond_params, rx_params):\n    c = tc.Circuit(N, inputs=state)\n    for i in range(6):\n        a, b = 2 * i, 2 * i + 1\n        c.rxx(a, b, theta=2.0 * bond_params[i, 0])\n        c.rzz(a, b, theta=2.0 * bond_params[i, 1])\n    for q in range(N):\n        c.rx(q, theta=rx_params[q])\n    return c.state()\n\n\ndef apply_odd(state, bond_params, rx_params):\n    # bond_params first 5 used\n    c = tc.Circuit(N, inputs=state)\n    for i in range(5):\n        a, b = 2 * i + 1, 2 * i + 2\n        c.rxx(a, b, theta=2.0 * bond_params[i, 0])\n        c.rzz(a, b, theta=2.0 * bond_params[i, 1])\n    for q in range(N):\n        c.rx(q, theta=rx_params[q])\n    return c.state()\n\n\ndef postselect_all(state):\n    logs = []\n    for q in (0, 2, 4, 6, 8, 10):\n        c = tc.Circuit(N, inputs=state)\n        c.post_select(q, keep=0)\n        st = c.state()\n        p = jnp.real(jnp.vdot(st, st))  # state normalized\n        logs.append(jnp.log(p + 1e-12))\n        state = st / jnp.sqrt(p)\n    return state, jnp.stack(logs)\n\n\ndef evaluate(bond_e, bond_o, rx):\n    # bond_e: (5,6,2) for even steps 0,2,4,6,8\n    # bond_o: (5,5,2) for odd steps\n    # rx: (10,12)\n    state = init_plus()\n    all_logs = []\n    for s in range(5):\n        state = apply_even(state, bond_e[s], rx[2 * s])\n        state, logs = postselect_all(state)\n        all_logs.append(logs)\n        state = apply_odd(state, bond_o[s], rx[2 * s + 1])\n        state, logs = postselect_all(state)\n        all_logs.append(logs)\n    log_arr = jnp.concatenate(all_logs)\n    ket = state.reshape((2 ** N, 1))\n    tmp = K.sparse_dense_matmul(H, ket)\n    e = jnp.real(jnp.matmul(jnp.conjugate(ket).T, tmp)[0, 0])\n    ed = e / N\n    mean_log = jnp.mean(log_arr)\n    success = jnp.exp(jnp.sum(log_arr))\n    loss = ed - WLOG * mean_log\n    return loss, (ed, success, mean_log)\n\n\nkey = jax.random.PRNGKey(1)\nk1,k2,k3 = jax.random.split(key, 3)\nbond_e = 0.05 * jax.random.normal(k1, (5, 6, 2), dtype=jnp.float32)\nbond_o = 0.05 * jax.random.normal(k2, (5, 5, 2), dtype=jnp.float32)\nrx = 0.05 * jax.random.normal(k3, (10, N), dtype=jnp.float32)\nparams = (bond_e, bond_o, rx)\n\nt0 = time.time()\nloss, aux = evaluate(*params)\nprint(\\\"eager\\\", float(loss), [float(x) for x in aux], \\\"t\\\", time.time() - t0, flush=True)\n\ndef loss_aux(params):\n    return evaluate(*params)\n\nvag = jax.value_and_grad(loss_aux, has_aux=True)\nt0 = time.time()\n(v, aux), g = vag(params)\ngn = jax.tree_util.tree_map(lambda x: float(jnp.linalg.norm(x)), g)\nprint(\\\"eager grad\\\", float(v), gn, \\\"t\\\", time.time() - t0, flush=True)\n\njvag = jax.jit(vag)\nt0 = time.time()\n(v, aux), g = jvag(params)\nprint(\\\"jit1\\\", float(v), [float(x) for x in aux], \\\"t\\\", time.time() - t0, flush=True)\nt0 = time.time()\n(v, aux), g = jvag(params)\nprint(\\\"jit2\\\", float(v), \\\"t\\\", time.time() - t0, flush=True)\n\nopt = optax.adam(0.01)\nopt_state = opt.init(params)\n\n@jax.jit\ndef train_step(params, opt_state):\n    (loss, aux), grads = jax.value_and_grad(loss_aux, has_aux=True)(params)\n    updates, opt_state = opt.update(grads, opt_state, params)\n    params = optax.apply_updates(params, updates)\n    return params, opt_state, loss, aux\n\nt0 = time.time()\nparams, opt_state, loss, aux = train_step(params, opt_state)\nprint(\\\"train0\\\", float(loss), [float(x) for x in aux], \\\"t\\\", time.time() - t0, flush=True)\n\nt0 = time.time()\nfor i in range(50):\n    params, opt_state, loss, aux = train_step(params, opt_state)\nprint(\\\"50steps\\\", time.time() - t0, \\\"loss\\\", float(loss), \\\"ed\\\", float(aux[0]), \\\"p\\\", float(aux[1]), flush=True)\nPY\npython /tmp/proto_fast.py > /tmp/proto_fast.out 2>&1 &\necho PID \"'$!\nsleep 8\ncat /tmp/proto_fast.out\nps -p $(pgrep -f '\"'python /tmp/proto_fast.py' | head -1) -o etime,pcpu 2>/dev/null || echo finished_early\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
