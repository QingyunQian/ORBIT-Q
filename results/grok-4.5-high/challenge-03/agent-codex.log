{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport numpy as np\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nn = 12\nn_steps = 10\ng = 0.9\n\ndef counts():\n    # param layout\n    idx = 0\n    slices = []\n    for t in range(n_steps):\n        bonds = 6 if t % 2 == 0 else 5\n        n_gate = bonds * 2 + n\n        slices.append((idx, idx + bonds*2, idx + bonds*2 + n, bonds))\n        idx += n_gate\n    return idx, slices\n\nn_params, slices = counts()\nprint(\\\"n_params\\\", n_params)\n\ndef build_and_eval(params):\n    c = tc.Circuit(n)\n    # init |+>\"'^n\n    for i in range(n):\n        c.h(i)\n    log_ps = []\n    # track norm via successive postselect without renormalizing:\n    # use expectation of projector via Z before each postselect with proper normalization\n    \n    # We'\"'ll renormalize by recreating circuit from state for numerical stability\n    # Actually better: compute p from expectation on current circuit\n    \n    for t in range(n_steps):\n        start, mid, end, nbonds = slices[t]\n        gate_params = params[start:mid]\n        rx_params = params[mid:end]\n        if t % 2 == 0:\n            bonds = [(2*i, 2*i+1) for i in range(6)]\n        else:\n            bonds = [(2*i+1, 2*i+2) for i in range(5)]\n        for b_i, (q0, q1) in enumerate(bonds):\n            txx = gate_params[2*b_i]\n            tzz = gate_params[2*b_i + 1]\n            c.rxx(q0, q1, theta=2.0 * txx)\n            c.rzz(q0, q1, theta=2.0 * tzz)\n        for q in range(n):\n            c.rx(q, theta=rx_params[q])\n        \n        # post-select even qubits one by one\n        for q in [0,2,4,6,8,10]:\n            # p0 = (1 + <Z>)/2 with normalized state\n            # get unnormalized expectation and norm\n            # Using state is clearer\n            psi = c.state()\n            # reshape to compute Z expectation on qubit q\n            # p0 = sum |amp|\"'^2 where bit q is 0\n            # state is ordered as bitstring with qubit 0 as most significant? \n            # In tensorcircuit, qubit 0 is the first index (leftmost, MSB)\n            shape = tuple([2]*n)\n            psi_r = psi.reshape(shape)\n            # sum over all indices where q-th axis is 0\n            # Use projector via expectation_ps - but need normalize\n            # <Z_q> unnorm / norm2\n            z_un = c.expectation_ps(z=[q])\n            # norm2 from state\n            n2 = jnp.real(jnp.vdot(psi, psi))\n            z_exp = jnp.real(z_un) / n2\n            p0 = (1.0 + z_exp) / 2.0\n            log_ps.append(jnp.log(p0 + 1e-12))\n            c.post_select(q, keep=0)\n    \n    psi = c.state()\n    n2 = jnp.real(jnp.vdot(psi, psi))\n    psi = psi / jnp.sqrt(n2)\n    # energy density of TFIM\n    # rebuild circuit with normalized state for expectations\n    c2 = tc.Circuit(n, inputs=psi)\n    e = 0.0\n    for i in range(n-1):\n        e = e - jnp.real(c2.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - g * jnp.real(c2.expectation_ps(x=[i]))\n    ed = e / n\n    log_arr = jnp.stack(log_ps)\n    mean_log = jnp.mean(log_arr)\n    success = jnp.exp(jnp.sum(log_arr))\n    loss = ed - 0.05 * mean_log\n    return loss, ed, success, mean_log\n\nparams = jnp.zeros(n_params)\nt0 = time.time()\nout = build_and_eval(params)\nprint(\"eager out\", out, \"time\", time.time()-t0)\n\n# jit value_and_grad\ndef loss_only(params):\n    return build_and_eval(params)[0]\n\nt0 = time.time()\nval, grad = jax.value_and_grad(loss_only)(params)\nprint(\"grad compile+run\", time.time()-t0, \"val\", val, \"gradnorm\", jnp.linalg.norm(grad))\n\nt0 = time.time()\nval, grad = jax.value_and_grad(loss_only)(params)\nprint(\"grad second\", time.time()-t0, \"val\", val)\nEOF\n'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
