{"type":"item.started","item":{"id":"item_98","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nn=12\nangle=0.31\n\ndef make_kraus(p01, p10):\n    K0 = jnp.stack([jnp.stack([jnp.sqrt(1-p01), 0j]), jnp.stack([0j, jnp.sqrt(1-p10)])])\n    # simpler\n    K0 = jnp.array([[jnp.sqrt(1-p01)+0j, 0],[0, jnp.sqrt(1-p10)+0j]], jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)+0j],[0,0]], jnp.complex64)\n    K2 = jnp.array([[0,0],[jnp.sqrt(p01)+0j,0]], jnp.complex64)\n    return [K0,K1,K2]\n\ndef row(p01,p10,kind):\n    c=tc.DMCircuit(n)\n    if kind==0:\n        c.h(0)\n        for i in range(n-1): c.cnot(i,i+1)\n    elif kind==1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind==3:\n        for i in range(n): c.h(i)\n    k=make_kraus(p01,p10)\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle)\n        c.apply_general_kraus(k,i)\n        c.apply_general_kraus(k,i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle)\n        c.apply_general_kraus(k,i)\n        c.apply_general_kraus(k,i+1)\n    rho = c.densitymatrix()\n    # rho shape (4096,4096)\n    diag = jnp.real(jnp.diag(rho))\n    idx = jnp.arange(1<<n)\n    outs=[]\n    for q in range(n):\n        signs = 1 - 2*((idx >> (n-1-q)) & 1)\n        outs.append(jnp.dot(diag, signs))\n    # parity\n    parity = jnp.zeros_like(idx)\n    x=idx\n    for _ in range(n):\n        parity = parity \"'^ (x & 1)\n        x = x >> 1\n    outs.append(jnp.dot(diag, 1-2*parity))\n    return jnp.stack(outs)\n\ndef table(p):\n    p01=jax.nn.sigmoid(p[0]); p10=jax.nn.sigmoid(p[1])\n    return jnp.stack([row(p01,p10,k) for k in range(4)])\n\nparams=jnp.array([float(np.log(0.07/0.93)), float(np.log(0.04/0.96))], jnp.float32)\n\nt0=time.time(); t=table(params); t.block_until_ready(); print('\"'eager table', time.time()-t0)\n\n# Try jit one row\nrow_jit = tc.backend.jit(lambda p01,p10: row(p01,p10,2))\nt0=time.time(); r=row_jit(0.07,0.04); r.block_until_ready(); print('jit row0', time.time()-t0, r[:3])\nt0=time.time(); r=row_jit(0.07,0.04); r.block_until_ready(); print('jit row1', time.time()-t0)\n\n# jit all via 4 kinds as int argument - may not work\n# separate 4 jitted\nfuns=[]\nfor kind in range(4):\n    funs.append(tc.backend.jit(lambda p01,p10,kind=kind: row(p01,p10,kind)))\n\ndef table2(p):\n    p01=jax.nn.sigmoid(p[0]); p10=jax.nn.sigmoid(p[1])\n    return jnp.stack([f(p01,p10) for f in funs])\n\nt0=time.time(); t=table2(params); t.block_until_ready(); print('table2 compile', time.time()-t0)\nt0=time.time(); t=table2(params); t.block_until_ready(); print('table2 run', time.time()-t0)\n\ndef loss(p, target):\n    pred=table2(p)\n    return jnp.mean((pred-target)**2)\n\n# target\ntarget=table2(jnp.array([float(np.log(0.034/0.966)), float(np.log(0.011/0.989))], jnp.float32))\nt0=time.time(); v,g=jax.value_and_grad(loss)(params, target); v.block_until_ready(); print('vjp', float(v), np.array(g), time.time()-t0)\nt0=time.time(); v,g=jax.value_and_grad(loss)(params, target); v.block_until_ready(); print('vjp2', float(v), np.array(g), time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
