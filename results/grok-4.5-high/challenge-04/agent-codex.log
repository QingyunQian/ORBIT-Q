{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.channels import kraus_to_super_gate\nimport numpy as np\nimport time\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\nn=12\ndim=1<<n\nangle=0.31\n\ndef kraus(p01,p10):\n    K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128)\n    K1=np.array([[0,np.sqrt(p10)],[0,0]],np.complex128)\n    K2=np.array([[0,0],[np.sqrt(p01),0]],np.complex128)\n    return [K0,K1,K2]\n\nKs=kraus(0.034,0.011)\n# super gate shape\nsg = kraus_to_super_gate(Ks)\nprint('super', type(sg), np.array(sg).shape)\n\n# How DMCircuit applies - reshape to 4 legs of dim 2\nsuper_op = np.array(sg).reshape([2]*4)\nprint(super_op.shape)\n\n# Apply to density matrix tensor using tn-like einsum\nrho = np.zeros((dim,dim),np.complex128); rho[0,0]=1\n# reshape to 2*n indices\nrho_t = rho.reshape([2]*(2*n))\n\ndef apply_super_1q(rho_t, super_op, q):\n    # super_op legs: out_ket, out_bra, in_ket, in_bra? need check kraus_to_super_gate\n    # From DMCircuit:\n    # nlegs=4, o2i=2, r2l=1\n    # super_op.get_edge(i + r2l + o2i) \"'^ front[ind + nqubits]  # edge 1+2=3 -> bra in?\n    # front[ind+nqubits] = edge 1  # bra out\n    # edge i+o2i=2 ''^ front[ind] # ket in\n    # front[ind] = edge 0  # ket out\n    # So legs: 0 ket_out, 1 bra_out, 2 ket_in, 3 bra_in\n    ket_in = q\n    bra_in = n+q\n    # einsum\n    # rho_t has axes 0..n-1 ket, n..2n-1 bra\n    return np.einsum(super_op, [0,1, ket_in, bra_in], rho_t, list(range(2*n)), [0 if i==ket_in else 1 if i==bra_in else i for i in range(2*n)], optimize=True)\n\n# Check convention via single qubit\nrho1 = np.array([[1,0],[0,0]],np.complex128)\n# apply channel via evol_kraus\nfrom tensorcircuit.channels import evol_kraus\nrho1b = np.array(evol_kraus(rho1, Ks))\nprint('\"'evol', rho1b)\n\n# vectorized super: svec = super @ vec(rho)\n# kraus_to_super format?\nS = np.array(sg)\nprint('S shape', S.shape)\n# try \nv = rho1.reshape(4, order='F')  # col major?\nprint('try F', (S @ rho1.reshape(4, order='F')).reshape(2,2, order='F'))\nprint('try C', (S @ rho1.reshape(4)).reshape(2,2))\n\n# Look at source\nimport inspect\nprint(inspect.getsource(tc.channels.kraus_to_super_gate))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
