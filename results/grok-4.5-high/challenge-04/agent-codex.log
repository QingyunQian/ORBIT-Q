{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\nn = 12\ndim = 2 ** n\nangle = 0.31\nU = np.asarray(tc.gates.rxx(theta=angle).tensor, dtype=np.complex128).reshape(4, 4)\nprint('U ok', U.shape)\n\ndef kraus(p01, p10):\n    K0 = np.array([[np.sqrt(1-p01), 0], [0, np.sqrt(1-p10)]], dtype=np.complex128)\n    K1 = np.array([[0, np.sqrt(p10)], [0, 0]], dtype=np.complex128)\n    K2 = np.array([[0, 0], [np.sqrt(p01), 0]], dtype=np.complex128)\n    return [K0, K1, K2]\n\ndef apply_unitary_2q(rho, U4, q1, q2):\n    # rho: (dim,dim)\n    left = 2 ** q1\n    mid = 2 ** (q2 - q1 - 1)\n    right = 2 ** (n - q2 - 1)\n    r = rho.reshape(left, 2, mid, 2, right, left, 2, mid, 2, right)\n    # bring ket qubits together and bra qubits together\n    # shape to (left*mid*right, 4, left*mid*right, 4)\n    r = np.transpose(r, (0, 2, 4, 1, 3, 5, 7, 9, 6, 8))\n    # (L,M,R, k1,k2, L,M,R, b1,b2)\n    r = r.reshape(left*mid*right, 4, left*mid*right, 4)\n    r = np.einsum('ij,ajbk,lk->ailb', U4, r, np.conj(U4), optimize=True)\n    r = r.reshape(left, mid, right, 2, 2, left, mid, right, 2, 2)\n    r = np.transpose(r, (0, 3, 1, 4, 2, 5, 8, 6, 9, 7))\n    return r.reshape(dim, dim)\n\ndef apply_channel_1q(rho, Ks, q):\n    left = 2 ** q\n    right = 2 ** (n - q - 1)\n    r = rho.reshape(left, 2, right, left, 2, right)\n    r = np.transpose(r, (0, 2, 1, 3, 5, 4))  # L R k L R b\n    r = r.reshape(left*right, 2, left*right, 2)\n    out = np.zeros_like(r)\n    for K in Ks:\n        out += np.einsum('ij,ajbk,lk->ailb', K, r, np.conj(K), optimize=True)\n    out = out.reshape(left, right, 2, left, right, 2)\n    out = np.transpose(out, (0, 2, 1, 3, 5, 4))\n    return out.reshape(dim, dim)\n\ndef init_rho(kind):\n    psi = np.zeros(dim, dtype=np.complex128)\n    if kind == 0:\n        psi[0] = 1/np.sqrt(2); psi[-1]=1/np.sqrt(2)\n    elif kind == 1:\n        psi = np.array([1.0], dtype=np.complex128)\n        s = 1/np.sqrt(2)\n        for _ in range(n//2):\n            a = np.zeros(psi.size*4, dtype=np.complex128)\n            a[1::4] = psi*s\n            a[2::4] = psi*s\n            psi = a\n    elif kind == 2:\n        psi[0] = 1\n    else:\n        psi[:] = 1/np.sqrt(dim)\n    return np.outer(psi, np.conj(psi))\n\ndef expects(rho):\n    diag = np.real(np.diag(rho))\n    outs = []\n    idx = np.arange(dim)\n    for q in range(n):\n        signs = 1 - 2*((idx >> (n-1-q)) & 1)\n        outs.append(diag @ signs)\n    parity = np.zeros(dim, np.int64)\n    x = idx.copy()\n    for _ in range(n):\n        parity \"'^= x & 1\n        x >>= 1\n    outs.append(diag @ (1-2*parity))\n    return np.array(outs)\n\ndef evolve(kind, p01, p10):\n    rho = init_rho(kind)\n    Ks = kraus(p01, p10)\n    for i in range(0, n-1, 2):\n        rho = apply_unitary_2q(rho, U, i, i+1)\n        rho = apply_channel_1q(rho, Ks, i)\n        rho = apply_channel_1q(rho, Ks, i+1)\n    for i in range(1, n-1, 2):\n        rho = apply_unitary_2q(rho, U, i, i+1)\n        rho = apply_channel_1q(rho, Ks, i)\n        rho = apply_channel_1q(rho, Ks, i+1)\n    return expects(rho)\n\n# validate vs DMCircuit\ndef ref(kind, p01, p10):\n    c=tc.DMCircuit(n)\n    if kind==0:\n        c.h(0)\n        for i in range(n-1): c.cnot(i,i+1)\n    elif kind==1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind==3:\n        for i in range(n): c.h(i)\n    Ks=kraus(p01,p10)\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n    rho=np.array(c.state(),dtype=np.complex128)\n    return expects(rho)\n\nfor kind in range(4):\n    t0=time.time(); v=evolve(kind,0.034,0.011); t1=time.time()\n    r=ref(kind,0.034,0.011)\n    print(kind, '\"'time', t1-t0, 'diff', np.max(np.abs(v-r)))\n\nt0=time.time(); tab=np.stack([evolve(k,0.034,0.011) for k in range(4)]); print('table', time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
