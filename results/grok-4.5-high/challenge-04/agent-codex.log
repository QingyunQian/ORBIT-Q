{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\ndim = 2 ** n\nangle = 0.31\nU_rxx = jnp.asarray(tc.gates.rxx(theta=angle).tensor, dtype=jnp.complex64)  # (2,2,2,2)\n\ndef kraus_stack(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1 - p01), 0.0], [0.0, jnp.sqrt(1 - p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0.0, jnp.sqrt(p10)], [0.0, 0.0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0.0, 0.0], [jnp.sqrt(p01), 0.0]], dtype=jnp.complex64)\n    return jnp.stack([K0, K1, K2], axis=0)\n\ndef apply_two_qubit_unitary(rho, U, q1, q2):\n    left = 2 ** q1\n    mid = 2 ** (q2 - q1 - 1)\n    right = 2 ** (n - q2 - 1)\n    # indices: L q1 M q2 R | L q1 M q2 R\n    rho = rho.reshape(left, 2, mid, 2, right, left, 2, mid, 2, right)\n    # U: o1 o2 i1 i2\n    # left: contract i1,i2 with ket q1,q2\n    rho = jnp.einsum('o p i j, a i b j c  d e f g h -> a o b p c  d e f g h', U, rho, optimize=True)\n    # right: bra transforms with Uconj on output legs -> contract bra q1,q2 (e,g) as out of U*, free i,j become new bra\n    # <bra| U\"'^dag = components: sum_{e,g} rho[..., e, ..., g, ...] conj(U)[e,g,i,j] wait\n    # If ket'\"' = U ket, bra' = bra U\"'^dag, so rho'\"' = U rho U\"'^dag\n    # U''^dag_{ij, eg} = conj(U_{eg, ij}) = conj(U)[e,g,i,j]\n    # rho'\"'_{ao b p c, d i f j h} = sum_{e g} rho_{ao b p c, d e f g h} * conj(U)_{e g i j}\n    rho = jnp.einsum('a o b p c d e f g h, e g i j -> a o b p c d i f j h', rho, jnp.conj(U), optimize=True)\n    return rho.reshape(dim, dim)\n\ndef apply_one_qubit_channel(rho, Ks, q):\n    left = 2 ** q\n    right = 2 ** (n - q - 1)\n    rho = rho.reshape(left, 2, right, left, 2, right)\n    rho = jnp.einsum('k o i, a i b c j d, k p j -> a o b c p d', Ks, rho, jnp.conj(Ks), optimize=True)\n    return rho.reshape(dim, dim)\n\ndef expect_z(rho, q):\n    left = 2 ** q\n    right = 2 ** (n - q - 1)\n    diag = jnp.diagonal(rho).real.reshape(left, 2, right)\n    return diag[:, 0, :].sum() - diag[:, 1, :].sum()\n\ndef expect_allz(rho):\n    d = jnp.diagonal(rho).real\n    # parity of bitcount\n    bits = jnp.arange(dim)\n    parity = jnp.zeros(dim, dtype=jnp.int32)\n    x = bits\n    for _ in range(n):\n        parity = parity \"'^ (x & 1)\n        x = x >> 1\n    signs = 1 - 2 * parity\n    return jnp.sum(d * signs)\n\ndef init_rho(kind):\n    psi = jnp.zeros((dim,), dtype=jnp.complex64)\n    if kind == 0:\n        s = 1 / jnp.sqrt(jnp.array(2.0, dtype=jnp.float32))\n        psi = psi.at[0].set(s)\n        psi = psi.at[dim - 1].set(s)\n    elif kind == 1:\n        psi = jnp.array([1.0], dtype=jnp.complex64)\n        s = 1 / jnp.sqrt(jnp.array(2.0, dtype=jnp.float32))\n        for _ in range(0, n, 2):\n            a = jnp.zeros(psi.shape[0] * 4, dtype=jnp.complex64)\n            a = a.at[1::4].set(psi * s)\n            a = a.at[2::4].set(psi * s)\n            psi = a\n    elif kind == 2:\n        psi = psi.at[0].set(1.0)\n    else:\n        psi = jnp.ones((dim,), dtype=jnp.complex64) / jnp.sqrt(jnp.array(float(dim), dtype=jnp.float32))\n    return jnp.outer(psi, jnp.conj(psi)).astype(jnp.complex64)\n\ndef evolve_kind(p01, p10, kind):\n    Ks = kraus_stack(p01, p10)\n    rho = init_rho(kind)\n    for i in range(0, n - 1, 2):\n        rho = apply_two_qubit_unitary(rho, U_rxx, i, i + 1)\n        rho = apply_one_qubit_channel(rho, Ks, i)\n        rho = apply_one_qubit_channel(rho, Ks, i + 1)\n    for i in range(1, n - 1, 2):\n        rho = apply_two_qubit_unitary(rho, U_rxx, i, i + 1)\n        rho = apply_one_qubit_channel(rho, Ks, i)\n        rho = apply_one_qubit_channel(rho, Ks, i + 1)\n    zs = [expect_z(rho, q) for q in range(n)]\n    zs.append(expect_allz(rho))\n    return jnp.stack(zs)\n\n# Reference with DMCircuit numpy\ndef ref(kind, p01, p10):\n    tc.set_backend('\"'numpy')\n    c = tc.DMCircuit(n)\n    if kind == 0:\n        c.h(0)\n        for i in range(n-1):\n            c.cnot(i,i+1)\n    elif kind == 1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind == 3:\n        for i in range(n):\n            c.h(i)\n    K0 = np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]], dtype=np.complex64)\n    K1 = np.array([[0,np.sqrt(p10)],[0,0]], dtype=np.complex64)\n    K2 = np.array([[0,0],[np.sqrt(p01),0]], dtype=np.complex64)\n    k=[K0,K1,K2]\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n    outs=[]\n    for i in range(n):\n        outs.append(float(np.real(c.expectation_ps(z=[i]))))\n    outs.append(float(np.real(c.expectation_ps(z=list(range(n))))))\n    tc.set_backend('jax')\n    return np.array(outs)\n\nfor kind in range(4):\n    t0=time.time()\n    val = np.array(evolve_kind(0.034,0.011,kind))\n    print('kind', kind, 'time', time.time()-t0, 'maxdiff', np.max(np.abs(val-ref(kind,0.034,0.011))))\n    print(val)\n\n# JIT all table\ndef all_table(params):\n    p01 = jax.nn.sigmoid(params[0])\n    p10 = jax.nn.sigmoid(params[1])\n    return jnp.stack([evolve_kind(p01, p10, k) for k in range(4)], axis=0)\n\nf = jax.jit(all_table)\n# init from 0.07, 0.04\nr0 = jnp.log(jnp.array([0.07,0.04])/ (1-jnp.array([0.07,0.04])))\nt0=time.time(); out=f(r0).block_until_ready(); print('jit1', time.time()-t0)\nt0=time.time(); out=f(r0).block_until_ready(); print('jit2', time.time()-t0, out.shape)\n\n# value and grad\ndef loss_fn(params, target):\n    pred = all_table(params)\n    return jnp.mean((pred - target)**2)\n\ntarget = f(jnp.log(jnp.array([0.034,0.011])/(1-jnp.array([0.034,0.011]))))\ng = jax.jit(jax.value_and_grad(loss_fn))\nt0=time.time(); l,grads=g(r0, target); l.block_until_ready(); print('grad1', time.time()-t0, fl