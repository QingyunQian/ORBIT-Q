{"type":"item.started","item":{"id":"item_81","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numba as nb\nimport numpy as np\nimport tensorcircuit as tc\nimport time\n\ntc.set_backend('numpy')\nn=12\ndim=1<<n\nangle=0.31\nU=np.asarray(tc.gates.rxx(theta=angle).tensor,dtype=np.complex128).reshape(4,4)\nU = np.ascontiguousarray(U)\n\n@nb.njit(cache=True)\ndef apply_adj_U(rho, U4, q1, n):\n    # rho flattened (dim*dim,) complex128 or 2d\n    dim = 1<<n\n    left = 1<<q1\n    right = 1<<(n-q1-2)\n    out = np.zeros_like(rho)\n    # iterate basis indices\n    # ket index i, bra j\n    # For each left, mid(4), right\n    for a in range(left):\n        for b in range(right):\n            for c in range(left):\n                for d in range(right):\n                    # block 4x4\n                    # gather\n                    for k in range(4):\n                        for l in range(4):\n                            # compute\n                            pass\n    return rho\n\n# Better: reshape-free using strides in numpy with BLAS\n# Use (m,4,m,4) blocks when qubits are at LSB; permute indices with bit reorder arrays.\n\ndef bit_perm_to_end(qs, n):\n    qs=list(qs)\n    rest=[q for q in range(n) if q not in qs]\n    order=rest+qs\n    # new_idx from old_idx\n    old = np.arange(1<<n)\n    new = np.zeros(1<<n, dtype=np.int64)\n    for pos,q in enumerate(order):\n        bit = (old >> (n-1-q)) & 1\n        new |= bit << (n-1-pos)\n    # We want permutation P such that state_new = state_old[P] means gathering old indices in new order\n    # state_new[new_i] = state_old[old_i] where new_i = transform(old_i)\n    # so state_new = state_old[inv_transform]\n    inv = np.empty_like(new)\n    inv[new] = old\n    return inv\n\n# Precompute\npair_inv = {}\nfor i in range(n-1):\n    pair_inv[i] = bit_perm_to_end([i,i+1], n)\nsingle_inv = {}\nfor i in range(n):\n    single_inv[i] = bit_perm_to_end([i], n)\n\n@nb.njit(cache=True)\ndef apply_gate_end(rho, G, nq):\n    dim = rho.shape[0]\n    d = 1<<nq\n    m = dim // d\n    out = np.zeros_like(rho)\n    # rho reshaped (m,d,m,d)\n    Gd = G.conj().T  # for right? we'll do G @ block @ G\"'^dag\n    for a in range(m):\n        for b in range(m):\n            # extract block d x d\n            block = np.empty((d,d), dtype=np.complex128)\n            for i in range(d):\n                for j in range(d):\n                    block[i,j] = rho[a*d+i, b*d+j]\n            # G block G''^dag\n            tmp = G @ block\n            block2 = tmp @ G.conj().T\n            for i in range(d):\n                for j in range(d):\n                    out[a*d+i, b*d+j] = block2[i,j]\n    return out\n\n# This is O(m''^2 * d''^3) = O(dim''^2 * d) roughly - for d=4, m=1024, m''^2=1e6, * 64 ops = ok\n\n@nb.njit(cache=True)\ndef apply_channel_end(rho, Ks):\n    dim = rho.shape[0]\n    d = 2\n    m = dim // d\n    out = np.zeros_like(rho)\n    for a in range(m):\n        for b in range(m):\n            block = np.empty((d,d), dtype=np.complex128)\n            for i in range(d):\n                for j in range(d):\n                    block[i,j] = rho[a*d+i, b*d+j]\n            acc = np.zeros((d,d), dtype=np.complex128)\n            for k in range(Ks.shape[0]):\n                K = Ks[k]\n                tmp = K @ block\n                acc += tmp @ K.conj().T\n            for i in range(d):\n                for j in range(d):\n                    out[a*d+i, b*d+j] = acc[i,j]\n    return out\n\n@nb.njit(cache=True)\ndef permute_rho(rho, inv):\n    # rho2 = rho[np.ix_(inv,inv)]\n    dim=rho.shape[0]\n    out=np.empty_like(rho)\n    for i in range(dim):\n        ii=inv[i]\n        for j in range(dim):\n            out[i,j]=rho[ii, inv[j]]\n    return out\n\n# Test speed of permute - might be slow in python loops even numba\nrho=np.zeros((dim,dim),np.complex128); rho[0,0]=1\ninv=pair_inv[0]\nt0=time.time(); \n# compile\nr2=permute_rho(rho, inv)\nprint('\"'compile perm', time.time()-t0)\nt0=time.time();\nfor _ in range(5):\n    r2=permute_rho(rho, inv)\nprint('perm x5', time.time()-t0)\n\nt0=time.time()\nr3=apply_gate_end(rho, U, 2)\nprint('gate compile', time.time()-t0)\nt0=time.time()\nfor _ in range(5):\n    r3=apply_gate_end(rho, U, 2)\nprint('gate x5', time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
