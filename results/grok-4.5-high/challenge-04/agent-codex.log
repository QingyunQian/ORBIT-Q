{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport os\nos.environ['XLA_PYTHON_CLIENT_PREALLOCATE'] = 'false'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\ndim = 1 << n\nangle = np.float32(0.31)\nU = jnp.asarray(np.asarray(tc.gates.rxx(theta=float(angle)).tensor).reshape(4,4).astype(np.complex64))\n\ndef apply_adjacent_unitary(rho, U4, q1):\n    # q2 = q1+1 adjacent\n    left = 1 << q1\n    right = 1 << (n - q1 - 2)\n    r = rho.reshape(left, 4, right, left, 4, right)\n    # r[a,k,b,c,l,d]; apply U on k, Uconj on l\n    # use two tensordots via reshape to matmul\n    # First left-multiply: treat as (4, left*right*left*4*right) after moving axis\n    r2 = jnp.swapaxes(r, 0, 1).reshape(4, -1)\n    r2 = U4 @ r2\n    r = r2.reshape(4, left, right, left, 4, right)\n    r = jnp.swapaxes(r, 0, 1)  # left,4,right,left,4,right\n    # right multiply by U\"'^dag on axis 4: sum_l r[...,l,...] conj(U)[j,l] = (r @ U''^dag.T?) \n    # out_j = sum_l r_l * conj(U)_{j l} = sum_l r_l Udag_{l j}\n    # so last axis of size 4: r_mat @ U.conj().T ? \n    # r shape (..., 4) @ (4,4) with matrix U''^dag.T = conj(U)\n    r2 = r.reshape(-1, 4)\n    r2 = r2 @ jnp.conj(U4).T  # wait: (r @ M)_{j} = sum_l r_l M_l j with M = conj(U).T => M_lj = conj(U)_jl so outj=sum r_l conj(U)_jl yes\n    r = r2.reshape(left, 4, right, left, right, 4)\n    r = jnp.moveaxis(r, -1, 4)\n    return r.reshape(dim, dim)\n\ndef apply_channel(rho, Ks, q):\n    left = 1 << q\n    right = 1 << (n - q - 1)\n    r = rho.reshape(left, 2, right, left, 2, right)\n    acc = 0\n    for k in range(3):\n        K = Ks[k]\n        t = jnp.swapaxes(r, 0, 1).reshape(2, -1)\n        t = K @ t\n        t = t.reshape(2, left, right, left, 2, right)\n        t = jnp.swapaxes(t, 0, 1)\n        t2 = t.reshape(-1, 2) @ jnp.conj(K).T\n        t2 = t2.reshape(left, 2, right, left, right, 2)\n        t2 = jnp.moveaxis(t2, -1, 4)\n        acc = acc + t2\n    return acc.reshape(dim, dim)\n\ndef kraus_stack(p01, p10):\n    s01 = jnp.sqrt(1.0 - p01).astype(jnp.float32)\n    s10 = jnp.sqrt(1.0 - p10).astype(jnp.float32)\n    sp01 = jnp.sqrt(p01).astype(jnp.float32)\n    sp10 = jnp.sqrt(p10).astype(jnp.float32)\n    K0 = jnp.array([[s01, 0], [0, s10]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, sp10], [0, 0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0, 0], [sp01, 0]], dtype=jnp.complex64)\n    return jnp.stack([K0, K1, K2], axis=0)\n\ndef init_rho(kind):\n    psi = jnp.zeros((dim,), dtype=jnp.complex64)\n    if kind == 0:\n        s = jnp.array(1/np.sqrt(2), dtype=jnp.complex64)\n        psi = psi.at[0].set(s).at[dim-1].set(s)\n    elif kind == 1:\n        # build iteratively with numpy then convert? use jax\n        vals = jnp.array([1.0], dtype=jnp.complex64)\n        s = jnp.array(1/np.sqrt(2), dtype=jnp.complex64)\n        for _ in range(n//2):\n            a = jnp.zeros(vals.shape[0]*4, dtype=jnp.complex64)\n            a = a.at[1::4].set(vals*s).at[2::4].set(vals*s)\n            vals = a\n        psi = vals\n    elif kind == 2:\n        psi = psi.at[0].set(1.0)\n    else:\n        psi = jnp.ones((dim,), dtype=jnp.complex64) * jnp.array(1/np.sqrt(dim), dtype=jnp.complex64)\n    return jnp.outer(psi, jnp.conj(psi))\n\n# precompute sign tables\nidx = np.arange(dim)\nz_signs = np.stack([1-2*((idx >> (n-1-q)) & 1) for q in range(n)], axis=0).astype(np.float32)\nparity = np.zeros(dim, np.int32)\nx = idx.copy()\nfor _ in range(n):\n    parity ''^= x & 1\n    x >>= 1\nall_signs = (1-2*parity).astype(np.float32)\nz_signs_j = jnp.asarray(z_signs)\nall_signs_j = jnp.asarray(all_signs)\n\ndef expects(rho):\n    diag = jnp.real(jnp.diag(rho))\n    zs = z_signs_j @ diag\n    pz = jnp.dot(all_signs_j, diag)\n    return jnp.concatenate([zs, pz[None]])\n\ndef evolve_kind(p01, p10, kind):\n    Ks = kraus_stack(p01, p10)\n    rho = init_rho(kind)\n    # even\n    for i in range(0, n-1, 2):\n        rho = apply_adjacent_unitary(rho, U, i)\n        rho = apply_channel(rho, Ks, i)\n        rho = apply_channel(rho, Ks, i+1)\n    for i in range(1, n-1, 2):\n        rho = apply_adjacent_unitary(rho, U, i)\n        rho = apply_channel(rho, Ks, i)\n        rho = apply_channel(rho, Ks, i+1)\n    return expects(rho)\n\ndef all_table(p01, p10):\n    return jnp.stack([evolve_kind(p01, p10, k) for k in range(4)], axis=0)\n\n# validate one with numpy DMCircuit\ntc.set_backend('\"'numpy')\ndef ref(p01,p10):\n    rows=[]\n    for kind in range(4):\n        c=tc.DMCircuit(n)\n        if kind==0:\n            c.h(0)\n            for i in range(n-1): c.cnot(i,i+1)\n        elif kind==1:\n            for i in range(0,n,2):\n                c.x(i+1); c.h(i); c.cnot(i,i+1)\n        elif kind==3:\n            for i in range(n): c.h(i)\n        K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex64)\n        K1=np.array([[0,np.sqrt(p10)],[0,0]],np.complex64)\n        K2=np.array([[0,0],[np.sqrt(p01),0]],np.complex64)\n        Ks=[K0,K1,K2]\n        for i in range(0,n-1,2):\n            c.rxx(i,i+1,theta=float(angle)); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        for i in range(1,n-1,2):\n            c.rxx(i,i+1,theta=float(angle)); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        rho=np.array(c.state()); diag=np.real(np.diag(rho))\n        outs=[float(z_signs[q]@diag) for q in range(n)]\n        outs.append(float(all_signs@diag))\n        rows.append(outs)\n    return np.array(rows)\nrtab=ref(0.034,0.011)\ntc.set_backend('jax')\n\nt0=time.time(); tab=np.array(all_table(0.034,0.011)); print('eager', time.time()-t0, 'diff', np.max(np.abs(tab-rtab)))\n\nf = jax.jit(all_table)\nt0=time.time(); tab=np.array(f(0.034,0.011)); print('jit1', time.time()-t0)\nt0=time.time(); tab=np.array(f(0.034,0.011)); print('jit2', time.time()-t0, 'diff', np.max(np.abs(tab-rtab)))\n\ndef loss(params, target):\n    p = jax.nn.sigmoid(params)\n    pred = all_table(p[0], p[1])\n    return jnp.mean((pred-target)**2)\n\nparams0 = jnp.log(jnp.array([0.07,0.04])/(1-jnp.array([0.07,0.04])))\ntarget = f(0.034,0.011)\n# forward-mode value_and_grad via jacfwd\nloss_jit = jax.jit(loss)\nt0=time.time(); print('loss', float(loss_jit(params0,target)), 't', time.time()-t0)\nt0=time.time(); print('loss2', float(loss_jit(params0,target)), 't', time.time()-t0)\n\n# jacfwd\ngfun = jax.jit(lambda p,t: jax.jacfwd(loss)(p,t))\nt0=time.time(); g=gfun(params0,target); g.block_until_ready(); print('g1', time.time()-t0, np.array(g))\nt0=time.time(); g=gfun(params0,target); g.block_until_ready(); print('g2', time.time()-t0, np.array(g))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
