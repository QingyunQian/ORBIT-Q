{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\ndim = 2 ** n\nangle = 0.31\nU_rxx = jnp.asarray(tc.gates.rxx(theta=angle).tensor, dtype=jnp.complex64).reshape(4, 4)\n\ndef kraus_stack(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1 - p01), 0.0], [0.0, jnp.sqrt(1 - p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0.0, jnp.sqrt(p10)], [0.0, 0.0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0.0, 0.0], [jnp.sqrt(p01), 0.0]], dtype=jnp.complex64)\n    return jnp.stack([K0, K1, K2], axis=0)\n\ndef apply_two_qubit_unitary(rho, U, q1, q2):\n    # qubit 0 = MSB\n    # ensure q1 < q2\n    b = 1 << (n - q1 - 1)  # not using this\n    # sizes\n    left = 2 ** q1\n    mid = 2 ** (q2 - q1 - 1)\n    right = 2 ** (n - q2 - 1)\n    rho = rho.reshape(left, 2, mid, 2, right, left, 2, mid, 2, right)\n    # U reshaped as (out1,out2,in1,in2)\n    Ur = U.reshape(2, 2, 2, 2)\n    # left apply\n    rho = jnp.einsum('o p i j, a i b j c d e f g h -> a o b p c d e f g h', Ur, rho, optimize=True)\n    # right apply U* on bra: indices d,f are in1,in2 of bra (qubit q1,q2 on right)\n    # bra transforms as conj: <psi| U\"'^dag => components with U*\n    rho = jnp.einsum('\"'a o b p c d e f g h, o p i j -> a o b p c d e i g j h', rho, jnp.conj(Ur), optimize=True)\n    return rho.reshape(dim, dim)\n\ndef apply_one_qubit_channel(rho, Ks, q):\n    left = 2 ** q\n    right = 2 ** (n - q - 1)\n    rho = rho.reshape(left, 2, right, left, 2, right)\n    # sum_k K * rho * K\"'^dag\n    rho = jnp.einsum('\"'k o i, a i b c j d, k p j -> a o b c p d', Ks, rho, jnp.conj(Ks), optimize=True)\n    return rho.reshape(dim, dim)\n\ndef expect_z(rho, q):\n    left = 2 ** q\n    right = 2 ** (n - q - 1)\n    # diagonal blocks\n    diag = jnp.diagonal(rho).real.reshape(left, 2, right)\n    # Z: |0> +1, |1> -1\n    return diag[:, 0, :].sum() - diag[:, 1, :].sum()\n\ndef expect_allz(rho):\n    # parity Z0...Z11 = product of Z = (+1 if even # of 1s else -1) on diagonal\n    d = jnp.diagonal(rho).real\n    bits = jnp.arange(dim)\n    # count parity of all bits\n    # popcount mod 2\n    parity = jnp.zeros(dim, dtype=jnp.int32)\n    x = bits\n    for _ in range(n):\n        parity = parity \"'^ (x & 1)\n        x = x >> 1\n    signs = 1 - 2 * parity\n    return jnp.sum(d * signs)\n\ndef init_rho(kind):\n    # build pure state then rho = |psi><psi|\n    psi = jnp.zeros((dim,), dtype=jnp.complex64)\n    if kind == 0:  # GHZ\n        psi = psi.at[0].set(1 / jnp.sqrt(2))\n        psi = psi.at[dim - 1].set(1 / jnp.sqrt(2))\n    elif kind == 1:  # Bell pairs on (0,1),(2,3),...\n        # state = product of (|01>+|10>)/sqrt2\n        # bit pattern: for each pair, 01 or 10\n        # We'\"'ll construct iteratively\n        psi = jnp.array([1.0], dtype=jnp.complex64)\n        for _ in range(0, n, 2):\n            # expand by 2 qubits: |01> and |10|\n            a = jnp.zeros(psi.shape[0] * 4, dtype=jnp.complex64)\n            # old @ |01> -> offset 1\n            a = a.at[1::4].set(psi / jnp.sqrt(2))\n            # old @ |10> -> offset 2\n            a = a.at[2::4].set(psi / jnp.sqrt(2))\n            psi = a\n    elif kind == 2:  # |0>\n        psi = psi.at[0].set(1.0)\n    elif kind == 3:  # |+>\"'^n\n        psi = jnp.ones((dim,), dtype=jnp.complex64) / jnp.sqrt(dim)\n    rho = jnp.outer(psi, jnp.conj(psi))\n    return rho\n\ndef evolve_kind(p01, p10, kind):\n    Ks = kraus_stack(p01, p10)\n    rho = init_rho(kind)\n    # even bonds\n    for i in range(0, n - 1, 2):\n        rho = apply_two_qubit_unitary(rho, U_rxx, i, i + 1)\n        rho = apply_one_qubit_channel(rho, Ks, i)\n        rho = apply_one_qubit_channel(rho, Ks, i + 1)\n    # odd bonds\n    for i in range(1, n - 1, 2):\n        rho = apply_two_qubit_unitary(rho, U_rxx, i, i + 1)\n        rho = apply_one_qubit_channel(rho, Ks, i)\n        rho = apply_one_qubit_channel(rho, Ks, i + 1)\n    zs = [expect_z(rho, q) for q in range(n)]\n    zs.append(expect_allz(rho))\n    return jnp.stack(zs)\n\ndef all_table(p01, p10):\n    return jnp.stack([evolve_kind(p01, p10, k) for k in range(4)], axis=0)\n\n# Compare against DMCircuit for kind=2\ntc.set_backend('\"'numpy')\ndef ref(kind, p01, p10):\n    c = tc.DMCircuit(n)\n    if kind == 0:\n        c.h(0)\n        for i in range(n-1):\n            c.cnot(i,i+1)\n    elif kind == 1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind == 3:\n        for i in range(n):\n            c.h(i)\n    K0 = np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]], dtype=np.complex64)\n    K1 = np.array([[0,np.sqrt(p10)],[0,0]], dtype=np.complex64)\n    K2 = np.array([[0,0],[np.sqrt(p01),0]], dtype=np.complex64)\n    k=[K0,K1,K2]\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n    outs=[]\n    for i in range(n):\n        outs.append(np.real(c.expectation_ps(z=[i])))\n    outs.append(np.real(c.expectation_ps(z=list(range(n)))))\n    return np.array(outs)\n\ntc.set_backend('jax')\nfor kind in range(4):\n    t0=time.time()\n    val = evolve_kind(0.034,0.011,kind).block_until_ready()\n    print('kind', kind, 'eager', time.time()-t0)\n    r = ref(kind, 0.034, 0.011)\n    print(' maxdiff', np.max(np.abs(np.array(val)-r)))\n    print(' val', np.array(val))\n    print(' ref', r)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
