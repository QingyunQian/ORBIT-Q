{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\ndim = 2**n\nangle = 0.31\n\n# Get gate matrices via TC\nrxx = tc.gates.rxx(theta=angle).tensor  # shape (2,2,2,2) or (4,4)?\nprint('rxx', rxx.shape, rxx.dtype)\n\ndef kraus_list(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1-p01), 0],[0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)],[0,0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0,0],[jnp.sqrt(p01),0]], dtype=jnp.complex64)\n    return [K0,K1,K2]\n\ndef apply_unitary_2q(rho, U, i, j):\n    # rho: (2,)*n + (2,)*n\n    # Apply U on qubits i,j: rho' = U rho U\"'^dag\n    # move axes\n    qubits = list(range(n))\n    # reshape rho to 2n indices\n    rho_t = rho.reshape((2,)* (2*n))\n    # apply on left\n    # indices for left qubits 0..n-1, right n..2n-1\n    U4 = U.reshape(2,2,2,2)  # a b, a'\"' b' out,in? tc gate is out legs then in?\n    # tc gates typically shape [2]*2*n_qubits with order out... in...\n    return rho_t  # placeholder\n\nprint(tc.gates.rxx(theta=0.3).tensor.shape)\n# Check gate convention\ng = tc.gates.Gate(np.eye(4).reshape(2,2,2,2))\nprint('ok')\n\n# Try using evol via superoperator on reshaped DM - vectorized\n# rho_vec shape (4**n,) but 4**12 = 16M too big for full superop, but local apply OK\n\ndef apply_1q_channel_vec(rho, Ks, q):\n    # rho shape (2**n, 2**n)\n    # reshape to (2,2,...,2, 2,2,...,2)\n    rho_t = rho.reshape((2,)*(2*n))\n    # We want sum_k K rho K\"'^dag on qubit q\n    # left index q, right index n+q\n    outs = []\n    for K in Ks:\n        # apply K on left index q\n        # einsum\n        left_inds = list(range(2*n))\n        # K_{a, i} * rho_{...i...}\n        # Use tensordot carefully\n        # permute q to front\n        axes = [q] + [a for a in range(n) if a!=q] + [n+q] + [n+a for a in range(n) if a!=q]\n        inv = np.argsort(axes)\n        rt = jnp.transpose(rho_t, axes).reshape(2, 2**(n-1), 2, 2**(n-1))\n        # rt: (i, rest_left, j, rest_right)\n        # new = K @ rho @ K''^dag  => K_ai rt_ij Kdag_jb\n        mid = jnp.einsum('\"'ai,irjs,bj->arbs', K, rt, jnp.conj(K))\n        mid = mid.reshape((2,)*(2*n))\n        mid = jnp.transpose(mid, inv)\n        outs.append(mid)\n    return sum(outs).reshape(2**n, 2**n)\n\ndef apply_2q_unitary(rho, U, i, j):\n    rho_t = rho.reshape((2,)*(2*n))\n    # U shape (4,4) mapping |ij> \n    U4 = U.reshape(2,2,2,2)  # o1,o2,i1,i2\n    axes = [i,j] + [a for a in range(n) if a not in (i,j)] + [n+i,n+j] + [n+a for a in range(n) if a not in (i,j)]\n    inv = np.argsort(axes)\n    rt = jnp.transpose(rho_t, axes).reshape(4, 2**(n-2), 4, 2**(n-2))\n    Um = U.reshape(4,4)\n    mid = jnp.einsum('ab,brcs,dc->ards', Um, rt, jnp.conj(Um))\n    mid = mid.reshape((2,)*(2*n))\n    mid = jnp.transpose(mid, inv)\n    return mid.reshape(2**n, 2**n)\n\n# Get RXX matrix from TC\nU = tc.gates.rxx(theta=angle).tensor\nprint('U raw', U.shape)\nUm = U.reshape(4,4)\nprint(Um)\n\n# initial |0><0|\nrho0 = jnp.zeros((dim,dim), dtype=jnp.complex64)\nrho0 = rho0.at[0,0].set(1.0)\n\ndef evolve(p01, p10):\n    rho = rho0\n    Ks = kraus_list(p01, p10)\n    for i in range(0,n-1,2):\n        rho = apply_2q_unitary(rho, Um, i, i+1)\n        rho = apply_1q_channel_vec(rho, Ks, i)\n        rho = apply_1q_channel_vec(rho, Ks, i+1)\n    for i in range(1,n-1,2):\n        rho = apply_2q_unitary(rho, Um, i, i+1)\n        rho = apply_1q_channel_vec(rho, Ks, i)\n        rho = apply_1q_channel_vec(rho, Ks, i+1)\n    return rho\n\nt0=time.time()\nrho = evolve(0.034, 0.011)\nrho.block_until_ready()\nprint('first', time.time()-t0)\n\n# jit\nfe = jax.jit(evolve)\nt0=time.time()\nrho = fe(0.034, 0.011)\nrho.block_until_ready()\nprint('jit compile', time.time()-t0)\nt0=time.time()\nrho = fe(0.034, 0.011)\nrho.block_until_ready()\nprint('jit run', time.time()-t0)\n\n# Z expectations\ndef z_exp(rho, q):\n    # Z on q\n    rho_t = rho.reshape((2,)*(2*n))\n    # sum_s (-1)\"'^{s_q} rho[s,s]\n    # simpler: diag\n    d = jnp.diag(rho).real\n    # bit of q\n    bits = (jnp.arange(dim) >> (n-1-q)) & 1  # if MSB is qubit 0\n    # Need to know bit ordering of TC - usually qubit 0 is MSB\n    signs = 1 - 2*bits\n    return jnp.sum(d * signs)\n\nprint('\"'Z0', z_exp(rho,0), 'Z1', z_exp(rho,1))\nprint('trace', jnp.trace(rho).real)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
