{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nfrom collections import defaultdict\nimport time\n\ntc.set_backend('numpy')\nn=12\nangle=0.31\nI=np.eye(2,dtype=np.complex128)\nX=np.array([[0,1],[1,0]],np.complex128)\nY=np.array([[0,-1j],[1j,0]],np.complex128)\nZ=np.array([[1,0],[0,-1]],np.complex128)\nP1=[I,X,Y,Z]\n\ndef channel_dual_ptm(p01,p10):\n    Ks=[\n        np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n        np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n        np.array([[0,0],[np.sqrt(p01),0]],np.complex128),\n    ]\n    R=np.zeros((4,4),np.complex128)\n    for b in range(4):\n        Op=sum(K.conj().T@P1[b]@K for K in Ks)\n        for a in range(4):\n            R[a,b]=np.trace(P1[a]@Op)/2\n    return np.real(R)\n\ndef rxx_dual_ptm():\n    U=np.asarray(tc.gates.rxx(theta=angle).tensor,np.complex128).reshape(4,4)\n    P2=[np.kron(P1[i],P1[j]) for i in range(4) for j in range(4)]\n    R=np.zeros((16,16),np.complex128)\n    for b,Pb in enumerate(P2):\n        Op=U.conj().T@Pb@U\n        for a,Pa in enumerate(P2):\n            R[a,b]=np.trace(Pa@Op)/4\n    return np.real(R)\n\nR2=rxx_dual_ptm()\nR1=channel_dual_ptm(0.034,0.011)\nprint('R1\\\\n',R1)\n\ndef apply_1q(op,q,R):\n    new=defaultdict(complex)\n    for s,c in op.items():\n        b=s[q]\n        for a in range(4):\n            v=R[a,b]\n            if abs(v)<1e-15: continue\n            ns=list(s); ns[q]=a\n            new[tuple(ns)] += c*v\n    return {k:v for k,v in new.items() if abs(v)>1e-15}\n\ndef apply_2q(op,q1,q2,R):\n    new=defaultdict(complex)\n    for s,c in op.items():\n        bin=4*s[q1]+s[q2]\n        col=R[:,bin]\n        for aout,val in enumerate(col):\n            if abs(val)<1e-15: continue\n            a1,a2=divmod(aout,4)\n            ns=list(s); ns[q1]=a1; ns[q2]=a2\n            new[tuple(ns)] += c*val\n    return {k:v for k,v in new.items() if abs(v)>1e-15}\n\ndef evolve_size(obs):\n    op={obs:1+0j}\n    ops=[]\n    for i in range(0,n-1,2):\n        ops += [('rxx',i),('ch',i),('ch',i+1)]\n    for i in range(1,n-1,2):\n        ops += [('rxx',i),('ch',i),('ch',i+1)]\n    sizes=[]\n    for typ,arg in reversed(ops):\n        if typ=='rxx':\n            op=apply_2q(op,arg,arg+1,R2)\n        else:\n            op=apply_1q(op,arg,R1)\n        sizes.append(len(op))\n    return len(op), max(sizes)\n\nfor q in range(n):\n    s=[0]*n; s[q]=3\n    print('Z',q, evolve_size(tuple(s)))\nprint('allZ', evolve_size(tuple([3]*n)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
