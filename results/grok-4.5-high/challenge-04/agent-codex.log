{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nn=12\nangle=0.31\n\ndef make_kraus(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1-p01), 0],[0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)],[0,0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0,0],[jnp.sqrt(p01),0]], dtype=jnp.complex64)\n    return [K0,K1,K2]\n\ndef one_row(p01, p10, kind):\n    c = tc.DMCircuit(n)\n    if kind == 0:\n        c.h(0)\n        for i in range(n-1):\n            c.cnot(i,i+1)\n    elif kind == 1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind == 3:\n        for i in range(n):\n            c.h(i)\n    k = make_kraus(p01, p10)\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle)\n        c.apply_general_kraus(k, i)\n        c.apply_general_kraus(k, i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle)\n        c.apply_general_kraus(k, i)\n        c.apply_general_kraus(k, i+1)\n    outs = []\n    for i in range(n):\n        outs.append(jnp.real(c.expectation_ps(z=[i])))\n    outs.append(jnp.real(c.expectation_ps(z=list(range(n)))))\n    return jnp.stack(outs)\n\ndef table(params):\n    p01 = jax.nn.sigmoid(params[0])\n    p10 = jax.nn.sigmoid(params[1])\n    return jnp.stack([one_row(p01,p10,k) for k in range(4)], axis=0)\n\ndef loss(params, target):\n    pred = table(params)\n    return jnp.mean((pred-target)**2)\n\nparams = jnp.array([np.log(0.07/0.93), np.log(0.04/0.96)], dtype=jnp.float32)\n\n# Build target with numpy quickly\ntc.set_backend('numpy')\ndef np_table(p01,p10):\n    rows=[]\n    for kind in range(4):\n        c=tc.DMCircuit(n)\n        if kind==0:\n            c.h(0)\n            for i in range(n-1): c.cnot(i,i+1)\n        elif kind==1:\n            for i in range(0,n,2):\n                c.x(i+1); c.h(i); c.cnot(i,i+1)\n        elif kind==3:\n            for i in range(n): c.h(i)\n        K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex64)\n        K1=np.array([[0,np.sqrt(p10)],[0,0]],np.complex64)\n        K2=np.array([[0,0],[np.sqrt(p01),0]],np.complex64)\n        k=[K0,K1,K2]\n        for i in range(0,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n        for i in range(1,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(k,i); c.apply_general_kraus(k,i+1)\n        outs=[]\n        for i in range(n):\n            outs.append(float(np.real(c.expectation_ps(z=[i]))))\n        outs.append(float(np.real(c.expectation_ps(z=list(range(n))))))\n        rows.append(outs)\n    return np.array(rows,np.float32)\ntarget = jnp.asarray(np_table(0.034,0.011))\ntc.set_backend('jax')\n\nt0=time.time(); v=loss(params, target); print('fwd', float(v), time.time()-t0)\n\n# try jacfwd without jit\nt0=time.time()\ng = jax.jacfwd(loss)(params, target)\nprint('jacfwd', np.array(g), time.time()-t0)\n\n# try value_and_grad without jit  \nt0=time.time()\nv,g = jax.value_and_grad(loss)(params, target)\nprint('vjp', float(v), np.array(g), time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
