{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\ndim = 2**n\nangle = 0.31\nUm = tc.gates.rxx(theta=angle).tensor.reshape(4,4)\n\ndef kraus_mats(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1-p01), 0],[0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)],[0,0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0,0],[jnp.sqrt(p01),0]], dtype=jnp.complex64)\n    return jnp.stack([K0,K1,K2])  # (3,2,2)\n\ndef apply_1q_gate_left_right(rho, M, q):\n    \\\"\\\"\\\"Apply M on left and M\"'^dag on right for qubit q. rho (dim,dim)\"\"\"\n    # bit ordering: qubit 0 is MSB\n    left = 2**(n-1-q)\n    # reshape into (before, 2, after, before, 2, after) where before = 2''^q, after = 2''^{n-1-q}\n    b = 2**q\n    a = 2**(n-1-q)\n    rt = rho.reshape(b, 2, a, b, 2, a)\n    # left multiply M on axis 1, right multiply conj(M) on axis 4\n    # new[b,o,a,b2,o2,a2] = M[o,i] * rt[b,i,a,b2,j,a2] * conj(M)[o2,j]\n    rt = jnp.einsum('\"'oi,bia bja,pj->boa bpa', M, rt, jnp.conj(M), optimize=True)\n    return rt.reshape(dim, dim)\n\n# Fix einsum - spaces invalid\ndef apply_1q_unitary(rho, M, q):\n    b = 2**q\n    a = 2**(n-1-q)\n    rt = rho.reshape(b, 2, a, b, 2, a)\n    # X = M @ rho_block\n    rt2 = jnp.einsum('oi,xiyujv->xoyujv', M, rt)\n    rt3 = jnp.einsum('xoyujv,pj->xoyupv', rt2, jnp.conj(M))\n    return rt3.reshape(dim, dim)\n\ndef apply_1q_channel(rho, Ks, q):\n    b = 2**q\n    a = 2**(n-1-q)\n    rt = rho.reshape(b, 2, a, b, 2, a)\n    # sum_k K rho Kdag\n    # Ks: (3,2,2)\n    rt2 = jnp.einsum('koi,xiyujv->k xoyujv', Ks, rt)\n    rt3 = jnp.einsum('k xoyujv,kpj->xoyupv', rt2, jnp.conj(Ks))\n    return rt3.reshape(dim, dim)\n\ndef apply_2q_unitary(rho, U4, i, j):\n    assert i < j\n    # general two-qubit on i < j\n    b = 2**i\n    m = 2**(j-i-1)\n    a = 2**(n-1-j)\n    # reshape (b,2,m,2,a, b,2,m,2,a)\n    rt = rho.reshape(b,2,m,2,a,b,2,m,2,a)\n    # combine the two qubit indices for left and right\n    rt = rt.transpose(0,2,4,1,3,5,7,9,6,8)  # ?\n    # Better approach: take qubits i,j bits\n\n    # Use: reshape to isolate qubits\n    # left indices: group as (b, qi, m, qj, a)\n    rt = rho.reshape(b, 2, m, 2, a, b, 2, m, 2, a)\n    # map left (qi,qj) with U, right with Udag\n    # U4 acts on (qi,qj) flattened\n    rt2 = jnp.einsum('abcd,xamyb uanvd->xcmyd ucnvd', U4.reshape(2,2,2,2), rt)\n    # wait right part also\n    return None\n\n# Simpler: use bit-permutation to bring qubits to the end\ndef move_qubits_to_end_matrix(qubits):\n    # permutation of basis that moves given qubits to LSB positions\n    # return permutation indices of size dim\n    rest = [q for q in range(n) if q not in qubits]\n    order = rest + list(qubits)  # new qubit order\n    # old index bits: qubit q at bit position n-1-q\n    # new index: for new positions\n    inds = np.arange(dim)\n    # extract bits\n    bits = [(inds >> (n-1-q)) & 1 for q in range(n)]\n    new = np.zeros(dim, dtype=np.int32)\n    for pos, q in enumerate(order):\n        new |= bits[q] << (n-1-pos)\n    return new\n\n# Precompute perms for all needed pairs and singles\nfrom functools import lru_cache\n\ndef perm_to_end(qs):\n    qs = list(qs)\n    rest = [q for q in range(n) if q not in qs]\n    order = rest + qs\n    inds = np.arange(dim)\n    bits = [(inds >> (n-1-q)) & 1 for q in range(n)]\n    new = np.zeros(dim, dtype=np.int32)\n    for pos, q in enumerate(order):\n        new |= bits[q] << (n-1-pos)\n    # We want perm such that rho_new = rho[p][:,p] brings qubits to end\n    # if new_idx = transform(old_idx), then state_new[new] = state_old[old]\n    # inv: old_from_new\n    inv = np.zeros(dim, dtype=np.int32)\n    inv[new] = inds\n    return inv  # rho' = rho[np.ix_(inv,inv)] means ... \n\n# Test speed of gather approach\np = perm_to_end([0,1])\nprint('perm', p[:8])\n\ndef apply_gate_end(rho, G, nq):\n    \\\"\\\"\\\"G acts on last nq qubits, G shape (2\"'^nq, 2''^nq)\"\"\"\n    d = 2**nq\n    m = dim // d\n    rt = rho.reshape(m, d, m, d)\n    # rt'\"' = G rt G\"'^dag\n    rt2 = jnp.einsum('\"'ab,mbnc,dc->madn', G, rt, jnp.conj(G))\n    return rt2.reshape(dim, dim)\n\ndef apply_channel_end(rho, Ks, nq=1):\n    d = 2**nq\n    m = dim // d\n    rt = rho.reshape(m, d, m, d)\n    # Ks (k,d,d)\n    rt2 = jnp.einsum('kab,mbnc,kdc->madn', Ks, rt, jnp.conj(Ks))\n    return rt2.reshape(dim, dim)\n\n# Precompute permutations as jax arrays\npair_perms = {}\nfor i in range(n-1):\n    pair_perms[(i,i+1)] = jnp.array(perm_to_end([i,i+1]))\nsingle_perms = {}\nfor i in range(n):\n    single_perms[i] = jnp.array(perm_to_end([i]))\n\ndef gather_rho(rho, perm):\n    return rho[perm][:, perm]\n\ndef scatter_rho(rho_perm, perm):\n    # inverse of gather: rho[perm][:,perm] = rho_perm\n    inv = jnp.zeros_like(perm)\n    inv = inv.at[perm].set(jnp.arange(dim))\n    return rho_perm[inv][:, inv]\n\ndef apply_2q(rho, U4, i, j):\n    perm = pair_perms[(i,j)]\n    rp = gather_rho(rho, perm)\n    rp = apply_gate_end(rp, U4, 2)\n    return scatter_rho(rp, perm)\n\ndef apply_ch(rho, Ks, i):\n    perm = single_perms[i]\n    rp = gather_rho(rho, perm)\n    rp = apply_channel_end(rp, Ks, 1)\n    return scatter_rho(rp, perm)\n\nrho0 = jnp.zeros((dim,dim), jnp.complex64).at[0,0].set(1)\n\ndef evolve(p01, p10):\n    Ks = kraus_mats(p01, p10)\n    rho = rho0\n    for i in range(0,n-1,2):\n        rho = apply_2q(rho, Um, i, i+1)\n        rho = apply_ch(rho, Ks, i)\n        rho = apply_ch(rho, Ks, i+1)\n    for i in range(1,n-1,2):\n        rho = apply_2q(rho, Um, i, i+1)\n        rho = apply_ch(rho, Ks, i)\n        rho = apply_ch(rho, Ks, i+1)\n    return rho\n\n# warmup numpy-like\nt0=time.time()\nr = evolve(0.034,0.011).block_until_ready()\nprint('eager', time.time()-t0, 'Z0', jnp.diag(r).real @ (1-2*((np.arange(dim)>>(n-1-0))&1)))\n\nfe=jax.jit(evolve)\nt0=time.time(); r=fe(0.034,0.011).block_until_ready(); print('jit1', time.time()-t0)\nt0=time.time(); r=fe(0.034,0.011).block_until_ready(); print('jit2', time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
