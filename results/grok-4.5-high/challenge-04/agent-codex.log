{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\n# Try contractor settings\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nprint('contractors', tc.contractor)\n# try cotengra or greedy\nn=12\nangle=0.31\n\ndef run_once(p01, p10):\n    def make_kraus(p01, p10):\n        K0 = tc.backend.convert_to_tensor(\n            jnp.array([[jnp.sqrt(1-p01)+0j, 0], [0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n        )\n        K1 = tc.backend.convert_to_tensor(\n            jnp.array([[0, jnp.sqrt(p10)], [0, 0]], dtype=jnp.complex64)\n        )\n        K2 = tc.backend.convert_to_tensor(\n            jnp.array([[0, 0], [jnp.sqrt(p01), 0]], dtype=jnp.complex64)\n        )\n        return [K0, K1, K2]\n\n    results = []\n    for kind in range(4):\n        c = tc.DMCircuit(n)\n        if kind == 0:\n            c.h(0)\n            for i in range(n-1):\n                c.cnot(i, i+1)\n        elif kind == 1:\n            for i in range(0, n, 2):\n                c.x(i+1); c.h(i); c.cnot(i, i+1)\n        elif kind == 3:\n            for i in range(n):\n                c.h(i)\n        k = make_kraus(p01, p10)\n        for i in range(0, n-1, 2):\n            c.rxx(i, i+1, theta=angle)\n            c.general_kraus(k, [i])\n            c.general_kraus(k, [i+1])\n        for i in range(1, n-1, 2):\n            c.rxx(i, i+1, theta=angle)\n            c.general_kraus(k, [i])\n            c.general_kraus(k, [i+1])\n        # get density matrix once then compute expectations\n        rho = c.state()\n        # reshape?\n        results.append(rho)\n    return results\n\nt0=time.time()\nrhos = run_once(0.034, 0.011)\nprint('time dm', time.time()-t0)\nprint(type(rhos[0]), getattr(rhos[0],'shape',None), np.asarray(rhos[0]).shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
