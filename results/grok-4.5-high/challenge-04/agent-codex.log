{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend('numpy')\ntc.set_dtype('complex128')\n\nn = 12\ndim = 2 ** n\nangle = 0.31\nU = np.asarray(tc.gates.rxx(theta=angle).tensor, dtype=np.complex128).reshape(4, 4)\n\ndef kraus(p01, p10):\n    K0 = np.array([[np.sqrt(1-p01), 0], [0, np.sqrt(1-p10)]], dtype=np.complex128)\n    K1 = np.array([[0, np.sqrt(p10)], [0, 0]], dtype=np.complex128)\n    K2 = np.array([[0, 0], [np.sqrt(p01), 0]], dtype=np.complex128)\n    return [K0, K1, K2]\n\ndef apply_gate_local(rho, G, qs):\n    \\\"\\\"\\\"Apply G (d,d) on qubits qs (tuple ascending) as G rho G\"'^dag.\"\"\"\n    qs = list(qs)\n    nq = len(qs)\n    d = 2 ** nq\n    # permutation: move qs to the end\n    rest = [q for q in range(n) if q not in qs]\n    order = rest + qs\n    # compute index perm\n    # old bit pos of qubit q is n-1-q\n    # after reorder, new state[new_idx] corresponds...\n    # We'\"'ll build perm of basis states\n    powers = np.array([1 << (n - 1 - q) for q in range(n)], dtype=np.int64)\n    # For each old index, new index\n    # Actually use reshape method without full perm of 4096\"'^2 by iterative swaps - for speed use:\n    # reshape isolating qubits one by one to end via swaps\n\n    # Direct approach with strides\n    rho_t = rho.reshape([2]*n + [2]*n)\n    # transpose ket and bra axes\n    ket_order = rest + qs\n    bra_order = [n + q for q in rest + qs]\n    axes = ket_order + bra_order\n    rho_t = rho_t.transpose(axes)\n    m = 2 ** (n - nq)\n    rho_t = rho_t.reshape(m, d, m, d)\n    # G rho G''^dag\n    # out[a,i,b,j] = sum G[i,k] rho[a,k,b,l] conj(G[j,l])\n    tmp = np.matmul(G, rho_t)  # (d,d) @ (m,d,m,d) need careful\n    # reshape to (m, d, m*d)\n    rt = rho_t.reshape(m, d, m * d)\n    rt = G @ rt  # (d,d)@(m,d,m*d) broadcast? no\n    # better loop-free:\n    rt = np.einsum('\"'ik,akbc->aibc', G, rho_t, optimize=True)\n    rt = np.einsum('aibl,jl->aibj', rt, np.conj(G), optimize=True)\n    # inverse transpose\n    rt = rt.reshape([2]*(n-nq) + [2]*nq + [2]*(n-nq) + [2]*nq)\n    # inverse axes\n    inv = np.argsort(axes)\n    rt = rt.transpose(inv)\n    return rt.reshape(dim, dim)\n\ndef init_rho(kind):\n    psi = np.zeros(dim, dtype=np.complex128)\n    if kind == 0:\n        psi[0] = 1/np.sqrt(2); psi[-1] = 1/np.sqrt(2)\n    elif kind == 1:\n        psi = np.array([1.0], dtype=np.complex128)\n        s = 1/np.sqrt(2)\n        for _ in range(n//2):\n            a = np.zeros(psi.size * 4, dtype=np.complex128)\n            a[1::4] = psi * s\n            a[2::4] = psi * s\n            psi = a\n    elif kind == 2:\n        psi[0] = 1.0\n    else:\n        psi[:] = 1/np.sqrt(dim)\n    return np.outer(psi, psi.conj())\n\ndef apply_channel_local(rho, Ks, q):\n    out = np.zeros_like(rho)\n    for K in Ks:\n        out += apply_gate_local(rho, K, [q])\n    return out\n\ndef expects(rho):\n    diag = np.real(np.diag(rho))\n    outs = []\n    idx = np.arange(dim)\n    for q in range(n):\n        signs = 1 - 2 * ((idx >> (n - 1 - q)) & 1)\n        outs.append(diag @ signs)\n    parity = np.zeros(dim, np.int64)\n    x = idx.copy()\n    for _ in range(n):\n        parity \"'^= x & 1\n        x >>= 1\n    outs.append(diag @ (1 - 2 * parity))\n    return np.asarray(outs, dtype=np.float64)\n\ndef evolve(kind, p01, p10):\n    rho = init_rho(kind)\n    Ks = kraus(p01, p10)\n    for i in range(0, n-1, 2):\n        rho = apply_gate_local(rho, U, [i, i+1])\n        rho = apply_channel_local(rho, Ks, i)\n        rho = apply_channel_local(rho, Ks, i+1)\n    for i in range(1, n-1, 2):\n        rho = apply_gate_local(rho, U, [i, i+1])\n        rho = apply_channel_local(rho, Ks, i)\n        rho = apply_channel_local(rho, Ks, i+1)\n    return expects(rho)\n\ndef ref(kind, p01, p10):\n    c = tc.DMCircuit(n)\n    if kind == 0:\n        c.h(0)\n        for i in range(n-1):\n            c.cnot(i, i+1)\n    elif kind == 1:\n        for i in range(0, n, 2):\n            c.x(i+1); c.h(i); c.cnot(i, i+1)\n    elif kind == 3:\n        for i in range(n):\n            c.h(i)\n    Ks = kraus(p01, p10)\n    for i in range(0, n-1, 2):\n        c.rxx(i, i+1, theta=angle)\n        c.apply_general_kraus(Ks, i)\n        c.apply_general_kraus(Ks, i+1)\n    for i in range(1, n-1, 2):\n        c.rxx(i, i+1, theta=angle)\n        c.apply_general_kraus(Ks, i)\n        c.apply_general_kraus(Ks, i+1)\n    return expects(np.array(c.state(), dtype=np.complex128))\n\nfor kind in range(4):\n    t0 = time.time()\n    v = evolve(kind, 0.034, 0.011)\n    print('\"'kind', kind, 'time', time.time()-t0, 'diff', np.max(np.abs(v - ref(kind, 0.034, 0.011))))\n    print(v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
