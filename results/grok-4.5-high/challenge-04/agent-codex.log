{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python -c \\\"\nimport tensorcircuit as tc\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\np01, p10 = 0.034, 0.011\n\ndef kraus_ops(p01, p10):\n    import jax.numpy as jnp\n    K0 = jnp.array([[jnp.sqrt(1-p01), 0], [0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)], [0, 0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0, 0], [jnp.sqrt(p01), 0]], dtype=jnp.complex64)\n    return [K0, K1, K2]\n\nt0 = time.time()\nc = tc.DMCircuit(n)\n# GHZ-ish - just start from 0\nangle = 0.31\nfor i in range(0, n-1, 2):\n    c.rxx(i, i+1, theta=angle)\n    k = kraus_ops(p01, p10)\n    c.apply_general_kraus(k, i)\n    c.apply_general_kraus(k, i+1)\nfor i in range(1, n-1, 2):\n    c.rxx(i, i+1, theta=angle)\n    k = kraus_ops(p01, p10)\n    c.apply_general_kraus(k, i)\n    c.apply_general_kraus(k, i+1)\n# expectations\nzs = []\nfor i in range(n):\n    zs.append(c.expectation((tc.gates.z(), [i])))\n# full parity\nops = tuple((tc.gates.z(), [i]) for i in range(n))\nzs.append(c.expectation(*ops))\nprint('time', time.time()-t0)\nprint([float(np.real(z)) for z in zs])\n\\\"\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
