{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nfrom collections import defaultdict\nimport time\n\ntc.set_backend('numpy')\nn=12\nangle=0.31\nP1=[np.eye(2,dtype=np.complex128),\n    np.array([[0,1],[1,0]],np.complex128),\n    np.array([[0,-1j],[1j,0]],np.complex128),\n    np.array([[1,0],[0,-1]],np.complex128)]\n\ndef channel_dual_ptm(p01,p10):\n    Ks=[\n        np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n        np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n        np.array([[0,0],[np.sqrt(p01),0]],np.complex128),\n    ]\n    R=np.zeros((4,4),float)\n    for b in range(4):\n        Op=sum(K.conj().T@P1[b]@K for K in Ks)\n        for a in range(4):\n            R[a,b]=np.real(np.trace(P1[a]@Op)/2)\n    return R\n\ndef rxx_dual_ptm():\n    U=np.asarray(tc.gates.rxx(theta=angle).tensor,np.complex128).reshape(4,4)\n    P2=[np.kron(P1[i],P1[j]) for i in range(4) for j in range(4)]\n    R=np.zeros((16,16),float)\n    for b,Pb in enumerate(P2):\n        Op=U.conj().T@Pb@U\n        for a,Pa in enumerate(P2):\n            R[a,b]=np.real(np.trace(Pa@Op)/4)\n    return R\n\nR2=rxx_dual_ptm()\n# Precompute nonzero maps for speed\nmap1 = []\nfor b in range(4):\n    map1.append([])  # filled per R\nmap2 = []\nfor b in range(16):\n    nz = [(a, R2[a,b]) for a in range(16) if abs(R2[a,b])>1e-14]\n    map2.append(nz)\n\ndef apply_1q_fast(keys, vals, q, R):\n    new = defaultdict(float)\n    for s,c in zip(keys, vals):\n        b = (s >> (2*q)) & 3  # encode pauli in base-4 int\n        for a in range(4):\n            v=R[a,b]\n            if v==0: continue\n            ns = s \"'^ (b<<(2*q)) ''^ (a<<(2*q))\n            new[ns] += c*v\n    keys2=np.fromiter(new.keys(),dtype=np.int64,count=len(new))\n    vals2=np.fromiter(new.values(),dtype=np.float64,count=len(new))\n    # prune\n    m=np.abs(vals2)>1e-14\n    return keys2[m], vals2[m]\n\ndef apply_2q_fast(keys, vals, q1, q2):\n    new=defaultdict(float)\n    shift1=2*q1; shift2=2*q2\n    for s,c in zip(keys,vals):\n        b1=(s>>shift1)&3; b2=(s>>shift2)&3\n        bin=4*b1+b2\n        for aout,val in map2[bin]:\n            a1,a2=divmod(aout,4)\n            ns=s\n            ns = ns ''^ (b1<<shift1) ''^ (a1<<shift1)\n            ns = ns ''^ (b2<<shift2) ''^ (a2<<shift2)\n            new[ns] += c*val\n    keys2=np.fromiter(new.keys(),dtype=np.int64,count=len(new))\n    vals2=np.fromiter(new.values(),dtype=np.float64,count=len(new))\n    m=np.abs(vals2)>1e-14\n    return keys2[m], vals2[m]\n\ndef encode(pauli_list):\n    s=0\n    for q,p in enumerate(pauli_list):\n        s |= (p<<(2*q))\n    return s\n\ndef evolve_op(pauli_list, R1):\n    keys=np.array([encode(pauli_list)],dtype=np.int64)\n    vals=np.array([1.0],dtype=np.float64)\n    ops=[]\n    for i in range(0,n-1,2):\n        ops += [('\"'rxx',i),('ch',i),('ch',i+1)]\n    for i in range(1,n-1,2):\n        ops += [('rxx',i),('ch',i),('ch',i+1)]\n    for typ,arg in reversed(ops):\n        if typ=='rxx':\n            keys,vals=apply_2q_fast(keys,vals,arg,arg+1)\n        else:\n            keys,vals=apply_1q_fast(keys,vals,arg,R1)\n    return keys,vals\n\n# expectations helpers\ndef exp_kind(keys, vals, kind):\n    if kind==2: # |0>\n        # only I/Z strings, all +1\n        tot=0.0\n        for s,c in zip(keys,vals):\n            ok=True\n            for q in range(n):\n                p=(s>>(2*q))&3\n                if p==1 or p==2:\n                    ok=False; break\n            if ok: tot+=c\n        return tot\n    if kind==3: # |+>\n        tot=0.0\n        for s,c in zip(keys,vals):\n            ok=True\n            for q in range(n):\n                p=(s>>(2*q))&3\n                if p==2 or p==3:\n                    ok=False; break\n            if ok: tot+=c\n        return tot\n    if kind==0: # GHZ\n        # use two-amplitude method\n        tot=0.0\n        full1=(1<<n)-1\n        for s,c in zip(keys,vals):\n            # apply P on |0> and |1..1>\n            for b in (0, full1):\n                phase=1+0j\n                out=b\n                ok_amp=True\n                for q in range(n):\n                    p=(s>>(2*q))&3\n                    bit=(b>>(n-1-q))&1\n                    if p==1:\n                        out \"'^= 1<<(n-1-q)\n                    elif p==2:\n                        phase *= (1j if bit==0 else -1j)\n                        out ''^= 1<<(n-1-q)\n                    elif p==3:\n                        phase *= (1 if bit==0 else -1)\n                if out in (0,full1):\n                    tot += c * (0.5) * np.real(phase)  # phase should make real overall\n                    # careful: total is real\n        return tot\n    if kind==1:\n        # product of bells\n        psi=np.zeros(4,np.complex128); psi[1]=psi[2]=1/np.sqrt(2)\n        rho2=np.outer(psi,psi.conj())\n        E2=np.zeros((4,4),float)\n        for i in range(4):\n            for j in range(4):\n                E2[i,j]=np.real(np.trace(rho2@np.kron(P1[i],P1[j])))\n        tot=0.0\n        for s,c in zip(keys,vals):\n            val=1.0\n            for pair in range(n//2):\n                q1=2*pair; q2=2*pair+1\n                p1=(s>>(2*q1))&3; p2=(s>>(2*q2))&3\n                val *= E2[p1,p2]\n            tot += c*val\n        return tot\n\ndef full_table(p01,p10):\n    R1=channel_dual_ptm(p01,p10)\n    # precompute evolved ops for 13 observables\n    ops=[]\n    for q in range(n):\n        pl=[0]*n; pl[q]=3\n        ops.append(evolve_op(pl,R1))\n    ops.append(evolve_op([3]*n,R1))\n    rows=np.zeros((4,13),float)\n    for kind in range(4):\n        for j,(k,v) in enumerate(ops):\n            rows[kind,j]=exp_kind(k,v,kind)\n    return rows\n\nt0=time.time(); tab=full_table(0.034,0.011); print('\"'time',time.time()-t0)\nprint(tab)\n\n# ref\ndef ref():\n    rows=[]\n    for kind in range(4):\n        c=tc.DMCircuit(n)\n        if kind==0:\n            c.h(0)\n            for i in range(n-1): c.cnot(i,i+1)\n        elif kind==1:\n            for i in range(0,n,2):\n                c.x(i+1); c.h(i); c.cnot(i,i+1)\n        elif kind==3:\n            for i in range(n): c.h(i)\n        p01,p10=0.034,0.011\n        Ks=[np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n            np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n            np.array([[0,0],[np.sqrt(p01),0]],np.complex128)]\n        for i in range(0,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        for i in range(1,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        outs=[]\n        for i in range(n):\n            outs.append(float(np.real(c.expectation_ps(z=[i]))))\n        outs.append(float(np.real(c.expectation_ps(z=list(range(n))))))\n        rows.append(outs)\n    return np.array(rows)\nrt=ref(); print('diff',np.max(np.abs(tab-rt)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
