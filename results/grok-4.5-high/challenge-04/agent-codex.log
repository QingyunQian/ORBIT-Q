{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\n\ntc.set_backend('numpy')\nn=12\ndim=2**n\nangle=0.31\nU=np.asarray(tc.gates.rxx(theta=angle).tensor,dtype=np.complex128).reshape(4,4)\n\ndef apply_2q_fast(rho, U4, q1, q2):\n    # Move qubits q1,q2 to positions at LSB via bit tricks - use reshape hierarchy\n    # General adjacent only for our circuit: q2=q1+1\n    assert q2 == q1+1\n    left = 2**q1\n    right = 2**(n-q2-1)\n    # rho shape (left, 4, right, left, 4, right)\n    r = rho.reshape(left, 4, right, left, 4, right)\n    # apply U on axis 1, U* on axis 4\n    # r' [a,i,b,c,j,d] = sum_{k,l} U[i,k] r[a,k,b,c,l,d] conj(U[j,l])\n    r = np.tensordot(U4, r, axes=([1],[1]))  # (i, a, b, c, l, d) \n    r = np.moveaxis(r, 0, 1)  # (a,i,b,c,l,d)\n    r = np.tensordot(r, np.conj(U4).T, axes=([4],[0]))  # (a,i,b,c,d,j) where sum_l r[..l..] conj(U).T[l,j]=conj(U)[j,l]\n    # wait conj(U).T[l,j] = conj(U)[j,l] yes\n    r = np.moveaxis(r, -1, 4)  # (a,i,b,c,j,d)\n    return r.reshape(dim,dim)\n\ndef apply_1q_channel_fast(rho, Ks, q):\n    left=2**q; right=2**(n-q-1)\n    r = rho.reshape(left, 2, right, left, 2, right)\n    out = np.zeros_like(r)\n    for K in Ks:\n        t = np.tensordot(K, r, axes=([1],[1])) # (i,a,b,c,l,d)\n        t = np.moveaxis(t, 0, 1) # a i b c l d\n        t = np.tensordot(t, np.conj(K).T, axes=([4],[0])) # a i b c d j\n        t = np.moveaxis(t, -1, 4)\n        out += t\n    return out.reshape(dim,dim)\n\ndef kraus(p01,p10):\n    return [\n        np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n        np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n        np.array([[0,0],[np.sqrt(p01),0]],np.complex128),\n    ]\n\ndef init_rho(kind):\n    psi=np.zeros(dim,np.complex128)\n    if kind==0:\n        psi[0]=psi[-1]=1/np.sqrt(2)\n    elif kind==1:\n        psi=np.array([1.0],np.complex128)\n        s=1/np.sqrt(2)\n        for _ in range(n//2):\n            a=np.zeros(psi.size*4,np.complex128); a[1::4]=psi*s; a[2::4]=psi*s; psi=a\n    elif kind==2:\n        psi[0]=1\n    else:\n        psi[:]=1/np.sqrt(dim)\n    return np.outer(psi,psi.conj())\n\ndef expects(rho):\n    diag=np.real(np.diag(rho)); idx=np.arange(dim); outs=[]\n    for q in range(n):\n        outs.append(diag @ (1-2*((idx>>(n-1-q))&1)))\n    parity=np.zeros(dim,np.int64); x=idx.copy()\n    for _ in range(n):\n        parity \"'^= x&1; x >>=1\n    outs.append(diag @ (1-2*parity))\n    return np.array(outs,float)\n\ndef evolve(kind,p01,p10):\n    rho=init_rho(kind); Ks=kraus(p01,p10)\n    for i in range(0,n-1,2):\n        rho=apply_2q_fast(rho,U,i,i+1)\n        rho=apply_1q_channel_fast(rho,Ks,i)\n        rho=apply_1q_channel_fast(rho,Ks,i+1)\n    for i in range(1,n-1,2):\n        rho=apply_2q_fast(rho,U,i,i+1)\n        rho=apply_1q_channel_fast(rho,Ks,i)\n        rho=apply_1q_channel_fast(rho,Ks,i+1)\n    return expects(rho)\n\ndef ref(kind,p01,p10):\n    c=tc.DMCircuit(n)\n    if kind==0:\n        c.h(0)\n        for i in range(n-1): c.cnot(i,i+1)\n    elif kind==1:\n        for i in range(0,n,2):\n            c.x(i+1); c.h(i); c.cnot(i,i+1)\n    elif kind==3:\n        for i in range(n): c.h(i)\n    Ks=kraus(p01,p10)\n    for i in range(0,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n    for i in range(1,n-1,2):\n        c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n    return expects(np.array(c.state(),np.complex128))\n\nfor kind in range(4):\n    t0=time.time(); v=evolve(kind,0.034,0.011); dt=time.time()-t0\n    r=ref(kind,0.034,0.011)\n    print(kind,'\"'time',dt,'diff',np.max(np.abs(v-r)))\nt0=time.time(); np.stack([evolve(k,0.07,0.04) for k in range(4)]); print('table',time.time()-t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
