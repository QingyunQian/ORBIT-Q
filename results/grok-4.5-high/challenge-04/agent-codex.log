{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport time\nimport numpy as np\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn=12\nangle=0.31\np01, p10 = 0.034, 0.011\n\ndef make_kraus(p01, p10):\n    K0 = jnp.array([[jnp.sqrt(1-p01), 0], [0, jnp.sqrt(1-p10)]], dtype=jnp.complex64)\n    K1 = jnp.array([[0, jnp.sqrt(p10)], [0, 0]], dtype=jnp.complex64)\n    K2 = jnp.array([[0, 0], [jnp.sqrt(p01), 0]], dtype=jnp.complex64)\n    return [K0, K1, K2]\n\ndef one_circuit(kind, p01, p10):\n    c = tc.DMCircuit(n)\n    if kind == 0:\n        c.h(0)\n        for i in range(n-1):\n            c.cnot(i, i+1)\n    elif kind == 1:\n        for i in range(0, n, 2):\n            c.x(i+1); c.h(i); c.cnot(i, i+1)\n    elif kind == 3:\n        for i in range(n):\n            c.h(i)\n    k = make_kraus(p01, p10)\n    for i in range(0, n-1, 2):\n        c.rxx(i, i+1, theta=angle)\n        c.apply_general_kraus(k, i)\n        c.apply_general_kraus(k, i+1)\n    for i in range(1, n-1, 2):\n        c.rxx(i, i+1, theta=angle)\n        c.apply_general_kraus(k, i)\n        c.apply_general_kraus(k, i+1)\n    rho = c.state()\n    return rho\n\nt0=time.time()\nrho = one_circuit(2, p01, p10)\nprint('time', time.time()-t0, np.asarray(rho).shape, np.asarray(rho).dtype)\n\n# try numpy backend\ntc.set_backend('numpy')\nt0=time.time()\nrho = one_circuit(2, p01, p10)\nprint('numpy time', time.time()-t0, np.asarray(rho).shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
