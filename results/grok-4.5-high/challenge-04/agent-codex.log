urn r.reshape(dim,dim)\n\nrho=np.zeros((dim,dim),np.complex128); rho[0,0]=1\nt0=time.time()\nfor i in range(0,n-1,2):\n    rho=apply_U_adj2(rho,i)\nprint('6 U matmul', time.time()-t0, 'trace', np.trace(rho).real)\n\n# compare correctness vs DMCircuit single rxx layer\nc=tc.DMCircuit(n)\nfor i in range(0,n-1,2):\n    c.rxx(i,i+1,theta=angle)\nrho_ref=np.array(c.state(),dtype=np.complex128)\nprint('diff', np.max(np.abs(rho-rho_ref)))\nPY\"","aggregated_output":"6 U 1.3051059246063232\n6 U matmul 0.9339556694030762 trace 1.0000000948977696\ndiff 4.850559087721251e-08\n","exit_code":0,"status":"completed"}}
