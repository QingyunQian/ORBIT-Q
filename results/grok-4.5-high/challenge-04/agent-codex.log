{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nimport time\nfrom collections import defaultdict\n\ntc.set_backend('numpy')\nn = 12\nangle = 0.31\n\n# Pauli matrices\nI = np.eye(2, dtype=np.complex128)\nX = np.array([[0,1],[1,0]], dtype=np.complex128)\nY = np.array([[0,-1j],[1j,0]], dtype=np.complex128)\nZ = np.array([[1,0],[0,-1]], dtype=np.complex128)\nP1 = [I,X,Y,Z]\n\n# Multiplication table for Paulis: s1*s2 = phase * s_out\n# phase in units of i\"'^k: store complex\ndef pauli_mul_table():\n    # returns (out, phase) for a,b in 0..3\n    tab = [[None]*4 for _ in range(4)]\n    names = [I,X,Y,Z]\n    for a in range(4):\n        for b in range(4):\n            prod = names[a] @ names[b]\n            # match to phase * paul\n            found=False\n            for c in range(4):\n                for ph in [1, -1, 1j, -1j]:\n                    if np.allclose(prod, ph*names[c]):\n                        tab[a][b] = (c, ph)\n                        found=True\n                        break\n                if found: break\n            assert found\n    return tab\nMUL = pauli_mul_table()\n\ndef mul_strings(s1, ph1, s2, ph2):\n    # s are tuples length n\n    ph = ph1*ph2\n    out = []\n    for a,b in zip(s1,s2):\n        c, p = MUL[a][b]\n        out.append(c)\n        ph *= p\n    return tuple(out), ph\n\n# Build 1q dual channel PTM: ε*(P_b) = sum_a R[a,b] P_a\n# Actually map coeffs: if O = sum c_b P_b, ε*(O)= sum c_b ε*(P_b)\n\ndef channel_dual_ptm(p01, p10):\n    Ks = [\n        np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n        np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n        np.array([[0,0],[np.sqrt(p01),0]],np.complex128),\n    ]\n    # ε*(O) = sum K''^dag O K\n    # PTM R such that coeffs_out = R @ coeffs_in in basis I,X,Y,Z with Bloch scaling?\n    # Use Hilbert-Schmidt: c_a = Tr(P_a O)/2\n    R = np.zeros((4,4), dtype=np.complex128)\n    for bin in range(4):\n        O = P1[bin]\n        Op = sum(K.conj().T @ O @ K for K in Ks)\n        for aout in range(4):\n            R[aout, bin] = np.trace(P1[aout] @ Op)/2\n    return np.real_if_close(R)\n\ndef rxx_dual_ptm():\n    U = np.asarray(tc.gates.rxx(theta=angle).tensor, dtype=np.complex128).reshape(4,4)\n    # 2q Paulis\n    P2 = []\n    labels=[]\n    for i in range(4):\n        for j in range(4):\n            P2.append(np.kron(P1[i], P1[j]))\n            labels.append((i,j))\n    R = np.zeros((16,16), dtype=np.complex128)\n    for bin, Pb in enumerate(P2):\n        Op = U.conj().T @ Pb @ U  # U† O U\n        for aout, Pa in enumerate(P2):\n            R[aout, bin] = np.trace(Pa @ Op)/4\n    return np.real_if_close(R), labels\n\nR2, labels = rxx_dual_ptm()\nprint('\"'R2 max imag', np.max(np.abs(np.imag(R2))))\nR2 = np.real(R2)\n\n# Sparse operator as dict: pauli_tuple -> complex coeff\n# where pauli_tuple[q] in 0..3\n\ndef apply_1q_dual(op, q, R):\n    new = defaultdict(complex)\n    for s, c in op.items():\n        b = s[q]\n        # map basis vector e_b through R: out_a = R[a,b]*c\n        for a in range(4):\n            if abs(R[a,b]) < 1e-14:\n                continue\n            ns = list(s)\n            ns[q] = a\n            new[tuple(ns)] += c * R[a,b]\n    # prune\n    return {k:v for k,v in new.items() if abs(v)>1e-14}\n\ndef apply_2q_dual(op, q1, q2, R):\n    new = defaultdict(complex)\n    for s, c in op.items():\n        b1, b2 = s[q1], s[q2]\n        bin = 4*b1 + b2\n        col = R[:, bin]\n        for aout, val in enumerate(col):\n            if abs(val) < 1e-14:\n                continue\n            a1, a2 = divmod(aout, 4)\n            ns = list(s)\n            ns[q1] = a1\n            ns[q2] = a2\n            new[tuple(ns)] += c * val\n    return {k:v for k,v in new.items() if abs(v)>1e-14}\n\ndef expect_on_state(op, kind):\n    # Compute <psi| O |psi> for our four states\n    # O = sum c_s P_s\n    if kind == 2:  # |0...0>\n        # <P_s> = 1 if only I and Z, else 0; Z contributes +1 on |0>\n        tot = 0j\n        for s,c in op.items():\n            if all(p in (0,3) for p in s):\n                tot += c  # all Z and I give +1\n        return np.real(tot)\n    if kind == 3:  # |+>\"'^n\n        # <+|X|+>=1, <+|I|+>=1, Y,Z =0\n        tot = 0j\n        for s,c in op.items():\n            if all(p in (0,1) for p in s):\n                tot += c\n        return np.real(tot)\n    if kind == 0:  # GHZ\n        # GHZ = (|0..0>+|1..1>)/sqrt2\n        # <X...X> =1, <Y...Y> with phases, Z products: even number of Z -> 1 if no X/Y, etc.\n        # General: use stabilizer or direct 2-amp\n        # <P> = 1/2 * ( <0|P|0> + <1|P|1> + <0|P|1> + <1|P|0> )\n        tot = 0j\n        full1 = (1<<n) - 1\n        for s,c in op.items():\n            # matrix element between computational basis\n            # P |b> = phase |b'\"'> \n            # For each basis bitstring b in {0, all1}:\n            def apply_pauli_on_bit(s, b):\n                phase = 1+0j\n                out = b\n                for q,p in enumerate(s):\n                    bit = (b >> (n-1-q)) & 1\n                    if p == 0:\n                        continue\n                    elif p == 1: # X flips\n                        out \"'^= (1 << (n-1-q))\n                    elif p == 2: # Y: i*Z*X -> phase i*(1-2bit) and flip\n                        phase *= (1j if bit==0 else -1j)  # Y|0>=i|1>, Y|1>=-i|0>\n                        out ''^= (1 << (n-1-q))\n                    elif p == 3: # Z\n                        phase *= (1 if bit==0 else -1)\n                return out, phase\n            # contributions\n            for b in [0, full1]:\n                out, phase = apply_pauli_on_bit(s, b)\n                # <psi| out><b| /2 * c * phase with <psi|out> = 1/sqrt2 if out in {0,full1}\n                if out in (0, full1):\n                    tot += c * phase * 0.5\n        return np.real(tot)\n    if kind == 1:  # product of Bell (|01>+|10>)/sqrt2 on pairs\n        # state is product of 2-qubit states\n        # For a Pauli string, expectation factors over pairs if we group\n        tot_c = 1+0j\n        # For each pair, compute local expectation of the 2q pauli\n        # Build 2q density matrix of Bell psi+ = (|01>+|10>)/sqrt2\n        # Actually (|01>+|10>)/sqrt2 is Y-basis bell? \n        # rho = |psi><psi|\n        psi = np.zeros(4, dtype=np.complex128)\n        psi[1] = psi[2] = 1/np.sqrt(2)\n        rho2 = np.outer(psi, psi.conj())\n        # For whole state product, <P> = prod_pairs Tr(rho2 * P_pair) if no... yes for product state and Paulis factor.\n        acc = 1+0j\n        for pair in range(n//2):\n            q1, q2 = 2*pair, 2*pair+1\n            # extract coeffs for this pair from full op - WAIT op is sum of many strings; cannot factor one op that is sum.\n            # Need to evaluate each Pauli string'\"'s expectation as product over pairs.\n        tot = 0j\n        for s,c in op.items():\n            val = 1+0j\n            ok=True\n            for pair in range(n//2):\n                q1,q2=2*pair,2*pair+1\n                pmat = np.kron(P1[s[q1]], P1[s[q2]])\n                e = np.trace(rho2 @ pmat)\n                val *= e\n            tot += c*val\n        return np.real(tot)\n\ndef heisenberg_obs(obs_pauli, p01, p10):\n    # obs_pauli: tuple length n\n    R1 = channel_dual_ptm(p01, p10)\n    op = {obs_pauli: 1.0+0j}\n    # Circuit forward: even RXX+noise, odd RXX+noise\n    # Heisenberg backward: reverse order duals\n    # Forward ops list:\n    ops = []\n    for i in range(0,n-1,2):\n        ops.append(('rxx', i, i+1))\n        ops.append(('ch', i))\n        ops.append(('ch', i+1))\n    for i in range(1,n-1,2):\n        ops.append(('rxx', i, i+1))\n        ops.append(('ch', i))\n        ops.append(('ch', i+1))\n    for typ,*arg in reversed(ops):\n        if typ=='rxx':\n            op = apply_2q_dual(op, arg[0], arg[1], R2)\n        else:\n            op = apply_1q_dual(op, arg[0], R1)\n    return op\n\ndef table(p01,p10):\n    # 13 observables\n    rows=[]\n    for kind in range(4):\n        outs=[]\n        for q in range(n):\n            s = [0]*n; s[q]=3\n            op = heisenberg_obs(tuple(s), p01, p10)\n            outs.append(expect_on_state(op, kind))\n        s = [3]*n\n        op = heisenberg_obs(tuple(s), p01, p10)\n        outs.append(expect_on_state(op, kind))\n        rows.append(outs)\n    return np.array(rows,float)\n\n# reference\ndef ref_table(p01,p10):\n    def kraus():\n        return [\n            np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],np.complex128),\n            np.array([[0,np.sqrt(p10)],[0,0]],np.complex128),\n            np.array([[0,0],[np.sqrt(p01),0]],np.complex128),\n        ]\n    rows=[]\n    for kind in range(4):\n        c=tc.DMCircuit(n)\n        if kind==0:\n            c.h(0)\n            for i in range(n-1): c.cnot(i,i+1)\n        elif kind==1:\n            for i in range(0,n,2):\n                c.x(i+1); c.h(i); c.cnot(i,i+1)\n        elif kind==3:\n            for i in range(n): c.h(i)\n        Ks=kraus()\n        for i in range(0,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        for i in range(1,n-1,2):\n            c.rxx(i,i+1,theta=angle); c.apply_general_kraus(Ks,i); c.apply_general_kraus(Ks,i+1)\n        outs=[]\n        rho=np.array(c.state(),np.complex128)\n        diag=np.real(np.diag(rho)); idx=np.arange(dim:=2**n)\n        for q in range(n):\n            outs.append(diag @ (1-2*((idx>>(n-1-q))&1)))\n        parity=np.zeros(dim,np.int64); x=idx.copy()\n        for _ in range(n):\n            parity \"'^= x&1; x>>=1\n        outs.append(diag @ (1-2*parity))\n        rows.append(outs)\n    return np.array(rows,float)\n\nt0=time.time(); tab=table(0.034,0.011); print('\"'heisenberg time', time.time()-t0)\nt0=time.time(); rtab=ref_table(0.034,0.011); print('ref time', time.time()-t0)\nprint('diff', np.max(np.abs(tab-rtab)))\nprint(tab)\nprint(rtab)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
