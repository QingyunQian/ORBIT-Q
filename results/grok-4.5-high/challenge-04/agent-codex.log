{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nimport time\n\ntc.set_backend('numpy')\nn=12\ndim=1<<n\nangle=0.31\nU=np.ascontiguousarray(np.asarray(tc.gates.rxx(theta=angle).tensor,dtype=np.complex128).reshape(4,4))\n\ndef apply_U_adj(rho, q1):\n    left=1<<q1\n    right=1<<(n-q1-2)\n    # reshape (left,4,right,left,4,right)\n    r = rho.reshape(left,4,right,left,4,right)\n    # left apply U: new[a,i,b,...] = sum_k U[i,k] r[a,k,b,...]\n    r = np.einsum('ik,akbcld->aibcld', U, r, optimize=True)\n    # right apply Udag: new[...,c,j,d] = sum_l r[...,c,l,d] conj(U[j,l])\n    r = np.einsum('aibcld,jl->aibcjd', r, np.conj(U), optimize=True)\n    return r.reshape(dim,dim)\n\ndef apply_K_channel(rho, Ks, q):\n    left=1<<q; right=1<<(n-q-1)\n    r = rho.reshape(left,2,right,left,2,right)\n    acc = np.zeros_like(r)\n    for K in Ks:\n        t = np.einsum('ik,akbcld->aibcld', K, r, optimize=True)\n        t = np.einsum('aibcld,jl->aibcjd', t, np.conj(K), optimize=True)\n        acc += t\n    return acc.reshape(dim,dim)\n\n# optimize einsum path once\nrho=np.zeros((dim,dim),np.complex128); rho[0,0]=1\nt0=time.time()\nfor i in range(0,n-1,2):\n    rho=apply_U_adj(rho,i)\nprint('6 U', time.time()-t0)\n\n# Try better matmul based\ndef apply_U_adj2(rho, q1):\n    left=1<<q1; right=1<<(n-q1-2)\n    r=rho.reshape(left,4,right*left*4*right)\n    # U @ r along axis1\n    r=(U @ r.reshape(left,4,-1).transpose(1,0,2).reshape(4,-1)).reshape(4,left,-1).transpose(1,0,2)\n    r=r.reshape(left,4,right,left,4,right)\n    # right: r last 4 with Udag\n    r=r.reshape(left*4*right*left,4,right)\n    # out[j] = sum_l r[l] conj(U[j,l]) = (U.conj() @ r_as (4,...)) \n    tmp = r.transpose(1,0,2).reshape(4,-1)  # l, ...\n    tmp2 = np.conj(U) @ tmp  # j, ...\n    r = tmp2.reshape(4, left*4*right*left, right).transpose(1,0,2)\n    r = r.reshape(left,4,right,left,4,right)\n    return r.reshape(dim,dim)\n\nrho=np.zeros((dim,dim),np.complex128); rho[0,0]=1\nt0=time.time()\nfor i in range(0,n-1,2):\n    rho=apply_U_adj2(rho,i)\nprint('6 U matmul', time.time()-t0, 'trace', np.trace(rho).real)\n\n# compare correctness vs DMCircuit single rxx layer\nc=tc.DMCircuit(n)\nfor i in range(0,n-1,2):\n    c.rxx(i,i+1,theta=angle)\nrho_ref=np.array(c.state(),dtype=np.complex128)\nprint('diff', np.max(np.abs(rho-rho_ref)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
