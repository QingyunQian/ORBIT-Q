s[0]), float(objs[-1]))\nt0 = time.time()\nobjs = optimize_one(theta0)\nobjs.block_until_ready()\nprint(\\\"scan run\\\", time.time()-t0)\n\n# 10 restarts\nt0 = time.time()\nhist = []\nfor r in range(10):\n    hist.append(optimize_one(theta0 + 0.001*r))\njax.block_until_ready(hist)\nprint(\\\"10 restarts\\\", time.time()-t0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
