{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport numpy as np\nimport tensorcircuit as tc\nimport time\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex128\\\")\n\n# Quick test: 18 qubit circuit with ~74 gates, expectation, grad, adam\nimport jax\nimport jax.numpy as jnp\n\nn = 18\nparams = jnp.array(np.random.randn(74) * 0.02)\n\ndef make_obj():\n    def obj(theta):\n        c = tc.Circuit(n)\n        # apply some gates\n        for i in range(n):\n            c.rx(i, theta=theta[i % len(theta)])\n        for i in range(0, n-1, 2):\n            c.rzz(i, i+1, theta=theta[(i+n) % len(theta)])\n        # more layers\n        for layer in range(5):\n            for i in range(n):\n                c.ry(i, theta=theta[(layer*n+i) % len(theta)])\n            for i in range(0, n-1, 2):\n                c.rxx(i, i+1, theta=theta[(layer*n+i+3) % len(theta)])\n        e = c.expectation_ps(x=[0], z=[2])\n        return jnp.real(e)\n    return obj\n\nobj = make_obj()\ngrad_fn = jax.jit(jax.value_and_grad(obj))\n# warmup\nv, g = grad_fn(params)\nprint(\\\"val\\\", v, \\\"grad shape\\\", g.shape)\n\nt0 = time.time()\nfor _ in range(100):\n    v, g = grad_fn(params)\n    params = params - 0.03 * g\nprint(\\\"100 steps\\\", time.time()-t0, \\\"final\\\", v)\n\n# Test with scan over restarts\nprint(\\\"jax devices\\\", jax.devices())\nprint(tc.about())\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
