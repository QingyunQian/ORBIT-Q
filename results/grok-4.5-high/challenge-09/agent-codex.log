{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\ndef ladder_edges(n_qubits):\n    assert n_qubits % 2 == 0\n    n_columns = n_qubits // 2\n    edges = []\n    for column in range(n_columns):\n        edges.append((2 * column, 2 * column + 1))\n        if column + 1 < n_columns:\n            edges.append((2 * column, 2 * (column + 1)))\n            edges.append((2 * column + 1, 2 * (column + 1) + 1))\n            if column % 2 == 0:\n                edges.append((2 * column, 2 * (column + 1) + 1))\n            else:\n                edges.append((2 * column + 1, 2 * (column + 1)))\n    return edges\n\ndef generate_gate_tape(config):\n    rng = np.random.default_rng(config[\\\"seed\\\"])\n    single_axes = (\\\"rx\\\", \\\"ry\\\", \\\"rz\\\")\n    two_axes = (\\\"rxx\\\", \\\"ryy\\\", \\\"rzz\\\")\n    graph_edges = ladder_edges(config[\\\"n_qubits\\\"])\n    gate_tape = []\n    parameter_index = 0\n    for _ in range(config[\\\"n_layers\\\"]):\n        for qubit in range(config[\\\"n_qubits\\\"]):\n            axis = single_axes[int(rng.integers(len(single_axes)))]\n            gate_tape.append((axis, qubit, parameter_index))\n            parameter_index += 1\n        edges = list(graph_edges)\n        rng.shuffle(edges)\n        used = set()\n        for qubit_a, qubit_b in edges:\n            if qubit_a in used or qubit_b in used:\n                continue\n            if rng.random() > config[\\\"edge_keep_prob\\\"]:\n                continue\n            axis = two_axes[int(rng.integers(len(two_axes)))]\n            gate_tape.append((axis, qubit_a, qubit_b, parameter_index))\n            parameter_index += 1\n            used.add(qubit_a)\n            used.add(qubit_b)\n    return tuple(gate_tape), parameter_index\n\nconfig = {\n    \\\"n_qubits\\\": 512,\n    \\\"n_layers\\\": 6,\n    \\\"max_steps\\\": 100,\n    \\\"n_restarts\\\": 200,\n    \\\"learning_rate\\\": 0.03,\n    \\\"initial_parameter_scale\\\": 0.02,\n    \\\"seed\\\": 2035,\n    \\\"edge_keep_prob\\\": 0.24,\n    \\\"success_threshold\\\": 1.0,\n}\ngate_tape, parameter_count = generate_gate_tape(config)\npauli_terms = (\n    (0.5645931361768194, ((\\\"x\\\", 388), (\\\"z\\\", 390))),\n    (1.0, ((\\\"x\\\", 16), (\\\"y\\\", 19))),\n)\n\ndef extract_cone(gate_tape, support_qubits):\n    relevant = set(support_qubits)\n    gates = []\n    for g in reversed(gate_tape):\n        if len(g) == 3:\n            name, q, pidx = g\n            if q in relevant:\n                gates.append(g)\n        else:\n            name, a, b, pidx = g\n            if a in relevant or b in relevant:\n                relevant.add(a)\n                relevant.add(b)\n                gates.append(g)\n    gates.reverse()\n    qubits = sorted(relevant)\n    qmap = {q: i for i, q in enumerate(qubits)}\n    return qubits, qmap, gates\n\ncones = []\nall_pidx = []\nfor coeff, ops in pauli_terms:\n    support = [q for _, q in ops]\n    qubits, qmap, gates = extract_cone(gate_tape, support)\n    mapped_ops = [(p, qmap[q]) for p, q in ops]\n    mgates = []\n    pidxs = []\n    for g in gates:\n        if len(g) == 3:\n            name, q, pidx = g\n            mgates.append((name, qmap[q], pidx))\n            pidxs.append(pidx)\n        else:\n            name, a, b, pidx = g\n            mgates.append((name, qmap[a], qmap[b], pidx))\n            pidxs.append(pidx)\n    cones.append((coeff, len(qubits), mgates, mapped_ops, pidxs))\n    all_pidx.extend(pidxs)\n\nunique_p = sorted(set(all_pidx))\np_to_local = {p: i for i, p in enumerate(unique_p)}\nprint(\\\"total unique params\\\", len(unique_p))\n\ncone_data = []\nfor coeff, nq, mgates, mapped_ops, pidxs in cones:\n    local_gates = []\n    for g in mgates:\n        if len(g) == 3:\n            name, q, pidx = g\n            local_gates.append((name, q, p_to_local[pidx]))\n        else:\n            name, a, b, pidx = g\n            local_gates.append((name, a, b, p_to_local[pidx]))\n    cone_data.append((coeff, nq, local_gates, mapped_ops))\n\ndef objective(theta_local):\n    total = 0.0\n    for coeff, nq, local_gates, mapped_ops in cone_data:\n        c = tc.Circuit(nq)\n        for g in local_gates:\n            if len(g) == 3:\n                name, q, li = g\n                getattr(c, name)(q, theta=theta_local[li])\n            else:\n                name, a, b, li = g\n                getattr(c, name)(a, b, theta=theta_local[li])\n        kw = {}\n        for p, q in mapped_ops:\n            kw.setdefault(p, []).append(q)\n        e = c.expectation_ps(**kw)\n        total = total + coeff * jnp.real(e)\n    return total\n\ntheta0 = jnp.asarray(np.random.randn(len(unique_p)).astype(np.float32) * 0.02)\nprint(\\\"obj\\\", float(objective(theta0)))\n\nlr = config[\\\"learning_rate\\\"]\nb1, b2, eps = 0.9, 0.999, 1e-8\nMAX_STEPS = 100\n\n@jax.jit\ndef optimize_one(theta0):\n    def step(carry, _):\n        theta, m, v, t = carry\n        obj, g = jax.value_and_grad(objective)(theta)\n        t = t + 1\n        m = b1 * m + (1 - b1) * g\n        v = b2 * v + (1 - b2) * (g * g)\n        mhat = m / (1 - b1 ** t)\n        vhat = v / (1 - b2 ** t)\n        # loss = -obj, Adam descends loss => ascent on obj\n        theta = theta + lr * mhat / (jnp.sqrt(vhat) + eps)\n        return (theta, m, v, t), obj\n    m0 = jnp.zeros_like(theta0)\n    v0 = jnp.zeros_like(theta0)\n    (_, _, _, _), objs = jax.lax.scan(step, (theta0, m0, v0, jnp.array(0.0, dtype=theta0.dtype)), None, length=MAX_STEPS)\n    return objs\n\nt0 = time.time()\nobjs = optimize_one(theta0)\nobjs.block_until_ready()\nprint(\\\"compile+run one\\\", time.time()-t0, \\\"first\\\", float(objs[0]), \\\"last\\\", float(objs[-1]))\n\nt0 = time.time()\nobjs = optimize_one(theta0)\nobjs.block_until_ready()\nprint(\\\"run one\\\", time.time()-t0)\n\nn_restarts = 200\ninits = []\nunique_p_arr = np.array(unique_p)\nfor r in range(n_restarts):\n    rng = np.random.default_rng(config[\\\"seed\\\"] + 100000 + r)\n    full = rng.normal(0.0, config[\\\"initial_parameter_scale\\\"], size=parameter_count).astype(np.float32)\n    inits.append(full[unique_p_arr])\ninits = jnp.asarray(np.stack(inits))\n\nopt_all = jax.jit(jax.vmap(optimize_one))\nt0 = time.time()\nall_objs = opt_all(inits)\nall_objs.block_until_ready()\nprint(\\\"compile+vmap 200\\\", time.time()-t0)\nprint(\\\"shape\\\", all_objs.shape)\nprint(\\\"best final\\\", float(all_objs[:, -1].max()))\nprint(\\\"mean final\\\", float(all_objs[:, -1].mean()))\nprint(\\\"mean init\\\", float(all_objs[:, 0].mean()))\nprint(\\\"success frac\\\", float((all_objs[:, -1] >= 1.0).mean()))\n\nt0 = time.time()\nall_objs = opt_all(inits)\nall_objs.block_until_ready()\nprint(\\\"vmap 200 only\\\", time.time()-t0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
