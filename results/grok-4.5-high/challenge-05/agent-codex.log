{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK = tc.backend\n\nn = 18\ng = 1.10\nn_layers = 10\n\ndef filter_X(a):\n    ca = K.cosh(a)\n    sa = K.sinh(a)\n    return K.cast(K.stack([K.stack([ca, sa]), K.stack([sa, ca])]), 'complex64')\n\ndef filter_ZZ(b):\n    zeros = 0.0 * b\n    eb = K.exp(b)\n    emb = K.exp(-b)\n    row0 = K.stack([eb, zeros, zeros, zeros])\n    row1 = K.stack([zeros, emb, zeros, zeros])\n    row2 = K.stack([zeros, zeros, emb, zeros])\n    row3 = K.stack([zeros, zeros, zeros, eb])\n    return K.cast(K.stack([row0, row1, row2, row3]), 'complex64')\n\ndef energy_density(state):\n    c = tc.Circuit(n, inputs=state)\n    e = 0.0\n    for i in range(n-1):\n        e = e - K.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - g * K.real(c.expectation_ps(x=[i]))\n    return e / n\n\ndef loss(params):\n    # params: (2, n_layers) -> a, b\n    params_a = params[0]\n    params_b = params[1]\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    state = c.state()\n    def layer(state, l_ab):\n        a, b = l_ab\n        c = tc.Circuit(n, inputs=state)\n        gx = filter_X(a)\n        gz = filter_ZZ(b)\n        for i in range(n):\n            c.unitary(i, unitary=gx)\n        # even or odd - need layer index. pass as part of carry? use two functions or pass parity\n        return state, None  # placeholder\n    # python loop for layers with parity\n    for l in range(n_layers):\n        c = tc.Circuit(n, inputs=state)\n        gx = filter_X(params_a[l])\n        gz = filter_ZZ(params_b[l])\n        for i in range(n):\n            c.unitary(i, unitary=gx)\n        if l % 2 == 0:\n            for i in range(0, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        else:\n            for i in range(1, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        state = c.state()\n        state = state / K.norm(state)\n    return energy_density(state)\n\nparams = K.convert_to_tensor(np.ones((2, n_layers), dtype=np.float32)*0.01)\n# jit value and grad\nvag = K.jit(K.value_and_grad(loss))\nprint('compiling...')\nt0 = time.time()\nval, grad = vag(params)\nprint('first', val, time.time()-t0)\nt0 = time.time()\nfor i in range(5):\n    val, grad = vag(params)\nprint('5 iters', time.time()-t0, 'val', val)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
