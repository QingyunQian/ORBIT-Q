{"type":"item.started","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\nimport time\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK=tc.backend\nprint('contractors', [x for x in dir(tc.cons) if not x.startswith('_')][:30])\nn=18; g=1.1; n_layers=10\n\ndef filter_X(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.stack([jnp.stack([ca,sa]),jnp.stack([sa,ca])]).astype(jnp.complex64)\n\ndef zz_diag(b):\n    # diagonal of exp(b ZZ): for basis 00,01,10,11 -> +b,-b,-b,+b\n    eb=jnp.exp(b); emb=jnp.exp(-b)\n    return jnp.stack([eb, emb, emb, eb]).astype(jnp.complex64)\n\ndef evolve(params):\n    a,b=params\n    c=tc.Circuit(n)\n    for i in range(n): c.h(i)\n    state=c.state()\n    for l in range(n_layers):\n        c=tc.Circuit(n, inputs=state)\n        gx=filter_X(a[l]); d=zz_diag(b[l])\n        for i in range(n): c.unitary(i, unitary=gx)\n        rng = range(0,n-1,2) if l%2==0 else range(1,n-1,2)\n        for i in rng:\n            # try diagonal gate\n            c.diagonal(i, i+1, unitary=d.reshape(2,2,2,2) if False else d)\n        state=c.state(); state=state/jnp.linalg.norm(state)\n    return state\n\n# check diagonal API\nc=tc.Circuit(2)\nprint('has diagonal', hasattr(c,'diagonal'), hasattr(c,'DIAGONAL'))\nimport inspect\nif hasattr(c,'diagonal'):\n    # find how\n    from tensorcircuit import gates\n    print('diagonal_gate', getattr(gates,'diagonal_gate',None))\nprint([m for m in dir(tc.gates) if 'diag' in m.lower()])\nPY\nrg -n \\\"def diagonal|diagonal_gate|name=\\\\\\\"diagonal\\\\\\\"\\\" /usr/local/lib/python3.11/site-packages/tensorcircuit --glob '*.py' | head -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
