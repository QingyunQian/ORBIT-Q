{"type":"item.started","item":{"id":"item_118","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\nimport time\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK=tc.backend\nn=18\ng=1.1\nn_layers=10\n\ndef filter_X(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.stack([jnp.stack([ca,sa]),jnp.stack([sa,ca])]).astype(jnp.complex64)\ndef filter_ZZ(b):\n    z=jnp.zeros(()); eb=jnp.exp(b); emb=jnp.exp(-b)\n    return jnp.stack([\n        jnp.stack([eb,z,z,z]),jnp.stack([z,emb,z,z]),jnp.stack([z,z,emb,z]),jnp.stack([z,z,z,eb])\n    ]).astype(jnp.complex64)\n\ndef evolve(params):\n    a,b=params\n    c=tc.Circuit(n)\n    for i in range(n): c.h(i)\n    state=c.state()\n    for l in range(n_layers):\n        c=tc.Circuit(n, inputs=state)\n        gx=filter_X(a[l]); gz=filter_ZZ(b[l])\n        for i in range(n): c.unitary(i, unitary=gx)\n        rng = range(0,n-1,2) if l%2==0 else range(1,n-1,2)\n        for i in rng: c.unitary(i,i+1,unitary=gz)\n        state=c.state(); state=state/jnp.linalg.norm(state)\n    return state\n\ndef energy(state):\n    c=tc.Circuit(n, inputs=state)\n    e=0.0\n    for i in range(n-1): e = e - jnp.real(c.expectation_ps(z=[i,i+1]))\n    for i in range(n): e = e - g*jnp.real(c.expectation_ps(x=[i]))\n    return e/n\n\ndef loss(params):\n    return energy(evolve(params))\n\nparams=jnp.ones((2,10),dtype=jnp.float32)*0.01\nev=K.jit(evolve)\nen=K.jit(energy)\nls=K.jit(loss)\nvag=K.jit(K.value_and_grad(loss))\n\ns=ev(params); s.block_until_ready()\nt0=time.time();\nfor _ in range(10):\n    s=ev(params)\ns.block_until_ready(); print('evolve10', time.time()-t0)\n\ne=en(s); e.block_until_ready()\nt0=time.time();\nfor _ in range(10):\n    e=en(s)\ne.block_until_ready(); print('energy10', time.time()-t0)\n\nv=ls(params); v.block_until_ready()\nt0=time.time();\nfor _ in range(10):\n    v=ls(params)\nv.block_until_ready(); print('loss10', time.time()-t0)\n\nv,g=vag(params); v.block_until_ready()\nt0=time.time();\nfor _ in range(10):\n    v,g=vag(params)\nv.block_until_ready(); print('vag10', time.time()-t0)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
