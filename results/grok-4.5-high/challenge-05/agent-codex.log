{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax.numpy as jnp\nimport numpy as np\nimport time\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK=tc.backend\nn=18; g=np.float32(1.1); n_layers=10\n\ndef filter_X(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.stack([jnp.stack([ca,sa]),jnp.stack([sa,ca])]).astype(jnp.complex64)\ndef zz_diag(b):\n    eb=jnp.exp(b); emb=jnp.exp(-b)\n    return jnp.stack([eb, emb, emb, eb]).astype(jnp.complex64)\n\ndef loss(params):\n    a=params[0]; b=params[1]\n    c=tc.Circuit(n)\n    for i in range(n): c.h(i)\n    state=c.state()\n    for l in range(n_layers):\n        c=tc.Circuit(n, inputs=state)\n        gx=filter_X(a[l]); d=zz_diag(b[l])\n        for i in range(n): c.unitary(i, unitary=gx)\n        rng = range(0,n-1,2) if (l%2==0) else range(1,n-1,2)\n        for i in rng:\n            c.diagonal(i, i+1, diag=d)\n        state=c.state(); state=state/jnp.linalg.norm(state)\n    c=tc.Circuit(n, inputs=state)\n    e=jnp.float32(0.0)\n    for i in range(n-1):\n        e = e - jnp.real(c.expectation_ps(z=[i,i+1]))\n    for i in range(n):\n        e = e - g*jnp.real(c.expectation_ps(x=[i]))\n    return e/n\n\nparams=jnp.ones((2,10),dtype=jnp.float32)*0.01\nvag=K.jit(K.value_and_grad(loss))\nv,g=vag(params); v.block_until_ready()\nprint('val', float(v))\nt0=time.time()\nfor _ in range(20):\n    v,g=vag(params)\nv.block_until_ready()\nprint('20 vag', time.time()-t0, 'per', (time.time()-t0)/20)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
