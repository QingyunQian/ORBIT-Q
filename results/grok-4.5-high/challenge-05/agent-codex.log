{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\nimport optax\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK = tc.backend\n\nn = 18\ng = 1.10\nn_layers = 10\nmax_steps = 600\nlr = 0.02\n\ndef filter_X(a):\n    ca = K.cosh(a)\n    sa = K.sinh(a)\n    return K.cast(K.stack([K.stack([ca, sa]), K.stack([sa, ca])]), 'complex64')\n\ndef filter_ZZ(b):\n    zeros = 0.0 * b\n    eb = K.exp(b)\n    emb = K.exp(-b)\n    mat = K.stack([\n        K.stack([eb, zeros, zeros, zeros]),\n        K.stack([zeros, emb, zeros, zeros]),\n        K.stack([zeros, zeros, emb, zeros]),\n        K.stack([zeros, zeros, zeros, eb]),\n    ])\n    return K.cast(mat, 'complex64')\n\ndef energy_density(state):\n    c = tc.Circuit(n, inputs=state)\n    e = 0.0\n    for i in range(n-1):\n        e = e - K.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - g * K.real(c.expectation_ps(x=[i]))\n    return e / n\n\ndef loss(params):\n    params_a = params[0]\n    params_b = params[1]\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    state = c.state()\n    for l in range(n_layers):\n        c = tc.Circuit(n, inputs=state)\n        gx = filter_X(params_a[l])\n        gz = filter_ZZ(params_b[l])\n        for i in range(n):\n            c.unitary(i, unitary=gx)\n        if l % 2 == 0:\n            for i in range(0, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        else:\n            for i in range(1, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        state = c.state()\n        state = state / K.norm(state)\n    return energy_density(state)\n\nparams = K.convert_to_tensor(np.ones((2, n_layers), dtype=np.float32)*0.01)\nvag = K.jit(K.value_and_grad(loss))\n\n# Adam via optax or manual\ntry:\n    import optax\n    print('optax available')\nexcept Exception as e:\n    print('no optax', e)\n\n# manual adam with scan\nbeta1, beta2, eps = 0.9, 0.999, 1e-8\n\n@K.jit\ndef train_step(params, m, v, t):\n    val, g = vag(params)  # nested jit?\n    t = t + 1\n    m = beta1 * m + (1-beta1) * g\n    v = beta2 * v + (1-beta2) * g * g\n    mhat = m / (1 - beta1**t)\n    vhat = v / (1 - beta2**t)\n    params = params - lr * mhat / (K.sqrt(vhat) + eps)\n    return params, m, v, t, val\n\n# Actually nested jit of vag might be issue - define value_and_grad inside\n\nloss_vag = K.value_and_grad(loss)\n\n@jax.jit\ndef step(carry, _):\n    params, m, v, t = carry\n    val, g = loss_vag(params)\n    t = t + 1\n    m = beta1 * m + (1-beta1) * g\n    v = beta2 * v + (1-beta2) * (g*g)\n    mhat = m / (1 - beta1**t)\n    vhat = v / (1 - beta2**t)\n    params = params - lr * mhat / (jnp.sqrt(vhat) + eps)\n    return (params, m, v, t), val\n\nparams0 = jnp.ones((2, n_layers), dtype=jnp.float32)*0.01\nm0 = jnp.zeros_like(params0)\nv0 = jnp.zeros_like(params0)\nt0 = jnp.array(0, dtype=jnp.float32)\n\nprint('compiling scan...')\nt_start = time.time()\n# warmup small\ncarry, hist = jax.lax.scan(step, (params0, m0, v0, t0), None, length=2)\nhist.block_until_ready()\nprint('warmup', time.time()-t_start, 'hist', hist)\n\nt_start = time.time()\ncarry, hist = jax.lax.scan(step, (params0, m0, v0, t0), None, length=max_steps)\nhist.block_until_ready()\nparams_f, _, _, _ = carry\nprint('600 steps', time.time()-t_start)\nprint('init E', hist[0], 'final E', hist[-1])\nprint('params a', params_f[0])\nprint('params b', params_f[1])\nprint('min hist', hist.min())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
