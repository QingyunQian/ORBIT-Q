{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nfrom scipy.linalg import expm\n\ntc.set_backend('jax')\nK = tc.backend\n\nn = 6\ng = 1.10\n\ndef make_ham_terms(n, g):\n    # return list of expectation contributions\n    pass\n\ndef energy_density(state, n, g):\n    # use circuit from state\n    c = tc.Circuit(n, inputs=state)\n    e = 0.0\n    for i in range(n-1):\n        e = e - c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e = e - g * c.expectation_ps(x=[i])\n    return K.real(e) / n\n\ndef filter_X(a):\n    # exp(a X) = cosh(a) I + sinh(a) X\n    ca = K.cosh(a)\n    sa = K.sinh(a)\n    # matrix [[ca, sa],[sa, ca]]\n    return K.stack([K.stack([ca, sa]), K.stack([sa, ca])])\n\ndef filter_ZZ(b):\n    # exp(b ZZ) in computational basis is diagonal: exp(b) for |00>,|11|; exp(-b) for |01>,|10|\n    eb = K.exp(b)\n    emb = K.exp(-b)\n    # 4x4 matrix\n    mat = K.zeros((4,4), dtype=K.complex128 if False else None)\n    # better construct explicitly\n    zeros = 0.0*b\n    ones = zeros + 1.0\n    # use complex\n    m00 = eb\n    row0 = K.stack([eb, zeros, zeros, zeros])\n    row1 = K.stack([zeros, emb, zeros, zeros])\n    row2 = K.stack([zeros, zeros, emb, zeros])\n    row3 = K.stack([zeros, zeros, zeros, eb])\n    mat = K.stack([row0,row1,row2,row3])\n    return K.cast(mat, dtype='complex64')\n\nprint(filter_X(0.5))\nprint(filter_ZZ(0.3))\nprint(expm(0.3*np.diag([1,-1,-1,1])))\n\ndef circuit_energy(params_a, params_b):\n    # params shape (n_layers,)\n    n_layers = params_a.shape[0]\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    state = c.state()\n    for l in range(n_layers):\n        c = tc.Circuit(n, inputs=state)\n        gx = filter_X(params_a[l])\n        gz = filter_ZZ(params_b[l])\n        # cast gx\n        gx = K.cast(gx, 'complex64')\n        for i in range(n):\n            c.unitary(i, unitary=gx)\n        if l % 2 == 0:\n            pairs = [(i,i+1) for i in range(0,n-1,2)]\n        else:\n            pairs = [(i,i+1) for i in range(1,n-1,2)]\n        for i,j in pairs:\n            c.unitary(i,j, unitary=gz)\n        state = c.state()\n        # normalize\n        state = state / K.norm(state)\n    return energy_density(state, n, g)\n\nn_layers = 4\na = K.convert_to_tensor(np.ones(n_layers)*0.01)\nb = K.convert_to_tensor(np.ones(n_layers)*0.01)\nprint('E', circuit_energy(a,b))\n\nval, grad = K.value_and_grad(circuit_energy, argnums=(0,1))(a,b)\nprint('val', val)\nprint('grad a', grad[0])\nprint('grad b', grad[1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
