{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train5b.py << 'EOF'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK = tc.backend\n\nn = 18\ng = np.float32(1.10)\nn_layers = 10\nmax_steps = 600\nlr = np.float32(0.02)\nbeta1 = np.float32(0.9)\nbeta2 = np.float32(0.999)\neps = np.float32(1e-8)\n\ndef filter_X(a):\n    ca = jnp.cosh(a)\n    sa = jnp.sinh(a)\n    mat = jnp.stack([jnp.stack([ca, sa]), jnp.stack([sa, ca])])\n    return mat.astype(jnp.complex64)\n\ndef filter_ZZ(b):\n    zeros = jnp.zeros((), dtype=b.dtype)\n    eb = jnp.exp(b)\n    emb = jnp.exp(-b)\n    mat = jnp.stack([\n        jnp.stack([eb, zeros, zeros, zeros]),\n        jnp.stack([zeros, emb, zeros, zeros]),\n        jnp.stack([zeros, zeros, emb, zeros]),\n        jnp.stack([zeros, zeros, zeros, eb]),\n    ])\n    return mat.astype(jnp.complex64)\n\ndef energy_density(state):\n    c = tc.Circuit(n, inputs=state)\n    e = jnp.zeros((), dtype=jnp.float32)\n    for i in range(n-1):\n        e = e - jnp.real(c.expectation_ps(z=[i, i+1]))\n    for i in range(n):\n        e = e - g * jnp.real(c.expectation_ps(x=[i]))\n    return e / n\n\ndef loss(params):\n    # params shape (2, n_layers)\n    params_a = params[0]\n    params_b = params[1]\n    c = tc.Circuit(n)\n    for i in range(n):\n        c.h(i)\n    state = c.state()\n    for l in range(n_layers):\n        c = tc.Circuit(n, inputs=state)\n        gx = filter_X(params_a[l])\n        gz = filter_ZZ(params_b[l])\n        for i in range(n):\n            c.unitary(i, unitary=gx)\n        if l % 2 == 0:\n            for i in range(0, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        else:\n            for i in range(1, n-1, 2):\n                c.unitary(i, i+1, unitary=gz)\n        state = c.state()\n        state = state / jnp.linalg.norm(state)\n    return energy_density(state)\n\nloss_vag = K.value_and_grad(loss)\n\n@jax.jit\ndef adam_step(params, m, v, t):\n    val, g = loss_vag(params)\n    t = t + 1\n    m = beta1 * m + (1 - beta1) * g\n    v = beta2 * v + (1 - beta2) * (g * g)\n    mhat = m / (1 - beta1 ** t)\n    vhat = v / (1 - beta2 ** t)\n    params = params - lr * mhat / (jnp.sqrt(vhat) + eps)\n    return params, m, v, t, val\n\nparams = jnp.ones((2, n_layers), dtype=jnp.float32) * np.float32(0.01)\nm = jnp.zeros_like(params)\nv = jnp.zeros_like(params)\nt = jnp.array(0, dtype=jnp.float32)\n\nprint('compile...', flush=True)\nt0 = time.time()\nparams, m, v, t, val = adam_step(params, m, v, t)\nval.block_until_ready()\nprint('compile done', time.time()-t0, 'val', float(val), flush=True)\n\n# reset\nparams = jnp.ones((2, n_layers), dtype=jnp.float32) * np.float32(0.01)\nm = jnp.zeros_like(params)\nv = jnp.zeros_like(params)\nt = jnp.array(0, dtype=jnp.float32)\nhist = []\nt0 = time.time()\nfor step in range(max_steps):\n    params, m, v, t, val = adam_step(params, m, v, t)\n    hist.append(float(np.asarray(val)))\n    if (step+1) % 100 == 0:\n        print(step+1, hist[-1], time.time()-t0, flush=True)\nval.block_until_ready()\nprint('total', time.time()-t0, flush=True)\nprint('final', hist[-1], 'init', hist[0], flush=True)\nnp.save('/tmp/hist5b.npy', np.array(hist))\nnp.save('/tmp/params5b.npy', np.array(params))\nprint('SAVED', flush=True)\nEOF\npython /tmp/train5b.py 2>&1 | tee /tmp/train5b.log\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
