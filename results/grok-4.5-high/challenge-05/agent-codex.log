{"type":"item.started","item":{"id":"item_79","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport numpy as np\nfrom scipy import sparse\nfrom scipy.sparse.linalg import eigsh\nn=18\ng=1.10\n# build sparse H\ndim=2**n\n# Use kron construction carefully\nsx=sparse.csr_matrix(np.array([[0,1],[1,0]],dtype=np.float64))\nsz=sparse.csr_matrix(np.array([[1,0],[0,-1]],dtype=np.float64))\nI=sparse.eye(2,format='csr')\n\ndef op_on(ops):\n    # ops list of length n\n    out=ops[0]\n    for a in ops[1:]:\n        out=sparse.kron(out,a,format='csr')\n    return out\n\nH = sparse.csr_matrix((dim,dim), dtype=np.float64)\nfor i in range(n-1):\n    ops=[I]*n\n    ops[i]=sz; ops[i+1]=sz\n    H = H - op_on(ops)\nfor i in range(n):\n    ops=[I]*n\n    ops[i]=sx\n    H = H - g*op_on(ops)\nprint('H nnz', H.nnz)\ne=eigsh(H,k=1,which='SA',return_eigenvectors=False)\nprint('E0', e[0], 'density', e[0]/n)\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
