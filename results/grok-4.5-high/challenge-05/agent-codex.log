workaround. Do not bypass the obstruction by switching frameworks, by importing or using another quantum framework, by writing a raw quantum simulator from scratch, by reverse-engineering the evaluator thresholds, or by manufacturing outputs that mimic a successful run without actually performing the required computation. \n9:root         470  0.0  0.0   4336  3204 ?        Ss   18:48   0:00 /bin/bash -c python - <<'PY' import tensorcircuit as tc import jax import jax.numpy as jnp import numpy as np import time import optax  tc.set_backend('jax') tc.set_dtype('complex64') K = tc.backend  n = 18 g = 1.10 n_layers = 10 max_steps = 600 lr = 0.02  def filter_X(a):     ca = K.cosh(a)     sa = K.sinh(a)     return K.cast(K.stack([K.stack([ca, sa]), K.stack([sa, ca])]), 'complex64')  def filter_ZZ(b):     zeros = 0.0 * b     eb = K.exp(b)     emb = K.exp(-b)     mat = K.stack([         K.stack([eb, zeros, zeros, zeros]),         K.stack([zeros, emb, zeros, zeros]),         K.stack([zeros, zeros, emb, zeros]),         K.stack([zeros, zeros, zeros, eb]),     ])     return K.cast(mat, 'complex64')  def energy_density(state):     c = tc.Circuit(n, inputs=state)     e = 0.0     for i in range(n-1):         e = e - K.real(c.expectation_ps(z=[i, i+1]))     for i in range(n):         e = e - g * K.real(c.expectation_ps(x=[i]))     return e / n  def loss(params):     params_a = params[0]     params_b = params[1]     c = tc.Circuit(n)     for i in range(n):         c.h(i)     state = c.state()     for l in range(n_layers):         c = tc.Circuit(n, inputs=state)         gx = filter_X(params_a[l])         gz = filter_ZZ(params_b[l])         for i in range(n):             c.unitary(i, unitary=gx)         if l % 2 == 0:             for i in range(0, n-1, 2):                 c.unitary(i, i+1, unitary=gz)         else:             for i in range(1, n-1, 2):                 c.unitary(i, i+1, unitary=gz)         state = c.state()         state = state / K.norm(state)     return energy_density(state)  params = K.convert_to_tensor(np.ones((2, n_layers), dtype=np.float32)*0.01) vag = K.jit(K.value_and_grad(loss))  # Adam via optax or manual try:     import optax     print('optax available') except Exception as e:     print('no optax', e)  # manual adam with scan beta1, beta2, eps = 0.9, 0.999, 1e-8  @K.jit def train_step(params, m, v, t):     val, g = vag(params)  # nested jit?     t = t + 1     m = beta1 * m + (1-beta1) * g     v = beta2 * v + (1-beta2) * g * g     mhat = m / (1 - beta1**t)     vhat = v / (1 - beta2**t)     params = params - lr * mhat / (K.sqrt(vhat) + eps)     return params, m, v, t, val  # Actually nested jit of vag might be issue - define value_and_grad inside  loss_vag = K.value_and_grad(loss)  @jax.jit def step(carry, _):     params, m, v, t = carry     val, g = loss_vag(params)     t = t + 1     m = beta1 * m + (1-beta1) * g     v = beta2 * v + (1-beta2) * (g*g)     mhat = m / (1 - beta1**t)     vhat = v / (1 - beta2**t)     params = params - lr * mhat / (jnp.sqrt(vhat) + eps)     return (params, m, v, t), val  params0 = jnp.ones((2, n_layers), dtype=jnp.float32)*0.01 m0 = jnp.zeros_like(params0) v0 = jnp.zeros_like(params0) t0 = jnp.array(0, dtype=jnp.float32)  print('compiling scan...') t_start = time.time() # warmup small carry, hist = jax.lax.scan(step, (params0, m0, v0, t0), None, length=2) hist.block_until_ready() print('warmup', time.time()-t_start, 'hist', hist)  t_start = time.time() carry, hist = jax.lax.scan(step, (params0, m0, v0, t0), None, length=max_steps) hist.block_until_ready() params_f, _, _, _ = carry print('600 steps', time.time()-t_start) print('init E', hist[0], 'final E', hist[-1]) print('params a', params_f[0]) print('params b', params_f[1]) print('min hist', hist.min()) PY\n10:root         471  325  6.3 4315616 1038688 ?     Sl   18:48   1:56 python -\n12:root         546  0.0  0.0   4332  3184 ?        Ss   18:48   0:00 /bin/bash -c ps aux | rg -n \"python|jax\" | head -20; ls -la /proc/28419 2>/dev/nul