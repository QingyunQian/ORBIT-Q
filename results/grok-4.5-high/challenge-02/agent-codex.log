{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\nn_blocks = 3\nzz = 1.2\nhz = 0.35\nss = 6\nw = 0.25\ntarget = jnp.array([0.30, 0.60, 0.80], dtype=jnp.float32)\nppb = 81\nn_params = 3*81\n\n# Build dense Hamiltonian once with numpy\ndef build_H(n, zz, hz):\n    dim = 2**n\n    # Use sparse scipy then to dense/jax\n    import scipy.sparse as sp\n    X = sp.csr_matrix([[0,1],[1,0]], dtype=np.complex64)\n    Y = sp.csr_matrix([[0,-1j],[1j,0]], dtype=np.complex64)\n    Z = sp.csr_matrix([[1,0],[0,-1]], dtype=np.complex64)\n    I = sp.eye(2, dtype=np.complex64)\n    def kron_n(ops):\n        out = ops[0]\n        for op in ops[1:]:\n            out = sp.kron(out, op, format='csr')\n        return out\n    H = sp.csr_matrix((dim,dim), dtype=np.complex64)\n    for i in range(n-1):\n        ops = [I]*n\n        ops[i]=X; ops[i+1]=X\n        H = H + kron_n(ops)\n        ops = [I]*n\n        ops[i]=Y; ops[i+1]=Y\n        H = H + kron_n(ops)\n        ops = [I]*n\n        ops[i]=Z; ops[i+1]=Z\n        H = H + zz * kron_n(ops)\n    for i in range(n):\n        ops = [I]*n\n        ops[i]=Z\n        H = H + hz * ((-1)**i) * kron_n(ops)\n    return H\n\nt0=time.time()\nHsp = build_H(n,zz,hz)\nH = jnp.array(Hsp.toarray())\nprint('H built', time.time()-t0, H.shape, 'dtype', H.dtype)\n\n# initial state via circuit\ndef make_init():\n    c = tc.Circuit(n)\n    for i in range(1,n,2):\n        c.x(i)\n    return c.state()\n\ninit = make_init()\nprint('init argmax', int(jnp.argmax(jnp.abs(init))), int('010101010101',2))\n\neven_bonds = [(i,i+1) for i in range(0,n,2)]\nodd_bonds = [(i,i+1) for i in range(1,n-1,2)]\nxx = tc.gates._xx_matrix\nyy = tc.gates._yy_matrix\nzzm = tc.gates._zz_matrix\n\ndef forward(params):\n    p = params.reshape(n_blocks, ppb)\n    c = tc.Circuit(n, inputs=init)\n    ents = []\n    for b in range(n_blocks):\n        pb = p[b]\n        idx=0\n        ery=pb[idx:idx+12]; idx+=12\n        erz=pb[idx:idx+12]; idx+=12\n        eint=pb[idx:idx+18].reshape(6,3); idx+=18\n        ory=pb[idx:idx+12]; idx+=12\n        orz=pb[idx:idx+12]; idx+=12\n        oint=pb[idx:idx+15].reshape(5,3)\n        for q in range(n):\n            c.ry(q, theta=ery[q]); c.rz(q, theta=erz[q])\n        for bi,(i,j) in enumerate(even_bonds):\n            c.exp1(i,j,theta=eint[bi,0], unitary=xx)\n            c.exp1(i,j,theta=eint[bi,1], unitary=yy)\n            c.exp1(i,j,theta=eint[bi,2], unitary=zzm)\n        for q in range(n):\n            c.ry(q, theta=ory[q]); c.rz(q, theta=orz[q])\n        for bi,(i,j) in enumerate(odd_bonds):\n            c.exp1(i,j,theta=oint[bi,0], unitary=xx)\n            c.exp1(i,j,theta=oint[bi,1], unitary=yy)\n            c.exp1(i,j,theta=oint[bi,2], unitary=zzm)\n        st = c.state()\n        # entropy via tc.quantum\n        rho = tc.quantum.reduced_density_matrix(st, list(range(ss,n)))\n        ents.append(tc.quantum.renyi_entropy(rho, 2))\n    st = c.state()\n    # energy <psi|H|psi>\n    e = jnp.real(jnp.vdot(st, H @ st))\n    ents = jnp.stack(ents).astype(jnp.float32)\n    return e, ents\n\ndef loss_fn(params):\n    e, ents = forward(params)\n    mse = jnp.mean((ents - target)**2)\n    loss = e/n + w*mse\n    return loss, (e/n, mse, ents)\n\nkey = jax.random.PRNGKey(0)\nparams = 0.02 * jax.random.normal(key, (n_params,), dtype=jnp.float32)\n\nt0=time.time()\nval = loss_fn(params)\nprint('fwd', time.time()-t0, val[0], val[1][0], val[1][1], val[1][2])\n\nt0=time.time()\n(val,aux),g = jax.value_and_grad(loss_fn, has_aux=True)(params)\nprint('grad', time.time()-t0, float(val), float(jnp.linalg.norm(g)))\n\nvg = jax.jit(jax.value_and_grad(loss_fn, has_aux=True))\nt0=time.time()\n(val,aux),g = vg(params)\nval.block_until_ready()\nprint('jit1', time.time()-t0)\n\nt0=time.time()\n(val,aux),g = vg(params)\nval.block_until_ready()\nprint('jit2', time.time()-t0, float(val), float(aux[0]), float(aux[1]), aux[2])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
