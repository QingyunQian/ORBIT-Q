{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\nzz_aniso = 1.2\nh_stag = 0.35\nn_blocks = 3\nparams_per_block = 81\nn_params = n_blocks * params_per_block\n\nxx = tc.gates._xx_matrix\nyy = tc.gates._yy_matrix\nzz = tc.gates._zz_matrix\neven_bonds = [(i,i+1) for i in range(0,n,2)]\nodd_bonds = [(i,i+1) for i in range(1,n-1,2)]\neven_n = n*2 + len(even_bonds)*3\n\ndef apply_sublayer(c, params, bonds):\n    idx = 0\n    for q in range(n):\n        c.ry(q, theta=params[idx]); idx+=1\n        c.rz(q, theta=params[idx]); idx+=1\n    for (i,j) in bonds:\n        c.exp1(i, j, theta=params[idx], unitary=xx); idx+=1\n        c.exp1(i, j, theta=params[idx], unitary=yy); idx+=1\n        c.exp1(i, j, theta=params[idx], unitary=zz); idx+=1\n    return c\n\n# Build sparse Hamiltonian with numpy/scipy for energy from state\nimport scipy.sparse as sp\nI = sp.eye(2, format='csr', dtype=np.complex64)\nX = sp.csr_matrix(np.array([[0,1],[1,0]], dtype=np.complex64))\nY = sp.csr_matrix(np.array([[0,-1j],[1j,0]], dtype=np.complex64))\nZ = sp.csr_matrix(np.array([[1,0],[0,-1]], dtype=np.complex64))\n\ndef op_on(ops):\n    # ops: list of 12 sparse 2x2\n    out = ops[0]\n    for o in ops[1:]:\n        out = sp.kron(out, o, format='csr')\n    return out\n\ndef two_site(i,j,A,B):\n    ops=[I]*n\n    ops[i]=A; ops[j]=B\n    return op_on(ops)\n\nH = sp.csr_matrix((2**n, 2**n), dtype=np.complex64)\nfor i in range(n-1):\n    H = H + two_site(i,i+1,X,X)\n    H = H + two_site(i,i+1,Y,Y)\n    H = H + zz_aniso * two_site(i,i+1,Z,Z)\nfor i in range(n):\n    ops=[I]*n; ops[i]=Z\n    H = H + h_stag*((-1)**i)*op_on(ops)\nH = H.astype(np.complex64)\nprint('H nnz', H.nnz)\n\n# Convert H to dense jax for matvec? 4096\"'^2 is 16M complex64 = 128MB - ok\nH_dense = jnp.array(H.toarray())\nprint('\"'H dense ok', H_dense.shape)\n\ndef circuit_outputs(params):\n    params = params.reshape(n_blocks, params_per_block)\n    c = tc.Circuit(n)\n    for q in range(n):\n        if q % 2 == 1:\n            c.x(q)\n    s2s = []\n    for b in range(n_blocks):\n        p = params[b]\n        apply_sublayer(c, p[:even_n], even_bonds)\n        apply_sublayer(c, p[even_n:], odd_bonds)\n        psi = c.state()\n        rho = tc.quantum.reduced_density_matrix(psi, list(range(6,12)))\n        s2 = tc.quantum.renyi_entropy(rho, k=2)\n        s2s.append(jnp.real(s2))\n    psi = c.state()\n    # energy = <psi|H|psi>\n    e = jnp.real(jnp.vdot(psi, H_dense @ psi))\n    return e, jnp.stack(s2s)\n\nkey = jax.random.PRNGKey(0)\nparams = 0.02 * jax.random.normal(key, (n_params,), dtype=jnp.float32)\n\nt0=time.time()\ne,s2 = circuit_outputs(params)\nprint('eager', float(e), np.array(s2), time.time()-t0, flush=True)\n\n# jit\njitted = jax.jit(circuit_outputs)\nt0=time.time()\ne,s2 = jitted(params)\ne.block_until_ready()\nprint('jit1', float(e), np.array(s2), time.time()-t0, flush=True)\nt0=time.time()\ne,s2 = jitted(params)\ne.block_until_ready()\nprint('jit2', float(e), np.array(s2), time.time()-t0, flush=True)\n\ndef loss_fn(params):\n    e, s2 = circuit_outputs(params)\n    targets = jnp.array([0.3,0.6,0.8], dtype=jnp.float32)\n    mse = jnp.mean((s2 - targets)**2)\n    loss = e/n + 0.25 * mse\n    return loss, (e/n, mse, s2)\n\n@jax.jit\ndef step_metrics_grad(params):\n    (loss, aux), g = jax.value_and_grad(loss_fn, has_aux=True)(params)\n    return loss, aux, g\n\nt0=time.time()\nloss, aux, g = step_metrics_grad(params)\nloss.block_until_ready()\nprint('grad1', float(loss), float(aux[0]), float(aux[1]), time.time()-t0, flush=True)\nt0=time.time()\nloss, aux, g = step_metrics_grad(params)\nloss.block_until_ready()\nprint('grad2', float(loss), time.time()-t0, 'gnorm', float(jnp.linalg.norm(g)), flush=True)\nPY\n\"","aggregated_output":"H nnz 26624\nH dense ok (4096, 40