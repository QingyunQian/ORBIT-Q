{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"# Check if still going and try numpy-only speed of manual state evolution vs TC\nps -p 703 -o etime=,pcpu=,stat= 2>/dev/null || echo dead\n# How fast is bare jax statevector with TC gates matrices via Circuit.unitary path?\npython - <<'PY'\nimport time, numpy as np, jax, jax.numpy as jnp, tensorcircuit as tc\ntc.set_backend('jax'); tc.set_dtype('complex64')\n\n# Minimal circuit timing\nn=12\ndef energy_simple(params):\n    c = tc.Circuit(n)\n    for i in range(1,n,2):\n        c.x(i)\n    # few gates\n    for i in range(n):\n        c.ry(i, theta=params[i])\n    s = c.state()\n    return jnp.real(jnp.vdot(s,s))\n\nparams = jnp.ones(n)\nt0=time.time(); energy_simple(params); print('eager', time.time()-t0)\nf=jax.jit(jax.value_and_grad(energy_simple))\nt0=time.time(); v,g=f(params); v.block_until_ready(); print('jit1', time.time()-t0)\nt0=time.time(); v,g=f(params); v.block_until_ready(); print('jit2', time.time()-t0)\n\n# larger circuit like ours\nppb=81\nn_blocks=3\nn_params=243\nxxm=tc.gates._xx_matrix; yym=tc.gates._yy_matrix; zzm=tc.gates._zz_matrix\neven=[(i,i+1) for i in range(0,n,2)]\nodd=[(i,i+1) for i in range(1,n-1,2)]\n\ndef fwd(params):\n    p=params.reshape(n_blocks,ppb)\n    c=tc.Circuit(n)\n    for i in range(1,n,2): c.x(i)\n    for b in range(n_blocks):\n        pb=p[b]; idx=0\n        ery=pb[idx:idx+12]; idx+=12\n        erz=pb[idx:idx+12]; idx+=12\n        eint=pb[idx:idx+18].reshape(6,3); idx+=18\n        ory=pb[idx:idx+12]; idx+=12\n        orz=pb[idx:idx+12]; idx+=12\n        oint=pb[idx:idx+15].reshape(5,3)\n        for q in range(n):\n            c.ry(q,theta=ery[q]); c.rz(q,theta=erz[q])\n        for bi,(i,j) in enumerate(even):\n            c.exp1(i,j,theta=eint[bi,0],unitary=xxm)\n            c.exp1(i,j,theta=eint[bi,1],unitary=yym)\n            c.exp1(i,j,theta=eint[bi,2],unitary=zzm)\n        for q in range(n):\n            c.ry(q,theta=ory[q]); c.rz(q,theta=orz[q])\n        for bi,(i,j) in enumerate(odd):\n            c.exp1(i,j,theta=oint[bi,0],unitary=xxm)\n            c.exp1(i,j,theta=oint[bi,1],unitary=yym)\n            c.exp1(i,j,theta=oint[bi,2],unitary=zzm)\n    s=c.state()\n    return jnp.real((s.conj()*s).sum())\n\nparams=0.02*jax.random.normal(jax.random.PRNGKey(0),(n_params,),dtype=jnp.float32)\nt0=time.time(); print('eager big', float(fwd(params)), time.time()-t0)\nf=jax.jit(jax.value_and_grad(fwd))\nprint('compiling...')\nt0=time.time(); v,g=f(params); v.block_until_ready(); print('jit1 big', time.time()-t0)\nt0=time.time(); v,g=f(params); v.block_until_ready(); print('jit2 big', time.time()-t0, float(v), float(jnp.linalg.norm(g)))\nPY\n# also check original bench\necho '---bench---'\ncat /tmp/tc_bench.txt\nps -p 703 -o etime= 2>/dev/null || echo dead\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
