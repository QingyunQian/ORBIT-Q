{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\nK = tc.set_backend('jax')\n\nn = 12\nn_blocks = 3\nzz_anisotropy = 1.2\nstaggered_field = 0.35\nsubsystem_size = 6\nentropy_weight = 0.25\ntarget = jnp.array([0.30, 0.60, 0.80], dtype=jnp.float32)\n\n# param structure\n# even: ry[12], rz[12], int[6,3]\n# odd: ry[12], rz[12], int[5,3]\nparams_per_block = 12+12+6*3 + 12+12+5*3\nprint('params_per_block', params_per_block)\nn_params = n_blocks * params_per_block\nprint('n_params', n_params)\n\ndef unpack(params):\n    # params shape (n_blocks, 81)\n    p = params.reshape(n_blocks, params_per_block)\n    out = []\n    for b in range(n_blocks):\n        pb = p[b]\n        idx = 0\n        ery = pb[idx:idx+12]; idx+=12\n        erz = pb[idx:idx+12]; idx+=12\n        eint = pb[idx:idx+18].reshape(6,3); idx+=18\n        ory = pb[idx:idx+12]; idx+=12\n        orz = pb[idx:idx+12]; idx+=12\n        oint = pb[idx:idx+15].reshape(5,3); idx+=15\n        out.append((ery,erz,eint,ory,orz,oint))\n    return out\n\ndef apply_sublayer(c, ry, rz, bonds, ints):\n    for q in range(n):\n        c.ry(q, theta=ry[q])\n        c.rz(q, theta=rz[q])\n    for bi, (i,j) in enumerate(bonds):\n        th = ints[bi]\n        c.exp1(i, j, theta=th[0], unitary=tc.gates._xx_matrix)\n        c.exp1(i, j, theta=th[1], unitary=tc.gates._yy_matrix)\n        c.exp1(i, j, theta=th[2], unitary=tc.gates._zz_matrix)\n    return c\n\neven_bonds = [(i,i+1) for i in range(0,n,2)]\nodd_bonds = [(i,i+1) for i in range(1,n-1,2)]\nprint('even', even_bonds, 'odd', odd_bonds)\n\n# initial state |010101010101>\ninit = np.zeros(2**n, dtype=np.complex64)\n# bitstring 010101010101 means qubit0=0, qubit1=1, ...\n# In TC, qubit 0 is usually the leftmost in state indexing? Need to check.\n# Computational basis: state index with binary representation.\n# If qubit 0 is MSB: |010101010101> = int('010101010101', 2)\n# If qubit 0 is LSB: int(reverse)\nbitstr = '010101010101'\nidx_msb = int(bitstr, 2)\nprint('idx', idx_msb)\ninit[idx_msb] = 1.0\ninit = jnp.array(init)\n\n# Pauli expectation helpers\ndef energy_from_state(s):\n    # Use a circuit with inputs for expectation? Or manual.\n    c = tc.Circuit(n, inputs=s)\n    e = 0.0\n    for i in range(n-1):\n        e += c.expectation_ps(x=[i,i+1])\n        e += c.expectation_ps(y=[i,i+1])\n        e += zz_anisotropy * c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e += staggered_field * ((-1)**i) * c.expectation_ps(z=[i])\n    return jnp.real(e)\n\ndef s2_half(state):\n    # trace out qubits 6..11\n    rho = tc.quantum.reduced_density_matrix(state, list(range(subsystem_size, n)))\n    return tc.quantum.renyi_entropy(rho, 2)\n\ndef circuit_forward(params):\n    blocks = unpack(params)\n    c = tc.Circuit(n, inputs=init)\n    ents = []\n    for b in range(n_blocks):\n        ery,erz,eint,ory,orz,oint = blocks[b]\n        apply_sublayer(c, ery, erz, even_bonds, eint)\n        apply_sublayer(c, ory, orz, odd_bonds, oint)\n        st = c.state()\n        ents.append(s2_half(st))\n    st = c.state()\n    e = energy_from_state(st)\n    ents = jnp.stack(ents)\n    return e, ents\n\ndef loss_fn(params):\n    e, ents = circuit_forward(params)\n    mse = jnp.mean((ents - target)**2)\n    loss = e / n + entropy_weight * mse\n    return loss, (e/n, mse, ents)\n\n# test\nkey = jax.random.PRNGKey(0)\nparams = 0.02 * jax.random.normal(key, (n_params,), dtype=jnp.float32)\nt0 = time.time()\nval = loss_fn(params)\nprint('loss', val[0], 'ed', val[1][0], 'mse', val[1][1], 'ents', val[1][2])\nprint('fwd time', time.time()-t0)\n\nt0 = time.time()\n(val, aux), g = jax.value_and_grad(loss_fn, has_aux=True)(params)\nprint('grad time', time.time()-t0, 'grad norm', float(jnp.linalg.norm(g)))\n\n# jit\njitted = jax.jit(jax.value_and_grad(loss_fn, has_aux=True))\nt0 = time.time()\n(val, aux), g = jitted(params)\nval.block_until_ready()\nprint('jit compile+run', time.time()-t0)\n\nt0 = time.time()\n(val, aux), g = jitted(params)\nval.block_until_ready()\nprint('jit run', time.time()-t0)\nprint(val, aux[0], aux[1], aux[2])\nPY\"","aggregated_output":"","exit_code":143,"status":"failed"}}
