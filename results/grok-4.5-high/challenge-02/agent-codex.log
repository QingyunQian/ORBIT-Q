{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport optax\nimport time\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn = 12\nzz_aniso = 1.2\nh_stag = 0.35\nn_blocks = 3\n# params per block: even: 12 ry + 12 rz + 6*3 xx/yy/zz + odd: 12 ry + 12 rz + 5*3 = 24+18+24+15 = 81\nparams_per_block = 81\nn_params = n_blocks * params_per_block\n\n# Hamiltonian terms as Pauli strings for expectation_ps\n# XX, YY, ZZ on bonds + staggered Z\n\ndef energy_from_state_circuit(c):\n    e = 0.0\n    for i in range(n-1):\n        e += c.expectation_ps(x=[i,i+1])\n        e += c.expectation_ps(y=[i,i+1])\n        e += zz_aniso * c.expectation_ps(z=[i,i+1])\n    for i in range(n):\n        e += h_stag * ((-1)**i) * c.expectation_ps(z=[i])\n    return jnp.real(e)\n\nxx = tc.gates._xx_matrix\nyy = tc.gates._yy_matrix\nzz = tc.gates._zz_matrix\n\ndef apply_sublayer(c, params, bonds):\n    # params: (n_qubits*2 + len(bonds)*3,)\n    idx = 0\n    for q in range(n):\n        c.ry(q, theta=params[idx]); idx+=1\n        c.rz(q, theta=params[idx]); idx+=1\n    for (i,j) in bonds:\n        c.exp1(i, j, theta=params[idx], unitary=xx); idx+=1\n        c.exp1(i, j, theta=params[idx], unitary=yy); idx+=1\n        c.exp1(i, j, theta=params[idx], unitary=zz); idx+=1\n    return c\n\neven_bonds = [(i,i+1) for i in range(0,n,2)]\nodd_bonds = [(i,i+1) for i in range(1,n-1,2)]\nprint('even', even_bonds, 'odd', odd_bonds)\neven_n = n*2 + len(even_bonds)*3\nodd_n = n*2 + len(odd_bonds)*3\nprint(even_n, odd_n, even_n+odd_n)\n\ndef circuit_outputs(params):\n    # params shape (243,)\n    params = params.reshape(n_blocks, params_per_block)\n    # initial state |010101010101>\n    c = tc.Circuit(n)\n    for q in range(n):\n        if q % 2 == 1:\n            c.x(q)\n    s2s = []\n    for b in range(n_blocks):\n        p = params[b]\n        c = apply_sublayer(c, p[:even_n], even_bonds)\n        c = apply_sublayer(c, p[even_n:], odd_bonds)\n        # state and renyi\n        psi = c.state()\n        # trace out qubits 6..11\n        rho = tc.quantum.reduced_density_matrix(psi, list(range(6,12)))\n        s2 = tc.quantum.renyi_entropy(rho, k=2)\n        s2s.append(s2)\n    e = energy_from_state_circuit(c)\n    return e, jnp.stack(s2s)\n\n# test\nkey = jax.random.PRNGKey(0)\nparams = 0.02 * jax.random.normal(key, (n_params,), dtype=jnp.float32)\nt0=time.time()\ne,s2 = circuit_outputs(params)\nprint('eager', e, s2, time.time()-t0)\n\nt0=time.time()\njitted = jax.jit(circuit_outputs)\ne,s2 = jitted(params)\ne.block_until_ready(); print('jit1', e, s2, time.time()-t0)\nt0=time.time()\ne,s2 = jitted(params)\ne.block_until_ready(); print('jit2', e, s2, time.time()-t0)\n\ndef loss_fn(params, targets, weight):\n    e, s2 = circuit_outputs(params)\n    mse = jnp.mean((s2 - targets)**2)\n    loss = e/n + weight * mse\n    return loss, (e/n, mse, s2)\n\ntargets = jnp.array([0.3,0.6,0.8], dtype=jnp.float32)\nweight = 0.25\n\nval_and_grad = jax.jit(jax.value_and_grad(lambda p: loss_fn(p, targets, weight)[0], has_aux=False))\n# better with aux\ndef vg(params):\n    (loss, aux), g = jax.value_and_grad(loss_fn, has_aux=True)(params, targets, weight)\n    return (loss, aux), g\nvg = jax.jit(vg)\n\nt0=time.time()\n(loss, aux), g = vg(params)\nloss.block_until_ready()\nprint('grad1', loss, aux[0], time.time()-t0)\nt0=time.time()\n(loss, aux), g = vg(params)\nloss.block_until_ready()\nprint('grad2', loss, aux[0], time.time()-t0)\nprint('grad norm', float(jnp.linalg.norm(g)))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
