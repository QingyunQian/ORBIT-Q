pe('complex64') K = tc.set_backend('jax')  n = 12 n_blocks = 3 zz_anisotropy = 1.2 staggered_field = 0.35 subsystem_size = 6 entropy_weight = 0.25 target = jnp.array([0.30, 0.60, 0.80], dtype=jnp.float32)  # param structure # even: ry[12], rz[12], int[6,3] # odd: ry[12], rz[12], int[5,3] params_per_block = 12+12+6*3 + 12+12+5*3 print('params_per_block', params_per_block) n_params = n_blocks * params_per_block print('n_params', n_params)  def unpack(params):     # params shape (n_blocks, 81)     p = params.reshape(n_blocks, params_per_block)     out = []     for b in range(n_blocks):         pb = p[b]         idx = 0         ery = pb[idx:idx+12]; idx+=12         erz = pb[idx:idx+12]; idx+=12         eint = pb[idx:idx+18].reshape(6,3); idx+=18         ory = pb[idx:idx+12]; idx+=12         orz = pb[idx:idx+12]; idx+=12         oint = pb[idx:idx+15].reshape(5,3); idx+=15         out.append((ery,erz,eint,ory,orz,oint))     return out  def apply_sublayer(c, ry, rz, bonds, ints):     for q in range(n):         c.ry(q, theta=ry[q])         c.rz(q, theta=rz[q])     for bi, (i,j) in enumerate(bonds):         th = ints[bi]         c.exp1(i, j, theta=th[0], unitary=tc.gates._xx_matrix)         c.exp1(i, j, theta=th[1], unitary=tc.gates._yy_matrix)         c.exp1(i, j, theta=th[2], unitary=tc.gates._zz_matrix)     return c  even_bonds = [(i,i+1) for i in range(0,n,2)] odd_bonds = [(i,i+1) for i in range(1,n-1,2)] print('even', even_bonds, 'odd', odd_bonds)  # initial state |010101010101> init = np.zeros(2**n, dtype=np.complex64) # bitstring 010101010101 means qubit0=0, qubit1=1, ... # In TC, qubit 0 is usually the leftmost in state indexing? Need to check. # Computational basis: state index with binary representation. # If qubit 0 is MSB: |010101010101> = int('010101010101', 2) # If qubit 0 is LSB: int(reverse) bitstr = '010101010101' idx_msb = int(bitstr, 2) print('idx', idx_msb) init[idx_msb] = 1.0 init = jnp.array(init)  # Pauli expectation helpers def energy_from_state(s):     # Use a circuit with inputs for expectation? Or manual.     c = tc.Circuit(n, inputs=s)     e = 0.0     for i in range(n-1):         e += c.expectation_ps(x=[i,i+1])         e += c.expectation_ps(y=[i,i+1])         e += zz_anisotropy * c.expectation_ps(z=[i,i+1])     for i in range(n):         e += staggered_field * ((-1)**i) * c.expectation_ps(z=[i])     return jnp.real(e)  def s2_half(state):     # trace out qubits 6..11     rho = tc.quantum.reduced_density_matrix(state, list(range(subsystem_size, n)))     return tc.quantum.renyi_entropy(rho, 2)  def circuit_forward(params):     blocks = unpack(params)     c = tc.Circuit(n, inputs=init)     ents = []     for b in range(n_blocks):         ery,erz,eint,ory,orz,oint = blocks[b]         apply_sublayer(c, ery, erz, even_bonds, eint)         apply_sublayer(c, ory, orz, odd_bonds, oint)         st = c.state()         ents.append(s2_half(st))     st = c.state()     e = energy_from_state(st)     ents = jnp.stack(ents)     return e, ents  def loss_fn(params):     e, ents = circuit_forward(params)     mse = jnp.mean((ents - target)**2)     loss = e / n + entropy_weight * mse     return loss, (e/n, mse, ents)  # test key = jax.random.PRNGKey(0) params = 0.02 * jax.random.normal(key, (n_params,), dtype=jnp.float32) t0 = time.time() val = loss_fn(params) print('loss', val[0], 'ed', val[1][0], 'mse', val[1][1], 'ents', val[1][2]) print('fwd time', time.time()-t0)  t0 = time.time() (val, aux), g = jax.value_and_grad(loss_fn, has_aux=True)(params) print('grad time', time.time()-t0, 'grad norm', float(jnp.linalg.norm(g)))  # jit jitted = jax.jit(jax.value_and_grad(loss_fn, has_aux=True)) t0 = time.time() (val, aux), g = jitted(params) val.block_until_ready() print('jit compile+run', time.time()-t0)  t0 = time.time() (val, aux), g = jitted(params) val.block_until_ready() print('jit run', time.time()-t0) print(val, aux[0], aux[1], aux[2]) PY\nroot         411  110  6.5 4452224 1076308 ?     Sl   17:44   0:19 python -\nroot        