{"type":"item.started","item":{"id":"item_101","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_scan.py << 'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\nimport scipy.sparse as sp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\nprint(\\\"backend\\\", tc.backend.name, flush=True)\n\nn = 12\nn_blocks = 3\nppb = 81\nn_params = n_blocks * ppb\nzz_a = 1.2\nhz = 0.35\nss = 6\nw = 0.25\nmax_steps = 500\nlr = 0.015\ntarget = jnp.array([0.30, 0.60, 0.80], dtype=jnp.float32)\n\nX = sp.csr_matrix(np.array([[0, 1], [1, 0]], dtype=np.complex64))\nY = sp.csr_matrix(np.array([[0, -1j], [1j, 0]], dtype=np.complex64))\nZ = sp.csr_matrix(np.array([[1, 0], [0, -1]], dtype=np.complex64))\nI = sp.eye(2, dtype=np.complex64)\n\ndef kron_n(ops):\n    out = ops[0]\n    for op in ops[1:]:\n        out = sp.kron(out, op, format=\\\"csr\\\")\n    return out\n\nt0 = time.time()\ndim = 2 ** n\nHsp = sp.csr_matrix((dim, dim), dtype=np.complex64)\nfor i in range(n - 1):\n    ops = [I] * n; ops[i] = X; ops[i + 1] = X; Hsp = Hsp + kron_n(ops)\n    ops = [I] * n; ops[i] = Y; ops[i + 1] = Y; Hsp = Hsp + kron_n(ops)\n    ops = [I] * n; ops[i] = Z; ops[i + 1] = Z; Hsp = Hsp + zz_a * kron_n(ops)\nfor i in range(n):\n    ops = [I] * n; ops[i] = Z; Hsp = Hsp + hz * ((-1) ** i) * kron_n(ops)\nH = jnp.asarray(Hsp.toarray())\nprint(\\\"H\\\", time.time() - t0, flush=True)\n\n# init state\nc0 = tc.Circuit(n)\nfor i in range(1, n, 2):\n    c0.x(i)\ninit = c0.state().astype(jnp.complex64)\nprint(\\\"init\\\", int(jnp.argmax(jnp.abs(init))), flush=True)\n\nxxm = jnp.asarray(tc.gates._xx_matrix)\nyym = jnp.asarray(tc.gates._yy_matrix)\nzzm = jnp.asarray(tc.gates._zz_matrix)\neven = [(i, i + 1) for i in range(0, n, 2)]\nodd = [(i, i + 1) for i in range(1, n - 1, 2)]\n\ndef apply_block(state, pb):\n    c = tc.Circuit(n, inputs=state)\n    idx = 0\n    ery = pb[idx:idx+12]; idx += 12\n    erz = pb[idx:idx+12]; idx += 12\n    eint = pb[idx:idx+18].reshape(6, 3); idx += 18\n    ory = pb[idx:idx+12]; idx += 12\n    orz = pb[idx:idx+12]; idx += 12\n    oint = pb[idx:idx+15].reshape(5, 3)\n    for q in range(n):\n        c.ry(q, theta=ery[q])\n        c.rz(q, theta=erz[q])\n    for bi, (i, j) in enumerate(even):\n        c.exp1(i, j, theta=eint[bi, 0], unitary=xxm)\n        c.exp1(i, j, theta=eint[bi, 1], unitary=yym)\n        c.exp1(i, j, theta=eint[bi, 2], unitary=zzm)\n    for q in range(n):\n        c.ry(q, theta=ory[q])\n        c.rz(q, theta=orz[q])\n    for bi, (i, j) in enumerate(odd):\n        c.exp1(i, j, theta=oint[bi, 0], unitary=xxm)\n        c.exp1(i, j, theta=oint[bi, 1], unitary=yym)\n        c.exp1(i, j, theta=oint[bi, 2], unitary=zzm)\n    st = c.state()\n    rho = tc.quantum.reduced_density_matrix(st, list(range(ss, n)))\n    ent = tc.quantum.renyi_entropy(rho, 2)\n    ent = jnp.real(ent).astype(jnp.float32)\n    return st, ent\n\ndef loss_fn(params):\n    p = params.reshape(n_blocks, ppb)\n    def body(state, pb):\n        return apply_block(state, pb)\n    final_state, ents = jax.lax.scan(body, init, p)\n    e = jnp.real(jnp.vdot(final_state, H @ final_state))\n    ed = e / n\n    mse = jnp.mean((ents - target) ** 2)\n    loss = ed + w * mse\n    return loss, (ed, mse, ents)\n\nparams = 0.02 * jax.random.normal(jax.random.PRNGKey(0), (n_params,), dtype=jnp.float32)\n\nt0 = time.time()\nval = loss_fn(params)\nprint(\\\"eager\\\", time.time() - t0, float(val[0]), float(val[1][0]), float(val[1][1]), np.array(val[1][2]), flush=True)\n\nt0 = time.time()\n(val, aux), g = jax.value_and_grad(loss_fn, has_aux=True)(params)\nprint(\\\"grad eager\\\", time.time() - t0, float(val), float(jnp.linalg.norm(g)), flush=True)\n\n# optimizer step with scan\noptimizer = optax.adam(lr)\nopt_state = optimizer.init(params)\n\ndef step_fn(carry, _):\n    params, opt_state = carry\n    (loss, (ed, mse, ents)), grads = jax.value_and_grad(loss_fn, has_aux=True)(params)\n    updates, opt_state = optimizer.update(grads, opt_state, params)\n    params = optax.apply_updates(params, updates)\n    return (params, opt_state), (ed, loss, mse, ents)\n\nprint(\\\"compiling scan train...\\\", flush=True)\nt0 = time.time()\n# compile with small steps first\nrun5 = jax.jit(lambda p, o: jax.lax.scan(step_fn, (p, o), None, length=5))\n(p2, o2), hist = run5(params, opt_state)\njax.block_until_ready(hist[0])\nprint(\\\"compile+5\\\", time.time() - t0, flush=True)\nprint(\\\"hist ed\\\", np.array(hist[0]), flush=True)\n\nt0 = time.time()\n(p2, o2), hist = run5(params, opt_state)\njax.block_until_ready(hist[0])\nprint(\\\"run5\\\", time.time() - t0, flush=True)\n\nprint(\\\"compiling 500...\\\", flush=True)\nrun500 = jax.jit(lambda p, o: jax.lax.scan(step_fn, (p, o), None, length=max_steps))\nt0 = time.time()\n(p2, o2), hist = run500(params, opt_state)\njax.block_until_ready(hist[0])\nprint(\\\"compile+500\\\", time.time() - t0, flush=True)\nprint(\\\"first/last ed\\\", float(hist[0][0]), float(hist[0][-1]), flush=True)\nprint(\\\"first/last loss\\\", float(hist[1][0]), float(hist[1][-1]), flush=True)\nprint(\\\"last ents\\\", np.array(hist[3][-1]), flush=True)\nprint(\\\"DONE\\\", flush=True)\nEOF\npython /tmp/bench_scan.py > /tmp/bench_scan.txt 2>&1 &\necho \"'$! | tee /tmp/bench_scan.pid\nsleep 2\nhead -20 /tmp/bench_scan.txt\nps -p $(cat /tmp/bench_scan.pid) -o etime=,pcpu= || echo dead'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
