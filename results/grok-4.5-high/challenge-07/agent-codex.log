{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\nn_data, n_anc, n = 8, 8, 16\nn_layers, n_traj = 2, 64\nh = 1.05\nseed=2047\nscale=0.1\nlr=0.02\nmax_steps=100\nn_params = n_layers * 6 * n_data\n\nrng = np.random.default_rng(seed)\nparams = jnp.asarray(rng.normal(0.0, scale, size=(n_params,)), dtype=jnp.float32)\nstatus = jnp.asarray(rng.uniform(size=(n_traj, n_layers, n_anc)), dtype=jnp.float32)\n\n# Build Hamiltonian matrix on data qubits, embed in full space as acting on qubits 0..7\n# H = -sum ZZ - h sum X on data\n# Full dim 2\"'^16 = 65536 - matrix is huge 65536''^2. Better apply H|psi> without full matrix.\n\ndef apply_z(psi, q):\n    idx = jnp.arange(psi.shape[0])\n    bit = (idx >> (n - 1 - q)) & 1\n    signs = (1 - 2*bit).astype(psi.dtype)\n    return psi * signs\n\ndef apply_x(psi, q):\n    idx = jnp.arange(psi.shape[0])\n    flip = idx ''^ (1 << (n - 1 - q))\n    return psi[flip]\n\ndef energy_from_psi(psi):\n    # <H> = -sum <ZZ> - h sum <X>\n    e = 0.0\n    # more efficient: 0.5 * ( <psi|H psi> + h.c. ) but H hermitian\n    # compute H|psi>\n    hpsi = jnp.zeros_like(psi)\n    for i in range(n_data-1):\n        hpsi = hpsi - apply_z(apply_z(psi, i), i+1)\n    for i in range(n_data):\n        hpsi = hpsi - h * apply_x(psi, i)\n    return jnp.vdot(psi, hpsi).real\n\ndef circuit_state(params, status_one):\n    p = params.reshape((n_layers, 6, n_data))\n    c = tc.Circuit(n)\n    for layer in range(n_layers):\n        for i in range(n_data):\n            c.ry(i, theta=p[layer, 0, i])\n        for i in range(n_anc):\n            c.ry(n_data + i, theta=p[layer, 1, i])\n        for i in range(n_data):\n            c.rzz(n_data + i, i, theta=p[layer, 2, i])\n        for i in range(n_anc - 1):\n            c.cnot(n_data + i, n_data + i + 1)\n        for i in range(n_anc):\n            m = c.cond_measure(n_data + i, status=status_one[layer, i])\n            g0 = tc.gates.rzz(theta=p[layer, 3, i])\n            g1 = tc.gates.rzz(theta=p[layer, 4, i])\n            c.conditional_gate(m, [g0, g1], n_data + i, i)\n        for i in range(n_data - 1):\n            c.cnot(i, i + 1)\n        for i in range(n_data):\n            c.rz(i, theta=p[layer, 5, i])\n    return c.state()\n\ndef energy_one(params, s):\n    psi = circuit_state(params, s)\n    return energy_from_psi(psi)\n\n@jax.jit\ndef energy_batch(params, status):\n    return jax.vmap(lambda s: energy_one(params, s))(status)\n\n# compare to expectation_ps\ndef energy_one_ps(params, status_one):\n    p = params.reshape((n_layers, 6, n_data))\n    c = tc.Circuit(n)\n    for layer in range(n_layers):\n        for i in range(n_data):\n            c.ry(i, theta=p[layer, 0, i])\n        for i in range(n_anc):\n            c.ry(n_data + i, theta=p[layer, 1, i])\n        for i in range(n_data):\n            c.rzz(n_data + i, i, theta=p[layer, 2, i])\n        for i in range(n_anc - 1):\n            c.cnot(n_data + i, n_data + i + 1)\n        for i in range(n_anc):\n            m = c.cond_measure(n_data + i, status=status_one[layer, i])\n            g0 = tc.gates.rzz(theta=p[layer, 3, i])\n            g1 = tc.gates.rzz(theta=p[layer, 4, i])\n            c.conditional_gate(m, [g0, g1], n_data + i, i)\n        for i in range(n_data - 1):\n            c.cnot(i, i + 1)\n        for i in range(n_data):\n            c.rz(i, theta=p[layer, 5, i])\n    e = 0.0\n    for i in range(n_data - 1):\n        e = e - c.expectation_ps(z=[i, i+1])\n    for i in range(n_data):\n        e = e - h * c.expectation_ps(x=[i])\n    return jnp.real(e)\n\ne1 = energy_one(params, status[0])\ne2 = energy_one_ps(params, status[0])\nprint('\"'compare', float(e1), float(e2))\n\noptimizer = optax.adam(lr)\nopt_state = optimizer.init(params)\n\n@jax.jit\ndef train_step(params, opt_state):\n    def loss_fn(p):\n        return jnp.mean(energy_batch(p, status))\n    loss, grads = jax.value_and_grad(loss_fn)(params)\n    updates, opt_state = optimizer.update(grads, opt_state, params)\n    params = optax.apply_updates(params, updates)\n    return params, opt_state, loss\n\nt0=time.time(); params, opt_state, loss = train_step(params, opt_state); loss.block_until_ready(); print('compile', time.time()-t0, float(loss))\nt0=time.time()\nfor i in range(99):\n    params, opt_state, loss = train_step(params, opt_state)\nloss.block_until_ready()\nprint('99 steps', time.time()-t0, 'final_loss_before_last_update_style', float(loss))\nprint('final avg', float(jnp.mean(energy_batch(params, status))))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
