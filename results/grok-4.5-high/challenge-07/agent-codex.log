{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend('jax')\nK = tc.backend\n\nn_data = 8\nn_anc = 8\nn = 16\nn_layers = 2\nn_traj = 64\nseed = 2047\nh = 1.05\nlr = 0.02\nscale = 0.1\nmax_steps = 100\n\n# parameter layout: [layers, 6, 8] -> data, anc, ent, fb0, fb1, post\nn_params = n_layers * 6 * n_data\n\nkey = jax.random.PRNGKey(seed)\nkey, k1, k2 = jax.random.split(key, 3)\nparams = scale * jax.random.normal(k1, (n_params,))\n# fixed trajectory uniforms: n_traj x n_layers x n_anc\nstatus = jax.random.uniform(k2, (n_traj, n_layers, n_anc))\n\ndef energy_one(params, status_one):\n    # status_one: (n_layers, n_anc)\n    p = params.reshape((n_layers, 6, n_data))\n    c = tc.Circuit(n)\n    for layer in range(n_layers):\n        # data RY\n        for i in range(n_data):\n            c.ry(i, theta=p[layer, 0, i])\n        # anc RY\n        for i in range(n_anc):\n            c.ry(n_data + i, theta=p[layer, 1, i])\n        # entangling RZZ\n        for i in range(n_data):\n            c.rzz(n_data + i, i, theta=p[layer, 2, i])\n        # ancilla CNOT ladder\n        for i in range(n_anc - 1):\n            c.cnot(n_data + i, n_data + i + 1)\n        # measure ancillas and conditional feedback\n        for i in range(n_anc):\n            m = c.cond_measure(n_data + i, status=status_one[layer, i])\n            # conditional RZZ: if m=0 use fb0, if m=1 use fb1\n            g0 = tc.gates.rzz(theta=p[layer, 3, i])\n            g1 = tc.gates.rzz(theta=p[layer, 4, i])\n            c.conditional_gate(m, [g0, g1], n_data + i, i)\n        # data CNOT ladder\n        for i in range(n_data - 1):\n            c.cnot(i, i + 1)\n        # data RZ post\n        for i in range(n_data):\n            c.rz(i, theta=p[layer, 5, i])\n    # Hamiltonian expectation on data qubits\n    e = 0.0\n    for i in range(n_data - 1):\n        e = e - c.expectation_ps(z=[i, i+1])\n    for i in range(n_data):\n        e = e - h * c.expectation_ps(x=[i])\n    return jnp.real(e)\n\nenergy_batch = jax.jit(jax.vmap(energy_one, in_axes=(None, 0)))\n\ndef loss_fn(params):\n    es = energy_batch(params, status)\n    return jnp.mean(es), es\n\n# test one eval\nt0 = time.time()\nval, es = loss_fn(params)\nval.block_until_ready()\nprint('first eval', time.time()-t0, float(val), es.shape)\n\nt0 = time.time()\nval, es = loss_fn(params)\nval.block_until_ready()\nprint('second eval', time.time()-t0, float(val))\nPY\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
