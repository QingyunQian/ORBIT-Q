{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"cat > /root/solution_7.py << 'EOF'\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\n\ndef run_solution(config):\n    n_data = int(config[\\\"n_data_qubits\\\"])\n    n_anc = int(config[\\\"n_ancilla_qubits\\\"])\n    n_qubits = int(config[\\\"n_qubits\\\"])\n    n_layers = int(config[\\\"n_layers\\\"])\n    n_traj = int(config[\\\"n_trajectories\\\"])\n    scale = float(config[\\\"initial_parameter_scale\\\"])\n    max_steps = int(config[\\\"max_steps\\\"])\n    lr = float(config[\\\"learning_rate\\\"])\n    seed = int(config[\\\"seed\\\"])\n    h = jnp.float32(config[\\\"transverse_field\\\"])\n\n    # Parameter blocks per layer: data RY, anc RY, ent RZZ, fb0 RZZ, fb1 RZZ, post RZ\n    n_blocks = 6\n    n_params = n_layers * n_blocks * n_data\n\n    rng = np.random.default_rng(seed)\n    params = jnp.asarray(rng.normal(0.0, scale, size=(n_params,)), dtype=jnp.float32)\n    # Fixed trajectory uniforms for reproducible mid-circuit measurement outcomes.\n    status = jnp.asarray(\n        rng.uniform(size=(n_traj, n_layers, n_anc)), dtype=jnp.float32\n    )\n\n    def energy_one(params, status_one):\n        p = params.reshape((n_layers, n_blocks, n_data))\n        c = tc.Circuit(n_qubits)\n        for layer in range(n_layers):\n            for i in range(n_data):\n                c.ry(i, theta=p[layer, 0, i])\n            for i in range(n_anc):\n                c.ry(n_data + i, theta=p[layer, 1, i])\n            for i in range(n_data):\n                c.rzz(n_data + i, i, theta=p[layer, 2, i])\n            for i in range(n_anc - 1):\n                c.cnot(n_data + i, n_data + i + 1)\n            for i in range(n_anc):\n                m = c.cond_measure(n_data + i, status=status_one[layer, i])\n                g0 = tc.gates.rzz(theta=p[layer, 3, i])\n                g1 = tc.gates.rzz(theta=p[layer, 4, i])\n                c.conditional_gate(m, [g0, g1], n_data + i, i)\n            for i in range(n_data - 1):\n                c.cnot(i, i + 1)\n            for i in range(n_data):\n                c.rz(i, theta=p[layer, 5, i])\n\n        e = 0.0\n        for i in range(n_data - 1):\n            e = e - c.expectation_ps(z=[i, i + 1])\n        for i in range(n_data):\n            e = e - h * c.expectation_ps(x=[i])\n        return jnp.real(e)\n\n    @jax.jit\n    def energy_batch(params, status_batch):\n        return jax.vmap(lambda s: energy_one(params, s))(status_batch)\n\n    @jax.jit\n    def loss_and_grad(params):\n        def loss_fn(p):\n            return jnp.mean(energy_batch(p, status))\n\n        return jax.value_and_grad(loss_fn)(params)\n\n    optimizer = optax.adam(lr)\n    opt_state = optimizer.init(params)\n\n    @jax.jit\n    def train_step(params, opt_state):\n        loss, grads = loss_and_grad(params)\n        updates, opt_state = optimizer.update(grads, opt_state, params)\n        params = optax.apply_updates(params, updates)\n        return params, opt_state, loss\n\n    energy_history = []\n    for _ in range(max_steps):\n        params, opt_state, loss = train_step(params, opt_state)\n        energy_history.append(loss)\n\n    energy_history = jnp.stack(energy_history)\n    final_trajectory_energies = energy_batch(params, status)\n\n    return {\n        \\\"energy_history\\\": np.asarray(energy_history, dtype=np.float64),\n        \\\"final_trajectory_energies\\\": np.asarray(\n            final_trajectory_energies, dtype=np.float64\n        ),\n    }\nEOF\n\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
