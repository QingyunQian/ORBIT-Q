{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import PauliStringSum2COO\nfrom tensorcircuit.timeevol import ode_evol_global\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nn = 14\nn_blocks = 4\nt_min, t_max = 0.05, 0.50\n\ndef build_xy_and_det(n):\n    ls_xy, w_xy = [], []\n    for i in range(n-1):\n        sx = [0]*n; sx[i]=1; sx[i+1]=1\n        sy = [0]*n; sy[i]=2; sy[i+1]=2\n        ls_xy += [sx, sy]; w_xy += [1.0, 1.0]\n    ls_d, w_d = [], []\n    for i in range(n):\n        sz = [0]*n; sz[i]=3\n        ls_d.append(sz); w_d.append(float((-1)**i))\n    return PauliStringSum2COO(ls_xy, weight=w_xy, numpy=False), PauliStringSum2COO(ls_d, weight=w_d, numpy=False)\n\ndef build_target(n):\n    ls, w = [], []\n    for i in range(n-1):\n        for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n            s=[0]*n; s[i]=p; s[i+1]=p\n            ls.append(s); w.append(c)\n    for i in range(n):\n        s=[0]*n; s[i]=3\n        ls.append(s); w.append(0.25*((-1)**i))\n    return PauliStringSum2COO(ls, weight=w, numpy=False)\n\nHxy, Hd = build_xy_and_det(n)\nHt = build_target(n)\n\npsi0 = tc.Circuit(n)\nfor i in range(n):\n    if i % 2 == 1:\n        psi0.x(i)\npsi0 = psi0.state()\n\ndef ham_func(t, J, Delta):\n    return J * Hxy + Delta * Hd\n\ndef one_block(psi, block_params):\n    s_l, j_l, d_l, angles = block_params\n    tl = t_min + (t_max - t_min) * jax.nn.sigmoid(s_l)\n    Jl = jnp.tanh(j_l)\n    Dl = jnp.tanh(d_l)\n    times = jnp.asarray([0.0, tl], dtype=jnp.float32)\n    psi = ode_evol_global(ham_func, psi, times, None, Jl, Dl, rtol=1e-6, atol=1e-6, max_steps=16, ode_backend='jaxode')[-1]\n    c = tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k, theta=angles[k, 0])\n        c.ry(k, theta=angles[k, 1])\n        c.rz(k, theta=angles[k, 2])\n    return c.state(), None\n\ndef loss_fn(params):\n    s, jpar, d, angles = params\n    # stack block params\n    # s: (L,), angles (L,n,3)\n    def f(psi, inputs):\n        return one_block(psi, inputs)\n    # transpose to scan\n    block_in = (s, jpar, d, angles)\n    psi, _ = jax.lax.scan(f, psi0, block_in)\n    return jnp.real(jnp.vdot(psi, Ht @ psi)) / n\n\nkey = jax.random.PRNGKey(0)\nparams = (\n    jnp.zeros((n_blocks,), dtype=jnp.float32),\n    jnp.full((n_blocks,), 0.1, dtype=jnp.float32),\n    jnp.full((n_blocks,), 0.1, dtype=jnp.float32),\n    0.1 * jax.random.normal(key, (n_blocks, n, 3), dtype=jnp.float32),\n)\n\nvag = jax.jit(jax.value_and_grad(loss_fn))\nprint('compile scan...', flush=True)\nt0=time.time()\ne,g = vag(params); g[0].block_until_ready()\nprint('compile', time.time()-t0, 'e', float(e), flush=True)\nt0=time.time()\nfor _ in range(5):\n    e,g=vag(params); g[0].block_until_ready()\nprint('5runs', time.time()-t0, flush=True)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
