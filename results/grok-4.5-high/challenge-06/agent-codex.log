{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import PauliStringSum2COO\nfrom tensorcircuit.timeevol import ode_evol_global\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nn = 6\nn_blocks = 2\nt_min, t_max = 0.05, 0.50\n\n# Pauli codes: 0 I, 1 X, 2 Y, 3 Z\ndef build_xy_and_det(n):\n    ls_xy, w_xy = [], []\n    for i in range(n-1):\n        sx = [0]*n; sx[i]=1; sx[i+1]=1\n        sy = [0]*n; sy[i]=2; sy[i+1]=2\n        ls_xy += [sx, sy]\n        w_xy += [1.0, 1.0]\n    ls_d, w_d = [], []\n    for i in range(n):\n        sz = [0]*n; sz[i]=3\n        ls_d.append(sz)\n        w_d.append(float((-1)**i))\n    Hxy = PauliStringSum2COO(ls_xy, weight=w_xy, numpy=False)\n    Hd = PauliStringSum2COO(ls_d, weight=w_d, numpy=False)\n    return Hxy, Hd\n\ndef build_target(n):\n    ls, w = [], []\n    for i in range(n-1):\n        for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n            s=[0]*n; s[i]=p; s[i+1]=p\n            ls.append(s); w.append(c)\n    for i in range(n):\n        s=[0]*n; s[i]=3\n        ls.append(s); w.append(0.25*((-1)**i))\n    return PauliStringSum2COO(ls, weight=w, numpy=False)\n\nHxy, Hd = build_xy_and_det(n)\nHt = build_target(n)\n\n# Neel |0101...>\nbits = ''.join('1' if i%2 else '0' for i in range(n))  # wait |0101> means q0=0? Usually leftmost is qubit 0\n# |010101...> means qubit0=0, qubit1=1,...\nidx = 0\nfor i in range(n):\n    if i % 2 == 1:\n        idx |= (1 << (n-1-i))  # check endianness\nprint('bits attempt', bits, idx)\n\n# Tensorcircuit uses little-endian usually? Let's check\nc = tc.Circuit(n)\nc.x(1); c.x(3); c.x(5)\npsi = c.state()\nprint('tc neel idx', int(jnp.argmax(jnp.abs(psi))))\n\n# Use TC to build Neel\ndef neel_state(n):\n    c = tc.Circuit(n)\n    for i in range(n):\n        if i % 2 == 1:\n            c.x(i)\n    return c.state()\n\npsi0 = neel_state(n)\nprint('norm', jnp.linalg.norm(psi0))\n\n# energy of neel\ne0 = jnp.real(jnp.vdot(psi0, Ht @ psi0)) / n\nprint('neel energy density', e0)\n\n# Try one block evolution\ndef apply_analog(psi, J, Delta, t, rtol, atol, max_steps):\n    H = J * Hxy + Delta * Hd\n    def ham(time):\n        return H\n    times = jnp.array([0.0, t], dtype=jnp.float32)\n    out = ode_evol_global(ham, psi, times, rtol=rtol, atol=atol, max_steps=max_steps, ode_backend='diffrax')\n    return out[-1]\n\ndef apply_digital(psi, angles):\n    # angles: (n, 3)\n    c = tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k, theta=angles[k,0])\n        c.ry(k, theta=angles[k,1])\n        c.rz(k, theta=angles[k,2])\n    return c.state()\n\nkey = jax.random.PRNGKey(0)\ns = jnp.zeros(n_blocks)\nj = jnp.ones(n_blocks)*0.1\nd = jnp.ones(n_blocks)*0.1\nangles = 0.1*jax.random.normal(key, (n_blocks, n, 3))\n\ndef loss_fn(s, j, d, angles):\n    psi = psi0\n    for l in range(n_blocks):\n        tl = t_min + (t_max-t_min)*jax.nn.sigmoid(s[l])\n        Jl = jnp.tanh(j[l])\n        Dl = jnp.tanh(d[l])\n        psi = apply_analog(psi, Jl, Dl, tl, 1e-6, 1e-6, 16)\n        psi = apply_digital(psi, angles[l])\n    e = jnp.real(jnp.vdot(psi, Ht @ psi)) / n\n    return e\n\nt0 = time.time()\nval = loss_fn(s, j, d, angles)\nprint('loss', val, 'time', time.time()-t0)\n\nt0 = time.time()\ng = jax.grad(loss_fn, argnums=(0,1,2,3))(s,j,d,angles)\nprint('grad shapes', [x.shape for x in g], 'time', time.time()-t0)\n\n# jit\nloss_jit = jax.jit(loss_fn)\ngrad_jit = jax.jit(jax.grad(loss_fn, argnums=(0,1,2,3)))\nt0=time.time(); loss_jit(s,j,d,angles).block_until_ready(); print('jit loss compile', time.time()-t0)\nt0=time.time(); loss_jit(s,j,d,angles).block_until_ready(); print('jit loss run', time.time()-t0)\nt0=time.time(); grad_jit(s,j,d,angles)[0].block_until_ready(); print('jit grad compile', time.time()-t0)\nt0=time.time(); grad_jit(s,j,d,angles)[0].block_until_ready(); print('jit grad run', time.time()-t0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
