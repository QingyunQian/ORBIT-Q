{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport numpy as np\nimport scipy.sparse.linalg as sla\nfrom tensorcircuit.quantum import PauliStringSum2COO\nimport solution_6\n\nconfig = {\n    \\\"n_qubits\\\": 14,\n    \\\"n_blocks\\\": 4,\n    \\\"t_min\\\": 0.05,\n    \\\"t_max\\\": 0.50,\n    \\\"ode_rtol\\\": 1e-6,\n    \\\"ode_atol\\\": 1e-6,\n    \\\"ode_max_steps\\\": 16,\n    \\\"max_steps\\\": 100,\n    \\\"learning_rate\\\": 0.12,\n}\n\nn = config[\\\"n_qubits\\\"]\nls, w = [], []\nfor i in range(n-1):\n    for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n        s=[0]*n; s[i]=p; s[i+1]=p\n        ls.append(s); w.append(c)\nfor i in range(n):\n    s=[0]*n; s[i]=3\n    ls.append(s); w.append(0.25*((-1)**i))\nH = PauliStringSum2COO(ls, weight=w, numpy=True)\ngs = sla.eigsh(H, k=1, which='SA', return_eigenvectors=False)[0] / n\nprint('exact gs density', gs)\n\nt0 = time.time()\nresults = solution_6.run_solution(config)\nelapsed = time.time() - t0\nprint('runtime', elapsed)\n\nhist = results['energy_density_history']\nprint('len', len(hist))\nprint('init', hist[0], 'final', hist[-1])\nprint('times', results['final_analog_times'])\nprint('J', results['final_analog_couplings'])\nprint('D', results['final_analog_detunings'])\n\nchecks = []\nchecks.append(('len', len(hist)==100))\nchecks.append(('times shape', results['final_analog_times'].shape==(4,)))\nchecks.append(('times range', np.all((results['final_analog_times']>0.05)&(results['final_analog_times']<0.5))))\nchecks.append(('J range', np.all(np.abs(results['final_analog_couplings'])<1)))\nchecks.append(('D range', np.all(np.abs(results['final_analog_detunings'])<1)))\nchecks.append(('improved', hist[-1] < hist[0]))\nchecks.append(('above gs', hist[-1] >= gs - 1e-6))\nchecks.append(('within 1', hist[-1] <= gs + 1.0))\nfor name, ok in checks:\n    print(name, ok)\nprint('ALL', all(c[1] for c in checks))\nEOF\"","aggregated_output":"","