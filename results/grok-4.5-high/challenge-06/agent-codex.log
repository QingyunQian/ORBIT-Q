{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import PauliStringSum2COO\nfrom tensorcircuit.timeevol import ode_evol_global\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nn = 14\nn_blocks = 4\nt_min, t_max = 0.05, 0.50\n\ndef build_xy_and_det(n):\n    ls_xy, w_xy = [], []\n    for i in range(n-1):\n        sx = [0]*n; sx[i]=1; sx[i+1]=1\n        sy = [0]*n; sy[i]=2; sy[i+1]=2\n        ls_xy += [sx, sy]\n        w_xy += [1.0, 1.0]\n    ls_d, w_d = [], []\n    for i in range(n):\n        sz = [0]*n; sz[i]=3\n        ls_d.append(sz)\n        w_d.append(float((-1)**i))\n    return PauliStringSum2COO(ls_xy, weight=w_xy, numpy=False), PauliStringSum2COO(ls_d, weight=w_d, numpy=False)\n\ndef build_target(n):\n    ls, w = [], []\n    for i in range(n-1):\n        for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n            s=[0]*n; s[i]=p; s[i+1]=p\n            ls.append(s); w.append(c)\n    for i in range(n):\n        s=[0]*n; s[i]=3\n        ls.append(s); w.append(0.25*((-1)**i))\n    return PauliStringSum2COO(ls, weight=w, numpy=False)\n\nHxy, Hd = build_xy_and_det(n)\nHt = build_target(n)\n\ndef neel_state(n):\n    c = tc.Circuit(n)\n    for i in range(n):\n        if i % 2 == 1:\n            c.x(i)\n    return c.state()\n\npsi0 = neel_state(n)\n\ndef apply_analog(psi, J, Delta, t):\n    H = J * Hxy + Delta * Hd\n    def ham(time):\n        return H\n    times = jnp.array([0.0, t], dtype=jnp.float32)\n    # jaxode default\n    out = ode_evol_global(ham, psi, times, rtol=1e-6, atol=1e-6, max_steps=16, ode_backend='jaxode')\n    return out[-1]\n\ndef apply_digital(psi, angles):\n    c = tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k, theta=angles[k,0])\n        c.ry(k, theta=angles[k,1])\n        c.rz(k, theta=angles[k,2])\n    return c.state()\n\nkey = jax.random.PRNGKey(42)\ns = jnp.zeros(n_blocks, dtype=jnp.float32)\njpar = jnp.ones(n_blocks, dtype=jnp.float32)*0.1\nd = jnp.ones(n_blocks, dtype=jnp.float32)*0.1\nangles = 0.1*jax.random.normal(key, (n_blocks, n, 3), dtype=jnp.float32)\n\ndef loss_fn(s, jpar, d, angles):\n    psi = psi0\n    for l in range(n_blocks):\n        tl = t_min + (t_max-t_min)*jax.nn.sigmoid(s[l])\n        Jl = jnp.tanh(jpar[l])\n        Dl = jnp.tanh(d[l])\n        psi = apply_analog(psi, Jl, Dl, tl)\n        psi = apply_digital(psi, angles[l])\n    e = jnp.real(jnp.vdot(psi, Ht @ psi)) / n\n    return e\n\nloss_and_grad = jax.jit(jax.value_and_grad(loss_fn, argnums=(0,1,2,3)))\nprint('compiling jaxode...', flush=True)\nt0=time.time()\nval, g = loss_and_grad(s,jpar,d,angles)\ng[0].block_until_ready()\nprint('compile+run', time.time()-t0, 'loss', float(val), flush=True)\nt0=time.time()\nfor i in range(5):\n    val, g = loss_and_grad(s,jpar,d,angles)\n    g[0].block_until_ready()\nprint('5 runs', time.time()-t0, 'per', (time.time()-t0)/5, flush=True)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
