ndom.PRNGKey(42)\ns = jnp.zeros(n_blocks, dtype=jnp.float32)\njpar = jnp.ones(n_blocks, dtype=jnp.float32)*0.1\nd = jnp.ones(n_blocks, dtype=jnp.float32)*0.1\nangles = 0.1*jax.random.normal(key, (n_blocks, n, 3), dtype=jnp.float32)\n\ndef loss_fn(s, jpar, d, angles):\n    psi = psi0\n    for l in range(n_blocks):\n        tl = t_min + (t_max-t_min)*jax.nn.sigmoid(s[l])\n        Jl = jnp.tanh(jpar[l])\n        Dl = jnp.tanh(d[l])\n        psi = apply_analog(psi, Jl, Dl, tl)\n        psi = apply_digital(psi, angles[l])\n    e = jnp.real(jnp.vdot(psi, Ht @ psi)) / n\n    return e\n\nt0=time.time(); print('eager', float(loss_fn(s,jpar,d,angles)), time.time()-t0, flush=True)\n\nloss_and_grad = jax.jit(jax.value_and_grad(loss_fn, argnums=(0,1,2,3)))\nprint('compiling jaxode...', flush=True)\nt0=time.time()\nval, g = loss_and_grad(s,jpar,d,angles)\ng[0].block_until_ready()\nprint('compile+run', time.time()-t0, 'loss', float(val), flush=True)\nt0=time.time()\nfor i in range(5):\n    val, g = loss_and_grad(s,jpar,d,angles)\n    g[0].block_until_ready()\nprint('5 runs', time.time()-t0, 'per', (time.time()-t0)/5, flush=True)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
