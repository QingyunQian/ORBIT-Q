{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python << 'EOF'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport optax\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import PauliStringSum2COO\nfrom tensorcircuit.timeevol import ode_evol_global\nimport scipy.sparse.linalg as sla\nimport scipy.sparse as sp\n\ntc.set_backend(\\\"jax\\\")\ntc.set_dtype(\\\"complex64\\\")\n\nconfig = {\n    \\\"n_qubits\\\": 14,\n    \\\"n_blocks\\\": 4,\n    \\\"t_min\\\": 0.05,\n    \\\"t_max\\\": 0.50,\n    \\\"ode_rtol\\\": 1e-6,\n    \\\"ode_atol\\\": 1e-6,\n    \\\"ode_max_steps\\\": 16,\n    \\\"max_steps\\\": 100,\n    \\\"learning_rate\\\": 0.12,\n}\n\nn = config[\\\"n_qubits\\\"]\nn_blocks = config[\\\"n_blocks\\\"]\nt_min = config[\\\"t_min\\\"]\nt_max = config[\\\"t_max\\\"]\nrtol = config[\\\"ode_rtol\\\"]\natol = config[\\\"ode_atol\\\"]\nmax_steps_ode = config[\\\"ode_max_steps\\\"]\nmax_steps = config[\\\"max_steps\\\"]\nlr = config[\\\"learning_rate\\\"]\n\ndef build_xy_and_det(n):\n    ls_xy, w_xy = [], []\n    for i in range(n-1):\n        sx = [0]*n; sx[i]=1; sx[i+1]=1\n        sy = [0]*n; sy[i]=2; sy[i+1]=2\n        ls_xy += [sx, sy]\n        w_xy += [1.0, 1.0]\n    ls_d, w_d = [], []\n    for i in range(n):\n        sz = [0]*n; sz[i]=3\n        ls_d.append(sz)\n        w_d.append(float((-1)**i))\n    return (\n        PauliStringSum2COO(ls_xy, weight=w_xy, numpy=False),\n        PauliStringSum2COO(ls_d, weight=w_d, numpy=False),\n    )\n\ndef build_target(n):\n    ls, w = [], []\n    for i in range(n-1):\n        for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n            s=[0]*n; s[i]=p; s[i+1]=p\n            ls.append(s); w.append(c)\n    for i in range(n):\n        s=[0]*n; s[i]=3\n        ls.append(s); w.append(0.25*((-1)**i))\n    return PauliStringSum2COO(ls, weight=w, numpy=False)\n\nHxy, Hd = build_xy_and_det(n)\nHt = build_target(n)\n\n# exact GS via numpy sparse\nHt_np = PauliStringSum2COO(\n    [[([0]*n)[j] for j in range(n)] for _ in [0]], weight=[0.0], numpy=True\n)\n# rebuild with numpy\nls, w = [], []\nfor i in range(n-1):\n    for p, c in [(1,0.7),(2,0.7),(3,1.1)]:\n        s=[0]*n; s[i]=p; s[i+1]=p\n        ls.append(s); w.append(c)\nfor i in range(n):\n    s=[0]*n; s[i]=3\n    ls.append(s); w.append(0.25*((-1)**i))\nfrom tensorcircuit.quantum import PauliStringSum2COO_numpy\nHtn = PauliStringSum2COO(ls, weight=w, numpy=True)\nprint(type(Htn), Htn.shape)\nevals = sla.eigsh(Htn, k=1, which='SA', return_eigenvectors=False)\nprint('GS energy density', evals[0]/n, flush=True)\n\ndef neel_state(n):\n    c = tc.Circuit(n)\n    for i in range(n):\n        if i % 2 == 1:\n            c.x(i)\n    return c.state()\n\npsi0 = neel_state(n)\n\ndef ham_func(t, J, Delta):\n    return J * Hxy + Delta * Hd\n\ndef apply_analog(psi, J, Delta, t):\n    times = jnp.asarray([0.0, t], dtype=jnp.float32)\n    out = ode_evol_global(\n        ham_func, psi, times, None, J, Delta,\n        rtol=rtol, atol=atol, max_steps=max_steps_ode, ode_backend='jaxode'\n    )\n    return out[-1]\n\ndef apply_digital(psi, angles):\n    c = tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k, theta=angles[k, 0])\n        c.ry(k, theta=angles[k, 1])\n        c.rz(k, theta=angles[k, 2])\n    return c.state()\n\ndef loss_fn(params):\n    s, jpar, d, angles = params\n    psi = psi0\n    for l in range(n_blocks):\n        tl = t_min + (t_max - t_min) * jax.nn.sigmoid(s[l])\n        Jl = jnp.tanh(jpar[l])\n        Dl = jnp.tanh(d[l])\n        psi = apply_analog(psi, Jl, Dl, tl)\n        psi = apply_digital(psi, angles[l])\n    return jnp.real(jnp.vdot(psi, Ht @ psi)) / n\n\nkey = jax.random.PRNGKey(0)\nparams = (\n    jnp.zeros((n_blocks,), dtype=jnp.float32),\n    jnp.full((n_blocks,), 0.1, dtype=jnp.float32),\n    jnp.full((n_blocks,), 0.1, dtype=jnp.float32),\n    0.1 * jax.random.normal(key, (n_blocks, n, 3), dtype=jnp.float32),\n)\n\noptimizer = optax.adam(lr)\nopt_state = optimizer.init(params)\nvag = jax.jit(jax.value_and_grad(loss_fn))\n\nprint('compile...', flush=True)\nt0 = time.time()\ne, g = vag(params); g[0].block_until_ready()\nprint('compiled', time.time()-t0, 'e0', float(e), flush=True)\n\nhist = []\nt_train = time.time()\nfor step in range(max_steps):\n    e, g = vag(params)\n    hist.append(float(e))\n    updates, opt_state = optimizer.update(g, opt_state, params)\n    params = optax.apply_updates(params, updates)\n    if step % 10 == 0 or step == max_steps-1:\n        print(step, hist[-1], flush=True)\nprint('train time', time.time()-t_train, flush=True)\n\ns, jpar, d, angles = params\ntimes = t_min + (t_max - t_min) * jax.nn.sigmoid(s)\ncoups = jnp.tanh(jpar)\ndets = jnp.tanh(d)\nprint('times', np.array(times))\nprint('J', np.array(coups))\nprint('D', np.array(dets))\nprint('final', hist[-1], 'init', hist[0], 'gs', evals[0]/n)\nprint('improved', hist[-1] < hist[0])\nprint('above gs', hist[-1] >= evals[0]/n - 1e-6)\nprint('within 1.0', hist[-1] <= evals[0]/n + 1.0)\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
