{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, time\nrng=np.random.default_rng(0); chi=128\nA=rng.normal(size=(chi,chi,chi))+1j*rng.normal(size=(chi,chi,chi))\nB0=rng.normal(size=(chi,chi))+1j*rng.normal(size=(chi,chi)); B=B0.conj().T@B0\nv=rng.normal(size=chi)+1j*rng.normal(size=chi)\nfor opt in [False, True]:\n t=time.time(); C=np.einsum('xud,de,xpe->xup', A.conj(), B, A, optimize=opt); tc=time.time()-t\n t=time.time(); P=np.einsum('u,xup,p->x', v.conj(), C, v, optimize=opt); tp=time.time()-t\n print(opt,'C',tc,'P',tp,'total',tc+tp)\n# verify P with direct method\nW=np.tensordot(A,v,axes=(1,0))\nP2=np.einsum('xd,de,xe->x',W.conj(),B,W,optimize=False)\nP=np.einsum('u,xup,p->x', v.conj(), C, v, optimize=False)\nprint('maxdiff',np.max(np.abs(P-P2)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
