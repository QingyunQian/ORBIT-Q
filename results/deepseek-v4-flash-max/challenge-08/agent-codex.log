{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_mps_col.py <<'PY'\nimport tensorcircuit as tc, numpy as np, time\ntc.set_backend('numpy')\nside=7; n=49\nc=tc.MPSCircuit(n)\nfor r in range(side):\n for cc in range(side):\n  q=cc*side+r\n  c.apply_single_gate(tc.gates.ry(theta=0.19+0.07*np.sin(0.83*(r+1))+0.05*np.cos(0.61*(cc+1))+0.03*np.sin(0.29*(r+cc+2))), q)\n# horizontal RZZ: between col cc and cc+1 same row r, distance side\nfor r in range(side):\n for cc in range(side-1):\n  c.apply_double_gate(tc.gates.rzz(theta=0.3), cc*side+r, (cc+1)*side+r)\n# vertical RXX adjacent in column-major\nfor cc in range(side):\n for r in range(side-1):\n  c.apply_double_gate(tc.gates.rxx(theta=0.3), cc*side+r, cc*side+r+1)\nfor r in range(side):\n for cc in range(side):\n  q=cc*side+r\n  c.apply_single_gate(tc.gates.rx(theta=0.17), q)\nprint('bonds', c.get_bond_dimensions())\nprint('max', max(c.get_bond_dimensions()))\nPY\ntimeout 120 python /tmp/test_mps_col.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
