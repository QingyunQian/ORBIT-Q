{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_rtsample.py <<'PY'\nimport tensorcircuit as tc, numpy as np, time\ntc.set_backend('numpy')\nside=7; n=49\nc=tc.MPSCircuit(n)\n# simple random-ish gates same as earlier\nfor i in range(n): c.apply_single_gate(tc.gates.ry(theta=0.2), i)\nfor i in range(n-1): c.apply_double_gate(tc.gates.rzz(theta=0.2), i, i+1)\nfor i in range(n-side): c.apply_double_gate(tc.gates.rxx(theta=0.2), i, i+side)\nfor i in range(n): c.apply_single_gate(tc.gates.rx(theta=0.2), i)\nprint('max bond',max(c.get_bond_dimensions()), flush=True)\nt=time.time(); c.position(0); print('position0',time.time()-t, flush=True)\nTs=c.get_tensors()\nprint('tensor shapes', [t.shape for t in Ts[:10]], flush=True)\n\ndef sample_one(Ts, rng):\n    v=np.array([1.0+0j])\n    bits=np.empty(len(Ts),dtype=np.int8)\n    for i,T in enumerate(Ts):\n        ws=[]\n        for x in range(2):\n            w=np.einsum('a,abx?->?', v, T[:,x,:], optimize=False) if False else np.tensordot(v, T[:,x,:], axes=(0,0))\n            ws.append(w)\n        p=np.array([np.vdot(w,w).real for w in ws])\n        p/=p.sum()\n        x=rng.choice(2,p=p)\n        bits[i]=x\n        v=ws[x]/np.sqrt(p[x])\n    return bits\n\nrng=np.random.default_rng(1)\nt=time.time(); s=sample_one(Ts,rng); print('sample1',time.time()-t, s[:10], flush=True)\nt=time.time()\nfor k in range(20):\n    sample_one(Ts,rng)\nprint('20 samples',time.time()-t, flush=True)\nPY\ntimeout 120 python /tmp/test_rtsample.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
