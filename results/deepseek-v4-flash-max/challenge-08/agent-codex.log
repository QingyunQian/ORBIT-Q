{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_tn.py <<'PY'\nimport tensorcircuit as tc, numpy as np, time\ntc.set_backend('numpy')\n\ndef angles(side):\n    alpha=np.zeros((side,side)); gamma=np.zeros((side,side))\n    for r in range(side):\n      for c in range(side):\n        alpha[r,c]=0.19+0.07*np.sin(0.83*(r+1))+0.05*np.cos(0.61*(c+1))+0.03*np.sin(0.29*(r+c+2))\n        gamma[r,c]=0.17+0.06*np.cos(0.52*(r+1))-0.04*np.sin(0.44*(c+1))+0.02*np.cos(0.25*(r+c+2))\n    bh=np.zeros((side,side-1)); bv=np.zeros((side-1,side))\n    kh=0\n    for r in range(side):\n      for c in range(side-1):\n        kh+=1; bh[r,c]=0.31+0.09*np.sin(0.47*(kh+1))+0.06*np.cos(0.38*(2*r+c+1))\n    kv=0\n    for r in range(side-1):\n      for c in range(side):\n        kv+=1; bv[r,c]=0.27+0.08*np.cos(0.41*(kv+1))+0.07*np.sin(0.33*(r+2*c+1))\n    return alpha,gamma,bh,bv\n\ndef make_circuit(side, alpha,gamma,bh,bv):\n    c=tc.Circuit(side*side)\n    for r in range(side):\n      for cc in range(side):\n        c.ry(r*side+cc, theta=alpha[r,cc])\n    for r in range(side):\n      for cc in range(side-1):\n        c.rzz(r*side+cc, r*side+cc+1, theta=bh[r,cc])\n    for r in range(side-1):\n      for cc in range(side):\n        c.rxx(r*side+cc, (r+1)*side+cc, theta=bv[r,cc])\n    for r in range(side):\n      for cc in range(side):\n        c.rx(r*side+cc, theta=gamma[r,cc])\n    return c\n\nfor side in [3]:\n    alpha,gamma,bh,bv=angles(side)\n    c=make_circuit(side,alpha,gamma,bh,bv)\n    qv=c.get_quvector()\n    print('qv edges',len(qv.out_edges))\n    t=time.time()\n    rho=qv.projector().partial_trace(subsystem_to_keep=list(range(side)))\n    print('partial trace built',time.time()-t)\n    t=time.time()\n    m=rho.eval()\n    print('eval time',time.time()-t,'shape',np.shape(m))\n    diag=np.real(np.diag(m))\n    print('prob',diag[:8], 'sum',diag.sum())\n    # statevector compare\n    t=time.time()\n    st=c.state()\n    sv=np.abs(st.reshape((2,)*9))**2\n    # marginal first row\n    p0=sv.sum(axis=tuple(range(1,9))).reshape(2**side)\n    print('state time',time.time()-t)\n    print('maxdiff',np.max(np.abs(p0-diag)))\nPY\npython /tmp/test_tn.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
