{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_rtsample_small.py <<'PY'\nimport tensorcircuit as tc, numpy as np, time\ntc.set_backend('numpy')\nrng=np.random.default_rng(0)\nfor n in [2,3,4]:\n    c=tc.MPSCircuit(n)\n    for i in range(n): c.apply_single_gate(tc.gates.ry(theta=rng.uniform(0,1)), i)\n    # random adjacent gates\n    for i in range(n-1): c.apply_double_gate(tc.gates.rzz(theta=rng.uniform(0,1)), i, i+1)\n    c.position(0)\n    Ts=c.get_tensors()\n    # exact state\n    st=c.wavefunction()\n    probs=np.abs(st.reshape(-1))**2\n    # empirical\n    N=20000\n    samples=np.empty((N,n),dtype=np.int8)\n    for k in range(N):\n        v=np.array([1.0+0j])\n        bits=np.empty(n,dtype=np.int8)\n        for i,T in enumerate(Ts):\n            ws=[np.tensordot(v,T[:,x,:],axes=(0,0)) for x in (0,1)]\n            p=np.array([np.vdot(w,w).real for w in ws]); p/=p.sum()\n            x=rng.choice(2,p=p)\n            bits[i]=x; v=ws[x]/np.sqrt(p[x])\n        samples[k]=bits\n    emp=np.zeros(2**n)\n    idx=np.zeros(n,dtype=np.int32)\n    for k in range(N):\n        bits=samples[k]\n        idx[:]=bits[::-1]\n        # compute integer little? just bitstring order from qubit0 as high? use simple\n        ii=sum(int(b)<<(n-1-i) for i,b in enumerate(bits))\n        emp[ii]+=1\n    emp/=N\n    print('n',n,'max err',np.max(np.abs(emp-probs)),'probs',probs[:8])\nPY\ntimeout 60 python /tmp/test_rtsample_small.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
