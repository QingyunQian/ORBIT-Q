{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_measure_full.py <<'PY'\nimport tensorcircuit as tc, jax, time, numpy as np\ntc.set_backend('jax')\nn=8\ninit=np.zeros(2**16, dtype=np.complex64); init[0]=1.0\ninit_t=tc.array_to_tensor(init)\n\ndef energy_circuit(params, status):\n    c=tc.Circuit(16, inputs=init_t)\n    for layer in range(2):\n        for i in range(n):\n            c.ry(i, theta=params[layer,0,i])\n        for i in range(n):\n            c.ry(8+i, theta=params[layer,1,i])\n        for i in range(n):\n            c.rzz(8+i, i, theta=params[layer,2,i])\n        for j in range(n-1):\n            c.cnot(8+j, 9+j)\n        bits, p = c.measure_jit(*range(8,16), status=status[layer])\n        for i in range(n):\n            m=tc.backend.cast(bits[i],'int32')\n            proj=tc.backend.reshape(tc.backend.stack([1-m,0,0,m]), (2,2))\n            c.any(8+i, unitary=proj, name='post')\n        st=c.wavefunction()\n        nrm=tc.backend.sqrt(tc.backend.sum(tc.backend.abs(st)**2))\n        c.replace_inputs(st/nrm)\n        for i in range(n):\n            m=tc.backend.cast(bits[i],'int32')\n            ang=tc.backend.where(m==0, params[layer,3,i], params[layer,4,i])\n            c.rzz(8+i, i, theta=ang)\n        for j in range(n-1):\n            c.cnot(j, j+1)\n        for i in range(n):\n            c.rz(i, theta=params[layer,5,i])\n    e = 0.0\n    for i in range(n-1):\n        e += -c.expectation([tc.gates.z(),[i]],[tc.gates.z(),[i+1]])\n    for i in range(n):\n        e += -1.05*c.expectation([tc.gates.x(),[i]])\n    return tc.backend.real(e)\n\nf = jax.vmap(energy_circuit, in_axes=(None,0))\ndef obj(params,status):\n    return tc.backend.mean(f(params,status))\nobjg = jax.jit(jax.value_and_grad(obj))\nrng=np.random.default_rng(0)\nparams=tc.array_to_tensor(rng.normal(size=(2,6,8))*0.1)\nstatus=tc.array_to_tensor(rng.random(size=(64,2,8)))\nt=time.time(); v,g=objg(params,status); print('compile val',v,'time',time.time()-t)\nfor k in range(3):\n    t=time.time(); v,g=objg(params,status); print('step',k,float(v),time.time()-t)\nPY\ntimeout 300 python /tmp/test_measure_full.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
