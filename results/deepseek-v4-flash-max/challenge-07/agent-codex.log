{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_cond_vmap.py <<'PY'\nimport tensorcircuit as tc, jax, time, numpy as np\ntc.set_backend('jax')\nn=8\ndef energy_circuit(params, status):\n    c=tc.Circuit(16)\n    for layer in range(2):\n        for i in range(n):\n            c.ry(i, theta=params[layer,0,i])\n        for i in range(n):\n            c.ry(8+i, theta=params[layer,1,i])\n        for i in range(n):\n            c.rzz(8+i, i, theta=params[layer,2,i])\n        for j in range(n-1):\n            c.cnot(8+j, 9+j)\n        ms=[]\n        for i in range(n):\n            ms.append(c.cond_measurement(8+i, status=status[layer,i]))\n        for i in range(n):\n            m=ms[i]\n            ang=tc.backend.where(m==0, params[layer,3,i], params[layer,4,i])\n            c.rzz(8+i, i, theta=ang)\n        for j in range(n-1):\n            c.cnot(j, j+1)\n        for i in range(n):\n            c.rz(i, theta=params[layer,5,i])\n    e = 0.0\n    for i in range(n-1):\n        e += -c.expectation([tc.gates.z(),[i]],[tc.gates.z(),[i+1]])\n    for i in range(n):\n        e += -1.05*c.expectation([tc.gates.x(),[i]])\n    return tc.backend.real(e)\n\nf = jax.vmap(energy_circuit, in_axes=(None,0))\ndef obj(params,status):\n    return tc.backend.mean(f(params,status))\nobjg = jax.jit(jax.value_and_grad(obj))\n\nrng=np.random.default_rng(0)\nparams=tc.array_to_tensor(rng.normal(size=(2,6,8))*0.1)\nfor B in [4,16,64]:\n    status=tc.array_to_tensor(rng.random(size=(B,2,8)))\n    t=time.time(); v,g=objg(params,status); print('B',B,'v',v,'gradnorm',jax.numpy.linalg.norm(g),'time',time.time()-t)\nPY\ntimeout 300 python /tmp/test_cond_vmap.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
