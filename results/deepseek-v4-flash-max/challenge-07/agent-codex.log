{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_cond_full.py <<'PY'\nimport tensorcircuit as tc, jax, time, numpy as np\ntc.set_backend('jax')\nn=8\ndef energy_circuit(params, status):\n    c=tc.Circuit(16)\n    for layer in range(2):\n        off=layer\n        for i in range(n):\n            c.ry(i, theta=params[off,0,i])\n        for i in range(n):\n            c.ry(8+i, theta=params[off,1,i])\n        for i in range(n):\n            c.rzz(8+i, i, theta=params[off,2,i])\n        for j in range(n-1):\n            c.cnot(8+j, 9+j)\n        ms=[]\n        for i in range(n):\n            m=c.cond_measurement(8+i, status=status[layer,i])\n            ms.append(m)\n        for i in range(n):\n            m=ms[i]\n            ang=tc.backend.where(m==0, params[off,3,i], params[off,4,i])\n            c.rzz(8+i, i, theta=ang)\n        for j in range(n-1):\n            c.cnot(j, j+1)\n        for i in range(n):\n            c.rz(i, theta=params[off,5,i])\n    e = 0.0\n    for i in range(n-1):\n        e += -c.expectation([tc.gates.z(),[i]],[tc.gates.z(),[i+1]])\n    for i in range(n):\n        e += -1.05*c.expectation([tc.gates.x(),[i]])\n    return tc.backend.real(e)\n\nrng=np.random.default_rng(0)\nparams=tc.array_to_tensor(rng.normal(size=(2,6,8))*0.1)\nstatus=tc.array_to_tensor(rng.random(size=(2,8)))\nt=time.time(); v=jax.jit(energy_circuit)(params,status); print('val',v,'time',time.time()-t)\nPY\ntimeout 240 python /tmp/test_cond_full.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
