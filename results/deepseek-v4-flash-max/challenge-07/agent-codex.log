{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_mid.py <<'PY'\nimport tensorcircuit as tc, jax, time, numpy as np\ntc.set_backend('jax')\nprint('backend', tc.cons.get_default_backend())\n\ndef f(theta, status):\n    c=tc.Circuit(2)\n    c.ry(0, theta=theta)\n    bits, p = c.measure_jit(0, status=status)\n    m = tc.backend.cast(bits[0], 'int32')\n    c.mid_measurement(0, keep=m)\n    # feedback based on m: angle = where(m, 1.0, 0.5)\n    ang = tc.backend.where(m==0, 0.5, 1.0)\n    c.rz(1, theta=ang)\n    e = c.expectation([tc.gates.z(),[0]]) + c.expectation([tc.gates.z(),[1]])\n    return tc.backend.real(e)\n\nst=tc.array_to_tensor([0.2])\nt=time.time(); print('jit1', jax.jit(f)(0.1, st), time.time()-t)\nt=time.time(); print('jit2', jax.jit(f)(0.1, st), time.time()-t)\n# vmap statuses\nstb=tc.array_to_tensor([0.2,0.8])\nfvm=jax.vmap(f, in_axes=(None,0))\nt=time.time(); print('vmap', fvm(0.1, stb), time.time()-t)\n# grad batched? maybe\ndef loss(theta,status):\n    return tc.backend.sum(jax.vmap(f, in_axes=(None,0))(theta,status))\nt=time.time(); g=jax.jit(jax.grad(lambda th,s: loss(th,s)))(0.1, stb)\nprint('grad',g, time.time()-t)\nPY\npython /tmp/test_mid.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
