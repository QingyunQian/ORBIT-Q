{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_compare.py <<'PY'\nimport numpy as np, tensorcircuit as tc, jax, time\ntc.set_backend('jax')\nn=8; dim=2**n\ndef pauli(p,i):\n    mats={'x':np.array([[0,1],[1,0]],dtype=np.complex64),'z':np.array([[1,0],[0,-1]],dtype=np.complex64)}\n    op=[np.eye(2,dtype=np.complex64)]*n; op[i]=mats[p]\n    r=op[0]\n    for m in op[1:]: r=np.kron(r,m)\n    return r\nH=np.zeros((dim,dim),dtype=np.complex64)\nfor i in range(n-1): H += -pauli('z',i)@pauli('z',i+1)\nfor i in range(n): H += -1.05*pauli('x',i)\nG=tc.gates.Gate(H.reshape([2]*n+[2]*n))\ninit=np.zeros(2**16,dtype=np.complex64); init[0]=1.; init_t=tc.array_to_tensor(init)\n\ndef common_gates(c,p,bits):\n    for layer in range(2):\n        for i in range(n): c.ry(i, theta=p[layer,0,i])\n        for i in range(n): c.ry(8+i, theta=p[layer,1,i])\n        for i in range(n): c.rzz(8+i, i, theta=p[layer,2,i])\n        for j in range(n-1): c.cnot(8+j,9+j)\n        for i in range(n):\n            m=tc.backend.cast(bits[layer,i],'int32')\n            proj=tc.backend.reshape(tc.backend.stack([1-m,0,0,m]),(2,2))\n            c.any(8+i, unitary=proj, name='post')\n        if layer==0 and False: pass\n        for i in range(n):\n            m=tc.backend.cast(bits[layer,i],'int32')\n            ang=tc.backend.where(m==0, p[layer,3,i], p[layer,4,i])\n            c.rzz(8+i,i,theta=ang)\n        for j in range(n-1): c.cnot(j,j+1)\n        for i in range(n): c.rz(i, theta=p[layer,5,i])\n\ndef e_norm(p,bits):\n    c=tc.Circuit(16, inputs=init_t)\n    for layer in range(2):\n        for i in range(n): c.ry(i, theta=p[layer,0,i])\n        for i in range(n): c.ry(8+i, theta=p[layer,1,i])\n        for i in range(n): c.rzz(8+i, i, theta=p[layer,2,i])\n        for j in range(n-1): c.cnot(8+j,9+j)\n        for i in range(n):\n            m=tc.backend.cast(bits[layer,i],'int32')\n            proj=tc.backend.reshape(tc.backend.stack([1-m,0