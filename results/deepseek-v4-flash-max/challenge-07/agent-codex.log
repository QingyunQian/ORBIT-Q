\n        for i in range(n):\n            m=tc.backend.cast(bits_t[layer,i],'int32')\n            ang=tc.backend.where(m==0, p[layer,3,i], p[layer,4,i])\n            c.rzz(8+i,i,theta=ang)\n        for j in range(n-1): c.cnot(j,j+1)\n        for i in range(n): c.rz(i, theta=p[layer,5,i])\n    e=c.expectation((G,list(range(n))))\n    st=c.wavefunction(); nrm2=tc.backend.sum(tc.backend.abs(st)**2,axis=-1)\n    return tc.backend.where(nrm2>1e-12, tc.backend.real(e)/nrm2, 0.0)\nf=jax.vmap(energy,in_axes=(None,0))\nobjg=jax.jit(jax.value_and_grad(lambda p,b: tc.backend.mean(f(p,b))))\ninit_fn,upd_fn,get=opt.adam(0.02); state=init_fn(params); upd=jax.jit(upd_fn)\nfor k in range(3):\n    p=get(state); e,g=objg(p,bits); state=upd(k,jax.numpy.real(g),state)\nfor k in range(10):\n    p=get(state); t=time.time(); e,g=objg(p,bits); print('obj',time.time()-t); t=time.time(); state=upd(k,jax.numpy.real(g),state); print('upd',time.time()-t)\nPY\ntimeout 120 python /tmp/test_time20.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
