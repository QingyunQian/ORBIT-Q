{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/solution7_proto.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.example_libraries.optimizers as opt\n\ndef run_solution(config):\n    tc.set_backend(\\\"jax\\\")\n    nd = config[\\\"n_data_qubits\\\"]\n    na = config[\\\"n_ancilla_qubits\\\"]\n    nq = nd + na\n    nl = config[\\\"n_layers\\\"]\n    nt = config[\\\"n_trajectories\\\"]\n    scale = config[\\\"initial_parameter_scale\\\"]\n    lr = config[\\\"learning_rate\\\"]\n    steps = config[\\\"max_steps\\\"]\n    seed = config[\\\"seed\\\"]\n    hx = config[\\\"transverse_field\\\"]\n\n    rng = np.random.default_rng(seed)\n    params = tc.array_to_tensor(rng.normal(size=(nl, 6, nd)) * scale)\n    status = tc.array_to_tensor(rng.random(size=(nt, nl, na)))\n\n    dim = 1 << nd\n    H = np.zeros((dim, dim), dtype=np.complex64)\n\n    def pauli(p, i):\n        m = {\\\"x\\\": np.array([[0,1],[1,0]], dtype=np.complex64),\n             \\\"z\\\": np.array([[1,0],[0,-1]], dtype=np.complex64)}[p]\n        ops = [np.eye(2, dtype=np.complex64)] * nd\n        ops[i] = m\n        out = ops[0]\n        for q in ops[1:]:\n            out = np.kron(out, q)\n        return out\n\n    for i in range(nd - 1):\n        H -= pauli(\\\"z\\\", i) @ pauli(\\\"z\\\", i + 1)\n    for i in range(nd):\n        H -= hx * pauli(\\\"x\\\", i)\n    Hgate = tc.gates.Gate(H.reshape([2] * nd + [2] * nd))\n\n    init = np.zeros(1 << nq, dtype=np.complex64)\n    init[0] = 1.0\n    init_t = tc.array_to_tensor(init)\n\n    def sample_bits(p, st):\n        c = tc.Circuit(nq)\n        rows = []\n        for layer in range(nl):\n            for i in range(nd):\n                c.ry(i, theta=p[layer, 0, i])\n            for i in range(na):\n                c.ry(nd + i, theta=p[layer, 1, i])\n            for i in range(nd):\n                c.rzz(nd + i, i, theta=p[layer, 2, i])\n            for j in range(na - 1):\n                c.cnot(nd + j, nd + j + 1)\n            row = []\n            for i in range(na):\n                row.append(c.cond_measurement(nd + i, status=st[layer, i]))\n            rows.append(tc.backend.stack(row))\n        return tc.backend.stack(rows)\n\n    bits = jax.jit(jax.vmap(sample_bits, in_axes=(None, 0)))(params, status)\n\n    def trajectory_energy(p, bits_t):\n        c = tc.Circuit(nq, inputs=init_t)\n        for layer in range(nl):\n            for i in range(nd):\n                c.ry(i, theta=p[layer, 0, i])\n            for i in range(na):\n                c.ry(nd + i, theta=p[layer, 1, i])\n            for i in range(nd):\n                c.rzz(nd + i, i, theta=p[layer, 2, i])\n            for j in range(na - 1):\n                c.cnot(nd + j, nd + j + 1)\n            for i in range(na):\n                m = tc.backend.cast(bits_t[layer, i], \\\"int32\\\")\n                proj = tc.backend.reshape(tc.backend.stack([1 - m, 0, 0, m]), (2, 2))\n                c.any(nd + i, unitary=proj, name=\\\"post\\\")\n            st = c.wavefunction()\n            nrm = tc.backend.sqrt(tc.backend.sum(tc.backend.abs(st) ** 2, axis=-1, keepdims=True))\n            c = tc.Circuit(nq, inputs=st / nrm)\n            for i in range(na):\n                m = tc.backend.cast(bits_t[layer, i], \\\"int32\\\")\n                ang = tc.backend.where(m == 0, p[layer, 3, i], p[layer, 4, i])\n                c.rzz(nd + i, i, theta=ang)\n            for j in range(nd - 1):\n                c.cnot(j, j + 1)\n            for i in range(nd):\n                c.rz(i, theta=p[layer, 5, i])\n        return tc.backend.real(c.expectation((Hgate, list(range(nd)))))\n\n    f = jax.vmap(trajectory_energy, in_axes=(None, 0))\n    objg = jax.jit(jax.value_and_grad(lambda p, b: tc.backend.mean(f(p, b))))\n\n    init_fn, upd_fn, get_params = opt.adam(lr)\n    state = init_fn(params)\n    upd = jax.jit(upd_fn)\n    hist = []\n    for t in range(steps):\n        p = get_params(state)\n        e, g = objg(p, bits)\n        hist.append(float(np.asarray(e)))\n        state = upd(t, g, state)\n\n    p = get_params(state)\n    final_es = np.asarray(f(p, bits))\n    return {\n        \\\"energy_history\\\": np.array(hist),\n        \\\"final_trajectory_energies\\\": final_es,\n    }\n\nif __name__ == \\\"__main__\\\":\n    import time\n    cfg = {\\\"n_data_qubits\\\": 8, \\\"n_ancilla_qubits\\\": 8, \\\"n_qubits\\\": 16,\n           \\\"n_layers\\\": 2, \\\"n_trajectories\\\": 64, \\\"initial_parameter_scale\\\": 0.1,\n           \\\"max_steps\\\": 100, \\\"learning_rate\\\": 0.02, \\\"seed\\\": 2047,\n           \\\"transverse_field\\\": 1.05, \\\"minimum_improvement\\\": 0.3,\n           \\\"target_final_energy\\\": -8.3}\n    t0=time.time(); r=run_solution(cfg); print('time',time.time()-t0)\n    print(len(r['energy_history']), r['energy_history'][0], r['energy_history'][-1], r['final_trajectory_energies'].shape)\n    print('mean final', r['final_trajectory_energies'].mean(), 'std', r['final_trajectory_energies'].std())\nPY\ntimeout 300 python /tmp/solution7_proto.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
