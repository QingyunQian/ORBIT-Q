{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_norm2.py <<'PY'\nimport tensorcircuit as tc, jax, time, numpy as np\ntc.set_backend('jax')\ninit=tc.array_to_tensor(np.array([1.,0.,0.,0.]))\n\ndef f(theta):\n    c=tc.Circuit(2, inputs=init)\n    c.ry(0, theta=theta)\n    proj=tc.array_to_tensor([[1.,0.],[0.,0.]])\n    c.any(0, unitary=proj, name='post')\n    st=c.wavefunction()\n    nrm=tc.backend.sqrt(tc.backend.sum(tc.backend.abs(st)**2, axis=-1, keepdims=True))\n    c=tc.Circuit(2, inputs=st/nrm)\n    c.rz(1, theta=0.5)\n    e=c.expectation([tc.gates.z(),[0]])+c.expectation([tc.gates.z(),[1]])\n    return tc.backend.real(e)\n\nt=time.time(); print('jit', jax.jit(f)(0.1), time.time()-t)\nt=time.time(); print('vmap', jax.vmap(f)(tc.array_to_tensor([0.1,0.8])), time.time()-t)\nPY\npython /tmp/test_norm2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
