{"type":"item.completed","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport inspect, jax.example_libraries.optimizers as o\nprint(inspect.getsource(o.adam))\nprint(inspect.getsource(o._adam_update) if hasattr(o,'_adam_update') else '')\nPY\"","aggregated_output":"@optimizer\ndef adam(step_size, b1=0.9, b2=0.999, eps=1e-8):\n  \"\"\"Construct optimizer triple for Adam.\n\n  Args:\n    step_size: positive scalar, or a callable representing a step size schedule\n      that maps the iteration index to a positive scalar.\n    b1: optional, a positive scalar value for beta_1, the exponential decay rate\n      for the first moment estimates (default 0.9).\n    b2: optional, a positive scalar value for beta_2, the exponential decay rate\n      for the second moment estimates (default 0.999).\n    eps: optional, a positive scalar value for epsilon, a small constant for\n      numerical stability (default 1e-8).\n\n  Returns:\n    An (init_fun, update_fun, get_params) triple.\n  \"\"\"\n  step_size = make_schedule(step_size)\n  def init(x0):\n    m0 = jnp.zeros_like(x0)\n    v0 = jnp.zeros_like(x0)\n    return x0, m0, v0\n  def update(i, g, state):\n    x, m, v = state\n    m = (1 - b1) * g + b1 * m  # First  moment estimate.\n    v = (1 - b2) * jnp.square(g) + b2 * v  # Second moment estimate.\n    mhat = m / (1 - jnp.asarray(b1, m.dtype) ** (i + 1))  # Bias correction.\n    vhat = v / (1 - jnp.asarray(b2, m.dtype) ** (i + 1))\n    x = x - step_size(i) * mhat / (jnp.sqrt(vhat) + eps)\n    return x, m, v\n  def get_params(state):\n    x, _, _ = state\n    return x\n  return init, update, get_params\n\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_time_small.py <<'PY'\n# Reuse a simple function with few params? Instead use actual functions but 10 steps no jit update\nimport numpy as np, tensorcircuit as tc, jax, time\nimport jax.example_libraries.optimizers as opt\ntc.set_backend('jax')\nn=8; dim=2**n\ndef pauli(p,i):\n    mats={'x':np.array([[0,1],[1,0]],dtype=np.complex64),'z':np.array([[1,0],[0,-1]],dtype=np.complex64)}\n    op=[np.eye(2,dtype=np.complex64)]*n; op[i]=mats[p]\n    r=op[0]\n    for m in op[1:]: r=np.kron(r,m)\n    return r\nH=np.zeros((dim,dim),dtype=np.complex64)\nfor i in range(n-1): H += -pauli('z',i)@pauli('z',i+1)\nfor i in range(n): H += -1.05*pauli('x',i)\nG=tc.gates.Gate(H.reshape([2]*n+[2]*n))\ninit=np.zeros(2**16,dtype=np.complex64); init[0]=1.; init_t=tc.array_to_tensor(init)\nrng=np.random.default_rng(2047)\nparams=tc.array_to_tensor(rng.normal(size=(2,6,8))*0.1)\nstatus=tc.array_to_tensor(rng.random(size=(64,2,8)))\ndef sample_bits(p, st):\n    c=tc.Circuit(16); rows=[]\n    for layer in range(2):\n        for i in range(n): c.ry(i, theta=p[layer,0,i])\n        for i in range(n): c.ry(8+i, theta=p[layer,1,i])\n        for i in range(n): c.rzz(8+i, i, theta=p[layer,2,i])\n        for j in range(n-1): c.cnot(8+j,9+j)\n        row=[]\n        for i in range(n): row.append(c.cond_measurement(8+i, status=st[layer,i]))\n        rows.append(tc.backend.stack(row))\n    return tc.backend.stack(rows)\nbits=jax.jit(jax.vmap(sample_bits,in_axes=(None,0)))(params,status)\ndef energy(p,bits_t):\n    c=tc.Circuit(16, inputs=init_t)\n    for layer in range(2):\n        for i in range(n): c.ry(i, theta=p[layer,0,i])\n        for i in range(n): c.ry(8+i, theta=p[layer,1,i])\n        for i in range(n): c.rzz(8+i, i, theta=p[layer,2,i])\n        for j in range(n-1): c.cnot(8+j,9+j)\n        for i in range(n):\n            m=tc.backend.cast(bits_t[layer,i],'int32')\n            proj=tc