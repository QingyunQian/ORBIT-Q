{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_ham_dense.py <<'PY'\nimport numpy as np, tensorcircuit as tc, jax, time\ntc.set_backend('jax')\nn=8\n# H dense 256x256\ndim=2**n\n# build via kron sparse? small dense manually\ndef pauli(p, i):\n    mats={'x':np.array([[0,1],[1,0]],dtype=np.complex64),'z':np.array([[1,0],[0,-1]],dtype=np.complex64)}\n    op=[np.eye(2,dtype=np.complex64)]*n; op[i]=mats[p]\n    r=op[0]\n    for m in op[1:]: r=np.kron(r,m)\n    return r\nH=np.zeros((dim,dim),dtype=np.complex64)\nfor i in range(n-1): H += -pauli('z',i)@pauli('z',i+1)\nfor i in range(n): H += -1.05*pauli('x',i)\nG=tc.gates.Gate(H.reshape([2]*n+[2]*n))\n\ndef energy_fixed(params, bits):\n    c=tc.Circuit(16)\n    for layer in range(2):\n        for i in range(n): c.ry(i, theta=params[layer,0,i])\n        for i in range(n): c.ry(8+i, theta=params[layer,1,i])\n        for i in range(n): c.rzz(8+i, i, theta=params[layer,2,i])\n        for j in range(n-1): c.cnot(8+j,9+j)\n        for i in range(n):\n            m=tc.backend.cast(bits[layer,i],'int32')\n            proj=tc.backend.reshape(tc.backend.stack([1-m,0,0,m]),(2,2))\n            c.any(8+i, unitary=proj, name='post')\n        st=c.wavefunction(); nrm=tc.backend.sqrt(tc.backend.sum(tc.backend.abs(st)**2,axis=-1,keepdims=True))\n        c=tc.Circuit(16, inputs=st/nrm)\n        for i in range(n):\n            m=tc.backend.cast(bits[layer,i],'int32')\n            ang=tc.backend.where(m==0, params[layer,3,i], params[layer,4,i])\n            c.rzz(8+i,i,theta=ang)\n        for j in range(n-1): c.cnot(j,j+1)\n        for i in range(n): c.rz(i, theta=params[layer,5,i])\n    return tc.backend.real(c.expectation((G, list(range(8)))))\n\nf=jax.vmap(energy_fixed, in_axes=(None,0))\nobjg=jax.jit(jax.value_and_grad(lambda p,b: tc.backend.mean(f(p,b))))\nrng=np.random.default_rng(0)\nparams=tc.array_to_tensor(rng.normal(size=(2,6,8))*0.1)\nbits=tc.array_to_tensor(rng.integers(0,2,size=(64,2,8)))\nt=time.time(); v,g=objg(params,bits); print('compile',v,time.time()-t)\nfor k in range(3):\n    t=time.time(); v,g=objg(params,bits); print('step',v,time.time()-t)\nPY\ntimeout 300 python /tmp/test_ham_dense.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
