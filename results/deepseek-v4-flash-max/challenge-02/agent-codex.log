{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '230,420p' /usr/local/lib/python3.11/site-packages/tensorcircuit/gates.py && sed -n '1120,1190p' /usr/local/lib/python3.11/site-packages/tensorcircuit/gates.py\"","aggregated_output":"\n    :param num: inputs\n    :type num: Union[float, Tensor]\n    :param dtype: dtype of the output Tensors\n    :type dtype: str, optional\n    :return: List of Tensors or a single Tensor\n    :rtype: Union[List[Tensor], Tensor]\n    \"\"\"\n\n    l = []\n    if dtype is None:\n        dtype = dtypestr\n    for n in num:\n        if not backend.is_tensor(n):\n            l.append(backend.cast(backend.convert_to_tensor(n), dtype=dtype))\n        else:\n            l.append(backend.cast(n, dtype=dtype))\n    if len(l) == 1:\n        return l[0]\n    return l\n\n\narray_to_tensor = num_to_tensor\n\n\ndef _cast_registered_gate(m: Tensor) -> Tensor:\n    if isinstance(m, np.ndarray):\n        return np.asarray(m, dtype=npdtype)\n    return m\n\n\nclass GateF:\n    def __init__(\n        self, m: Tensor, n: Optional[str] = None, ctrl: Optional[List[int]] = None\n    ):\n        if n is None:\n            n = \"unknowngate\"\n        self.m = m\n        self.n = n\n        self.ctrl = ctrl\n\n    def __call__(self, *args: Any, **kws: Any) -> Gate:\n        m1 = array_to_tensor(self.m)\n        # m = backend.cast(m, dtypestr)\n        m1 = backend.cast(m1, dtypestr)\n        return Gate(m1, name=self.n)\n\n    def adjoint(self) -> \"GateF\":\n        m = self.__call__()\n        shape0 = backend.shape_tuple(m.tensor)\n        m0 = backend.reshapem(m.tensor)\n        ma = backend.adjoint(m0)\n        name = self.n + \"d\"\n        ma = backend.reshape(ma, shape0)\n        return GateF(ma, name, self.ctrl)\n\n    # TODO(@refraction-ray): adjoint gate convention finally determined\n    def ided(self, before: bool = True) -> \"GateF\":\n        def f(*args: Any, **kws: Any) -> Any:\n     