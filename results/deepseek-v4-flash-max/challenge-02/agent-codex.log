{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, scipy.sparse as sp, scipy.sparse.linalg as spla\nn=12; zz=1.2; h=0.35\ndef pauli(op,i):\n    l=[sp.eye(2,dtype=complex) for _ in range(n)]\n    l[i]=op\n    return sp.lil_matrix(1)\n# build kron via reduce\nfrom functools import reduce\ndef kron_all(ops):\n    return reduce(lambda a,b: sp.kron(a,b,format='csr'), ops)\nX=np.array([[0,1],[1,0]],complex); Y=np.array([[0,-1j],[1j,0]],complex); Z=np.array([[1,0],[0,-1]],complex)\nH=0\nfor i in range(n-1):\n    ops=[sp.eye(2,format='csr',dtype=complex) for _ in range(n)]\n    ops[i]=sp.csr_matrix(X); ops[i+1]=sp.csr_matrix(X); H=H+kron_all(ops)\n    ops=[sp.eye(2,format='csr',dtype=complex) for _ in range(n)]\n    ops[i]=sp.csr_matrix(Y); ops[i+1]=sp.csr_matrix(Y); H=H+kron_all(ops)\n    ops=[sp.eye(2,format='csr',dtype=complex) for _ in range(n)]\n    ops[i]=sp.csr_matrix(Z); ops[i+1]=sp.csr_matrix(Z); H=H+zz*kron_all(ops)\nfor i in range(n):\n    ops=[sp.eye(2,format='csr',dtype=complex) for _ in range(n)]\n    ops[i]=sp.csr_matrix(Z); H=H+h*((-1)**i)*kron_all(ops)\ne0=spla.eigsh(H,k=1,which='SA',return_eigenvectors=False)[0]\nprint('exact density', e0/12)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
