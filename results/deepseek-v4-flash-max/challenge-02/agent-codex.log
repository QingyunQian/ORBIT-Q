{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto3.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp\nfrom tensorcircuit.quantum import reduced_density_matrix, renyi_entropy\n\nb=tc.cons.backend\nX=np.array([[0.,1.],[1.,0.]],dtype=np.complex64); Y=np.array([[0.,-1j],[1j,0.]],dtype=np.complex64); Z=np.array([[1.,0.],[0.,-1.]],dtype=np.complex64)\nXX=np.kron(X,X); YY=np.kron(Y,Y); ZZ=np.kron(Z,Z)\nn=12; target=jnp.array([0.3,0.6,0.8],dtype=jnp.float32); w=0.25\n\ndef build(params):\n    c=tc.Circuit(n)\n    for i in range(1,n,2): c.x(i)\n    s2s=[]; idx=0\n    for block in range(3):\n        for i in range(n): c.ry(i,theta=params[idx]); idx+=1\n        for i in range(n): c.rz(i,theta=params[idx]); idx+=1\n        for k in range(6):\n            i=2*k; j=i+1\n            U=params[idx]*XX+params[idx+1]*YY+params[idx+2]*ZZ; idx+=3\n            c.exp(i,j,unitary=U,theta=1.0)\n        for i in range(n): c.ry(i,theta=params[idx]); idx+=1\n        for i in range(n): c.rz(i,theta=params[idx]); idx+=1\n        for k in range(5):\n            i=2*k+1; j=i+1\n            U=params[idx]*XX+params[idx+1]*YY+params[idx+2]*ZZ; idx+=3\n            c.exp(i,j,unitary=U,theta=1.0)\n        s=c.wavefunction(); rho=reduced_density_matrix(s, subsystem_to_keep=range(6)); s2s.append(b.real(renyi_entropy(rho,k=2)))\n    return c, jnp.stack(s2s)\n\ndef loss_fn(params):\n    c,s2s=build(params); s=c.wavefunction(); e=0.0\n    for i in range(11):\n        e+=b.real(tc.expectation((tc.gates.x(),[i]),(tc.gates.x(),[i+1]),ket=s))\n        e+=b.real(tc.expectation((tc.gates.y(),[i]),(tc.gates.y(),[i+1]),ket=s))\n        e+=1.2*b.real(tc.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]),ket=s))\n    for i in range(12):\n        h=0.35 if i%2==0 else -0.35\n        e+=h*b.real(tc.expectation((tc.gates.z(),[i]),ket=s))\n    ed=e/12; mse=jnp.mean((s2s-target)**2); loss=ed+w*mse\n    return loss,(ed,s2s,mse)\n\nrng=np.random.default_rng(0)\np=jnp.array(rng.normal(0.0,0.02,size=243),dtype=jnp.float32)\nvg=jax.jit(b.value_and_grad(loss_fn,has_aux=True))\nt0=time.time(); print('start compile')\nloss,(ed,s2s,mse)=vg(p)\nprint('after compile', time.time()-t0, loss, ed, s2s, mse)\nm=jnp.zeros_like(p); v=jnp.zeros_like(p)\nlr=0.015; b1=0.9; b2=0.999; eps=1e-8\nh=[]\nfor t in range(1,501):\n    loss,(ed,s2s,mse),g=vg(p)\n    h.append((float(ed),float(loss),float(mse),np.asarray(s2s)))\n    m=b1*m+(1-b1)*g\n    v=b2*v+(1-b2)*g*g\n    mh=m/(1-b1**t); vh=v/(1-b2**t)\n    p=p-lr*mh/(jnp.sqrt(vh)+eps)\nh=np.array(h, dtype=object)\nprint('total',time.time()-t0)\nprint('initial', h[0])\nprint('final', h[-1])\nprint('params norm', np.linalg.norm(p))\nPY\npython /tmp/proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
