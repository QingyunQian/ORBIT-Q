{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto1.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nimport jax.numpy as jnp\nfrom tensorcircuit.quantum import reduced_density_matrix, renyi_entropy\n\nb = tc.cons.backend\nX = np.array([[0.,1.],[1.,0.]], dtype=np.complex64)\nY = np.array([[0.,-1j],[1j,0.]], dtype=np.complex64)\nZ = np.array([[1.,0.],[0.,-1.]], dtype=np.complex64)\nXX = np.kron(X,X); YY=np.kron(Y,Y); ZZ=np.kron(Z,Z)\nPAIR = [XX,YY,ZZ]\nn=12\ntarget=jnp.array([0.3,0.6,0.8], dtype=jnp.float32)\nw=0.25\n\ndef build(params):\n    c=tc.Circuit(n)\n    for i in range(1,n,2):\n        c.x(i)\n    s2s=[]\n    idx=0\n    for block in range(3):\n        # even rotations\n        for i in range(n):\n            c.ry(i, theta=params[idx]); idx+=1\n        for i in range(n):\n            c.rz(i, theta=params[idx]); idx+=1\n        for k in range(6):\n            i=2*k; j=i+1\n            U=params[idx]*XX+params[idx+1]*YY+params[idx+2]*ZZ\n            idx+=3\n            c.exp(i,j,unitary=U,theta=1.0)\n        # odd rotations\n        for i in range(n):\n            c.ry(i, theta=params[idx]); idx+=1\n        for i in range(n):\n            c.rz(i, theta=params[idx]); idx+=1\n        for k in range(5):\n            i=2*k+1; j=i+1\n            U=params[idx]*XX+params[idx+1]*YY+params[idx+2]*ZZ\n            idx+=3\n            c.exp(i,j,unitary=U,theta=1.0)\n        s=c.wavefunction()\n        rho=reduced_density_matrix(s, subsystem_to_keep=range(6))\n        s2s.append(b.real(renyi_entropy(rho,k=2)))\n    return c, jnp.stack(s2s)\n\ndef loss_fn(params):\n    c,s2s=build(params)\n    s=c.wavefunction()\n    e=0.0\n    for i in range(11):\n        e += b.real(tc.expectation((tc.gates.x(),[i]),(tc.gates.x(),[i+1]), ket=s))\n        e += b.real(tc.expectation((tc.gates.y(),[i]),(tc.gates.y(),[i+1]), ket=s))\n        e += 1.2*b.real(tc.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]), ket=s))\n    for i in range(12):\n        h = 0.35 if i%2==0 else -0.35\n        e += h*b.real(tc.expectation((tc.gates.z(),[i]), ket=s))\n    ed=e/12\n    mse=jnp.mean((s2s-target)**2)\n    loss=ed+w*mse\n    return loss, (ed, s2s, mse)\n\np=jnp.zeros(243, dtype=jnp.float32)\nvg=b.value_and_grad(loss_fn, has_aux=True)\nprint('call', vg(p))\nPY\npython /tmp/proto1.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
