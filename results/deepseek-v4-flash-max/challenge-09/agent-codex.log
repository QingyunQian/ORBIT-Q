{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_fwd.py <<'PY'\nimport numpy as np, jax, jax.numpy as jnp, time, tensorcircuit as tc, os\ntc.set_backend('jax'); tc.set_dtype('complex64')\n# generated from prior helper (copy)\ndef ladder_edges(n):\n    edges=[]\n    for col in range(n//2):\n        edges.append((2*col,2*col+1))\n        if col+1<n//2:\n            edges.append((2*col,2*(col+1))); edges.append((2*col+1,2*(col+1)+1))\n            if col%2==0: edges.append((2*col,2*(col+1)+1))\n            else: edges.append((2*col+1,2*(col+1)))\n    return edges\ndef gen(config):\n    rng=np.random.default_rng(config['seed']); tape=[]; p=0\n    single=('rx','ry','rz'); two=('rxx','ryy','rzz')\n    for _ in range(config['n_layers']):\n        for q in range(config['n_qubits']):\n            tape.append((single[int(rng.integers(3))],q,p)); p+=1\n        edges=list(ladder_edges(config['n_qubits'])); rng.shuffle(edges); used=set()\n        for a,b in edges:\n            if a in used or b in used: continue\n            if rng.random()>config['edge_keep_prob']: continue\n            tape.append((two[int(rng.integers(3))],a,b,p)); p+=1; used.update((a,b))\n    return tuple(tape),p\nconfig={\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"max_steps\\\":100,\\\"n_restarts\\\":200,\\\"learning_rate\\\":0.03,\\\"initial_parameter_scale\\\":0.02,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24,\\\"success_threshold\\\":1.0}\ngt,p=gen(config)\nterms=((0.5645931361768194, (('x',388),('z',390))),(1.0,(('x',16),('y',19))))\ndef cone(obs):\n    mark=set(q for _,q in obs); gs=[]\n    for g in reversed(gt):\n        if len(g)==3:\n            if g[1] in mark: gs.append(g)\n        else:\n            a,b=g[1],g[2]\n            if a in mark or b in mark: mark.update((a,b)); gs.append(g)\n    return mark, list(reversed(gs))\ncones=[]\nfor w,obs in terms:\n    m,gs=cone(obs); mp={q:i for i,q in enumerate(sorted(m))}\n    rg=[(g[0],mp[g[1]],g[2]) if len(g)==3 else (g[0],mp[g[1]],mp[g[2]],g[3]) for g in gs]\n    cones.append((w,mp[obs[0][1]],mp[obs[1][1]],len(m),rg))\nneed=set()\nfor _,_,_,_,rg in cones:\n    for g in rg: need.add(g[2] if len(g)==3 else g[3])\nneed=sorted(need); idx={v:i for i,v in enumerate(need)}\nw1,i1,j1,n1,rg1=cones[0]; w2,i2,j2,n2,rg2=cones[1]\n\ndef make_c(n,rg,theta):\n    c=tc.Circuit(n)\n    for k in range(n): c.H(k)\n    for g in rg:\n        if len(g)==3:\n            getattr(c,g[0])(g[1], theta=theta[idx[g[2]]])\n        else:\n            getattr(c,g[0])(g[1], g[2], theta=theta[idx[g[3]]])\n    return c\n\ndef fA(theta):\n    c1=make_c(n1,rg1,theta); e1=c1.expectation((tc.gates.x(),[i1]),(tc.gates.z(),[j1]))\n    c2=make_c(n2,rg2,theta); e2=c2.expectation((tc.gates.x(),[i2]),(tc.gates.y(),[j2]))\n    return -(w1*jnp.real(e1)+jnp.real(e2))\n\ndef fB(theta):\n    c1=make_c(n1,rg1,theta); e1=c1.expectation((tc.gates.x(),[i1]),(tc.gates.z(),[j1]), reuse=False)\n    c2=make_c(n2,rg2,theta); e2=c2.expectation((tc.gates.x(),[i2]),(tc.gates.y(),[j2]), reuse=False)\n    return -(w1*jnp.real(e1)+jnp.real(e2))\n\ndef fC(theta):\n    c1=make_c(n1,rg1,theta); s1=c1.wavefunction(); e1=tc.expectation((tc.gates.x(),[i1]),(tc.gates.z(),[j1]), ket=s1)\n    c2=make_c(n2,rg2,theta); s2=c2.wavefunction(); e2=tc.expectation((tc.gates.x(),[i2]),(tc.gates.y(),[j2]), ket=s2)\n    return -(w1*jnp.real(e1)+jnp.real(e2))\n\ndef fD(theta):\n    c1=make_c(n1,rg1,theta); e1=c1.expectation((tc.gates.x(),[i1]),(tc.gates.z(),[j1]), enable_lightcone=True)\n    c2=make_c(n2,rg2,theta); e2=c2.expectation((tc.gates.x(),[i2]),(tc.gates.y(),[j2]), enable_lightcone=True)\n    return -(w1*jnp.real(e1)+jnp.real(e2))\n\nrng=np.random.default_rng(2035+100000); th=jnp.array(rng.normal(0,0.02,size=len(need)))\nfor name,f in [('A exp',fA),('B noreuse',fB),('C wave+exp',fC),('D lightcone',fD)]:\n    try:\n        jf=jax.jit(f)\n        v=jf(th); v.block_until_ready()\n        t=time.time()\n        for _ in range