{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto.py <<'PY'\nimport numpy as np, jax, jax.numpy as jnp, time, tensorcircuit as tc\ntc.set_backend('jax')\ntc.set_dtype('complex64')\n\ndef ladder_edges(n):\n    edges=[]\n    for col in range(n//2):\n        edges.append((2*col,2*col+1))\n        if col+1<n//2:\n            edges.append((2*col,2*(col+1))); edges.append((2*col+1,2*(col+1)+1))\n            if col%2==0: edges.append((2*col,2*(col+1)+1))\n            else: edges.append((2*col+1,2*(col+1)))\n    return edges\n\ndef gen(config):\n    rng=np.random.default_rng(config['seed']); tape=[]; p=0\n    single=('rx','ry','rz'); two=('rxx','ryy','rzz')\n    for _ in range(config['n_layers']):\n        for q in range(config['n_qubits']):\n            tape.append((single[int(rng.integers(3))],q,p)); p+=1\n        edges=list(ladder_edges(config['n_qubits'])); rng.shuffle(edges); used=set()\n        for a,b in edges:\n            if a in used or b in used: continue\n            if rng.random()>config['edge_keep_prob']: continue\n            tape.append((two[int(rng.integers(3))],a,b,p)); p+=1; used.update((a,b))\n    return tuple(tape),p\n\nconfig={\\\"n_qubits\\\":512,\\\"n_layers\\\":6,\\\"max_steps\\\":100,\\\"n_restarts\\\":200,\\\"learning_rate\\\":0.03,\\\"initial_parameter_scale\\\":0.02,\\\"seed\\\":2035,\\\"edge_keep_prob\\\":0.24,\\\"success_threshold\\\":1.0}\ngt,p=gen(config)\nterms=((0.5645931361768194, (('x',388),('z',390))),(1.0,(('x',16),('y',19))))\n\ndef cone(obs):\n    mark=set(q for _,q in obs); gs=[]\n    for g in reversed(gt):\n        if len(g)==3:\n            if g[1] in mark: gs.append(g)\n        else:\n            a,b=g[1],g[2]\n            if a in mark or b in mark: mark.update((a,b)); gs.append(g)\n    return mark, list(reversed(gs))\n\nconed=[]\nfor w,obs in terms:\n    m,gs=cone(obs); mp={q:i for i,q in enumerate(sorted(m))}\n    # remap gates\n    rg=[]\n    for g in gs:\n        if len(g)==3: rg.append((g[0], mp[g[1]], g[2]))\n        else: rg.append((g[0], mp[g[1]], mp[g[2]], g[3]))\n    coned.append((w,obs,rg,len(m)))\n\nprint('coned sizes',[(len(rg),n) for _,_,rg,n in coned])\nfor k in range(2):\n    w,obs,rg,n=coned[k]\n    print('gates',rg)\n\n# all params needed\nneed=set()\nfor w,obs,rg,n in coned:\n    for g in rg: need.add(g[2] if len(g)==3 else g[3])\nneed=sorted(need); idx={v:i for i,v in enumerate(need)}\nprint('need',len(need),'range',need[0],need[-1])\n\n# build functions\ndef make_circuit(rg,n,theta):\n    c=tc.Circuit(n)\n    for i in range(n): c.H(i)\n    for g in rg:\n        if len(g)==3:\n            name,q,pi=g\n            getattr(c,name)(q, theta=theta[idx[pi]])\n        else:\n            name,a,b,pi=g\n            getattr(c,name)(a,b, theta=theta[idx[pi]])\n    return c\n\ndef obj(theta):\n    val=0.\n    for w,obs,rg,n in coned:\n        c=make_circuit(rg,n,theta)\n        ops=tuple((getattr(tc.gates,s)(), [mpq]) for s,mpq in [(({('x','x'):'x',('y','y'):'y',('z','z'):'z'})[p[0]], i) for p,i in []])\n        # explicit\n        e1 = c.expectation((tc.gates.x(),[mp[obs[0][1]]]), (tc.gates.z(),[mp[obs[1][1]]]))\n        e2 = c.expectation((tc.gates.x(),[mp2[obs[0][1]]]), (tc.gates.y(),[mp2[obs[1][1]]]))\n        val = val + w*jnp.real(e1) + jnp.real(e2)\n    return -val\n\n# fix using prebuilt ops lists\nopslist=[]\nfor w,obs,rg,n in coned:\n    mp={q:i for i,q in enumerate(sorted(set(q for _,q in obs)))} # actually use cone map from before, but need map\n    # recompute maps from gate remap impossible; store\n    opslist.append(obs)\nprint(opslist)\nPY\npython /tmp/proto.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
