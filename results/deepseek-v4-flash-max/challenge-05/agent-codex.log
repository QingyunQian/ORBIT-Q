{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\nprint('backend before', tc.backend.name)\ntc.set_backend('jax')\nprint('backend after', tc.backend.name, 'dtype', tc.cons.dtypestr)\nimport jax\nimport jax.numpy as jnp\n\nn=4\ninit = np.ones(2**n, dtype=np.complex64)/np.sqrt(2**n)\nxmat = np.array([[1.,1.],[1.,1.]], dtype=np.complex64) # exp(aX) at a=0? actually identity not\n\ndef f(a,b):\n    c=tc.Circuit(n, inputs=init)\n    for i in range(n):\n        u = jnp.array([[jnp.cosh(a), jnp.sinh(a)],[jnp.sinh(a), jnp.cosh(a)]], dtype=jnp.complex64)\n        c.any(u, i)\n    for (i,j) in [(0,1),(2,3)]:\n        v = jnp.array([[jnp.exp(b),0,0,0],[0,jnp.exp(-b),0,0],[0,0,jnp.exp(-b),0],[0,0,0,jnp.exp(b)]], dtype=jnp.complex64)\n        c.any(v, i, j)\n    psi=c.wavefunction()\n    psi=psi/jnp.linalg.norm(psi)\n    e = tc.expectation((tc.gates.z(),[0]),(tc.gates.z(),[1]), ket=psi)\n    return jnp.real(e)\n\na=jnp.array(0.01,dtype=jnp.float32); b=jnp.array(0.01,dtype=jnp.float32)\nprint('f', f(a,b))\nprint('grad', jax.grad(lambda a,b: f(a,b))(a,b))\nprint('jitted?')\nfjit=jax.jit(f)\nprint(fjit(a,b))\nprint('grad jit', jax.jit(jax.grad(lambda a,b: f(a,b)))(a,b))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
