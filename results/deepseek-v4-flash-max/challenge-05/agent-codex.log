{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 300 python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp, time\nfrom tensorcircuit.quantum import PauliStringSum2COO\n\nn=18\nls=[]; ws=[]\nfor i in range(n-1):\n    row=[0]*n; row[i]=3; row[i+1]=3; ls.append(row); ws.append(-1.0)\nfor i in range(n):\n    row=[0]*n; row[i]=1; ls.append(row); ws.append(-1.10)\nH=PauliStringSum2COO(ls, ws, numpy=False)\ninit=np.ones(2**n,dtype=np.complex64)/np.sqrt(2**n)\ndef make_u(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.array([[ca,sa],[sa,ca]],dtype=jnp.complex64)\ndef make_v(b):\n    return jnp.diag(jnp.array([jnp.exp(b),jnp.exp(-b),jnp.exp(-b),jnp.exp(b)],dtype=jnp.complex64))\ndef loss_fn(p):\n    a=p[:10].reshape(5,2); b=p[10:].reshape(5,2)\n    c=tc.Circuit(n, inputs=init)\n    for l in range(10):\n        aa=a[l//2,l%2]; bb=b[l//2,l%2]\n        u=make_u(aa); v=make_v(bb)\n        for i in range(n):\n            c.any(i,unitary=u)\n        rng=range(0,n,2) if l%2==0 else range(1,n-1,2)\n        for i in rng:\n            c.any(i,i+1,unitary=v)\n        psi=c.wavefunction(); psi=psi/jnp.linalg.norm(psi)\n        c=tc.Circuit(n, inputs=psi)\n    state=c.wavefunction(form='ket')\n    tmp=H @ state\n    expt=jnp.conj(state).T @ tmp\n    return jnp.real(expt[0,0])/n\n\ndef run_steps(p0, steps, lr=0.02):\n    b1=jnp.float32(0.9); b2=jnp.float32(0.999); eps=jnp.float32(1e-8)\n    def body(carry, x):\n        p, m, v, t = carry\n        loss, grad = jax.value_and_grad(loss_fn)(p)\n        t = t + 1\n        m = b1*m + (1-b1)*grad\n        v = b2*v + (1-b2)*grad*grad\n        mhat = m/(1-b1**t)\n        vhat = v/(1-b2**t)\n        p = p - lr*mhat/(jnp.sqrt(vhat)+eps)\n        return (p,m,v,t), loss\n    init=(p0, jnp.zeros_like(p0), jnp.zeros_like(p0), jnp.array(0, dtype=jnp.int32))\n    (p,m,v,t), hist = jax.lax.scan(body, init, None, length=steps)\n    return p, hist\n\np0=jnp.full(20,0.01,dtype=jnp.float32)\nprint('compile scan 30')\nt0=time.time(); p,hist=run_steps(p0,30); jax.block_until_ready((p,hist)); print('30 time',time.time()-t0,'hist0/last',np.asarray(hist[0]),np.asarray(hist[-1]))\nprint('compile scan 100')\nt0=time.time(); p,hist=run_steps(p0,100); jax.block_until_ready((p,hist)); print('100 time',time.time()-t0,'hist0/last',np.asarray(hist[0]),np.asarray(hist[-1]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
