{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 300 python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp, optax, time\nfrom tensorcircuit.quantum import PauliStringSum2COO\n\nn=18\nls=[]; weights=[]\nfor i in range(n-1):\n    row=[0]*n; row[i]=3; row[i+1]=3; ls.append(row); weights.append(-1.0)\nfor i in range(n):\n    row=[0]*n; row[i]=1; ls.append(row); weights.append(-1.10)\nH=PauliStringSum2COO(ls, weights, numpy=False)\ninit = np.ones(2**n, dtype=np.complex64)/np.sqrt(2**n)\n\ndef make_u(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.array([[ca, sa],[sa, ca]], dtype=jnp.complex64)\ndef make_v(b):\n    eb=jnp.exp(b); em=jnp.exp(-b)\n    return jnp.diag(jnp.array([eb,em,em,eb], dtype=jnp.complex64))\n\ndef loss_fn(p):\n    a=p[:10].reshape(5,2); b=p[10:].reshape(5,2)\n    c=tc.Circuit(n, inputs=init)\n    for l in range(10):\n        aa=a[l//2,l%2]; bb=b[l//2,l%2]\n        u=make_u(aa); v=make_v(bb)\n        for i in range(n):\n            c.any(i, unitary=u)\n        if l%2==0:\n            bonds=range(0,n,2)\n        else:\n            bonds=range(1,n-1,2)\n        for i in bonds:\n            c.any(i,i+1,unitary=v)\n        psi=c.wavefunction()\n        psi=psi/jnp.linalg.norm(psi)\n        c=tc.Circuit(n, inputs=psi)\n    # energy with sparse H\n    state=c.wavefunction(form='ket')\n    tmp=H @ state\n    expt=jnp.conj(state).T @ tmp\n    return jnp.real(expt[0,0])/n\n\np0=jnp.full(20,0.01,dtype=jnp.float32)\nopt=optax.adam(0.02)\nstate=opt.init(p0)\n\n@jax.jit\ndef step(p, state):\n    loss, grad=jax.value_and_grad(loss_fn)(p)\n    updates, state=opt.update(grad, state, p)\n    return optax.apply_updates(p, updates), state, loss\n\nprint('compile...')\nt0=time.time()\np=p0; st=state\nhist=np.empty(600, dtype=np.float32)\nfor k in range(600):\n    p, st, loss=step(p, st)\n    hist[k]=np.asarray(loss)\nprint('elapsed',time.time()-t0)\nprint('first last',hist[0],hist[-1], 'min',hist.min())\nprint('p', np.asarray(p))\nprint('a', np.asarray(p[:10].reshape(5,2)))\nprint('b', np.asarray(p[10:].reshape(5,2)))\nprint('hist nonfinite', np.isnan(hist).sum())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
