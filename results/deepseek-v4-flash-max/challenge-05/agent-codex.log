{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 120 python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp, time\n\nn=18\ninit = np.ones(2**n, dtype=np.complex64)/np.sqrt(2**n)\nz = tc.gates.z(); x = tc.gates.x()\nzz = tc.gates.zz() if hasattr(tc.gates,'zz') else None\n# check gates names\nprint('has zz', hasattr(tc.gates,'zz'), [g for g in dir(tc.gates) if g in ('z','x','zz')])\n# Build ops as tuples once outside? We'll pass inside closure.\n# 1-qubit matrix function\ndef make_u(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.array([[ca, sa],[sa, ca]], dtype=jnp.complex64)\ndef make_v(b):\n    eb=jnp.exp(b); em=jnp.exp(-b)\n    return jnp.diag(jnp.array([eb,em,em,eb], dtype=jnp.complex64))\n\ndef f(p):\n    a=p[:10].reshape(5,2)\n    b=p[10:].reshape(5,2)\n    c=tc.Circuit(n, inputs=init)\n    for l in range(10):\n        aa=a[l//2,l%2]; bb=b[l//2,l%2]\n        u=make_u(aa)\n        v=make_v(bb)\n        for i in range(n):\n            c.any(i, unitary=u)\n        if l%2==0:\n            bonds=[(i,i+1) for i in range(0,n,2)]\n        else:\n            bonds=[(i,i+1) for i in range(1,n-1,2)]\n        for (i,j) in bonds:\n            c.any(i,j,unitary=v)\n        psi=c.wavefunction()\n        psi=psi/jnp.linalg.norm(psi)\n        # store normalized state in circuit? We could start new circuit with psi for next layer to reduce nodes.\n        c=tc.Circuit(n, inputs=psi)\n    e = tc.expectation((z,[0]), ket=psi)\n    return jnp.real(e)\n\np=jnp.zeros(20,dtype=jnp.float32)\nt0=time.time()\nprint('compiling...')\nfj=jax.jit(f)\nprint('compile start')\ntry:\n    y=fj(p)\n    print('result', y, 'elapsed compile+run', time.time()-t0)\nexcept Exception as ex:\n    import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
