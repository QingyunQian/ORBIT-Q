{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 240 python - <<'PY'\nimport tensorcircuit as tc\nimport numpy as np\ntc.set_backend('jax')\nimport jax, jax.numpy as jnp, time\nfrom tensorcircuit.quantum import PauliStringSum2COO\nn=18\nls=[]; ws=[]\nfor i in range(n-1):\n    row=[0]*n; row[i]=3; row[i+1]=3; ls.append(row); ws.append(-1.0)\nfor i in range(n):\n    row=[0]*n; row[i]=1; ls.append(row); ws.append(-1.10)\nH=PauliStringSum2COO(ls, ws, numpy=False)\ninit=np.ones(2**n,dtype=np.complex64)/np.sqrt(2**n)\ndef make_u(a):\n    ca=jnp.cosh(a); sa=jnp.sinh(a)\n    return jnp.array([[ca,sa],[sa,ca]],dtype=jnp.complex64)\ndef make_v(b):\n    return jnp.diag(jnp.array([jnp.exp(b),jnp.exp(-b),jnp.exp(-b),jnp.exp(b)],dtype=jnp.complex64))\n\ndef evolve(p):\n    a=p[:10].reshape(5,2); b=p[10:].reshape(5,2)\n    c=tc.Circuit(n, inputs=init)\n    for l in range(10):\n        aa=a[l//2,l%2]; bb=b[l//2,l%2]\n        u=make_u(aa); v=make_v(bb)\n        for i in range(n):\n            c.any(i,unitary=u)\n        rng=range(0,n,2) if l%2==0 else range(1,n-1,2)\n        for i in rng:\n            c.any(i,i+1,unitary=v)\n        psi=c.wavefunction(); psi=psi/jnp.linalg.norm(psi)\n        c=tc.Circuit(n, inputs=psi)\n    return c, psi\n\ndef f_state(p):\n    c,psi=evolve(p)\n    return jnp.real(jnp.sum(psi*jnp.conj(psi)))\n\ndef f_energy(p):\n    c,psi=evolve(p)\n    tmp=H @ psi\n    return jnp.real(jnp.dot(jnp.conj(psi), tmp))/n\n\nzmat=np.diag([1+0j,-1+0j]).astype(np.complex64)\nxmat=np.array([[0,1],[1,0]],dtype=np.complex64)\ndef f_energy_tc(p):\n    c,psi=evolve(p)\n    e=0.0\n    for i in range(n-1):\n        e=e+tc.expectation((zmat,[i]),(zmat,[i+1]),ket=psi)\n    for i in range(n):\n        e=e+tc.expectation((xmat,[i]),ket=psi)\n    return jnp.real(-e - 1.10*jnp.sum(jnp.ones(n)))/n\n\np=jnp.full(20,0.01,dtype=jnp.float32)\nfor name,fn in [('state_norm',f_state),('energy_sparse',f_energy),('energy_tc35',f_energy_tc)]:\n    print('---',name)\n    vg=jax.jit(jax.value_and_grad(fn))\n    t0=time.time(); v,g=vg(p); print('first incl compile', time.time()-t0, v, jnp.linalg.norm(g))\n    t0=time.time()\n    for k in range(3):\n        v,g=vg(p+0.001*(k+1))\n    print('3 calls',time.time()-t0, 'avg', (time.time()-t0)/3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
