{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_tc.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nimport jax.numpy as jnp\n\ndef build(params, n=4, sel=(0,1,2,3)):\n    c=tc.Circuit(n)\n    c.x(1)\n    for q in range(n):\n        c.rx(q, theta=params[q,0])\n        c.rz(q, theta=params[q,1])\n        c.ry(q, theta=params[q,2])\n    c.cmz(*sel)\n    return c\n\nparams=jnp.zeros((4,3))\nc=build(params)\nprint('state dtype', c.state().dtype, c.state().shape)\nprint('state', c.state())\nprint('amp1111', c.amplitude('1111'))\nprint('amp0000', c.amplitude('0000'))\n\ndef energy(p):\n    c=build(p)\n    s=0.0\n    for q in range(n:=4):\n        s += c.expectation_ps(z=[q])\n    return tc.backend.real(s)\n\nprint('energy', energy(params))\nprint('grad', jax.grad(energy)(params))\nPY\npython /tmp/test_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
