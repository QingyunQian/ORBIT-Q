{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nprint('before', tc.backend.name)\ntc.set_backend('jax')\nprint('after', tc.backend.name, tc.get_dtype())\nimport jax, numpy as np\nSx=np.array([[0,1/np.sqrt(2),0],[1/np.sqrt(2),0,1/np.sqrt(2)],[0,1/np.sqrt(2),0]],dtype=complex)\nSy=1j*np.array([[0,-1/np.sqrt(2),0],[1/np.sqrt(2),0,-1/np.sqrt(2)],[0,1/np.sqrt(2),0]],dtype=complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nD=np.diag([1.,0,1.]).astype(complex)\n# Ry(theta)=exp(-i theta Sy), Rz(theta)=exp(-i theta Sz)\nimport scipy.linalg as sla\n\ndef circ(params):\n    c=tc.Circuit(2, dim=3)\n    m=scipy.linalg.expm(-1j*params[0]*Sy)\n    c.any(0, unitary=m)\n    c.any(1, unitary=scipy.linalg.expm(-1j*params[1]*Sz))\n    # expectation of Sx0*Sx1 + Sz0*Sz1\n    op=np.kron(Sx,Sx)+np.kron(Sz,Sz)\n    # need matrix passed as tensor maybe\n    return c.expectation((op,[0,1]))\nparams=np.array([0.2,0.3])\nprint('run', circ(params))\nprint('grad?', end=' ')\ntry:\n g=tc.backend.grad(circ)(params)\n print(g)\nexcept Exception as e:\n import traceback; traceback.print_exc()\nprint('jit')\njf=tc.backend.jit(circ)\nprint(jf(params))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
