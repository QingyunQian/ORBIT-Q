{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\nfrom tensorcircuit.templates.measurements import mpo_expectation\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nSz2=np.diag([1.,0,1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nbeta=0.2; D=0.15\nH2=A+beta*(A+B)@(A+B)\nH4=H2.reshape(3,3,3,3)\nM=H4.transpose(0,2,1,3).reshape(9,9)\nu,sv,vh=np.linalg.svd(M); K=np.count_nonzero(sv>1e-10)\nL=np.empty((K,3,3),complex); R=np.empty((K,3,3),complex)\nfor k in range(K):\n L[k]=np.sqrt(sv[k])*u[:,k].reshape(3,3); R[k]=np.sqrt(sv[k])*vh[k,:].reshape(3,3)\ndef make_mpo(n):\n nodes=[]\n for i in range(n):\n  dl=1 if i==0 else K+1\n  dr=1 if i==n-1 else K+1\n  W=np.zeros((dl,3,3,dr),complex)\n  if i>0:\n   for k in range(K):\n    W[k+1,:,:,0]=R[k] # axes in,out? R[k][a,c] -> W[in=c,out=a]=R[a,c] => W[:,:,0]=R.T\n    # Since R is a matrix M[out,in], with axes (in,out) = transpose\n    W[k+1,:,:,0]=R[k].T\n  if i<n-1:\n   for k in range(K):\n    W[0,:,:,k+1]=L[k].T\n  W[0,:,:,0]=D*Sz2.T\n  nodes.append(tn.Node(W,name=f'W{i}'))\n for i in range(n-1): nodes[i][3]\"'^nodes[i+1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\n# reference dense for n=2,3\ndef refH(n):\n I=np.eye(3,dtype=complex); H=0\n for i in range(n-1):\n  # kron with positions 0..n-1 using nested loops\n  op=np.array([[1]])\n  # build kron with H2 at i via kron(I_left,H2,I_right) where left=3''^i? But because site0 outer, kron sequential with identity appended after; for i from 0: H2 outer then I''^(n-2) gives H2 on sites0,1. For i> need permutation; use tensor approach small\n  tens=np.zeros([3]*n+[3]*n,complex)\n  H4t=H2.reshape(3,3,3,3)\n  for a in range(3):\n   for b in range(3):\n    for c in range(3):\n     for d in range(3):\n      # out i=a,out i+1=b,in i=c,in i+1=d\n      sl_out=[slice(None)]*n; sl_in=[slice(None)]*n\n      sl_out[i]=a; sl_out[i+1]=b; sl_in[i]=c; sl_in[i+1]=d\n      tens[tuple(sl_out)+tuple(sl_in)] += H4t[a,b,c,d]\n  for i in range(n):\n   tens2=np.zeros([3]*n+[3]*n,complex)\n   for a in range(3):\n    for c in range(3):\n     sl_out=[slice(None)]*n; sl_in=[slice(None)]*n\n     sl_out[i]=a; sl_in[i]=c\n     tens2[tuple(sl_out)+tuple(sl_in)] = D*Sz2[a,c]\n  H += tens.reshape(3**n,3**n) + tens2.reshape(3**n,3**n)\n return H\nfor n in [2,3]:\n Href=refH(n)\n E=make_mpo(n).eval_matrix()\n print('\"'n',n,'err',np.max(np.abs(E-Href)))\n # random circuit\n import scipy.linalg as sla\n c=tc.Circuit(n,dim=3)\n for i in range(n):\n  h=np.random.randn(3,3)+1j*np.random.randn(3,3); h=h+h.conj().T\n  c.any(i,unitary=sla.expm(-1j*h),dim=3)\n e1=c.expectation((H2 if n==2 else Href,[0,1] if n==2 else None)) if n==2 else None\n if n==2:\n  print('direct',c.expectation((H2,[0,1])),'mpo',mpo_expectation(c,make_mpo(n)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
