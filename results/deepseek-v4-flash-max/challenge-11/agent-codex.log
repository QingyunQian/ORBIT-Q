{"type":"item.started","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\nfrom tensorcircuit.templates.measurements import mpo_expectation\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nSz2=np.diag([1.,0,1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nbeta=0.2; D=0.15\nH2=A+beta*(A+B)@(A+B)\nH4=H2.reshape(3,3,3,3); M=H4.transpose(0,2,1,3).reshape(9,9)\nu,sv,vh=np.linalg.svd(M); Kb=np.count_nonzero(sv>1e-10)\nLb=[]; Rb=[]\nfor k in range(Kb):\n Lb.append(np.sqrt(sv[k])*u[:,k].reshape(3,3))\n Rb.append(np.sqrt(sv[k])*vh[k,:].reshape(3,3))\nI=np.eye(3,dtype=complex)\ndef make_mpo(n):\n terms=[]\n for i in range(n-1):\n  for k in range(Kb):\n   terms.append((i,Lb[k],Rb[k]))\n for i in range(n-1):\n  terms.append((i,D*Sz2,I))\n terms.append((n-2,I,D*Sz2))\n K=len(terms); Dstate=K+2\n nodes=[]\n for i in range(n):\n  dl=1 if i==0 else Dstate\n  dr=1 if i==n-1 else Dstate\n  W=np.zeros((dl,3,3,dr),complex)\n  # map right/left state indices: 0=pre,1=post,2..=active\n  if i==0:\n   # left pre only\n   W[0,:,:,0]=I.T  # pre->pre\n   W[0,:,:,1]=0\n   for k,(st,L,R) in enumerate(terms):\n    if st==i: W[0,:,:,k+2]=L.T\n  elif i==n-1:\n   # right post only\n   W[0,:,:,0]=0  # pre->? invalid\n   W[1,:,:,0]=I.T # post->post\n   for k,(st,L,R) in enumerate(terms):\n    if st==i-1: W[k+2,:,:,0]=R.T\n  else:\n   W[0,:,:,0]=I.T\n   W[1,:,:,1]=I.T\n   for k,(st,L,R) in enumerate(terms):\n    if st==i: W[0,:,:,k+2]=L.T\n    if st==i-1: W[k+2,:,:,1]=R.T\n  nodes.append(tn.Node(W))\n for i in range(n-1): nodes[i][3]\"'^nodes[i+1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\ndef refH(n):\n H