{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\nfrom tensorcircuit.templates.measurements import mpo_expectation\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nH=A+B+0.2*(A+B)@(A+B)\nM=H.reshape(9,9)\nu,sv,vh=np.linalg.svd(M); K=9\nL=np.empty((K,3,3),complex); R=np.empty((K,3,3),complex)\nfor k in range(K):\n L[k]=np.sqrt(sv[k])*u[:,k].reshape(3,3); R[k]=np.sqrt(sv[k])*vh[k,:].reshape(3,3)\ndef make_mpo(order):\n nodes=[]\n W0=np.zeros((1,3,3,K+1),complex); W1=np.zeros((K+1,3,3,1),complex)\n I=np.eye(3,dtype=complex)\n for a in range(3):\n  for c in range(3):\n   if order==0: W0[0,c,a,0]=I[a,c]\n   else: W0[0,a,c,0]=I[a,c]\n for k in range(K):\n  for a in range(3):\n   for c in range(3):\n    if order==0: W0[0,c,a,k+1]=L[k][a,c]\n    else: W0[0,a,c,k+1]=L[k][a,c]\n for k in range(K):\n  for a in range(3):\n   for c in range(3):\n    if order==0: W1[k+1,c,a,0]=R[k][a,c]\n    else: W1[k+1,a,c,0]=R[k][a,c]\n for idx,W in enumerate([W0,W1]):\n  nodes.append(tn.Node(W,name=f'W{idx}'))\n nodes[0][3]\"'^nodes[1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\n# random local unitaries\ndef u3():\n  # random orthogonal-ish via expm\n  import scipy.linalg as sla\n  h=np.random.randn(3,3)+1j*np.random.randn(3,3); h=h+h.conj().T\n  return sla.expm(-1j*h)\nU0=u3(); U1=u3()\nc=tc.Circuit(2,dim=3)\nc.any(0,unitary=U0,dim=3); c.any(1,unitary=U1,dim=3)\nprint('\"'direct',c.expectation((H,[0,1])))\nfor order in [0,1]:\n try: print('order',order,mpo_expectation(c,make_mpo(order)))\n except Exception as e: print('err',order,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
