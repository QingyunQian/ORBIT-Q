{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nSz2=np.diag([1.,0,1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nbeta=0.2; D=0.15\nH2=A+beta*(A+B)@(A+B)\nH4=H2.reshape(3,3,3,3); M=H4.transpose(0,2,1,3).reshape(9,9)\nu,sv,vh=np.linalg.svd(M); K=9\nL=np.empty((K,3,3),complex); R=np.empty((K,3,3),complex)\nfor k in range(K):\n L[k]=np.sqrt(sv[k])*u[:,k].reshape(3,3); R[k]=np.sqrt(sv[k])*vh[k,:].reshape(3,3)\ndef make_mpo(includeD=True):\n nodes=[]\n for i in range(2):\n  dl=1 if i==0 else K+1; dr=1 if i==1 else K+1\n  W=np.zeros((dl,3,3,dr),complex)\n  if i>0:\n   W[1:,:,:,0]=np.stack([R[k].T for k in range(K)])\n  if i<1:\n   W[0,:,:,1:]=np.stack([L[k].T for k in range(K)],axis=2)\n  if includeD:\n   W[0,:,:,0]=D*Sz2.T\n  nodes.append(tn.Node(W))\n nodes[0][3]\"'^nodes[1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\nE=make_mpo(True).eval_matrix(); E0=make_mpo(False).eval_matrix()\nprint('\"'E-H2 err',np.max(np.abs(E-H2)), 'E0-H2',np.max(np.abs(E0-H2)))\nprint('E - (E0 + D kron(Sz2,I)+D kron(I,Sz2))')\ntarget=E0+D*np.kron(Sz2,np.eye(3))+D*np.kron(np.eye(3),Sz2)\nprint(np.max(np.abs(E-target)))\nprint('diag samples', np.diag(E)[:6], np.diag(H2+D*np.kron(Sz2,np.eye(3))+D*np.kron(np.eye(3),Sz2))[:6])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
