{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import QuOperator\nimport numpy as np\nfrom tensorcircuit.templates.measurements import mpo_expectation\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy)\nB=np.kron(Sz,Sz)\nH=A+B+0.2*(A+B)@(A+B)\n# simple circuit\nc=tc.Circuit(2, dim=3)\nc.any(0, unitary=np.eye(3), dim=3)\nc.any(1, unitary=np.eye(3), dim=3)\nprint('direct', c.expectation((H,[0,1])))\nq=QuOperator.from_tensor(H.reshape(3,3,3,3))\nprint('q op', q.out_space, q.in_space)\nprint('mpo_expectation', mpo_expectation(c,q))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
