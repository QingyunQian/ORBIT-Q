{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nH=A+B+0.2*(A+B)@(A+B)\nM=H.reshape(9,9); u,sv,vh=np.linalg.svd(M); K=9\nL=np.empty((K,3,3),complex); R=np.empty((K,3,3),complex)\nfor k in range(K):\n L[k]=np.sqrt(sv[k])*u[:,k].reshape(3,3); R[k]=np.sqrt(sv[k])*vh[k,:].reshape(3,3)\ndef build(axis_in_first, out_edge_axis, swap=False):\n # axis_in_first: True => node axes [l,in,out,r]; False => [l,out,in,r]\n # out_edge_axis: which node axis index to use as out edge (1 or 2)\n W0=np.zeros((1,3,3,K+1),complex); W1=np.zeros((K+1,3,3,1),complex)\n left=L if not swap else R\n right=R if not swap else L\n for k in range(K):\n  for a in range(3):\n   for c in range(3):\n    if axis_in_first:\n     W0[0,c,a,k+1]=left[k][a,c]\n     W1[k+1,c,a,0]=right[k][a,c]\n    else:\n     W0[0,a,c,k+1]=left[k][a,c]\n     W1[k+1,a,c,0]=right[k][a,c]\n nodes=[tn.Node(W0),tn.Node(W1)]; nodes[0][3]\"'^nodes[1][0]\n out_ax=out_edge_axis\n in_ax=1 if out_ax==2 else 2\n return quantum_constructor([n[out_ax] for n in nodes],[n[in_ax] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\nfor af in [True,False]:\n for oe in [1,2]:\n  for swap in [False,True]:\n   E=build(af,oe,swap).eval_matrix()\n   print('\"'af',af,'oe',oe,'swap',swap,'err',np.max(np.abs(E-H)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
