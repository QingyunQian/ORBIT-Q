{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\ntc.set_backend('jax')\ns=np.sqrt(2); Sx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex); Sy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex); Sz=np.diag([1.,0,-1.]).astype(complex); Sz2=np.diag([1.,0,1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz); beta=0.2; D=0.15\nH2=A+beta*(A+B)@(A+B)\nH4=H2.reshape(3,3,3,3); M=H4.transpose(0,2,1,3).reshape(9,9); u,sv,vh=np.linalg.svd(M); Kb=9\nLb=[np.sqrt(sv[k])*u[:,k].reshape(3,3) for k in range(Kb)]; Rb=[np.sqrt(sv[k])*vh[k,:].reshape(3,3) for k in range(Kb)]\nI=np.eye(3,dtype=complex)\ndef make_mpo(n, withD=True):\n terms=[]\n for i in range(n-1):\n  for k in range(Kb): terms.append((i,Lb[k],Rb[k]))\n if withD:\n  for i in range(n-1): terms.append((i,D*Sz2,I))\n  terms.append((n-2,I,D*Sz2))\n K=len(terms); Dstate=K+2\n nodes=[]\n for i in range(n):\n  dl=1 if i==0 else Dstate; dr=1 if i==n-1 else Dstate\n  W=np.zeros((dl,3,3,dr),complex)\n  if i==0:\n   W[0,:,:,0]=I.T\n   for k,(st,L,R) in enumerate(terms):\n    if st==i: W[0,:,:,k+2]=L.T\n  elif i==n-1:\n   W[1,:,:,0]=I.T\n   for k,(st,L,R) in enumerate(terms):\n    if st==i-1: W[k+2,:,:,0]=R.T\n  else:\n   W[0,:,:,0]=I.T; W[1,:,:,1]=I.T\n   for k,(st,L,R) in enumerate(terms):\n    if st==i: W[0,:,:,k+2]=L.T\n    if st==i-1: W[k+2,:,:,1]=R.T\n  nodes.append(tn.Node(W))\n for i in range(n-1): nodes[i][3]\"'^nodes[i+1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\nfor n in [2,3]:\n E=make_mpo(n,True).eval_matrix(); E0=make_mpo(n,False).eval_matrix()\n print('\"'n',n,'Ddiff nnz',np.count_nonzero(E-E0),'max',np.max(np.abs(E-E0)))\n # compare to expected D sum for n=2\n if n==2:\n  expect=D*np.kron(Sz2,I)+D*np.kron(I,Sz2)\n  print('diff vs expect',np.max(np.abs((E-E0)-expect)))\n  print('E-E0 diag', np.round(np.diag(E-E0),4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
