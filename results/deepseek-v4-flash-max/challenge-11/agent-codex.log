{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nfrom tensorcircuit.quantum import quantum_constructor\nimport numpy as np, tensornetwork as tn\nfrom tensorcircuit.templates.measurements import mpo_expectation\ntc.set_backend('jax')\ns=np.sqrt(2)\nSx=np.array([[0,1/s,0],[1/s,0,1/s],[0,1/s,0]],complex)\nSy=1j*np.array([[0,-1/s,0],[1/s,0,-1/s],[0,1/s,0]],complex)\nSz=np.diag([1.,0,-1.]).astype(complex)\nSz2=np.diag([1.,0,1.]).astype(complex)\nA=np.kron(Sx,Sx)+np.kron(Sy,Sy); B=np.kron(Sz,Sz)\nbeta=0.2; D=0.15\nH2=A+beta*(A+B)@(A+B)\nH4=H2.reshape(3,3,3,3); M=H4.transpose(0,2,1,3).reshape(9,9)\nu,sv,vh=np.linalg.svd(M); Kb=np.count_nonzero(sv>1e-10)\nLb=[]; Rb=[]\nfor k in range(Kb):\n Lb.append(np.sqrt(sv[k])*u[:,k].reshape(3,3))\n Rb.append(np.sqrt(sv[k])*vh[k,:].reshape(3,3))\ndef make_mpo(n):\n # build term list (start, L, R)\n terms=[]\n for i in range(n-1):\n  terms.append((i,Lb,Rb))\n # local D_i: start i, end i+1\n for i in range(n-1):\n  terms.append((i, [D*Sz2], [np.eye(3,dtype=complex)]))\n terms.append((n-2, [np.eye(3,dtype=complex)], [D*Sz2]))\n # But term entries lists many; easier build per site with term index\n K=len(terms)\n # need per term start and L/R matrix; construct arrays\n starts=np.array([t[0] for t in terms])\n Ls=np.array([t[1][0] if isinstance(t[1],list) else t[1] for t in terms])\n Rs=np.array([t[2][0] if isinstance(t[2],list) else t[2] for t in terms])\n nodes=[]\n for i in range(n):\n  dl=1 if i==0 else K+1\n  dr=1 if i==n-1 else K+1\n  W=np.zeros((dl,3,3,dr),complex)\n  for k in range(K):\n   if starts[k]==i:\n    W[0,:,:,k+1]=Ls[k].T\n   if starts[k]==i-1:\n    W[k+1,:,:,0]=Rs[k].T\n  nodes.append(tn.Node(W))\n for i in range(n-1): nodes[i][3]\"'^nodes[i+1][0]\n return quantum_constructor([n[2] for n in nodes],[n[1] for n in nodes],nodes,[nodes[0][0],nodes[-1][3]])\ndef refH(n):\n I=np.eye(3,dtype=complex); H=np.zeros((3**n,3**n),complex)\n H4t=H2.reshape(3,3,3,3)\n for i in range(n-1):\n  tens=np.zeros([3]*n+[3]*n,complex)\n  for a in range(3):\n   for b in range(3):\n    for c in range(3):\n     for d in range(3):\n      sl_out=[slice(None)]*n; sl_in=[slice(None)]*n\n      sl_out[i]=a; sl_out[i+1]=b; sl_in[i]=c; sl_in[i+1]=d\n      tens[tuple(sl_out)+tuple(sl_in)] += H4t[a,b,c,d]\n  H += tens.reshape(3**n,3**n)\n for i in range(n):\n  tens=np.zeros([3]*n+[3]*n,complex)\n  for a in range(3):\n   for c in range(3):\n    sl_out=[slice(None)]*n; sl_in=[slice(None)]*n\n    sl_out[i]=a; sl_in[i]=c\n    tens[tuple(sl_out)+tuple(sl_in)] = D*Sz2[a,c]\n  H += tens.reshape(3**n,3**n)\n return H\nfor n in [2,3]:\n Href=refH(n); E=make_mpo(n).eval_matrix()\n print('\"'n',n,'err',np.max(np.abs(E-Href)))\n import scipy.linalg as sla\n c=tc.Circuit(n,dim=3)\n for i in range(n):\n  h=np.random.randn(3,3)+1j*np.random.randn(3,3); h=h+h.conj().T\n  c.any(i,unitary=sla.expm(-1j*h),dim=3)\n # direct dense expectation via state\n psi=c.wavefunction(form='ket')\n direct=np.real((psi.conj().reshape(1,-1)@Href@psi)[0,0])\n print('direct',direct,'mpo',mpo_expectation(c,make_mpo(n)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
