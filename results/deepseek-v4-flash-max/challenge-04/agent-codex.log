{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_dm.py <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\n\n# 1-qubit exact channel test\nK0 = np.array([[np.sqrt(1-0.034),0],[0,np.sqrt(1-0.011)]], dtype=np.complex64)\nK1 = np.array([[0,np.sqrt(0.011)],[0,0]], dtype=np.complex64)\nK2 = np.array([[0,0],[np.sqrt(0.034),0]], dtype=np.complex64)\nkraus = [tc.gates.Gate(K0), tc.gates.Gate(K1), tc.gates.Gate(K2)]\n\ndef run(p):\n    c = tc.DMCircuit2(1, inputs=np.array([1,0], dtype=np.complex64))\n    c.general_kraus(kraus, 0)\n    return c.expectation((tc.gates.z(), [0]))\n\nprint(run(None))\nprint('expected', (1-0.034)*1 + 0.011*(-1))\n\n# 2-qubit parity with two noise channels after rxx\nK = kraus\ndef run2(p):\n    c = tc.DMCircuit2(2, inputs=np.array([1,0,0,0], dtype=np.complex64))\n    c.rxx(0,1, theta=p)\n    c.general_kraus(K, 0)\n    c.general_kraus(K, 1)\n    return c.expectation((tc.gates.z(), [0]), (tc.gates.z(), [1]))\nprint('parity', run2(0.31))\n\n# grad test\nfrom jax import grad\np = tc.num_to_tensor(0.31)\nprint('grad', grad(lambda x: tc.backend.real(run2(x)))(p))\nPY\npython /tmp/test_dm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
