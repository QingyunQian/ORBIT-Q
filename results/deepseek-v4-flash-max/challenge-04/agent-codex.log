nd(lab)\n    t=tc.cons.contractor(nodes, output_edge_order=[lab.get_edge(0)])\n    return tc.backend.real(t.tensor)\nt=time.time()\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: custom_table(k,p01,p10))\n    y=f(np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('\"'kind',kind,'first',time.time()-t,y[0],y[-1]); t=time.time()\n    for _ in range(2):\n        y=f(np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print(' 2x',time.time()-t); t=time.time()\n# optimizer\ntables=[]\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: custom_table(k,p01,p10))\n    tables.append(np.asarray(f(np.float32(0.034),np.float32(0.011)).block_until_ready()))\ntarget=np.stack(tables).astype(np.float32)\ndef table_all(p01,p10):\n    return tc.backend.stack([custom_table(k,p01,p10) for k in range(4)])\ndef loss(r):\n    p01=tc.backend.sigmoid(r[0]); p10=tc.backend.sigmoid(r[1])\n    fit=table_all(p01,p10)\n    return tc.backend.mean((fit-jnp.asarray(target))**2)\nt=time.time(); lv=jax.jit(jax.value_and_grad(loss))\nr0=np.array([np.log(.07/.93),np.log(.04/.96)],dtype=np.float32)\nval,g=lv(r0); print('loss grad compile',time.time()-t,val,g)\nt=time.time()\nfor _ in range(3): val,g=lv(r0)\nprint('3x',time.time()-t)\nm=np.zeros(2,np.float32); v=np.zeros(2,np.float32); r=r0.copy(); lr=np.float32(.04); b1=np.float32(.9); b2=np.float32(.999); eps=np.float32(1e-8)\nhist=[]; t=time.time()\nfor step in range(1,121):\n    val,g=lv(r); hist.append(np.asarray(val))\n    m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g\n    mh=m/(1-b1**step); vh=v/(1-b2**step)\n    r=r-lr*mh/(np.sqrt(vh)+eps)\nprint('120',time.time()-t,'p',jax.nn.sigmoid(r),'loss',np.asarray(val),hist[0],hist[-1])\nPY\npython /tmp/bench_custom_jit.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
