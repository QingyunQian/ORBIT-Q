{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport inspect\nfrom tensorcircuit.basecircuit import BaseCircuit\nprint(inspect.getsource(BaseCircuit._copy_state_tensor))\nPY\"","aggregated_output":"    def _copy_state_tensor(\n        self, conj: bool = False, reuse: bool = True\n    ) -> Tuple[List[tn.Node], List[tn.Edge]]:\n        if reuse:\n            t = getattr(self, \"state_tensor\", None)\n            if t is None:\n                nodes, d_edges = self._copy()\n                t = contractor(nodes, output_edge_order=d_edges)\n                setattr(self, \"state_tensor\", t)\n            ndict, edict = tn.copy([t], conjugate=conj)\n            newnodes = []\n            newnodes.append(ndict[t])\n            newfront = []\n            for e in t.edges:\n                newfront.append(edict[e])\n            return newnodes, newfront\n        return self._copy(conj)\n\n","exit_code":0,"status":"completed"}}
