{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport inspect\nfrom tensorcircuit.basecircuit import _split_two_qubit_gate\nprint(inspect.getsource(_split_two_qubit_gate))\nPY\"","aggregated_output":"def _split_two_qubit_gate(\n    a: tn.Node,\n    max_singular_values: Optional[int] = None,\n    max_truncation_err: Optional[float] = None,\n    fixed_choice: Optional[int] = None,\n) -> Any:\n    if (max_singular_values is not None) and (fixed_choice is None):\n        fixed_choice = 1\n    ndict, _ = tn.copy([a])\n    n = ndict[a]\n    n1, n2, _ = tn.split_node(\n        n,\n        left_edges=[n[0], n[2]],\n        right_edges=[n[1], n[3]],\n        max_singular_values=max_singular_values,\n        max_truncation_err=max_truncation_err,\n    )\n    if fixed_choice == 1:\n        # still considering better API type for fixed_choice\n        return n1, n2, False\n    s1 = n1.tensor.shape[-1]  # bond dimension\n    n3, n4, _ = tn.split_node(\n        n,\n        left_edges=[n[0], n[3]],\n        right_edges=[n[1], n[2]],\n        max_singular_values=max_singular_values,\n        max_truncation_err=max_truncation_err,\n    )\n    if fixed_choice == 2:  # swap one\n        return n3, n4, True  # swap\n    s2 = n3.tensor.shape[-1]\n    if (s1 >= n[0].dimension * n[2].dimension) and (\n        s2 >= n[1].dimension * n[3].dimension\n    ):\n        # jax jit unspport split_node with trun_err anyway\n        # tf function doesn't work either, though I believe it may work on tf side\n        # CANNOT DONE(@refraction-ray): tf.function version with trun_err set\n        return None\n    if s1 <= s2:  # equal is necessary for max values to pick on unswap one\n        return n1, n2, False  # no swap\n    return n3, n4, True  # swap\n\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_split.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nN=12\ndef mk_kraus(p01,p10):\n    K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],dtype=np.complex64)\n    K1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64)\n    K2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return [tc.gates.Gate(K0),tc.gates.Gate(K1),tc.gates.Gate(K2)]\nK=mk_kraus(0.034,0.011)\ndef prep(c, kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind, split):\n    c=tc.DMCircuit2(N, split=split); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\n\ndef table(kind, split):\n    c=circuit(kind,split)\n    vals=[]\n    for i in range(N):\n        vals.append(c.expectation((tc.gates.z(),[i])))\n    vals.append(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]))\n    return tc.backend.stack([tc.backend.real(v) for v in vals])\n\nfor ms in [2,4,8,16]:\n    print('ms',ms)\n    allvals=[]\n    t0=time.time()\n    for kind in range(4):\n        t=time.time(); v=table(kind, {'max_singular_values':ms}); print(kind, time.time()-t, v[0],v[-1]); allvals.append(v)\n    print('total',time.time()-t0)\nPY\npython /tmp/bench_split.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
