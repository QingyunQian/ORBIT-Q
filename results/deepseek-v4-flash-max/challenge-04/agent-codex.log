{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_custom_obs.py <<'PY'\nimport time, numpy as np\nimport tensornetwork as tn\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nN=12\ndef mk_kraus(p01,p10):\n    z=tc.num_to_tensor(0.0); o=tc.num_to_tensor(1.0)\n    K0=tc.gates.Gate(tc.backend.stack([tc.backend.stack([tc.backend.sqrt(1-p01),z]),tc.backend.stack([z,tc.backend.sqrt(1-p10)])]))\n    K1=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,tc.backend.sqrt(p10)]),tc.backend.stack([z,z])]))\n    K2=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,z]),tc.backend.stack([tc.backend.sqrt(p01),z])]))\n    return [K0,K1,K2]\ndef prep(c, kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind,K):\n    c=tc.DMCircuit2(N, split={'max_singular_values':8}); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\n# build label tensor\nsize=1<<N\nL=np.zeros((N+1,size),dtype=np.complex64)\nfor i in range(N):\n    for b in range(size):\n        L[i,b]=1.0 if ((b>>i)&1)==0 else -1.0\nfor b in range(size):\n    L[N,b]=1.0 if b.bit_count()%2==0 else -1.0\nL=L.reshape((N+1,)+ (2,)*N)\ndef custom_table(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    nodes, front = c._copy()\n    # CopyNodes for diagonal\n    diag=[]\n    for i in range(N):\n        cn=tn.CopyNode(3,2,dtype=np.complex64)\n        cn[0] \"'^ front[i]\n        cn[1] ''^ front[i+N]\n        nodes.append(cn)\n        diag.append(cn[2])\n    # label node\n    lab=tn.Node(tc.num_to_tensor(L), name='\"'obs')\n    for i,e in enumerate(diag):\n        e \"'^ lab.get_edge(i+1)\n    nodes.append(lab)\n    t=tc.cons.contractor(nodes, output_edge_order=[lab.get_edge(0)])\n    return tc.backend.real(t.tensor)\nK=mk_kraus(0.034,0.011)\nfor kind in range(4):\n    t=time.time(); y=custom_table(kind,0.034,0.011); print(kind,time.time()-t,y[:3],y[-1])\nPY\npython /tmp/bench_custom_obs.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
