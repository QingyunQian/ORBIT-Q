{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_traceprod.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nN=12\ndef mk_kraus(p01,p10):\n    z=tc.num_to_tensor(0.0); o=tc.num_to_tensor(1.0)\n    K0=tc.gates.Gate(tc.backend.stack([tc.backend.stack([tc.backend.sqrt(1-p01),z]),tc.backend.stack([z,tc.backend.sqrt(1-p10)])]))\n    K1=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,tc.backend.sqrt(p10)]),tc.backend.stack([z,z])]))\n    K2=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,z]),tc.backend.stack([tc.backend.sqrt(p01),z])]))\n    return [K0,K1,K2]\ndef prep(c,kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind,K):\n    c=tc.DMCircuit2(N); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\n# build dense Z Pauli strings as numpy complex64\nZ=np.array([[1,0],[0,-1]],dtype=np.complex64)\nops=[]\nfor i in range(N):\n    op=np.array([[1]],dtype=np.complex64)\n    for j in range(N):\n        op=np.kron(op, Z if j==i else np.eye(2,dtype=np.complex64))\n    ops.append(op)\nop=np.array([[1]],dtype=np.complex64)\nfor j in range(N): op=np.kron(op,Z)\nops.append(op)\nops=np.stack(ops) # (13,4096,4096)\nO=tc.num_to_tensor(ops)\ndef table_one(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    dm=c.densitymatrix()\n    vals=tc.backend.einsum('nij,ji->n', O, dm)  # trace O @ rho\n    return tc.backend.real(vals)\njtable={}\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    jtable[kind]=f\n    t=time.time(); y=f(np.float32(0.034),np.float32(0.011)).block_until_ready(); print('kind',kind,'first',time.time()-t,y[0],y[-1])\nfor kind in range(4):\n    t=time.time()\n    for _ in range(3):\n        y=jtable[kind](np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('kind',kind,'3x',time.time()-t)\nPY\npython /tmp/bench_traceprod.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
