{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_opt.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nN=12\nSIGNS = np.empty((12, 1<<N), dtype=np.float32)\nfor i in range(N):\n    SIGNS[i] = np.array([1 if ((b>>i)&1)==0 else -1 for b in range(1<<N)], dtype=np.float32)\nPAR = np.array([1 if bin(b).count('1')%2==0 else -1 for b in range(1<<N)], dtype=np.float32)\n\ndef mk_kraus(p01,p10):\n    z=tc.num_to_tensor(0.0); o=tc.num_to_tensor(1.0)\n    K0=tc.gates.Gate(tc.backend.stack([tc.backend.stack([tc.backend.sqrt(1-p01),z]),tc.backend.stack([z,tc.backend.sqrt(1-p10)])]))\n    K1=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,tc.backend.sqrt(p10)]),tc.backend.stack([z,z])]))\n    K2=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,z]),tc.backend.stack([tc.backend.sqrt(p01),z])]))\n    return [K0,K1,K2]\n\ndef prep(c, kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\n\ndef circuit(kind,K):\n    c=tc.DMCircuit2(N, split={'max_singular_values':8}); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\n\ndef table_one(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    dm=c.densitymatrix()\n    diag=tc.backend.real(tc.backend.diagonal(dm))\n    zs=tc.backend.einsum('ni,i->n', tc.num_to_tensor(SIGNS), diag)\n    par=tc.backend.sum(tc.num_to_tensor(PAR)*diag)\n    return tc.backend.concat([zs, tc.backend.reshape(par,[1])])\n\ntables=[]\nt=time.time()\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    y=f(np.float32(0.034),np.float32(0.011)).block_until_ready()\n    tables.append(y)\n    print('kind',kind,'compile+run',time.time()-t); t=time.time()\ntarget=np.stack(tables)\n\ndef table_all(p01,p10):\n    return tc.backend.stack([table_one(k,p01,p10) for k in range(4)])\n\ndef loss(r):\n    p01=tc.backend.sigmoid(r[0]); p10=tc.backend.sigmoid(r[1])\n    fit=table_all(p01,p10)\n    return tc.backend.mean((fit-tc.num_to_tensor(target))**2)\n\nt=time.time()\nloss_and_grad=jax.jit(jax.value_and_grad(loss))\nr0=np.array([np.log(0.070/0.930), np.log(0.040/0.960)], dtype=np.float32)\nval,g=loss_and_grad(r0)\nprint('loss grad compile',time.time()-t, val, g)\nt=time.time()\nfor _ in range(3):\n    val,g=loss_and_grad(r0)\nprint('3x',time.time()-t)\n\n# Adam 120\nm=np.zeros(2,dtype=np.float32); v=np.zeros(2,dtype=np.float32)\nr=r0.copy(); lr=np.float32(0.04); b1=np.float32(0.9); b2=np.float32(0.999); eps=np.float32(1e-8)\nhist=[]\nt=time.time()\nfor step in range(1,121):\n    val,g=loss_and_grad(r)\n    hist.append(val)\n    m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g\n    mhat=m/(1-b1**step); vhat=v/(1-b2**step)\n    r=r-lr*mhat/(np.sqrt(vhat)+eps)\nprint('120 steps',time.time()-t)\np=jax.nn.sigmoid(r)\nprint('p',p,'loss',val,'hist0',hist[0], 'histlast',hist[-1])\nPY\npython /tmp/bench_opt.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
