('kind',kind,'first',time.time()-t,y[0],y[-1])\nfor kind in range(4):\n    t=time.time()\n    for _ in range(3):\n        y=jtable[kind](np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('kind',kind,'3x',time.time()-t)\nPY\npython /tmp/bench_rdm_jit.py\"","aggregated_output":"kind 0 first 3.6550419330596924 -0.044964194 0.37874982\nkind 1 first 3.031540870666504 -0.04496491 0.32658395\nkind 2 first 2.9156880378723145 0.82358706 0.1885467\nkind 3 first 3.255326986312866 -0.04496491 -1.3387762e-09\nkind 0 3x 6.570975065231323\nkind 1 3x 5.807219505310059\nkind 2 3x 5.707084655761719\nkind 3 3x 5.799683332443237\n","exit_code":0,"status":"completed"}}
