{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_dm.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\n\nN=12\np01=0.034; p10=0.011\n\ndef mk_kraus(p01,p10):\n    K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],dtype=np.complex64)\n    K1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64)\n    K2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return [tc.gates.Gate(K0),tc.gates.Gate(K1),tc.gates.Gate(K2)]\n\nK=mk_kraus(p01,p10)\n\ndef prep(c, kind):\n    if kind==0: # GHZ\n        c.h(0)\n        for i in range(1,N):\n            c.cnot(0,i)\n    elif kind==1: # bell pairs\n        for i in range(0,N,2):\n            c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: # zeros\n        pass\n    else: # plus\n        for i in range(N):\n            c.h(i)\n\ndef circuit(kind, K):\n    c=tc.DMCircuit2(N)\n    prep(c,kind)\n    # even\n    for i in range(0,N,2):\n        c.rxx(i,i+1, theta=0.31)\n    for i in range(N):\n        c.general_kraus(K,i)\n    # odd\n    for i in range(1,N-1,2):\n        c.rxx(i,i+1, theta=0.31)\n    for i in range(N):\n        c.general_kraus(K,i)\n    return c\n\ndef table(kind,K):\n    c=circuit(kind,K)\n    vals=[]\n    for i in range(N):\n        vals.append(c.expectation((tc.gates.z(),[i])))\n    vals.append(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]))\n    return tc.backend.stack([tc.backend.real(v) for v in vals])\n\nfor kind in range(4):\n    t=time.time(); v=table(kind,K); print(kind, time.time()-t, v[:3], v[-1])\nPY\npython /tmp/bench_dm.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
