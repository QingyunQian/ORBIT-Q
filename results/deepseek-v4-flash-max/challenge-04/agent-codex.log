{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_jit.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nN=12\ndef mk_kraus(p01,p10):\n    K0=np.array([[np.sqrt(1-p01),0],[0,np.sqrt(1-p10)]],dtype=np.complex64)\n    K1=np.array([[0,np.sqrt(p10)],[0,0]],dtype=np.complex64)\n    K2=np.array([[0,0],[np.sqrt(p01),0]],dtype=np.complex64)\n    return [tc.gates.Gate(K0),tc.gates.Gate(K1),tc.gates.Gate(K2)]\ndef prep(c, kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind, K):\n    c=tc.DMCircuit2(N); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\ndef table_one(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    vals=[]\n    for i in range(N):\n        vals.append(c.expectation((tc.gates.z(),[i])))\n    vals.append(c.expectation(*[(tc.gates.z(),[i]) for i in range(N)]))\n    return tc.backend.stack([tc.backend.real(v) for v in vals])\njtable={}\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    jtable[kind]=f\n    t=time.time(); y=f(np.float32(0.034),np.float32(0.011)).block_until_ready(); print('kind',kind,'first',time.time()-t,y[0],y[-1])\n# timed repeats\nfor kind in range(4):\n    t=time.time()\n    for _ in range(3):\n        y=jtable[kind](np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('kind',kind,'3x',time.time()-t)\nPY\npython /tmp/bench_jit.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
