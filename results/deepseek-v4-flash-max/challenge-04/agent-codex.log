{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, numpy as np\nimport solution_4\ncfg = {\n    \\\"n_qubits\\\": 12,\n    \\\"entangler_angle\\\": 0.31,\n    \\\"true_p01\\\": 0.034,\n    \\\"true_p10\\\": 0.011,\n    \\\"initial_p01\\\": 0.070,\n    \\\"initial_p10\\\": 0.040,\n    \\\"max_steps\\\": 120,\n    \\\"learning_rate\\\": 0.04,\n    \\\"probability_absolute_tolerance\\\": 2e-4,\n}\nt=time.time(); res=solution_4.run_solution(cfg); dt=time.time()-t\ntrue=np.array([cfg['true_p01'], cfg['true_p10']])\nfit=res['final_probabilities']\nK0=np.diag([np.sqrt(1-fit[0]), np.sqrt(1-fit[1])])\nK1=np.array([[0,np.sqrt(fit[1])],[0,0]])\nK2=np.array([[0,0],[np.sqrt(fit[0]),0]])\ntp_err=np.max(np.abs(K0.conj().T@K0+K1.conj().T@K1+K2.conj().T@K2-np.eye(2)))\nchecks = {\n 'runtime': dt,\n 'len': len(res['loss_history']),\n 'probs_shape': res['final_probabilities'].shape,\n 'fit_shape': res['fitted_expectations'].shape,\n 'final_loss<initial': res['loss_history'][-1] < res['loss_history'][0],\n 'abs_err': np.abs(fit-true),\n 'tp_err': tp_err,\n 'keys': sorted(res.keys()),\n}\nprint(checks)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
