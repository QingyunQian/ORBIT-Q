{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_opt_exp.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nimport jax.numpy as jnp\nN=12\ndef mk_kraus(p01,p10):\n    z=tc.num_to_tensor(0.0); o=tc.num_to_tensor(1.0)\n    K0=tc.gates.Gate(tc.backend.stack([tc.backend.stack([tc.backend.sqrt(1-p01),z]),tc.backend.stack([z,tc.backend.sqrt(1-p10)])]))\n    K1=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,tc.backend.sqrt(p10)]),tc.backend.stack([z,z])]))\n    K2=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,z]),tc.backend.stack([tc.backend.sqrt(p01),z])]))\n    return [K0,K1,K2]\ndef prep(c, kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind,K):\n    c=tc.DMCircuit2(N, split={'max_singular_values':8}); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\ndef table_one(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    v0=c.expectation((tc.gates.z(),[0]))\n    v1=c.expectation((tc.gates.z(),[1]))\n    par=c.expectation(*[(tc.gates.z(),[i]) for i in range(N)])\n    vals=[tc.backend.real(v0)]+[tc.backend.real(v1)]*(N-2)+[tc.backend.real(v0)]+[tc.backend.real(par)]\n    return tc.backend.stack(vals)\n# check values vs exact diag target known from prior\nt=time.time()\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    y=f(np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('kind',kind,'first',time.time()-t,y[0],y[1],y[-1]); t=time.time()\n# optimize\ntables=[]\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    tables.append(np.asarray(f(np.float32(0.034),np.float32(0.011)).block_until_ready()))\ntarget=np.stack(tables).astype(np.float32)\ndef table_all(p01,p10):\n    return tc.backend.stack([table_one(k,p01,p10) for k in range(4)])\ndef loss(r):\n    p01=tc.backend.sigmoid(r[0]); p10=tc.backend.sigmoid(r[1])\n    fit=table_all(p01,p10)\n    return tc.backend.mean((fit-jnp.asarray(target))**2)\nt=time.time(); lv=jax.jit(jax.value_and_grad(loss))\nr0=np.array([np.log(0.07/0.93),np.log(0.04/0.96)],dtype=np.float32)\nval,g=lv(r0); print('loss grad compile',time.time()-t,val,g)\nt=time.time()\nfor _ in range(3): val,g=lv(r0)\nprint('3x',time.time()-t)\nm=np.zeros(2,np.float32); v=np.zeros(2,np.float32); r=r0.copy(); lr=np.float32(0.04); b1=np.float32(.9); b2=np.float32(.999); eps=np.float32(1e-8)\nhist=[]; t=time.time()\nfor step in range(1,121):\n    val,g=lv(r); hist.append(np.asarray(val))\n    m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g\n    mh=m/(1-b1**step); vh=v/(1-b2**step)\n    r=r-lr*mh/(np.sqrt(vh)+eps)\nprint('120',time.time()-t,'p',jax.nn.sigmoid(r),'loss',np.asarray(val),hist[0],hist[-1])\nPY\npython /tmp/bench_opt_exp.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
