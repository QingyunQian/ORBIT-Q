{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_diag.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nN=12\ndef mk_kraus(p01,p10):\n    z=tc.num_to_tensor(0.0); o=tc.num_to_tensor(1.0)\n    K0=tc.gates.Gate(tc.backend.stack([tc.backend.stack([tc.backend.sqrt(1-p01),z]),tc.backend.stack([z,tc.backend.sqrt(1-p10)])]))\n    K1=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,tc.backend.sqrt(p10)]),tc.backend.stack([z,z])]))\n    K2=tc.gates.Gate(tc.backend.stack([tc.backend.stack([z,z]),tc.backend.stack([tc.backend.sqrt(p01),z])]))\n    return [K0,K1,K2]\ndef prep(c,kind):\n    if kind==0:\n        c.h(0)\n        for i in range(1,N): c.cnot(0,i)\n    elif kind==1:\n        for i in range(0,N,2): c.h(i); c.cnot(i,i+1); c.x(i)\n    elif kind==2: pass\n    else:\n        for i in range(N): c.h(i)\ndef circuit(kind,K):\n    c=tc.DMCircuit2(N); prep(c,kind)\n    for i in range(0,N,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    for i in range(1,N-1,2): c.rxx(i,i+1, theta=0.31)\n    for i in range(N): c.general_kraus(K,i)\n    return c\ndef table_one(kind,p01,p10):\n    K=mk_kraus(p01,p10)\n    c=circuit(kind,K)\n    dm=c.densitymatrix()\n    diag=tc.backend.real(tc.backend.diag_part(dm))\n    diag=tc.backend.reshape(diag, [2]*N)\n    signs=tc.backend.stack([tc.backend.reshape(tc.backend.convert_to_tensor(np.array([1 if (b>>i)&1==0 else -1 for b in range(1<<N)], dtype=np.float32)), [2]*N) for i in range(N)])\n    # signs shape (N,2,...,2); multiply diag broadcast: need diag[None,...]\n    vals=tc.backend.sum(signs*tc.backend.reshape(diag,[1]+[2]*N), axis=tuple(range(1,N+1)))\n    par=tc.backend.sum(tc.backend.prod(signs,axis=0)*diag)\n    return tc.backend.concat([vals,tc.backend.reshape(par,[1])])\njtable={}\nfor kind in range(4):\n    f=jax.jit(lambda p01,p10,k=kind: table_one(k,p01,p10))\n    jtable[kind]=f\n    t=time.time(); y=f(np.float32(0.034),np.float32(0.011)).block_until_ready(); print('kind',kind,'first',time.time()-t,y)\nfor kind in range(4):\n    t=time.time()\n    for _ in range(3):\n        y=jtable[kind](np.float32(0.034),np.float32(0.011)).block_until_ready()\n    print('kind',kind,'3x',time.time()-t)\nPY\npython /tmp/bench_diag.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
