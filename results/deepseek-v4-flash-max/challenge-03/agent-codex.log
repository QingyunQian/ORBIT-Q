{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cd /root && python - <<'PY'\nimport tensorcircuit as tc\nimport jax, jax.numpy as jnp\nimport numpy as np, time\ntc.set_backend('jax')\nn=4\ndim=2**n\n\ndef forward(theta):\n    # initial |+>\"'^n\n    psi = jnp.full((dim,), 1.0/jnp.sqrt(dim), dtype=jnp.complex64)\n    c = tc.Circuit(n, inputs=psi)\n    # one layer: even bonds\n    for i in range(0,n,2):\n        c.rxx(i,i+1, theta=2*theta[2*(i//2)])\n        c.rzz(i,i+1, theta=2*theta[2*(i//2)+1])\n    for i in range(n):\n        c.rx(i, theta=theta[4+i])\n    # postselect even 0,2: get cumulative prefix probs via measure_jit on normalized state before postselect\n    status = jnp.zeros(2)\n    # measure_jit returns sample and p total\n    # need individual prefix probabilities; call for prefixes\n    probs = []\n    for k in range(1,3):\n        _, p = c.measure_jit(*range(0,2*k,2), with_prob=True, status=jnp.zeros(k))\n        probs.append(p)\n    cond0 = probs[0]\n    cond1 = probs[1]/probs[0]\n    # postselect\n    c.post_select(0); c.post_select(2)\n    un = c.state()\n    norm2 = jnp.real(jnp.sum(jnp.abs(un)**2))\n    psi2 = un/jnp.sqrt(norm2)\n    # energy expectation using tc.expectation\n    e = jnp.real(tc.expectation((tc.gates.z(), [0]), ket=psi2))\n    return e, cond0, cond1, norm2, un\n\ntheta=jnp.zeros(6)\nprint('\"'eager:')\nout=forward(theta)\nfor x in out: print(x)\nprint('jit:')\nf=jax.jit(forward)\nout2=f(theta)\nfor x in out2: print(x)\n# grad\nprint('grad:')\ng=jax.grad(lambda t: forward(t)[0])(theta)\nprint(g)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
