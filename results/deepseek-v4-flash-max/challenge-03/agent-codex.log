3=time.time()\n    lp=fv(plus); lm=fv(minus); t4=time.time()\n    g=0.5*(lp-lm).reshape(theta.shape); t5=time.time()\n    m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g\n    mh=m/(1-b1**(step+1)); vh=v/(1-b2**(step+1))\n    theta=theta-lr*mh/(jnp.sqrt(vh)+epsa); t6=time.time()\n    print(step, 'fm',t2-t1,'build',t3-t2,'fv',t4-t3,'g',t5-t4,'adam',t6-t5,'total',t6-t1, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
