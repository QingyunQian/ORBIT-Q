{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 280 python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, time, numpy as np\ntc.set_backend('jax')\nn=12; N=2**n; evens=tuple(range(0,n,2)); bonds_even=[(i,i+1) for i in range(0,n,2)]; bonds_odd=[(i,i+1) for i in range(1,n-1,2)]\nls=[]; weights=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=3; r[i+1]=3; ls.append(r); weights.append(-1.0)\nfor i in range(n):\n    r=[0]*n; r[i]=1; ls.append(r); weights.append(-0.9)\nmvp=tc.quantum.PauliStringSum2MVP(ls, weights)\ndef forward(theta):\n    psi=jnp.full((N,),1/jnp.sqrt(N),dtype=jnp.complex64); logs=[]; S=1.0\n    for t in range(10):\n        c=tc.Circuit(n,inputs=psi); bonds=bonds_even if t%2==0 else bonds_odd; tth=theta[t]\n        for b,(i,j) in enumerate(bonds):\n            c.rxx(i,j,theta=2*tth[2*b]); c.rzz(i,j,theta=2*tth[2*b+1])\n        for q in range(n): c.rx(q,theta=tth[12+q])\n        for q in evens:\n            c.post_select(q); un=c.state(); S2=jnp.real(jnp.sum(jnp.abs(un)**2)); logs.append(jnp.log(S2/S+1e-12)); S=S2; psi=un\n    e=jnp.real(jnp.vdot(psi,mvp(psi)))/S/n\n    logs=jnp.stack(logs); mlp=jnp.mean(logs)\n    return e, mlp\ndef loss(theta):\n    e,mlp=forward(theta); return e-0.05*mlp\nkey=jax.random.PRNGKey(1); theta=0.1*jax.random.normal(key,(10,24),dtype=jnp.float32)\nprint('compile forward', flush=True); t0=time.time(); f=jax.jit(loss); f(theta); print('forward compiled', time.time()-t0, flush=True)\nprint('compile grad', flush=True); t0=time.time(); gf=jax.jit(jax.grad(loss)); g=gf(theta); print('grad compiled', time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 260 python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, time, numpy as np\ntc.set_backend('jax')\nn=12; N=2**n; evens=tuple(range(0,n,2)); bonds_even=[(i,i+1) for i in range(0,n,2)]; bonds_odd=[(i,i+1) for i in range(1,n-1,2)]\ndef energy(psi):\n    e=0.0\n    for i in range(n-1): e=e+jnp.real(tc.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]),ket=psi))\n    for i in range(n): e=e-0.9*jnp.real(tc.expectation((tc.gates.x(),[i]),ket=psi))\n    return e\ndef forward(theta):\n    psi=jnp.full((N,),1/jnp.sqrt(N),dtype=jnp.complex64); logs=[]\n    for t in range(10):\n        c=tc.Circuit(n,inputs=psi); bonds=bonds_even if t%2==0 else bonds_odd; tth=theta[t]\n        for b,(i,j) in enumerate(bonds):\n            c.rxx(i,j,theta=2*tth[2*b]); c.rzz(i,j,theta=2*tth[2*b+1])\n        for q in range(n): c.rx(q,theta=tth[12+q])\n        n2=1.0\n        for q in evens:\n            c.post_select(q); un=c.state(); n2a=jnp.real(jnp.sum(jnp.abs(un)**2)); logs.append(jnp.log(n2a/n2+1e-12)); n2=n2a\n        psi=un/jnp.sqrt(n2)\n    e=energy(psi); logs=jnp.stack(logs); mlp=jnp.mean(logs)\n    return e/N, mlp\ndef loss(theta):\n    e,mlp=forward(theta); return e-0.05*mlp\ndef metrics(theta):\n    e,mlp=forward(theta); return e, jnp.exp(60*mlp), mlp, e-0.05*mlp\ndef adam(theta,m,v,g,step):\n    m=0.9*m+0.1*g; v=0.999*v+0.001*g*g\n    mh=m/(1-0.9**(step+1)); vh=v/(1-0.999**(step+1))\n    return theta-0.01*mh/(jnp.sqrt(vh)+1e-8), m, v\nkey=jax.random.PRNGKey(1); theta=0.1*jax.random.normal(key,(10,24),dtype=jnp.float32)\nshifts=jnp.zeros((240,10,24),dtype=jnp.float32).at[jnp.arange(240)//24, jnp.arange(240)%24].set(0.5*np.pi)\nprint('compile', flush=True); t0=time.time(); fm=jax.jit(metrics); fv=jax.jit(jax.vmap(loss)); adamj=jax.jit(adam)\nfm(theta); fv(theta[None]+shifts); adamj(theta,jnp.zeros_like(theta),jnp.zeros_like(theta),jnp.ones_like(theta),0)\nprint('compiled', time.time()-t0, flush=True)\nm=jnp.zeros_like(theta); v=jnp.zeros_like(theta)\nhist=[]\nfor step in range(300):\n    met=fm(theta)\n    hist.append(met)\n    lp=fv(theta[None]+shifts); lm=fv(theta[None]-shifts)\n    g=0.5*(lp-lm).reshape(theta.shape)\n    theta,m,v=adamj(theta,m,v,g,step)\n    if step%50==49: print('step',step+1,'time',time.time()-t0, flush=True)\nprint('final', fm(theta), 'time', time.time()-t0, flush=True)\nPY\"","aggregated_output":"compile\ncompiled 18.226150274276733\nstep 50 time 78.67254543304443\nstep 100 time 133.27162885665894\nstep 150 time 190.4690318107605\nstep 200 time 254.27953124046326\n","exit_code":124,"status":"failed"}}
