{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 60 python - <<'PY'\nimport jax, jax.numpy as jnp, time, numpy as np\nx=jnp.zeros((10,24),dtype=jnp.float32); m=jnp.zeros_like(x); v=jnp.zeros_like(x)\nfor k in range(10):\n    g=jnp.ones_like(x)*0.1\n    t0=time.time()\n    m=0.9*m+0.1*g\n    v=0.999*v+0.001*g*g\n    mh=m/(1-0.9**(k+1)); vh=v/(1-0.999**(k+1))\n    x=x-0.01*mh/(jnp.sqrt(vh)+1e-8)\n    print(k, time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
