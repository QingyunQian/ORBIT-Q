{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cd /root && timeout 250 python - <<'PY'\nimport tensorcircuit as tc, jax, jax.numpy as jnp, time, numpy as np\ntc.set_backend('jax')\nn=12; N=2**n; evens=tuple(range(0,n,2)); bonds_even=[(i,i+1) for i in range(0,n,2)]; bonds_odd=[(i,i+1) for i in range(1,n-1,2)]\ndef energy(psi):\n    e=0.0\n    for i in range(n-1): e=e+jnp.real(tc.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1]),ket=psi))\n    for i in range(n): e=e-0.9*jnp.real(tc.expectation((tc.gates.x(),[i]),ket=psi))\n    return e\ndef forward(theta):\n    psi=jnp.full((N,),1/jnp.sqrt(N),dtype=jnp.complex64); logs=[]\n    for t in range(10):\n        c=tc.Circuit(n,inputs=psi); bonds=bonds_even if t%2==0 else bonds_odd; tth=theta[t]\n        for b,(i,j) in enumerate(bonds):\n            c.rxx(i,j,theta=2*tth[2*b]); c.rzz(i,j,theta=2*tth[2*b+1])\n        for q in range(n): c.rx(q,theta=tth[12+q])\n        n2=1.0\n        for q in evens:\n            c.post_select(q); un=c.state(); n2a=jnp.real(jnp.sum(jnp.abs(un)**2)); logs.append(jnp.log(n2a/n2+1e-12)); n2=n2a\n        psi=un/jnp.sqrt(n2)\n    e=energy(psi); logs=jnp.stack(logs); mlp=jnp.mean(logs)\n    return e/N, mlp\ndef metrics(theta):\n    e,mlp=forward(theta); return e, jnp.exp(60*mlp), mlp, e-0.05*mlp\nf=jax.jit(metrics)\nkey=jax.random.PRNGKey(1); theta=0.1*jax.random.normal(key,(10,24),dtype=jnp.float32)\nprint('start', flush=True); t0=time.time(); f(theta); print('compiled', time.time()-t0, flush=True)\nm=jnp.zeros_like(theta); v=jnp.zeros_like(theta); b1=0.9; b2=0.999; epsa=1e-8; lr=0.01\nhist=[]\nfor step in range(300):\n    e,success,mlp,loss=f(theta)\n    hist.append((np.float32(e), np.float32(success), np.float32(mlp), np.float32(loss)))\n    # gradient with parameter shift\n    gparts=[]\n    for idx in range(240):\n        t=idx//24; r=idx%24\n        tp=theta.at[t,r].add(0.5*np.pi)\n        tm=theta.at[t,r].add(-0.5*np.pi)\n        gparts.append(0.5*(f(tp)[3]-f(tm)[3]))\n    g=jnp.stack(gparts).reshape(theta.shape)\n    m=b1*m+(1-b1)*g; v=b2*v+(1-b2)*g*g\n    mh=m/(1-b1**(step+1)); vh=v/(1-b2**(step+1))\n    theta=theta-lr*mh/(jnp.sqrt(vh)+epsa)\n    if step%50==49:\n        print('step',step+1,'loss',loss,'time',time.time()-t0, flush=True)\nprint('final', f(theta), 'time', time.time()-t0, flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
