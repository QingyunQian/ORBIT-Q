{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cd /root && cat > /tmp/proto3.py <<'PY'\nimport tensorcircuit as tc\nimport jax, jax.numpy as jnp\nimport numpy as np, time, sys\ntc.set_backend('jax')\nn=12\nN=2**n\nevens=tuple(range(0,n,2))\nbonds_even=[(i,i+1) for i in range(0,n,2)]\nbonds_odd=[(i,i+1) for i in range(1,n-1,2)]\n\ndef energy(psi):\n    # TC expectation per term\n    e=0.0\n    for i in range(n-1):\n        e = e + jnp.real(tc.expectation((tc.gates.z(), [i]),(tc.gates.z(), [i+1]), ket=psi))\n    for i in range(n):\n        e = e - 0.9*jnp.real(tc.expectation((tc.gates.x(), [i]), ket=psi))\n    return e\n\ndef step_params(theta):\n    # theta shape (10, 24): first 12 xx/zz pairs, then 12 rx\n    pass\n\ndef forward(theta):\n    psi = jnp.full((N,), 1.0/jnp.sqrt(N), dtype=jnp.complex64)\n    logs=[]\n    prods=[]\n    for t in range(10):\n        c=tc.Circuit(n, inputs=psi)\n        bonds = bonds_even if t%2==0 else bonds_odd\n        tth=theta[t]\n        for b,(i,j) in enumerate(bonds):\n            c.rxx(i,j, theta=2*tth[2*b])\n            c.rzz(i,j, theta=2*tth[2*b+1])\n        for q in range(n):\n            c.rx(q, theta=tth[12+q])\n        # conditional event probabilities via prefixes\n        cum=1.0\n        for k in range(6):\n            _,p = c.measure_jit(*evens[:k+1], with_prob=True, status=jnp.zeros(k+1))\n            cond = p/cum\n            logs.append(jnp.log(cond+1e-12))\n            cum=p\n            prods.append(cum)\n        # postselect all\n        for q in evens:\n            c.post_select(q)\n        un=c.state()\n        norm2=jnp.real(jnp.sum(jnp.abs(un)**2))\n        psi=un/jnp.sqrt(norm2)\n    e=energy(psi)\n    lp=jnp.stack(logs)\n    mlp=jnp.mean(jnp.log(jnp.clip(cond,1e-12,None))) # wrong placeholder\n    return e/N, norm2\n\ndef loss(theta):\n    e, norm2 = forward(theta)\n    # placeholder actual mlp\n    return e - 0.05*(-60)\n\nif __name__=='__main__':\n    key=jax.random.PRNGKey(0)\n    theta=jax.random.normal(key,(10,24))*0.1\n    t0=time.time(); out=forward(theta); print('eager forward', time.time()-t0, out[0], out[1])\n    f=jax.jit(forward)\n    t0=time.time(); out2=f(theta); print('jit forward first', time.time()-t0, out2)\n    t0=time.time(); out3=f(theta); print('jit forward second', time.time()-t0, out3)\n    t0=time.time(); g=jax.jit(jax.grad(loss))(theta); print('jit grad', time.time()-t0)\nPY\npython /tmp/proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
