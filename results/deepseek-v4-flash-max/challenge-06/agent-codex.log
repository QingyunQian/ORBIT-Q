{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax'); tc.set_dtype('complex128')\nn=14\nls=[]; ws=[]\nfor i in range(n-1):\n    for p,w in [(1,0.7),(2,0.7),(3,1.1)]:\n        r=[0]*n; r[i]=r[i+1]=p; ls.append(r); ws.append(w)\nfor i in range(n):\n    r=[0]*n; r[i]=3; ls.append(r); ws.append(0.25*((-1)**i))\nH=tc.quantum.PauliStringSum2COO(ls,ws,numpy=False)\nxy_rows=[]; z_rows=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; xy_rows.append(r)\n    r=[0]*n; r[i]=r[i+1]=2; xy_rows.append(r)\nfor i in range(n):\n    r=[0]*n; r[i]=3; z_rows.append(r)\nxy_mvp=tc.quantum.PauliStringSum2MVP(xy_rows,[1.0]*len(xy_rows))\nz_mvp=tc.quantum.PauliStringSum2MVP(z_rows,[1.0]*len(z_rows))\ninit=tc.Circuit(n)\nfor i in range(1,n,2): init.x(i)\npsi0=init.state()\nrng=np.random.default_rng(42)\nrot=rng.normal(0,0.1,(4,n,3)); s=np.zeros(4); j=np.ones(4)*0.1; d=np.ones(4)*0.1\nparams=(rot,s,j,d)\n\ndef make_energy(ode_backend='jaxode'):\n    def energy(params):\n        rot,s,j,d=params\n        psi=psi0\n        for l in range(4):\n            def f(y,t):\n                J=jnp.tanh(j[l]); D=jnp.tanh(d[l])\n                return -1j*(J*xy_mvp(y)+D*z_mvp(y))\n            out=tc.timeevol.ode_evol_global(f, psi, [0.0,0.05+0.45*jax.nn.sigmoid(s[l])], None, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16, ode_backend=ode_backend)\n            psi=out[-1]\n            c=tc.Circuit(n, inputs=psi)\n            for k in range(n):\n                c.rz(k,theta=rot[l,k,0]); c.ry(k,theta=rot[l,k,1]); c.rz(k,theta=rot[l,k,2])\n            psi=c.state()\n        c=tc.Circuit(n, inputs=psi)\n        return jnp.real(tc.templates.measurements.operator_expectation(c,H))/14\n    return energy\n\nfor backend in ['jaxode','diffrax']:\n    energy=make_energy(backend)\n    t0=time.time(); e=energy(params); print(backend,'first fwd',time.time()-t0,e)\n    fg=jax.jit(jax.value_and_grad(energy))\n    t0=time.time(); e,g=fg(params); print(backend,'first jit fg',time.time()-t0)\n    t0=time.time(); e,g=fg(params); print(backend,'second fg',time.time()-t0)\n    times=[]\n    for _ in range(3):\n        t0=time.time(); e,g=fg(params); times.append(time.time()-t0)\n    print('avg',np.mean(times))\nPY\npython /tmp/bench.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench2.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax'); tc.set_dtype('complex128')\nn=14\nls=[]; ws=[]\nfor i in range(n-1):\n    for p,w in [(1,0.7),(2,0.7),(3,1.1)]:\n        r=[0]*n; r[i]=r[i+1]=p; ls.append(r); ws.append(w)\nfor i in range(n):\n    r=[0]*n; r[i]=3; ls.append(r); ws.append(0.25*((-1)**i))\nH=tc.quantum.PauliStringSum2COO(ls,ws,numpy=False)\nxy_rows=[]; z_rows=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; xy_rows.append(r)\n    r=[0]*n; r[i]=r[i+1]=2; xy_rows.append(r)\nfor i in range(n):\n    r=[0]*n; r[i]=3; z_rows.append(r)\nxy_mvp=tc.quantum.PauliStringSum2MVP(xy_rows,[1.0]*len(xy_rows))\nz_mvp=tc.quantum.PauliStringSum2MVP(z_rows,[1.0]*len(z_rows))\ninit=tc.Circuit(n)\nfor i in range(1,n,2): init.x(i)\npsi0=init.state()\nrng=np.random.default_rng(42)\nrot=rng.normal(0,0.1,(4,n,3)); s=np.zeros(4); j=np.ones(4)*0.1; d=np.ones(4)*0.1\nparams=(rot,s,j,d)\n\ndef energy(params):\n    rot,s,j,d=params\n    psi=psi0\n    for l in range(4):\n        def f(y,t):\n            J=jnp.tanh(j[l]); D=jnp.tanh(d[l])\n            return -1j*(J*xy_mvp(y)+D*z_mvp(y))\n        out=tc.timeevol.ode_evol_global(f, psi, [0.0,0.05+0.45*jax.nn.sigmoid(s[l])], None, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n        psi=out[-1]\n        c=tc.Circuit(n, inputs=psi)\n        for k in range(n):\n            c.rz(k,theta=rot[l,k,0]); c.ry(k,theta=rot[l,k,1]); c.rz(k,theta=rot[l,k,2])\n        psi=c.state()\n    c=tc.Circuit(n, inputs=psi)\n    return jnp.real(tc.templates.measurements.operator_expectation(c,H))/14\n\nfj=jax.jit(energy)\nt0=time.time(); e=fj(params); print('jit fwd call time',time.time()-t0)\nt0=time.time(); e.block_until_ready(); print('block',time.time()-t0, float(e))\nt0=time.time(); e2=fj(params); e2.block_until_ready(); print('second fwd',time.time()-t0, float(e2))\n\nfg=jax.jit(jax.value_and_grad(energy))\nt0=time.time(); e,g=fg(params); print('jit fg call time',time.time()-t0)\nt0=time.time(); jax.block_until_ready((e,g)); print('fg block',time.time()-t0, float(e))\nt0=time.time(); e2,g2=fg(params); jax.block_until_ready((e2,g2)); print('fg second',time.time()-t0, float(e2))\n# perturb params\np2=(rot+0.001,s+0.001,j,d)\nt0=time.time(); e3,g3=fg(p2); jax.block_until_ready((e3,g3)); print('fg perturb',time.time()-t0, float(e3))\nPY\npython /tmp/bench2.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
