{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/fullrun.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax'); tc.set_dtype('complex128')\nn=14\n# target H\nls=[]; ws=[]\nfor i in range(n-1):\n    for p,w in [(1,0.7),(2,0.7),(3,1.1)]:\n        r=[0]*n; r[i]=r[i+1]=p; ls.append(r); ws.append(w)\nfor i in range(n):\n    r=[0]*n; r[i]=3; ls.append(r); ws.append(0.25*((-1)**i))\nH=tc.quantum.PauliStringSum2COO(ls,ws,numpy=False)\nxy_rows=[]; z_rows=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; xy_rows.append(r)\n    r=[0]*n; r[i]=r[i+1]=2; xy_rows.append(r)\nfor i in range(n):\n    r=[0]*n; r[i]=3; z_rows.append(r)\nxy_mvp=tc.quantum.PauliStringSum2MVP(xy_rows,[1.0]*len(xy_rows))\nz_mvp=tc.quantum.PauliStringSum2MVP(z_rows,[1.0]*len(z_rows))\ninit=tc.Circuit(n)\nfor i in range(1,n,2): init.x(i)\npsi0=init.state()\nrng=np.random.default_rng(42)\nrot=rng.normal(0,0.1,(4,n,3)); s=np.zeros(4); j=np.ones(4)*0.1; d=np.ones(4)*0.1\n\ndef analog(psi, tt, jj, dd):\n    def f(y,t,a,b):\n        return -1j*(jnp.tanh(a)*xy_mvp(y)+jnp.tanh(b)*z_mvp(y))\n    out=tc.timeevol.ode_evol_global(f, psi, [0.0, tt], None, jj, dd, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n    return out[-1]\n\ndef digital(psi, rr):\n    c=tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k,theta=rr[k,0]); c.ry(k,theta=rr[k,1]); c.rz(k,theta=rr[k,2])\n    return c.state()\n\ndef block(psi, rr, ss, jj, dd):\n    return digital(analog(psi, 0.05+0.45*jax.nn.sigmoid(ss), jj, dd), rr)\nblock_jit=jax.jit(block)\n\ndef loss(params):\n    rot,ss,jj,dd=params\n    psi=psi0\n    for l in range(4):\n        psi=block_jit(psi, rot[l], ss[l], jj[l], dd[l])\n    c=tc.Circuit(n, inputs=psi)\n    return jnp.real(tc.templates.measurements.operator_expectation(c,H))/14\n\nparams=(jnp.asarray(rot), jnp.asarray(s), jnp.asarray(j), jnp.asarray(d))\nvg=jax.value_and_grad(loss)\n# warmup\nt0=time.time(); e,g=vg(params); jax.block_until_ready((e,g)); print('warmup',time.time()-t0,float(e))\nm=[jnp.zeros_like(p) for p in params]; v=[jnp.zeros_like(p) for p in params]\nhist=np.empty(100)\nt0=time.time()\nfor t in range(1,101):\n    e,g=vg(params)\n    jax.block_until_ready((e,g))\n    hist[t-1]=float(e)\n    # adam\n    for idx,(p,gi,mi,vi) in enumerate(zip(params,g,m,v)):\n        mi2=0.9*mi+0.12*(1-0.9)*gi # actually beta1\n        vi2=0.999*vi+(1-0.999)*gi*gi\n        mhat=mi2/(1-0.9**t); vhat=vi2/(1-0.999**t)\n        params[idx]=p-0.12*mhat/(jnp.sqrt(vhat)+1e-8)\n    m=[0.9*m[i]+0.12*(1-0.9)*g[i] for i in range(4)]\n    v=[0.999*v[i]+(1-0.999)*g[i]*g[i] for i in range(4)]\nprint('loop time',time.time()-t0)\nprint('init',hist[0],'final hist',hist[-1],'min',hist.min())\nprint('params', [np.asarray(x) for x in params])\nprint('times',0.05+0.45*1/(1+np.exp(-np.asarray(params[1]))))\nprint('couplings',np.tanh(np.asarray(params[2])),'det',np.tanh(np.asarray(params[3])))\nPY\npython /tmp/fullrun.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
