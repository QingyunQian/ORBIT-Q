{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test14.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax')\ntc.set_dtype('complex128')\n\nn=14\n# target structures\nls=[]; ws=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; ls.append(r); ws.append(0.7)\n    r=[0]*n; r[i]=r[i+1]=2; ls.append(r); ws.append(0.7)\n    r=[0]*n; r[i]=r[i+1]=3; ls.append(r); ws.append(1.1)\nfor i in range(n):\n    r=[0]*n; r[i]=3; ls.append(r); ws.append(0.25*((-1)**i))\nH = tc.quantum.PauliStringSum2COO(ls, ws, numpy=False)\nprint('H', type(H), H.dtype if hasattr(H,'dtype') else None)\n\nxy_rows=[]; z_rows=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; xy_rows.append(r)\n    r=[0]*n; r[i]=r[i+1]=2; xy_rows.append(r)\nfor i in range(n):\n    r=[0]*n; r[i]=3; z_rows.append(r)\nxy_mvp = tc.quantum.PauliStringSum2MVP(xy_rows, [1.0]*len(xy_rows))\nz_mvp = tc.quantum.PauliStringSum2MVP(z_rows, [1.0]*len(z_rows))\n\ninit=tc.Circuit(n)\nfor i in range(1,n,2): init.x(i)\npsi0=init.state()\n\ndef evolve(rot, s,j,d):\n    def f(y,t):\n        J=jnp.tanh(j); D=jnp.tanh(d); tt=0.05+0.45*jax.nn.sigmoid(s)\n        return -1j*(J*xy_mvp(y)+D*z_mvp(y))\n    out = tc.timeevol.ode_evol_global(f, psi0, [0.0, tt], None, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n    return out[-1]\n\ndef energy(params):\n    rot,s,j,d = params\n    psi=psi0\n    for l in range(4):\n        def f(y,t):\n            J=jnp.tanh(j[l]); D=jnp.tanh(d[l]); tt=0.05+0.45*jax.nn.sigmoid(s[l])\n            return -1j*(J*xy_mvp(y)+D*z_mvp(y))\n        out = tc.timeevol.ode_evol_global(f, psi, [0.0, 0.05+0.45*jax.nn.sigmoid(s[l])], None, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n        psi=out[-1]\n        c=tc.Circuit(n, inputs=psi)\n        for k in range(n):\n            c.rz(k, theta=rot[l,k,0]); c.ry(k, theta=rot[l,k,1]); c.rz(k, theta=rot[l,k,2])\n        psi=c.state()\n    c=tc.Circuit(n, inputs=psi)\n    e=tc.templates.measurements.operator_expectation(c,H)\n    return jnp.real(e)/14\n\nrng=np.random.default_rng(42)\nrot=rng.normal(0,0.1,(4,n,3))\ns=np.zeros(4); j=np.ones(4)*0.1; d=np.ones(4)*0.1\nparams=(rot,s,j,d)\nt0=time.time()\ne=energy(params)\nprint('energy',e,'time',time.time()-t0)\nt0=time.time()\ng=jax.grad(energy)(params)\nprint('grad shapes', [x.shape for x in g], 'time', time.time()-t0)\nPY\npython /tmp/test14.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
