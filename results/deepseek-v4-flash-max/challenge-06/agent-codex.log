{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, scipy.sparse as sp, scipy.sparse.linalg as sla\nn=14\n# build sparse target Hamiltonian\nrows=[]; cols=[]; data=[]\ndef add_term(pairs, coeff):\n    # pairs (op,index); op 1=X,2=Y,3=Z\n    dim=2**n\n    # local basis indices; use state vector ordering TC q0 most significant? sparse expectation consistent irrelevant\n    # construct via kron sparse matrices\n    mats=[]\n    for k in range(n):\n        op=next((o for o,i in pairs if i==k), None)\n        if op is None:\n            mats.append(sp.eye(2, format='csr'))\n        elif op==1:\n            mats.append(sp.csr_matrix(np.array([[0,1],[1,0]])))\n        elif op==2:\n            mats.append(sp.csr_matrix(np.array([[0,-1j],[1j,0]])))\n        elif op==3:\n            mats.append(sp.csr_matrix(np.array([[1,0],[0,-1]])))\n    M=mats[0]\n    for x in mats[1:]: M=sp.kron(M,x,format='csr')\n    rows.extend(M.tocoo().row); cols.extend(M.tocoo().col); data.extend((coeff*M.tocoo().data).tolist())\nfor i in range(n-1):\n    add_term([(1,i),(1,i+1)],0.7)\n    add_term([(2,i),(2,i+1)],0.7)\n    add_term([(3,i),(3,i+1)],1.1)\nfor i in range(n):\n    add_term([(3,i)],0.25*((-1)**i))\nH=sp.csr_matrix((data,(rows,cols)),shape=(2**n,2**n))\ne=sla.eigsh(H,k=1,which='SA',tol=1e-10)\nprint(e[0][0], e[0][0]/14)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
