{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np\nimport tensorcircuit as tc\nimport jax\ntc.set_backend('jax')\ntc.set_dtype('complex128')\nn=3\nc=tc.Circuit(n)\nc.x(0)\npsi=c.state()\nprint('psi dtype', psi.dtype, psi.shape)\nxy_mvp = tc.quantum.PauliStringSum2MVP([[1,1,0],[2,2,0]], [1.0,1.0])\nz_mvp = tc.quantum.PauliStringSum2MVP([[3,0,0],[0,3,0],[0,0,3]], [1.0,1.0,1.0])\n\ndef evolve(J, Delta):\n    def f(y,t):\n        return -1j*(J*xy_mvp(y)+Delta*z_mvp(y))\n    out = tc.timeevol.ode_evol_global(f, psi, [0.0, 0.2], None, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n    return out[-1]\n\nprint('out', evolve(0.1,0.2).shape, evolve(0.1,0.2).dtype)\nprint('grad', jax.grad(lambda J,D: jax.numpy.sum(jax.numpy.abs(evolve(J,D))**2))(0.1,0.2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
