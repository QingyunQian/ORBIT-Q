Operator) -> Any:\n2034:def u1_inds(n: int, m: int) -> Tensor:\n2069:def u1_mask(n: int, m: int) -> Tensor:\n2090:def u1_project(s: Tensor, n: int, m: int) -> Tensor:\n2106:def u1_enlarge(s: Tensor, n: int, m: int) -> Tensor:\n2124:def heisenberg_hamiltonian(\n2215:def PauliStringSum2MVP(\n2237:        def mvp_identity(psi: Tensor) -> Tensor:\n2299:    def mvp(psi: Tensor) -> Tensor:\n2347:def PauliStringSum2Dense(\n2379:# def _tf2numpy_sparse(a: Tensor) -> Tensor:\n2386:# def _numpy2tf_sparse(a: Tensor) -> Tensor:\n2394:def PauliStringSum2COO(\n2469:def _dc_sum(l: List[Any]) -> Any:\n2489:def PauliStringSum2COO_tf(\n2525:def PauliString2COO(l: Sequence[int], weight: Optional[float] = None) -> Tensor:\n2571:def ps2coo_core(\n2598:def op2tensor(\n2606:# def op2tensor(\n2613:#     def wrapper(*args: Any, **kwargs: Any) -> Any:\n2625:def entropy(rho: Union[Tensor, QuOperator], eps: Optional[float] = None) -> Tensor:\n","exit_code":0,"status":"completed"}}
