{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench5.py <<'PY'\nimport time, numpy as np\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\ntc.set_backend('jax'); tc.set_dtype('complex128')\nn=14\nls=[]; ws=[]\nfor i in range(n-1):\n    for p,w in [(1,0.7),(2,0.7),(3,1.1)]:\n        r=[0]*n; r[i]=r[i+1]=p; ls.append(r); ws.append(w)\nfor i in range(n):\n    r=[0]*n; r[i]=3; ls.append(r); ws.append(0.25*((-1)**i))\nH=tc.quantum.PauliStringSum2COO(ls,ws,numpy=False)\nxy_rows=[]; z_rows=[]\nfor i in range(n-1):\n    r=[0]*n; r[i]=r[i+1]=1; xy_rows.append(r)\n    r=[0]*n; r[i]=r[i+1]=2; xy_rows.append(r)\nfor i in range(n):\n    r=[0]*n; r[i]=3; z_rows.append(r)\nxy_mvp=tc.quantum.PauliStringSum2MVP(xy_rows,[1.0]*len(xy_rows))\nz_mvp=tc.quantum.PauliStringSum2MVP(z_rows,[1.0]*len(z_rows))\ninit=tc.Circuit(n)\nfor i in range(1,n,2): init.x(i)\npsi0=init.state()\nrng=np.random.default_rng(42)\nrot=rng.normal(0,0.1,(4,n,3)); s=np.zeros(4); j=np.ones(4)*0.1; d=np.ones(4)*0.1\n\ndef analog(psi, tt, jj, dd):\n    def f(y,t,a,b):\n        return -1j*(jnp.tanh(a)*xy_mvp(y)+jnp.tanh(b)*z_mvp(y))\n    out=tc.timeevol.ode_evol_global(f, psi, [0.0, tt], None, jj, dd, mode='raw', rtol=1e-6, atol=1e-6, max_steps=16)\n    return out[-1]\n\ndef digital(psi, rr):\n    c=tc.Circuit(n, inputs=psi)\n    for k in range(n):\n        c.rz(k,theta=rr[k,0]); c.ry(k,theta=rr[k,1]); c.rz(k,theta=rr[k,2])\n    return c.state()\n\ndef block(psi, rr, ss, jj, dd):\n    return digital(analog(psi, 0.05+0.45*jax.nn.sigmoid(ss), jj, dd), rr)\nblock_jit=jax.jit(block)\n\ndef loss(params):\n    rot,ss,jj,dd=params\n    psi=psi0\n    for l in range(4):\n        psi=block_jit(psi, rot[l], ss[l], jj[l], dd[l])\n    c=tc.Circuit(n, inputs=psi)\n    return jnp.real(tc.templates.measurements.operator_expectation(c,H))/14\n\nparams=(rot,s,j,d)\n# warm forward block jit\nt0=time.time(); out=block_jit(psi0, rot[0], s[0], j[0], d[0]); out.block_until_ready(); print('block fwd compile+run',time.time()-t0, float(jnp.sum(jnp.abs(out))))\nt0=time.time(); out=block_jit(psi0, rot[0], s[0], j[0], d[0]); out.block_until_ready(); print('block fwd run',time.time()-t0)\nt0=time.time(); e=loss(params); print('loss call',time.time()-t0, e)\nvg=jax.value_and_grad(loss)\nfor i in range(4):\n    t0=time.time(); e,g=vg(params); jax.block_until_ready((e,g)); print('vg',i,time.time()-t0,float(e))\np2=(rot+0.001,s+0.001,j,d)\nt0=time.time(); e,g=vg(p2); jax.block_until_ready((e,g)); print('vg perturb',time.time()-t0,float(e))\nPY\npython /tmp/bench5.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
