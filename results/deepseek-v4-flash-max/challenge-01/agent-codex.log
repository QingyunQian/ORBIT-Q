{"type":"item.started","item":{"id":"item_103","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, quimb.tensor as qtn, tensorcircuit as tc\nfor n in [2,4,8]:\n m=qtn.MPS_rand_state(n,bond_dim=8,seed=1)\n ts=[]\n for i,t in enumerate(m.tensors):\n  a=np.asarray(t.data)\n  if i==0: a=np.transpose(a,(1,0))[None,:,:]\n  elif i==n-1: a=a[:,:,None]\n  else: a=np.transpose(a,(0,2,1))\n  ts.append(a.astype(np.complex64))\n print('n',n,'bonds',[t.shape for t in ts])\n for typ in ['mps','circ']:\n  e=0\n  for i in range(n-1):\n   if typ=='mps': c=tc.MPSCircuit(n,tensors=ts,split={})\n   else: c=tc.Circuit(n,tensors=ts,split={})\n   e+=c.expectation((tc.gates.zz(),[i,i+1]))\n  for i in range(n):\n   if typ=='mps': c=tc.MPSCircuit(n,tensors=ts,split={})\n   else: c=tc.Circuit(n,tensors=ts,split={})\n   e-=1.05*c.expectation((tc.gates.x(),[i]))\n  print(typ, e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
