{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, quimb.tensor as qtn\nI=np.eye(2,dtype=complex); X=np.array([[0,1],[1,0]],dtype=complex); Z=np.diag([1.,-1.]).astype(complex)\ndef en_vec(vec,n):\n vec=vec.reshape(-1)\n e=0\n for j in range(n-1):\n  o=[I]*n; o[j]=Z; o[j+1]=Z\n  mm=o[0]\n  for q in o[1:]: mm=np.kron(mm,q)\n  e-=vec.conj()@mm@vec\n for j in range(n):\n  o=[I]*n; o[j]=X\n  mm=o[0]\n  for q in o[1:]: mm=np.kron(mm,q)\n  e-=1.05*vec.conj()@mm@vec\n return e\nfor n in [2,4,8]:\n m=qtn.MPS_rand_state(n,bond_dim=4,seed=1)\n vec=m.to_dense()\n print(n, 'norm', np.linalg.norm(vec.reshape(-1)), 'exact', en_vec(vec,n))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
