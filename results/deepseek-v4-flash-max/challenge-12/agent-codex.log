{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test32.py <<'PY'\nimport numpy as np, time\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nimport jax.numpy as jnp\n\nn=32\narr=np.load('/tmp/target.npz')\ntt=[np.asarray(arr[k]) for k in arr.files]\n# transpose lrp -> lpr\ntt=[np.transpose(a,(0,2,1)) if a.ndim==3 else np.transpose(a,(1,0)) for a in tt]\ntt=[jnp.asarray(a.astype(np.complex64)) for a in tt]\n\ndef make_ket(par):\n    k=tc.MPSCircuit(n)\n    for i in range(1,n,2):\n        k.X(i)\n    for b in range(2):\n        for i in range(b%2, n-1, 2):\n            off=(b*(n//2)+i//2)*15\n            k.apply(tc.gates.su4_gate(par[off:off+15]), i, i+1)\n    return k\n\ndef make_bra():\n    return tc.MPSCircuit(n, tensors=tt, center_position=0)\n\ndef loss(par):\n    bra=make_bra()\n    ket=make_ket(par)\n    ov=ket.proj_with_mps(bra)\n    f=jnp.real(ov*jnp.conj(ov))\n    return 1.0-f, f\n\npar0=0.02*np.random.RandomState(2039).randn((31*15,)).astype(np.float32)\nt=time.time()\nloss_grad=jax.jit(jax.value_and_grad(lambda p: loss(p)[0]))\n# first compile\nv,g=loss_grad(jnp.asarray(par0))\nprint('first value', v, 'grad', g.shape, 'time', time.time()-t)\n# evaluate f directly maybe compile same\n# norm\nbra=make_bra()\n# non-jit? need jit loss\nnorm2_fn=jax.jit(lambda: jnp.real(make_bra().proj_with_mps(make_bra())))\nt=time.time(); nrm=norm2_fn(); print('norm2', nrm, 'time', time.time()-t)\nPY\npython /tmp/test32.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
