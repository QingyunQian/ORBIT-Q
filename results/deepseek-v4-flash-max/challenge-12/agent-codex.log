{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_solution.py <<'PY'\nimport numpy as np, time, sys\nsys.path.insert(0, '/root')\nimport solution_12\n\nclass T:\n    def __init__(self, data, inds): self.data=data; self.inds=list(inds)\nclass S:\n    def __init__(self, arrays):\n        self._arrays=[np.asarray(a) for a in arrays]\n        n=len(self._arrays)\n        self._inds=[]\n        for i,a in enumerate(self._arrays):\n            if i==0:\n                inds=['k0','b0']\n            elif i==n-1:\n                inds=[f'b{i-1}',f'k{i}']\n            else:\n                inds=[f'b{i-1}',f'k{i}',f'b{i}']\n            self._inds.append(inds)\n    @property\n    def tensors(self):\n        return tuple(T(d,i) for d,i in zip(self._arrays,self._inds))\n    def site_ind(self,i): return f'k{i}'\n\narr=np.load('/tmp/target.npz')\nstate=S([arr[k] for k in arr.files])\nconfig={'n_qubits':32,'zz_anisotropy':1.4,'staggered_field':0.2,'dmrg_chi':8,'dmrg_sweeps':4,'dmrg_tolerance':1e-7,'n_layers':2,'max_steps':5000,'learning_rate':0.02,'initial_parameter_scale':0.02,'seed':2039,'dmrg_state':state}\nt=time.time()\nres=solution_12.run_solution(config)\nprint('elapsed', time.time()-t)\nfor k,v in res.items():\n    print(k, v.shape if hasattr(v,'shape') else v)\nprint('loss0',res['loss_history'][0],'lossf',res['loss_history'][-1])\nprint('f0',res['fidelity_history'][0],'ff',res['fidelity_history'][-1])\nprint('finite',np.isfinite(res['loss_history']).all(), np.isfinite(res['fidelity_history']).all(), np.isfinite(res['final_parameters']).all(), np.isfinite(res['final_overlap_phase']))\nPY\npython /tmp/test_solution.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
