{"type":"item.completed","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc 'cat -n /root/solution_12.py'","aggregated_output":"     1\timport numpy as np\n     2\t\n     3\timport jax\n     4\timport jax.numpy as jnp\n     5\timport tensorcircuit as tc\n     6\t\n     7\t\n     8\tdef run_solution(config):\n     9\t    tc.set_backend(\"jax\")\n    10\t\n    11\t    n = int(config[\"n_qubits\"])\n    12\t    n_layers = int(config[\"n_layers\"])\n    13\t    max_steps = int(config[\"max_steps\"])\n    14\t    lr = float(config[\"learning_rate\"])\n    15\t    scale = float(config[\"initial_parameter_scale\"])\n    16\t    seed = int(config[\"seed\"])\n    17\t    state = config[\"dmrg_state\"]\n    18\t\n    19\t    tensors = []\n    20\t    for i, t in enumerate(state.tensors):\n    21\t        a = np.asarray(t.data)\n    22\t        pos = t.inds.index(state.site_ind(i))\n    23\t        if i == 0:\n    24\t            b = a[None, :, :] if pos == 1 else a.T[None, :, :]\n    25\t        elif i == n - 1:\n    26\t            b = a[:, :, None] if pos == 0 else a.T[:, :, None]\n    27\t        elif pos == 1:\n    28\t            b = a\n    29\t        elif pos == 2:\n    30\t            b = a.transpose(0, 2, 1)\n    31\t        else:\n    32\t            b = a.transpose(1, 0, 2)\n    33\t        tensors.append(jnp.asarray(b.astype(np.complex64)))\n    34\t\n    35\t    def make_bra():\n    36\t        return tc.MPSCircuit(n, tensors=tensors, center_position=0)\n    37\t\n    38\t    norm2 = float(jnp.real(jax.jit(lambda: make_bra().proj_with_mps(make_bra()))()))\n    39\t    norm = float(np.sqrt(norm2))\n    40\t    tensors[:] = [t / norm for t in tensors]\n    41\t\n    42\t    def make_ket(par):\n    43\t        c = tc.MPSCircuit(n)\n    44\t        for i in range(1, n, 2):\n    45\t            c.X(i)\n    46\t        for layer in range(n_layers):\n    47\t            start = layer % 2\n    48\t            n_gates = (n - start) // 2\n    49\t            base = layer * (n // 2)\n    50\t            for gi in range(n_gates):\n    51\t                i = start + 2 * gi\n    52\t                off = (base + gi) * 15\n    53\t                c.apply(tc.gates.su4_gate(par[off : off + 15]), i, i + 1)\n    54\t        return c\n    55\t\n    56\t    def overlap_fn(par):\n    57\t        return make_ket(par).proj_with_mps(make_bra())\n    58\t\n    59\t    def loss_fn(par):\n    60\t        ov = overlap_fn(par)\n    61\t        fid = jnp.clip(jnp.real(ov * jnp.conj(ov)), 0.0, 1.0)\n    62\t        return 1.0 - fid\n    63\t\n    64\t    rng = np.random.RandomState(seed)\n    65\t    p0 = jnp.asarray((scale * rng.randn((n - 1) * 15)).astype(np.float32))\n    66\t\n    67\t    def adam_step(carry, _):\n    68\t        par, m, v, b1t, b2t = carry\n    69\t        loss, g = jax.value_and_grad(loss_fn)(par)\n    70\t        m = 0.9 * m + 0.1 * g\n    71\t        v = 0.999 * v + 0.001 * g * g\n    72\t        b1t = 0.9 * b1t\n    73\t        b2t = 0.999 * b2t\n    74\t        mh = m / (1.0 - b1t)\n    75\t        vh = v / (1.0 - b2t)\n    76\t        par = par - lr * mh / (jnp.sqrt(vh) + 1e-8)\n    77\t        return (par, m, v, b1t, b2t), (loss, 1.0 - loss)\n    78\t\n    79\t    carry0 = (\n    80\t        p0,\n    81\t        jnp.zeros_like(p0),\n    82\t        jnp.zeros_like(p0),\n    83\t        jnp.ones(()),\n    84\t        jnp.ones(()),\n    85\t    )\n    86\t    carry, hist = jax.lax.scan(adam_step, carry0, None, length=max_steps)\n    87\t    p_final = np.asarray(carry[0])\n    88\t    ov_final = overlap_fn(jnp.asarray(p_final))\n    89\t\n    90\t    return {\n    91\t        \"loss_history\": np.asarray(hist[0]),\n    92\t        \"fidelity_history\": np.asarray(hist[1]),\n    93\t        \"final_parameters\": p_final,\n    94\t        \"final_overlap_phase\": float(np.angle(ov_final)),\n    95\t    }\n","exit_code":0,"status":"completed"}}
