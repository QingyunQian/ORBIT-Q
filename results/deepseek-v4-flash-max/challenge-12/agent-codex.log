{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/scan_test.py <<'PY'\nimport numpy as np, time, math\nimport tensorcircuit as tc\ntc.set_backend('jax')\nimport jax\nimport jax.numpy as jnp\n\nn=32\narr=np.load('/tmp/target.npz')\nraw=[np.asarray(arr[k]) for k in arr.files]\ntt=[]\nfor i,a in enumerate(raw):\n    if i==0:\n        b=a[None,:,:]\n    elif i==n-1:\n        b=a[:,:,None]\n    else:\n        b=a\n    tt.append(jnp.asarray(b.astype(np.complex64)))\n# normalize\nbra0=tc.MPSCircuit(n, tensors=tt, center_position=0)\nnrm=float(jnp.real(bra0.proj_with_mps(bra0)))\nprint('norm2 before', nrm)\nscale=np.sqrt(nrm)\ntt=[t/scale for t in tt]\n\ndef make_ket(par):\n    k=tc.MPSCircuit(n)\n    for i in range(1,n,2):\n        k.X(i)\n    for layer in range(2):\n        start=layer%2\n        ngates = 16 if layer==0 else 15\n        base=layer*16\n        for gi in range(ngates):\n            i=start+2*gi\n            off=(base+gi)*15\n            k.apply(tc.gates.su4_gate(par[off:off+15]), i, i+1)\n    return k\n\ndef make_bra():\n    return tc.MPSCircuit(n, tensors=tt, center_position=0)\n\ndef loss_and_f(par):\n    bra=make_bra()\n    ket=make_ket(par)\n    ov=ket.proj_with_mps(bra)\n    f=jnp.real(ov*jnp.conj(ov))\n    f=jnp.clip(f, 0.0, 1.0)\n    return 1.0-f, f\n\nlg=jax.jit(jax.value_and_grad(lambda p: loss_and_f(p)[0]))\n\npar0=0.02*np.random.RandomState(2039).randn(465).astype(np.float32)\n# test 1\nt=time.time(); val,g=lg(jnp.asarray(par0)); print('compile1',time.time()-t, val)\n\ndef adam_step(carry, x):\n    par, m, v, b1t, b2t = carry\n    (loss, f), g = jax.value_and_grad(lambda p: loss_and_f(p)[0])(par)\n    # no extra jit\n    m = 0.9*m + 0.1*g\n    v = 0.999*v + 0.001*g*g\n    b1t *= 0.9\n    b2t *= 0.999\n    mh = m/(1.0-b1t)\n    vh = v/(1.0-b2t)\n    par = par - 0.02*mh/(jnp.sqrt(vh)+1e-8)\n    return (par,m,v,b1t,b2t), (loss,f)\n\ndef run(nsteps, p0):\n    m=jnp.zeros_like(p0); v=jnp.zeros_like(p0)\n    b1t=jnp.ones(()); b2t=jnp.ones(())\n    carry0=(jnp.asarray(p0),m,v,b1t,b2t)\n    t=time.time()\n    carry, hist = jax.lax.scan(adam_step, carry0, None, length=nsteps)\n    print('scan time', time.time()-t)\n    return carry[0], hist[0], hist[1]\n\np, loss_hist, f_hist = run(500, par0)\nprint('final loss', loss_hist[-1], 'f', f_hist[-1])\nprint('shapes', loss_hist.shape, f_hist.shape)\nprint('increased', f_hist[-1] > f_hist[0], loss_hist[-1] < loss_hist[0])\n# save for later maybe\nnp.savez('/tmp/hist500.npz', loss=np.array(loss_hist), f=np.array(f_hist), p=np.array(p))\nPY\npython /tmp/scan_test.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
