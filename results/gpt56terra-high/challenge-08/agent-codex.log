{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/bench_tc.py <<'PY'\nimport time, numpy as np, tensorcircuit as tc\n# tc.set_backend('numpy')\ntc.set_backend('jax')\ntc.set_contractor('greedy', preprocessing=True)\nn=7; c=tc.Circuit(49)\nfor r in range(n):\n for col in range(n):\n  a=.19+.07*np.sin(.83*(r+1))+.05*np.cos(.61*(col+1))+.03*np.sin(.29*(r+col+2)); c.ry(7*r+col,theta=a)\nkh=0\nfor r in range(n):\n for col in range(n-1):\n  b=.31+.09*np.sin(.47*(kh+1))+.06*np.cos(.38*(2*r+col+1)); c.rzz(7*r+col,7*r+col+1,theta=b); kh+=1\nkv=0\nfor r in range(n-1):\n for col in range(n):\n  b=.27+.08*np.cos(.41*(kv+1))+.07*np.sin(.33*(r+2*col+1)); c.rxx(7*r+col,7*(r+1)+col,theta=b); kv+=1\nfor r in range(n):\n for col in range(n):\n  a=.17+.06*np.cos(.52*(r+1))-.04*np.sin(.44*(col+1))+.02*np.cos(.25*(r+col+2)); c.rx(7*r+col,theta=a)\nprint('built',len(c._nodes))\nfor shots in [1,2]:\n st=time.time()\n try:\n  x=c.sample(batch=shots, allow_state=False, format='sample_bin')\n  print('out', shots, np.asarray(x).shape, time.time()-st, np.asarray(x)[:1])\n except Exception as e: print('ERR',type(e),e,time.time()-st)\nPY\npython /tmp/bench_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
