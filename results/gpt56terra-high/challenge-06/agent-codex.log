[k] = slice(None, None, -1)\n            flip_slice: Optional[Tuple[slice, ...]] = tuple(sl)\n        else:\n            flip_slice = None\n\n        term_flip_slices.append(flip_slice)\n        term_flip_axes.append(flip_axes)\n        term_mask_indices.append(mask_indices)\n        term_weights.append(phase_c)\n\n    # Pre-fuse per-axis Z masks into a single broadcastable mask per term.\n    # Built once at setup (amortized over many mvp calls); stored as backend\n    # tensors so the call path only needs a dtype-aligned broadcast multiply.\n    term_fused_masks: List[Optional[Tensor]] = []\n    for mask_indices in term_mask_indices:\n        if not mask_indices:\n            term_fused_masks.append(None)\n            continue\n        m = np.ones([1] * n, dtype=np.float64)\n        for a in mask_indices:\n            z_k = np.array([1.0, -1.0]).reshape([1] * a + [2] + [1] * (n - a - 1))\n            m = m * z_k\n        term_fused_masks.append(backend.convert_to_tensor(m))\n\n    def mvp(psi: Tensor) -> Tensor:\n        psi_shape = backend.shape_tuple(psi)\n        is_flat = len(psi_shape) == 1\n\n        if is_flat:\n            psi_tensor = backend.reshape(psi, (2,) * n)\n        else:\n            psi_tensor = psi\n\n        dtype = backend.dtype(psi_tensor)\n\n        total_res = backend.zeros_like(psi_tensor)\n\n        for i in range(len(term_weights)):\n            term_psi = psi_tensor\n\n            # 1. Apply fused Z mask via a single broadcast multiply\n            fused = term_fused_masks[i]\n            if fused is not None:\n                term_psi = term_psi * backend.cast(fused, dtype)\n\n            # 2. Apply flips via slicing\n            flip_slice = term_flip_slices[i]\n            if flip_slice is not None:\n                if tf_module is not None:\n                    # TF workaround: reshape to rank 3, flip, reshape back\n                    curr_psi = term_psi\n                    for axis in term_flip_axes[i]:\n                        pre_shape = 2**axis\n                        post_shape = 2 ** (n - 1 - axis)\n                        curr_psi = tf_module.reshape(\n                            curr_psi, (pre_shape, 2, post_shape)\n                        )\n                        curr_psi = tf_module.reverse(curr_psi, axis=[1])\n                    term_psi = tf_module.reshape(curr_psi, (2,) * n)\n                else:\n                    term_psi = term_psi[flip_slice]\n\n            # 3. Apply weight\n            total_res = total_res + (term_psi * term_weights[i])\n\n        if is_flat:\n            return backend.reshape(total_res, (-1,))\n        return total_res\n\n    return mvp\n\n\ndef PauliStringSum2Dense(\n    ls: Sequence[Sequence[int]],\n    weight: Optional[Sequence[float]] = None,\n    numpy: bool = False,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/testtc.py <<'PY'\nimport os\nos.environ['JAX_ENABLE_X64']='False'\nimport numpy as np\nimport jax, jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax')\nfrom tensorcircuit.analogcircuit import AnalogCircuit\nn=14\n# pauli map\np=tc.gates.PAULI_CHAR_TO_INDEX\nlsxy=[]; lsz=[]; lstar=[]; ws=[]\nfor i in range(n-1):\n for pp in ('X','Y'):\n  a=[0]*n;a[i]=a[i+1]=p[pp];lsxy.append(a)\n for pp,w in [('X',.7),('Y',.7),('Z',1.1)]:\n  a=[0]*n;a[i]=a[i+1]=p[pp];lstar.append(a);ws.append(w)\nfor i in range(n):\n a=[0]*n;a[i]=p['Z'];lsz.append(a);lstar.append(a);ws.append(.25*(-1)**i)\nhxy=tc.quantum.PauliStringSum2COO(lsxy,[1.]*len(lsxy),numpy=False)\nhz=tc.quantum.PauliStringSum2COO(lsz,[(-1.)**i for i in range(n)],numpy=False)\nht=tc.quantum.PauliStringSum2COO(lstar,ws,numpy=False)\n\ndef loss(q):\n s,j,d,a,b,g=q\n ac=AnalogCircuit(n)\n for k in range(1,n,2):ac.x(k)\n for l in range(4):\n  t=.05+.45*jax.nn.sigmoid(s[l]); J=jnp.tanh(j[l]);D=jnp.tanh(d[l])\n  ac.add_analog_block(lambda x,J=J,D=D: J*hxy+D*hz,t,ode_backend='diffrax',rtol=1e-6,atol=1e-6,max_steps=16)\n  for k in range(n):\n   ac.rz(k,theta=a[l,k]);ac.ry(k,theta=b[l,k]);ac.rz(k,theta=g[l,k])\n psi=ac.state()\n return jnp.real(jnp.vdot(psi,ht@psi))/n\nkey=jax.random.key(4)\nq=(jnp.zeros(4),.1*jnp.ones(4),.1*jnp.ones(4),*.1*jax.random.normal(key,(3,4,14)))\nvg=jax.jit(jax.value_and_grad(loss))\nimport time\nst=time.time();v,gr=vg(q);jax.block_until_ready(v);print('first',time.time()-st,v,[x.shape for x in gr])\nst=time.time();v,gr=vg(q);jax.block_until_ready(v);print('second',time.time()-st,v)\nPY\npython /tmp/testtc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
