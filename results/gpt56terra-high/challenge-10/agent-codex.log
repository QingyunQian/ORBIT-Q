{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"nl -ba solution_10.py | sed -n '1,130p'\"","aggregated_output":"     1\t\"\"\"TensorCircuit-NG solution for the controlled-Z hyperedge VQE benchmark.\"\"\"\n     2\timport os\n     3\t\n     4\tos.environ.setdefault(\"XLA_PYTHON_CLIENT_PREALLOCATE\", \"false\")\n     5\t\n     6\timport numpy as np\n     7\timport jax\n     8\timport jax.numpy as jnp\n     9\timport tensorcircuit as tc\n    10\tfrom tensorcircuit.quantum import extract_tensors_from_qop\n    11\t\n    12\t\n    13\tdef _cmz_mpo(n, selected):\n    14\t    \"\"\"Embed TensorCircuit's native CMZ MPS factorization as a diagonal MPO.\"\"\"\n    15\t    nodes, _, _ = extract_tensors_from_qop(tc.gates.cmz_gate(len(selected)))\n    16\t    factors, selected = [np.asarray(node.tensor) for node in nodes], set(selected)\n    17\t    result, k = [], 0\n    18\t    for q in range(n):\n    19\t        if q not in selected:\n    20\t            result.append(jnp.asarray(np.einsum(\"ab,ij->aijb\", np.eye(2), np.eye(2))))\n    21\t            continue\n    22\t        factor, k = factors[k], k + 1\n    23\t        if k == 1:\n    24\t            tensor = np.zeros((1, 2, 2, 2), np.complex64)\n    25\t            tensor[0, 0, 0], tensor[0, 1, 1] = factor[0], factor[1]\n    26\t        elif factor.ndim == 2:\n    27\t            tensor = np.zeros((2, 2, 2, 1), np.complex64)\n    28\t            tensor[:, 0, 0, 0], tensor[:, 1, 1, 0] = factor[:, 0], factor[:, 1]\n    29\t        else:\n    30\t            tensor = np.zeros((2, 2, 2, 2), np.complex64)\n    31\t            tensor[:, 0, 0, :], tensor[:, 1, 1, :] = factor[:, 0, :], factor[:, 1, :]\n    32\t        result.append(jnp.asarray(tensor))\n    33\t    return result\n    34\t\n    35\t\n    36\tdef run_solution(config):\n    37\t    tc.set_backend(\"jax\")\n    38\t    n = config[\"n_qubits\"]\n    39\t    selected = tuple(config[\"selected_qubits\"])\n    40\t    layers = config[\"n_layers\"]\n    41\t    cmz = _cmz_mpo(n, selected)\n    42\t    zz, x = config[\"zz_strength\"], config[\"x_strength\"]\n    43\t\n    44\t    def energy(angles):\n    45\t        circuit = tc.MPSCircuit(n)\n    46\t        for q in config[\"initial_ones\"]:\n    47\t            circuit.x(q)\n    48\t        for layer in range(layers):\n    49\t            for q in range(n):\n    50\t                circuit.rx(q, theta=angles[layer, q, 0])\n    51\t                circuit.rz(q, theta=angles[layer, q, 1])\n    52\t                circuit.ry(q, theta=angles[layer, q, 2])\n    53\t            circuit.apply_MPO(cmz, 0)\n    54\t        zz_value = sum(jnp.real(circuit.expectation(\n    55\t            (tc.gates.z(), [q]), (tc.gates.z(), [q + 1]))) for q in range(n - 1))\n    56\t        x_value = sum(jnp.real(circuit.expectation((tc.gates.x(), [q]))) for q in range(n))\n    57\t        return (-zz * zz_value - x * x_value) / n\n    58\t\n    59\t    energy_grad = jax.jit(jax.value_and_grad(energy))\n    60\t    rng = np.random.default_rng(config[\"seed\"])\n    61\t    parameters = jnp.asarray(\n    62\t        rng.normal(0.0, config[\"initial_parameter_scale\"], (layers, n, 3)),\n    63\t        dtype=jnp.float32,\n    64\t    )\n    65\t    first = jnp.zeros_like(parameters)\n    66\t    second = jnp.zeros_like(parameters)\n    67\t    rate, beta1, beta2, eps = config[\"learning_rate\"], 0.9, 0.999, 1.0e-8\n    68\t\n    69\t    def adam_step(carry, step):\n    70\t        parameters, first, second = carry\n    71\t        value, gradient = energy_grad(parameters)\n    72\t        first = beta1 * first + (1.0 - beta1) * gradient\n    73\t        second = beta2 * second + (1.0 - beta2) * gradient * gradient\n    74\t        correction1 = 1.0 - beta1 ** (step + 1)\n    75\t        correction2 = 1.0 - beta2 ** (step + 1)\n    76\t        parameters = parameters - rate * (first / correction1) / (\n    77\t            jnp.sqrt(second / correction2) + eps\n    78\t        )\n    79\t        return (parameters, first, second), value\n    80\t\n    81\t    def optimize(parameters, first, second):\n    82\t        return jax.lax.scan(adam_step, (parameters, first, second),\n    83\t                            jnp.arange(config[\"max_steps\"]))\n    84\t\n    85\t    (parameters, _, _), history = jax.jit(optimize)(parameters, first, second)\n    86\t\n    87\t    return {\"energy_history\": np.asarray(history), \"final_parameters\": np.asarray(parameters)}\n","exit_code":0,"status":"completed"}}
