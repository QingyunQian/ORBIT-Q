{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/test_tc.py <<'PY'\nimport time\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nn=32; L=4\nK=tc.set_backend('jax')\ninit=tuple(jnp.array([[[1.],[0.]]],dtype=jnp.complex64) for _ in range(n))\nxx,yy,zz=tc.gates._xx_matrix, tc.gates._yy_matrix, tc.gates._zz_matrix\nX,Z=tc.gates.x(),tc.gates.z()\ndef loss(p):\n c=tc.MPSCircuit(n,tensors=list(init),center_position=0)\n for l in range(L):\n  for i in range(n):\n   c.rz(i,theta=p[l,i,0]); c.ry(i,theta=p[l,i,1]); c.rz(i,theta=p[l,i,2])\n  for i in range(l%2,n-1,2):\n   c.exp1(i,i+1,unitary=xx,theta=p[l,i,3]); c.exp1(i,i+1,unitary=yy,theta=p[l,i,4]); c.exp1(i,i+1,unitary=zz,theta=p[l,i,5])\n e=0.\n for i in range(n-1): e=e-c.expectation((Z,[i]),(Z,[i+1]))\n for i in range(n): e=e-1.05*c.expectation((X,[i]))\n return jnp.real(e)\nvg=jax.value_and_grad(loss)\ndef run(p):\n def step(c,_):\n  p,m,v,t=c\n  e,g=vg(p); t=t+1; m=.9*m+.1*g; v=.999*v+.001*g*g\n  p=p-.005*m/(1-.9**t)/(jnp.sqrt(v/(1-.999**t))+1e-8)\n  return (p,m,v,t),e\n return jax.lax.scan(step,(p,jnp.zeros_like(p),jnp.zeros_like(p),jnp.array(0)),None,length=2)\np=jnp.zeros((L,n,6),dtype=jnp.float32)\nt=time.time(); cr=jax.jit(run); ans=cr(p); ans[1].block_until_ready(); print('compile+two',time.time()-t, ans[1])\nt=time.time(); ans=cr(p); ans[1].block_until_ready(); print('two run',time.time()-t,ans[1])\nPY\npython /tmp/test_tc.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
