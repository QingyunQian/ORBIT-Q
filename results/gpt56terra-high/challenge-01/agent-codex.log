{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport tensorcircuit as tc\nimport jax, jax.numpy as jnp\nimport numpy as np\nK=tc.set_backend('jax')\n# 4 product mps tensors tc ordering\narr=[jnp.array([[1.,0.]], dtype=jnp.complex64)] + [jnp.array([[[1.],[0.]]],dtype=jnp.complex64) for _ in range(2)] + [jnp.array([[1.],[0.]],dtype=jnp.complex64)]\n# Actually first shape l? expects left phys right? (1,2,1) all\narr=[jnp.array([[[1.],[0.]]],dtype=jnp.complex64) for _ in range(4)]\ndef f(p):\n c=tc.MPSCircuit(4,tensors=arr,center_position=0,split={'max_singular_values':16})\n for i in range(4): c.rz(i, theta=p[i,0]); c.ry(i,theta=p[i,1]); c.rz(i,theta=p[i,2])\n for i in range(0,3,2):\n  c.exp1(i,i+1,unitary=tc.gates._xx_matrix,theta=p[i,3])\n  c.exp1(i,i+1,unitary=tc.gates._yy_matrix,theta=p[i,4])\n  c.exp1(i,i+1,unitary=tc.gates._zz_matrix,theta=p[i,5])\n return sum(c.expectation((tc.gates.z(),[i]),(tc.gates.z(),[i+1])) for i in range(3))\np=jnp.zeros((4,6))\nprint('loss',f(p))\nprint('grad',jax.grad(f)(p).shape)\nprint('jit',jax.jit(jax.value_and_grad(f))(p)[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
