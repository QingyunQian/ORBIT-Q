{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/train12.py <<'PY'\nimport pickle,numpy as np,time\nimport jax,jax.numpy as jnp\nimport tensorcircuit as tc\nimport quimb.tensor as qtn\ntc.set_backend('jax')\nwith open('/tmp/target.pkl','rb')as f: qm=pickle.load(f)\nn=qm.L\ndef qtensors(m):\n out=[]\n for i,t in enumerate(m.tensors):\n  inds=list(t.inds); p=inds.index(m.site_ind(i)); a=np.asarray(t.data)\n  left=next((inds.index(x) for x in inds if i and x in m.tensors[i-1].inds),None)\n  right=next((inds.index(x) for x in inds if i<n-1 and x in m.tensors[i+1].inds),None)\n  order=(([left] if left is not None else [])+[p]+([right] if right is not None else []))\n  a=np.transpose(a,order)\n  if left is None:a=a[None,:,:]\n  if right is None:a=a[:,:,None]\n  out.append(jnp.asarray(a,dtype=jnp.complex64))\n return out\ntarget=tc.MPSCircuit(n,tensors=qtensors(qm),center_position=0)\nzero=jnp.array([1,0],dtype=jnp.complex64);one=jnp.array([0,1],dtype=jnp.complex64)\ninit=tuple((zero if i%2==0 else one).reshape(1,2,1)for i in range(n))\nbonds=tuple(list(range(0,n-1,2))+list(range(1,n-1,2)))\ndef fidelity(p):\n c=tc.MPSCircuit(n,tensors=init,center_position=0)\n for k,i in enumerate(bonds):c.apply(tc.gates.su4(p[15*k:15*k+15]),i,i+1)\n o=c.proj_with_mps(target)\n return jnp.real(o*jnp.conj(o))\nvg=jax.value_and_grad(fidelity)\ndef train(p, steps):\n def u(c,_):\n  p,m,v,t=c; f,g=vg(p);t=t+1;m=.9*m+.1*g;v=.999*v+.001*g*g;p=p+.02*(m/(1-.9**t))/(jnp.sqrt(v/(1-.999**t))+1e-8);return(p,m,v,t),(1-f,f)\n return jax.lax.scan(u,(p,jnp.zeros_like(p),jnp.zeros_like(p),jnp.array(0)),None,length=steps)\nrun=jax.jit(train,static_argnums=1)\np=jax.random.normal(jax.random.PRNGKey(2039),(len(bonds)*15,))*0.02\nt=time.time(); (out,h)=run(p,100);jax.block_until_ready(out[0]);print('time',time.time()-t, 'F', h[1][0],h[1][-1])\nt=time.time(); (out,h)=run(out[0],100);jax.block_until_ready(out[0]);print('time2',time.time()-t, 'F', h[1][-1])\nPY\npython /tmp/train12.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
