{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/run_tc5scan.py <<'PY'\nimport time\nimport numpy as np\nimport jax\nimport jax.numpy as jnp\nimport tensorcircuit as tc\ntc.set_backend('jax')\nn=18; nl=10; max_steps=600; lr=.02\nbonds=(tuple(range(0,n-1,2)),tuple(range(1,n-1,2)))\nterms=[];weights=[]\nfor i in range(n-1):\n t=[0]*n;t[i]=t[i+1]=3;terms.append(t);weights.append(-1.)\nfor i in range(n):\n t=[0]*n;t[i]=1;terms.append(t);weights.append(-1.1)\nmvp=tc.quantum.PauliStringSum2MVP(terms,weights)\ndef loss(p):\n c=tc.Circuit(n);c.h(range(n));s=c.state()\n for l in range(nl):\n  a,b=p[l]\n  u=jnp.array([[jnp.cosh(a),jnp.sinh(a)],[jnp.sinh(a),jnp.cosh(a)]],dtype=jnp.complex64)\n  v=jnp.diag(jnp.array([jnp.exp(b),jnp.exp(-b),jnp.exp(-b),jnp.exp(b)],dtype=jnp.complex64))\n  c=tc.Circuit(n,inputs=s)\n  for i in range(n):c.any(i,unitary=u)\n  for i in bonds[l%2]:c.any(i,i+1,unitary=v)\n  s=c.state();s=s/jnp.linalg.norm(s)\n return jnp.real(jnp.vdot(s,mvp(s)))/n\nvg=jax.value_and_grad(loss)\ndef body(carry,k):\n p,m,v=carry\n x,g=vg(p)\n m=.9*m+.1*g;v=.999*v+.001*(g*g)\n t=k+1\n p=p-lr*(m/(1-.9**t))/(jnp.sqrt(v/(1-.999**t))+1e-8)\n return (p,m,v),x\n@jax.jit\ndef go(p):\n return jax.lax.scan(body,(p,jnp.zeros_like(p),jnp.zeros_like(p)),jnp.arange(max_steps))\np=jnp.full((nl,2),.01)\nt=time.time();(p,m,v),h=go(p);h.block_until_ready();print('time',time.time()-t)\nprint(h[0],h[-1],p)\nPY\npython /tmp/run_tc5scan.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
