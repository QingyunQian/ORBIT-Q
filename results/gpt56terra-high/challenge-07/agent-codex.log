     for op in ops:\n            if isinstance(op[1], int):\n                op[1] = [op[1]]\n        all_sites = np.concatenate([op[1] for op in ops])\n\n        # move position inside the operator range\n        if other is None:\n            site_begin = np.min(all_sites)\n            site_end = np.max(all_sites)\n            if self._mps.center_position < site_begin:\n                self.position(site_begin)\n            elif self._mps.center_position > site_end:\n                self.position(site_end)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/abstractcircuit.py:826:    def measure_instruction(self, *index: int) -> None:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/abstractcircuit.py:904:        self.measure_instruction(q)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/abstractcircuit.py:1404:    conditional_gate = select_gate\n/usr/local/lib/python3.11/site-packages/tensorcircuit/abstractcircuit.py:1417:        >>> c.conditional_gate(r, [tc.gates.i(), tc.gates.x()], 1)\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:637:    def _is_measure_instruction_name(name: str) -> bool:\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:676:            if self._is_measure_instruction_name(name):\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:712:                        \"allow_state=True currently supports terminal measure_instruction only.\"\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:812:    def _run_instruction_trajectory(\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:856:            c.conditional_gate(m, [gates.i(), gates.x()], q)  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:860:            c.conditional_gate(m, [gates.i(), gates.x()], q)  # type: ignore\n/usr/local/lib/python3.11/site-packages/tensorcircuit/basecircuit.py:1299:                records = self._run_instruction_trajecto