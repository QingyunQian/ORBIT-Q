{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/proto3.py <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\nimport time\n\ntc.set_backend('jax')\n#tc.set_dtype('complex64')\nN=12\nI=tc.gates.i()\nX=tc.gates.x(); Z=tc.gates.z()\n\ndef metric(p):\n c=tc.Circuit(N)\n for q in range(N): c.h(q)\n logs=[]\n norm=jnp.array(1.0)\n for t in range(10):\n  bonds=range(0,11,2) if t%2==0 else range(1,11,2)\n  for k,a in enumerate(bonds):\n   c.exp1(a,a+1, unitary=tc.gates._xx_matrix, theta=p[t,k,0])\n   c.exp1(a,a+1, unitary=tc.gates._zz_matrix, theta=p[t,k,1])\n  for q in range(N): c.rx(q,theta=p[t,6,q])\n  for q in range(0,N,2):\n   before=tc.backend.real(c.expectation((I,[0])))\n   c.mid_measurement(q,keep=0)\n   after=tc.backend.real(c.expectation((I,[0])))\n   logs.append(jnp.log(after/before+1e-12))\n   norm=after\n e=0.\n for q in range(N-1):e-=tc.backend.real(c.expectation((Z,[q]),(Z,[q+1])))/norm\n for q in range(N):e-=.9*tc.backend.real(c.expectation((X,[q])))/norm\n m=jnp.mean(jnp.stack(logs))\n return e/N, m\n\ndef loss(p):\n e,m=metric(p)\n return e-.05*m,(e,m)\nvg=jax.jit(jax.value_and_grad(loss,has_aux=True))\np=0.1*jax.random.normal(jax.random.PRNGKey(42),(10,7,12))\n# unused reshaping but okay 7 rows: bond first 6 theta both; rx in p[:,6,:]\nt0=time.time(); ((l,(e,m)),g)=vg(p); jax.block_until_ready(l); print('first',time.time()-t0,l,e,m,jnp.linalg.norm(g))\nt0=time.time();\nfor i in range(5):\n ((l,(e,m)),g)=vg(p); p=p-.01*g\njax.block_until_ready(l);print('run',time.time()-t0,l,e,m)\nPY\npython /tmp/proto3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
