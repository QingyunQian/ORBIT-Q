{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"cat > /tmp/state3.py <<'PY'\nimport tensorcircuit as tc\nimport jax\nimport jax.numpy as jnp\nimport time\n\ntc.set_backend('jax')\nN=12\n\ndef metric(p):\n c=tc.Circuit(N)\n for q in range(N):c.h(q)\n logs=[]\n for t in range(10):\n  bonds=range(0,11,2) if t%2==0 else range(1,11,2)\n  for k,a in enumerate(bonds):\n   c.exp1(a,a+1,unitary=tc.gates._xx_matrix,theta=p[t,k,0])\n   c.exp1(a,a+1,unitary=tc.gates._zz_matrix,theta=p[t,k,1])\n  for q in range(N):c.rx(q,theta=p[t,6,q])\n  for q in range(0,N,2):\n   s=c.state()\n   z=tc.backend.real(tc.expectation((tc.gates.z(),q),ket=s,normalization=True))\n   pr=(1+z)/2\n   logs.append(jnp.log(pr+1e-12))\n   c.mid_measurement(q,keep=0)\n   s=c.state()/tc.backend.sqrt(pr)\n   c=tc.Circuit(N,inputs=s)\n s=c.state()\n e=0.\n for q in range(N-1):e-=tc.backend.real(tc.expectation((tc.gates.z(),q),(tc.gates.z(),q+1),ket=s,normalization=True))\n for q in range(N):e-=.9*tc.backend.real(tc.expectation((tc.gates.x(),q),ket=s,normalization=True))\n return e/N,jnp.mean(jnp.stack(logs))\ndef loss(p):\n e,m=metric(p);return e-.05*m,(e,m)\nvg=jax.jit(jax.value_and_grad(loss,has_aux=True))\np=.1*jax.random.normal(jax.random.PRNGKey(42),(10,7,12))\nt=time.time();((l,(e,m)),g)=vg(p);jax.block_until_ready(l);print('FIRST',time.time()-t,l,e,m,jnp.linalg.norm(g))\nt=time.time()\nfor i in range(5):((l,(e,m)),g)=vg(p);p=p-.01*g\njax.block_until_ready(l);print('NEXT',time.time()-t,l,e,m)\nPY\npython /tmp/state3.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
